{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Plataforma": {
    "ZonaHoraria": "America/Bogota"
  },
  "Integration": {
    "Dispatcher": {
      "Enabled": true,
      "IntervalSeconds": 5,
      "BudgetSeconds": 60,
      "LeaseTtlSeconds": 120,
      "BatchSize": 100
    },
    "Retries": {
      "BaseDelaySeconds": 15,
      "MaxDelayMinutes": 15,
      "AlertAfterAttempts": 3,
      "AlertAfterMinutes": 15
    },
    "AuditForwarder": {
      "Enabled": true
    },
    "ScheduledTasks": {
      "Enabled": true,
      "IntervalSeconds": 60
    },
    "EmailDispatcher": {
      "Enabled": true,
      "IntervalSeconds": 15
    },
    "ReorderReview": {
      "StartHour": 5
    }
  },
  "AttachmentStorage": {
    "Provider": "Local",
    "LocalRootPath": "storage/attachments",
    "MaxBytes": 26214400,
    "SubidaMinutos": 5,
    "DescargaSegundos": 60,
    "Concurrencia": {
      "Permisos": 32,
      "Cola": 64
    },
    "S3": {
      "BucketName": "",
      "Region": "us-east-1",
      "Prefix": "",
      "ServerSideEncryption": "AES256"
    }
  },
  "Database": {
    "Provider": "SqlServer",
    "ConnectionStrings": {
      "PostgreSQL": "",
      "SqlServer": "Server=localhost;Database=IngenIA365ERP;Trusted_Connection=true;TrustServerCertificate=true;"
    },
    "AdminConnectionStrings": {
      "PostgreSQL": "",
      "SqlServer": "Server=localhost;Database=IngenIA365ERP_Admin;Trusted_Connection=true;TrustServerCertificate=true;"
    },
    "AutoMigrate": false,
    "Seed": {
      "RunParametricSeed": true,
      "RunTestSeed": false
    },
    "Startup": {
      "RetryWindowSeconds": 60,
      "RetryIntervalSeconds": 5
    }
  },
  "ConnectionStrings": {
    "SqlServer": "Server=localhost;Database=IngenIA365ERP;Trusted_Connection=true;TrustServerCertificate=true;",
    "MongoDB": "mongodb://localhost:27017/IngenIA365ERP_Audit",
    "Redis": "localhost:6379,abortConnect=false"
  },
  "JwtSettings": {
    "PrivateKeyPath": "Keys/dev_private.pem",
    "PublicKeyPath": "Keys/dev_public.pem",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7,
    "Issuer": "IngenIA365ERP",
    "Audience": "IngenIA365ERP.Clients"
  },
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "IngenIA365ERP_Audit",
    "RetentionDays": 1825,
    "AccessLogRetentionDays": 90,
    "BatchSize": 100,
    "FlushIntervalSeconds": 5
  },
  "Serilog": {
    "_comentario": "Los niveles de registro se gobiernan AQUI (y en el appsettings del ambiente o con variables Serilog__MinimumLevel__*). La seccion Logging de arriba NO filtra nada: UseSerilog sustituye la ILoggerFactory entera y sus reglas no se consultan; se deja como estaba porque nada la lee. Hasta el 2026-09-12 esta seccion tampoco se leia (Program.cs no llamaba ReadFrom.Configuration) y en produccion cada peticion y cada SQL de EF Core salian en Information. Microsoft nunca en Error: a Warning quedan las advertencias de autenticacion, DataProtection y Kestrel que si hay que ver; Microsoft.Hosting.Lifetime en Information para conservar las lineas de arranque y apagado.",
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    }
  },
  "RateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "GeneralRules": [
      {
        "Endpoint": "POST:/api/auth/login",
        "Period": "1m",
        "Limit": 10
      },
      {
        "Endpoint": "POST:/api/auth/refresh",
        "Period": "1m",
        "Limit": 20
      },
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 1000
      }
    ]
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5001",
      "http://localhost:7200",
      "http://localhost:5200",
      "http://localhost:7052"
    ]
  },
  "Sesion": {
    "InactividadMinutos": 30,
    "DuracionMaximaHoras": 12
  },
  "CentralIdentity": {
    "AdminDatabaseConnectionStringName": "SqlServerAdmin",
    "ChallengeTokenLifetimeMinutes": 5,
    "RequireUniqueEmail": true,
    "PasswordMinimumLength": 12,
    "DisableInternalLockout": true,
    "BootstrapMasterAdmin": {
      "EmailEnvVar": "MASTER_ADMIN_EMAIL",
      "PasswordEnvVar": "MASTER_ADMIN_PASSWORD"
    }
  },
  "PwnedPassword": {
    "Enabled": true,
    "BaseUrl": "https://api.pwnedpasswords.com",
    "TimeoutSeconds": 2,
    "FailOpenOnError": true
  },
  "LoginLockout": {
    "Enabled": true,
    "Thresholds": [
      {
        "AfterFailures": 5,
        "LockSeconds": 60
      },
      {
        "AfterFailures": 10,
        "LockSeconds": 300
      },
      {
        "AfterFailures": 15,
        "LockSeconds": 900
      },
      {
        "AfterFailures": 20,
        "LockSeconds": 3600
      }
    ],
    "RequireAdminUnlockAfterFailures": 20
  },
  "InvitationDefaults": {
    "ValidityDays": 7
  },
  "PasswordResetDefaults": {
    "TokenValidityMinutes": 60
  }
}
