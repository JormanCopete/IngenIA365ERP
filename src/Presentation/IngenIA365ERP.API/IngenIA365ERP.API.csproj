<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <!-- Publicacion para el contenedor (ci.yml pasa -p:ContainerPublish=true): ReadyToRun
       precompila el IL a codigo nativo de linux-x64, asi el arranque del pod y la primera
       peticion de cada endpoint tras un despliegue no pagan el JIT completo (en produccion
       la API tardaba 100-140 s en responder /health/live). Condicionado para que dotnet run
       y dotnet test en la maquina de desarrollo no cambien. Framework-dependent: la imagen
       base aspnet:10.0 trae el runtime. -->
  <PropertyGroup Condition="'$(ContainerPublish)' == 'true'">
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Carter" Version="10.0.0" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <!-- Feature 012 (I4): QR de la representación gráfica de los documentos electrónicos. Misma versión que Identity. -->
    <PackageReference Include="QRCoder" Version="1.6.*" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.4.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <!-- Envuelve consola y archivo en una cola con hilo de fondo: antes los dos
         sinks escribian en el hilo de la peticion. Serilog.Settings.Configuration
         (ReadFrom.Configuration) y los sinks Console/File ya llegan con
         Serilog.AspNetCore; este es el unico que faltaba. 2.1.0 es la ultima
         estable y pide Serilog >= 4.1.0 (aca resuelve 4.3.0). -->
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="AspNetCoreRateLimit" Version="5.*" />
    <!-- Feature 004: health checks del motor activo (tag "ready"). Se registra
         uno u otro segun Database:Provider. -->
    <PackageReference Include="AspNetCore.HealthChecks.SqlServer" Version="9.*" />
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="9.*" />
    <PackageReference Include="QuestPDF" Version="2026.5.0" />
    <!-- Requerido por dotnet-ef tools (startup project). Pinned a 10.x para
         evitar carga del Design 8.0.0 transitivo. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Core\IngenIA365ERP.Application\IngenIA365ERP.Application.csproj" />
    <ProjectReference Include="..\..\Infrastructure\IngenIA365ERP.Persistence\IngenIA365ERP.Persistence.csproj" />
    <!-- Feature 004: ambos arboles de migraciones viajan con la API; en runtime
         el IDbProviderConfigurator elige cual usa Database.Migrate(). -->
    <ProjectReference Include="..\..\Infrastructure\IngenIA365ERP.Persistence.Migrations.SqlServer\IngenIA365ERP.Persistence.Migrations.SqlServer.csproj" />
    <ProjectReference Include="..\..\Infrastructure\IngenIA365ERP.Persistence.Migrations.PostgreSql\IngenIA365ERP.Persistence.Migrations.PostgreSql.csproj" />
    <ProjectReference Include="..\..\Infrastructure\IngenIA365ERP.Identity\IngenIA365ERP.Identity.csproj" />
    <ProjectReference Include="..\..\Infrastructure\IngenIA365ERP.Audit\IngenIA365ERP.Audit.csproj" />
    <ProjectReference Include="..\..\Infrastructure\IngenIA365ERP.Caching\IngenIA365ERP.Caching.csproj" />
    <ProjectReference Include="..\..\Infrastructure\IngenIA365ERP.Storage\IngenIA365ERP.Storage.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="IngenIA365ERP.API.IntegrationTests" />
  </ItemGroup>

</Project>
