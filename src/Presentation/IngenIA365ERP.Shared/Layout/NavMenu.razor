@code {
    /// <summary>Feature 014 (T057): el grupo de captaciones se muestra cuando tenga su primer enlace; US1 (T070) le puso las líneas.</summary>
    private static readonly bool HayEnlacesDeCaptaciones = true;

    [Parameter] public bool SidebarOpen { get; set; } = true;

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _isTenantAdmin;
    private bool _isMaster;
    private string _activeTenantId = "";
    private string? _cooperativaRevisada;
    private bool _sesionSinPos;

    /// <summary>
    /// Hay cooperativa activa en el token. Es lo que decide si se muestran las
    /// secciones operativas: sin ella, esas pantallas sólo pueden fallar.
    /// </summary>
    private bool _tieneCooperativa => !string.IsNullOrEmpty(_activeTenantId);

    protected override async Task OnParametersSetAsync()
    {
        if (AuthState is null) return;
        var user = (await AuthState).User;
        _isTenantAdmin = bool.TryParse(user.FindFirst("tenant_admin")?.Value, out var admin) && admin;
        _isMaster = bool.TryParse(user.FindFirst("is_global_master_admin")?.Value, out var master) && master;
        _activeTenantId = user.FindFirst("active_tenant_id")?.Value ?? "";
        await RevisarSesionDeCajaAsync();
    }

    /// <summary>
    /// T645 (FR-058): si la sesión abierta del usuario es de un punto sin POS, «Vender en el POS» no se ofrece (ese punto cobra en
    /// oficina). Se pregunta una vez por cooperativa y sólo a quien ve sesiones de caja; si la consulta falla, el enlace queda.
    /// </summary>
    private async Task RevisarSesionDeCajaAsync()
    {
        if (!_tieneCooperativa || _cooperativaRevisada == _activeTenantId) return;
        _cooperativaRevisada = _activeTenantId;
        _sesionSinPos = false;
        if (!await Permisos.TieneAsync("Inventory.CashSessions.View")) return;
        var r = await Ventas.MiSesionAbiertaAsync();
        _sesionSinPos = r is { IsSuccess: true, Value.PointOfSale.PosEnabled: false };
    }
}
