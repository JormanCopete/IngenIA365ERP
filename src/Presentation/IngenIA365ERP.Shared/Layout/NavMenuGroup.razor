@* Grupo plegable del menú lateral (un módulo).
   2026-11-18 (pedido del dueño): el módulo donde está la pantalla abierta se abre solo y se marca. Para eso las opciones se pintan
   siempre (ocultas si el grupo está cerrado) y el CSS pregunta con :has() si alguna NavLink quedó .active: sin esto, el grupo de la
   pantalla actual aparecía cerrado al recargar y no había forma de saber en qué módulo se estaba. Tres estados: sin tocar (abierto
   sólo si contiene la pantalla actual), abierto o cerrado a mano.
   2026-11-19: el grupo abierto solo se cierra con un clic. El componente pregunta al mapa del menú (MapaDelMenu) si la
   dirección actual es una de sus opciones; antes no lo sabía y el primer clic «abría» lo que ya se veía abierto. *@
@implements IDisposable
@inject NavigationManager Nav
@inject PermisosDelUsuario Permisos
@if (_visible)
{
<div class="nav-group @Estado">
    <button type="button" class="nav-item nav-group-toggle" @onclick="Toggle" title="@Title" aria-expanded="@(Abierto ? "true" : "false")">
        <span class="e-icons @IconoCss"></span>
        @if (Expanded)
        {
            <span class="nav-group-title">@Title</span>
            <span class="e-icons e-chevron-down nav-chevron"></span>
        }
    </button>
    @if (Expanded)
    {
        <div class="nav-group-items">
            @ChildContent
        </div>
    }
</div>
}

@code {
    [Parameter] public string Icon { get; set; } = "";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public bool Expanded { get; set; } = true;
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// 2026-11-23: un módulo sin ninguna opción que el usuario pueda abrir no se muestra (antes quedaba el título y, al abrirlo,
    /// nada). Mientras los permisos no se resuelven se ve, para que el menú no parpadee en quien sí tiene acceso.
    /// </summary>
    private bool _visible = true;

    protected override async Task OnInitializedAsync()
    {
        Permisos.Cambiaron += OnCambiaron;
        await EvaluarAsync();
    }

    private async Task EvaluarAsync()
    {
        var estado = await Permisos.ObtenerAsync();
        _visible = estado.Provisional || estado.EsMaestro || MapaDelMenu.ElModuloTieneAlgoVisible(Title, estado.Codigos);
    }

    private void OnCambiaron() => _ = InvokeAsync(async () =>
    {
        await EvaluarAsync();
        StateHasChanged();
    });

    public void Dispose() => Permisos.Cambiaron -= OnCambiaron;

    /// <summary>null = sin tocar: lo decide el CSS según contenga la pantalla actual.</summary>
    private bool? _abierto;

    /// <summary>2026-11-18: el ícono del módulo. Hasta ese día se pintaba «e-@Icon» y el menú pasaba «e-chart»: la clase quedaba
    /// «e-e-chart», que no existe, y ningún módulo mostraba su ícono. Se acepta con o sin el prefijo.</summary>
    private string IconoCss => Icon.StartsWith("e-", StringComparison.Ordinal) ? Icon : $"e-{Icon}";

    private bool ContieneLaPantalla => MapaDelMenu.ElModuloContiene(Title, "/" + Nav.ToBaseRelativePath(Nav.Uri));

    /// <summary>Lo que se ve: abierto a mano, o sin tocar y con la pantalla actual adentro.</summary>
    private bool Abierto => _abierto ?? ContieneLaPantalla;

    private string Estado => _abierto switch { true => "abierto", false => "cerrado", _ => "auto" };

    /// <summary>Desde «sin tocar» el clic invierte lo que se ve: si el grupo se veía abierto por contener la pantalla actual, lo
    /// cierra; si no, lo abre.</summary>
    private void Toggle() => _abierto = _abierto switch
    {
        null => !ContieneLaPantalla,
        var abierto => !abierto,
    };
}
