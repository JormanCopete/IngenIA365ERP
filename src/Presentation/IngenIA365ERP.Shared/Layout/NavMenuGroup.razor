@* Grupo plegable del menú lateral (un módulo).
   2026-11-18 (pedido del dueño): el módulo donde está la pantalla abierta se abre solo y se marca. Para eso las opciones se pintan
   siempre (ocultas si el grupo está cerrado) y el CSS pregunta con :has() si alguna NavLink quedó .active: sin esto, el grupo de la
   pantalla actual aparecía cerrado al recargar y no había forma de saber en qué módulo se estaba. Tres estados: sin tocar (abierto
   sólo si contiene la pantalla actual), abierto o cerrado a mano. *@
<div class="nav-group @Estado">
    <button type="button" class="nav-item nav-group-toggle" @onclick="Toggle" title="@Title" aria-expanded="@(Abierto ? "true" : "false")">
        <span class="e-icons @IconoCss"></span>
        @if (Expanded)
        {
            <span class="nav-group-title">@Title</span>
            <span class="e-icons e-chevron-down nav-chevron"></span>
        }
    </button>
    @if (Expanded)
    {
        <div class="nav-group-items">
            @ChildContent
        </div>
    }
</div>

@code {
    [Parameter] public string Icon { get; set; } = "";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public bool Expanded { get; set; } = true;
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>null = sin tocar: lo decide el CSS según contenga la pantalla actual.</summary>
    private bool? _abierto;

    /// <summary>2026-11-18: el ícono del módulo. Hasta ese día se pintaba «e-@Icon» y el menú pasaba «e-chart»: la clase quedaba
    /// «e-e-chart», que no existe, y ningún módulo mostraba su ícono. Se acepta con o sin el prefijo.</summary>
    private string IconoCss => Icon.StartsWith("e-", StringComparison.Ordinal) ? Icon : $"e-{Icon}";

    private bool Abierto => _abierto == true;

    private string Estado => _abierto switch { true => "abierto", false => "cerrado", _ => "auto" };

    /// <summary>Desde «sin tocar» el primer clic cierra si el grupo se veía abierto por contener la pantalla; como el componente no
    /// sabe eso sin preguntarle al navegador, el primer clic abre y el CSS, en «abierto», muestra igual. Un segundo clic cierra.</summary>
    private void Toggle() => _abierto = _abierto != true;
}
