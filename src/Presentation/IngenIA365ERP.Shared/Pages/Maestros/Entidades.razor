@page "/maestros/entidades"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification

<PageTitle>Entidades Externas - IngenIA365ERP</PageTitle>

<div class="page-header">
    <h3>Entidades Externas</h3>
    <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@OpenCreate">Nuevo</SfButton>
</div>

<SfGrid @ref="_grid" TValue="ExternalEntityItem" DataSource="@_items"
    AllowPaging="true" AllowSorting="true" AllowFiltering="true">
    <GridColumns>
        <GridColumn Field="Name" HeaderText="Nombre" Width="300" />
        <GridColumn Field="ShortName" HeaderText="Nombre Corto" Width="200" />
        <GridColumn HeaderText="Acciones" Width="150" TextAlign="TextAlign.Center">
            <Template>
                @{
                    var item = context as ExternalEntityItem;
                    <SfButton CssClass="e-flat e-small" IconCss="e-icons e-edit" OnClick="@(() => OpenEdit(item!))" />
                    <SfButton CssClass="e-flat e-small e-danger" IconCss="e-icons e-trash" OnClick="@(() => OpenDelete(item!))" />
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

<SfDialog @bind-Visible="_showDialog" Header="@_dialogTitle" Width="450px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <div class="pagina">
                <div>
                    <label>Nombre *</label>
                    <SfTextBox @bind-Value="_model.Name" Placeholder="Nombre" />
                </div>
                <div>
                    <label>Nombre Corto</label>
                    <SfTextBox @bind-Value="_model.ShortName" Placeholder="Nombre corto" />
                </div>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _showDialog = false)" />
        <DialogButton Content="Guardar" IsPrimary="true" OnClick="@Save" />
    </DialogButtons>
</SfDialog>

<ConfirmDialog @bind-Visible="_showConfirm" OnConfirm="ConfirmDelete"
    Message="Esta seguro de eliminar este registro?" />

@code {
    private SfGrid<ExternalEntityItem>? _grid;
    private List<ExternalEntityItem> _items = [];
    private ExternalEntityItem _model = new();
    private Guid? _editId;
    private bool _showDialog, _showConfirm;
    private string _dialogTitle = "";
    private Guid _deleteId;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        try { _items = await Http.GetListAsync<ExternalEntityItem>("/api/core/external-entities?pageSize=500") ?? []; }
        catch { _items = []; }
    }

    private void OpenCreate() { _model = new(); _editId = null; _dialogTitle = "Nueva Entidad Externa"; _showDialog = true; }
    private void OpenEdit(ExternalEntityItem item) { _model = new() { Name = item.Name, ShortName = item.ShortName }; _editId = item.PublicId; _dialogTitle = "Editar Entidad Externa"; _showDialog = true; }
    private void OpenDelete(ExternalEntityItem item) { _deleteId = item.PublicId; _showConfirm = true; }

    private async Task Save()
    {
        HttpResponseMessage res;
        if (_editId.HasValue)
            res = await Http.PutAsJsonAsync($"/api/core/external-entities/{_editId}", _model);
        else
            res = await Http.PostAsJsonAsync("/api/core/external-entities", _model);

        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro guardado");
            _showDialog = false;
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al guardar");
    }

    private async Task ConfirmDelete()
    {
        var res = await Http.DeleteAsync($"/api/core/external-entities/{_deleteId}");
        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro eliminado");
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al eliminar");
    }

    private class ExternalEntityItem
    {
        public Guid PublicId { get; set; }
        public string Name { get; set; } = "";
        public string? ShortName { get; set; }
    }
}
