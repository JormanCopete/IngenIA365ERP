@page "/maestros/actividades-culturales"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification

<PageTitle>Actividades Culturales - IngenIA365ERP</PageTitle>

<div class="page-header">
    <h3>Actividades Culturales</h3>
    <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@OpenCreate">Nuevo</SfButton>
</div>

<SfGrid @ref="_grid" TValue="CulturalActivityItem" DataSource="@_items"
    AllowPaging="true" AllowSorting="true" AllowFiltering="true">
    <GridColumns>
        <GridColumn Field="Name" HeaderText="Nombre" Width="250" />
        <GridColumn Field="ShortName" HeaderText="Nombre Corto" Width="150" />
        <GridColumn Field="CommitteeName" HeaderText="Comite" Width="200" />
        <GridColumn HeaderText="Acciones" Width="150" TextAlign="TextAlign.Center">
            <Template>
                @{
                    var item = context as CulturalActivityItem;
                    <SfButton CssClass="e-flat e-small" IconCss="e-icons e-edit" OnClick="@(() => OpenEdit(item!))" />
                    <SfButton CssClass="e-flat e-small e-danger" IconCss="e-icons e-trash" OnClick="@(() => OpenDelete(item!))" />
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

<SfDialog @bind-Visible="_showDialog" Header="@_dialogTitle" Width="500px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <div style="padding:10px;display:flex;flex-direction:column;gap:16px;">
                <div>
                    <label>Nombre *</label>
                    <SfTextBox @bind-Value="_model.Name" Placeholder="Nombre" />
                </div>
                <div>
                    <label>Nombre Corto</label>
                    <SfTextBox @bind-Value="_model.ShortName" Placeholder="Nombre corto" />
                </div>
                <div>
                    <label>Comite</label>
                    <SfDropDownList TValue="Guid?" TItem="CommitteeOption" DataSource="@_committees"
                        @bind-Value="_model.CommitteeId" Placeholder="Seleccione comite">
                        <DropDownListFieldSettings Text="Name" Value="PublicId" />
                    </SfDropDownList>
                </div>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _showDialog = false)" />
        <DialogButton Content="Guardar" IsPrimary="true" OnClick="@Save" />
    </DialogButtons>
</SfDialog>

<ConfirmDialog @bind-Visible="_showConfirm" OnConfirm="ConfirmDelete"
    Message="Esta seguro de eliminar este registro?" />

@code {
    private SfGrid<CulturalActivityItem>? _grid;
    private List<CulturalActivityItem> _items = [];
    private List<CommitteeOption> _committees = [];
    private CulturalActivityModel _model = new();
    private Guid? _editId;
    private bool _showDialog, _showConfirm;
    private string _dialogTitle = "";
    private Guid _deleteId;

    protected override async Task OnInitializedAsync()
    {
        await LoadCommittees();
        await LoadData();
    }

    private async Task LoadData()
    {
        try { _items = await Http.GetFromJsonAsync<List<CulturalActivityItem>>("/api/core/cultural-activities?pageSize=500") ?? []; }
        catch { _items = []; }
    }

    private async Task LoadCommittees()
    {
        try { _committees = await Http.GetFromJsonAsync<List<CommitteeOption>>("/api/core/committees?pageSize=500") ?? []; }
        catch { _committees = []; }
    }

    private void OpenCreate() { _model = new(); _editId = null; _dialogTitle = "Nueva Actividad Cultural"; _showDialog = true; }

    private void OpenEdit(CulturalActivityItem item)
    {
        _model = new() { Name = item.Name, ShortName = item.ShortName, CommitteeId = item.CommitteeId };
        _editId = item.PublicId;
        _dialogTitle = "Editar Actividad Cultural";
        _showDialog = true;
    }

    private void OpenDelete(CulturalActivityItem item) { _deleteId = item.PublicId; _showConfirm = true; }

    private async Task Save()
    {
        HttpResponseMessage res;
        if (_editId.HasValue)
            res = await Http.PutAsJsonAsync($"/api/core/cultural-activities/{_editId}", _model);
        else
            res = await Http.PostAsJsonAsync("/api/core/cultural-activities", _model);

        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro guardado");
            _showDialog = false;
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al guardar");
    }

    private async Task ConfirmDelete()
    {
        var res = await Http.DeleteAsync($"/api/core/cultural-activities/{_deleteId}");
        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro eliminado");
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al eliminar");
    }

    private class CulturalActivityItem
    {
        public Guid PublicId { get; set; }
        public string Name { get; set; } = "";
        public string? ShortName { get; set; }
        public Guid? CommitteeId { get; set; }
        public string? CommitteeName { get; set; }
    }

    private class CulturalActivityModel
    {
        public string Name { get; set; } = "";
        public string? ShortName { get; set; }
        public Guid? CommitteeId { get; set; }
    }

    private class CommitteeOption
    {
        public Guid PublicId { get; set; }
        public string Name { get; set; } = "";
    }
}
