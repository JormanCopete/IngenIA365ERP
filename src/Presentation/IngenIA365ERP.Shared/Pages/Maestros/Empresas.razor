@page "/maestros/empresas"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification

<PageTitle>Empresas - IngenIA365ERP</PageTitle>

<div class="page-header" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;">
    <h3>Empresas</h3>
    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
        <SfTextBox Placeholder="Buscar por nombre o NIT..." @bind-Value="_search" Width="280px"
                   ValueChange="@((Syncfusion.Blazor.Inputs.ChangedEventArgs e) => OnSearchChanged())" />
        <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@OpenCreate">Nueva Empresa</SfButton>
    </div>
</div>

<SfGrid @ref="_grid" TValue="CompanyRow" DataSource="@_items"
        AllowPaging="true" AllowSorting="true" AllowFiltering="true">
    <GridPageSettings PageSize="20" />
    <GridColumns>
        <GridColumn Field="@nameof(CompanyRow.TaxId)" HeaderText="NIT" Width="140" />
        <GridColumn Field="@nameof(CompanyRow.Name)" HeaderText="Nombre" Width="280" />
        <GridColumn Field="@nameof(CompanyRow.ShortName)" HeaderText="Nombre Corto" Width="180" />
        <GridColumn Field="@nameof(CompanyRow.Phone)" HeaderText="Telefono" Width="140" />
        <GridColumn Field="@nameof(CompanyRow.City)" HeaderText="Ciudad" Width="140" />
        <GridColumn HeaderText="Acciones" Width="150" TextAlign="TextAlign.Center" AllowFiltering="false" AllowSorting="false">
            <Template>
                @{
                    var c = context as CompanyRow;
                    <SfButton CssClass="e-flat e-small" IconCss="e-icons e-edit"
                              OnClick="@(() => OpenEdit(c!))" Title="Editar" />
                    <SfButton CssClass="e-flat e-small e-danger" IconCss="e-icons e-trash"
                              OnClick="@(() => OpenDelete(c!))" Title="Eliminar" />
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

<SfDialog @bind-Visible="_showDialog" Header="@_dialogTitle" Width="650px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <EditForm Model="_model" OnValidSubmit="Save">
                <DataAnnotationsValidator />
                <div style="padding:10px;display:grid;grid-template-columns:repeat(2,1fr);gap:14px;">
                    <div>
                        <label>NIT / Documento <span style="color:red">*</span></label>
                        <SfTextBox @bind-Value="_model.TaxId" Placeholder="NIT"
                                   HtmlAttributes="@(new Dictionary<string, object> { { "maxlength", "20" } })" />
                        <ValidationMessage For="@(() => _model.TaxId)" />
                    </div>
                    <div>
                        <label>DV</label>
                        <SfTextBox @bind-Value="_model.TaxIdCheckDigit" Placeholder="Digito"
                                   HtmlAttributes="@(new Dictionary<string, object> { { "maxlength", "2" } })" />
                    </div>
                    <div style="grid-column:span 2;">
                        <label>Nombre / Razon Social <span style="color:red">*</span></label>
                        <SfTextBox @bind-Value="_model.Name" Placeholder="Nombre completo de la empresa"
                                   HtmlAttributes="@(new Dictionary<string, object> { { "maxlength", "120" } })" />
                        <ValidationMessage For="@(() => _model.Name)" />
                    </div>
                    <div style="grid-column:span 2;">
                        <label>Nombre Corto</label>
                        <SfTextBox @bind-Value="_model.ShortName" Placeholder="Nombre comercial"
                                   HtmlAttributes="@(new Dictionary<string, object> { { "maxlength", "60" } })" />
                    </div>
                    <div style="grid-column:span 2;">
                        <label>Direccion</label>
                        <SfTextBox @bind-Value="_model.Address" Placeholder="Direccion"
                                   HtmlAttributes="@(new Dictionary<string, object> { { "maxlength", "80" } })" />
                    </div>
                    <div>
                        <label>Telefono</label>
                        <SfTextBox @bind-Value="_model.Phone" Placeholder="Telefono"
                                   HtmlAttributes="@(new Dictionary<string, object> { { "maxlength", "40" } })" />
                    </div>
                    <div>
                        <label>Ciudad</label>
                        <SfTextBox @bind-Value="_model.City" Placeholder="Ciudad"
                                   HtmlAttributes="@(new Dictionary<string, object> { { "maxlength", "40" } })" />
                    </div>
                    <div style="grid-column:span 2;">
                        <label>Departamento</label>
                        <SfTextBox @bind-Value="_model.Department" Placeholder="Departamento"
                                   HtmlAttributes="@(new Dictionary<string, object> { { "maxlength", "40" } })" />
                    </div>
                </div>
                <button type="submit" id="empresas-submit" style="display:none"></button>
            </EditForm>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@CancelDialog" />
        <DialogButton Content="Guardar" IsPrimary="true" OnClick="@Save" Disabled="@_saving" />
    </DialogButtons>
</SfDialog>

<ConfirmDialog @bind-Visible="_showConfirm" OnConfirm="ConfirmDelete"
               Message="¿Esta seguro de eliminar esta empresa?" />

@code {
    private SfGrid<CompanyRow>? _grid;
    private List<CompanyRow> _items = new();
    private string _search = "";
    private System.Threading.CancellationTokenSource? _searchDebounce;

    private bool _showDialog, _showConfirm, _saving;
    private string _dialogTitle = "";
    private CompanyModel _model = new();
    private Guid? _editId;
    private Guid _deleteId;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        try
        {
            var url = "/api/core/companies?PageNumber=1&PageSize=500";
            if (!string.IsNullOrWhiteSpace(_search))
                url += $"&SearchTerm={Uri.EscapeDataString(_search)}";

            _items = await Http.GetListAsync<CompanyRow>(url);
        }
        catch (Exception ex)
        {
            _items = new List<CompanyRow>();
            await Notification.ErrorAsync($"No se pudieron cargar las empresas: {ex.Message}");
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
            if (_grid is not null) await _grid.Refresh();
        }
    }

    private async Task OnSearchChanged()
    {
        _searchDebounce?.Cancel();
        _searchDebounce = new System.Threading.CancellationTokenSource();
        var token = _searchDebounce.Token;
        try
        {
            await Task.Delay(350, token);
            if (!token.IsCancellationRequested) await LoadData();
        }
        catch (TaskCanceledException) { /* expected */ }
    }

    private void OpenCreate()
    {
        _model = new CompanyModel();
        _editId = null;
        _dialogTitle = "Nueva Empresa";
        _showDialog = true;
    }

    private void OpenEdit(CompanyRow row)
    {
        _model = new CompanyModel
        {
            Name = row.Name,
            ShortName = row.ShortName,
            TaxId = row.TaxId,
            TaxIdCheckDigit = row.TaxIdCheckDigit,
            Address = row.Address,
            Phone = row.Phone,
            City = row.City,
            Department = row.Department
        };
        _editId = row.PublicId;
        _dialogTitle = "Editar Empresa";
        _showDialog = true;
    }

    private void OpenDelete(CompanyRow row)
    {
        _deleteId = row.PublicId;
        _showConfirm = true;
    }

    private void CancelDialog()
    {
        _showDialog = false;
        _model = new CompanyModel();
        _editId = null;
    }

    private async Task Save()
    {
        if (_saving) return;

        if (string.IsNullOrWhiteSpace(_model.TaxId))
        {
            await Notification.WarningAsync("El NIT/Documento es obligatorio.");
            return;
        }
        if (string.IsNullOrWhiteSpace(_model.Name))
        {
            await Notification.WarningAsync("El nombre es obligatorio.");
            return;
        }

        _saving = true;
        try
        {
            var payload = new
            {
                Name = _model.Name,
                ShortName = _model.ShortName,
                TaxId = _model.TaxId,
                TaxIdCheckDigit = _model.TaxIdCheckDigit,
                Address = _model.Address,
                Phone = _model.Phone,
                City = _model.City,
                Department = _model.Department
            };

            HttpResponseMessage res;
            if (_editId.HasValue)
                res = await Http.PutAsJsonAsync($"/api/core/companies/{_editId}", payload);
            else
                res = await Http.PostAsJsonAsync("/api/core/companies", payload);

            if (res.IsSuccessStatusCode)
            {
                await Notification.SuccessAsync(_editId.HasValue
                    ? "Empresa actualizada."
                    : "Empresa creada.");
                _showDialog = false;
                _model = new CompanyModel();
                _editId = null;
                await LoadData();
            }
            else
            {
                await Notification.ShowErrorAsync(res, "Error al guardar empresa");
            }
        }
        catch (Exception ex)
        {
            await Notification.ErrorAsync($"Error inesperado: {ex.Message}");
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ConfirmDelete()
    {
        try
        {
            var res = await Http.DeleteAsync($"/api/core/companies/{_deleteId}");
            if (res.IsSuccessStatusCode)
            {
                await Notification.SuccessAsync("Empresa eliminada.");
                await LoadData();
            }
            else
            {
                await Notification.ShowErrorAsync(res, "Error al eliminar empresa");
            }
        }
        catch (Exception ex)
        {
            await Notification.ErrorAsync($"Error inesperado: {ex.Message}");
        }
    }

    private class CompanyRow
    {
        public Guid PublicId { get; set; }
        public string Name { get; set; } = "";
        public string? ShortName { get; set; }
        public string TaxId { get; set; } = "";
        public string? TaxIdCheckDigit { get; set; }
        public string? Address { get; set; }
        public string? Phone { get; set; }
        public string? City { get; set; }
        public string? Department { get; set; }
    }

    private class CompanyModel
    {
        [Required(ErrorMessage = "Nombre obligatorio.")]
        [MaxLength(120)]
        public string Name { get; set; } = "";

        [MaxLength(60)]
        public string? ShortName { get; set; }

        [Required(ErrorMessage = "NIT/Documento obligatorio.")]
        [MaxLength(20)]
        public string TaxId { get; set; } = "";

        [MaxLength(2)]
        public string? TaxIdCheckDigit { get; set; }

        [MaxLength(80)]
        public string? Address { get; set; }

        [MaxLength(40)]
        public string? Phone { get; set; }

        [MaxLength(40)]
        public string? City { get; set; }

        [MaxLength(40)]
        public string? Department { get; set; }
    }
}
