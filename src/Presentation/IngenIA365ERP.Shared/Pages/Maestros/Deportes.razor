@page "/maestros/deportes"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification

<PageTitle>Deportes - IngenIA365ERP</PageTitle>

<div class="page-header">
    <h3>Deportes</h3>
    <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@OpenCreate">Nuevo Deporte</SfButton>
</div>

<IndicadorDeCarga Cargando="@_carga.Activa">
<SfGrid @ref="_grid" TValue="SportRow" DataSource="@_items"
        AllowPaging="true" AllowSorting="true" AllowFiltering="true">
    <GridPageSettings PageSize="20" />
    <GridColumns>
        <GridColumn Field="@nameof(SportRow.Code)" HeaderText="Código" Width="120" />
        <GridColumn Field="@nameof(SportRow.Name)" HeaderText="Nombre" Width="280" />
        <GridColumn Field="@nameof(SportRow.ShortName)" HeaderText="Nombre Corto" Width="180" />
        <GridColumn Field="@nameof(SportRow.CommitteeName)" HeaderText="Comite" Width="200" />
        <GridColumn HeaderText="Acciones" Width="150" TextAlign="TextAlign.Center" AllowFiltering="false" AllowSorting="false">
            <Template>
                @{
                    var s = context as SportRow;
                    <SfButton CssClass="e-flat e-small" IconCss="e-icons e-edit"
                              OnClick="@(() => OpenEdit(s!))" Title="Editar" />
                    <SfButton CssClass="e-flat e-small e-danger" IconCss="e-icons e-trash"
                              OnClick="@(() => OpenDelete(s!))" Title="Eliminar" />
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>
</IndicadorDeCarga>

<SfDialog @bind-Visible="_showDialog" Header="@_dialogTitle" Width="500px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@_guardado.Activa" Texto="Guardando…">
            <EditForm Model="_model" OnValidSubmit="Save">
                <DataAnnotationsValidator />
                <div class="pagina">
                    <div>
                        <CampoCodigo Catalogo="deportes" @bind-Value="_model.Code" Largo="10"
                                     EditandoPublicId="_editId" OnEditarExistente="EditarExistente" DuplicadoChanged="@(d => _codigoRepetido = d)" />
                    </div>
                    <div>
                        <label>Nombre <span class="obligatorio">*</span></label>
                        <SfTextBox @bind-Value="_model.Name" MaxLength="80" Placeholder="Nombre del deporte"
                                   HtmlAttributes="@(new Dictionary<string, object> { { "maxlength", "80" } })" />
                        <ValidationMessage For="@(() => _model.Name)" />
                    </div>
                    <div>
                        <label>Nombre Corto</label>
                        <SfTextBox @bind-Value="_model.ShortName" MaxLength="40" Placeholder="Nombre corto"
                                   HtmlAttributes="@(new Dictionary<string, object> { { "maxlength", "40" } })" />
                    </div>
                    <div>
                        <label>Comite</label>
                        <SfDropDownList TValue="Guid?" TItem="LookupOption"
                                        @bind-Value="_model.CommitteePublicId"
                                        DataSource="@_committees"
                                        Placeholder="Seleccione comite (opcional)"
                                        AllowFiltering="true"
                                        ShowClearButton="true">
                            <DropDownListFieldSettings Text="Name" Value="PublicId" />
                        </SfDropDownList>
                        <small class="hint">
                            Si no aparecen comites, primero registre uno en
                            <a href="/maestros/comites" target="_blank">Maestros - Comites</a>.
                        </small>
                    </div>
                </div>
                <button type="submit" id="deportes-submit" style="display:none"></button>
            </EditForm>
        </IndicadorDeCarga>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@CancelDialog" />
        <DialogButton Content="Guardar" IsPrimary="true" OnClick="@Save" Disabled="@(_saving || _guardado.Activa)" />
    </DialogButtons>
</SfDialog>

<ConfirmDialog @bind-Visible="_showConfirm" OnConfirm="ConfirmDelete"
               Message="¿Esta seguro de eliminar este deporte?" />

@code {
    // Indicadores de carga por zona (ver docs/manual/indicador-de-carga.md).
    private readonly EstadoDeCarga _carga = new(), _guardado = new();
    private SfGrid<SportRow>? _grid;
    private List<SportRow> _items = new();
    private List<LookupOption> _committees = new();

    private bool _showDialog, _showConfirm, _saving;
    private string _dialogTitle = "";
    private SportModel _model = new();
    private Guid? _editId;
    private bool _codigoRepetido;
    private Guid _deleteId;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadCommittees(), LoadData());
    }

    private async Task LoadCommittees()
    {
        try
        {
            _committees = (await Http.GetListAsync<LookupRaw>("/api/core/committees?PageNumber=1&PageSize=500"))
                .Select(c => new LookupOption(c.PublicId, c.Name)).ToList();
        }
        catch { _committees = new List<LookupOption>(); }
    }

    private async Task LoadData()
    {
        using var carga = _carga.Iniciar();
        try
        {
            _items = await Http.GetListAsync<SportRow>("/api/core/sports?PageNumber=1&PageSize=500");
        }
        catch (Exception ex)
        {
            _items = new List<SportRow>();
            await Notification.ErrorAsync($"No se pudieron cargar los deportes: {ex.Message}");
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
            if (_grid is not null) await _grid.Refresh();
        }
    }

    private void OpenCreate()
    {
        _model = new SportModel();
        _editId = null;
        _dialogTitle = "Nuevo Deporte";
        _showDialog = true;
    }

    private void EditarExistente(Guid publicId)
    {
        var existente = _items.FirstOrDefault(i => i.PublicId == publicId);
        if (existente is not null) { _codigoRepetido = false; OpenEdit(existente); }
    }

    private void OpenEdit(SportRow row)
    {
        _model = new SportModel
        {
            Code = row.Code,
            Name = row.Name,
            ShortName = row.ShortName,
            CommitteePublicId = row.CommitteePublicId
        };
        _editId = row.PublicId;
        _dialogTitle = "Editar Deporte";
        _showDialog = true;
    }

    private void OpenDelete(SportRow row)
    {
        _deleteId = row.PublicId;
        _showConfirm = true;
    }

    private void CancelDialog()
    {
        _showDialog = false;
        _model = new SportModel();
        _editId = null;
    }

    private async Task Save()
    {
        using var guardado = _guardado.Iniciar();
        if (_codigoRepetido)
        {
            await Notification.WarningAsync("Ese código ya existe: editá ese registro o usá otro código.");
            return;
        }
        if (_saving) return;

        if (string.IsNullOrWhiteSpace(_model.Name))
        {
            await Notification.WarningAsync("El nombre es obligatorio.");
            return;
        }

        _saving = true;
        try
        {
            // El backend usa CommitteePublicId (Guid?). Ojo: si era Guid.Empty, lo convertimos a null.
            var payload = new
            {
                Name = _model.Name,
                ShortName = _model.ShortName,
                CommitteePublicId = _model.CommitteePublicId == Guid.Empty ? (Guid?)null : _model.CommitteePublicId
            };

            HttpResponseMessage res;
            if (_editId.HasValue)
                res = await Http.PutAsJsonAsync($"/api/core/sports/{_editId}", payload);
            else
                res = await Http.PostAsJsonAsync("/api/core/sports", payload);

            if (res.IsSuccessStatusCode)
            {
                await Notification.SuccessAsync(_editId.HasValue
                    ? "Deporte actualizado."
                    : "Deporte creado.");
                _showDialog = false;
                _model = new SportModel();
                _editId = null;
                await LoadData();
            }
            else
            {
                await Notification.ShowErrorAsync(res, "Error al guardar deporte");
            }
        }
        catch (Exception ex)
        {
            await Notification.ErrorAsync($"Error inesperado: {ex.Message}");
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ConfirmDelete()
    {
        try
        {
            var res = await Http.DeleteAsync($"/api/core/sports/{_deleteId}");
            if (res.IsSuccessStatusCode)
            {
                await Notification.SuccessAsync("Deporte eliminado.");
                await LoadData();
            }
            else
            {
                await Notification.ShowErrorAsync(res, "Error al eliminar deporte");
            }
        }
        catch (Exception ex)
        {
            await Notification.ErrorAsync($"Error inesperado: {ex.Message}");
        }
    }

    /// <summary>Coincide con el DTO devuelto por /api/core/sports.</summary>
    private class SportRow
    {
        public string? Code { get; set; }
        public Guid PublicId { get; set; }
        public string Name { get; set; } = "";
        public string? ShortName { get; set; }
        public Guid? CommitteePublicId { get; set; }
        public string? CommitteeName { get; set; }
    }

    private class SportModel
    {
        public string? Code { get; set; }
        [Required(ErrorMessage = "Nombre obligatorio.")]
        [MaxLength(80)]
        public string Name { get; set; } = "";

        [MaxLength(40)]
        public string? ShortName { get; set; }

        public Guid? CommitteePublicId { get; set; }
    }

    private class LookupRaw
    {
        public Guid PublicId { get; set; }
        public string Name { get; set; } = "";
    }

    private class LookupOption
    {
        public Guid? PublicId { get; set; }
        public string Name { get; set; } = "";
        public LookupOption(Guid publicId, string name) { PublicId = publicId; Name = name; }
    }
}
