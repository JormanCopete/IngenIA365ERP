@page "/maestros/agencias"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification

<PageTitle>Agencias - IngenIA365ERP</PageTitle>

<div class="page-header">
    <h3>Agencias</h3>
    <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@OpenCreate">Nuevo</SfButton>
</div>

<IndicadorDeCarga Cargando="@_carga.Activa">
<SfGrid @ref="_grid" TValue="BranchItem" DataSource="@_items"
        AllowPaging="true" AllowSorting="true" AllowFiltering="true">
    <GridPageSettings PageSize="20" />
    <GridColumns>
        <GridColumn Field="@nameof(BranchItem.Code)" HeaderText="Código" Width="120" />
        <GridColumn Field="@nameof(BranchItem.Name)" HeaderText="Nombre" Width="320" />
        <GridColumn Field="@nameof(BranchItem.ShortName)" HeaderText="Nombre Corto" Width="200" />
        <GridColumn Field="@nameof(BranchItem.MunicipalityDaneCode)" HeaderText="Municipio (DIVIPOLA)" Width="160" />
        <GridColumn HeaderText="Acciones" Width="150" TextAlign="TextAlign.Center" AllowFiltering="false" AllowSorting="false">
            <Template>
                @{
                    var item = context as BranchItem;
                    <SfButton CssClass="e-flat e-small" IconCss="e-icons e-edit"
                              OnClick="@(() => OpenEdit(item!))" />
                    <SfButton CssClass="e-flat e-small e-danger" IconCss="e-icons e-trash"
                              OnClick="@(() => OpenDelete(item!))" />
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>
</IndicadorDeCarga>

<SfDialog @bind-Visible="_showDialog" Header="@_dialogTitle" Width="450px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@_guardado.Activa" Texto="Guardando…">
            <EditForm Model="_model" OnValidSubmit="Save">
                <DataAnnotationsValidator />
                <div class="pagina">
                    <div>
                        <CampoCodigo Catalogo="agencias" @bind-Value="_model.Code" Largo="10"
                                     EditandoPublicId="_editId" OnEditarExistente="EditarExistente" DuplicadoChanged="@(d => _codigoRepetido = d)" />
                    </div>
                    <div>
                        <label>Nombre <span class="obligatorio">*</span></label>
                        <SfTextBox @bind-Value="_model.Name" MaxLength="80" Placeholder="Nombre"
                                   HtmlAttributes="@(new Dictionary<string, object> { { "maxlength", "80" } })" />
                        <ValidationMessage For="@(() => _model.Name)" />
                    </div>
                    <div>
                        <label>Nombre Corto</label>
                        <SfTextBox @bind-Value="_model.ShortName" MaxLength="40" Placeholder="Nombre corto"
                                   HtmlAttributes="@(new Dictionary<string, object> { { "maxlength", "40" } })" />
                        <ValidationMessage For="@(() => _model.ShortName)" />
                    </div>
                    <div>
                        @* Feature 012 (T178): el municipio DIVIPOLA de la sucursal; ReteICA de compras lo propone y la
                           carga de plantillas lo exige. Sólo las ciudades con código DANE. *@
                        <label>Municipio (DIVIPOLA)</label>
                        <SfDropDownList TValue="string" TItem="MunicipioItem" @bind-Value="_model.MunicipalityDaneCode"
                                        DataSource="@_municipios" AllowFiltering="true" ShowClearButton="true"
                                        Placeholder="Seleccione el municipio">
                            <DropDownListFieldSettings Text="@nameof(MunicipioItem.Etiqueta)" Value="@nameof(MunicipioItem.DaneCode)" />
                        </SfDropDownList>
                        <small class="hint">Si el municipio no aparece, cárguelo con su código DANE en Maestros › Ciudades.</small>
                    </div>
                </div>
                @* Submit oculto: permite ENTER y dispara OnValidSubmit con validacion *@
                <button type="submit" id="agencias-submit" style="display:none"></button>
            </EditForm>
        </IndicadorDeCarga>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@CancelDialog" />
        <DialogButton Content="Guardar" IsPrimary="true" OnClick="@Save" Disabled="@(_saving || _guardado.Activa)" />
    </DialogButtons>
</SfDialog>

<ConfirmDialog @bind-Visible="_showConfirm" OnConfirm="ConfirmDelete"
               Message="¿Esta seguro de eliminar esta agencia?" />

@code {
    // Indicadores de carga por zona (ver docs/manual/indicador-de-carga.md).
    private readonly EstadoDeCarga _carga = new(), _guardado = new();
    private SfGrid<BranchItem>? _grid;
    private List<BranchItem> _items = new();
    private List<MunicipioItem> _municipios = new();
    private BranchModel _model = new();
    private Guid? _editId;
    private bool _codigoRepetido;
    private bool _showDialog, _showConfirm, _saving;
    private string _dialogTitle = "";
    private Guid _deleteId;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        using var carga = _carga.Iniciar();
        try
        {
            // GetListAsync (extension en HttpClientListExtensions) deserializa indistintamente
            // PagedList<T> { items: [...] } o un array plano.
            _items = await Http.GetListAsync<BranchItem>(
                "/api/core/branches?PageNumber=1&PageSize=500&SortBy=name");
            var ciudades = await Http.GetListAsync<CiudadItem>("/api/core/cities?PageNumber=1&PageSize=2000");
            _municipios = ciudades
                .Where(c => !string.IsNullOrWhiteSpace(c.DaneCode))
                .Select(c => new MunicipioItem(c.DaneCode!, $"{c.Name} ({c.DepartmentName}) — {c.DaneCode}"))
                .OrderBy(m => m.Etiqueta)
                .ToList();
        }
        catch (Exception ex)
        {
            _items = new List<BranchItem>();
            await Notification.ErrorAsync($"No se pudieron cargar las agencias: {ex.Message}");
        }
        finally
        {
            // Forza el repintado del grid con el nuevo DataSource.
            await InvokeAsync(StateHasChanged);
            if (_grid is not null)
                await _grid.Refresh();
        }
    }

    private void OpenCreate()
    {
        _model = new BranchModel();
        _editId = null;
        _dialogTitle = "Nueva Agencia";
        _showDialog = true;
    }

    private void EditarExistente(Guid publicId)
    {
        var existente = _items.FirstOrDefault(i => i.PublicId == publicId);
        if (existente is not null) { _codigoRepetido = false; OpenEdit(existente); }
    }

    private void OpenEdit(BranchItem item)
    {
        _model = new BranchModel
        {
            Code = item.Code,
            Name = item.Name,
            ShortName = item.ShortName,
            MunicipalityDaneCode = item.MunicipalityDaneCode,
            // El PUT reemplaza el vínculo con la oficina: se devuelve el que tenía para no borrarlo al editar.
            TenantBranchPublicId = item.TenantBranchPublicId
        };
        _editId = item.PublicId;
        _dialogTitle = "Editar Agencia";
        _showDialog = true;
    }

    private void OpenDelete(BranchItem item)
    {
        _deleteId = item.PublicId;
        _showConfirm = true;
    }

    private void CancelDialog()
    {
        _showDialog = false;
        _model = new BranchModel();
        _editId = null;
    }

    private async Task Save()
    {
        using var guardado = _guardado.Iniciar();
        if (_codigoRepetido)
        {
            await Notification.WarningAsync("Ese código ya existe: editá ese registro o usá otro código.");
            return;
        }
        if (_saving) return;

        // Validacion cliente minima (alineada al CreateBranchCommandValidator del backend).
        if (string.IsNullOrWhiteSpace(_model.Name))
        {
            await Notification.WarningAsync("El nombre es obligatorio.");
            return;
        }
        if (_model.Name.Length > 80)
        {
            await Notification.WarningAsync("El nombre no puede superar 80 caracteres.");
            return;
        }
        if (!string.IsNullOrEmpty(_model.ShortName) && _model.ShortName.Length > 40)
        {
            await Notification.WarningAsync("El nombre corto no puede superar 40 caracteres.");
            return;
        }

        _saving = true;
        // Limpiar el desplegable lo deja nulo, y nulo es «no cambia» en el servidor: vacío es el que quita el municipio.
        _model.MunicipalityDaneCode ??= string.Empty;
        try
        {
            HttpResponseMessage res;
            if (_editId.HasValue)
            {
                // El endpoint completa el PublicId desde la ruta, asi que basta enviar el cuerpo.
                res = await Http.PutAsJsonAsync($"/api/core/branches/{_editId}", _model);
            }
            else
            {
                res = await Http.PostAsJsonAsync("/api/core/branches", _model);
            }

            if (res.IsSuccessStatusCode)
            {
                await Notification.SuccessAsync(_editId.HasValue
                    ? "Agencia actualizada correctamente."
                    : "Agencia creada correctamente.");
                _showDialog = false;
                _editId = null;
                _model = new BranchModel();
                await LoadData();
            }
            else
            {
                await Notification.ShowErrorAsync(res, "Error al guardar la agencia");
            }
        }
        catch (Exception ex)
        {
            await Notification.ErrorAsync($"Error inesperado al guardar: {ex.Message}");
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ConfirmDelete()
    {
        try
        {
            var res = await Http.DeleteAsync($"/api/core/branches/{_deleteId}");
            if (res.IsSuccessStatusCode)
            {
                await Notification.SuccessAsync("Agencia eliminada correctamente.");
                await LoadData();
            }
            else
            {
                await Notification.ShowErrorAsync(res, "Error al eliminar la agencia");
            }
        }
        catch (Exception ex)
        {
            await Notification.ErrorAsync($"Error inesperado al eliminar: {ex.Message}");
        }
    }

    /// <summary>
    /// Modelo enviado al endpoint POST/PUT. Coincide con CreateBranchCommand y UpdateBranchCommand.
    /// Anotaciones espejo del CreateBranchCommandValidator (FluentValidation) en el backend.
    /// </summary>
    private class BranchModel
    {
        public string? Code { get; set; }
        [Required(ErrorMessage = "El nombre es obligatorio.")]
        [MaxLength(80, ErrorMessage = "El nombre no puede superar 80 caracteres.")]
        public string Name { get; set; } = string.Empty;

        [MaxLength(40, ErrorMessage = "El nombre corto no puede superar 40 caracteres.")]
        public string? ShortName { get; set; }

        /// <summary>Vacío (no nulo) quita el municipio; el servidor toma nulo como «no cambia».</summary>
        public string? MunicipalityDaneCode { get; set; } = string.Empty;

        public Guid? TenantBranchPublicId { get; set; }
    }

    /// <summary>Una ciudad de <c>/api/core/cities</c> (CityDto).</summary>
    private sealed record CiudadItem(string Name, string DepartmentName, string? DaneCode);

    /// <summary>Opción del desplegable de municipio.</summary>
    private sealed record MunicipioItem(string DaneCode, string Etiqueta);

    /// <summary>
    /// Vista que pinta la grilla. Coincide con BranchDto.
    /// </summary>
    private class BranchItem
    {
        public string? Code { get; set; }
        public Guid PublicId { get; set; }
        public string Name { get; set; } = string.Empty;
        public string? ShortName { get; set; }
        public string? MunicipalityDaneCode { get; set; }
        public Guid? TenantBranchPublicId { get; set; }
    }
}
