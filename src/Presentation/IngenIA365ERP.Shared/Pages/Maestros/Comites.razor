@page "/maestros/comites"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification

<PageTitle>Comites - IngenIA365ERP</PageTitle>

<div class="page-header" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;">
    <h3>Comites</h3>
    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
        <SfTextBox Placeholder="Buscar comite..." @bind-Value="_search" Width="280px"
                   ValueChange="@((Syncfusion.Blazor.Inputs.ChangedEventArgs e) => OnSearchChanged())" />
        <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@OpenCreate">Nuevo Comite</SfButton>
    </div>
</div>

<SfGrid @ref="_grid" TValue="CommitteeRow" DataSource="@_items"
        AllowPaging="true" AllowSorting="true" AllowFiltering="true">
    <GridPageSettings PageSize="20" />
    <GridColumns>
        <GridColumn Field="@nameof(CommitteeRow.Name)" HeaderText="Nombre" Width="320" />
        <GridColumn Field="@nameof(CommitteeRow.ShortName)" HeaderText="Nombre Corto" Width="200" />
        <GridColumn HeaderText="Tipo" Width="160">
            <Template>
                @{
                    var c = context as CommitteeRow;
                    var label = _committeeTypes.FirstOrDefault(t => t.Value == c?.CommitteeType)?.Name ?? c?.CommitteeType;
                    <span>@label</span>
                }
            </Template>
        </GridColumn>
        <GridColumn HeaderText="Acciones" Width="150" TextAlign="TextAlign.Center" AllowFiltering="false" AllowSorting="false">
            <Template>
                @{
                    var c = context as CommitteeRow;
                    <SfButton CssClass="e-flat e-small" IconCss="e-icons e-edit"
                              OnClick="@(() => OpenEdit(c!))" Title="Editar" />
                    <SfButton CssClass="e-flat e-small e-danger" IconCss="e-icons e-trash"
                              OnClick="@(() => OpenDelete(c!))" Title="Eliminar" />
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

<SfDialog @bind-Visible="_showDialog" Header="@_dialogTitle" Width="500px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <EditForm Model="_model" OnValidSubmit="Save">
                <DataAnnotationsValidator />
                <div style="padding:10px;display:flex;flex-direction:column;gap:14px;">
                    <div>
                        <label>Nombre <span style="color:red">*</span></label>
                        <SfTextBox @bind-Value="_model.Name" Placeholder="Nombre del comite"
                                   HtmlAttributes="@(new Dictionary<string, object> { { "maxlength", "80" } })" />
                        <ValidationMessage For="@(() => _model.Name)" />
                    </div>
                    <div>
                        <label>Nombre Corto</label>
                        <SfTextBox @bind-Value="_model.ShortName" Placeholder="Nombre corto"
                                   HtmlAttributes="@(new Dictionary<string, object> { { "maxlength", "60" } })" />
                    </div>
                    <div>
                        <label>Tipo de Comite</label>
                        <SfDropDownList TValue="string" TItem="CodeOption"
                                        @bind-Value="_model.CommitteeType"
                                        DataSource="@_committeeTypes"
                                        Placeholder="Seleccione tipo">
                            <DropDownListFieldSettings Text="Name" Value="Value" />
                        </SfDropDownList>
                    </div>
                </div>
                <button type="submit" id="comites-submit" style="display:none"></button>
            </EditForm>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@CancelDialog" />
        <DialogButton Content="Guardar" IsPrimary="true" OnClick="@Save" Disabled="@_saving" />
    </DialogButtons>
</SfDialog>

<ConfirmDialog @bind-Visible="_showConfirm" OnConfirm="ConfirmDelete"
               Message="¿Esta seguro de eliminar este comite?" />

@code {
    private SfGrid<CommitteeRow>? _grid;
    private List<CommitteeRow> _items = new();
    private string _search = "";
    private System.Threading.CancellationTokenSource? _searchDebounce;

    private bool _showDialog, _showConfirm, _saving;
    private string _dialogTitle = "";
    private CommitteeModel _model = new();
    private Guid? _editId;
    private Guid _deleteId;

    private List<CodeOption> _committeeTypes = new()
    {
        new("DP", "Deportivo"),
        new("CL", "Cultural"),
        new("ED", "Educativo"),
        new("RC", "Recreacion"),
        new("AD", "Administrativo"),
        new("OT", "Otro")
    };

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        try
        {
            var url = "/api/core/committees?PageNumber=1&PageSize=500";
            if (!string.IsNullOrWhiteSpace(_search))
                url += $"&SearchTerm={Uri.EscapeDataString(_search)}";

            _items = await Http.GetListAsync<CommitteeRow>(url);
        }
        catch (Exception ex)
        {
            _items = new List<CommitteeRow>();
            await Notification.ErrorAsync($"No se pudieron cargar los comites: {ex.Message}");
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
            if (_grid is not null) await _grid.Refresh();
        }
    }

    private async Task OnSearchChanged()
    {
        _searchDebounce?.Cancel();
        _searchDebounce = new System.Threading.CancellationTokenSource();
        var token = _searchDebounce.Token;
        try
        {
            await Task.Delay(350, token);
            if (!token.IsCancellationRequested) await LoadData();
        }
        catch (TaskCanceledException) { /* expected */ }
    }

    private void OpenCreate()
    {
        _model = new CommitteeModel();
        _editId = null;
        _dialogTitle = "Nuevo Comite";
        _showDialog = true;
    }

    private void OpenEdit(CommitteeRow row)
    {
        _model = new CommitteeModel
        {
            Name = row.Name,
            ShortName = row.ShortName,
            CommitteeType = row.CommitteeType
        };
        _editId = row.PublicId;
        _dialogTitle = "Editar Comite";
        _showDialog = true;
    }

    private void OpenDelete(CommitteeRow row)
    {
        _deleteId = row.PublicId;
        _showConfirm = true;
    }

    private void CancelDialog()
    {
        _showDialog = false;
        _model = new CommitteeModel();
        _editId = null;
    }

    private async Task Save()
    {
        if (_saving) return;

        if (string.IsNullOrWhiteSpace(_model.Name))
        {
            await Notification.WarningAsync("El nombre es obligatorio.");
            return;
        }

        _saving = true;
        try
        {
            var payload = new
            {
                Name = _model.Name,
                ShortName = _model.ShortName,
                CommitteeType = _model.CommitteeType
            };

            HttpResponseMessage res;
            if (_editId.HasValue)
                res = await Http.PutAsJsonAsync($"/api/core/committees/{_editId}", payload);
            else
                res = await Http.PostAsJsonAsync("/api/core/committees", payload);

            if (res.IsSuccessStatusCode)
            {
                await Notification.SuccessAsync(_editId.HasValue
                    ? "Comite actualizado."
                    : "Comite creado.");
                _showDialog = false;
                _model = new CommitteeModel();
                _editId = null;
                await LoadData();
            }
            else
            {
                await Notification.ShowErrorAsync(res, "Error al guardar comite");
            }
        }
        catch (Exception ex)
        {
            await Notification.ErrorAsync($"Error inesperado: {ex.Message}");
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ConfirmDelete()
    {
        try
        {
            var res = await Http.DeleteAsync($"/api/core/committees/{_deleteId}");
            if (res.IsSuccessStatusCode)
            {
                await Notification.SuccessAsync("Comite eliminado.");
                await LoadData();
            }
            else
            {
                await Notification.ShowErrorAsync(res, "Error al eliminar comite");
            }
        }
        catch (Exception ex)
        {
            await Notification.ErrorAsync($"Error inesperado: {ex.Message}");
        }
    }

    private class CommitteeRow
    {
        public Guid PublicId { get; set; }
        public string Name { get; set; } = "";
        public string? ShortName { get; set; }
        public string? CommitteeType { get; set; }
    }

    private class CommitteeModel
    {
        [Required(ErrorMessage = "Nombre obligatorio.")]
        [MaxLength(80, ErrorMessage = "Nombre no puede superar 80 caracteres.")]
        public string Name { get; set; } = "";

        [MaxLength(60)]
        public string? ShortName { get; set; }

        [MaxLength(2)]
        public string? CommitteeType { get; set; }
    }

    private record CodeOption(string Value, string Name);
}
