@page "/maestros/ciudades"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification

<PageTitle>Ciudades - IngenIA365ERP</PageTitle>

<div class="page-header">
    <h3>Ciudades</h3>
    <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@OpenCreate">Nuevo</SfButton>
</div>

<SfGrid @ref="_grid" TValue="CityItem" DataSource="@_items"
    AllowPaging="true" AllowSorting="true" AllowFiltering="true">
    <GridColumns>
        <GridColumn Field="Name" HeaderText="Nombre" Width="250" />
        <GridColumn Field="ShortName" HeaderText="Nombre Corto" Width="150" />
        <GridColumn Field="DepartmentName" HeaderText="Departamento" Width="200" />
        <GridColumn HeaderText="Acciones" Width="150" TextAlign="TextAlign.Center">
            <Template>
                @{
                    var item = context as CityItem;
                    <SfButton CssClass="e-flat e-small" IconCss="e-icons e-edit" OnClick="@(() => OpenEdit(item!))" />
                    <SfButton CssClass="e-flat e-small e-danger" IconCss="e-icons e-trash" OnClick="@(() => OpenDelete(item!))" />
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

<SfDialog @bind-Visible="_showDialog" Header="@_dialogTitle" Width="500px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <div style="padding:10px;display:flex;flex-direction:column;gap:16px;">
                <div>
                    <label>Nombre *</label>
                    <SfTextBox @bind-Value="_model.Name" Placeholder="Nombre" />
                </div>
                <div>
                    <label>Nombre Corto</label>
                    <SfTextBox @bind-Value="_model.ShortName" Placeholder="Nombre corto" />
                </div>
                <div>
                    <label>Departamento *</label>
                    <SfDropDownList TValue="Guid?" TItem="DepartmentOption" DataSource="@_departments"
                        @bind-Value="_model.DepartmentId" Placeholder="Seleccione departamento">
                        <DropDownListFieldSettings Text="Name" Value="PublicId" />
                    </SfDropDownList>
                </div>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _showDialog = false)" />
        <DialogButton Content="Guardar" IsPrimary="true" OnClick="@Save" />
    </DialogButtons>
</SfDialog>

<ConfirmDialog @bind-Visible="_showConfirm" OnConfirm="ConfirmDelete"
    Message="Esta seguro de eliminar este registro?" />

@code {
    private SfGrid<CityItem>? _grid;
    private List<CityItem> _items = [];
    private List<DepartmentOption> _departments = [];
    private CityModel _model = new();
    private Guid? _editId;
    private bool _showDialog, _showConfirm;
    private string _dialogTitle = "";
    private Guid _deleteId;

    protected override async Task OnInitializedAsync()
    {
        await LoadDepartments();
        await LoadData();
    }

    private async Task LoadData()
    {
        try { _items = await Http.GetFromJsonAsync<List<CityItem>>("/api/core/cities?pageSize=500") ?? []; }
        catch { _items = []; }
    }

    private async Task LoadDepartments()
    {
        try { _departments = await Http.GetFromJsonAsync<List<DepartmentOption>>("/api/core/departments?pageSize=500") ?? []; }
        catch { _departments = []; }
    }

    private void OpenCreate() { _model = new(); _editId = null; _dialogTitle = "Nueva Ciudad"; _showDialog = true; }

    private void OpenEdit(CityItem item)
    {
        _model = new() { Name = item.Name, ShortName = item.ShortName, DepartmentId = item.DepartmentId };
        _editId = item.PublicId;
        _dialogTitle = "Editar Ciudad";
        _showDialog = true;
    }

    private void OpenDelete(CityItem item) { _deleteId = item.PublicId; _showConfirm = true; }

    private async Task Save()
    {
        HttpResponseMessage res;
        if (_editId.HasValue)
            res = await Http.PutAsJsonAsync($"/api/core/cities/{_editId}", _model);
        else
            res = await Http.PostAsJsonAsync("/api/core/cities", _model);

        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro guardado");
            _showDialog = false;
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al guardar");
    }

    private async Task ConfirmDelete()
    {
        var res = await Http.DeleteAsync($"/api/core/cities/{_deleteId}");
        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro eliminado");
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al eliminar");
    }

    private class CityItem
    {
        public Guid PublicId { get; set; }
        public string Name { get; set; } = "";
        public string? ShortName { get; set; }
        public Guid? DepartmentId { get; set; }
        public string? DepartmentName { get; set; }
    }

    private class CityModel
    {
        public string Name { get; set; } = "";
        public string? ShortName { get; set; }
        public Guid? DepartmentId { get; set; }
    }

    private class DepartmentOption
    {
        public Guid PublicId { get; set; }
        public string Name { get; set; } = "";
    }
}
