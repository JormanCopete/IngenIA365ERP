    }

    private async Task GuardarConceptoAsync()
    {
        if (_guardado.Activa) return;
        using var guardado = _guardado.Iniciar();
        var f = _fConcepto;
        var (ok, codigo, mensaje) = _conceptoEditado is { } editado
            ? Resultado(await Catalogo.EditarConceptoAsync(editado.WithholdingConceptPublicId, new EditarConceptoDeRetencionRequest(f.Nombre ?? "", f.Activo, f.Notas, f.Motivo ?? ""), _clave))
            : Resultado(await Catalogo.CrearConceptoAsync(new CrearConceptoDeRetencionRequest(f.Codigo ?? "", f.Nombre ?? "", f.Notas, f.Motivo ?? ""), _clave));
