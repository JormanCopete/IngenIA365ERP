    // ------------------------------------------------------------------------------------------ ayudantes --

    private static (bool Ok, string? Codigo, string? Mensaje) Resultado<T>(IngenIA365ERP.Shared.Services.Security.InvitationApiResult<T> r) =>
        (r.IsSuccess, r.ErrorCode, r.ErrorMessage);

    private Task AvisarAsync(string? codigo, string? mensaje, string porDefecto) =>
        Notification.ErrorAsync(codigo == "Generic.NotFound" ? NotificationServiceExtensions.SinPermiso : mensaje ?? porDefecto);

    private static string? Nulo(string? texto) => string.IsNullOrWhiteSpace(texto) ? null : texto.Trim();

    private sealed class FormularioDeImpuesto
    {
        public string? Codigo { get; set; }
        public string? Nombre { get; set; }
        public int Clase { get; set; } = 1;
        public int Forma { get; set; } = 1;
        public string CalculadoSobre { get; set; } = "";
        public bool EsRetencion { get; set; }
        public string? CodigoDian { get; set; }
        public bool Activo { get; set; } = true;
        public string? Notas { get; set; }
        public string? Motivo { get; set; }
    }

    private sealed class CondicionDeFormulario(string etiqueta, string valor)
    {
        public string Etiqueta { get; } = etiqueta;
        public string Valor { get; set; } = valor;
        public bool? Leer() => Valor switch { "si" => true, "no" => false, _ => null };
        public static string Escribir(bool? v) => v switch { true => "si", false => "no", _ => "" };
    }

    private sealed class FormularioDeTarifa
    {
        public string Impuesto { get; set; } = "";
        public string? Codigo { get; set; }
        public string? Nombre { get; set; }
        public decimal? Puntos { get; set; }
        public decimal? ValorPorUnidad { get; set; }
        public string Concepto { get; set; } = "";
        public string? Municipio { get; set; }
        public string? Actividad { get; set; }
        public decimal? BaseUvt { get; set; }
        public decimal? BasePesos { get; set; }
        public int AplicaA { get; set; } = 3;
        public int Prioridad { get; set; }
        public DateTime? Desde { get; set; } = DateTime.Today;
        public DateTime? Hasta { get; set; }
        public string TipoPersona { get; set; } = "";
        public string? Norma { get; set; }
        public string? Notas { get; set; }
        public string? Motivo { get; set; }

        public List<CondicionDeFormulario> Condiciones { get; } =
        [
            new("Sujeto declarante", ""), new("Sujeto responsable de IVA", ""), new("Sujeto gran contribuyente", ""),
            new("Sujeto autorretenedor", ""), new("Sujeto del régimen simple", ""), new("Agente gran contribuyente", ""),
            new("Agente retenedor de IVA", ""),
        ];

        public CondicionesDeTarifaDto CondicionesDto() => new()
        {
            SubjectPersonType = string.IsNullOrEmpty(TipoPersona) ? null : TipoPersona,
            SubjectIsIncomeTaxFiler = Condiciones[0].Leer(),
            SubjectIsVatResponsible = Condiciones[1].Leer(),
            SubjectIsLargeContributor = Condiciones[2].Leer(),
            SubjectIsSelfWithholder = Condiciones[3].Leer(),
            SubjectIsSimpleTaxRegime = Condiciones[4].Leer(),
            AgentIsLargeContributor = Condiciones[5].Leer(),
            AgentIsVatWithholdingAgent = Condiciones[6].Leer(),
        };

        /// <summary>El formulario con los datos de una tarifa: para corregirla o para abrir su vigencia siguiente.</summary>
        public static FormularioDeTarifa DeTarifa(TarifaTributariaDto t, bool nuevaVigencia)
        {
            var f = new FormularioDeTarifa
            {
                Impuesto = t.TaxPublicId.ToString(), Codigo = t.Code, Nombre = t.Name,
                Puntos = t.Rate is { } r ? r * 100m : null, ValorPorUnidad = t.AmountPerUnit,
                Concepto = t.WithholdingConceptPublicId?.ToString() ?? "", Municipio = t.MunicipalityDaneCode, Actividad = t.ActivityCode,
                BaseUvt = t.MinimumBaseUvt, BasePesos = t.MinimumBasePesos, AplicaA = t.AppliesTo, Prioridad = t.Priority,
                Desde = nuevaVigencia ? (t.ValidTo is { } h ? h.AddDays(1).ToDateTime(TimeOnly.MinValue) : DateTime.Today) : t.ValidFrom.ToDateTime(TimeOnly.MinValue),
                Hasta = nuevaVigencia ? null : t.ValidTo?.ToDateTime(TimeOnly.MinValue),
                TipoPersona = t.Conditions.SubjectPersonType ?? "", Norma = t.LegalSource, Notas = t.Notes,
            };
            var c = t.Conditions;
            bool?[] valores = [c.SubjectIsIncomeTaxFiler, c.SubjectIsVatResponsible, c.SubjectIsLargeContributor, c.SubjectIsSelfWithholder,
                c.SubjectIsSimpleTaxRegime, c.AgentIsLargeContributor, c.AgentIsVatWithholdingAgent];
            for (var i = 0; i < valores.Length; i++) f.Condiciones[i].Valor = CondicionDeFormulario.Escribir(valores[i]);
            return f;
        }
    }

    private sealed class FormularioDeConcepto
    {
        public string? Codigo { get; set; }
        public string? Nombre { get; set; }
        public bool Activo { get; set; } = true;
        public string? Notas { get; set; }
        public string? Motivo { get; set; }
    }
}
