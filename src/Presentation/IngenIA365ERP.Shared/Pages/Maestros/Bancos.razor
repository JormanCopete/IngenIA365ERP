@page "/maestros/bancos"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification
@inject PersonasClient Personas
@inject PermisosDelUsuario Permisos

<PageTitle>Bancos - IngenIA365ERP</PageTitle>

<div class="page-header">
    <h3>Bancos</h3>
    <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@OpenCreate">Nuevo</SfButton>
</div>

<IndicadorDeCarga Cargando="@_carga.Activa">
<SfGrid @ref="_grid" TValue="BankItem" DataSource="@_items"
    AllowPaging="true" AllowSorting="true" AllowFiltering="true">
    <GridColumns>
        <GridColumn Field="@nameof(BankItem.Code)" HeaderText="Código" Width="120" />
        <GridColumn Field="Name" HeaderText="Nombre" Width="250" />
        <GridColumn Field="ShortName" HeaderText="Nombre Corto" Width="150" />
        <GridColumn Field="AccountCode" HeaderText="Cuenta Contable" Width="150" />
        <GridColumn Field="VoucherTypeCode" HeaderText="Tipo Comprobante" Width="150" />
        <GridColumn Field="CheckDigitRequired" HeaderText="Digito Chequeo" Width="130" DisplayAsCheckBox="true" />
        <GridColumn Field="FinancialTaxRate" HeaderText="% GMF" Width="100" Format="N4" TextAlign="TextAlign.Right" />
        <GridColumn HeaderText="Acciones" Width="150" TextAlign="TextAlign.Center">
            <Template>
                @{
                    var item = context as BankItem;
                    <SfButton CssClass="e-flat e-small" IconCss="e-icons e-edit" OnClick="@(() => OpenEdit(item!))" />
                    <SfButton CssClass="e-flat e-small e-danger" IconCss="e-icons e-trash" OnClick="@(() => OpenDelete(item!))" />
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>
</IndicadorDeCarga>

<SfDialog @bind-Visible="_showDialog" Header="@_dialogTitle" Width="550px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@_guardado.Activa" Texto="Guardando…">
            <div class="pagina">
                <div>
                    <CampoCodigo Catalogo="bancos" @bind-Value="_model.Code" Largo="10"
                                 EditandoPublicId="_editId" OnEditarExistente="EditarExistente" DuplicadoChanged="@(d => _codigoRepetido = d)" />
                </div>
                <div>
                    <label>Nombre <span class="obligatorio">*</span></label>
                    <SfTextBox @bind-Value="_model.Name" MaxLength="80" Placeholder="Nombre del banco" />
                </div>
                <div>
                    <label>Nombre Corto</label>
                    <SfTextBox @bind-Value="_model.ShortName" MaxLength="30" Placeholder="Nombre corto" />
                </div>
                <div>
                    <label>Cuenta Contable</label>
                    <SfTextBox @bind-Value="_model.AccountCode" MaxLength="20" Placeholder="Codigo cuenta contable" />
                </div>
                <div>
                    <label>Tipo Comprobante</label>
                    <SfTextBox @bind-Value="_model.VoucherTypeCode" MaxLength="10" Placeholder="Codigo tipo comprobante" />
                </div>
                <div>
                    <SfCheckBox @bind-Checked="_model.CheckDigitRequired" Label="Requiere Digito de Chequeo" />
                </div>
                <div class="campo">
                    <label>Persona que lo representa como tercero (feature 009)</label>
                    <PersonSearchPicker @bind-Selected="_persona" ShowHelpText="false" PermitirCrear="@_puedeCrearPersona" OnCrearPersona="@CrearPersonaAsync" TextoSinResultados="Regístrela en Maestros › Personas y vuelva a buscarla." />
                    <span class="texto-tenue">Con ella se contabilizan los aportes en las cuentas que exigen tercero.</span>
                </div>
                <div>
                    <label>Tasa GMF (%)</label>
                    <SfNumericTextBox TValue="decimal?" @bind-Value="_model.FinancialTaxRate"
                        Placeholder="0.0000" Decimals="4" Format="N4" Min="0" Max="100" Step="0.0001m" />
                </div>
            </div>
        </IndicadorDeCarga>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _showDialog = false)" />
        <DialogButton Content="Guardar" IsPrimary="true" OnClick="@Save" Disabled="@_guardado.Activa" />
    </DialogButtons>
</SfDialog>

<PersonaDialog @bind-Visible="_mostrarPersona" DocumentoInicial="@_documentoInicial" OnGuardado="@PersonaGuardadaAsync" />

<ConfirmDialog @bind-Visible="_showConfirm" OnConfirm="ConfirmDelete"
    Message="Esta seguro de eliminar este registro?" />

@code {
    // Indicadores de carga por zona (ver docs/manual/indicador-de-carga.md).
    private readonly EstadoDeCarga _carga = new(), _guardado = new();
    private SfGrid<BankItem>? _grid;
    private List<BankItem> _items = [];
    private BankModel _model = new();
    private Guid? _editId;
    private bool _codigoRepetido;
    private bool _showDialog, _showConfirm;
    private string _dialogTitle = "";
    private Guid _deleteId;

    protected override async Task OnInitializedAsync()
    {
        _puedeCrearPersona = await Permisos.TieneAsync("Core.People.Create");
        await LoadData();
    }

    private async Task LoadData()
    {
        using var carga = _carga.Iniciar();
        try { _items = await Http.GetListAsync<BankItem>("/api/core/banks?pageSize=500") ?? []; }
        catch (Exception ex) { _items = []; await Notification.ErrorAsync($"No se pudo cargar la lista: {ex.Message}"); }
    }

    private void OpenCreate() { _model = new(); _persona = null; _editId = null; _dialogTitle = "Nuevo Banco"; _showDialog = true; }

    private void EditarExistente(Guid publicId)
    {
        var existente = _items.FirstOrDefault(i => i.PublicId == publicId);
        if (existente is not null) { _codigoRepetido = false; OpenEdit(existente); }
    }

    private void OpenEdit(BankItem item)
    {
        _model = new()
        {
            Code = item.Code,
            Name = item.Name,
            ShortName = item.ShortName,
            AccountCode = item.AccountCode,
            VoucherTypeCode = item.VoucherTypeCode,
            CheckDigitRequired = item.CheckDigitRequired,
            FinancialTaxRate = item.FinancialTaxRate,
            PersonPublicId = item.PersonPublicId
        };
        _persona = item.PersonPublicId is { } pid ? new PersonSearchPicker.PersonSearchItem { PublicId = pid, FullName = item.PersonName ?? "" } : null;
        _editId = item.PublicId;
        _dialogTitle = "Editar Banco";
        _showDialog = true;
    }

    private void OpenDelete(BankItem item) { _deleteId = item.PublicId; _showConfirm = true; }

    private async Task Save()
    {
        using var guardado = _guardado.Iniciar();
        _model.PersonPublicId = _persona?.PublicId;
        if (_codigoRepetido)
        {
            await Notification.WarningAsync("Ese código ya existe: editá ese registro o usá otro código.");
            return;
        }
        HttpResponseMessage res;
        if (_editId.HasValue)
            res = await Http.PutAsJsonAsync($"/api/core/banks/{_editId}", _model);
        else
            res = await Http.PostAsJsonAsync("/api/core/banks", _model);

        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro guardado");
            _showDialog = false;
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al guardar");
    }

    private async Task ConfirmDelete()
    {
        var res = await Http.DeleteAsync($"/api/core/banks/{_deleteId}");
        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro eliminado");
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al eliminar");
    }

    private class BankItem
    {
        public Guid? PersonPublicId { get; set; }
        public string? PersonName { get; set; }
        public string? Code { get; set; }
        public Guid PublicId { get; set; }
        public string Name { get; set; } = "";
        public string? ShortName { get; set; }
        public string? AccountCode { get; set; }
        public string? VoucherTypeCode { get; set; }
        public bool CheckDigitRequired { get; set; }
        public decimal? FinancialTaxRate { get; set; }
    }

    private class BankModel
    {
        public Guid? PersonPublicId { get; set; }
        public string? Code { get; set; }
        public string Name { get; set; } = "";
        public string? ShortName { get; set; }
        public string? AccountCode { get; set; }
        public string? VoucherTypeCode { get; set; }
        public bool CheckDigitRequired { get; set; }
        public decimal? FinancialTaxRate { get; set; }
    }
    // Feature 009 (FR-088): la persona que representa a la entidad como tercero contable.
    private PersonSearchPicker.PersonSearchItem? _persona;
    private bool _puedeCrearPersona;
    private bool _mostrarPersona;
    private string? _documentoInicial;

    private async Task CrearPersonaAsync(string termino)
    {
        _documentoInicial = termino.All(char.IsDigit) ? termino : null;
        _mostrarPersona = true;
        await Task.CompletedTask;
    }

    private async Task PersonaGuardadaAsync(Guid publicId)
    {
        _mostrarPersona = false;
        var r = await Personas.ObtenerAsync(publicId);
        if (r.IsSuccess && r.Value is { } p)
            _persona = new PersonSearchPicker.PersonSearchItem { PublicId = p.PublicId, IdentificationNumber = p.TaxId, FullName = string.IsNullOrWhiteSpace(p.BusinessName) ? $"{p.FirstName} {p.LastName}".Trim() : p.BusinessName };
    }
}
