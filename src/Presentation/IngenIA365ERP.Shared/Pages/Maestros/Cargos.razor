@page "/maestros/cargos"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification

<PageTitle>Cargos - IngenIA365ERP</PageTitle>

<div class="page-header">
    <h3>Cargos</h3>
    <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@OpenCreate">Nuevo</SfButton>
</div>

<IndicadorDeCarga Cargando="@_carga.Activa">
<SfGrid @ref="_grid" TValue="PositionItem" DataSource="@_items"
    AllowPaging="true" AllowSorting="true" AllowFiltering="true">
    <GridColumns>
        <GridColumn Field="@nameof(PositionItem.Code)" HeaderText="Código" Width="120" />
        <GridColumn Field="Name" HeaderText="Nombre" Width="300" />
        <GridColumn Field="ShortName" HeaderText="Nombre Corto" Width="200" />
        <GridColumn HeaderText="Acciones" Width="150" TextAlign="TextAlign.Center">
            <Template>
                @{
                    var item = context as PositionItem;
                    <SfButton CssClass="e-flat e-small" IconCss="e-icons e-edit" OnClick="@(() => OpenEdit(item!))" />
                    <SfButton CssClass="e-flat e-small e-danger" IconCss="e-icons e-trash" OnClick="@(() => OpenDelete(item!))" />
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>
</IndicadorDeCarga>

<SfDialog @bind-Visible="_showDialog" Header="@_dialogTitle" Width="450px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@_guardado.Activa" Texto="Guardando…">
            <div class="pagina">
                <div>
                    <CampoCodigo Catalogo="cargos" @bind-Value="_model.Code" Largo="10"
                                 EditandoPublicId="_editId" OnEditarExistente="EditarExistente" DuplicadoChanged="@(d => _codigoRepetido = d)" />
                </div>
                <div>
                    <label>Nombre <span class="obligatorio">*</span></label>
                    <SfTextBox @bind-Value="_model.Name" MaxLength="80" Placeholder="Nombre" />
                </div>
                <div>
                    <label>Nombre Corto</label>
                    <SfTextBox @bind-Value="_model.ShortName" MaxLength="40" Placeholder="Nombre corto" />
                </div>
            </div>
        </IndicadorDeCarga>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _showDialog = false)" />
        <DialogButton Content="Guardar" IsPrimary="true" OnClick="@Save" Disabled="@_guardado.Activa" />
    </DialogButtons>
</SfDialog>

<ConfirmDialog @bind-Visible="_showConfirm" OnConfirm="ConfirmDelete"
    Message="Esta seguro de eliminar este registro?" />

@code {
    // Indicadores de carga por zona (ver docs/manual/indicador-de-carga.md).
    private readonly EstadoDeCarga _carga = new(), _guardado = new();
    private SfGrid<PositionItem>? _grid;
    private List<PositionItem> _items = [];
    private PositionItem _model = new();
    private Guid? _editId;
    private bool _codigoRepetido;
    private bool _showDialog, _showConfirm;
    private string _dialogTitle = "";
    private Guid _deleteId;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        using var carga = _carga.Iniciar();
        try { _items = await Http.GetListAsync<PositionItem>("/api/core/positions?pageSize=500") ?? []; }
        catch (Exception ex) { _items = []; await Notification.ErrorAsync($"No se pudo cargar la lista: {ex.Message}"); }
    }

    private void OpenCreate() { _model = new(); _editId = null; _dialogTitle = "Nuevo Cargo"; _showDialog = true; }
    private void EditarExistente(Guid publicId)
    {
        var existente = _items.FirstOrDefault(i => i.PublicId == publicId);
        if (existente is not null) { _codigoRepetido = false; OpenEdit(existente); }
    }

    private void OpenEdit(PositionItem item) { _model = new() { Code = item.Code, Name = item.Name, ShortName = item.ShortName }; _editId = item.PublicId; _dialogTitle = "Editar Cargo"; _showDialog = true; }
    private void OpenDelete(PositionItem item) { _deleteId = item.PublicId; _showConfirm = true; }

    private async Task Save()
    {
        using var guardado = _guardado.Iniciar();
        if (_codigoRepetido)
        {
            await Notification.WarningAsync("Ese código ya existe: editá ese registro o usá otro código.");
            return;
        }
        HttpResponseMessage res;
        if (_editId.HasValue)
            res = await Http.PutAsJsonAsync($"/api/core/positions/{_editId}", _model);
        else
            res = await Http.PostAsJsonAsync("/api/core/positions", _model);

        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro guardado");
            _showDialog = false;
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al guardar");
    }

    private async Task ConfirmDelete()
    {
        var res = await Http.DeleteAsync($"/api/core/positions/{_deleteId}");
        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro eliminado");
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al eliminar");
    }

    private class PositionItem
    {
        public string? Code { get; set; }
        public Guid PublicId { get; set; }
        public string Name { get; set; } = "";
        public string? ShortName { get; set; }
    }
}
