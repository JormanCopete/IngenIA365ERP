@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using IngenIA365ERP.Shared.Components.Tablero
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Inicio - IngenIA365ERP</PageTitle>

@* 2026-11-10 (pedido del dueño): el tablero muestra sólo lo que cada usuario agregó: sus accesos directos. Hasta ese día mostraba
   cifras, gráficos y nombres de ejemplo fijos en el código (asociados, cartera, créditos por vencer), iguales para todos y falsos. *@
<div class="pagina dashboard">
    <div class="dashboard-header">
        <h2>Bienvenido, @_userName</h2>
        <p class="text-muted">@_currentDate</p>
    </div>

    <AccesosDirectos />
</div>

@code {
    private string _userName = "Usuario";
    private readonly string _currentDate = DateTime.Now.ToString("dddd, dd MMMM yyyy", new System.Globalization.CultureInfo("es-CO"));

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
            _userName = authState.User.Identity.Name ?? "Usuario";
    }
}
