@page "/asociados/registro"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using IngenIA365ERP.Shared.Components.Shared
@inject HttpClient Http
@inject INotificationService Notification

<PageTitle>Asociados - IngenIA365ERP</PageTitle>

<div class="page-header">
    <h3>Asociados</h3>
    <div>
        <SfTextBox Placeholder="Buscar por documento, nombre o apellido..." @bind-Value="_search"
                   Width="320px"
                   ValueChange="@((Syncfusion.Blazor.Inputs.ChangedEventArgs e) => OnSearchChanged())" />
        <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@OpenSelectPersonDialog">Nuevo Asociado</SfButton>
    </div>
</div>

<SfGrid @ref="_grid" TValue="AssociateRow" DataSource="@_items"
        AllowPaging="true" AllowSorting="true" AllowFiltering="true">
    <GridPageSettings PageSize="20" />
    <GridColumns>
        <GridColumn Field="@nameof(AssociateRow.IdentificationNumber)" HeaderText="Documento" Width="130" />
        <GridColumn Field="@nameof(AssociateRow.FullName)" HeaderText="Nombre Completo" Width="260" />
        <GridColumn Field="@nameof(AssociateRow.JoinDate)" HeaderText="Fecha Ingreso" Width="130"
                    Format="dd/MM/yyyy" Type="ColumnType.Date" />
        <GridColumn Field="@nameof(AssociateRow.ContributionRate)" HeaderText="% Aporte" Width="100"
                    Format="N2" TextAlign="TextAlign.Right" />
        <GridColumn Field="@nameof(AssociateRow.ExternalEmployerName)" HeaderText="Empresa Empleadora" Width="200" />
        <GridColumn Field="@nameof(AssociateRow.ExternalSalary)" HeaderText="Salario" Width="140"
                    Format="N2" TextAlign="TextAlign.Right" />
        <GridColumn HeaderText="Estado" Width="110" TextAlign="TextAlign.Center">
            <Template>
                @{
                    var a = context as AssociateRow;
                    var css = a?.Status == "A" ? "e-badge e-badge-success"
                            : a?.Status == "I" ? "e-badge e-badge-warning"
                            : "e-badge e-badge-danger";
                    var label = a?.Status == "A" ? "Activo"
                              : a?.Status == "I" ? "Inactivo"
                              : a?.Status == "R" ? "Retirado" : a?.Status;
                    <span class="@css" style="padding:2px var(--pad-sm);font-size:var(--texto-xs);">@label</span>
                }
            </Template>
        </GridColumn>
        <GridColumn HeaderText="Acciones" Width="120" TextAlign="TextAlign.Center" AllowFiltering="false" AllowSorting="false">
            <Template>
                @{
                    var a = context as AssociateRow;
                    <SfButton CssClass="e-flat e-small" IconCss="e-icons e-edit"
                              OnClick="@(() => OpenEdit(a!))" Title="Editar" />
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

@* ===== Dialog: Seleccionar Persona (componente compartido) ===== *@
<SfDialog @bind-Visible="_showSelectPerson" Header="Seleccionar Persona"
          Width="600px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <div class="panel-pestana">
                <p class="muted" style="margin-bottom:var(--gap-md);">
                    Para registrar un asociado, primero seleccione la persona.
                    Si la persona aun no existe, debe crearla en
                    <a href="/maestros/personas" target="_blank">Maestros - Personas</a>.
                </p>
                <PersonSearchPicker OnPersonSelected="HandlePersonSelected"
                                    ShowHelpText="false" />
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _showSelectPerson = false)" />
    </DialogButtons>
</SfDialog>

@* ===== Dialog: Editar asociado (datos persona + datos rol) ===== *@
<SfDialog @bind-Visible="_showEditDialog" Header="@_dialogTitle" Width="900px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <SfTab>
                <TabItems>
                    @* --- Tab 1: Datos Persona (editables) --- *@
                    <TabItem>
                        <ChildContent><TabHeader Text="Datos Persona" /></ChildContent>
                        <ContentTemplate>
                            <div class="rejilla-campos panel-pestana">
                                <div>
                                    <label>Tipo Doc.</label>
                                    <SfDropDownList TValue="string" TItem="CodeOption"
                                                    @bind-Value="_personModel.IdType"
                                                    DataSource="@_idTypes">
                                        <DropDownListFieldSettings Text="Name" Value="Value" />
                                    </SfDropDownList>
                                </div>
                                <div>
                                    <label>Numero Documento <span style="color:var(--peligro-texto)">*</span></label>
                                    <SfTextBox @bind-Value="_personModel.TaxId" />
                                </div>
                                <div>
                                    <label>Nombres <span style="color:var(--peligro-texto)">*</span></label>
                                    <SfTextBox @bind-Value="_personModel.FirstName" />
                                </div>
                                <div>
                                    <label>Apellidos <span style="color:var(--peligro-texto)">*</span></label>
                                    <SfTextBox @bind-Value="_personModel.LastName" />
                                </div>
                                <div class="campo-ancho">
                                    <label>Razon Social (juridica)</label>
                                    <SfTextBox @bind-Value="_personModel.BusinessName" />
                                </div>
                                <div>
                                    <label>Email</label>
                                    <SfTextBox @bind-Value="_personModel.Email" />
                                </div>
                                <div>
                                    <label>Telefono</label>
                                    <SfTextBox @bind-Value="_personModel.Phone1" />
                                </div>
                                <div>
                                    <label>Movil</label>
                                    <SfTextBox @bind-Value="_personModel.Mobile" />
                                </div>
                                <div>
                                    <label>Genero</label>
                                    <SfDropDownList TValue="string" TItem="CodeOption"
                                                    @bind-Value="_personModel.Gender"
                                                    DataSource="@_genders">
                                        <DropDownListFieldSettings Text="Name" Value="Value" />
                                    </SfDropDownList>
                                </div>
                                <div>
                                    <label>Estado Civil</label>
                                    <SfDropDownList TValue="string" TItem="CodeOption"
                                                    @bind-Value="_personModel.MaritalStatus"
                                                    DataSource="@_maritalStatuses">
                                        <DropDownListFieldSettings Text="Name" Value="Value" />
                                    </SfDropDownList>
                                </div>
                                <div>
                                    <label>Fecha Nacimiento</label>
                                    <SfDatePicker TValue="DateTime?" @bind-Value="_personModel.DateOfBirthDt" Format="dd/MM/yyyy" />
                                </div>
                                <div class="campo-ancho">
                                    <label>Direccion</label>
                                    <SfTextBox @bind-Value="_personModel.Address" />
                                </div>
                                <div>
                                    <label>Ciudad</label>
                                    <SfDropDownList TValue="Guid?" TItem="LookupOption"
                                                    @bind-Value="_personModel.CityPublicId"
                                                    DataSource="@_cities"
                                                    AllowFiltering="true"
                                                    Placeholder="Seleccione">
                                        <DropDownListFieldSettings Text="Name" Value="PublicId" />
                                    </SfDropDownList>
                                </div>
                            </div>
                        </ContentTemplate>
                    </TabItem>

                    @* --- Tab 2: Afiliacion --- *@
                    <TabItem>
                        <ChildContent><TabHeader Text="Afiliacion" /></ChildContent>
                        <ContentTemplate>
                            <div class="rejilla-campos panel-pestana">
                                <div>
                                    <label>Fecha de Ingreso</label>
                                    <SfDatePicker TValue="DateTime?" @bind-Value="_associateModel.JoinDateDt" Format="dd/MM/yyyy" />
                                </div>
                                <div>
                                    <label>Tasa de Aporte (%)</label>
                                    <SfNumericTextBox TValue="decimal" @bind-Value="_associateModel.ContributionRate"
                                                      Format="N2" Min="0" Max="100" Step="0.5m" />
                                </div>
                                <div>
                                    <label>Aporte Comprometido</label>
                                    <SfNumericTextBox TValue="decimal" @bind-Value="_associateModel.ContributionPledged"
                                                      Format="N2" Min="0" Step="50000m" />
                                </div>
                                <div>
                                    <label>Estado</label>
                                    <SfDropDownList TValue="string" TItem="CodeOption"
                                                    @bind-Value="_associateModel.Status"
                                                    DataSource="@_associateStatuses">
                                        <DropDownListFieldSettings Text="Name" Value="Value" />
                                    </SfDropDownList>
                                </div>
                                <div>
                                    <label>Sucursal</label>
                                    <SfDropDownList TValue="Guid?" TItem="LookupOption"
                                                    @bind-Value="_associateModel.BranchPublicId"
                                                    DataSource="@_branches"
                                                    AllowFiltering="true"
                                                    Placeholder="Seleccione">
                                        <DropDownListFieldSettings Text="Name" Value="PublicId" />
                                    </SfDropDownList>
                                </div>
                                <div>
                                    <label>Comite</label>
                                    <SfDropDownList TValue="Guid?" TItem="LookupOption"
                                                    @bind-Value="_associateModel.CommitteePublicId"
                                                    DataSource="@_committees"
                                                    AllowFiltering="true"
                                                    Placeholder="Seleccione">
                                        <DropDownListFieldSettings Text="Name" Value="PublicId" />
                                    </SfDropDownList>
                                </div>
                                <div>
                                    <label>Categoria</label>
                                    <SfTextBox @bind-Value="_associateModel.CategoryRating" />
                                </div>
                                <div>
                                    <label>Clase de Asociado</label>
                                    <SfTextBox @bind-Value="_associateModel.AssociateClass" />
                                </div>
                            </div>
                        </ContentTemplate>
                    </TabItem>

                    @* --- Tab 3: Empresa Empleadora Externa --- *@
                    <TabItem>
                        <ChildContent><TabHeader Text="Empleo Externo" /></ChildContent>
                        <ContentTemplate>
                            <div class="rejilla-campos panel-pestana">
                                <div class="campo-ancho">
                                    <label>Empresa donde trabaja el asociado</label>
                                    <SfTextBox @bind-Value="_associateModel.ExternalEmployerName"
                                               Placeholder="Nombre de la empresa empleadora" />
                                </div>
                                <div>
                                    <label>Fecha de Ingreso a la Empresa</label>
                                    <SfDatePicker TValue="DateTime?" @bind-Value="_associateModel.ExternalEmploymentStartDateDt" Format="dd/MM/yyyy" />
                                </div>
                                <div>
                                    <label>Salario</label>
                                    <SfNumericTextBox TValue="decimal" @bind-Value="_associateModel.ExternalSalary"
                                                      Format="N2" Min="0" Step="50000m" />
                                </div>
                                <div>
                                    <label>Tipo de Salario</label>
                                    <SfTextBox @bind-Value="_associateModel.ExternalSalaryType" />
                                </div>
                                <div>
                                    <label>Cesantias</label>
                                    <SfNumericTextBox TValue="decimal" @bind-Value="_associateModel.ExternalSeverance"
                                                      Format="N2" Min="0" />
                                </div>
                                <div class="campo-ancho">
                                    <label>Fondo de Cesantias</label>
                                    <SfTextBox @bind-Value="_associateModel.ExternalSeveranceFund" />
                                </div>
                            </div>
                        </ContentTemplate>
                    </TabItem>

                    @* --- Tab 4: Banca de Deposito --- *@
                    <TabItem>
                        <ChildContent><TabHeader Text="Banca Deposito" /></ChildContent>
                        <ContentTemplate>
                            <div class="rejilla-campos panel-pestana">
                                <p class="campo-ancho hint">
                                    Cuenta donde se depositan excedentes y aportes al asociado.
                                </p>
                                <div>
                                    <label>Banco</label>
                                    <SfDropDownList TValue="Guid?" TItem="LookupOption"
                                                    @bind-Value="_associateModel.DepositBankPublicId"
                                                    DataSource="@_banks"
                                                    AllowFiltering="true"
                                                    Placeholder="Seleccione">
                                        <DropDownListFieldSettings Text="Name" Value="PublicId" />
                                    </SfDropDownList>
                                </div>
                                <div>
                                    <label>Tipo Cuenta</label>
                                    <SfDropDownList TValue="string" TItem="CodeOption"
                                                    @bind-Value="_associateModel.DepositBankAccountType"
                                                    DataSource="@_accountTypes">
                                        <DropDownListFieldSettings Text="Name" Value="Value" />
                                    </SfDropDownList>
                                </div>
                                <div class="campo-ancho">
                                    <label>Numero de Cuenta</label>
                                    <SfTextBox @bind-Value="_associateModel.DepositBankAccountNumber" />
                                </div>
                            </div>
                        </ContentTemplate>
                    </TabItem>

                    @* --- Tab 5: Conyuge laboral --- *@
                    <TabItem>
                        <ChildContent><TabHeader Text="Conyuge (Empleo)" /></ChildContent>
                        <ContentTemplate>
                            <div class="rejilla-campos panel-pestana">
                                <div class="campo-ancho">
                                    <label>Empresa donde trabaja el conyuge</label>
                                    <SfTextBox @bind-Value="_associateModel.SpouseEmployer" />
                                </div>
                                <div>
                                    <label>Salario del Conyuge</label>
                                    <SfNumericTextBox TValue="decimal" @bind-Value="_associateModel.SpouseSalary"
                                                      Format="N2" Min="0" Step="50000m" />
                                </div>
                                <div>
                                    <label>Cargo del Conyuge</label>
                                    <SfTextBox @bind-Value="_associateModel.SpousePosition" />
                                </div>
                                <div>
                                    <label>Profesion del Conyuge</label>
                                    <SfTextBox @bind-Value="_associateModel.SpouseProfession" />
                                </div>
                            </div>
                        </ContentTemplate>
                    </TabItem>
                </TabItems>
            </SfTab>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@CancelEdit" />
        <DialogButton Content="@(_isNewAssociate ? "Registrar" : "Guardar Cambios")"
                      IsPrimary="true" OnClick="@Save" Disabled="@_saving" />
    </DialogButtons>
</SfDialog>

@code {
    private SfGrid<AssociateRow>? _grid;
    private List<AssociateRow> _items = new();
    private string _search = "";
    private System.Threading.CancellationTokenSource? _searchDebounce;

    // Person selector dialog
    private bool _showSelectPerson;

    // Edit/Create dialog
    private bool _showEditDialog;
    private bool _saving;
    private bool _isNewAssociate;
    private string _dialogTitle = "";
    private Guid? _associatePublicId;
    private Guid _personPublicId;
    private PersonModel _personModel = new();
    private AssociateModel _associateModel = new();

    // Lookups
    private List<LookupOption> _cities = new();
    private List<LookupOption> _branches = new();
    private List<LookupOption> _committees = new();
    private List<LookupOption> _banks = new();

    private List<CodeOption> _idTypes = new()
    {
        new("C", "Cedula"), new("CE", "C. Extranjeria"), new("TI", "Tarjeta Identidad"),
        new("NI", "NIT"), new("PA", "Pasaporte")
    };
    private List<CodeOption> _genders = new() { new("M", "Masculino"), new("F", "Femenino"), new("O", "Otro") };
    private List<CodeOption> _maritalStatuses = new()
    {
        new("S", "Soltero(a)"), new("C", "Casado(a)"), new("U", "Union Libre"),
        new("D", "Divorciado(a)"), new("V", "Viudo(a)")
    };
    private List<CodeOption> _associateStatuses = new()
    {
        new("A", "Activo"), new("I", "Inactivo"), new("R", "Retirado")
    };
    private List<CodeOption> _accountTypes = new()
    {
        new("A", "Ahorros"), new("C", "Corriente")
    };

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadLookups(), LoadData());
    }

    private async Task LoadLookups()
    {
        try
        {
            var citiesTask = Http.GetListAsync<LookupRaw>("/api/core/cities?PageNumber=1&PageSize=2000");
            var branchesTask = Http.GetListAsync<LookupRaw>("/api/core/branches?PageNumber=1&PageSize=500");
            var committeesTask = Http.GetListAsync<LookupRaw>("/api/core/committees?PageNumber=1&PageSize=500");
            var banksTask = Http.GetListAsync<LookupRaw>("/api/core/banks?PageNumber=1&PageSize=500");

            await Task.WhenAll(citiesTask, branchesTask, committeesTask, banksTask);

            _cities = (await citiesTask).Select(x => new LookupOption(x.PublicId, x.Name)).ToList();
            _branches = (await branchesTask).Select(x => new LookupOption(x.PublicId, x.Name)).ToList();
            _committees = (await committeesTask).Select(x => new LookupOption(x.PublicId, x.Name)).ToList();
            _banks = (await banksTask).Select(x => new LookupOption(x.PublicId, x.Name)).ToList();
        }
        catch { /* silently */ }
    }

    private async Task LoadData()
    {
        try
        {
            var url = "/api/core/associates?PageNumber=1&PageSize=500";
            if (!string.IsNullOrWhiteSpace(_search))
                url += $"&SearchTerm={Uri.EscapeDataString(_search)}";

            _items = await Http.GetListAsync<AssociateRow>(url);
        }
        catch (Exception ex)
        {
            _items = new List<AssociateRow>();
            await Notification.ErrorAsync($"No se pudieron cargar los asociados: {ex.Message}");
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
            if (_grid is not null) await _grid.Refresh();
        }
    }

    private async Task OnSearchChanged()
    {
        _searchDebounce?.Cancel();
        _searchDebounce = new System.Threading.CancellationTokenSource();
        var token = _searchDebounce.Token;
        try
        {
            await Task.Delay(350, token);
            if (!token.IsCancellationRequested) await LoadData();
        }
        catch (TaskCanceledException) { }
    }

    private void OpenSelectPersonDialog()
    {
        _showSelectPerson = true;
    }

    private async Task HandlePersonSelected(PersonSearchPicker.PersonSearchItem person)
    {
        _showSelectPerson = false;
        _personPublicId = person.PublicId;

        try
        {
            var p = await Http.GetFromJsonAsync<PersonEditDto>($"/api/core/people/{person.PublicId}");
            if (p is null) { await Notification.ErrorAsync("No se cargo la persona."); return; }

            _personModel = new PersonModel
            {
                IdType = p.IdType, TaxId = p.TaxId,
                FirstName = p.FirstName, LastName = p.LastName, BusinessName = p.BusinessName,
                Email = p.Email, Phone1 = p.Phone1, Mobile = p.Mobile,
                Address = p.Address, CityPublicId = p.CityPublicId,
                Gender = p.Gender, MaritalStatus = p.MaritalStatus,
                DateOfBirthDt = p.DateOfBirth?.ToDateTime(TimeOnly.MinValue)
            };
        }
        catch (Exception ex)
        {
            await Notification.ErrorAsync($"Error al cargar persona: {ex.Message}");
            return;
        }

        if (person.IsAssociate)
        {
            try
            {
                var a = await Http.GetFromJsonAsync<AssociateEditDto>($"/api/core/associates/by-person/{person.PublicId}");
                if (a is not null)
                {
                    _associatePublicId = a.PublicId;
                    _isNewAssociate = false;
                    _dialogTitle = $"Editar Asociado: {person.FullName}";
                    _associateModel = MapAssociateDto(a);
                    _showEditDialog = true;
                    return;
                }
            }
            catch { /* fall through to new */ }
        }

        _associatePublicId = null;
        _isNewAssociate = true;
        _dialogTitle = $"Registrar Asociado: {person.FullName}";
        _associateModel = new AssociateModel
        {
            JoinDateDt = DateTime.Today,
            Status = "A"
        };
        _showEditDialog = true;
    }

    private async Task OpenEdit(AssociateRow row)
    {
        try
        {
            var a = await Http.GetFromJsonAsync<AssociateEditDto>($"/api/core/associates/{row.PublicId}");
            if (a is null) { await Notification.ErrorAsync("No se cargo el asociado."); return; }

            _associatePublicId = a.PublicId;
            _personPublicId = a.PersonPublicId;
            _isNewAssociate = false;
            _dialogTitle = $"Editar Asociado: {a.PersonName}";

            var p = await Http.GetFromJsonAsync<PersonEditDto>($"/api/core/people/{a.PersonPublicId}");
            if (p is not null)
            {
                _personModel = new PersonModel
                {
                    IdType = p.IdType, TaxId = p.TaxId,
                    FirstName = p.FirstName, LastName = p.LastName, BusinessName = p.BusinessName,
                    Email = p.Email, Phone1 = p.Phone1, Mobile = p.Mobile,
                    Address = p.Address, CityPublicId = p.CityPublicId,
                    Gender = p.Gender, MaritalStatus = p.MaritalStatus,
                    DateOfBirthDt = p.DateOfBirth?.ToDateTime(TimeOnly.MinValue)
                };
            }

            _associateModel = MapAssociateDto(a);
            _showEditDialog = true;
        }
        catch (Exception ex)
        {
            await Notification.ErrorAsync($"Error al cargar asociado: {ex.Message}");
        }
    }

    private static AssociateModel MapAssociateDto(AssociateEditDto a) => new()
    {
        JoinDateDt = a.JoinDate?.ToDateTime(TimeOnly.MinValue),
        ContributionRate = a.ContributionRate,
        EmployerCompanyPublicId = a.EmployerCompanyPublicId,
        BranchPublicId = a.BranchPublicId,
        SectionPublicId = a.SectionPublicId,
        CommitteePublicId = a.CommitteePublicId,
        CategoryRating = a.CategoryRating,
        AssociateClass = a.AssociateClass,
        PaymentType = a.PaymentType,
        ContributionPledged = a.ContributionPledged,
        Status = a.Status,
        ExternalEmployerName = a.ExternalEmployerName,
        ExternalEmploymentStartDateDt = a.ExternalEmploymentStartDate?.ToDateTime(TimeOnly.MinValue),
        ExternalSalary = a.ExternalSalary,
        ExternalSalaryType = a.ExternalSalaryType,
        ExternalSeverance = a.ExternalSeverance,
        ExternalSeveranceFund = a.ExternalSeveranceFund,
        DepositBankPublicId = a.DepositBankPublicId,
        DepositBankAccountNumber = a.DepositBankAccountNumber,
        DepositBankAccountType = a.DepositBankAccountType,
        SpouseEmployer = a.SpouseEmployer,
        SpouseSalary = a.SpouseSalary,
        SpousePosition = a.SpousePosition,
        SpouseProfession = a.SpouseProfession
    };

    private void CancelEdit()
    {
        _showEditDialog = false;
        _associatePublicId = null;
        _personModel = new PersonModel();
        _associateModel = new AssociateModel();
    }

    private async Task Save()
    {
        if (_saving) return;
        if (string.IsNullOrWhiteSpace(_personModel.TaxId) ||
            string.IsNullOrWhiteSpace(_personModel.FirstName) ||
            string.IsNullOrWhiteSpace(_personModel.LastName))
        {
            await Notification.WarningAsync("Documento, nombres y apellidos son obligatorios.");
            return;
        }

        _saving = true;
        try
        {
            // 1. Actualizar Persona
            var personPayload = new
            {
                _personModel.IdType, _personModel.TaxId,
                _personModel.FirstName, _personModel.LastName, _personModel.BusinessName,
                _personModel.Email, _personModel.Phone1, _personModel.Mobile, _personModel.Address,
                CityPublicId = _personModel.CityPublicId,
                _personModel.Gender, _personModel.MaritalStatus,
                DateOfBirth = _personModel.DateOfBirthDt.HasValue
                    ? DateOnly.FromDateTime(_personModel.DateOfBirthDt.Value).ToString("yyyy-MM-dd")
                    : null,
                IsAssociate = true
            };
            var resPerson = await Http.PutAsJsonAsync($"/api/core/people/{_personPublicId}", personPayload);
            if (!resPerson.IsSuccessStatusCode)
            {
                await Notification.ShowErrorAsync(resPerson, "Error al actualizar datos de la persona");
                return;
            }

            // 2. Asociado: register o update
            HttpResponseMessage resAssoc;
            if (_isNewAssociate)
            {
                var registerPayload = new
                {
                    PersonPublicId = _personPublicId,
                    JoinDate = _associateModel.JoinDateDt.HasValue
                        ? DateOnly.FromDateTime(_associateModel.JoinDateDt.Value).ToString("yyyy-MM-dd")
                        : null,
                    _associateModel.ContributionRate,
                    _associateModel.EmployerCompanyPublicId, _associateModel.BranchPublicId,
                    _associateModel.SectionPublicId, _associateModel.CommitteePublicId,
                    _associateModel.CategoryRating, _associateModel.AssociateClass, _associateModel.PaymentType,
                    _associateModel.ContributionPledged,
                    _associateModel.ExternalEmployerName,
                    ExternalEmploymentStartDate = _associateModel.ExternalEmploymentStartDateDt.HasValue
                        ? DateOnly.FromDateTime(_associateModel.ExternalEmploymentStartDateDt.Value).ToString("yyyy-MM-dd")
                        : null,
                    _associateModel.ExternalSalary, _associateModel.ExternalSalaryType,
                    _associateModel.ExternalSeverance, _associateModel.ExternalSeveranceFund,
                    _associateModel.DepositBankPublicId, _associateModel.DepositBankAccountNumber,
                    _associateModel.DepositBankAccountType,
                    _associateModel.SpouseEmployer, _associateModel.SpouseSalary,
                    _associateModel.SpousePosition, _associateModel.SpouseProfession
                };
                resAssoc = await Http.PostAsJsonAsync("/api/core/associates", registerPayload);
            }
            else
            {
                var updatePayload = new
                {
                    JoinDate = _associateModel.JoinDateDt.HasValue
                        ? DateOnly.FromDateTime(_associateModel.JoinDateDt.Value).ToString("yyyy-MM-dd")
                        : null,
                    _associateModel.ContributionRate,
                    _associateModel.EmployerCompanyPublicId, _associateModel.BranchPublicId,
                    _associateModel.SectionPublicId, _associateModel.CommitteePublicId,
                    _associateModel.CategoryRating, _associateModel.AssociateClass, _associateModel.PaymentType,
                    _associateModel.ContributionPledged, _associateModel.Status,
                    _associateModel.ExternalEmployerName,
                    ExternalEmploymentStartDate = _associateModel.ExternalEmploymentStartDateDt.HasValue
                        ? DateOnly.FromDateTime(_associateModel.ExternalEmploymentStartDateDt.Value).ToString("yyyy-MM-dd")
                        : null,
                    _associateModel.ExternalSalary, _associateModel.ExternalSalaryType,
                    _associateModel.ExternalSeverance, _associateModel.ExternalSeveranceFund,
                    _associateModel.DepositBankPublicId, _associateModel.DepositBankAccountNumber,
                    _associateModel.DepositBankAccountType,
                    _associateModel.SpouseEmployer, _associateModel.SpouseSalary,
                    _associateModel.SpousePosition, _associateModel.SpouseProfession
                };
                resAssoc = await Http.PutAsJsonAsync($"/api/core/associates/{_associatePublicId}", updatePayload);
            }

            if (resAssoc.IsSuccessStatusCode)
            {
                await Notification.SuccessAsync(_isNewAssociate
                    ? "Asociado registrado correctamente."
                    : "Asociado actualizado correctamente.");
                _showEditDialog = false;
                await LoadData();
            }
            else
            {
                await Notification.ShowErrorAsync(resAssoc, "Error al guardar datos del asociado");
            }
        }
        catch (Exception ex)
        {
            await Notification.ErrorAsync($"Error inesperado: {ex.Message}");
        }
        finally
        {
            _saving = false;
        }
    }

