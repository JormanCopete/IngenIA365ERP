@page "/asociados/registro"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification
@inject PersonasClient Personas
@inject PermisosDelUsuario Permisos

<PageTitle>Asociados - IngenIA365ERP</PageTitle>

<div class="page-header">
    <h3>Asociados</h3>
    <div>
        <SfTextBox Placeholder="Buscar por documento, nombre o apellido..." @bind-Value="_search"
                   Width="320px"
                   ValueChange="@((Syncfusion.Blazor.Inputs.ChangedEventArgs e) => OnSearchChanged())" />
        <PermissionGate Required="Core.Associates.Create">
            <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@OpenSelectPersonDialog">Nuevo asociado</SfButton>
        </PermissionGate>
    </div>
</div>

<IndicadorDeCarga Cargando="@_carga.Activa">
<SfGrid @ref="_grid" TValue="AssociateRow" DataSource="@_items"
        AllowPaging="true" AllowSorting="true" AllowFiltering="true">
    <GridPageSettings PageSize="20" />
    <GridColumns>
        <GridColumn Field="@nameof(AssociateRow.IdentificationNumber)" HeaderText="Documento" Width="130" />
        <GridColumn Field="@nameof(AssociateRow.FullName)" HeaderText="Nombre completo" Width="260" />
        <GridColumn Field="@nameof(AssociateRow.JoinDate)" HeaderText="Fecha ingreso" Width="130"
                    Format="dd/MM/yyyy" Type="ColumnType.Date" />
        <GridColumn Field="@nameof(AssociateRow.ContributionRate)" HeaderText="% Aporte" Width="100"
                    Format="N2" TextAlign="TextAlign.Right" />
        <GridColumn Field="@nameof(AssociateRow.ExternalEmployerName)" HeaderText="Empresa empleadora" Width="200" />
        <GridColumn Field="@nameof(AssociateRow.ExternalSalary)" HeaderText="Salario" Width="140"
                    Format="N2" TextAlign="TextAlign.Right" />
        <GridColumn HeaderText="Estado" Width="110" TextAlign="TextAlign.Center">
            <Template>
                @{
                    var a = context as AssociateRow;
                    var css = a?.Status == "A" ? "e-badge e-badge-success marca-rol"
                            : a?.Status == "I" ? "e-badge e-badge-warning marca-rol"
                            : "e-badge e-badge-danger marca-rol";
                    <span class="@css">@CatalogosDePersona.Nombre(CatalogosDePersona.Estados, a?.Status)</span>
                }
            </Template>
        </GridColumn>
        <GridColumn HeaderText="Acciones" Width="120" TextAlign="TextAlign.Center" AllowFiltering="false" AllowSorting="false">
            <Template>
                @{
                    var a = context as AssociateRow;
                    <PermissionGate Required="Core.Associates.Update">
                        <SfButton CssClass="e-flat e-small" IconCss="e-icons e-edit"
                                  OnClick="@(() => OpenEdit(a!))" Title="Editar" />
                    </PermissionGate>
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>
</IndicadorDeCarga>

@* ===== Diálogo: elegir la persona (o crearla, si puede) ===== *@
<SfDialog @bind-Visible="_showSelectPerson" Header="Nuevo asociado: ¿quién es?"
          Width="600px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <div class="panel-pestana">
                <p class="muted">
                    Buscá la persona por documento o nombre. Si ya está registrada, se completa su afiliación;
                    @(_puedeCrearPersona ? "si no existe, podés crearla aquí mismo y afiliarla en un solo paso." : "si no existe, pedile el registro a quien administra Maestros › Personas.")
                </p>
                <PersonSearchPicker OnPersonSelected="HandlePersonSelected" ShowHelpText="false"
                                    PermitirCrear="@_puedeCrearPersona" OnCrearPersona="AbrirAltaConPersonaNueva" />
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _showSelectPerson = false)" />
    </DialogButtons>
</SfDialog>

@* ===== Diálogo: registrar / editar asociado ===== *@
<SfDialog @bind-Visible="_showEditDialog" Header="@_dialogTitle" Width="900px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@(_guardado.Activa || _cargaDialogo.Activa)" Texto="@(_guardado.Activa ? "Guardando…" : "Cargando…")">
            @if (!_personaNueva)
            {
                <div class="persona-solo-lectura">
                    <span class="muted">
                        Datos personales de <strong>@_personaModelo.NombreVisible</strong> — se leen aquí; se editan en Personas.
                    </span>
                    <PermissionGate Required="Core.People.Update">
                        <SfButton CssClass="e-small" IconCss="e-icons e-edit" OnClick="@(() => _showPersonaDialog = true)">Editar datos de la persona</SfButton>
                    </PermissionGate>
                </div>
            }
            <SfTab>
                <TabItems>
                    <TabItem>
                        <ChildContent><TabHeader Text="Identificación" /></ChildContent>
                        <ContentTemplate>
                            <PersonaCampos Seccion="SeccionDePersona.Identificacion" Modelo="@_personaModelo" Deshabilitado="@(!_personaNueva)" />
                        </ContentTemplate>
                    </TabItem>
                    <TabItem>
                        <ChildContent><TabHeader Text="Contacto" /></ChildContent>
                        <ContentTemplate>
                            <PersonaCampos Seccion="SeccionDePersona.Contacto" Modelo="@_personaModelo" Deshabilitado="@(!_personaNueva)" Ciudades="@_ciudades" />
                        </ContentTemplate>
                    </TabItem>
                    <TabItem>
                        <ChildContent><TabHeader Text="Demografía" /></ChildContent>
                        <ContentTemplate>
                            <PersonaCampos Seccion="SeccionDePersona.Demografia" Modelo="@_personaModelo" Deshabilitado="@(!_personaNueva)" />
                        </ContentTemplate>
                    </TabItem>

                    @* --- Afiliación --- *@
                    <TabItem>
                        <ChildContent><TabHeader Text="Afiliación" /></ChildContent>
                        <ContentTemplate>
                            <div class="rejilla-campos panel-pestana">
                                <div>
                                    <label>Fecha de ingreso</label>
                                    <SfDatePicker TValue="DateTime?" @bind-Value="_associateModel.JoinDateDt" Format="dd/MM/yyyy" />
                                </div>
                                <div>
                                    <label>Tasa de aporte (%)</label>
                                    <SfNumericTextBox TValue="decimal" @bind-Value="_associateModel.ContributionRate"
                                                      Format="N2" Min="0" Max="100" Step="0.5m" />
                                </div>
                                <div>
                                    <label>Aporte comprometido</label>
                                    <SfNumericTextBox TValue="decimal" @bind-Value="_associateModel.ContributionPledged"
                                                      Format="N2" Min="0" Step="50000m" />
                                </div>
                                @if (!_isNewAssociate)
                                {
                                    <div>
                                        <label>Estado</label>
                                        <SfDropDownList TValue="string" TItem="OpcionDeCatalogo" @bind-Value="_associateModel.Status"
                                                        DataSource="@CatalogosDePersona.Estados">
                                            <DropDownListFieldSettings Text="Nombre" Value="Codigo" />
                                        </SfDropDownList>
                                    </div>
                                }
                                <div>
                                    <label>Sucursal</label>
                                    <SfDropDownList TValue="Guid?" TItem="LookupOption" @bind-Value="_associateModel.BranchPublicId"
                                                    DataSource="@_branches" AllowFiltering="true" Placeholder="Seleccione">
                                        <DropDownListFieldSettings Text="Name" Value="PublicId" />
                                    </SfDropDownList>
                                </div>
                                <div>
                                    <label>Comité</label>
                                    <SfDropDownList TValue="Guid?" TItem="LookupOption" @bind-Value="_associateModel.CommitteePublicId"
                                                    DataSource="@_committees" AllowFiltering="true" Placeholder="Seleccione">
                                        <DropDownListFieldSettings Text="Name" Value="PublicId" />
                                    </SfDropDownList>
                                </div>
                                <div>
                                    <label>Categoría</label>
                                    <SfTextBox @bind-Value="_associateModel.CategoryRating" />
                                </div>
                                <div>
                                    <label>Clase de asociado</label>
                                    <SfTextBox @bind-Value="_associateModel.AssociateClass" />
                                </div>
                            </div>
                        </ContentTemplate>
                    </TabItem>

                    @* --- Empleo externo --- *@
                    <TabItem>
                        <ChildContent><TabHeader Text="Empleo externo" /></ChildContent>
                        <ContentTemplate>
                            <div class="rejilla-campos panel-pestana">
                                <div class="campo-ancho">
                                    <label>Empresa donde trabaja el asociado</label>
                                    <SfTextBox @bind-Value="_associateModel.ExternalEmployerName" Placeholder="Nombre de la empresa empleadora" />
                                </div>
                                <div>
                                    <label>Fecha de ingreso a la empresa</label>
                                    <SfDatePicker TValue="DateTime?" @bind-Value="_associateModel.ExternalEmploymentStartDateDt" Format="dd/MM/yyyy" />
                                </div>
                                <div>
                                    <label>Salario</label>
                                    <SfNumericTextBox TValue="decimal" @bind-Value="_associateModel.ExternalSalary" Format="N2" Min="0" Step="50000m" />
                                </div>
                                <div>
                                    <label>Tipo de salario</label>
                                    <SfTextBox @bind-Value="_associateModel.ExternalSalaryType" />
                                </div>
                                <div>
                                    <label>Cesantías</label>
                                    <SfNumericTextBox TValue="decimal" @bind-Value="_associateModel.ExternalSeverance" Format="N2" Min="0" />
                                </div>
                                <div class="campo-ancho">
                                    <label>Fondo de cesantías</label>
                                    <SfTextBox @bind-Value="_associateModel.ExternalSeveranceFund" />
                                </div>
                            </div>
                        </ContentTemplate>
                    </TabItem>

                    @* --- Banca de depósito --- *@
                    <TabItem>
                        <ChildContent><TabHeader Text="Banca depósito" /></ChildContent>
                        <ContentTemplate>
                            <div class="rejilla-campos panel-pestana">
                                <p class="campo-ancho hint">Cuenta donde se depositan excedentes y aportes al asociado.</p>
                                <div>
                                    <label>Banco</label>
                                    <SfDropDownList TValue="Guid?" TItem="LookupOption" @bind-Value="_associateModel.DepositBankPublicId"
                                                    DataSource="@_banks" AllowFiltering="true" Placeholder="Seleccione">
                                        <DropDownListFieldSettings Text="Name" Value="PublicId" />
                                    </SfDropDownList>
                                </div>
                                <div>
                                    <label>Tipo de cuenta</label>
                                    <SfDropDownList TValue="string" TItem="CodeOption" @bind-Value="_associateModel.DepositBankAccountType"
                                                    DataSource="@_accountTypes">
                                        <DropDownListFieldSettings Text="Name" Value="Value" />
                                    </SfDropDownList>
                                </div>
                                <div class="campo-ancho">
                                    <label>Número de cuenta</label>
                                    <SfTextBox @bind-Value="_associateModel.DepositBankAccountNumber" />
                                </div>
                            </div>
                        </ContentTemplate>
                    </TabItem>

                    @* --- Cónyuge laboral --- *@
                    <TabItem>
                        <ChildContent><TabHeader Text="Cónyuge (empleo)" /></ChildContent>
                        <ContentTemplate>
                            <div class="rejilla-campos panel-pestana">
                                <div class="campo-ancho">
                                    <label>Empresa donde trabaja el cónyuge</label>
                                    <SfTextBox @bind-Value="_associateModel.SpouseEmployer" />
                                </div>
                                <div>
                                    <label>Salario del cónyuge</label>
                                    <SfNumericTextBox TValue="decimal" @bind-Value="_associateModel.SpouseSalary" Format="N2" Min="0" Step="50000m" />
                                </div>
                                <div>
                                    <label>Cargo del cónyuge</label>
                                    <SfTextBox @bind-Value="_associateModel.SpousePosition" />
                                </div>
                                <div>
                                    <label>Profesión del cónyuge</label>
                                    <SfTextBox @bind-Value="_associateModel.SpouseProfession" />
                                </div>
                            </div>
                        </ContentTemplate>
                    </TabItem>
                </TabItems>
            </SfTab>

            @if (_colision is not null)
            {
                <div class="aviso aviso-error aviso-documento">
                    <span>@_colision.Mensaje</span>
                    @if (_colision.Eliminada)
                    {
                        <PermissionGate Required="Core.People.Delete">
                            <SfButton CssClass="e-small" OnClick="@RestaurarYUsarAsync" Disabled="@_saving">Restaurar persona</SfButton>
                        </PermissionGate>
                        <PermissionGate Required="Core.People.Delete" Fallback="@PedirRestauracion" />
                    }
                    else
                    {
                        <SfButton CssClass="e-small" OnClick="@UsarExistenteAsync" Disabled="@_saving">Usar esa persona</SfButton>
                    }
                </div>
            }
            </IndicadorDeCarga>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@CancelEdit" />
        <DialogButton Content="@(_isNewAssociate ? "Registrar" : "Guardar cambios")"
                      IsPrimary="true" OnClick="@Save" Disabled="@(_saving || _guardado.Activa)" />
    </DialogButtons>
</SfDialog>

@* El único sitio que escribe la persona: el diálogo compartido de Personas (FR-005). *@
<PersonaDialog @bind-Visible="_showPersonaDialog" PersonaPublicId="@_personPublicId" OnGuardado="@PersonaEditadaAsync" />

@code {
    /// <summary>Feature 008: llegar con <c>?persona=</c> (desde Personas › Roles › «Registrar como asociado…») abre el diálogo con esa persona.</summary>
    [SupplyParameterFromQuery(Name = "persona")] public Guid? Persona { get; set; }

    // Indicadores de carga por zona (ver docs/manual/indicador-de-carga.md).
    private readonly EstadoDeCarga _carga = new(), _cargaDialogo = new(), _guardado = new();
    private SfGrid<AssociateRow>? _grid;
    private List<AssociateRow> _items = new();
    private string _search = "";
    private System.Threading.CancellationTokenSource? _searchDebounce;
    private bool _puedeCrearPersona;
    private Guid? _personaAbiertaPorRuta;

    // Diálogo: elegir persona
    private bool _showSelectPerson;

    // Diálogo: registrar / editar
    private bool _showEditDialog, _showPersonaDialog;
    private bool _saving;
    private bool _isNewAssociate;
    /// <summary>Modo alta en un paso: la persona no existe todavía y sus campos se editan aquí (FR-001).</summary>
    private bool _personaNueva;
    private string _dialogTitle = "";
    private Guid? _associatePublicId;
    private Guid? _personPublicId;
    private PersonaFormularioModelo _personaModelo = PersonaFormularioModelo.Nuevo();
    private AssociateModel _associateModel = new();
    private Colision? _colision;

    // Catálogos
    private IReadOnlyList<OpcionDeCiudad> _ciudades = [];
    private List<LookupOption> _branches = new();
    private List<LookupOption> _committees = new();
    private List<LookupOption> _banks = new();
    private List<CodeOption> _accountTypes = new() { new("A", "Ahorros"), new("C", "Corriente") };

    private RenderFragment PedirRestauracion => @<span>Pedile la restauración a quien administra Maestros › Personas.</span>;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadLookups(), LoadData(), CalcularPermisosAsync());
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Persona is { } id && _personaAbiertaPorRuta != id)
        {
            _personaAbiertaPorRuta = id;
            await AbrirConPersonaExistenteAsync(id);
        }
    }

    private async Task CalcularPermisosAsync() =>
        _puedeCrearPersona = await Permisos.TieneAsync("Core.People.Create");

    private async Task LoadLookups()
    {
        using var carga = _carga.Iniciar();
        // Cada catálogo se revisa por separado: los que llegaron se muestran y los que no se
        // nombran en el aviso (Principio IX). Antes un solo catch callaba todos.
        var citiesTask = Personas.ListarCiudadesAsync();
        var branchesTask = Http.GetListAsync<LookupRaw>("/api/core/branches?PageNumber=1&PageSize=500");
        var committeesTask = Http.GetListAsync<LookupRaw>("/api/core/committees?PageNumber=1&PageSize=500");
        var banksTask = Http.GetListAsync<LookupRaw>("/api/core/banks?PageNumber=1&PageSize=500");
        try { await Task.WhenAll(citiesTask, branchesTask, committeesTask, banksTask); }
        catch { /* se revisa tarea por tarea */ }

        var caidos = new List<string>();
        _ciudades = citiesTask.IsCompletedSuccessfully ? citiesTask.Result : Caido(citiesTask, "ciudades", caidos, (IReadOnlyList<OpcionDeCiudad>)[]);
        _branches = Resultado(branchesTask, "sucursales", caidos).Select(x => new LookupOption(x.PublicId, x.Name)).ToList();
        _committees = Resultado(committeesTask, "comités", caidos).Select(x => new LookupOption(x.PublicId, x.Name)).ToList();
        _banks = Resultado(banksTask, "bancos", caidos).Select(x => new LookupOption(x.PublicId, x.Name)).ToList();

        if (caidos.Count > 0)
            await Notification.ErrorAsync($"No se pudieron cargar estos catálogos: {string.Join("; ", caidos)}. Recargá la página antes de registrar un asociado.");
    }

    private static List<T> Resultado<T>(Task<List<T>> tarea, string nombre, List<string> caidos)
    {
        if (tarea.IsCompletedSuccessfully) return tarea.Result;
        caidos.Add($"{nombre} ({tarea.Exception?.GetBaseException().Message ?? "cancelado"})");
        return new List<T>();
    }

    private static T Caido<T>(Task tarea, string nombre, List<string> caidos, T vacio)
    {
        caidos.Add($"{nombre} ({tarea.Exception?.GetBaseException().Message ?? "cancelado"})");
        return vacio;
    }

    private async Task LoadData()
    {
        using var carga = _carga.Iniciar();
        try
        {
            var url = "/api/core/associates?PageNumber=1&PageSize=500";
            if (!string.IsNullOrWhiteSpace(_search))
                url += $"&SearchTerm={Uri.EscapeDataString(_search)}";
            _items = await Http.GetListAsync<AssociateRow>(url);
        }
        catch (Exception ex)
        {
            _items = new List<AssociateRow>();
            await Notification.ErrorAsync($"No se pudieron cargar los asociados: {ex.Message}");
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
            if (_grid is not null) await _grid.Refresh();
        }
    }

    private async Task OnSearchChanged()
    {
        _searchDebounce?.Cancel();
        _searchDebounce = new System.Threading.CancellationTokenSource();
        var token = _searchDebounce.Token;
        try
        {
            await Task.Delay(350, token);
            if (!token.IsCancellationRequested) await LoadData();
        }
        catch (TaskCanceledException) { }
    }

    // ---------- Elegir o crear la persona ----------

    private void OpenSelectPersonDialog() => _showSelectPerson = true;

    private Task HandlePersonSelected(PersonSearchPicker.PersonSearchItem person)
    {
        _showSelectPerson = false;
        return AbrirConPersonaExistenteAsync(person.PublicId);
    }

    /// <summary>Persona existente: datos personales de sólo lectura (FR-005); si ya es asociada se edita su afiliación (US2.2).</summary>
    private async Task AbrirConPersonaExistenteAsync(Guid personaId)
    {
        using var carga = _cargaDialogo.Iniciar();
        _colision = null;
        var persona = await Personas.ObtenerAsync(personaId);
        if (!persona.IsSuccess || persona.Value is null)
        {
            await Notification.ErrorAsync($"No se pudo cargar la persona: {persona.ErrorMessage}");
            return;
        }
        _personPublicId = personaId;
        _personaNueva = false;
        _personaModelo = PersonaFormularioModelo.DesdeDto(persona.Value);

        if (persona.Value.IsAssociate)
        {
            var existente = await Http.GetAsync($"/api/core/associates/by-person/{personaId}");
            if (existente.IsSuccessStatusCode)
            {
                var afiliacion = await existente.Content.ReadFromJsonAsync<AssociateEditDto>();
                if (afiliacion is not null)
                {
                    AbrirEdicion(afiliacion);
                    return;
                }
            }
            else if (existente.StatusCode != System.Net.HttpStatusCode.NotFound)
            {
                await Notification.ShowErrorAsync(existente, "No se pudo cargar la afiliación");
                return;
            }
        }

        AbrirRegistro($"Registrar asociado: {_personaModelo.NombreVisible}");
    }

    /// <summary>Alta en un paso (FR-001): la persona no existe; se digita aquí y se guarda junto con la afiliación.</summary>
    private void AbrirAltaConPersonaNueva(string termino)
    {
        _showSelectPerson = false;
        _colision = null;
        _personPublicId = null;
        _personaNueva = true;
        _personaModelo = PersonaFormularioModelo.Nuevo(termino.All(char.IsDigit) ? termino : null);
        AbrirRegistro("Registrar asociado (persona nueva)");
    }

    private void AbrirRegistro(string titulo)
    {
        _associatePublicId = null;
        _isNewAssociate = true;
        _dialogTitle = titulo;
        _associateModel = new AssociateModel { JoinDateDt = DateTime.Today, Status = "A" };
        _showEditDialog = true;
    }

    private void AbrirEdicion(AssociateEditDto afiliacion)
    {
        _associatePublicId = afiliacion.PublicId;
        _isNewAssociate = false;
        _dialogTitle = $"Editar asociado: {_personaModelo.NombreVisible}";
        _associateModel = MapAssociateDto(afiliacion);
        _showEditDialog = true;
    }

    private async Task OpenEdit(AssociateRow row)
    {
        using var carga = _cargaDialogo.Iniciar();
        try
        {
            var afiliacion = await Http.GetFromJsonAsync<AssociateEditDto>($"/api/core/associates/{row.PublicId}");
            if (afiliacion is null) { await Notification.ErrorAsync("No se cargó el asociado."); return; }
            var persona = await Personas.ObtenerAsync(afiliacion.PersonPublicId);
            if (!persona.IsSuccess || persona.Value is null)
            {
                await Notification.ErrorAsync($"No se cargó la persona del asociado: {persona.ErrorMessage}");
                return;
            }
            _personPublicId = afiliacion.PersonPublicId;
            _personaNueva = false;
            _personaModelo = PersonaFormularioModelo.DesdeDto(persona.Value);
            _colision = null;
            AbrirEdicion(afiliacion);
        }
        catch (Exception ex)
        {
            await Notification.ErrorAsync($"Error al cargar asociado: {ex.Message}");
        }
    }

    /// <summary>Volvió el diálogo compartido de Personas: se refrescan los datos de sólo lectura.</summary>
    private async Task PersonaEditadaAsync(Guid personaId)
    {
        var persona = await Personas.ObtenerAsync(personaId);
        if (persona.IsSuccess && persona.Value is not null)
            _personaModelo = PersonaFormularioModelo.DesdeDto(persona.Value);
        await LoadData();
    }

    private static AssociateModel MapAssociateDto(AssociateEditDto a) => new()
    {
        JoinDateDt = a.JoinDate?.ToDateTime(TimeOnly.MinValue),
        ContributionRate = a.ContributionRate,
        EmployerCompanyPublicId = a.EmployerCompanyPublicId,
        BranchPublicId = a.BranchPublicId,
        SectionPublicId = a.SectionPublicId,
        CommitteePublicId = a.CommitteePublicId,
        CategoryRating = a.CategoryRating,
        AssociateClass = a.AssociateClass,
        PaymentType = a.PaymentType,
        ContributionPledged = a.ContributionPledged,
        Status = a.Status,
        ExternalEmployerName = a.ExternalEmployerName,
        ExternalEmploymentStartDateDt = a.ExternalEmploymentStartDate?.ToDateTime(TimeOnly.MinValue),
        ExternalSalary = a.ExternalSalary,
        ExternalSalaryType = a.ExternalSalaryType,
        ExternalSeverance = a.ExternalSeverance,
        ExternalSeveranceFund = a.ExternalSeveranceFund,
        DepositBankPublicId = a.DepositBankPublicId,
        DepositBankAccountNumber = a.DepositBankAccountNumber,
        DepositBankAccountType = a.DepositBankAccountType,
        SpouseEmployer = a.SpouseEmployer,
        SpouseSalary = a.SpouseSalary,
        SpousePosition = a.SpousePosition,
        SpouseProfession = a.SpouseProfession
    };

    private void CancelEdit()
    {
        _showEditDialog = false;
        _associatePublicId = null;
        _colision = null;
        _personaModelo = PersonaFormularioModelo.Nuevo();
        _associateModel = new AssociateModel();
    }

    // ---------- Guardar ----------

    private async Task Save()
    {
        if (_saving) return;

        if (_personaNueva)
        {
            var avisos = _personaModelo.Validar();
            if (avisos.Count > 0) { await Notification.WarningAsync(avisos[0]); return; }
        }

        _saving = true;
        _colision = null;
        using var guardado = _guardado.Iniciar();
        try
        {
            if (_isNewAssociate && _personaNueva)
            {
                // Un solo paso: persona y afiliación juntas o ninguna (FR-001).
                var r = await Personas.RegistrarAsociadoConPersonaAsync(
                    new AltaAsociadoConPersonaRequest(_personaModelo.AInput(), PayloadAfiliacion()));
                if (!r.IsSuccess) { await FalloDelAltaAsync(r.ErrorCode, r.ErrorMessage); return; }
                await Notification.SuccessAsync("Persona y asociado registrados correctamente.");
                _showEditDialog = false;
                await LoadData();
                return;
            }

            // Persona existente: la afiliación va sola; los datos personales NO se tocan desde aquí (FR-005).
            HttpResponseMessage resAssoc;
            if (_isNewAssociate)
            {
                resAssoc = await Http.PostAsJsonAsync("/api/core/associates",
                    PayloadAfiliacion() with { PersonPublicId = _personPublicId!.Value });
            }
            else
            {
                resAssoc = await Http.PutAsJsonAsync($"/api/core/associates/{_associatePublicId}",
                    PayloadAfiliacion() with { Status = _associateModel.Status });
            }

            if (resAssoc.IsSuccessStatusCode)
            {
                await Notification.SuccessAsync(_isNewAssociate
                    ? "Asociado registrado correctamente."
                    : "Asociado actualizado correctamente.");
                _showEditDialog = false;
                await LoadData();
            }
            else
            {
                await Notification.ShowErrorAsync(resAssoc, "Error al guardar datos del asociado");
            }
        }
        catch (Exception ex)
        {
            await Notification.ErrorAsync($"Error inesperado: {ex.Message}");
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>Los 23 campos de <c>AssociateInput</c>; con <c>PersonPublicId</c> es <c>RegisterAssociateCommand</c>, con <c>Status</c> el PUT.</summary>
    private PayloadAfiliacionDto PayloadAfiliacion() => new(
        _associateModel.JoinDateDt is { } j ? DateOnly.FromDateTime(j) : null,
        _associateModel.ContributionRate, _associateModel.EmployerCompanyPublicId, _associateModel.BranchPublicId,
        _associateModel.SectionPublicId, _associateModel.CommitteePublicId, _associateModel.CategoryRating,
        _associateModel.AssociateClass, _associateModel.PaymentType, _associateModel.ContributionPledged,
        _associateModel.ExternalEmployerName,
        _associateModel.ExternalEmploymentStartDateDt is { } e ? DateOnly.FromDateTime(e) : null,
        _associateModel.ExternalSalary, _associateModel.ExternalSalaryType, _associateModel.ExternalSeverance,
        _associateModel.ExternalSeveranceFund, _associateModel.DepositBankPublicId, _associateModel.DepositBankAccountNumber,
        _associateModel.DepositBankAccountType, _associateModel.SpouseEmployer, _associateModel.SpouseSalary,
        _associateModel.SpousePosition, _associateModel.SpouseProfession);

    private async Task FalloDelAltaAsync(string? codigo, string? mensaje)
    {
        switch (codigo)
        {
            case ErroresDePersona.DocumentoDuplicado:
                _colision = new Colision(mensaje ?? "Ya existe una persona con ese documento.", Eliminada: false);
                break;
            case ErroresDePersona.DocumentoEliminado:
                _colision = new Colision(mensaje ?? "Ese documento pertenece a una persona eliminada.", Eliminada: true);
                break;
            default:
                await Notification.ErrorAsync(codigo == "Generic.NotFound"
                    ? $"Error al registrar: {NotificationServiceExtensions.SinPermiso}"
                    : $"Error al registrar: {mensaje}");
                break;
        }
    }

    private async Task UsarExistenteAsync()
    {
        var quien = await Personas.PorDocumentoAsync(_personaModelo.TaxId.Trim());
        if (!quien.IsSuccess || quien.Value is null)
        {
            await Notification.ErrorAsync($"No se pudo abrir la persona existente: {quien.ErrorMessage}");
            return;
        }
        await ContinuarConExistenteAsync(quien.Value.PublicId);
    }

    private async Task RestaurarYUsarAsync()
    {
        if (_saving) return;
        _saving = true;
        using var guardado = _guardado.Iniciar();
        try
        {
            var quien = await Personas.PorDocumentoAsync(_personaModelo.TaxId.Trim());
            if (!quien.IsSuccess || quien.Value is null)
            {
                await Notification.ErrorAsync($"No se encontró la persona eliminada: {quien.ErrorMessage}");
                return;
            }
            var r = await Personas.RestaurarAsync(quien.Value.PublicId);
            if (!r.IsSuccess)
            {
                await Notification.ErrorAsync(r.ErrorCode == "Generic.NotFound"
                    ? NotificationServiceExtensions.SinPermiso
                    : $"No se pudo restaurar: {r.ErrorMessage}");
                return;
            }
            await Notification.SuccessAsync($"Persona restaurada: {quien.Value.FullName}.");
            await ContinuarConExistenteAsync(quien.Value.PublicId);
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>Cambia el diálogo a persona existente sin perder la afiliación ya digitada.</summary>
    private async Task ContinuarConExistenteAsync(Guid personaId)
    {
        var afiliacion = _associateModel;
        var titulo = _dialogTitle;
        await AbrirConPersonaExistenteAsync(personaId);
        if (_isNewAssociate)
        {
            _associateModel = afiliacion;
        }
        else if (titulo != _dialogTitle)
        {
            await Notification.InfoAsync("Esa persona ya es asociada: se abrió su afiliación para editarla.");
        }
    }

