@page "/legacy-login"
@layout MinimalLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Login - IngenIA365ERP</PageTitle>

<div class="login-page">
    <div class="login-card">
        <div class="login-header">
            <span class="e-icons e-bank login-logo"></span>
            <h1>IngenIA365ERP</h1>
            <p>Sistema ERP Financiero</p>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="login-error">
                <span class="e-icons e-circle-close"></span> @_error
            </div>
        }

        <EditForm Model="_model" OnValidSubmit="HandleLogin" class="login-form">
            <DataAnnotationsValidator />

            <div class="form-field">
                <label>Tenant</label>
                <SfDropDownList TValue="string" TItem="TenantOption" @bind-Value="_model.TenantId"
                                DataSource="@_tenants" CssClass="e-outline"
                                Enabled="@(!_loading)">
                    <DropDownListFieldSettings Text="Name" Value="Id" />
                </SfDropDownList>
            </div>

            <div class="form-field">
                <label>Correo electronico</label>
                <SfTextBox @bind-Value="_model.Email" Placeholder="usuario@empresa.com"
                           CssClass="e-outline" Enabled="@(!_loading)" />
                <ValidationMessage For="@(() => _model.Email)" />
            </div>

            <div class="form-field">
                <label>Contrasena</label>
                <SfTextBox @bind-Value="_model.Password" Type="InputType.Password"
                           Placeholder="Ingrese su contrasena"
                           CssClass="e-outline" Enabled="@(!_loading)" />
                <ValidationMessage For="@(() => _model.Password)" />
            </div>

            <SfButton CssClass="e-primary e-block login-btn" Type="submit"
                      Disabled="@_loading" IsPrimary="true">
                @if (_loading)
                {
                    <span class="e-icons e-spinner e-spin"></span>
                    <span>Ingresando...</span>
                }
                else
                {
                    <span>Ingresar</span>
                }
            </SfButton>
        </EditForm>

        <div class="login-footer">
            <a href="#">Olvido la contrasena?</a>
        </div>
    </div>
    <div class="login-brand">
        <span>IngenIA 365 - ERP Financiero SaaS</span>
    </div>
</div>

@code {
    private LoginRequest _model = new() { TenantId = "dev_tenant" };
    private string? _error;
    private bool _loading;

    private List<TenantOption> _tenants =
    [
        new("dev_tenant", "Cooperativa Demo Desarrollo"),
    ];

    private async Task HandleLogin()
    {
        _error = null;
        _loading = true;
        try
        {
            var response = await AuthService.LoginAsync(_model);
            if (response.Success)
            {
                if (AuthStateProvider is CustomAuthStateProvider custom)
                    // Pasamos el token JWT (no el email) — el provider decodifica
                    // los claims reales (perm, roles) para PermissionGate.
                    custom.NotifyUserAuthentication(response.Token ?? string.Empty);
                await Task.Delay(100);
                Navigation.NavigateTo("/", false);
            }
            else
            {
                _error = response.Message ?? "Credenciales invalidas";
            }
        }
        catch (Exception ex)
        {
            _error = $"Error de conexion: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private record TenantOption(string Id, string Name);
}
