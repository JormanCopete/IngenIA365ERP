@page "/tesoreria/reglas-de-conciliacion"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using IngenIA365ERP.Shared.Services.Http
@using IngenIA365ERP.Shared.Services.Inventario
@using IngenIA365ERP.Shared.Services.Tesoreria
@inject ConciliacionCompletaClient Cliente
@inject CuentasBancariasClient CuentasApi
@inject INotificationService Notification

<PageTitle>Reglas de conciliación - IngenIA365ERP</PageTitle>

@* Feature 015, T2, US17 (fase 41, T0449; FR-129): las reglas configurables del cruce automático de la conciliación completa, por prioridad (la menor primero) y con su
   holgura de días, para todas las cuentas o para una. Sin reglas activas, el cruce es el de la conciliación mínima. Un empate nunca se cruza solo. *@
<PermissionGate Required="Treasury.Reconciliation.View" AnyOf="@(new[] { "Treasury.Reconciliation.Work" })" MostrarAviso="true">
<div class="pagina">
    <div class="page-header">
        <h3>Reglas de conciliación</h3>
        <div class="toolbar">
            <PermissionGate Required="Treasury.Reconciliation.Work">
                <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@(() => Editar(null))">Nueva regla</SfButton>
            </PermissionGate>
            <a class="boton boton-secundario" href="/tesoreria/conciliacion">Conciliación</a>
            <SfButton CssClass="e-outline" IconCss="e-icons e-refresh" Disabled="@_carga.Activa" OnClick="@CargarAsync">Actualizar</SfButton>
        </div>
    </div>

    <IndicadorDeCarga Cargando="@_carga.Activa" Texto="Cargando las reglas…">
        @if (_reglas.Count == 0)
        {
            <p class="texto-tenue">No hay reglas: el cruce automático es el de la conciliación mínima (valor, fecha con holgura y referencia).</p>
        }
        else
        {
            <table class="data-grid">
                <thead><tr><th>Prioridad</th><th>Código</th><th>Nombre</th><th>Criterio</th><th>Holgura</th><th>Cuenta</th><th>Activa</th><th></th></tr></thead>
                <tbody>
                    @foreach (var r in _reglas)
                    {
                        <tr>
                            <td>@r.Priority</td><td>@r.Code</td><td>@r.Name</td><td>@Criterio(r.Criterion)</td><td>@r.ToleranceDays días</td>
                            <td>@(_cuentas.FirstOrDefault(c => c.PublicId == r.BankAccountPublicId)?.Code ?? "Todas")</td><td>@(r.IsActive ? "Sí" : "No")</td>
                            <td><PermissionGate Required="Treasury.Reconciliation.Work"><SfButton CssClass="e-flat" OnClick="@(() => Editar(r))">Editar</SfButton></PermissionGate></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </IndicadorDeCarga>

    @if (_editando)
    {
        <section class="info-card">
            <h4>@(_publicId is null ? "Nueva regla" : "Editar regla")</h4>
            <IndicadorDeCarga Cargando="@_guardado.Activa" Texto="Guardando…">
                <div class="form-grid">
                    <label class="campo">Código * <input class="e-input" @bind="_codigo" maxlength="10" /></label>
                    <label class="campo">Nombre * <input class="e-input" @bind="_nombre" maxlength="150" /></label>
                    <label class="campo">Criterio *
                        <select class="e-input" @bind="_criterio">
                            <option value="1">Misma referencia y valor</option>
                            <option value="2">Mismo valor dentro de la holgura</option>
                            <option value="3">Mismo valor el mismo día</option>
                        </select>
                    </label>
                    <label class="campo">Holgura (días) <input type="number" class="e-input" @bind="_holgura" min="0" max="31" /></label>
                    <label class="campo">Prioridad * <input type="number" class="e-input" @bind="_prioridad" min="1" /></label>
                    <label class="campo">Cuenta
                        <select class="e-input" @bind="_cuenta">
                            <option value="">Todas las cuentas</option>
                            @foreach (var c in _cuentas) { <option value="@c.PublicId">@c.Code · @c.BankName</option> }
                        </select>
                    </label>
                    <label class="campo"><input type="checkbox" @bind="_activa" /> Activa</label>
                </div>
                <div class="toolbar">
                    <SfButton CssClass="e-flat" OnClick="@(() => _editando = false)">Cancelar</SfButton>
                    <SfButton CssClass="e-primary" Disabled="@(_guardado.Activa || string.IsNullOrWhiteSpace(_codigo) || string.IsNullOrWhiteSpace(_nombre))" OnClick="@GuardarAsync">Guardar</SfButton>
                </div>
            </IndicadorDeCarga>
        </section>
    }
</div>
</PermissionGate>

@code {
    private readonly EstadoDeCarga _carga = new(), _guardado = new();
    private IReadOnlyList<ReglaDeConciliacionDto> _reglas = [];
    private IReadOnlyList<CuentaBancariaPropiaDto> _cuentas = [];
    private bool _editando, _activa = true;
    private Guid? _publicId;
    private string _codigo = "", _nombre = "", _cuenta = "";
    private int _criterio = 1, _holgura = 3, _prioridad = 1;
    private ClaveDeOperacion _clave = new();

    protected override async Task OnInitializedAsync()
    {
        var c = await CuentasApi.CuentasAsync();
        if (c.IsSuccess) _cuentas = c.Value ?? [];
        await CargarAsync();
    }

    private static string Criterio(int c) => c switch { 1 => "Referencia y valor", 2 => "Valor y fecha", 3 => "Valor el mismo día", _ => "" };

    private async Task CargarAsync()
    {
        using var carga = _carga.Iniciar();
        var r = await Cliente.ReglasAsync();
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudieron consultar las reglas."); return; }
        _reglas = r.Value ?? [];
    }

    private void Editar(ReglaDeConciliacionDto? r)
    {
        _editando = true;
        _clave = new ClaveDeOperacion();
        (_publicId, _codigo, _nombre, _criterio, _holgura, _prioridad, _cuenta, _activa) = r is null
            ? ((Guid?)null, "", "", 1, 3, (_reglas.Count == 0 ? 0 : _reglas.Max(x => x.Priority)) + 1, "", true)
            : ((Guid?)r.PublicId, r.Code, r.Name, r.Criterion, r.ToleranceDays, r.Priority, r.BankAccountPublicId?.ToString() ?? "", r.IsActive);
    }

    private async Task GuardarAsync()
    {
        using (_guardado.Iniciar())
        {
            var r = await Cliente.GuardarReglaAsync(_publicId, new ReglaDeConciliacionRequest(_codigo.Trim(), _nombre.Trim(), _criterio, _holgura, _prioridad,
                Guid.TryParse(_cuenta, out var c) ? c : null, _activa), _clave);
            if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo guardar la regla."); return; }
            _editando = false;
            await Notification.SuccessAsync($"Regla {r.Value?.Code} guardada.");
        }
        await CargarAsync();
    }
}
