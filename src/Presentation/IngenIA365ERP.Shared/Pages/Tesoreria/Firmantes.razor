@page "/tesoreria/firmantes"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using IngenIA365ERP.Shared.Services.Http
@using IngenIA365ERP.Shared.Services.Tesoreria
@inject OrdenesManualesClient FirmantesApi
@inject CuentasBancariasClient Cuentas
@inject INotificationService Notification

<PageTitle>Firmantes y tokens - IngenIA365ERP</PageTitle>

@* Feature 015, T1 (fase 34, T0418; FR-208): los firmantes y los tokens del portal del banco de cada cuenta propia, con la combinación de firmas por clase y monto y su
   vigencia. El alta y el retiro llevan su acta y los aprueba otra persona; la vigilancia diaria avisa cuando un firmante o el dueño de un token se retira de la
   cooperativa. *@
<PermissionGate Required="Treasury.Signers.Manage" AnyOf="@(new[] { "Treasury.Signers.Approve", "Treasury.BankAccounts.View" })" MostrarAviso="true">
<div class="pagina">
    <div class="page-header">
        <h3>Firmantes y tokens de las cuentas</h3>
        <div class="toolbar">
            <select class="e-input" @bind="_cuenta" @bind:after="CargarAsync">
                <option value="">Elija la cuenta…</option>
                @foreach (var c in _cuentas) { <option value="@c.PublicId">@c.Code · @c.Name</option> }
            </select>
            <label><input type="checkbox" @bind="_conRetirados" @bind:after="CargarAsync" /> Con los retirados</label>
            <SfButton CssClass="e-outline" IconCss="e-icons e-refresh" Disabled="@_carga.Activa" OnClick="@CargarAsync">Actualizar</SfButton>
        </div>
    </div>

    <IndicadorDeCarga Cargando="@_carga.Activa" Texto="Cargando firmantes y tokens…">
        @if (Guid.TryParse(_cuenta, out _))
        {
            <h4>Firmantes</h4>
            <table class="data-grid">
                <thead><tr><th>Persona</th><th>Clase</th><th>Firma sola hasta</th><th>En conjunto</th><th>Cargo</th><th>Desde</th><th>Hasta</th><th>Estado</th><th></th></tr></thead>
                <tbody>
                    @foreach (var f in _firmantes)
                    {
                        <tr>
                            <td>@f.PersonName</td><td>@f.SignatureClass</td><td>@(f.MaxAmountAlone?.ToString("N2") ?? "—")</td><td>@(f.CanSignJointly ? "Sí" : "No")</td><td>@f.Role</td>
                            <td>@f.ValidFrom.ToString("dd/MM/yyyy")</td><td>@f.ValidTo?.ToString("dd/MM/yyyy")</td><td>@Estado(f.Status)</td>
                            <td>@Acciones(f)</td>
                        </tr>
                    }
                </tbody>
            </table>
            <h4>Tokens del portal del banco</h4>
            <table class="data-grid">
                <thead><tr><th>Serial</th><th>Persona</th><th>Uso</th><th>Desde</th><th>Hasta</th><th>Estado</th><th></th></tr></thead>
                <tbody>
                    @foreach (var t in _tokens)
                    {
                        <tr>
                            <td>@t.Serial</td><td>@t.PersonName</td><td>@t.Purpose</td><td>@t.ValidFrom.ToString("dd/MM/yyyy")</td><td>@t.ValidTo?.ToString("dd/MM/yyyy")</td>
                            <td>@Estado(t.Status)</td><td>@Acciones(t)</td>
                        </tr>
                    }
                </tbody>
            </table>

            <PermissionGate Required="Treasury.Signers.Manage">
                <div class="info-card">
                    <h4>Registrar un firmante o un token</h4>
                    <IndicadorDeCarga Cargando="@_guardado.Activa" Texto="Guardando…">
                        <div class="form-grid">
                            <div class="campo campo-ancho">Persona * <PersonSearchPicker @bind-Selected="_persona" ShowHelpText="false" Compacto="true" /></div>
                            <label class="campo">Acta (adjunto) * <input class="e-input" @bind="_acta" /></label>
                            <label class="campo">Clase de firma <input class="e-input" @bind="_clase" maxlength="10" /></label>
                            <label class="campo">Firma sola hasta <input class="e-input" type="number" step="0.01" @bind="_tope" /></label>
                            <label class="campo"><input type="checkbox" @bind="_conjunto" /> Firma en conjunto</label>
                            <label class="campo">Cargo <input class="e-input" @bind="_cargo" maxlength="80" /></label>
                            <label class="campo">Serial del token <input class="e-input" @bind="_serial" maxlength="40" /></label>
                            <label class="campo">Uso del token <input class="e-input" @bind="_uso" maxlength="80" /></label>
                        </div>
                        <div class="toolbar">
                            <SfButton CssClass="e-primary" OnClick="@(() => RegistrarAsync(token: false))">Registrar firmante</SfButton>
                            <SfButton CssClass="e-outline" OnClick="@(() => RegistrarAsync(token: true))">Registrar token</SfButton>
                        </div>
                    </IndicadorDeCarga>
                </div>
            </PermissionGate>
        }
        else
        {
            <p class="muted">Elija una cuenta propia para ver sus firmantes y tokens.</p>
        }
    </IndicadorDeCarga>
</div>
</PermissionGate>

@code {
    private readonly EstadoDeCarga _carga = new(), _guardado = new();
    private IReadOnlyList<CuentaBancariaPropiaDto> _cuentas = [];
    private IReadOnlyList<FirmanteOTokenDto> _firmantes = [], _tokens = [];
    private PersonSearchPicker.PersonSearchItem? _persona;
    private string _cuenta = "", _acta = "";
    private string? _clase, _cargo, _serial, _uso, _motivo;
    private decimal? _tope;
    private bool _conjunto = true, _conRetirados;

    protected override async Task OnInitializedAsync()
    {
        using var carga = _carga.Iniciar();
        var c = await Cuentas.CuentasAsync();
        if (c.IsSuccess && c.Value is not null) _cuentas = c.Value;
    }

    private async Task CargarAsync()
    {
        if (!Guid.TryParse(_cuenta, out var cuenta)) return;
        using var carga = _carga.Iniciar();
        var f = await FirmantesApi.FirmantesAsync(cuenta, tokens: false, _conRetirados);
        var t = await FirmantesApi.FirmantesAsync(cuenta, tokens: true, _conRetirados);
        if (!f.IsSuccess || !t.IsSuccess) { await Notification.ErrorAsync(f.ErrorMessage ?? t.ErrorMessage ?? "No se pudieron consultar los firmantes."); return; }
        _firmantes = f.Value ?? [];
        _tokens = t.Value ?? [];
    }

    private static string Estado(int e) => e switch
    {
        1 => "Alta por aprobar", 2 => "Activo", 3 => "Retiro por aprobar", 4 => "Retirado", 5 => "Rechazado", _ => "—",
    };

    private RenderFragment Acciones(FirmanteOTokenDto a) => __builder =>
    {
        if (a.Status is 1 or 3)
        {
            <PermissionGate Required="Treasury.Signers.Approve">
                <SfButton CssClass="e-flat" OnClick="@(() => DecidirAsync(a, true))">Aprobar</SfButton>
                <SfButton CssClass="e-flat" OnClick="@(() => DecidirAsync(a, false))">Rechazar</SfButton>
            </PermissionGate>
        }
        else if (a.Status == 2)
        {
            @* Segunda ronda del 2026-10-27 (D-l; FR-234): desde la fecha de retiro no firma; si su ficha de empleado está terminada, se avisa. *@
            @if (a.PersonLeft) { <span class="aviso aviso-error">Se retiró de la cooperativa: pida su retiro.</span> }
            <PermissionGate Required="Treasury.Signers.Manage">
                <input class="e-input" placeholder="Motivo del retiro" @bind="_motivo" />
                <label class="campo">No firma desde <input class="e-input" type="date" @bind="_retiroDesde" /></label>
                <SfButton CssClass="e-flat" OnClick="@(() => RetirarAsync(a))">Pedir el retiro</SfButton>
            </PermissionGate>
        }
    };

    private async Task RegistrarAsync(bool token)
    {
        if (!Guid.TryParse(_cuenta, out var cuenta) || _persona is null || !Guid.TryParse(_acta, out var acta))
        {
            await Notification.WarningAsync("Elija la persona y adjunte el acta.");
            return;
        }
        if (token ? string.IsNullOrWhiteSpace(_serial) : string.IsNullOrWhiteSpace(_clase))
        {
            await Notification.WarningAsync(token ? "Escriba el serial del token." : "Escriba la clase de firma.");
            return;
        }
        using var g = _guardado.Iniciar();
        var r = token
            ? await FirmantesApi.RegistrarTokenAsync(cuenta, new RegistrarTokenRequest(_persona.PublicId, _serial!.Trim(), _uso, acta, null), new ClaveDeOperacion())
            : await FirmantesApi.RegistrarFirmanteAsync(cuenta, new RegistrarFirmanteRequest(_persona.PublicId, _clase!.Trim(), _tope, _conjunto, _cargo, acta, null), new ClaveDeOperacion());
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo registrar."); return; }
        await Notification.SuccessAsync("Registrado: espera la aprobación de otra persona.");
        await CargarAsync();
    }

    private DateTime? _retiroDesde;

    private async Task RetirarAsync(FirmanteOTokenDto a)
    {
        if (!Guid.TryParse(_cuenta, out var cuenta) || string.IsNullOrWhiteSpace(_motivo) || !Guid.TryParse(_acta, out var acta))
        {
            await Notification.WarningAsync("Escriba el motivo y adjunte el acta del retiro.");
            return;
        }
        using var g = _carga.Iniciar();
        var r = await FirmantesApi.RetirarAsync(cuenta, a, new RetirarFirmanteRequest(_motivo.Trim(), acta,
            _retiroDesde is { } d ? DateOnly.FromDateTime(d) : null), new ClaveDeOperacion());
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo pedir el retiro."); return; }
        _motivo = null;
        await CargarAsync();
    }

    private async Task DecidirAsync(FirmanteOTokenDto a, bool aprobar)
    {
        if (!Guid.TryParse(_cuenta, out var cuenta)) return;
        using var g = _carga.Iniciar();
        var r = await FirmantesApi.DecidirAsync(cuenta, a, aprobar, aprobar ? null : "Rechazado desde la pantalla de firmantes", new ClaveDeOperacion());
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo decidir."); return; }
        await CargarAsync();
    }
}
