@page "/cartera/zonas"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification

<PageTitle>Zonas - IngenIA365ERP</PageTitle>

<div class="page-header">
    <h3>Zonas</h3>
    <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@OpenCreate">Nuevo</SfButton>
</div>

<IndicadorDeCarga Cargando="@_carga.Activa">
    <SfGrid @ref="_grid" TValue="ZoneItem" DataSource="@_items"
        AllowPaging="true" AllowSorting="true" AllowFiltering="true">
        <GridColumns>
            <GridColumn Field="Code" HeaderText="Codigo" Width="100" TextAlign="TextAlign.Center" />
            <GridColumn Field="Name" HeaderText="Nombre" Width="250" />
            <GridColumn Field="Address" HeaderText="Direccion" Width="200" />
            <GridColumn Field="Phone" HeaderText="Telefono" Width="150" />
            <GridColumn HeaderText="Acciones" Width="150" TextAlign="TextAlign.Center">
                <Template>
                    @{
                        var item = context as ZoneItem;
                        <SfButton CssClass="e-flat e-small" IconCss="e-icons e-edit" OnClick="@(() => OpenEdit(item!))" />
                        <SfButton CssClass="e-flat e-small e-danger" IconCss="e-icons e-trash" OnClick="@(() => OpenDelete(item!))" />
                    }
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
</IndicadorDeCarga>

<SfDialog @bind-Visible="_showDialog" Header="@_dialogTitle" Width="500px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@_guardado.Activa" Texto="Guardando…">
                <div class="pagina">
                    <div>
                        <label>Codigo *</label>
                        <SfNumericTextBox TValue="int" @bind-Value="_model.Code"
                            Placeholder="0" Format="N0" Min="0" />
                    </div>
                    <div>
                        <label>Nombre *</label>
                        <SfTextBox @bind-Value="_model.Name" Placeholder="Nombre de la zona" />
                    </div>
                    <div>
                        <label>Direccion</label>
                        <SfTextBox @bind-Value="_model.Address" Placeholder="Direccion" />
                    </div>
                    <div>
                        <label>Telefono</label>
                        <SfTextBox @bind-Value="_model.Phone" Placeholder="Telefono" />
                    </div>
                </div>
            </IndicadorDeCarga>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _showDialog = false)" />
        <DialogButton Content="Guardar" IsPrimary="true" OnClick="@Save" Disabled="@_guardado.Activa" />
    </DialogButtons>
</SfDialog>

<ConfirmDialog @bind-Visible="_showConfirm" OnConfirm="ConfirmDelete"
    Message="Esta seguro de eliminar este registro?" />

@code {
    // Indicadores de carga por zona (ver docs/manual/indicador-de-carga.md).
    private readonly EstadoDeCarga _carga = new(), _guardado = new();

    private SfGrid<ZoneItem>? _grid;
    private List<ZoneItem> _items = [];
    private ZoneModel _model = new();
    private Guid? _editId;
    private bool _showDialog, _showConfirm;
    private string _dialogTitle = "";
    private Guid _deleteId;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        using var carga = _carga.Iniciar();
        try { _items = await Http.GetListAsync<ZoneItem>("/api/savings/zones?pageSize=500") ?? []; }
        catch (Exception ex) { _items = []; await Notification.ErrorAsync($"No se pudo cargar la lista: {ex.Message}"); }
    }

    private void OpenCreate() { _model = new(); _editId = null; _dialogTitle = "Nueva Zona"; _showDialog = true; }

    private void OpenEdit(ZoneItem item)
    {
        _model = new()
        {
            Code = item.Code,
            Name = item.Name,
            Address = item.Address,
            Phone = item.Phone
        };
        _editId = item.PublicId;
        _dialogTitle = "Editar Zona";
        _showDialog = true;
    }

    private void OpenDelete(ZoneItem item) { _deleteId = item.PublicId; _showConfirm = true; }

    private async Task Save()
    {
        using var guardado = _guardado.Iniciar();
        HttpResponseMessage res;
        if (_editId.HasValue)
            res = await Http.PutAsJsonAsync($"/api/savings/zones/{_editId}", _model);
        else
            res = await Http.PostAsJsonAsync("/api/savings/zones", _model);

        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro guardado");
            _showDialog = false;
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al guardar");
    }

    private async Task ConfirmDelete()
    {
        var res = await Http.DeleteAsync($"/api/savings/zones/{_deleteId}");
        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro eliminado");
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al eliminar");
    }

    private class ZoneItem
    {
        public Guid PublicId { get; set; }
        public int Code { get; set; }
        public string Name { get; set; } = "";
        public string Address { get; set; } = "";
        public string Phone { get; set; } = "";
    }

    private class ZoneModel
    {
        public int Code { get; set; }
        public string Name { get; set; } = "";
        public string Address { get; set; } = "";
        public string Phone { get; set; } = "";
    }
}
