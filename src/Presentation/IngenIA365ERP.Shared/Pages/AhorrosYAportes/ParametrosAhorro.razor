@page "/cartera/parametros-ahorro"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification

<PageTitle>Parametros de Ahorro - IngenIA365ERP</PageTitle>

<div class="page-header">
    <h3>Parametros de Ahorro</h3>
    <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@OpenCreate">Nuevo</SfButton>
</div>

<IndicadorDeCarga Cargando="@_carga.Activa">
    <SfGrid @ref="_grid" TValue="SavingsParameterItem" DataSource="@_items"
        AllowPaging="true" AllowSorting="true" AllowFiltering="true">
        <GridColumns>
            <GridColumn Field="SavingsLineId" HeaderText="Linea Ahorro" Width="130" TextAlign="TextAlign.Center" />
            <GridColumn Field="Name" HeaderText="Nombre" Width="250" />
            <GridColumn Field="InterestPaymentPeriod" HeaderText="Periodo Pago Interes" Width="170" />
            <GridColumn Field="InterestPaymentRate" HeaderText="Tasa Interes %" Width="140" Format="N4" TextAlign="TextAlign.Right" />
            <GridColumn Field="MinAccountBalance" HeaderText="Saldo Minimo" Width="150" Format="N2" TextAlign="TextAlign.Right" />
            <GridColumn HeaderText="Acciones" Width="150" TextAlign="TextAlign.Center">
                <Template>
                    @{
                        var item = context as SavingsParameterItem;
                        <SfButton CssClass="e-flat e-small" IconCss="e-icons e-edit" OnClick="@(() => OpenEdit(item!))" />
                        <SfButton CssClass="e-flat e-small e-danger" IconCss="e-icons e-trash" OnClick="@(() => OpenDelete(item!))" />
                    }
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
</IndicadorDeCarga>

<SfDialog @bind-Visible="_showDialog" Header="@_dialogTitle" Width="550px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@_guardado.Activa" Texto="Guardando…">
                <div class="pagina">
                    <div>
                        <label>Linea de Ahorro *</label>
                        <SfNumericTextBox TValue="int" @bind-Value="_model.SavingsLineId"
                            Placeholder="0" Min="0" Format="N0" />
                    </div>
                    <div>
                        <label>Nombre *</label>
                        <SfTextBox @bind-Value="_model.Name" Placeholder="Nombre del parametro" />
                    </div>
                    <div>
                        <label>Periodo de Pago de Intereses</label>
                        <SfTextBox @bind-Value="_model.InterestPaymentPeriod" Placeholder="Periodo (max 2)" MaxLength="2" />
                    </div>
                    <div>
                        <label>Tasa de Interes (%)</label>
                        <SfNumericTextBox TValue="decimal" @bind-Value="_model.InterestPaymentRate"
                            Placeholder="0.0000" Decimals="4" Format="N4" Min="0" Max="100" Step="0.0001m" />
                    </div>
                    <div>
                        <label>Saldo Minimo de Cuenta</label>
                        <SfNumericTextBox TValue="decimal" @bind-Value="_model.MinAccountBalance"
                            Placeholder="0.00" Decimals="2" Format="N2" Min="0" />
                    </div>
                </div>
            </IndicadorDeCarga>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _showDialog = false)" />
        <DialogButton Content="Guardar" IsPrimary="true" OnClick="@Save" Disabled="@_guardado.Activa" />
    </DialogButtons>
</SfDialog>

<ConfirmDialog @bind-Visible="_showConfirm" OnConfirm="ConfirmDelete"
    Message="Esta seguro de eliminar este registro?" />

@code {
    // Indicadores de carga por zona (ver docs/manual/indicador-de-carga.md).
    private readonly EstadoDeCarga _carga = new(), _guardado = new();

    private SfGrid<SavingsParameterItem>? _grid;
    private List<SavingsParameterItem> _items = [];
    private SavingsParameterModel _model = new();
    private Guid? _editId;
    private bool _showDialog, _showConfirm;
    private string _dialogTitle = "";
    private Guid _deleteId;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        using var carga = _carga.Iniciar();
        try { _items = await Http.GetListAsync<SavingsParameterItem>("/api/savings/savings-parameters?pageSize=500") ?? []; }
        catch (Exception ex) { _items = []; await Notification.ErrorAsync($"No se pudo cargar la lista: {ex.Message}"); }
    }

    private void OpenCreate() { _model = new(); _editId = null; _dialogTitle = "Nuevo Parametro de Ahorro"; _showDialog = true; }

    private void OpenEdit(SavingsParameterItem item)
    {
        _model = new()
        {
            SavingsLineId = item.SavingsLineId,
            Name = item.Name,
            InterestPaymentPeriod = item.InterestPaymentPeriod,
            InterestPaymentRate = item.InterestPaymentRate,
            MinAccountBalance = item.MinAccountBalance
        };
        _editId = item.PublicId;
        _dialogTitle = "Editar Parametro de Ahorro";
        _showDialog = true;
    }

    private void OpenDelete(SavingsParameterItem item) { _deleteId = item.PublicId; _showConfirm = true; }

    private async Task Save()
    {
        using var guardado = _guardado.Iniciar();
        HttpResponseMessage res;
        if (_editId.HasValue)
            res = await Http.PutAsJsonAsync($"/api/savings/savings-parameters/{_editId}", _model);
        else
            res = await Http.PostAsJsonAsync("/api/savings/savings-parameters", _model);

        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro guardado");
            _showDialog = false;
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al guardar");
    }

    private async Task ConfirmDelete()
    {
        var res = await Http.DeleteAsync($"/api/savings/savings-parameters/{_deleteId}");
        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro eliminado");
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al eliminar");
    }

    private class SavingsParameterItem
    {
        public Guid PublicId { get; set; }
        public int SavingsLineId { get; set; }
        public string Name { get; set; } = "";
        public string InterestPaymentPeriod { get; set; } = "";
        public decimal InterestPaymentRate { get; set; }
        public decimal MinAccountBalance { get; set; }
    }

    private class SavingsParameterModel
    {
        public int SavingsLineId { get; set; }
        public string Name { get; set; } = "";
        public string InterestPaymentPeriod { get; set; } = "";
        public decimal InterestPaymentRate { get; set; }
        public decimal MinAccountBalance { get; set; }
    }
}
