@page "/cdt/parametros"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification

<PageTitle>Parametros CDT - IngenIA365ERP</PageTitle>

<div class="page-header">
    <h3>Parametros CDT</h3>
    <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@OpenCreate">Nuevo</SfButton>
</div>

<SfGrid @ref="_grid" TValue="CdtParameterItem" DataSource="@_items"
    AllowPaging="true" AllowSorting="true" AllowFiltering="true">
    <GridColumns>
        <GridColumn Field="CreditLineId" HeaderText="Linea Credito" Width="120" TextAlign="TextAlign.Right" />
        <GridColumn Field="Description" HeaderText="Descripcion" Width="250" />
        <GridColumn Field="MinimumRate" HeaderText="Tasa Min" Width="100" Format="N2" TextAlign="TextAlign.Right" />
        <GridColumn Field="AnnualRate" HeaderText="% Anual" Width="120" Format="N9" TextAlign="TextAlign.Right" />
        <GridColumn Field="WithholdingRate" HeaderText="% RetFte" Width="100" Format="N2" TextAlign="TextAlign.Right" />
        <GridColumn Field="MinWithholdingAmount" HeaderText="Min RetFte" Width="120" Format="N2" TextAlign="TextAlign.Right" />
        <GridColumn Field="InterestType" HeaderText="Tipo Int." Width="80" />
        <GridColumn Field="TreasuryAccount" HeaderText="Cta Tesoreria" Width="130" />
        <GridColumn HeaderText="Acciones" Width="150" TextAlign="TextAlign.Center">
            <Template>
                @{
                    var item = context as CdtParameterItem;
                    <SfButton CssClass="e-flat e-small" IconCss="e-icons e-edit" OnClick="@(() => OpenEdit(item!))" />
                    <SfButton CssClass="e-flat e-small e-danger" IconCss="e-icons e-trash" OnClick="@(() => OpenDelete(item!))" />
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

<SfDialog @bind-Visible="_showDialog" Header="@_dialogTitle" Width="600px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <div style="padding:10px;display:flex;flex-direction:column;gap:16px;">
                <div>
                    <label>Linea de Credito *</label>
                    <SfNumericTextBox TValue="int" @bind-Value="_model.CreditLineId" Placeholder="Id linea de credito" Min="0" />
                </div>
                <div>
                    <label>Descripcion</label>
                    <SfTextBox @bind-Value="_model.Description" Placeholder="Descripcion del parametro" />
                </div>
                <div>
                    <label>Tasa Minima (%)</label>
                    <SfNumericTextBox TValue="decimal?" @bind-Value="_model.MinimumRate" Placeholder="0.00" Decimals="2" Format="N2" Min="0" Max="100" />
                </div>
                <div>
                    <label>Tasa Anual (%)</label>
                    <SfNumericTextBox TValue="decimal?" @bind-Value="_model.AnnualRate" Placeholder="0.000000000" Decimals="9" Format="N9" Min="0" />
                </div>
                <div>
                    <label>% Retencion en la Fuente</label>
                    <SfNumericTextBox TValue="decimal?" @bind-Value="_model.WithholdingRate" Placeholder="0.00" Decimals="2" Format="N2" Min="0" Max="100" />
                </div>
                <div>
                    <label>Valor Min Retencion</label>
                    <SfNumericTextBox TValue="decimal?" @bind-Value="_model.MinWithholdingAmount" Placeholder="0.00" Decimals="2" Format="N2" Min="0" />
                </div>
                <div>
                    <label>Concepto Intereses</label>
                    <SfNumericTextBox TValue="int?" @bind-Value="_model.InterestConceptId" Placeholder="Id concepto" Min="0" />
                </div>
                <div>
                    <label>Concepto Retencion</label>
                    <SfNumericTextBox TValue="int?" @bind-Value="_model.WithholdingConceptId" Placeholder="Id concepto" Min="0" />
                </div>
                <div>
                    <label>Incremento Mensual (%)</label>
                    <SfNumericTextBox TValue="decimal?" @bind-Value="_model.MonthlyIncrement" Placeholder="0.00" Decimals="2" Format="N2" Min="0" />
                </div>
                <div>
                    <label>Tipo de Interes</label>
                    <SfTextBox @bind-Value="_model.InterestType" Placeholder="S" />
                </div>
                <div>
                    <label>Cuenta Tesoreria</label>
                    <SfTextBox @bind-Value="_model.TreasuryAccount" Placeholder="Cuenta de tesoreria" />
                </div>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _showDialog = false)" />
        <DialogButton Content="Guardar" IsPrimary="true" OnClick="@Save" />
    </DialogButtons>
</SfDialog>

<ConfirmDialog @bind-Visible="_showConfirm" OnConfirm="ConfirmDelete"
    Message="Esta seguro de eliminar este registro?" />

@code {
    private SfGrid<CdtParameterItem>? _grid;
    private List<CdtParameterItem> _items = [];
    private CdtParameterModel _model = new();
    private Guid? _editId;
    private bool _showDialog, _showConfirm;
    private string _dialogTitle = "";
    private Guid _deleteId;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        try { _items = await Http.GetListAsync<CdtParameterItem>("/api/cdt/parameters?pageSize=500") ?? []; }
        catch { _items = []; }
    }

    private void OpenCreate() { _model = new(); _editId = null; _dialogTitle = "Nuevo Parametro CDT"; _showDialog = true; }

    private void OpenEdit(CdtParameterItem item)
    {
        _model = new()
        {
            CreditLineId = item.CreditLineId,
            Description = item.Description,
            MinimumRate = item.MinimumRate,
            AnnualRate = item.AnnualRate,
            WithholdingRate = item.WithholdingRate,
            MinWithholdingAmount = item.MinWithholdingAmount,
            InterestConceptId = item.InterestConceptId,
            WithholdingConceptId = item.WithholdingConceptId,
            MonthlyIncrement = item.MonthlyIncrement,
            InterestType = item.InterestType,
            TreasuryAccount = item.TreasuryAccount
        };
        _editId = item.PublicId;
        _dialogTitle = "Editar Parametro CDT";
        _showDialog = true;
    }

    private void OpenDelete(CdtParameterItem item) { _deleteId = item.PublicId; _showConfirm = true; }

    private async Task Save()
    {
        HttpResponseMessage res;
        if (_editId.HasValue)
            res = await Http.PutAsJsonAsync($"/api/cdt/parameters/{_editId}", _model);
        else
            res = await Http.PostAsJsonAsync("/api/cdt/parameters", _model);

        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro guardado");
            _showDialog = false;
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al guardar");
    }

    private async Task ConfirmDelete()
    {
        var res = await Http.DeleteAsync($"/api/cdt/parameters/{_deleteId}");
        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro eliminado");
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al eliminar");
    }

    private class CdtParameterItem
    {
        public Guid PublicId { get; set; }
        public int CreditLineId { get; set; }
        public string? Description { get; set; }
        public decimal? MinimumRate { get; set; }
        public decimal? AnnualRate { get; set; }
        public decimal? WithholdingRate { get; set; }
        public decimal? MinWithholdingAmount { get; set; }
        public int? InterestConceptId { get; set; }
        public int? WithholdingConceptId { get; set; }
        public decimal? MonthlyIncrement { get; set; }
        public string InterestType { get; set; } = "S";
        public string? TreasuryAccount { get; set; }
    }

    private class CdtParameterModel
    {
        public int CreditLineId { get; set; }
        public string? Description { get; set; }
        public decimal? MinimumRate { get; set; }
        public decimal? AnnualRate { get; set; }
        public decimal? WithholdingRate { get; set; }
        public decimal? MinWithholdingAmount { get; set; }
        public int? InterestConceptId { get; set; }
        public int? WithholdingConceptId { get; set; }
        public decimal? MonthlyIncrement { get; set; }
        public string InterestType { get; set; } = "S";
        public string? TreasuryAccount { get; set; }
    }
}
