@page "/compras/notas-proveedor"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using IngenIA365ERP.Shared.Components.Compras
@using IngenIA365ERP.Shared.Models.Compras
@using IngenIA365ERP.Shared.Services.Compras
@using IngenIA365ERP.Shared.Services.Http
@using IngenIA365ERP.Shared.Services.Inventario
@inject ComprasClient Compras
@inject InventarioClient Inventario
@inject INotificationService Notification

<PageTitle>Notas de proveedor - IngenIA365ERP</PageTitle>

@* Feature 012, T356 (FR-050; contracts/api.md §14.5; E9): las notas crédito y débito del proveedor contra una factura confirmada del
   mismo proveedor —por valor o por cantidad, línea por línea, y si cambian el costo de lo recibido (affectsCost)—, con los impuestos
   y retenciones de la foto de la factura en proporción (los calcula el servidor). La nota crédito no pasa de lo que queda de la
   factura. Se guarda el borrador, se revisa lo que calculó el servidor y se confirma. *@
<PermissionGate Required="Inventory.Purchases.View" MostrarAviso="true">
<div class="pagina">
    <div class="page-header">
        <h3>Notas de proveedor</h3>
        <div class="toolbar">
            <SfButton CssClass="e-outline" IconCss="e-icons e-refresh" Disabled="@_carga.Activa" OnClick="@CargarAsync">Actualizar</SfButton>
        </div>
    </div>

    <PermissionGate Required="Inventory.Purchases.Create">
        <div class="info-card">
            <h4>Nueva nota</h4>
            <IndicadorDeCarga Cargando="@_guardado.Activa" Texto="Guardando…">
                <div class="form-grid">
                    <label class="campo campo-ancho">Proveedor * <SelectorDeProveedor Seleccionado="@_proveedor" SeleccionadoChanged="@CambiarProveedorAsync" /></label>
                    <label class="campo">Factura *
                        <select class="e-input" value="@(_factura?.ToString() ?? "")" @onchange="@(e => ElegirFacturaAsync(e.Value?.ToString()))">
                            <option value="">Elija…</option>
                            @foreach (var f in _facturas) { <option value="@f.Document.PublicId">@f.Document.DisplayNumber · @f.Supplier?.Prefix@f.Supplier?.Number · @f.Document.Total?.ToString("N2")</option> }
                        </select>
                    </label>
                    <label class="campo">Clase
                        <select class="e-input" @bind="_clase"><option value="Credit">Nota crédito</option><option value="Debit">Nota débito</option></select>
                    </label>
                    <label class="campo">Tipo *
                        <select class="e-input" value="@(_tipo?.ToString() ?? "")" @onchange="@(e => _tipo = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null)">
                            @foreach (var t in _tipos) { <option value="@t.PublicId">@t.Code · @t.Name</option> }
                        </select>
                    </label>
                    <label class="campo">Prefijo <input class="e-input" @bind="_prefijo" maxlength="10" /></label>
                    <label class="campo">Número * <input class="e-input" @bind="_numero" maxlength="20" /></label>
                    <label class="campo campo-ancho">CUDE <input class="e-input" @bind="_cude" maxlength="96" /></label>
                    <label class="campo">Emisión * <input type="date" class="e-input" value="@(_emision?.ToString("yyyy-MM-dd"))" @onchange="@(e => _emision = LeerFecha(e.Value))" /></label>
                    <label class="campo campo-ancho">Motivo <input class="e-input" @bind="_motivoNota" maxlength="500" /></label>
                    @if (_referencia is { } referencia)
                    {
                        <label class="campo">Referencia <input class="e-input" disabled value="@referencia" /></label>
                    }
                </div>
                @if (_lineasFactura.Count > 0)
                {
                    <div class="tabla-desplazable">
                        <table class="data-grid">
                            <thead><tr><th>Línea de la factura</th><th class="numero">Cantidad facturada</th><th class="numero">Valor de la nota</th><th>Cambia el costo de lo recibido</th></tr></thead>
                            <tbody>
                                @foreach (var l in _lineasFactura)
                                {
                                    <tr>
                                        <td>@l.Producto</td>
                                        <td class="numero">@l.Cantidad.ToString("N4")</td>
                                        <td class="numero"><input class="e-input numero" type="number" min="0" step="any" @bind="l.Valor" /></td>
                                        <td><input type="checkbox" @bind="l.AfectaCosto" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                <div class="toolbar">
                    <SfButton CssClass="e-outline" Disabled="@(!PuedeGuardar)" OnClick="@GuardarAsync">Guardar y calcular impuestos</SfButton>
                    @if (_borrador is not null)
                    {
                        <SfButton CssClass="e-primary" IconCss="e-icons e-check" OnClick="@ConfirmarAsync">Confirmar la nota</SfButton>
                    }
                </div>
                @* US7 (T539): lo que dijo Contabilidad antes de confirmar. *@
                <ResultadoDeValidacionPrevia @ref="_validacion" Documento="@_borrador?.PublicId" />
                @if (_borrador is { } b)
                {
                    @if (b.Warnings.Count > 0) { <div class="aviso aviso-alerta"><ul>@foreach (var a in b.Warnings) { <li>@a.Message</li> }</ul></div> }
                    <ImpuestosDeCompra Renglones="@b.TaxLines" Totales="@b.Totals" />
                }
            </IndicadorDeCarga>
        </div>
    </PermissionGate>

    <IndicadorDeCarga Cargando="@_carga.Activa">
        @if (!_carga.Activa && _notas.Count == 0)
        {
            <p class="texto-tenue">No hay notas de proveedor registradas.</p>
        }
        else
        {
            <div class="tabla-desplazable">
                <table class="data-grid">
                    <thead><tr><th>Registro</th><th>Nota</th><th>Clase</th><th>Fecha</th><th>Proveedor</th><th>Estado</th><th class="numero">Total</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var n in _notas)
                        {
                            <tr>
                                <td><a href="@($"/compras/notas-proveedor/{n.Document.PublicId}")">@(n.Document.DisplayNumber ?? "(borrador)")</a></td>
                                <td>@n.Supplier?.Prefix@n.Supplier?.Number</td>
                                <td>@(n.Supplier?.IsDebitNote == true ? "Débito" : "Crédito")</td>
                                <td>@n.Document.OperationDate.ToString("dd/MM/yyyy")</td>
                                <td>@n.Document.Counterparty?.Name</td>
                                <td>@TextosDeInventario.Estado(n.Document.Status)</td>
                                <td class="numero">@n.Document.Total?.ToString("N2")</td>
                                <td>
                                    @if (n.Document.Status == 2 && n.Document.VoidedBy is null)
                                    {
                                        <PermissionGate Required="Inventory.Purchases.Void">
                                            <SfButton CssClass="e-flat" OnClick="@(() => AbrirAnulacion(n.Document.PublicId))">Anular</SfButton>
                                        </PermissionGate>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </IndicadorDeCarga>
</div>

@* Revisión comercial (2026-11-12): anular pide el motivo que escribe quien anula (antes iba uno fijo). *@
<SfDialog @bind-Visible="_mostrarAnulacion" Header="Anular la nota del proveedor" Width="520px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@_guardado.Activa" Texto="Guardando…">
                <p class="texto-apoyo">Se crea el documento contrario con su propia fecha; el número del proveedor queda libre. Si la nota había ajustado lo que se le debe en Tesorería, se revierte.</p>
                <label class="campo campo-ancho">Motivo * <input class="e-input" @bind="_motivoAnulacion" @bind:event="oninput" maxlength="500" /></label>
                <div class="toolbar">
                    <SfButton CssClass="e-primary" Disabled="@(_guardado.Activa || string.IsNullOrWhiteSpace(_motivoAnulacion))" OnClick="@AnularAsync">Anular</SfButton>
                    <SfButton CssClass="e-outline" OnClick="@(() => _mostrarAnulacion = false)">Cancelar</SfButton>
                </div>
            </IndicadorDeCarga>
        </Content>
    </DialogTemplates>
</SfDialog>
</PermissionGate>

@code {
    private sealed class LineaDeNota
    {
        public Guid InvoiceLinePublicId { get; set; }
        public string Producto { get; set; } = "";
        public decimal Cantidad { get; set; }
        public decimal Valor { get; set; }
        public bool AfectaCosto { get; set; }
    }

    /// <summary>Revisión comercial (2026-11-12): la nota que pide una devolución, prellenada: <c>?devolucion={id}&amp;factura={id}</c>.</summary>
    [SupplyParameterFromQuery(Name = "devolucion")] public Guid? Devolucion { get; set; }

    [SupplyParameterFromQuery(Name = "factura")] public Guid? FacturaDeLaDevolucion { get; set; }

    private readonly EstadoDeCarga _carga = new(), _guardado = new();
    private ClaveDeOperacion _claveGuardar = new(), _claveConfirmar = new();
    private ClaveDeOperacion _claveAnular = new();
    private Guid? _anulando;
    private string? _motivoAnulacion, _referencia;
    private bool _mostrarAnulacion;
    private List<ResumenDeFacturaDeProveedorDto> _notas = [], _facturas = [];
    private List<TipoDeDocumentoDto> _tipos = [];
    private List<LineaDeNota> _lineasFactura = [];
    private PersonSearchPicker.PersonSearchItem? _proveedor;
    private Guid? _factura, _tipo;
    private string _clase = "Credit";
    private string? _prefijo, _numero, _cude, _motivoNota;
    private DateOnly? _emision = DateOnly.FromDateTime(DateTime.Today);
    private DocumentoDeInventarioDto? _borrador;
    private ResultadoDeValidacionPrevia? _validacion;

    private bool PuedeGuardar => _proveedor is not null && _factura is not null && _tipo is not null && !string.IsNullOrWhiteSpace(_numero)
                                 && _lineasFactura.Any(l => l.Valor > 0m) && !_guardado.Activa;

    protected override async Task OnInitializedAsync()
    {
        var tipos = await Inventario.ListarTiposAsync(grupo: 1);
        _tipos = tipos.IsSuccess ? [.. (tipos.Value ?? []).Where(t => t.IsActive && t.Class == ClasesDeCompra.Nota)] : [];
        _tipo = _tipos.FirstOrDefault()?.PublicId;
        await CargarAsync();
        if (Devolucion is { } devolucion && FacturaDeLaDevolucion is { } factura) await PrellenarDesdeLaDevolucionAsync(devolucion, factura);
    }

    /// <summary>
    /// Revisión comercial (2026-11-12): la nota crédito que pide una devolución de lo ya facturado —el proveedor, la factura, las líneas con su valor al
    /// precio neto facturado, el motivo y la referencia de la devolución—. Falta lo que pone el proveedor: su número, su CUDE y la fecha.
    /// </summary>
    private async Task PrellenarDesdeLaDevolucionAsync(Guid devolucion, Guid factura)
    {
        using var carga = _carga.Iniciar();
        var p = await Compras.NotaPorDevolucionAsync(devolucion);
        if (!p.IsSuccess || p.Value is null) { await Notification.ErrorAsync(p.ErrorMessage ?? "No se pudo leer la devolución."); return; }
        var propuesta = p.Value.Invoices.FirstOrDefault(f => f.InvoicePublicId == factura);
        if (propuesta is null) { await Notification.WarningAsync("La devolución no pide nota sobre esa factura."); return; }
        var f = await Compras.ObtenerFacturaAsync(factura);
        if (!f.IsSuccess || f.Value is null) { await Notification.ErrorAsync(f.ErrorMessage ?? "No se pudo leer la factura."); return; }
        if (SelectorDeProveedor.Desde(f.Value.Document.Counterparty) is { } proveedor) await CambiarProveedorAsync(proveedor);
        await ElegirFacturaAsync(factura.ToString());
        _clase = "Credit";
        foreach (var l in _lineasFactura)
            l.Valor = propuesta.Lines.Where(x => x.InvoiceLinePublicId == l.InvoiceLinePublicId).Sum(x => x.Amount);
        _referencia = p.Value.Reference;
        _motivoNota = $"Devolución de mercancía {p.Value.ReturnNumber}".Trim();
        await Notification.InfoAsync("Nota prellenada con lo devuelto: escriba el número, el CUDE y la fecha de la nota que emitió el proveedor.");
    }

    private async Task CargarAsync()
    {
        using var carga = _carga.Iniciar();
        var r = await Compras.ListarNotasAsync(new FiltroDeCompras { PageSize = 50 });
        _notas = r.IsSuccess ? [.. r.Value!.Items] : [];
        if (!r.IsSuccess) await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudieron consultar las notas.");
    }

    private async Task CambiarProveedorAsync(PersonSearchPicker.PersonSearchItem? proveedor)
    {
        _proveedor = proveedor;
        _factura = null;
        _lineasFactura = [];
        _facturas = [];
        if (proveedor is null) return;
        var r = await Compras.ListarFacturasAsync(new FiltroDeCompras { SupplierPersonPublicId = proveedor.PublicId, Status = 2, PageSize = 100 });
        _facturas = r.IsSuccess ? [.. r.Value!.Items] : [];
    }

    private async Task ElegirFacturaAsync(string? valor)
    {
        _factura = Guid.TryParse(valor, out var g) ? g : null;
        _lineasFactura = [];
        _borrador = null;
        if (_factura is not { } id) return;
        var r = await Compras.ObtenerFacturaAsync(id);
        if (!r.IsSuccess || r.Value is null) return;
        _lineasFactura = r.Value.Document.Lines.OrderBy(l => l.LineNumber).Select(l => new LineaDeNota
        {
            InvoiceLinePublicId = l.LinePublicId, Producto = $"{l.Product.Code} · {l.Product.Name}", Cantidad = l.Quantity,
        }).ToList();
    }

    private async Task GuardarAsync()
    {
        using var guardado = _guardado.Iniciar();
        var pedido = new BorradorDeCompraRequest(_tipo!.Value, null, null, _proveedor!.PublicId, _referencia, _motivoNota, null, _borrador?.RowVersion,
            _lineasFactura.Where(l => l.Valor > 0m)
                .Select(l => new LineaDeCompraRequest(null, Guid.Empty, Guid.Empty, 0m, InvoiceLinePublicId: l.InvoiceLinePublicId, Amount: l.Valor, AffectsCost: l.AfectaCosto ? true : null))
                .ToList(),
            Supplier: new DocumentoDelProveedorRequest(string.IsNullOrWhiteSpace(_prefijo) ? null : _prefijo.Trim(), _numero!.Trim(),
                string.IsNullOrWhiteSpace(_cude) ? null : _cude.Trim(), _emision ?? DateOnly.FromDateTime(DateTime.Today), null, null, !string.IsNullOrWhiteSpace(_cude)),
            SupplierInvoicePublicId: _factura, NoteKind: _clase);
        var r = await Compras.GuardarAsync(ComprasClient.Rutas.Notas, _borrador?.PublicId, pedido, _claveGuardar);
        if (!r.IsSuccess || r.Value is null) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo guardar la nota."); return; }
        _borrador = r.Value;
    }

    private async Task ConfirmarAsync()
    {
        if (_borrador is null) return;
        if (_validacion is not null && !await _validacion.ValidarAsync()) return;
        using var guardado = _guardado.Iniciar();
        var r = await Compras.ConfirmarAsync(ComprasClient.Rutas.Notas, _borrador.PublicId, _borrador.RowVersion, _claveConfirmar);
        if (!r.IsSuccess || r.Value is null)
        {
            if (_validacion?.MostrarRechazo(r) != true) await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo confirmar la nota.");
            return;
        }
        _validacion?.Limpiar();
        await Notification.SuccessAsync(r.Value.Status == 1 ? "La nota quedó en aprobación." : $"Nota {r.Value.DisplayNumber} registrada.");
        _borrador = null;
        _claveGuardar = new();
        _claveConfirmar = new();
        _numero = _prefijo = _cude = _motivoNota = _referencia = null;
        await ElegirFacturaAsync(_factura?.ToString());
        await CargarAsync();
    }

    /// <summary>Cada anulación lleva su propia clave de operación y el motivo que se escribe.</summary>
    private void AbrirAnulacion(Guid nota)
    {
        _anulando = nota;
        _motivoAnulacion = null;
        _claveAnular = new ClaveDeOperacion();
        _mostrarAnulacion = true;
    }

    private async Task AnularAsync()
    {
        if (_anulando is not { } nota || string.IsNullOrWhiteSpace(_motivoAnulacion)) return;
        using var guardado = _guardado.Iniciar();
        var r = await Compras.AnularAsync(ComprasClient.Rutas.Notas, nota, _motivoAnulacion.Trim(), _claveAnular);
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo anular la nota."); return; }
        _mostrarAnulacion = false;
        _anulando = null;
        await Notification.SuccessAsync($"Nota anulada con {r.Value?.DisplayNumber}.");
        await CargarAsync();
    }

    private static DateOnly? LeerFecha(object? valor) =>
        DateOnly.TryParse(valor?.ToString(), System.Globalization.CultureInfo.InvariantCulture, out var f) ? f : null;
}
