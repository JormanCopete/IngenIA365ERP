@page "/admin/tenants/new"
@page "/admin/tenants/{PublicId:guid}"
@using IngenIA365ERP.Shared.Configuration
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>@(_isNew ? "Nueva cooperativa" : "Editar cooperativa") — IngenIA365ERP</PageTitle>

<div class="admin-page">
    <h1>@(_isNew ? "Registrar cooperativa" : "Editar cooperativa")</h1>

    <EditForm Model="_model" OnValidSubmit="SaveAsync" FormName="tenant-edit">
        <DataAnnotationsValidator />

        <fieldset>
            <legend>Identificación</legend>
            <div class="row">
                <label>Nombre comercial<InputText @bind-Value="_model.Name" /></label>
                @if (_isNew) { <label>Schema SQL<InputText @bind-Value="_model.SchemaName" /></label> }
            </div>
            <div class="row">
                <label>NIT<InputText @bind-Value="_model.Nit" disabled="@(!_isNew)" /></label>
                <label>Razón social<InputText @bind-Value="_model.LegalName" /></label>
            </div>
            <div class="row">
                <label>Dirección legal<InputText @bind-Value="_model.LegalAddress" /></label>
                <label>Régimen tributario<InputText @bind-Value="_model.TaxRegime" /></label>
            </div>
            <div class="row">
                <label>Subdominio<InputText @bind-Value="_model.Subdomain" disabled="@(!_isNew)" /></label>
            </div>
        </fieldset>

        <fieldset>
            <legend>Contacto</legend>
            <div class="row">
                <label>Email<InputText @bind-Value="_model.ContactEmail" /></label>
                <label>Teléfono<InputText @bind-Value="_model.ContactPhone" /></label>
            </div>
        </fieldset>

        <fieldset>
            <legend>Plan</legend>
            <div class="row">
                <label>Plan<InputText @bind-Value="_model.PlanType" /></label>
                <label>Usuarios máx<InputNumber @bind-Value="_model.MaxUsers" /></label>
                <label>Almacenamiento (MB)<InputNumber @bind-Value="_model.StorageLimitMb" /></label>
            </div>
        </fieldset>

        <ValidationSummary />
        @if (_error is not null) { <p class="error">@_error</p> }

        <div class="actions">
            <button type="submit" class="primary" disabled="@_saving">Guardar</button>
            <button type="button" @onclick="Cancel">Cancelar</button>
        </div>
    </EditForm>
</div>

@code {
    [Parameter] public Guid? PublicId { get; set; }
    private bool _isNew => PublicId is null;
    private readonly Model _model = new();
    private bool _saving;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        if (_isNew) return;
        var resp = await Http.GetAsync($"{AppSettings.GetApiBaseUrl()}/api/saas/tenants?search=");
        // En una UI real, traería /api/saas/tenants/{publicId}. Stub: el list contiene lo necesario.
        // Mantengo el handler sin Get individual por brevedad; T079 lo cierra cuando aterricen las UIs Users/Roles.
    }

    private async Task SaveAsync()
    {
        _saving = true; _error = null;
        try
        {
            var url = $"{AppSettings.GetApiBaseUrl()}/api/saas/tenants";
            HttpResponseMessage resp = _isNew
                ? await Http.PostAsJsonAsync(url, new
                {
                    name = _model.Name,
                    schemaName = _model.SchemaName,
                    subdomain = _model.Subdomain,
                    nit = _model.Nit,
                    legalName = _model.LegalName,
                    legalAddress = _model.LegalAddress,
                    taxRegime = _model.TaxRegime,
                    contactEmail = _model.ContactEmail,
                    contactPhone = _model.ContactPhone,
                    planType = _model.PlanType,
                    maxUsers = _model.MaxUsers,
                    storageLimitMb = _model.StorageLimitMb
                })
                : await Http.PutAsJsonAsync($"{url}/{PublicId}", new
                {
                    name = _model.Name,
                    legalName = _model.LegalName,
                    legalAddress = _model.LegalAddress,
                    taxRegime = _model.TaxRegime,
                    contactEmail = _model.ContactEmail,
                    contactPhone = _model.ContactPhone,
                    planType = _model.PlanType,
                    maxUsers = _model.MaxUsers,
                    storageLimitMb = _model.StorageLimitMb
                });

            if (resp.IsSuccessStatusCode)
            {
                Nav.NavigateTo("/admin/tenants");
            }
            else
            {
                _error = await resp.Content.ReadAsStringAsync();
            }
        }
        finally { _saving = false; }
    }

    private void Cancel() => Nav.NavigateTo("/admin/tenants");

    public sealed class Model
    {
        [Required, MaxLength(200)] public string Name { get; set; } = string.Empty;
        [Required, MaxLength(50)] public string SchemaName { get; set; } = string.Empty;
        [MaxLength(100)] public string? Subdomain { get; set; }
        [Required, MaxLength(20)] public string Nit { get; set; } = string.Empty;
        [Required, MaxLength(200)] public string LegalName { get; set; } = string.Empty;
        [MaxLength(300)] public string? LegalAddress { get; set; }
        [MaxLength(50)] public string? TaxRegime { get; set; }
        [Required, EmailAddress, MaxLength(200)] public string ContactEmail { get; set; } = string.Empty;
        [MaxLength(30)] public string? ContactPhone { get; set; }
        [Required, MaxLength(50)] public string PlanType { get; set; } = "Basic";
        [Range(1, 10000)] public int MaxUsers { get; set; } = 10;
        [Range(1, long.MaxValue)] public long StorageLimitMb { get; set; } = 5120;
    }
}
