@page "/admin/tenants"
@using IngenIA365ERP.Shared.Services.Security
@inject CooperativasClient Clientes
@inject NavigationManager Nav
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Cooperativas — IngenIA365ERP</PageTitle>

<div class="pagina">
    <div class="page-header">
        <div>
            <h2>Cooperativas</h2>
            <p class="texto-apoyo">Las empresas que usan el ERP.</p>
        </div>
        <div>
            <button class="boton-principal" type="button" @onclick="Nueva">Registrar cooperativa</button>
        </div>
    </div>

    <div class="toolbar">
        <label>
            Buscar
            <input type="search" placeholder="Nombre, NIT o subdominio…"
                   @bind="_busqueda" @bind:event="oninput" @bind:after="CargarAsync" />
        </label>
        <label class="campo-check">
            <input type="checkbox" @bind="_incluirSuspendidas" @bind:after="CargarAsync" />
            <span>Incluir suspendidas</span>
        </label>
    </div>

    @if (_mensaje is not null)
    {
        <div class="aviso @(_error ? "aviso-error" : "aviso-ok")" role="status">@_mensaje</div>
    }

    @if (_suspendiendo is not null)
    {
        <section class="tarjeta">
            <h3>Suspender «@_suspendiendo.Name»</h3>
            <p class="texto-apoyo">
                Corta el acceso a todos sus usuarios. El motivo queda registrado y
                se ve al reactivar, así que escribí algo que le sirva a quien lo lea
                dentro de seis meses.
            </p>
            <label for="motivo">Motivo</label>
            <input id="motivo" type="text" @bind="_motivo" @bind:event="oninput"
                   placeholder="Ej.: mora de tres meses en la suscripción" />
            <div class="acciones">
                <button class="boton-peligro" type="button"
                        disabled="@(string.IsNullOrWhiteSpace(_motivo) || _ocupada is not null)"
                        @onclick="ConfirmarSuspensionAsync">
                    @(_ocupada is not null ? "Suspendiendo…" : "Suspender")
                </button>
                <button class="boton-secundario" type="button"
                        @onclick="@(() => { _suspendiendo = null; _motivo = string.Empty; })">Cancelar</button>
            </div>
        </section>
    }

    @if (_cargando)
    {
        <p class="texto-apoyo">Cargando…</p>
    }
    else if (_cooperativas.Count == 0)
    {
        <div class="tarjeta">
            <p class="texto-apoyo">Sin resultados.</p>
        </div>
    }
    else
    {
        <section class="tarjeta">
            <table class="data-grid">
                <thead>
                    <tr>
                        <th scope="col">Nombre</th>
                        <th scope="col">NIT</th>
                        <th scope="col">Subdominio</th>
                        <th scope="col">Plan</th>
                        <th scope="col">Estado</th>
                        <th scope="col">Sucursales</th>
                        <th scope="col"><span class="visualmente-oculto">Acciones</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in _cooperativas)
                    {
                        <tr @key="c.PublicId">
                            <td>@c.Name</td>
                            <td>@c.Nit</td>
                            <td>@c.Subdomain</td>
                            <td>@c.PlanType</td>
                            <td>
                                <span class="pastilla @ClaseEstado(c)">@Estado(c)</span>
                            </td>
                            <td>@c.BranchCount</td>
                            <td class="celda-acciones">
                                <button class="boton-secundario" type="button"
                                        @onclick="() => Editar(c.PublicId)">Editar</button>
                                <button class="boton-secundario" type="button"
                                        @onclick="() => VerInvitaciones(c.PublicId)">Invitaciones</button>
                                @if (c.IsSuspended)
                                {
                                    <button class="boton-principal" type="button"
                                            disabled="@(_ocupada == c.PublicId)"
                                            @onclick="() => ReactivarAsync(c)">Reactivar</button>
                                }
                                else
                                {
                                    <button class="boton-peligro" type="button"
                                            @onclick="() => PedirMotivo(c)">Suspender</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }
</div>

@code {
    private List<CooperativaResumen> _cooperativas = [];
    private CooperativaResumen? _suspendiendo;
    private string _busqueda = string.Empty;
    private string _motivo = string.Empty;
    private bool _incluirSuspendidas;
    private bool _cargando = true;
    private Guid? _ocupada;
    private string? _mensaje;
    private bool _error;

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        _cargando = true;
        var r = await Clientes.ListarAsync(_busqueda, _incluirSuspendidas);
        _cargando = false;

        if (r.IsSuccess && r.Value is not null)
        {
            _cooperativas = [.. r.Value.Items];
        }
        else
        {
            _error = true;
            _mensaje = r.ErrorMessage ?? "No se pudieron cargar las cooperativas.";
        }
    }

    private void PedirMotivo(CooperativaResumen c)
    {
        // El motivo se pide SIEMPRE. Antes iba cableado como "Suspendido desde
        // panel", que no le dice nada a nadie cuando alguien pregunta por qué
        // una cooperativa lleva dos semanas sin poder entrar.
        _suspendiendo = c;
        _motivo = string.Empty;
        _mensaje = null;
    }

    private async Task ConfirmarSuspensionAsync()
    {
        if (_suspendiendo is null) return;
        _ocupada = _suspendiendo.PublicId;
        try
        {
            var r = await Clientes.SuspenderAsync(_suspendiendo.PublicId, _motivo.Trim());
            _error = !r.IsSuccess;
            _mensaje = r.IsSuccess
                ? $"«{_suspendiendo.Name}» quedó suspendida."
                : r.ErrorMessage;
            if (r.IsSuccess)
            {
                _suspendiendo = null;
                _motivo = string.Empty;
                await CargarAsync();
            }
        }
        finally { _ocupada = null; }
    }

    private async Task ReactivarAsync(CooperativaResumen c)
    {
        _ocupada = c.PublicId;
        try
        {
            var r = await Clientes.ReactivarAsync(c.PublicId);
            _error = !r.IsSuccess;
            _mensaje = r.IsSuccess ? $"«{c.Name}» quedó activa." : r.ErrorMessage;
            if (r.IsSuccess) await CargarAsync();
        }
        finally { _ocupada = null; }
    }

    private void Nueva() => Nav.NavigateTo("/saas/register-tenant");
    private void Editar(Guid publicId) => Nav.NavigateTo($"/admin/tenants/{publicId}");
    private void VerInvitaciones(Guid publicId) => Nav.NavigateTo($"/admin/tenants/{publicId}/invitaciones");

    private static string Estado(CooperativaResumen c) =>
        c.IsSuspended ? "Suspendida" : c.IsActive ? "Activa" : "Inactiva";

    private static string ClaseEstado(CooperativaResumen c) =>
        c.IsSuspended ? "pastilla-alerta" : c.IsActive ? "pastilla-exito" : "pastilla-tenue";
}
