@page "/admin/tenants/{TenantPublicId:guid}/invitaciones"
@using IngenIA365ERP.Shared.Services.Security
@using IngenIA365ERP.Shared.Services.Http
@inject CooperativasClient Clientes
@inject HttpClient Http
@inject NavigationManager Nav
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Invitaciones — IngenIA365ERP</PageTitle>

<div class="pagina">
    <div class="page-header">
        <div>
            <h2>Invitaciones</h2>
            <p class="texto-apoyo">@(_nombreCooperativa ?? "Cooperativa")</p>
        </div>
        <div>
            <label class="campo-check">
                <input type="checkbox" @bind="_incluirCerradas" @bind:after="CargarAsync" />
                <span>Incluir aceptadas y canceladas</span>
            </label>
            <button class="boton-secundario" type="button" @onclick="Volver">Volver</button>
        </div>
    </div>

    @if (_mensaje is not null)
    {
        <div class="aviso @(_error ? "aviso-error" : "aviso-ok")" role="status">@_mensaje</div>
    }

    @* Faltaba. La pantalla listaba, reenviaba y cancelaba invitaciones, y el
       botón «Invitar persona» de Usuarios traía aquí — a una lista vacía sin
       ningún sitio desde el que invitar. Se invita, no se crea: la invitación es
       lo único que da de alta las dos mitades de la persona (la identidad central
       y su usuario en la cooperativa). *@
    @* Feature 017: la invitación se ancla al documento de la persona. El número se digita dos
       veces; el correo es el canal de la invitación y la otra forma de entrar. *@
    <section class="tarjeta">
        <h3>@(_corrigiendo is null ? "Invitar a una persona" : "Corregir la invitación")</h3>
        <p class="texto-apoyo">
            Recibe un correo con un enlace que vence en unos días. Con ese enlace confirma su
            número de documento, crea su contraseña —o entra con la que ya tiene— y queda como
            miembro de @(_nombreCooperativa ?? "esta cooperativa"). Podrá entrar con su correo o con
            su usuario de documento.
        </p>
        <IndicadorDeCarga Cargando="@_cargaFormulario.Activa">
            <div class="rejilla-campos">
                <label>Tipo de documento
                    <select @bind="_f.Tipo" disabled="@_enviando">
                        @foreach (var t in _tipos)
                        {
                            <option value="@t.Codigo">@t.Codigo — @t.Nombre</option>
                        }
                    </select>
                </label>
                <label>Número de documento
                    <input type="text" autocomplete="off" @bind="_f.Numero" @bind:event="oninput" disabled="@_enviando" />
                </label>
                <label>Repita el número
                    <input type="text" autocomplete="off" @bind="_f.Confirmacion" @bind:event="oninput" disabled="@_enviando"
                           @onpaste:preventDefault="true" />
                </label>
                <label>Primer nombre
                    <input type="text" @bind="_f.Nombre" disabled="@_enviando" />
                </label>
                <label>Otros nombres
                    <input type="text" @bind="_f.OtrosNombres" disabled="@_enviando" />
                </label>
                <label>Primer apellido
                    <input type="text" @bind="_f.Apellido" disabled="@_enviando" />
                </label>
                <label>Segundo apellido
                    <input type="text" @bind="_f.SegundoApellido" disabled="@_enviando" />
                </label>
                <label>Correo personal
                    <input type="email" placeholder="correo@dominio.com" @bind="_f.Correo" @bind:event="oninput" disabled="@_enviando" />
                </label>
                <label>Celular
                    <input type="tel" @bind="_f.Celular" disabled="@_enviando" />
                </label>
                @if (!_esMaestro)
                {
                    <label>Rol
                        <select @bind="_f.Rol" disabled="@_enviando">
                            <option value="">Sólo lectura (por defecto)</option>
                            @foreach (var r in _roles)
                            {
                                <option value="@r.PublicId">@r.Name</option>
                            }
                        </select>
                    </label>
                    <label>Cargo
                        <select @bind="_f.Cargo" disabled="@_enviando">
                            <option value="">Sin cargo</option>
                            @foreach (var c in _cargos)
                            {
                                <option value="@c.PublicId">@c.Name</option>
                            }
                        </select>
                    </label>
                }
            </div>
            @if (_f.Numero is { Length: > 0 } && _f.Confirmacion is { Length: > 0 } && !NumerosCoinciden)
            {
                <p class="aviso aviso-error" role="alert">Los dos números de documento no coinciden.</p>
            }
            <div class="toolbar">
                @if (_esMaestro && _corrigiendo is null)
                {
                    <label class="campo-check">
                        <input type="checkbox" @bind="_comoAdministradora" disabled="@_enviando" />
                        <span>Como administradora de la cooperativa</span>
                    </label>
                }
                <button class="boton-principal" type="button"
                        disabled="@(_enviando || !FormularioValido)"
                        @onclick="InvitarAsync">
                    @(_enviando ? "Enviando…" : _corrigiendo is null ? "Enviar invitación" : "Guardar y enviar de nuevo")
                </button>
                @if (_corrigiendo is not null)
                {
                    <button class="boton-secundario" type="button" disabled="@_enviando" @onclick="CancelarCorreccion">Cancelar corrección</button>
                }
            </div>
        </IndicadorDeCarga>
    </section>

    @if (_cargando)
    {
        <p class="texto-apoyo">Cargando…</p>
    }
    else if (_invitaciones.Count == 0)
    {
        <div class="tarjeta">
            <p class="texto-apoyo">
                @(_incluirCerradas
                    ? "Esta cooperativa no tiene invitaciones."
                    : "No hay invitaciones pendientes. Marcá la casilla para ver las cerradas.")
            </p>
        </div>
    }
    else
    {
        <section class="tarjeta">
            <table class="data-grid">
                <thead>
                    <tr>
                        <th scope="col">Persona</th>
                        <th scope="col">Documento</th>
                        <th scope="col">Correo</th>
                        <th scope="col">Estado</th>
                        <th scope="col">Rol</th>
                        <th scope="col">Enviada</th>
                        <th scope="col">Vence</th>
                        <th scope="col"><span class="visualmente-oculto">Acciones</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in _invitaciones)
                    {
                        <tr @key="i.PublicId">
                            <td>@(i.NombreCompleto ?? "—")</td>
                            <td>@(i.TipoDeDocumento is null ? "—" : $"{i.TipoDeDocumento} {i.DocumentoEnmascarado}")</td>
                            <td>@i.Email</td>
                            <td>
                                @* Estado con texto además del color: una pastilla de
                                   color sola no la puede leer quien no distingue bien. *@
                                <span class="pastilla @ClasePastilla(i)">@EtiquetaEstado(i)</span>
                            </td>
                            <td>@(i.ComoAdministrador ? "Administradora" : "Miembro")</td>
                            <td class="texto-apoyo">@i.CreadaEn.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="texto-apoyo">@i.ExpiraEn.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            <td class="celda-acciones">
                                @if (i.Estado is "Pending" or "UnderReview")
                                {
                                    @if (i.TipoDeDocumento is not null)
                                    {
                                        <button class="boton-secundario" type="button"
                                                disabled="@(_ocupada == i.PublicId)"
                                                @onclick="() => Corregir(i)">Corregir</button>
                                    }
                                    <button class="boton-principal" type="button"
                                            disabled="@(_ocupada == i.PublicId)"
                                            @onclick="() => ReenviarAsync(i)">
                                        @(_ocupada == i.PublicId ? "Enviando…" : "Reenviar")
                                    </button>
                                    <button class="boton-peligro" type="button"
                                            disabled="@(_ocupada == i.PublicId)"
                                            @onclick="() => RevocarAsync(i)">Cancelar</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>

        <p class="texto-apoyo">
            Reenviar genera un enlace nuevo y anula el anterior: el token original
            sólo se guarda cifrado y no se puede recuperar. Si la persona encuentra
            el correo viejo, ese enlace ya no funcionará.
        </p>
    }
</div>

@code {
    [Parameter] public Guid TenantPublicId { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private List<InvitacionResumen> _invitaciones = [];
    private string? _nombreCooperativa;
    private bool _incluirCerradas;
    private bool _cargando = true;
    private Guid? _ocupada;
    private string? _mensaje;
    private bool _error;

    // Formulario de invitación (feature 017).
    private sealed class Formulario
    {
        public string Tipo { get; set; } = "CC";
        public string? Numero { get; set; }
        public string? Confirmacion { get; set; }
        public string? Nombre { get; set; }
        public string? OtrosNombres { get; set; }
        public string? Apellido { get; set; }
        public string? SegundoApellido { get; set; }
        public string? Correo { get; set; }
        public string? Celular { get; set; }
        public string Rol { get; set; } = string.Empty;
        public string Cargo { get; set; } = string.Empty;
    }

    private sealed record Opcion(Guid PublicId, string Name);

    private Formulario _f = new();
    private InvitacionResumen? _corrigiendo;
    private List<TipoDeDocumentoDeAcceso> _tipos = [];
    private List<Opcion> _roles = [];
    private List<Opcion> _cargos = [];
    private readonly EstadoDeCarga _cargaFormulario = new();
    private bool _comoAdministradora;
    private bool _enviando;
    private bool _esMaestro;

    private static string Normalizado(string? n) =>
        new((n ?? string.Empty).ToUpperInvariant().Where(c => c is >= '0' and <= '9' or >= 'A' and <= 'Z').ToArray());

    private bool NumerosCoinciden => Normalizado(_f.Numero) == Normalizado(_f.Confirmacion);

    private bool FormularioValido =>
        !string.IsNullOrWhiteSpace(_f.Correo)
        && System.Net.Mail.MailAddress.TryCreate(_f.Correo.Trim(), out _)
        && !string.IsNullOrWhiteSpace(_f.Numero)
        && NumerosCoinciden
        && !string.IsNullOrWhiteSpace(_f.Nombre)
        && !string.IsNullOrWhiteSpace(_f.Apellido);

    private async Task CargarCatalogosAsync()
    {
        using var carga = _cargaFormulario.Iniciar();
        var politica = await Clientes.ObtenerPoliticaDeIdentidadAsync(TenantPublicId);
        if (politica.IsSuccess && politica.Value is { } p)
        {
            _tipos = p.Catalogo.Where(t => p.TiposAceptados.Contains(t.Codigo)).ToList();
            if (_tipos.Count > 0 && !_tipos.Any(t => t.Codigo == _f.Tipo)) _f.Tipo = _tipos[0].Codigo;
        }

        // Roles y cargos son de la cooperativa activa: el maestro, que invita administradoras, no los elige.
        if (!_esMaestro)
        {
            try
            {
                _roles = (await Http.TryGetListAsync<Opcion>("/api/admin/roles?page=1&pageSize=200")).ToList();
                _cargos = (await Http.TryGetListAsync<Opcion>("/api/core/positions?pageSize=500")).ToList();
            }
            catch (HttpRequestException) { /* sin catálogos se invita sin rol ni cargo; la API valida */ }
        }
    }

    private void Corregir(InvitacionResumen i)
    {
        _corrigiendo = i;
        var partes = (i.NombreCompleto ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries);
        _f = new Formulario
        {
            Tipo = i.TipoDeDocumento ?? "CC",
            Correo = i.Email,
            Nombre = partes.ElementAtOrDefault(0),
            Apellido = partes.Length > 1 ? partes[^1] : null,
            Rol = i.RolPublicId?.ToString() ?? string.Empty,
            Cargo = i.CargoPublicId?.ToString() ?? string.Empty,
        };
        _mensaje = "Revise los datos y digite de nuevo el número de documento, dos veces.";
        _error = false;
    }

    private void CancelarCorreccion()
    {
        _corrigiendo = null;
        _f = new Formulario { Tipo = _tipos.FirstOrDefault()?.Codigo ?? "CC" };
    }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            _esMaestro = bool.TryParse(user.FindFirst("is_global_master_admin")?.Value, out var m) && m;
        }

        // El nombre de la cooperativa (para el subtítulo) y la lista de invitaciones no dependen
        // entre sí: van a la vez (eran dos viajes en serie de ~0,35 s cada uno). Cada rama escribe
        // campos distintos; si el nombre no llega, el subtítulo cae a «Cooperativa» como antes.
        await Task.WhenAll(CargarNombreAsync(), CargarAsync(), CargarCatalogosAsync());
    }

    private async Task InvitarAsync()
    {
        if (!FormularioValido || _enviando) return;

        var datos = new DatosDeInvitacion(
            _f.Correo!.Trim(), _f.Tipo, _f.Numero, _f.Confirmacion,
            _f.Nombre, _f.OtrosNombres, _f.Apellido, _f.SegundoApellido, _f.Celular,
            Guid.TryParse(_f.Rol, out var rol) ? rol : null,
            Guid.TryParse(_f.Cargo, out var cargo) ? cargo : null);
        _enviando = true;
        try
        {
            var r = _corrigiendo is { } original
                ? await Clientes.CorregirInvitacionAsync(TenantPublicId, original.PublicId, datos)
                : await Clientes.InvitarAsync(
                    TenantPublicId, datos,
                    comoAdministradora: _esMaestro && _comoAdministradora,
                    comoMaestro: _esMaestro);

            _error = !r.IsSuccess;
            if (r.IsSuccess && r.Value is { } emitida)
            {
                // El mismo mensaje haya o no cuenta (D-05): nunca se dice a qué correo salió.
                _mensaje = $"{emitida.Message ?? "Invitación enviada."} El enlace vence el {emitida.ExpiresAt.ToLocalTime():dd/MM/yyyy}.";
                _corrigiendo = null;
                _f = new Formulario { Tipo = _tipos.FirstOrDefault()?.Codigo ?? "CC" };
                _comoAdministradora = false;
                await CargarAsync();
            }
            else
            {
                // Si lo que falló fue el servidor de correo, la invitación quedó
                // creada igual y aparece abajo como pendiente: se reenvía desde ahí.
                _mensaje = (r.ErrorMessage ?? "No se pudo emitir la invitación.") +
                           " Si el problema fue el envío del correo, la invitación quedó creada y podés reenviarla desde la lista.";
                await CargarAsync();
            }
        }
        finally { _enviando = false; }
    }


    private async Task CargarNombreAsync()
    {
        var r = await Clientes.ListarAsync(incluirSuspendidas: true);
        if (r.IsSuccess && r.Value is not null)
        {
            _nombreCooperativa = r.Value.Items
                .FirstOrDefault(t => t.PublicId == TenantPublicId)?.Name;
        }
    }

    private async Task CargarAsync()
    {
        _cargando = true;
        var r = await Clientes.ListarInvitacionesAsync(TenantPublicId, _incluirCerradas);
        _cargando = false;

        if (r.IsSuccess && r.Value is not null)
        {
            _invitaciones = [.. r.Value];
        }
        else
        {
            _error = true;
            _mensaje = r.ErrorMessage ?? "No se pudieron cargar las invitaciones.";
        }
    }

    private async Task ReenviarAsync(InvitacionResumen i)
    {
        _ocupada = i.PublicId;
        try
        {
            var r = await Clientes.ReenviarInvitacionAsync(TenantPublicId, i.PublicId);
            if (r.IsSuccess && r.Value is { } res)
            {
                // Correo no enviado NO es éxito para quien pulsó el botón, aunque la
                // invitación nueva haya quedado: se muestra en rojo y con el motivo.
                _error = !res.CorreoEnviado;
                _mensaje = res.CorreoEnviado
                    ? $"Enviado de nuevo a {res.Email}. El enlace vence el {res.ExpiraEn.ToLocalTime():dd/MM/yyyy}."
                    : $"La invitación se generó de nuevo para {res.Email}, pero el correo no salió: {res.MotivoCorreoNoEnviado} " +
                      "El enlace anterior ya no sirve. Cuando el servidor de correo esté disponible, volvé a pulsar «Reenviar».";
                await CargarAsync();
            }
            else
            {
                _error = true;
                _mensaje = r.ErrorMessage;
            }
        }
        finally { _ocupada = null; }
    }

    private async Task RevocarAsync(InvitacionResumen i)
    {
        _ocupada = i.PublicId;
        try
        {
            var r = await Clientes.RevocarInvitacionAsync(i.PublicId);
            _error = !r.IsSuccess;
            _mensaje = r.IsSuccess
                ? $"Invitación de {i.Email} cancelada."
                : r.ErrorMessage;
            if (r.IsSuccess) await CargarAsync();
        }
        finally { _ocupada = null; }
    }

    // El maestro llega desde la consola de cooperativas; el administrador de una
    // cooperativa llega desde Usuarios, y /admin/tenants no es suyo.
    private void Volver() => Nav.NavigateTo(_esMaestro ? "/admin/tenants" : "/security/users");

    // Una invitación vencida sigue con estado Pending en la base: expira por
    // fecha, no por un cambio de estado. Mostrarla como "Pendiente" haría creer
    // que el enlace todavía sirve.
    private static string EtiquetaEstado(InvitacionResumen i) => i.Expirada
        ? "Vencida"
        : i.Estado switch
        {
            "Pending" => "Pendiente",
            "Accepted" => "Aceptada",
            "Revoked" => "Cancelada",
            "Superseded" => "Reemplazada",
            "Expired" => "Vencida",
            "UnderReview" => "En revisión",
            _ => i.Estado,
        };

    private static string ClasePastilla(InvitacionResumen i) => i.Expirada
        ? "pastilla-alerta"
        : i.Estado switch
        {
            "Pending" => "pastilla-info",
            "Accepted" => "pastilla-exito",
            "Revoked" => "pastilla-peligro",
            "UnderReview" => "pastilla-alerta",
            _ => "pastilla-tenue",
        };
}
