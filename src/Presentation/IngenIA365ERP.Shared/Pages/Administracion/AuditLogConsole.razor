@page "/admin/auditoria"
@using IngenIA365ERP.Shared.Configuration
@using Microsoft.JSInterop
@using System.Net.Http.Json
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject HttpClient Http
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Registro de auditoría — IngenIA365ERP</PageTitle>

<PermissionGate Required="AuditLog.View" MostrarAviso="true">
    <ChildContent>
        <div class="admin-page">
            <div class="page-header">
                <h1>Registro de auditoría</h1>
            </div>

            <div class="toolbar">
                <label>Usuario
                    <input type="text" placeholder="UserId" @bind="_userId" />
                </label>
                <label>Módulo
                    <input type="text" placeholder="Security" @bind="_module" />
                </label>
                <label>Acción
                    <input type="text" placeholder="Created/Updated/…" @bind="_action" />
                </label>
                <label>Entidad
                    <input type="text" placeholder="User" @bind="_entityType" />
                </label>
                <label>Desde
                    <input type="date" @bind="_from" />
                </label>
                <label>Hasta
                    <input type="date" @bind="_to" />
                </label>
                <button class="primary" @onclick="SearchAsync" disabled="@_loading">Buscar</button>

                <PermissionGate Required="AuditLog.Export">
                    <ChildContent>
                        <button @onclick="ExportCsvAsync" disabled="@_loading">Exportar CSV</button>
                        <button @onclick="ExportPdfAsync" disabled="@_loading">Exportar PDF firmado</button>
                    </ChildContent>
                </PermissionGate>
            </div>

            @if (_loading) { <p>Cargando…</p> }
            else if (_error is not null) { <p class="error aviso aviso-error" role="alert">@_error</p> }
            else if (_items.Count == 0) { <p>Sin resultados para los filtros aplicados.</p> }
            else
            {
                <p class="muted">@_totalCount eventos — página @_page de @TotalPages</p>

                <table class="data-grid">
                    <thead>
                        <tr>
                            <th>Fecha (UTC)</th>
                            <th>Usuario</th>
                            <th>Módulo</th>
                            <th>Acción</th>
                            <th>Entidad</th>
                            <th>Id</th>
                            <th>IP</th>
                            <th>Endpoint</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in _items)
                        {
                            <tr>
                                <td>@e.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>@e.UserName</td>
                                <td>@e.Module</td>
                                <td>@e.Action</td>
                                <td>@e.EntityType</td>
                                <td>@e.EntityId</td>
                                <td>@e.IpAddress</td>
                                <td>@e.Endpoint</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="actions">
                    <button @onclick="PrevPageAsync" disabled="@(_page <= 1 || _loading)">‹ Anterior</button>
                    <button @onclick="NextPageAsync" disabled="@(_page >= TotalPages || _loading)">Siguiente ›</button>
                </div>
            }
        </div>
    </ChildContent>
    <Fallback>
        <div class="admin-page">
            <p>No tienes permiso para consultar el registro de auditoría.</p>
        </div>
    </Fallback>
</PermissionGate>

@code {
    private const int PageSize = 50;

    private string? _userId, _module, _action, _entityType;
    private DateTime? _from, _to;
    private int _page = 1;
    private long _totalCount;
    private bool _loading;
    private string? _error;
    private List<AuditEntryItem> _items = new();

    private IJSObjectReference? _downloadModule;

    private int TotalPages => PageSize <= 0 ? 0
        : (int)Math.Ceiling((double)_totalCount / PageSize);

    protected override Task OnInitializedAsync() => SearchAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _downloadModule = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./audit-console.js");
        }
    }

    private async Task SearchAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true; _error = null;
        try
        {
            var url = BuildQueryUrl(_page, PageSize);
            var resp = await Http.GetAsync(url);
            if (!resp.IsSuccessStatusCode)
            {
                _error = await ExtractErrorAsync(resp);
                _items = new();
                _totalCount = 0;
                return;
            }
            var page = await resp.Content.ReadFromJsonAsync<PagedDto<AuditEntryItem>>();
            _items = page?.Items?.ToList() ?? new();
            _totalCount = page?.TotalCount ?? 0;
        }
        catch (Exception ex)
        {
            _error = $"Error de red: {ex.Message}";
        }
        finally { _loading = false; }
    }

    private async Task PrevPageAsync()
    {
        if (_page > 1) { _page--; await LoadAsync(); }
    }

    private async Task NextPageAsync()
    {
        if (_page < TotalPages) { _page++; await LoadAsync(); }
    }

    private Task ExportCsvAsync() =>
        DownloadAsync("/api/audit/logs/export.csv", "text/csv", $"audit-{DateTime.UtcNow:yyyyMMdd-HHmmss}.csv");

    private Task ExportPdfAsync() =>
        DownloadAsync("/api/audit/logs/export.pdf", "application/pdf", $"audit-{DateTime.UtcNow:yyyyMMdd-HHmmss}.pdf");

    private async Task DownloadAsync(string endpoint, string contentType, string fileName)
    {
        if (_downloadModule is null) return;
        _loading = true; _error = null;
        try
        {
            var url = $"{AppSettings.GetApiBaseUrl()}{endpoint}{BuildExportQueryString()}";
            using var resp = await Http.GetAsync(url, HttpCompletionOption.ResponseHeadersRead);
            if (!resp.IsSuccessStatusCode)
            {
                _error = await ExtractErrorAsync(resp);
                return;
            }
            // Usa el filename del header si el backend lo sugiere.
            var serverFileName = resp.Content.Headers.ContentDisposition?.FileNameStar
                ?? resp.Content.Headers.ContentDisposition?.FileName
                ?? fileName;
            using var stream = await resp.Content.ReadAsStreamAsync();
            using var streamRef = new DotNetStreamReference(stream, leaveOpen: false);
            await _downloadModule.InvokeVoidAsync(
                "downloadFromStream", serverFileName, contentType, streamRef);
        }
        catch (Exception ex)
        {
            _error = $"Error descargando export: {ex.Message}";
        }
        finally { _loading = false; }
    }

    private string BuildQueryUrl(int page, int pageSize)
    {
        var qs = new List<string>
        {
            $"page={page}",
            $"pageSize={pageSize}"
        };
        AppendIfPresent(qs, "userId", _userId);
        AppendIfPresent(qs, "module", _module);
        AppendIfPresent(qs, "action", _action);
        AppendIfPresent(qs, "entityType", _entityType);
        if (_from is not null) qs.Add($"from={_from.Value:yyyy-MM-dd}");
        if (_to is not null) qs.Add($"to={_to.Value:yyyy-MM-dd}");
        return $"{AppSettings.GetApiBaseUrl()}/api/audit/logs?{string.Join("&", qs)}";
    }

    private string BuildExportQueryString()
    {
        var qs = new List<string>();
        AppendIfPresent(qs, "userId", _userId);
        AppendIfPresent(qs, "module", _module);
        AppendIfPresent(qs, "action", _action);
        AppendIfPresent(qs, "entityType", _entityType);
        if (_from is not null) qs.Add($"from={_from.Value:yyyy-MM-dd}");
        if (_to is not null) qs.Add($"to={_to.Value:yyyy-MM-dd}");
        return qs.Count == 0 ? string.Empty : "?" + string.Join("&", qs);
    }

    private static void AppendIfPresent(List<string> qs, string name, string? value)
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            qs.Add($"{name}={Uri.EscapeDataString(value.Trim())}");
        }
    }

    private static async Task<string> ExtractErrorAsync(HttpResponseMessage resp)
    {
        try
        {
            var env = await resp.Content.ReadFromJsonAsync<ErrorEnvelope>();
            return env is null
                ? $"Error {(int)resp.StatusCode}"
                : $"{env.Code}: {env.Message}";
        }
        catch
        {
            return $"Error {(int)resp.StatusCode}";
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_downloadModule is not null)
        {
            try { await _downloadModule.DisposeAsync(); }
            catch (JSDisconnectedException) { /* navigation away */ }
        }
    }

    public sealed record AuditEntryItem(
        string Id, string TenantId, string UserId, string UserName,
        string Action, string EntityType, string? EntityId, string Module,
        string? IpAddress, string? Endpoint, string? HttpMethod, int? HttpStatusCode,
        long DurationMs, DateTime Timestamp,
        string? OldValuesJson, string? NewValuesJson, IReadOnlyList<string>? ChangedFields);

    public sealed record PagedDto<T>(IReadOnlyList<T> Items, int Page, int PageSize, long TotalCount);

    private sealed record ErrorEnvelope(string Code, string Message, string? TraceId);
}
