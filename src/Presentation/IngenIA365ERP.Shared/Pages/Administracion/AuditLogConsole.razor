@page "/admin/auditoria"
@using IngenIA365ERP.Shared.Configuration
@using Microsoft.JSInterop
@using System.Net.Http.Json
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject HttpClient Http
@inject IJSRuntime JS
@inject IngenIA365ERP.Shared.Services.Auditoria.IntegridadDeAuditoriaClient Integridad
@implements IAsyncDisposable

<PageTitle>Registro de auditoría — IngenIA365ERP</PageTitle>

<PermissionGate Required="AuditLog.View" MostrarAviso="true">
    <ChildContent>
        <div class="admin-page">
            <div class="page-header">
                <h1>Registro de auditoría</h1>
                @* Feature 012, T435 (FR-007, FR-008, US12-4, US12-5): la pestaña «Integridad» recalcula la cadena de sellos. *@
                <div class="toolbar">
                    <button class="@(_pestana == 0 ? "primary" : "")" @onclick="@(() => _pestana = 0)">Eventos</button>
                    <PermissionGate Required="AuditLog.VerifyIntegrity">
                        <button class="@(_pestana == 1 ? "primary" : "")" @onclick="@(() => _pestana = 1)">Integridad</button>
                    </PermissionGate>
                </div>
            </div>

            @if (_pestana == 1)
            {
                <PermissionGate Required="AuditLog.VerifyIntegrity" MostrarAviso="true">
                    <p class="texto-apoyo">
                        Recalcula la cadena de sellos de los módulos encadenados (inventario, facturación electrónica, integración,
                        aprobaciones, alertas, parámetros, impuestos, medios de pago y navegación) contra el testigo de la base y las anclas firmadas.
                    </p>
                    <div class="toolbar">
                        <label>Desde <input type="date" @bind="_verificarDesde" /></label>
                        <label>Hasta <input type="date" @bind="_verificarHasta" /></label>
                        <button class="primary" @onclick="VerificarAsync" disabled="@_verificacion.Activa">Verificar</button>
                    </div>
                    <IndicadorDeCarga Cargando="@_verificacion.Activa" Texto="Verificando la cadena…">
                        @if (_errorDeVerificacion is not null) { <p class="aviso aviso-error" role="alert">@_errorDeVerificacion</p> }
                        @if (_resultado is { } v)
                        {
                            <p class="texto-apoyo">
                                Revisados @v.Checked evento(s)@(v.FromSeq is null ? "" : $" (posiciones {v.FromSeq} a {v.ToSeq})") y @v.AnchorsChecked ancla(s).
                            </p>
                            @if (v.Incidents.Count == 0)
                            {
                                <p class="aviso aviso-ok">Sin incidentes: la cadena está íntegra en el rango.</p>
                            }
                            else
                            {
                                <table class="data-grid">
                                    <thead><tr><th>Hallazgo</th><th>Posición</th><th>Evento</th><th>Fecha (UTC)</th></tr></thead>
                                    <tbody>
                                        @foreach (var i in v.Incidents)
                                        {
                                            <tr>
                                                <td>@IngenIA365ERP.Shared.Services.Inventario.TextosDeSeguridad.HallazgoDeIntegridad(i.Kind)</td>
                                                <td>@i.Seq</td>
                                                <td>@i.EventId</td>
                                                <td>@i.OccurredAt?.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        }
                    </IndicadorDeCarga>
                </PermissionGate>
            }
            else
            {
            <div class="toolbar">
                <label>Usuario
                    <input type="text" placeholder="UserId" @bind="_userId" />
                </label>
                <label>Módulo
                    <input type="text" placeholder="Security" list="modulos-auditoria" @bind="_module" />
                    <datalist id="modulos-auditoria">
                        <option value="Navigation">Navigation — ingreso a opciones (feature 009)</option>
                        <option value="Security" /><option value="Core" /><option value="Payroll" /><option value="Accounting" />
                        <option value="Lending" /><option value="Inventory" /><option value="Treasury" /><option value="CDT" /><option value="General" />
                        <option value="ElectronicInvoicing" /><option value="Integration" /><option value="Approvals" /><option value="Alerts" />
                        <option value="Parameters" /><option value="Taxes" /><option value="PaymentMeans" />
                    </datalist>
                </label>
                <label>Acción
                    <input type="text" placeholder="Created/Updated/…" @bind="_action" />
                </label>
                <label>Entidad
                    <input type="text" placeholder="User" @bind="_entityType" />
                </label>
                <label>Desde
                    <input type="date" @bind="_from" />
                </label>
                <label>Hasta
                    <input type="date" @bind="_to" />
                </label>
                <label><input type="checkbox" @bind="_encadenados" /> sólo módulos encadenados</label>
                <label><input type="checkbox" @bind="_soloRechazos" /> sólo rechazos</label>
                <button class="primary" @onclick="SearchAsync" disabled="@_loading">Buscar</button>

                <PermissionGate Required="AuditLog.Export">
                    <ChildContent>
                        <button @onclick="ExportCsvAsync" disabled="@_loading">Exportar CSV</button>
                        <button @onclick="ExportPdfAsync" disabled="@_loading">Exportar PDF firmado</button>
                    </ChildContent>
                </PermissionGate>
            </div>

            <IndicadorDeCarga Cargando="@_loading">
            @if (_loading) { <p>Cargando…</p> }
            else if (_error is not null) { <p class="error aviso aviso-error" role="alert">@_error</p> }
            else if (_items.Count == 0) { <p>Sin resultados para los filtros aplicados.</p> }
            else
            {
                <p class="muted">@_totalCount eventos — página @_page de @TotalPages</p>

                <table class="data-grid">
                    <thead>
                        <tr>
                            <th>Fecha (UTC)</th>
                            <th>Usuario</th>
                            <th>Módulo</th>
                            <th>Acción</th>
                            <th>Entidad</th>
                            <th>Opción</th>
                            <th>Id</th>
                            <th>IP</th>
                            <th>Canal</th>
                            <th>Actor</th>
                            <th>Resultado</th>
                            <th>Motivo</th>
                            <th>Cadena</th>
                            <th>Endpoint</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in _items)
                        {
                            <tr>
                                <td>@e.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>@e.UserName</td>
                                <td>@e.Module</td>
                                <td>@e.Action</td>
                                <td>@e.EntityType</td>
                                <td>@Opcion(e)</td>
                                <td>@e.EntityId</td>
                                <td>@e.IpAddress</td>
                                <td>@e.Channel</td>
                                <td>@(e.ActorKind == "Process" ? "Proceso" : e.ActorKind == "Person" ? "Persona" : "")</td>
                                <td>@(e.Result == "Rejected" ? $"Rechazado: {e.ErrorCode}" : "")</td>
                                <td>@e.Reason</td>
                                <td>@e.ChainSeq</td>
                                <td>@e.Endpoint</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="actions">
                    <button @onclick="PrevPageAsync" disabled="@(_page <= 1 || _loading)">‹ Anterior</button>
                    <button @onclick="NextPageAsync" disabled="@(_page >= TotalPages || _loading)">Siguiente ›</button>
                </div>
            }
            </IndicadorDeCarga>
            }
        </div>
    </ChildContent>
    <Fallback>
        <div class="admin-page">
            <p>No tienes permiso para consultar el registro de auditoría.</p>
        </div>
    </Fallback>
</PermissionGate>

@code {
    private const int PageSize = 50;

    private string? _userId, _module, _action, _entityType;
    private DateTime? _from, _to;
    private int _page = 1;
    private long _totalCount;
    private bool _loading;
    private string? _error;
    private List<AuditEntryItem> _items = new();
    private bool _encadenados, _soloRechazos;
    private int _pestana;
    private DateTime? _verificarDesde = DateTime.UtcNow.Date.AddDays(-30), _verificarHasta = DateTime.UtcNow.Date;
    private readonly EstadoDeCarga _verificacion = new();
    private IngenIA365ERP.Shared.Services.Auditoria.VerificacionDeAuditoriaDto? _resultado;
    private string? _errorDeVerificacion;

    /// <summary>Los módulos cuya auditoría va por la cadena de sellos (feature 012, T36–T38).</summary>
    private const string ModulosEncadenados = "Inventory,ElectronicInvoicing,Integration,Approvals,Alerts,Parameters,Taxes,PaymentMeans,Navigation";

    private async Task VerificarAsync()
    {
        if (_verificarDesde is not { } desde || _verificarHasta is not { } hasta) { _errorDeVerificacion = "Indique el rango."; return; }
        using var carga = _verificacion.Iniciar();
        _errorDeVerificacion = null;
        var r = await Integridad.VerificarAsync(DateTime.SpecifyKind(desde, DateTimeKind.Utc), DateTime.SpecifyKind(hasta.AddDays(1).AddTicks(-1), DateTimeKind.Utc));
        if (!r.IsSuccess) { _resultado = null; _errorDeVerificacion = r.ErrorMessage ?? "No se pudo verificar la cadena."; return; }
        _resultado = r.Value;
    }

    private int TotalPages => PageSize <= 0 ? 0
        : (int)Math.Ceiling((double)_totalCount / PageSize);

    protected override Task OnInitializedAsync() => SearchAsync();

    private async Task SearchAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true; _error = null;
        try
        {
            var url = BuildQueryUrl(_page, PageSize);
            var resp = await Http.GetAsync(url);
            if (!resp.IsSuccessStatusCode)
            {
                _error = await ExtractErrorAsync(resp);
                _items = new();
                _totalCount = 0;
                return;
            }
            var page = await resp.Content.ReadFromJsonAsync<PagedDto<AuditEntryItem>>();
            _items = page?.Items?.ToList() ?? new();
            _totalCount = page?.TotalCount ?? 0;
        }
        catch (Exception ex)
        {
            _error = $"Error de red: {ex.Message}";
        }
        finally { _loading = false; }
    }

    private async Task PrevPageAsync()
    {
        if (_page > 1) { _page--; await LoadAsync(); }
    }

    private async Task NextPageAsync()
    {
        if (_page < TotalPages) { _page++; await LoadAsync(); }
    }

    private Task ExportCsvAsync() =>
        DownloadAsync("/api/audit/logs/export.csv", "text/csv", $"audit-{DateTime.UtcNow:yyyyMMdd-HHmmss}.csv");

    private Task ExportPdfAsync() =>
        DownloadAsync("/api/audit/logs/export.pdf", "application/pdf", $"audit-{DateTime.UtcNow:yyyyMMdd-HHmmss}.pdf");

    private async Task DownloadAsync(string endpoint, string contentType, string fileName)
    {
        _loading = true; _error = null;
        try
        {
            var url = $"{AppSettings.GetApiBaseUrl()}{endpoint}{BuildExportQueryString()}";
            using var resp = await Http.GetAsync(url, HttpCompletionOption.ResponseHeadersRead);
            if (!resp.IsSuccessStatusCode)
            {
                _error = await ExtractErrorAsync(resp);
                return;
            }
            // Usa el filename del header si el backend lo sugiere.
            var serverFileName = resp.Content.Headers.ContentDisposition?.FileNameStar
                ?? resp.Content.Headers.ContentDisposition?.FileName
                ?? fileName;
            using var stream = await resp.Content.ReadAsStreamAsync();
            using var streamRef = new DotNetStreamReference(stream, leaveOpen: false);
            // Feature 009 (T045): el helper de descarga vive en Shared/wwwroot/js/descargas.js.
            await JS.InvokeVoidAsync("descargas.downloadFromStream", serverFileName, contentType, streamRef);
        }
        catch (Exception ex)
        {
            _error = $"Error descargando export: {ex.Message}";
        }
        finally { _loading = false; }
    }

    private string BuildQueryUrl(int page, int pageSize)
    {
        var qs = new List<string>
        {
            $"page={page}",
            $"pageSize={pageSize}"
        };
        AppendIfPresent(qs, "userId", _userId);
        AppendIfPresent(qs, "module", _module);
        AppendIfPresent(qs, "action", _action);
        AppendIfPresent(qs, "entityType", _entityType);
        if (_from is not null) qs.Add($"from={_from.Value:yyyy-MM-dd}");
        if (_to is not null) qs.Add($"to={_to.Value:yyyy-MM-dd}");
        if (_encadenados) qs.Add($"modules={Uri.EscapeDataString(ModulosEncadenados)}");
        if (_soloRechazos) qs.Add("result=Rejected");
        return $"{AppSettings.GetApiBaseUrl()}/api/audit/logs?{string.Join("&", qs)}";
    }

    private string BuildExportQueryString()
    {
        var qs = new List<string>();
        AppendIfPresent(qs, "userId", _userId);
        AppendIfPresent(qs, "module", _module);
        AppendIfPresent(qs, "action", _action);
        AppendIfPresent(qs, "entityType", _entityType);
        if (_from is not null) qs.Add($"from={_from.Value:yyyy-MM-dd}");
        if (_to is not null) qs.Add($"to={_to.Value:yyyy-MM-dd}");
        return qs.Count == 0 ? string.Empty : "?" + string.Join("&", qs);
    }

    private static void AppendIfPresent(List<string> qs, string name, string? value)
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            qs.Add($"{name}={Uri.EscapeDataString(value.Trim())}");
        }
    }

    private static async Task<string> ExtractErrorAsync(HttpResponseMessage resp)
    {
        try
        {
            var env = await resp.Content.ReadFromJsonAsync<ErrorEnvelope>();
            return env is null
                ? $"Error {(int)resp.StatusCode}"
                : $"{env.Code}: {env.Message}";
        }
        catch
        {
            return $"Error {(int)resp.StatusCode}";
        }
    }

    /// <summary>Feature 009 (FR-051): en los eventos de navegación, el título y la ruta de la opción vienen en newValuesJson.</summary>
    private static string Opcion(AuditEntryItem e)
    {
        if (!string.Equals(e.Module, "Navigation", StringComparison.OrdinalIgnoreCase) || string.IsNullOrWhiteSpace(e.NewValuesJson)) return "";
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(e.NewValuesJson);
            var raiz = doc.RootElement;
            string? Leer(string a, string b) => raiz.TryGetProperty(a, out var v) ? v.GetString() : raiz.TryGetProperty(b, out var w) ? w.GetString() : null;
            var titulo = Leer("title", "Title");
            var ruta = Leer("route", "Route");
            return string.IsNullOrEmpty(titulo) ? ruta ?? "" : $"{titulo} ({ruta})";
        }
        catch (System.Text.Json.JsonException)
        {
            return e.NewValuesJson.Length > 60 ? e.NewValuesJson[..60] + "…" : e.NewValuesJson;
        }
    }

    public ValueTask DisposeAsync() => ValueTask.CompletedTask;

    public sealed record AuditEntryItem(
        string Id, string TenantId, string UserId, string UserName,
        string Action, string EntityType, string? EntityId, string Module,
        string? IpAddress, string? Endpoint, string? HttpMethod, int? HttpStatusCode,
        long DurationMs, DateTime Timestamp,
        string? OldValuesJson, string? NewValuesJson, IReadOnlyList<string>? ChangedFields,
        string? Channel = null, string? ActorKind = null, string? Origin = null, string? Reason = null,
        string Result = "Accepted", string? ErrorCode = null, string? OperationKey = null, long? ChainSeq = null);

    public sealed record PagedDto<T>(IReadOnlyList<T> Items, int Page, int PageSize, long TotalCount);

    private sealed record ErrorEnvelope(string Code, string Message, string? TraceId);
}
