@page "/admin/branches/new"
@page "/admin/branches/{PublicId:guid}"
@using IngenIA365ERP.Shared.Configuration
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>@(_isNew ? "Nueva sucursal" : "Editar sucursal") — IngenIA365ERP</PageTitle>

<div class="admin-page">
    <h1>@(_isNew ? "Crear sucursal" : "Editar sucursal")</h1>

    <EditForm Model="_model" OnValidSubmit="SaveAsync" FormName="branch-edit">
        <DataAnnotationsValidator />

        @if (_isNew)
        {
            <div class="row">
                <label>Tenant (PublicId)<InputText @bind-Value="_model.TenantPublicIdText" /></label>
                <label>Código<InputText @bind-Value="_model.Code" /></label>
            </div>
        }
        else
        {
            <p>Editando sucursal <code>@PublicId</code></p>
        }

        <div class="row">
            <label>Nombre<InputText @bind-Value="_model.Name" /></label>
            <label>Teléfono<InputText @bind-Value="_model.Phone" /></label>
        </div>
        <div class="row">
            <label>Dirección<InputText @bind-Value="_model.Address" /></label>
            <label>Email<InputText @bind-Value="_model.Email" /></label>
        </div>
        <div class="row">
            <label><InputCheckbox @bind-Value="_model.IsHeadquarters" /> Sucursal matriz</label>
        </div>

        <ValidationSummary />
        @if (_error is not null) { <p class="error">@_error</p> }

        <div class="actions">
            <button type="submit" class="primary" disabled="@_saving">Guardar</button>
            <button type="button" @onclick="Cancel">Cancelar</button>
        </div>
    </EditForm>
</div>

@code {
    [Parameter] public Guid? PublicId { get; set; }
    private bool _isNew => PublicId is null;
    private readonly Model _model = new();
    private bool _saving;
    private string? _error;

    private async Task SaveAsync()
    {
        _saving = true; _error = null;
        try
        {
            var url = $"{AppSettings.GetApiBaseUrl()}/api/admin/branches";
            HttpResponseMessage resp;
            if (_isNew)
            {
                if (!Guid.TryParse(_model.TenantPublicIdText, out var tpid))
                {
                    _error = "TenantPublicId inválido."; return;
                }
                resp = await Http.PostAsJsonAsync(url, new
                {
                    tenantPublicId = tpid,
                    code = _model.Code,
                    name = _model.Name,
                    address = _model.Address,
                    phone = _model.Phone,
                    email = _model.Email,
                    isHeadquarters = _model.IsHeadquarters
                });
            }
            else
            {
                resp = await Http.PutAsJsonAsync($"{url}/{PublicId}", new
                {
                    name = _model.Name,
                    address = _model.Address,
                    phone = _model.Phone,
                    email = _model.Email,
                    isHeadquarters = _model.IsHeadquarters
                });
            }

            if (resp.IsSuccessStatusCode) Nav.NavigateTo("/admin/branches");
            else _error = await resp.Content.ReadAsStringAsync();
        }
        finally { _saving = false; }
    }

    private void Cancel() => Nav.NavigateTo("/admin/branches");

    public sealed class Model
    {
        public string? TenantPublicIdText { get; set; }
        [Required, MaxLength(20)] public string Code { get; set; } = string.Empty;
        [Required, MaxLength(200)] public string Name { get; set; } = string.Empty;
        [MaxLength(300)] public string? Address { get; set; }
        [MaxLength(30)] public string? Phone { get; set; }
        [MaxLength(200), EmailAddress] public string? Email { get; set; }
        public bool IsHeadquarters { get; set; }
    }
}
