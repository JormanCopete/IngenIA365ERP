@page "/admin/branches"
@using IngenIA365ERP.Shared.Configuration
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>Oficinas — IngenIA365ERP</PageTitle>

<div class="admin-page">
    <div class="page-header">
        <h1>Oficinas</h1>
    </div>

    <div class="toolbar">
        <input type="search" placeholder="Buscar por código o nombre…" @bind="_search" @bind:event="oninput" />
        <label><input type="checkbox" @bind="_includeInactive" /> incluir inactivas</label>
        <button class="primary" @onclick="OpenCreate">+ Nueva oficina</button>
        <button @onclick="LoadAsync">Refrescar</button>
    </div>

    <IndicadorDeCarga Cargando="@_carga.Activa">
        @if (_error is not null) { <p class="error aviso aviso-error" role="alert">@_error</p> }
        else if (_items.Count == 0 && !_carga.Activa) { <p>Sin resultados.</p> }
        else
        {
            <table class="data-grid">
                <thead>
                    <tr>
                        <th>Código</th><th>Nombre</th><th>Dirección</th><th>Tel.</th>
                        <th>Principal</th><th>Estado</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in _items)
                    {
                        <tr>
                            <td>@b.Code</td>
                            <td>@b.Name</td>
                            <td>@b.Address</td>
                            <td>@b.Phone</td>
                            <td>@(b.IsHeadquarters ? "★" : "")</td>
                            <td>@(b.IsActive ? "Activa" : "Inactiva")</td>
                            <td>
                                <div class="acciones">
                                    <button @onclick="() => Edit(b.PublicId)">Editar</button>
                                    @if (b.IsActive && !b.IsHeadquarters)
                                    {
                                        <button @onclick="() => DeactivateAsync(b.PublicId)">Desactivar</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </IndicadorDeCarga>
</div>

@code {
    private List<BranchItem> _items = new();
    private string _search = string.Empty;
    private bool _includeInactive;
    private string? _error;

    // Indicadores de carga por zona (ver docs/manual/indicador-de-carga.md).
    private readonly EstadoDeCarga _carga = new();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _error = null;
        using var carga = _carga.Iniciar();
        var url = $"{AppSettings.GetApiBaseUrl()}/api/admin/branches?search={Uri.EscapeDataString(_search)}&includeInactive={_includeInactive}";
        var resp = await Http.GetAsync(url);
        if (!resp.IsSuccessStatusCode)
        {
            _error = $"Error {(int)resp.StatusCode}";
            return;
        }
        var page = await resp.Content.ReadFromJsonAsync<PagedResult<BranchItem>>();
        _items = page?.Items?.ToList() ?? new();
    }

    private void OpenCreate() => Nav.NavigateTo("/admin/branches/new");
    private void Edit(Guid publicId) => Nav.NavigateTo($"/admin/branches/{publicId}");

    private async Task DeactivateAsync(Guid publicId)
    {
        using var carga = _carga.Iniciar();
        var resp = await Http.PostAsync($"{AppSettings.GetApiBaseUrl()}/api/admin/branches/{publicId}/deactivate", null);
        if (resp.IsSuccessStatusCode) await LoadAsync();
        else _error = await resp.Content.ReadAsStringAsync();
    }

    public sealed record BranchItem(
        Guid PublicId, Guid TenantPublicId, string Code, string Name,
        string? Address, string? City, string? Department, string? Phone,
        bool IsActive, bool IsHeadquarters);

    public sealed record PagedResult<T>(IReadOnlyList<T> Items, int Page, int PageSize, long TotalCount);
}
