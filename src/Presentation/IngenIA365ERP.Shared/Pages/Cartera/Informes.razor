@page "/cartera/informes"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using IngenIA365ERP.Shared.Services.Cartera
@using IngenIA365ERP.Shared.Services.Http
@using IngenIA365ERP.Shared.Services.Inventario
@using IngenIA365ERP.Shared.Services.Nomina
@using IngenIA365ERP.Shared.Services.Reportes
@using IngenIA365ERP.Shared.Components.Reportes
@inject InformesDeCarteraClient InformesDeCartera
@inject LineasDeCreditoClient Lineas
@inject PermisosDelUsuario Permisos
@inject HttpClient Http
@inject INotificationService Notification
@inject NavigationManager Navigation
@inject DescargaDeArchivos Descargas

<PageTitle>Informes de cartera - IngenIA365ERP</PageTitle>

@* Feature 013, US15 (T0799, T98, T100; contracts/api.md §17): el centro de informes de Cartera, en el molde de /inventario/informes. El selector
   se alimenta del REGISTRO DE VISTAS de la API (GET /api/reports/lending): K1 publica edades, colocación, recaudo, movimientos, usura, mensajes
   al deudor y conciliación de la migración, y K2–K5 suman las suyas sin tocar esta pantalla. Filtros comunes: rango o corte, sucursal y línea
   (sólo las del alcance devuelven filas), modalidad, sub-segmento; los propios (groupBy, dateKind, ranges, points, purpose, channel, status,
   load…) se editan aquí o llegan por el enlace (?vista=aging&…) y viajan tal cual. Las columnas ocultas no se pintan ni se exportan: _credito
   abre el crédito, _operacion su crédito, _mensaje la bandeja. Exportar exige Lending.Reports.Export y, en las vistas con datos del deudor,
   además Lending.Reports.ExportPersonalData. *@
<PermissionGate Required="Lending.Reports.View" MostrarAviso="true">
<div class="pagina">
    <div class="page-header">
        <h3>Informes de cartera</h3>
        <div class="toolbar">
            @if (_tabla is not null && _vista is not null && PuedeExportar)
            {
                <PermissionGate Required="Lending.Reports.Export">
                    <SfButton CssClass="e-outline" IconCss="e-icons e-download" Disabled="@_carga.Activa" OnClick="@(() => DescargarAsync("xlsx"))">Excel</SfButton>
                    <SfButton CssClass="e-outline" IconCss="e-icons e-download" Disabled="@_carga.Activa" OnClick="@(() => DescargarAsync("pdf"))">PDF</SfButton>
                    <SfButton CssClass="e-outline" IconCss="e-icons e-download" Disabled="@_carga.Activa" OnClick="@(() => DescargarAsync("docx"))">Word</SfButton>
                </PermissionGate>
            }
        </div>
    </div>

    <IndicadorDeCarga Cargando="@_cargaVistas.Activa" Texto="Buscando los informes disponibles…">
        @if (!_cargaVistas.Activa && _vistas.Count == 0)
        {
            <p class="texto-tenue">No hay informes de cartera disponibles con sus permisos.</p>
        }
        else if (_vistas.Count > 0)
        {
            <div class="toolbar">
                <label class="campo">Informe
                    <select class="e-input" value="@(_vista?.Key)" @onchange="@(e => CambiarVista(e.Value?.ToString()))">
                        @foreach (var v in _vistas) { <option value="@v.Key">@v.Name</option> }
                    </select>
                </label>
                @if (Usa("from"))
                {
                    <label class="campo">Desde <input type="date" class="e-input" value="@Fecha(_filtros.From)" @onchange="@(e => _filtros.From = LeerFecha(e.Value))" /></label>
                }
                @if (Usa("to"))
                {
                    <label class="campo">Hasta <input type="date" class="e-input" value="@Fecha(_filtros.To)" @onchange="@(e => _filtros.To = LeerFecha(e.Value))" /></label>
                }
                @if (Usa("asOf"))
                {
                    <label class="campo">Con corte al <input type="date" class="e-input" value="@Fecha(_filtros.AsOf)" @onchange="@(e => _filtros.AsOf = LeerFecha(e.Value))" /></label>
                }
                @if (Usa("branch") && _sucursales.Count > 0)
                {
                    <label class="campo">Sucursal
                        <select class="e-input" value="@Otro("branch")" @onchange="@(e => PonerOtro("branch", e.Value?.ToString()))">
                            <option value="">Todas las del alcance</option>
                            @foreach (var s in _sucursales) { <option value="@s.PublicId">@s.Name</option> }
                        </select>
                    </label>
                }
                @if (Usa("line") && _lineas.Count > 0)
                {
                    <label class="campo">Línea
                        <select class="e-input" value="@Otro("line")" @onchange="@(e => PonerOtro("line", e.Value?.ToString()))">
                            <option value="">Todas las del alcance</option>
                            @foreach (var l in _lineas) { <option value="@l.PublicId">@l.Code · @l.Name</option> }
                        </select>
                    </label>
                }
                @if (Usa("modality"))
                {
                    <label class="campo">Modalidad <input class="e-input" value="@Otro("modality")" placeholder="CONSUMO, COMERCIAL…" @onchange="@(e => PonerOtro("modality", e.Value?.ToString()))" /></label>
                }
                @if (Usa("collector"))
                {
                    <label class="campo">Recaudador <input class="e-input" value="@Otro("collector")" placeholder="código" @onchange="@(e => PonerOtro("collector", e.Value?.ToString()))" /></label>
                }
                @if (UsaPropio("groupBy"))
                {
                    <label class="campo">Por
                        <select class="e-input" value="@Otro("groupBy")" @onchange="@(e => PonerOtro("groupBy", e.Value?.ToString()))">
                            @foreach (var (valor, texto) in DimensionesDeLaVista) { <option value="@valor">@texto</option> }
                        </select>
                    </label>
                }
                @if (UsaPropio("dateKind"))
                {
                    <label class="campo">Por fecha
                        <select class="e-input" value="@Otro("dateKind")" @onchange="@(e => PonerOtro("dateKind", e.Value?.ToString()))">
                            <option value="value">Valor</option>
                            <option value="accounting">Contable</option>
                            <option value="registered">De registro</option>
                        </select>
                    </label>
                }
                @if (UsaPropio("ranges"))
                {
                    <label class="campo">Rangos (días) <input class="e-input" value="@Otro("ranges")" placeholder="los de la cooperativa" @onchange="@(e => PonerOtro("ranges", e.Value?.ToString()))" /></label>
                }
                @if (UsaPropio("points"))
                {
                    <label class="campo">Puntos de alerta <input type="number" min="0" step="0.1" class="e-input" value="@Otro("points")" placeholder="los de la cooperativa" @onchange="@(e => PonerOtro("points", e.Value?.ToString()))" /></label>
                }
                @if (UsaPropio("purpose"))
                {
                    <label class="campo">Propósito
                        <select class="e-input" value="@Otro("purpose")" @onchange="@(e => PonerOtro("purpose", e.Value?.ToString()))">
                            <option value="">Todos</option>
                            <option value="Collection">Cobranza</option>
                            <option value="PriorNotice">Aviso previo</option>
                            <option value="Informative">Informativo</option>
                            <option value="DocumentDelivery">Envío de documento</option>
                            <option value="CollectionFeeNotice">Aviso de honorarios de cobranza</option>
                        </select>
                    </label>
                }
                @if (UsaPropio("channel"))
                {
                    <label class="campo">Canal
                        <select class="e-input" value="@Otro("channel")" @onchange="@(e => PonerOtro("channel", e.Value?.ToString()))">
                            <option value="">Todos</option>
                            <option value="Email">Correo</option>
                            <option value="Sms">SMS</option>
                            <option value="WhatsApp">WhatsApp</option>
                            <option value="Letter">Carta</option>
                        </select>
                    </label>
                }
                @if (UsaPropio("status"))
                {
                    <label class="campo">Estado
                        <select class="e-input" value="@Otro("status")" @onchange="@(e => PonerOtro("status", e.Value?.ToString()))">
                            <option value="">Todos</option>
                            @foreach (var (valor, texto) in EstadosDeLaVista) { <option value="@valor">@texto</option> }
                        </select>
                    </label>
                }
                @if (UsaPropio("kind") && _vista?.Key == "issued-documents")
                {
                    <label class="campo">Clase
                        <select class="e-input" value="@Otro("kind")" @onchange="@(e => PonerOtro("kind", e.Value?.ToString()))">
                            <option value="">Todas</option>
                            <option value="PaymentPlan">Plan de pagos</option>
                            <option value="Statement">Extracto</option>
                            <option value="LoanClearance">Paz y salvo de la obligación</option>
                            <option value="GeneralClearance">Paz y salvo general</option>
                            <option value="BalanceCertificate">Certificado de saldo</option>
                            <option value="TaxCertificate">Certificado tributario</option>
                        </select>
                    </label>
                }
                @if (UsaPropio("by"))
                {
                    <label class="campo">Concentración por
                        <select class="e-input" value="@Otro("by")" @onchange="@(e => PonerOtro("by", e.Value?.ToString()))">
                            <option value="debtor">Deudor</option>
                            <option value="group">Grupo conectado</option>
                            <option value="line">Línea</option>
                            <option value="sector">Sector</option>
                            <option value="payer">Pagaduría</option>
                        </select>
                    </label>
                }
                @* Feature 014, US17 (T222): el período de las vistas del GMF y de los formatos regulatorios de captaciones (la exógena, sólo el año). *@
                @if (UsaPropio("year"))
                {
                    <label class="campo">Año <input type="number" min="2000" max="2999" class="e-input" value="@Otro("year")" placeholder="@AnioPorDefecto" @onchange="@(e => PonerOtro("year", e.Value?.ToString()))" /></label>
                }
                @if (UsaPropio("month"))
                {
                    <label class="campo">Mes <input type="number" min="1" max="12" class="e-input" value="@Otro("month")" placeholder="el anterior" @onchange="@(e => PonerOtro("month", e.Value?.ToString()))" /></label>
                }
                @if (UsaPropio("top"))
                {
                    <label class="campo">Mayores <input type="number" min="1" max="500" class="e-input" value="@Otro("top")" placeholder="20" @onchange="@(e => PonerOtro("top", e.Value?.ToString()))" /></label>
                }
                @if (UsaPropio("warnAt"))
                {
                    <label class="campo">Señal desde (% del límite) <input type="number" min="1" max="100" class="e-input" value="@Otro("warnAt")" placeholder="80" @onchange="@(e => PonerOtro("warnAt", e.Value?.ToString()))" /></label>
                }
                @if (UsaPropio("load"))
                {
                    <label class="campo">Carga de migración <input class="e-input" value="@Otro("load")" placeholder="identificador de la carga" @onchange="@(e => PonerOtro("load", e.Value?.ToString()))" /></label>
                }
                <SfButton CssClass="e-primary" IconCss="e-icons e-search" Disabled="@(_carga.Activa || _vista is null)" OnClick="@AplicarAsync">Consultar</SfButton>
            </div>
            @if (FiltrosDelEnlace.Count > 0)
            {
                <p class="texto-tenue">
                    Filtros del enlace: @string.Join(" · ", FiltrosDelEnlace.Select(o => $"{o.Key} = {o.Value}"))
                    <button type="button" class="enlace" @onclick="@QuitarFiltrosDelEnlace">quitarlos</button>
                </p>
            }
            <p class="texto-tenue">@(_vista?.Description)</p>
        }
    </IndicadorDeCarga>

    <IndicadorDeCarga Cargando="@_carga.Activa">
        @if (_vistas.Count > 0)
        {
            <TablaDeReporte Tabla="@_tabla" TextoSinTabla="Elija el informe y los filtros y pulse «Consultar»."
                            FilasClicables="@Profundiza" EsClicable="@(f => Destino(f) is not null)" FilaElegida="@Profundizar" />
        }
    </IndicadorDeCarga>
</div>
</PermissionGate>

@code {
    /// <summary>Los filtros que la pantalla edita con su propio control: lo demás que vino en el enlace se muestra aparte.</summary>
    private static readonly HashSet<string> ConControl = new(StringComparer.Ordinal)
    {
        "branch", "line", "modality", "collector", "groupBy", "dateKind", "ranges", "points", "purpose", "channel", "status", "load",
        "by", "top", "warnAt", "year", "month",
    };

    private readonly EstadoDeCarga _cargaVistas = new(), _carga = new();
    private List<VistaDeInformeDeCarteraDto> _vistas = [];
    private List<ItemCrudo> _sucursales = [];
    private List<LineaDeCreditoResumenDto> _lineas = [];
    private VistaDeInformeDeCarteraDto? _vista;
    private FiltrosDeInformeDeInventarioModelo _filtros = new();
    private FiltrosDeInformeDeInventarioModelo _aplicados = new();
    private TablaReporteDto? _tabla;
    private bool _iniciado, _exportaDatosPersonales;

    [SupplyParameterFromQuery(Name = "vista")] public string? Vista { get; set; }

    private IEnumerable<KeyValuePair<string, string>> FiltrosDelEnlaceSinControl => _filtros.Otros.Where(o => !ConControl.Contains(o.Key));

    private List<KeyValuePair<string, string>> FiltrosDelEnlace => FiltrosDelEnlaceSinControl.ToList();

    protected override async Task OnParametersSetAsync()
    {
        if (_iniciado) return;
        _iniciado = true;
        _filtros = FiltrosDeInformeDeInventarioModelo.DesdeQuery(new Uri(Navigation.Uri).Query);
        var hoy = DateOnly.FromDateTime(DateTime.Today);
        _filtros.To ??= hoy;
        _filtros.From ??= new DateOnly(hoy.Year, hoy.Month, 1);
        _filtros.AsOf ??= hoy;

        using (_cargaVistas.Iniciar())
        {
            var r = await InformesDeCartera.VistasAsync();
            if (!r.IsSuccess)
            {
                await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudieron consultar los informes disponibles.");
                return;
            }
            _vistas = [.. r.Value ?? []];
            if (_vistas.Any(v => v.Filters.Contains("branch", StringComparer.OrdinalIgnoreCase)))
                _sucursales = await Http.TryGetListAsync<ItemCrudo>("/api/core/branches?PageNumber=1&PageSize=500&SortBy=name");
            if (_vistas.Any(v => v.Filters.Contains("line", StringComparer.OrdinalIgnoreCase)))
            {
                // Sin Lending.CreditLines.View la lista no llega y el filtro de línea sólo viaja por el enlace.
                var lineas = await Lineas.LineasAsync();
                _lineas = lineas.IsSuccess ? [.. lineas.Value ?? []] : [];
            }
        }

        _vista = _vistas.FirstOrDefault(v => v.Key == Vista) ?? _vistas.FirstOrDefault();
        await EvaluarExportacionAsync();
        // Llegar con ?vista= es profundizar desde otra pantalla: se consulta sola.
        if (_vista is not null && !string.IsNullOrWhiteSpace(Vista) && _vista.Key == Vista) await AplicarAsync();
    }

    private async Task CambiarVista(string? clave)
    {
        if (string.IsNullOrWhiteSpace(clave) || clave == _vista?.Key) return;
        _vista = _vistas.FirstOrDefault(v => v.Key == clave);
        _tabla = null;
        // Los filtros propios de una vista no significan lo mismo en otra (groupBy de colocación no es el de recaudo).
        foreach (var propio in new[] { "groupBy", "dateKind", "ranges", "points", "purpose", "channel", "status", "load", "kind", "loan", "by", "top", "warnAt", "year", "month" })
            _filtros.Otros.Remove(propio);
        await EvaluarExportacionAsync();
    }

    /// <summary>En una vista con datos del deudor, exportar exige además ExportPersonalData (el botón no se ofrece sin él).</summary>
    private async Task EvaluarExportacionAsync()
    {
        _exportaDatosPersonales = _vista is not null && _vista.PersonalData && await Permisos.TieneAsync("Lending.Reports.ExportPersonalData");
    }

    /// <summary>
    /// Se ofrece exportar si la consulta aplicada no trae datos del deudor o si la persona puede exportarlos. K5: la concentración por línea, sector
    /// o pagaduría no los trae (<c>personalDataExceptWhen</c>).
    /// </summary>
    private bool PuedeExportar => _vista is not null && (_exportaDatosPersonales || !_vista.TraeDatosDelDeudor(_aplicados.Otros));

    private bool Usa(string filtro) => _vista is not null && _vista.Filters.Contains(filtro, StringComparer.OrdinalIgnoreCase);

    private bool UsaPropio(string filtro) => _vista?.OwnFilters is { } propios && propios.Contains(filtro, StringComparer.OrdinalIgnoreCase);

    private string Otro(string nombre) => _filtros.Otros.TryGetValue(nombre, out var v) ? v : string.Empty;

    private void PonerOtro(string nombre, string? valor)
    {
        if (string.IsNullOrWhiteSpace(valor)) _filtros.Otros.Remove(nombre);
        else _filtros.Otros[nombre] = valor;
    }

    /// <summary>Las dimensiones de «groupBy» de la vista elegida (colocación y recaudo no abren por lo mismo).</summary>
    private IReadOnlyList<(string Valor, string Texto)> DimensionesDeLaVista => _vista?.Key switch
    {
        "receipts" => [("line", "Línea"), ("collector", "Recaudador"), ("modality", "Modalidad de pago"), ("meansClass", "Clase de medio")],
        // K5 (T0985): la calidad, en total o por oficina, línea o modalidad.
        "quality" => [("total", "Total"), ("office", "Oficina"), ("line", "Línea"), ("modality", "Modalidad")],
        _ => [("line", "Línea"), ("office", "Oficina"), ("advisor", "Asesor"), ("month", "Mes")],
    };

    /// <summary>Los estados del filtro «status» de la vista elegida: cada vista filtra por los suyos.</summary>
    private IReadOnlyList<(string Valor, string Texto)> EstadosDeLaVista => _vista?.Key switch
    {
        "issued-documents" => [("Valid", "Vigente"), ("SubjectToFinality", "Sujeto a firmeza"), ("Voided", "Anulado")],
        "promises" => [("Pending", "Pendiente"), ("Kept", "Cumplida"), ("Broken", "Incumplida")],
        "payment-agreements" => [("Proposed", "Propuesto"), ("Approved", "Aprobado"), ("Rejected", "Rechazado"), ("Cancelled", "Anulado")],
        "prior-notices" => [("Pending", "Pendiente"), ("InProgress", "En curso"), ("Valid", "Vigente"), ("Closed", "Cerrado")],
        // Feature 014, US17 (T222): los estados de una cuenta de captación o de aportes.
        "deposit-accounts-by-status" => [("Active", "Activa"), ("Inactive", "Inactiva"), ("Matured", "Vencida"), ("Closing", "En cancelación"),
            ("Closed", "Cancelada")],
        _ => [("Queued", "En cola"), ("Deferred", "Diferido"), ("Excluded", "Excluido"), ("Sent", "Enviado"), ("Delivered", "Entregado"),
            ("Failed", "Fallido"), ("Simulated", "Simulado"), ("Cancelled", "Cancelado")],
    };

    /// <summary>La tabla trae con qué profundizar: el crédito, la operación o el mensaje.</summary>
    private bool Profundiza => _tabla is not null && _tabla.Columnas.Any(c => c.Clave is "_credito" or "_mensaje" or "_documento" or "_cuenta");

    /// <summary>El año que propone el filtro: el del mes anterior, o el anterior en la exógena (anual).</summary>
    private string AnioPorDefecto => (_vista?.Key?.StartsWith("exogena-", StringComparison.Ordinal) == true
        ? DateTime.Today.Year - 1
        : DateTime.Today.AddMonths(-1).Year).ToString(System.Globalization.CultureInfo.InvariantCulture);

    /// <summary>A dónde lleva la fila: el crédito (también desde su operación) o, sin crédito, el mensaje en la bandeja.</summary>
    private string? Destino(FilaReporteDto fila)
    {
        if (_tabla is null) return null;
        if (TablaDeReporte.Oculto(_tabla, fila, "_credito") is { } credito && Guid.TryParse(credito, out var c)) return $"/cartera/creditos/{c}";
        // Feature 014, US17 (T222): una fila con cuenta de captación o de aportes abre su ficha.
        if (TablaDeReporte.Oculto(_tabla, fila, "_cuenta") is { } cuenta && Guid.TryParse(cuenta, out var a)) return $"/cartera/ahorros/{a}";
        if (_vista?.Key == "transactions" && TablaDeReporte.Oculto(_tabla, fila, "_mensaje") is { } m && Guid.TryParse(m, out var mensaje))
            return $"/cartera/bandeja-de-mensajes?mensaje={mensaje}";
        if (_vista?.Key == "debtor-messages" && TablaDeReporte.Oculto(_tabla, fila, "_mensaje") is not null) return "/cartera/mensajes";
        if (_vista?.Key == "issued-documents" && TablaDeReporte.Oculto(_tabla, fila, "_documento") is not null) return "/cartera/documentos";
        return null;
    }

    private Task Profundizar(FilaReporteDto fila)
    {
        if (Destino(fila) is { } ruta) Navigation.NavigateTo(ruta);
        return Task.CompletedTask;
    }

    private async Task AplicarAsync()
    {
        if (_vista is null) return;
        _aplicados = SoloLosDeLaVista(_filtros);
        using var carga = _carga.Iniciar();
        var r = await InformesDeCartera.InformeAsync(_vista.Key, _aplicados.ToQuery());
        if (!r.IsSuccess)
        {
            _tabla = null;
            await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo generar el informe.");
            return;
        }
        _tabla = r.Value;
    }

    private async Task DescargarAsync(string formato)
    {
        if (_vista is null) return;
        using var carga = _carga.Iniciar();
        var r = await InformesDeCartera.DescargarAsync(_vista.Key, _aplicados.ToQuery(), formato);
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo exportar."); return; }
        await Descargas.GuardarAsync(r.Value!.Nombre, r.Value.TipoContenido, r.Value.Contenido);
    }

    private void QuitarFiltrosDelEnlace()
    {
        foreach (var o in FiltrosDelEnlace) _filtros.Otros.Remove(o.Key);
        _tabla = null;
    }

    /// <summary>Las fechas que la vista no usa no viajan (una vista «al corte» no recibe rango, y al revés).</summary>
    private FiltrosDeInformeDeInventarioModelo SoloLosDeLaVista(FiltrosDeInformeDeInventarioModelo f)
    {
        var copia = f.Copia();
        if (!Usa("from")) copia.From = null;
        if (!Usa("to")) copia.To = null;
        if (!Usa("asOf")) copia.AsOf = null;
        return copia;
    }

    private static string Fecha(DateOnly? f) => f?.ToString("yyyy-MM-dd") ?? string.Empty;

    private static DateOnly? LeerFecha(object? valor) =>
        DateOnly.TryParse(valor?.ToString(), System.Globalization.CultureInfo.InvariantCulture, out var f) ? f : null;

    private sealed class ItemCrudo { public Guid PublicId { get; set; } public string Name { get; set; } = ""; }
}
