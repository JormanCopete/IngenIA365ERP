@page "/cartera/documentos-para-firma"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using IngenIA365ERP.Shared.Services.Cartera
@using IngenIA365ERP.Shared.Services.Http
@using IngenIA365ERP.Shared.Services.Nomina
@inject DocumentosParaFirmaClient Cliente
@inject DescargaDeArchivos Descargas
@inject INotificationService Notification

<PageTitle>Documentos para firma - IngenIA365ERP</PageTitle>

@* 2026-11-18 (pedido del dueño): las plantillas de los documentos que el sistema genera para firmar con cada crédito —el pagaré, la carta de
   instrucciones, la libranza y los que la cooperativa agregue— y sus campos propios. Cada cooperativa escribe su texto con los campos del sistema y los
   suyos, elige a qué canales de pago y líneas aplica cada documento y deja constancia de que su abogado lo validó (cambiar el texto quita esa
   constancia). Las plantillas base son un punto de partida sin validar. *@
<PermissionGate Required="Lending.SignatureTemplates.Manage" MostrarAviso="true">
<div class="pagina">
    <div class="page-header">
        <h3>Documentos para firma</h3>
        <div class="toolbar">
            @if (_config is { MissingBaseTemplates.Count: > 0 })
            {
                <SfButton CssClass="e-outline" Disabled="@_accion.Activa" OnClick="@CargarBaseAsync">Cargar plantillas base</SfButton>
            }
            <SfButton CssClass="e-outline" IconCss="e-icons e-plus" OnClick="@(() => AbrirCampo(null))">Nuevo campo</SfButton>
            <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@(() => AbrirPlantilla(null))">Nueva plantilla</SfButton>
        </div>
    </div>

    <p class="aviso aviso-info">
        Al aprobar una solicitud, «Generar documentos para firma» arma en un PDF las plantillas activas que le aplican: el pagaré y su carta de
        instrucciones siempre y la libranza cuando el crédito se paga por nómina. Las plantillas base siguen el Código de Comercio (arts. 621, 622 y 709 a
        711), la Ley 1527 de 2012 y el art. 142 de la Ley 79 de 1988, pero <strong>no están validadas por un abogado</strong>: el de la cooperativa debe
        revisarlas y marcarlas como validadas.
    </p>

    <IndicadorDeCarga Cargando="@_carga.Activa">
        @if (_config is { } c)
        {
            <div class="info-card">
                <h4>Plantillas</h4>
                @if (c.Templates.Count == 0)
                {
                    <p class="texto-tenue">No hay plantillas. Cargue las plantillas base o cree una nueva.</p>
                }
                else
                {
                    <div class="tabla-desplazable">
                        <table class="data-grid">
                            <thead><tr><th>Documento</th><th>Código</th><th>Nombre</th><th>Aplica a</th><th class="numero">Versión</th><th>Abogado</th><th>Estado</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var t in c.Templates)
                                {
                                    var plantilla = t;
                                    <tr>
                                        <td>@Clase(t.Kind)</td>
                                        <td>@t.Code</td>
                                        <td>@t.Name</td>
                                        <td>@AplicaA(t)</td>
                                        <td class="numero">@t.Version</td>
                                        <td>
                                            @if (t.IsVerified)
                                            {
                                                <span class="e-badge e-badge-success" title="@t.VerificationNote">Validada @(t.VerifiedAt?.ToLocalTime().ToString("dd/MM/yyyy"))</span>
                                            }
                                            else
                                            {
                                                <span class="e-badge e-badge-warning">Sin validar</span>
                                            }
                                        </td>
                                        <td>@(t.IsActive ? "Activa" : "Inactiva")</td>
                                        <td>
                                            <SfButton CssClass="e-flat e-small" OnClick="@(() => AbrirPlantilla(plantilla))">Editar</SfButton>
                                            <SfButton CssClass="e-flat e-small" Disabled="@_accion.Activa" OnClick="@(() => VistaPreviaAsync(plantilla.Name, plantilla.Kind, plantilla.Body, plantilla.IncludeFingerprint, plantilla.SignedByCoDebtors))">Vista previa</SfButton>
                                            @if (!t.IsVerified)
                                            {
                                                <SfButton CssClass="e-flat e-small" OnClick="@(() => AbrirValidacion(plantilla))">Marcar validada</SfButton>
                                            }
                                            <SfButton CssClass="e-flat e-small" Disabled="@_accion.Activa" OnClick="@(() => BorrarPlantillaAsync(plantilla))">Borrar</SfButton>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="info-card">
                <h4>Campos propios</h4>
                <p class="texto-tenue">
                    Además de los del sistema, cada cooperativa agrega los suyos: un valor fijo (la ciudad de pago, el registro como operador de libranza) o algo
                    que se digita al generar los documentos de cada solicitud. En la plantilla se escriben como {{CODIGO}}; uno en pesos da además
                    {{CODIGO_LETRAS}}.
                </p>
                @if (c.Fields.Count > 0)
                {
                    <div class="tabla-desplazable">
                        <table class="data-grid">
                            <thead><tr><th>Código</th><th>Nombre</th><th>Tipo</th><th>Valor</th><th>Estado</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var f in c.Fields)
                                {
                                    var campo = f;
                                    <tr>
                                        <td>{{@f.Code}}</td>
                                        <td>@f.Label</td>
                                        <td>@TipoDeCampo(f.Kind)</td>
                                        <td>
                                            @if (f.Source == "Constant")
                                            {
                                                @(string.IsNullOrWhiteSpace(f.ConstantValue) ? "(sin valor: sale con raya)" : f.ConstantValue)
                                            }
                                            else
                                            {
                                                <span>Se digita al generar@(f.IsRequired ? " (obligatorio)" : "")</span>
                                            }
                                        </td>
                                        <td>@(f.IsActive ? "Activo" : "Inactivo")</td>
                                        <td>
                                            <SfButton CssClass="e-flat e-small" OnClick="@(() => AbrirCampo(campo))">Editar</SfButton>
                                            <SfButton CssClass="e-flat e-small" Disabled="@_accion.Activa" OnClick="@(() => BorrarCampoAsync(campo))">Borrar</SfButton>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="info-card">
                <details>
                    <summary><strong>Cómo se escribe una plantilla y qué campos llena el sistema</strong></summary>
                    <ul>
                        <li><code>{{CAMPO}}</code> pone el valor; si está vacío sale una raya para llenarla a mano. <code>{{CAMPO:MAYUSCULAS}}</code> lo pone en mayúsculas.</li>
                        <li><code>{{BLANCO}}</code> o <code>{{BLANCO:40}}</code>: un espacio en blanco del largo dicho (el pagaré en blanco).</li>
                        <li><code>{{#SI CAMPO}} … {{#SINO}} … {{/SI}}</code> y <code>{{#NO CAMPO}} … {{/NO}}</code>: texto que sale o no según el campo.</li>
                        <li><code>{{#CADA CODEUDORES}} … {{/CADA}}</code>: repite el texto por cada codeudor, con <code>{{ORDEN}}</code>.</li>
                        <li>Al principio del renglón: <code># </code> título, <code>## </code> subtítulo, <code>- </code> viñeta, <code>= </code> centrado;
                            <code>---</code> solo en su renglón pasa a otra hoja; <code>{{FIRMAS}}</code> solo en su renglón pone las firmas; <code>**texto**</code> va en negrita.</li>
                    </ul>
                    <div class="tabla-desplazable">
                        <table class="data-grid tabla-compacta">
                            <thead><tr><th>Campo</th><th>Qué es</th><th>Ejemplo</th></tr></thead>
                            <tbody>
                                @foreach (var grupo in c.SystemFields.GroupBy(f => f.Group))
                                {
                                    <tr><td colspan="3"><strong>@grupo.Key</strong></td></tr>
                                    @foreach (var f in grupo)
                                    {
                                        <tr><td>{{@f.Code}}</td><td>@f.Description</td><td class="texto-tenue">@f.Example</td></tr>
                                    }
                                }
                                @foreach (var lista in c.SystemLists)
                                {
                                    <tr><td colspan="3"><strong>Lista {{#CADA @lista.Code}}</strong>: @lista.Description</td></tr>
                                    @foreach (var f in lista.Fields)
                                    {
                                        <tr><td>{{@f.Code}}</td><td>@f.Description</td><td class="texto-tenue">@f.Example</td></tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </details>
            </div>
        }
    </IndicadorDeCarga>
</div>

<SfDialog @bind-Visible="_mostrarPlantilla" Header="@(_plantillaId is null ? "Nueva plantilla" : "Editar plantilla")" Width="980px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@_guardado.Activa" Texto="Procesando…">
                <div class="form-grid">
                    <label class="campo">Documento *
                        <select class="e-input" @bind="_p.Kind">
                            @foreach (var (valor, texto) in Clases) { <option value="@valor">@texto</option> }
                        </select>
                    </label>
                    <label class="campo">Código * <input class="e-input" @bind="_p.Code" maxlength="20" /></label>
                    <label class="campo">Nombre * <input class="e-input" @bind="_p.Name" maxlength="120" /></label>
                    <label class="campo">Orden de impresión <input class="e-input" type="number" min="0" max="999" @bind="_p.PrintOrder" /></label>
                </div>
                <div class="toolbar">
                    <label class="campo-check"><input type="checkbox" @bind="_p.IsActive" /> Activa</label>
                    <label class="campo-check"><input type="checkbox" @bind="_p.IncludeFingerprint" /> Recuadro para la huella en las firmas</label>
                    <label class="campo-check"><input type="checkbox" @bind="_p.SignedByCoDebtors" /> Firman también los codeudores</label>
                </div>
                <p class="etiqueta-campo">Aplica cuando el crédito se paga por (ninguno marcado = siempre)</p>
                <div class="toolbar">
                    @foreach (var (valor, texto) in Canales)
                    {
                        var canal = valor;
                        <label class="campo-check"><input type="checkbox" checked="@_p.Canales.Contains(canal)" @onchange="@(e => Marcar(canal, e.Value is true))" /> @texto</label>
                    }
                </div>
                <div class="form-grid">
                    <label class="campo campo-ancho">Sólo en las líneas (códigos separados por coma; vacío = todas)
                        <input class="e-input" @bind="_p.Lineas" maxlength="2000" />
                    </label>
                    <label class="campo campo-ancho">Texto *
                        <textarea class="e-input editor-de-plantilla" rows="22" @bind="_p.Body" @bind:event="oninput"></textarea>
                    </label>
                </div>
                @if (_p.Verificada)
                {
                    <p class="texto-tenue">Esta plantilla está validada por el abogado: si cambia el texto, la versión sube y pierde la validación.</p>
                }
                @if (_error is not null) { <p class="aviso aviso-error" role="alert">@_error</p> }
                <div class="toolbar">
                    <SfButton CssClass="e-outline" Disabled="@(_guardado.Activa || string.IsNullOrWhiteSpace(_p.Body))" OnClick="@(() => VistaPreviaAsync(_p.Name, _p.Kind, _p.Body, _p.IncludeFingerprint, _p.SignedByCoDebtors))">Vista previa</SfButton>
                    <SfButton CssClass="e-primary" Disabled="@(_guardado.Activa || string.IsNullOrWhiteSpace(_p.Code) || string.IsNullOrWhiteSpace(_p.Name) || string.IsNullOrWhiteSpace(_p.Body))" OnClick="@GuardarPlantillaAsync">Guardar</SfButton>
                    <SfButton CssClass="e-outline" OnClick="@(() => _mostrarPlantilla = false)">Cancelar</SfButton>
                </div>
            </IndicadorDeCarga>
        </Content>
    </DialogTemplates>
</SfDialog>

<SfDialog @bind-Visible="_mostrarCampo" Header="@(_campoId is null ? "Nuevo campo propio" : "Editar campo propio")" Width="640px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@_guardado.Activa" Texto="Procesando…">
                <div class="form-grid">
                    <label class="campo">Código * <input class="e-input" @bind="_f.Code" maxlength="40" disabled="@(_campoId is not null)" placeholder="CIUDAD_PAGO" /></label>
                    <label class="campo">Nombre * <input class="e-input" @bind="_f.Label" maxlength="120" /></label>
                    <label class="campo">Tipo
                        <select class="e-input" @bind="_f.Kind">
                            @foreach (var (valor, texto) in TiposDeCampo) { <option value="@valor">@texto</option> }
                        </select>
                    </label>
                    <label class="campo">Valor
                        <select class="e-input" @bind="_f.Source">
                            <option value="Constant">Fijo de la cooperativa</option>
                            <option value="Typed">Se digita al generar</option>
                        </select>
                    </label>
                    @if (_f.Source == "Constant")
                    {
                        <label class="campo campo-ancho">Valor fijo <input class="e-input" @bind="_f.ConstantValue" maxlength="2000" /></label>
                    }
                    else
                    {
                        <label class="campo">Valor propuesto <input class="e-input" @bind="_f.DefaultValue" maxlength="2000" /></label>
                        <label class="campo-check"><input type="checkbox" @bind="_f.IsRequired" /> Obligatorio para generar</label>
                    }
                    <label class="campo campo-ancho">Ayuda <input class="e-input" @bind="_f.HelpText" maxlength="300" /></label>
                    <label class="campo">Orden <input class="e-input" type="number" min="0" max="999" @bind="_f.Order" /></label>
                    <label class="campo-check"><input type="checkbox" @bind="_f.IsActive" /> Activo</label>
                </div>
                @if (_error is not null) { <p class="aviso aviso-error" role="alert">@_error</p> }
                <div class="toolbar">
                    <SfButton CssClass="e-primary" Disabled="@(_guardado.Activa || string.IsNullOrWhiteSpace(_f.Code) || string.IsNullOrWhiteSpace(_f.Label))" OnClick="@GuardarCampoAsync">Guardar</SfButton>
                    <SfButton CssClass="e-outline" OnClick="@(() => _mostrarCampo = false)">Cancelar</SfButton>
                </div>
            </IndicadorDeCarga>
        </Content>
    </DialogTemplates>
</SfDialog>

<SfDialog @bind-Visible="_mostrarValidacion" Header="Marcar como validada por el abogado" Width="520px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@_guardado.Activa" Texto="Procesando…">
                <p>Deja constancia de que el abogado de la cooperativa revisó la versión @(_validar?.Version) de «@(_validar?.Name)».</p>
                <label class="campo">Nota (quién la revisó, concepto…) <input class="e-input" @bind="_nota" maxlength="300" /></label>
                <div class="toolbar">
                    <SfButton CssClass="e-primary" Disabled="@_guardado.Activa" OnClick="@ValidarAsync">Marcar validada</SfButton>
                    <SfButton CssClass="e-outline" OnClick="@(() => _mostrarValidacion = false)">Cancelar</SfButton>
                </div>
            </IndicadorDeCarga>
        </Content>
    </DialogTemplates>
</SfDialog>
</PermissionGate>

@code {
    private static readonly (string Valor, string Texto)[] Clases =
    [
        ("PromissoryNote", "Pagaré"), ("InstructionLetter", "Carta de instrucciones"), ("PayrollDeductionAuthorization", "Libranza"), ("Other", "Otro"),
    ];

    private static readonly (string Valor, string Texto)[] Canales =
    [
        ("Cashier", "Caja"), ("OwnPayroll", "Nómina de la cooperativa"), ("PaymasterDeduction", "Libranza con pagaduría"), ("DirectDebit", "Débito automático"),
    ];

    private static readonly (string Valor, string Texto)[] TiposDeCampo =
    [
        ("Text", "Texto"), ("LongText", "Texto largo"), ("Number", "Número"), ("Money", "Pesos"), ("Date", "Fecha"), ("YesNo", "Sí o no"),
    ];

    private sealed class PlantillaEditable
    {
        public string Kind { get; set; } = "Other";
        public string Code { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Body { get; set; } = string.Empty;
        public HashSet<string> Canales { get; set; } = [];
        public string? Lineas { get; set; }
        public bool IsActive { get; set; } = true;
        public int PrintOrder { get; set; } = 1;
        public bool IncludeFingerprint { get; set; } = true;
        public bool SignedByCoDebtors { get; set; } = true;
        public bool Verificada { get; set; }
    }

    private sealed class CampoEditable
    {
        public string Code { get; set; } = string.Empty;
        public string Label { get; set; } = string.Empty;
        public string Kind { get; set; } = "Text";
        public string Source { get; set; } = "Constant";
        public string? ConstantValue { get; set; }
        public string? DefaultValue { get; set; }
        public bool IsRequired { get; set; }
        public string? HelpText { get; set; }
        public int Order { get; set; }
        public bool IsActive { get; set; } = true;
    }

    private readonly EstadoDeCarga _carga = new(), _accion = new(), _guardado = new();
    private ConfiguracionDeFirmaDto? _config;
    private bool _mostrarPlantilla, _mostrarCampo, _mostrarValidacion;
    private Guid? _plantillaId, _campoId;
    private PlantillaEditable _p = new();
    private CampoEditable _f = new();
    private PlantillaDeFirmaDto? _validar;
    private string? _nota, _error;

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        using var carga = _carga.Iniciar();
        var r = await Cliente.ConfiguracionAsync();
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo leer la configuración."); return; }
        _config = r.Value;
    }

    private static string Clase(string kind) => Clases.FirstOrDefault(c => c.Valor == kind).Texto ?? kind;

    private static string TipoDeCampo(string kind) => TiposDeCampo.FirstOrDefault(c => c.Valor == kind).Texto ?? kind;

    private static string AplicaA(PlantillaDeFirmaDto t)
    {
        var canales = t.RepaymentChannels.Count == 0 ? "todo canal de pago" : string.Join(", ", t.RepaymentChannels.Select(c => Canales.FirstOrDefault(x => x.Valor == c).Texto ?? c));
        var lineas = t.CreditLineCodes.Count == 0 ? "todas las líneas" : "líneas " + string.Join(", ", t.CreditLineCodes);
        return $"{canales}; {lineas}";
    }

    private void Marcar(string canal, bool marcado)
    {
        if (marcado) _p.Canales.Add(canal);
        else _p.Canales.Remove(canal);
    }

    private async Task CargarBaseAsync()
    {
        using var accion = _accion.Iniciar();
        var r = await Cliente.CargarBaseAsync();
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudieron cargar las plantillas base."); return; }
        _config = r.Value;
        await Notification.SuccessAsync("Plantillas base cargadas. Complete los campos propios (ciudad de pago, días de mora…) y hágalas validar por el abogado.");
    }

    private void AbrirPlantilla(PlantillaDeFirmaDto? t)
    {
        _error = null;
        _plantillaId = t?.PublicId;
        _p = t is null
            ? new PlantillaEditable()
            : new PlantillaEditable
            {
                Kind = t.Kind, Code = t.Code, Name = t.Name, Body = t.Body, Canales = [.. t.RepaymentChannels],
                Lineas = t.CreditLineCodes.Count == 0 ? null : string.Join(", ", t.CreditLineCodes), IsActive = t.IsActive, PrintOrder = t.PrintOrder,
                IncludeFingerprint = t.IncludeFingerprint, SignedByCoDebtors = t.SignedByCoDebtors, Verificada = t.IsVerified,
            };
        _mostrarPlantilla = true;
    }

    private async Task GuardarPlantillaAsync()
    {
        using var guardado = _guardado.Iniciar();
        _error = null;
        var lineas = (_p.Lineas ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
        var r = await Cliente.GuardarPlantillaAsync(_plantillaId, new PlantillaDeFirmaRequest(_p.Kind, _p.Code.Trim().ToUpperInvariant(), _p.Name.Trim(), _p.Body,
            [.. _p.Canales], lineas, _p.IsActive, _p.PrintOrder, _p.IncludeFingerprint, _p.SignedByCoDebtors));
        if (!r.IsSuccess) { _error = r.ErrorMessage ?? "No se pudo guardar la plantilla."; return; }
        _mostrarPlantilla = false;
        await CargarAsync();
    }

    private async Task BorrarPlantillaAsync(PlantillaDeFirmaDto t)
    {
        using var accion = _accion.Iniciar();
        var r = await Cliente.BorrarPlantillaAsync(t.PublicId);
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo borrar la plantilla."); return; }
        await CargarAsync();
    }

    private void AbrirValidacion(PlantillaDeFirmaDto t)
    {
        _validar = t;
        _nota = null;
        _mostrarValidacion = true;
    }

    private async Task ValidarAsync()
    {
        if (_validar is null) return;
        using var guardado = _guardado.Iniciar();
        var r = await Cliente.ValidarPlantillaAsync(_validar.PublicId, _nota);
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo marcar la plantilla."); return; }
        _mostrarValidacion = false;
        await CargarAsync();
    }

    private async Task VistaPreviaAsync(string nombre, string clase, string texto, bool huella, bool codeudores)
    {
        using var accion = _accion.Iniciar();
        _error = null;
        var r = await Cliente.VistaPreviaAsync(new VistaPreviaDeFirmaRequest(string.IsNullOrWhiteSpace(nombre) ? "Documento" : nombre, clase, texto, huella,
            codeudores, null, null));
        if (!r.IsSuccess || r.Value is null)
        {
            var mensaje = r.ErrorMessage ?? "No se pudo armar la vista previa.";
            if (_mostrarPlantilla) _error = mensaje;
            else await Notification.ErrorAsync(mensaje);
            return;
        }

        try
        {
            await Descargas.GuardarAsync(r.Value.Nombre, r.Value.TipoContenido, r.Value.Contenido);
        }
        catch (JSException ex)
        {
            await Notification.ErrorAsync($"El navegador no pudo guardar el archivo: {ex.Message}");
        }
    }

    private void AbrirCampo(CampoDeFirmaDto? f)
    {
        _error = null;
        _campoId = f?.PublicId;
        _f = f is null
            ? new CampoEditable()
            : new CampoEditable
            {
                Code = f.Code, Label = f.Label, Kind = f.Kind, Source = f.Source, ConstantValue = f.ConstantValue, DefaultValue = f.DefaultValue,
                IsRequired = f.IsRequired, HelpText = f.HelpText, Order = f.Order, IsActive = f.IsActive,
            };
        _mostrarCampo = true;
    }

    private async Task GuardarCampoAsync()
    {
        using var guardado = _guardado.Iniciar();
        _error = null;
        var r = await Cliente.GuardarCampoAsync(_campoId, new CampoDeFirmaRequest(_f.Code.Trim().ToUpperInvariant(), _f.Label.Trim(), _f.Kind, _f.Source,
            _f.ConstantValue, _f.DefaultValue, _f.IsRequired, _f.HelpText, _f.Order, _f.IsActive));
        if (!r.IsSuccess) { _error = r.ErrorMessage ?? "No se pudo guardar el campo."; return; }
        _mostrarCampo = false;
        await CargarAsync();
    }

    private async Task BorrarCampoAsync(CampoDeFirmaDto f)
    {
        using var accion = _accion.Iniciar();
        var r = await Cliente.BorrarCampoAsync(f.PublicId);
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo borrar el campo."); return; }
        await CargarAsync();
    }
}
