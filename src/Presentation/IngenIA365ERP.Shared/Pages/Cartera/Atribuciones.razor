        public string Name { get; set; } = "";
        public int Order { get; set; }
        public int Kind { get; set; } = 1;
        public string? PermissionCode { get; set; }
        public Guid? GoverningBody { get; set; }
        public decimal? Ceiling { get; set; }
        public bool IsExceptionLevel { get; set; }
        public bool IsBoardLevel { get; set; }
    }

    /// <summary>Una regla en edición; <see cref="Original"/> conserva las condiciones que la pantalla no edita.</summary>
    private sealed class ReglaEditable
    {
        public int Order { get; set; }
        public string Subject { get; set; } = "CreditApplication";
        public string MinimumLevelCode { get; set; } = "";
        public decimal? MinAmount { get; set; }
        public decimal? MaxAmount { get; set; }
        public int? MinDaysPastDue { get; set; }
        public bool PolicyException { get; set; }
        public CondicionesDeReglaDto? Original { get; set; }
    }
