@page "/cartera/solicitudes/nueva"
@page "/cartera/solicitudes/{Id:guid}/corregir"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using IngenIA365ERP.Shared.Services.Cartera
@using IngenIA365ERP.Shared.Services.Http
@using IngenIA365ERP.Shared.Services.Inventario
@inject OriginacionClient Originacion
@inject InventarioClient Inventario
@inject PersonasClient Personas
@inject PermisosDelUsuario Permisos
@inject INotificationService Notification
@inject NavigationManager Navegacion

<PageTitle>@(EsCorreccion ? "Corregir solicitud de crédito" : "Nueva solicitud de crédito") - IngenIA365ERP</PageTitle>

@* Feature 013, US2 (T0411; FR-035; SC-009; quickstart §3.5 paso 2): radicar en tres pasos. 1) simular (el simulador queda visible, FR-013);
   2) el solicitante —se busca en el maestro y, si no está, se registra con PersonaDialog—, la oficina, los codeudores con su capacidad, la
   capacidad declarada y la preferencia de abono a capital; 3) se guarda el borrador y en su detalle se adjuntan los documentos y se radica.
   Las autorizaciones de datos de cada persona se registran con su evidencia en Autorizaciones del titular: si falta, radicar lo dice.
   2026-11-17 (pedido del dueño): los pasos se ven arriba; la persona elegida en el simulador pasa a ser el solicitante; con una sola oficina se
   elige sola; el resumen dice desembolso, primer pago y cuota; y lo que falta para guardar se dice en vez de sólo apagar el botón.
   2026-11-23 (pedido del dueño): la misma pantalla corrige un borrador o una solicitud devuelta (/cartera/solicitudes/{id}/corregir). Abre con
   lo guardado y sólo deja cambiar los grupos que el parámetro Originacion.GruposEditablesAlDevolver de la línea permite (en borrador, todo); el
   servidor los vuelve a revisar. El solicitante no cambia.
   2026-11-25 (pedido del dueño): también edita una solicitud radicada sin devolverla (permiso Lending.Applications.EditSubmitted, parámetro
   Originacion.EditarRadicadaSinDevolver), con el motivo del cambio; el servidor vuelve a correr las validaciones y el enrutamiento. *@
<PermissionGate Required="Lending.Applications.Create" AnyOf="@(new[] { "Lending.Applications.EditSubmitted" })" MostrarAviso="true">
<div class="pagina">
    <div class="page-header">
        <h3>@(!EsCorreccion ? "Nueva solicitud de crédito" : EsRadicada ? $"Editar la solicitud radicada {_original?.Number}" : $"Corregir la solicitud {_original?.Number ?? "en borrador"}")</h3>
        <div class="toolbar">
            <SfButton CssClass="e-outline" OnClick="@Volver">Volver</SfButton>
        </div>
    </div>

    <PasosDeSolicitud Actual="@_paso" />

    @if (EsCorreccion)
    {
        <IndicadorDeCarga Cargando="@_cargaOriginal.Activa" Texto="Leyendo la solicitud…">
            @if (_bloqueo is { } bloqueo)
            {
                <p class="aviso aviso-alerta" role="alert">@bloqueo</p>
            }
            else if (_original is { } o)
            {
                <p class="texto-apoyo">
                    @(o.Status == 4 ? "La solicitud fue devuelta para corregir." : o.Radicada ? "La solicitud está radicada y espera decisión: se edita sin devolverla." : "La solicitud está en borrador.")
                    Puede cambiar: @string.Join(", ", o.EditableGroups.Select(TextosDeOriginacion.GrupoEditable)).
                    Lo demás queda como está.
                    @if (o.Radicada)
                    {
                        <text>Al guardar se vuelven a correr las validaciones y el enrutamiento, y el cambio queda en su historial con el motivo: quien decide lo ve.</text>
                    }
                </p>
            }
        </IndicadorDeCarga>
    }
    else
    {
        <p class="texto-apoyo">@(_paso == 1
            ? "Elija la línea, simule y, si el plan le sirve, pulse «Usar en la solicitud»."
            : "Complete los datos del solicitante y guarde el borrador. Después adjunta los documentos y radica la solicitud.")</p>
    }

    @if (MuestraSimulador)
    {
        @if (EsCorreccion) { <p class="texto-tenue">Para cambiar monto, cuotas o fechas, simule y pulse «Usar en la solicitud»; si no simula, quedan las condiciones guardadas.</p> }
        <SimuladorDeCredito SimulacionHecha="@TomarSimulacion" PersonaElegida="@TomarPersona" Inicial="@_inicial" LineaFija="@(EsCorreccion && !Edita("Linea"))"
                            CompraInicial="@_compraInicial" CompraElegida="@(c => _compra = c)" />
    }

    @if (HayDatos)
    {
        <div class="info-card">
            <h4>Datos de la solicitud</h4>
            <IndicadorDeCarga Cargando="@_carga.Activa" Texto="Leyendo las oficinas…">
                <div class="kpi-grid">
                    <div class="kpi-card"><span class="kpi-label">Línea</span><span class="kpi-value">@LineaVisible</span></div>
                    <div class="kpi-card"><span class="kpi-label">Monto</span><span class="kpi-value">@TextosDeOriginacion.Pesos(MontoVisible)</span></div>
                    <div class="kpi-card"><span class="kpi-label">Cuotas</span><span class="kpi-value">@CuotasVisibles</span></div>
                    @if (_simulacion is { } sim)
                    {
                        <div class="kpi-card"><span class="kpi-label">Primera cuota</span><span class="kpi-value">@(sim.Resultado.Installments.FirstOrDefault() is { } c1 ? $"{TextosDeOriginacion.Pesos(c1.Total)} el {c1.DueDate:dd/MM/yyyy}" : "—")</span></div>
                        <div class="kpi-card"><span class="kpi-label">Desembolso previsto</span><span class="kpi-value">@sim.Resultado.DisbursementDate.ToString("dd/MM/yyyy")</span></div>
                    }
                    else if (_original is { } o)
                    {
                        <div class="kpi-card"><span class="kpi-label">Desembolso previsto</span><span class="kpi-value">@(o.ExpectedDisbursementDate?.ToString("dd/MM/yyyy") ?? "el día que se desembolse")</span></div>
                    }
                </div>
                @if (!EsCorreccion)
                {
                    <p class="texto-tenue">Para cambiar monto, plazo o fechas, simule de nuevo arriba y pulse otra vez «Usar en la solicitud».</p>
                }
                <div class="form-grid">
                    <div class="campo campo-ancho">Solicitante *
                        @if (EsCorreccion)
                        {
                            <p>@(_original?.Applicant.FullName) <span class="texto-tenue">(no cambia: para otra persona, otra solicitud)</span></p>
                        }
                        else
                        {
                            <PersonSearchPicker @bind-Selected="_solicitante" ShowHelpText="false" Compacto="true" PermitirCrear="@_puedeCrearPersona"
                                                OnCrearPersona="@CrearPersona" TextoSinResultados="Regístrela con «Crear persona» y vuelva a buscarla." />
                        }
                    </div>
                    @if (_compra is { } compra)
                    {
                        @* 2026-11-23 (descuento condicionado): el proveedor del bien recibe el giro completo. *@
                        <div class="campo campo-ancho">Proveedor del bien * (bien de @TextosDeOriginacion.Pesos(compra.Valor), opción @compra.Opcion)
                            @if (Edita("Condiciones"))
                            {
                                <PersonSearchPicker @bind-Selected="_proveedor" ShowHelpText="false" Compacto="true" />
                            }
                            else
                            {
                                <p>@(_proveedor?.FullName)</p>
                            }
                        </div>
                    }
                    <label class="campo">Oficina *
                        <select class="e-input" @bind="_oficina" disabled="@(!Edita("Oficina"))">
                            <option value="">Elija la oficina…</option>
                            @foreach (var o in _oficinas) { <option value="@o.PublicId">@o.Name</option> }
                        </select>
                    </label>
                    <label class="campo">Destino <input class="e-input" @bind="_destino" maxlength="200" disabled="@(!Edita("Destino"))" /></label>
                    <label class="campo">Forma de pago
                        <select class="e-input" @bind="_formaDePago" disabled="@(!Edita("FormaDePago"))">
                            @foreach (var f in TextosDeOriginacion.FormasDePago) { <option value="@f.Valor">@f.Texto</option> }
                        </select>
                    </label>
                    <label class="campo">Abonos extraordinarios a capital *
                        <select class="e-input" @bind="_preferencia" disabled="@(!Edita("PreferenciaDeAbono"))">
                            @foreach (var p in TextosDeOriginacion.PreferenciasDeAbono) { <option value="@p.Valor">@p.Texto</option> }
                        </select>
                    </label>
                    <label class="campo">Ingreso mensual del solicitante <input class="e-input" type="number" min="0" step="1000" @bind="_ingreso" disabled="@(!Edita("Capacidad"))" /></label>
                    <label class="campo">Gasto mensual <input class="e-input" type="number" min="0" step="1000" @bind="_gasto" disabled="@(!Edita("Capacidad"))" /></label>
                    <label class="campo">Cuotas que paga a otras entidades <input class="e-input" type="number" min="0" step="1000" @bind="_externas" disabled="@(!Edita("Capacidad"))" /></label>
                    @if (EsVivienda)
                    {
                        @* K6b (T1060; FR-024): en vivienda, VIS elige el porcentaje financiable de interés social (Ley 546 de 1999). *@
                        <label class="campo-check"><input type="checkbox" @bind="_esVis" disabled="@(!Edita("Condiciones"))" /> El inmueble es vivienda de interés social (VIS)</label>
                    }
                </div>

                <h5>Codeudores</h5>
                @if (Edita("Codeudores"))
                {
                    <div class="toolbar">
                        <div class="campo"><PersonSearchPicker @bind-Selected="_codeudor" ShowHelpText="false" Compacto="true" /></div>
                        <SfButton CssClass="e-outline" Disabled="@(_codeudor is null)" OnClick="@AgregarCodeudor">Agregar codeudor</SfButton>
                    </div>
                }
                @if (_codeudores.Count > 0)
                {
                    <table class="data-grid">
                        <thead><tr><th>Codeudor</th><th class="numero">Ingreso</th><th class="numero">Gasto</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var c in _codeudores)
                            {
                                var codeudor = c;
                                <tr>
                                    <td>@codeudor.Nombre@(codeudor.Rol == 3 ? " (avalista)" : "")</td>
                                    <td class="numero"><input class="e-input" type="number" min="0" @bind="codeudor.Ingreso" disabled="@(!Edita("Codeudores"))" /></td>
                                    <td class="numero"><input class="e-input" type="number" min="0" @bind="codeudor.Gasto" disabled="@(!Edita("Codeudores"))" /></td>
                                    <td>
                                        @if (Edita("Codeudores"))
                                        {
                                            <SfButton CssClass="e-flat e-small" OnClick="@(() => _codeudores.Remove(codeudor))">Quitar</SfButton>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else if (EsCorreccion)
                {
                    <p class="texto-tenue">Sin codeudores.</p>
                }
                <p class="aviso aviso-info">
                    Cada persona necesita su autorización de tratamiento de datos para el estudio del crédito (y para consultar centrales si la
                    línea lo exige), registrada con su evidencia en <a href="/cartera/autorizaciones">Autorizaciones del titular</a>.
                </p>
            </IndicadorDeCarga>

            <IndicadorDeCarga Cargando="@_guardado.Activa" Texto="Guardando…">
                @if (EsRadicada)
                {
                    @* 2026-11-25: editar la radicada pide el motivo; queda en su historial y en la auditoría. *@
                    <label class="campo campo-ancho">Motivo del cambio *
                        <textarea class="e-input" rows="2" maxlength="500" @bind="_motivoDeEdicion" @bind:event="oninput"
                                  placeholder="Por qué se cambia la solicitud ya radicada"></textarea>
                    </label>
                }
                @if (_error is not null) { <p class="aviso aviso-error" role="alert">@_error</p> }
                @if (Faltan.Count > 0) { <p class="texto-tenue">Para guardar falta: @string.Join(", ", Faltan).</p> }
                <div class="toolbar">
                    <SfButton CssClass="e-primary" IconCss="e-icons e-save" Disabled="@(_guardado.Activa || Faltan.Count > 0)" OnClick="@GuardarAsync">
                        @(!EsCorreccion ? "Guardar borrador y adjuntar documentos" : EsRadicada ? "Guardar los cambios" : "Guardar la corrección")
                    </SfButton>
                </div>
            </IndicadorDeCarga>
        </div>
    }
</div>

<PersonaDialog @bind-Visible="_mostrarPersona" DocumentoInicial="@_documentoInicial" CapturarAutorizacion="true" OnGuardado="@PersonaGuardadaAsync" />
</PermissionGate>

@code {
    private sealed class Codeudor
    {
        public Guid Persona { get; init; }
        public string Nombre { get; init; } = "";
        public int Rol { get; init; } = 2;
        public decimal? Ingreso { get; set; }
        public decimal? Gasto { get; set; }
        public decimal? Externas { get; init; }
    }

    /// <summary>La solicitud que se corrige (borrador o devuelta); nula en una nueva.</summary>
    [Parameter] public Guid? Id { get; set; }

    private readonly EstadoDeCarga _carga = new(), _guardado = new(), _cargaOriginal = new();
    private (SimulacionRequest Entrada, SimulacionDto Resultado)? _simulacion;
    private SolicitudDto? _original;
    private SimulacionRequest? _inicial;
    private (decimal Valor, string Opcion)? _compra, _compraInicial;
    private PersonSearchPicker.PersonSearchItem? _proveedor;
    private IReadOnlyList<SucursalContableDto> _oficinas = [];
    private PersonSearchPicker.PersonSearchItem? _solicitante, _codeudor;
    private readonly List<Codeudor> _codeudores = [];
    private Guid? _oficina;
    private string? _destino, _error, _documentoInicial, _bloqueo, _motivoDeEdicion;
    private int _formaDePago = 1, _preferencia = 1, _paso = 1;
    private decimal? _ingreso, _gasto, _externas;
    private bool _puedeCrearPersona, _mostrarPersona, _esVis;
    private ClaveDeOperacion _clave = new();

    private bool EsCorreccion => Id is not null;

    /// <summary>2026-11-25: se edita una solicitud ya radicada, sin devolverla.</summary>
    private bool EsRadicada => EsCorreccion && _original is { Radicada: true };

    /// <summary>En una nueva todo se edita; al corregir, lo que diga la solicitud.</summary>
    private bool Edita(string grupo) => !EsCorreccion || (_original?.Edita(grupo) ?? false);

    private bool MuestraSimulador => !EsCorreccion || (_original is not null && _bloqueo is null && (Edita("Condiciones") || Edita("Linea")));

    private bool HayDatos => EsCorreccion ? _original is not null && _bloqueo is null : _simulacion is not null;

    private bool EsVivienda => _simulacion?.Resultado.IsHousing ?? _original?.IsSocialHousing is not null;

    private string LineaVisible => _simulacion?.Resultado.CreditLineCode ?? _original?.Line.Code ?? "—";

    private decimal MontoVisible => _simulacion?.Resultado.Amount ?? _original?.Amount ?? 0m;

    private string CuotasVisibles => _simulacion is { } s
        ? $"{s.Resultado.InstallmentCount} {TextosDeOriginacion.Periodicidad(s.Resultado.Periodicity).ToLowerInvariant()}"
        : _original is { } o ? $"{o.Installments} {TextosDeOriginacion.Periodicidad(o.Periodicity).ToLowerInvariant()}" : "—";

    private List<string> Faltan =>
    [
        .. !EsCorreccion && _solicitante is null ? ["el solicitante"] : Array.Empty<string>(),
        .. _oficina is null ? ["la oficina"] : Array.Empty<string>(),
        .. _compra is not null && _proveedor is null ? ["el proveedor del bien"] : Array.Empty<string>(),
        .. EsRadicada && string.IsNullOrWhiteSpace(_motivoDeEdicion) ? ["el motivo del cambio"] : Array.Empty<string>(),
    ];

    protected override async Task OnInitializedAsync()
    {
        using var carga = _carga.Iniciar();
        _puedeCrearPersona = await Permisos.TieneAsync("Core.People.Create");
        var r = await Inventario.ListarSucursalesAsync();
        _oficinas = r.Value ?? [];
        if (EsCorreccion) await CargarOriginalAsync();
        else if (_oficinas.Count == 1) _oficina = _oficinas[0].PublicId;
    }

    /// <summary>Abre con lo guardado: oficina, destino, forma de pago, capacidad, codeudores y las condiciones para el simulador.</summary>
    private async Task CargarOriginalAsync()
    {
        using var carga = _cargaOriginal.Iniciar();
        var r = await Originacion.SolicitudAsync(Id!.Value);
        if (!r.IsSuccess || r.Value is not { } o) { _bloqueo = r.ErrorMessage ?? "No se pudo leer la solicitud."; return; }
        _original = o;
        _paso = 2;
        if (o.Status is not (1 or 2 or 3 or 4) || o.EditableGroups.Count == 0)
        {
            _bloqueo = o.Radicada
                ? "Esta solicitud ya está radicada y la cooperativa (o su línea) no deja editarla sin devolverla: quien decide la devuelve para corregir."
                : "Esta solicitud ya no se puede corregir: sólo se corrige en borrador, cuando se devuelve para corregir o, si la cooperativa lo deja, radicada.";
            return;
        }
        if (o.UsesAdvancedTerms)
        {
            _bloqueo = "Esta solicitud tiene condiciones que esta pantalla no maneja (cuotas extraordinarias, gracia, créditos que recoge o convenio de "
                + "libranza). Para no perderlas, anúlela y radique otra.";
            return;
        }
        _oficina = o.Office?.PublicId;
        _destino = o.Purpose;
        _formaDePago = o.PaymentForm;
        _preferencia = o.PrepaymentPreference ?? 1;
        _esVis = o.IsSocialHousing ?? false;
        var solicitante = o.Parties.FirstOrDefault(p => p.Role == 1);
        _ingreso = solicitante?.MonthlyIncome;
        _gasto = solicitante?.MonthlyExpenses;
        _externas = solicitante?.ExternalInstallments;
        _codeudores.Clear();
        _codeudores.AddRange(o.Parties.Where(p => p.Role != 1).OrderBy(p => p.Order).Select(p => new Codeudor
        {
            Persona = p.Person.PersonPublicId, Nombre = p.Person.FullName, Rol = p.Role, Ingreso = p.MonthlyIncome, Gasto = p.MonthlyExpenses,
            Externas = p.ExternalInstallments,
        }));
        _inicial = new SimulacionRequest(o.Line.PublicId, o.Amount, o.Installments ?? 1, o.Periodicity, o.ExpectedDisbursementDate, o.FirstDueDate,
            AmortizationSystem: o.AmortizationSystem, PersonPublicId: o.Applicant.PersonPublicId);
        if (o.SubsidizedPurchase is { } compra)
        {
            _compraInicial = _compra = (compra.AssetValue, compra.OptionCode);
            _proveedor = compra.Supplier is { } p ? new PersonSearchPicker.PersonSearchItem { PublicId = p.PersonPublicId, FullName = p.FullName } : null;
        }
    }

    private void Volver() => Navegacion.NavigateTo(EsCorreccion ? $"/cartera/solicitudes/{Id}" : "/cartera/solicitudes");

    private void TomarSimulacion((SimulacionRequest Entrada, SimulacionDto Resultado) simulacion)
    {
        _simulacion = simulacion;
        _paso = 2;
        _error = null;
        _clave = new ClaveDeOperacion();
    }

    /// <summary>La persona simulada se propone como solicitante si todavía no hay uno (al corregir, el solicitante no cambia).</summary>
    private void TomarPersona(PersonSearchPicker.PersonSearchItem? persona)
    {
        if (!EsCorreccion && persona is not null && _solicitante is null) _solicitante = persona;
    }

    private void CrearPersona(string termino)
    {
        _documentoInicial = termino.All(char.IsDigit) ? termino : null;
        _mostrarPersona = true;
    }

    private async Task PersonaGuardadaAsync(Guid publicId)
    {
        _mostrarPersona = false;
        var r = await Personas.ObtenerAsync(publicId);
        if (r.IsSuccess && r.Value is { } p)
            _solicitante = new PersonSearchPicker.PersonSearchItem { PublicId = p.PublicId, IdentificationNumber = p.TaxId, FullName = p.NombreVisible };
    }

    private void AgregarCodeudor()
    {
        var titular = EsCorreccion ? _original?.Applicant.PersonPublicId : _solicitante?.PublicId;
        if (_codeudor is not { } c || _codeudores.Any(x => x.Persona == c.PublicId) || c.PublicId == titular) return;
        _codeudores.Add(new Codeudor { Persona = c.PublicId, Nombre = c.FullName });
        _codeudor = null;
    }

    private async Task GuardarAsync()
    {
        if (_oficina is null) return;
        Guid solicitante;
        if (EsCorreccion)
        {
            if (_original is null) return;
            solicitante = _original.Applicant.PersonPublicId;
        }
        else
        {
            if (_solicitante is null || _simulacion is null) return;
            solicitante = _solicitante.PublicId;
        }
        using var carga = _guardado.Iniciar();
        _error = null;
        var solicitud = new SolicitudRequest
        {
            ApplicantPersonPublicId = solicitante, OfficePublicId = _oficina.Value,
            Purpose = string.IsNullOrWhiteSpace(_destino) ? null : _destino.Trim(), PaymentForm = _formaDePago, PrepaymentPreference = _preferencia,
            ApplicantCapacity = new CapacidadRequest(_ingreso, _gasto, _externas),
            CoDebtors = _codeudores.Select(c => new ParteDeSolicitudRequest(c.Persona, c.Ingreso, c.Gasto, c.Externas, c.Rol)).ToList(),
        };
        if (_simulacion is { } sim)
        {
            var e = sim.Entrada;
            solicitud.CreditLinePublicId = e.CreditLinePublicId;
            solicitud.Amount = e.Amount;
            solicitud.Installments = e.Installments;
            solicitud.Periodicity = e.Periodicity;
            solicitud.ExpectedDisbursementDate = e.DisbursementDate;
            solicitud.FirstDueDate = e.FirstDueDate;
            solicitud.AmortizationSystem = e.AmortizationSystem;
            solicitud.SimulationSha256 = sim.Resultado.SimulationSha256;
            solicitud.IsSocialHousing = sim.Resultado.IsHousing ? _esVis : null;
        }
        else if (_original is { } o)
        {
            // Sin simular de nuevo, quedan las condiciones guardadas.
            solicitud.CreditLinePublicId = o.Line.PublicId;
            solicitud.Amount = o.Amount;
            solicitud.Installments = o.Installments ?? 1;
            solicitud.Periodicity = o.Periodicity;
            solicitud.ExpectedDisbursementDate = o.ExpectedDisbursementDate;
            solicitud.FirstDueDate = o.FirstDueDate;
            solicitud.AmortizationSystem = o.AmortizationSystem;
            solicitud.IsSocialHousing = o.IsSocialHousing is null ? null : _esVis;
        }
        if (_compra is { } elegida)
        {
            solicitud.AssetValue = elegida.Valor;
            solicitud.DiscountOptionCode = elegida.Opcion;
            solicitud.SupplierPersonPublicId = _proveedor?.PublicId;
        }
        if (_original is { } original)
        {
            // La pantalla no elige seguros ni excepción: se mandan los que tiene.
            solicitud.Insurances = original.Insurances.Count > 0 ? original.Insurances : null;
            solicitud.PolicyExceptionRequested = original.PolicyExceptionRequested;
            solicitud.PolicyExceptionReason = original.PolicyExceptionReason;
        }
        else
        {
            solicitud.Insurances = _simulacion?.Entrada.Insurances;
        }

        var r = !EsCorreccion
            ? await Originacion.CrearAsync(solicitud, _clave)
            : EsRadicada
                ? await Originacion.EditarRadicadaAsync(Id!.Value, solicitud, _original!.RowVersion, _motivoDeEdicion!.Trim(), _clave)
                : await Originacion.ActualizarAsync(Id!.Value, solicitud, _original!.RowVersion, _clave);
        if (!r.IsSuccess || r.Value is null) { _error = string.Join(" ", LineasDeCreditoClient.Explicar(r)); return; }
        await Notification.SuccessAsync(!EsCorreccion ? "Borrador guardado: adjunte los documentos y radique."
            : EsRadicada ? "Cambios guardados: se volvieron a correr las validaciones y el enrutamiento."
            : "Corrección guardada: revise los documentos y vuelva a radicar.");
        Navegacion.NavigateTo($"/cartera/solicitudes/{r.Value.PublicId}");
    }
}
