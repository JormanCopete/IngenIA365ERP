@page "/cartera/archivos-de-descuento"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using IngenIA365ERP.Shared.Services.Adjuntos
@using IngenIA365ERP.Shared.Services.Cartera
@using IngenIA365ERP.Shared.Services.Http
@inject LibranzaClient Libranza
@inject AdjuntosClient Adjuntos
@inject INotificationService Notification
@inject NavigationManager Navegacion

<PageTitle>Archivos de descuento - IngenIA365ERP</PageTitle>

@* Feature 013, K2, US10 (T0852; contracts/api.md §13.2; FR-113, T78, I9): los archivos de descuentos por pagaduría y período. La vista previa (no
   escribe) muestra las líneas que saldrían con su novedad frente al último archivo enviado; generar lo guarda inmutable con su huella y lo entrega a
   Recaudo; regenerar antes del envío deja la versión anterior reemplazada; después del envío la corrección va como novedad del período siguiente.
   Descargar es un enlace firmado de 60 s (auditado); anular sólo antes del envío. «Enviado» lo marca la confirmación de Recaudo, no esta pantalla. *@
<PermissionGate Required="Lending.PayrollDeductionFiles.Read" MostrarAviso="true">
<div class="pagina">
    <div class="page-header">
        <h3>Archivos de descuento</h3>
    </div>

    <PermissionGate Required="Lending.PayrollDeductionFiles.Generate">
        <div class="info-card">
            <h4>Generar el archivo de un período</h4>
            <div class="toolbar">
                <label class="campo">Pagaduría
                    <select class="e-input" @bind="_convenio">
                        <option value="">Elija…</option>
                        @foreach (var c in _convenios.Where(c => !c.IsOwnPayroll)) { <option value="@c.PublicId">@c.Code · @c.Payer.LegalName</option> }
                    </select>
                </label>
                <label class="campo">Año <input class="e-input" type="number" min="2000" max="2999" @bind="_anio" /></label>
                <label class="campo">Mes <input class="e-input" type="number" min="1" max="12" @bind="_mes" /></label>
                <label class="campo">Quincena <input class="e-input" type="number" min="1" max="2" @bind="_quincena" placeholder="—" /></label>
                <label class="campo">Grupo de archivo <input class="e-input" @bind="_grupo" maxlength="20" placeholder="sólo si el convenio separa archivos" /></label>
                <label class="campo campo-ancho">Motivo (al regenerar) <input class="e-input" @bind="_motivo" maxlength="500" /></label>
                <SfButton CssClass="e-outline" Disabled="@(_accion.Activa || _convenio is null)" OnClick="@VistaPreviaAsync">Vista previa</SfButton>
                <SfButton CssClass="e-primary" Disabled="@(_accion.Activa || _previa is null || (_previa.Lines.Count == 0 && (_previa.AccountLines?.Count ?? 0) == 0))" OnClick="@GenerarAsync">Generar</SfButton>
            </div>
            <IndicadorDeCarga Cargando="@_accion.Activa" Texto="Preparando el archivo…">
                @if (_previa is { } p)
                {
                    <p><strong>@p.FileName</strong> · versión @p.Version · enviar a más tardar el @p.SendBy.ToString("dd/MM/yyyy") · @p.Lines.Count líneas ·
                        @TextosDeCreditos.Pesos(p.Total)</p>
                    <p class="texto-apoyo">Altas @p.NewCount · cambios @p.ChangeCount · retiros @p.CancellationCount · sin cambio @p.UnchangedCount</p>
                    <TablaDeLineasDeDescuento Lineas="@p.Lines" />
                    @if (p.AccountLines is { Count: > 0 } cuotas)
                    {
                        <h5>Cuotas de cuentas</h5>
                        <div class="tabla-desplazable">
                            <table class="data-grid">
                                <thead><tr><th>Línea</th><th>Empleado</th><th>Cuenta</th><th>Titular</th><th>Código</th><th>Vence</th><th class="numero">Valor</th><th>Novedad</th></tr></thead>
                                <tbody>
                                    @foreach (var c in cuotas)
                                    {
                                        <tr><td>@c.LineNumber</td><td>@c.EmployeeId</td><td>@c.AccountNumber</td><td>@c.Holder</td><td>@c.PaymasterConceptCode</td>
                                            <td>@c.DueDate.ToString("dd/MM/yyyy")</td><td class="numero">@TextosDeCreditos.Pesos(c.Total)</td><td>@c.Novelty</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    @if (p.WithoutEquivalence > 0)
                    {
                        <p class="aviso">@p.WithoutEquivalence obligación(es) o cuenta(s) del asociado no tienen código de la pagaduría en el convenio: no van en ningún archivo.</p>
                    }
                }
            </IndicadorDeCarga>
        </div>
    </PermissionGate>

    <div class="toolbar">
        <label class="campo">Pagaduría
            <select class="e-input" value="@_filtroConvenio" @onchange="@(e => FiltrarAsync(e.Value?.ToString(), _filtroEstado))">
                <option value="">Todas</option>
                @foreach (var c in _convenios) { <option value="@c.PublicId">@c.Code</option> }
            </select>
        </label>
        <label class="campo">Estado
            <select class="e-input" value="@_filtroEstado" @onchange="@(e => FiltrarAsync(_filtroConvenio, e.Value?.ToString()))">
                <option value="">Todos</option>
                @foreach (var e in TextosDeLibranza.EstadosDeArchivo) { <option value="@e.Valor">@e.Texto</option> }
            </select>
        </label>
        <SfButton CssClass="e-outline" IconCss="e-icons e-refresh" Disabled="@_carga.Activa" OnClick="@CargarArchivosAsync">Actualizar</SfButton>
    </div>
    <IndicadorDeCarga Cargando="@_carga.Activa">
        <div class="tabla-desplazable">
            <table class="data-grid">
                <thead><tr><th>Archivo</th><th>Pagaduría</th><th>Período</th><th>Versión</th><th class="numero">Líneas</th><th class="numero">Total</th><th>Estado</th><th>Enviado</th><th></th></tr></thead>
                <tbody>
                    @foreach (var a in _archivos)
                    {
                        var archivo = a;
                        <tr>
                            <td><a href="/cartera/archivos-de-descuento/@archivo.PublicId">@archivo.Number</a></td>
                            <td>@archivo.AgreementCode</td>
                            <td>@TextosDeLibranza.Periodo(archivo.Year, archivo.Month, archivo.SubPeriod)</td>
                            <td>@archivo.Version</td>
                            <td class="numero">@archivo.Lines</td>
                            <td class="numero">@TextosDeCreditos.Pesos(archivo.Total)</td>
                            <td>@TextosDeLibranza.EstadoDeArchivo(archivo.Status)</td>
                            <td>@(archivo.SentAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")@(archivo.PaymasterReference is { } r ? $" · {r}" : "")</td>
                            <td><SfButton CssClass="e-flat e-small" IconCss="e-icons e-download" Disabled="@_accion.Activa" OnClick="@(() => DescargarAsync(archivo))">Descargar</SfButton></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (_archivos.Count == 0) { <p class="texto-tenue">Todavía no hay archivos de descuento.</p> }
    </IndicadorDeCarga>
</div>
</PermissionGate>

@code {
    private readonly EstadoDeCarga _carga = new(), _accion = new();
    private List<ConvenioResumenDto> _convenios = [];
    private List<ArchivoDeDescuentosDto> _archivos = [];
    private string? _convenio, _motivo, _filtroConvenio, _filtroEstado, _grupo;
    private int _anio = DateTime.Today.Year, _mes = DateTime.Today.Month;
    private int? _quincena;
    private VistaPreviaDeDescuentosDto? _previa;
    private ClaveDeOperacion _clave = new();

    protected override async Task OnInitializedAsync()
    {
        var r = await Libranza.ConveniosAsync();
        _convenios = r.IsSuccess ? [.. r.Value ?? []] : [];
        await CargarArchivosAsync();
    }

    private async Task FiltrarAsync(string? convenio, string? estado)
    {
        _filtroConvenio = string.IsNullOrEmpty(convenio) ? null : convenio;
        _filtroEstado = string.IsNullOrEmpty(estado) ? null : estado;
        await CargarArchivosAsync();
    }

    private async Task CargarArchivosAsync()
    {
        using var carga = _carga.Iniciar();
        var r = await Libranza.ArchivosAsync(Guid.TryParse(_filtroConvenio, out var c) ? c : null, estado: _filtroEstado);
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudieron leer los archivos."); return; }
        _archivos = [.. r.Value?.Items ?? []];
    }

    private ArchivoDeDescuentosRequest Pedido() =>
        new(Guid.Parse(_convenio!), _anio, _mes, _quincena, string.IsNullOrWhiteSpace(_motivo) ? null : _motivo.Trim(),
            string.IsNullOrWhiteSpace(_grupo) ? null : _grupo.Trim().ToUpperInvariant());

    private async Task VistaPreviaAsync()
    {
        if (_convenio is null) return;
        using var carga = _accion.Iniciar();
        var r = await Libranza.VistaPreviaAsync(Pedido());
        _previa = r.IsSuccess ? r.Value : null;
        if (!r.IsSuccess) await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo preparar el archivo.");
        _clave = new ClaveDeOperacion();
    }

    private async Task GenerarAsync()
    {
        if (_convenio is null) return;
        using var carga = _accion.Iniciar();
        var r = await Libranza.GenerarAsync(Pedido(), _clave);
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo generar el archivo."); return; }
        _previa = null;
        await Notification.SuccessAsync($"Archivo {r.Value!.Number} generado con {r.Value.Lines} líneas.");
        Navegacion.NavigateTo($"/cartera/archivos-de-descuento/{r.Value.PublicId}");
    }

    private async Task DescargarAsync(ArchivoDeDescuentosDto archivo)
    {
        using var carga = _accion.Iniciar();
        var r = await Libranza.EnlaceAsync(archivo.PublicId);
        if (!r.IsSuccess || r.Value?.Url is not { } url) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo descargar el archivo."); return; }
        await Adjuntos.DescargarAsync(url, archivo.FileName);
    }
}
