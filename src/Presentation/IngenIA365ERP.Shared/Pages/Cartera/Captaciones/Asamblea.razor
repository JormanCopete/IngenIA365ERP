@page "/cartera/asamblea"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Globalization
@using IngenIA365ERP.Shared.Services.Adjuntos
@using IngenIA365ERP.Shared.Services.Cartera
@using IngenIA365ERP.Shared.Services.Http
@inject CaptacionesClient Cliente
@inject AdjuntosClient Adjuntos
@inject INotificationService Notification

<PageTitle>Asamblea - IngenIA365ERP</PageTitle>

@* Feature 014, US12 (T205; FR-045 a FR-047; contracts/api.md §12; research §22): la revalorización de aportes, la distribución de excedentes y la
   amortización de aportes que decide la asamblea. Se registra el borrador con lo decidido, se simula (límite del IPC y prorrateo al fondo), se lleva al
   orden del día de la asamblea y otra persona la aplica con el punto del acta cerrada, el acta firmada como soporte y la huella de la simulación que vio.
   Para corregir se reversa entera y se registra otra que la corrige (hereda el acta). Una decisión es de toda la cooperativa: la ve quien tiene alcance
   total. *@
<PermissionGate Required="Lending.Assembly.Register" AnyOf="@Permisos" MostrarAviso="true">
<div class="pagina">
    <div class="page-header">
        <h3>Asamblea: revalorización, excedentes y amortización</h3>
        <div class="toolbar">
            <input class="e-input" type="number" min="2000" max="2999" placeholder="Ejercicio" @bind="_anio" />
            <select class="e-input" value="@_estado" @onchange="@(e => CambiarEstadoAsync(e.Value?.ToString()))">
                <option value="">Todos los estados</option>
                @foreach (var e in new[] { 1, 3, 4, 5 }) { <option value="@e">@TextosDeAsamblea.Estado(e)</option> }
            </select>
            <SfButton CssClass="e-outline" IconCss="e-icons e-refresh" Disabled="@_carga.Activa" OnClick="@CargarAsync">Actualizar</SfButton>
            <PermissionGate Required="Lending.Assembly.Register">
                <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@AbrirRegistro">Registrar decisión</SfButton>
            </PermissionGate>
        </div>
    </div>

    <IndicadorDeCarga Cargando="@_carga.Activa">
        <div class="tabla-desplazable">
            <table class="data-grid">
                <thead>
                    <tr><th>Número</th><th>Clase</th><th>Ejercicio</th><th>Decidido</th><th>Base</th><th class="numero">Fondo</th><th class="numero">Aplicado</th>
                        <th>Estado</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var d in _decisiones)
                    {
                        var decision = d;
                        <tr>
                            <td>@decision.Number</td>
                            <td>@TextosDeAsamblea.Clase(decision.Kind)@(decision.Kind == 2 ? $" ({TextosDeAsamblea.Destino(decision.Destination)})" : "")</td>
                            <td>@decision.Year</td>
                            <td>@decision.PercentOrValue</td>
                            <td>@TextosDeAsamblea.Base(decision.Base)</td>
                            <td class="numero">@Pesos(decision.Fund)</td>
                            <td class="numero">@(decision.Status == 3 || decision.Status == 5 ? Pesos(decision.AppliedTotal) : "—")</td>
                            <td>@TextosDeAsamblea.Estado(decision.Status)</td>
                            <td><SfButton CssClass="e-flat e-small" OnClick="@(() => AbrirAsync(decision.PublicId))">Ver</SfButton></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (_decisiones.Count == 0) { <p class="texto-tenue">No hay decisiones de asamblea con esos filtros (o su alcance no es total).</p> }
    </IndicadorDeCarga>

    @if (_actual is { } a)
    {
        <div class="info-card">
            <IndicadorDeCarga Cargando="@_detalle.Activa">
                <h4>@a.Number · @TextosDeAsamblea.Clase(a.Kind) del ejercicio @a.Year · @TextosDeAsamblea.Estado(a.Status)</h4>
                <p>
                    @a.PercentOrValue sobre el @TextosDeAsamblea.Base(a.Base).ToLowerInvariant(), con cargo a un fondo de @Pesos(a.Fund)
                    @if (a.Kind == 2) { <span>· @TextosDeAsamblea.Destino(a.Destination) @(a.DestinationLineCode is { } l ? $"({l})" : "")</span> }
                    @if (a.CorrectsNumber is { } c) { <span>· corrige la decisión @c</span> }
                </p>
                @if (a.SessionNumber is { } acta) { <p>Acta @acta</p> }
                @if (a.LegalLimit is { } lim) { <p>Límite legal: @Porcentaje(lim) (@a.LegalLimitSource)</p> }
                @if (a.Status == 3 || a.Status == 5)
                {
                    <p>Calculado @Pesos(a.CalculatedTotal) · aplicado @Pesos(a.AppliedTotal) @(a.ProrationFactor is { } f ? $"· prorrateado (factor {f.ToString("0.######", Es)})" : "")</p>
                }
                @if (a.ReversedAt is { } rev) { <p class="aviso">Reversada el @rev.ToLocalTime().ToString("dd/MM/yyyy HH:mm"): @a.ReversalReason</p> }

                @if (a.Status == 1)
                {
                    <div class="toolbar">
                        <SfButton CssClass="e-outline" Disabled="@_detalle.Activa" OnClick="@SimularAsync">Simular</SfButton>
                        <PermissionGate Required="Lending.Assembly.Register">
                            <SfButton CssClass="e-flat" Disabled="@_detalle.Activa" OnClick="@(() => _motivoAccion = "")">Descartar…</SfButton>
                        </PermissionGate>
                    </div>
                    @if (_simulacion is { } s)
                    {
                        <div class="info-card">
                            <p>Tasa decidida @Porcentaje(s.DecidedRate) · aplicada @Porcentaje(s.AppliedRate)
                                @if (s.LimitedByIpc.Applied) { <strong> · limitada por el IPC (@Porcentaje(s.LimitedByIpc.Ipc ?? 0m))</strong> }
                                @if (s.ProratedToFund.Applied) { <strong> · prorrateada al fondo (factor @(s.ProratedToFund.Factor?.ToString("0.######", Es)))</strong> }
                            </p>
                            <p>Base @Pesos(s.Totals.Base) · calculado @Pesos(s.Totals.Calculated) · aplicado @Pesos(s.Totals.Applied) · queda en el fondo
                                @Pesos(s.Totals.FundRemainder) · @s.Totals.Lines asociado(s)</p>
                            @foreach (var x in s.Explanation) { <p class="texto-tenue">@x</p> }
                            @foreach (var w in s.Warnings) { <p class="aviso">@w</p> }
                            <div class="tabla-desplazable">
                                <table class="data-grid">
                                    <thead><tr><th>Asociado</th><th>Cuenta</th><th class="numero">Base</th><th class="numero">Calculado</th><th class="numero">Aplicado</th>
                                        <th>Destino</th></tr></thead>
                                    <tbody>
                                        @foreach (var l in s.Lines.Take(500))
                                        {
                                            <tr>
                                                <td>@l.Person.FullName<br /><span class="texto-tenue">@l.Person.DocumentNumber</span></td>
                                                <td>@l.ContributionAccountNumber</td>
                                                <td class="numero">@Pesos(l.BaseAmount)</td>
                                                <td class="numero">@Pesos(l.CalculatedAmount)@(l.LimitedByMinimum ? " (hasta el mínimo)" : "")</td>
                                                <td class="numero">@Pesos(l.AppliedAmount)</td>
                                                <td>@(l.DestinationAccountNumber ?? "—")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            @if (s.Lines.Count > 500) { <p class="texto-tenue">Se muestran 500 de @s.Lines.Count líneas.</p> }
                        </div>

                        <PermissionGate Required="Lending.Assembly.Approve">
                            <div class="info-card">
                                <h4>Aplicar (otra persona que quien registró)</h4>
                                <p class="texto-tenue">El acta firmada de la asamblea (y el proyecto de distribución, si lo hay) se sube como soporte de la decisión.</p>
                                <SubirSoporte OwnerEntityType="@TextosDeAsamblea.DuenoDeSoportes" OwnerEntityPublicId="@a.PublicId" Rotulo="Subir el acta"
                                              OnSubido="@CargarSoportesAsync" />
                                @foreach (var sop in _soportes.Where(x => x.Disponible))
                                {
                                    <label class="campo-check"><input type="checkbox" checked="@_elegidos.Contains(sop.PublicId)"
                                                                      @onchange="@(e => Elegir(sop.PublicId, e.Value is true))" /> @sop.FileName</label>
                                }
                                @if (a.SessionItemPublicId is null)
                                {
                                    <label class="campo campo-ancho">Punto del acta cerrada (su identificador)
                                        <input class="e-input" maxlength="36" @bind="_punto" />
                                    </label>
                                }
                                <label class="campo campo-ancho">Motivo <textarea class="e-input" rows="2" maxlength="500" @bind="_motivoAplicar"></textarea></label>
                                <SfButton CssClass="e-primary" Disabled="@(_detalle.Activa || _elegidos.Count == 0 || string.IsNullOrWhiteSpace(_motivoAplicar))"
                                          OnClick="@AplicarAsync">Aplicar con esta simulación</SfButton>
                            </div>
                        </PermissionGate>
                    }
                }

                @if (a.Status == 3)
                {
                    <PermissionGate Required="Lending.Assembly.Approve">
                        <SfButton CssClass="e-outline" Disabled="@_detalle.Activa" OnClick="@(() => _motivoAccion = "")">Reversar entera…</SfButton>
                    </PermissionGate>
                }

                @if (_motivoAccion is not null)
                {
                    <label class="campo campo-ancho">Motivo @(a.Status == 1 ? "del descarte" : "del reverso")
                        <textarea class="e-input" rows="2" maxlength="500" @bind="_motivoAccion"></textarea>
                    </label>
                    <div class="toolbar">
                        <SfButton CssClass="e-primary" Disabled="@(_detalle.Activa || string.IsNullOrWhiteSpace(_motivoAccion))"
                                  OnClick="@(a.Status == 1 ? DescartarAsync : ReversarAsync)">Confirmar</SfButton>
                        <SfButton CssClass="e-flat" OnClick="@(() => _motivoAccion = null)">Volver</SfButton>
                    </div>
                }

                @if (a.Lines.Count > 0)
                {
                    <div class="tabla-desplazable">
                        <table class="data-grid">
                            <thead><tr><th>Asociado</th><th>Cuenta</th><th class="numero">Base</th><th class="numero">Aplicado</th><th>Operación</th><th>Orden de giro</th></tr></thead>
                            <tbody>
                                @foreach (var l in a.Lines.Take(500))
                                {
                                    <tr>
                                        <td>@l.Person.FullName</td>
                                        <td>@(l.DestinationAccountNumber ?? l.ContributionAccountNumber)</td>
                                        <td class="numero">@Pesos(l.BaseAmount)</td>
                                        <td class="numero">@Pesos(l.AppliedAmount)</td>
                                        <td>@(l.OperationNumber ?? "—")</td>
                                        <td>@(l.PayoutOrderNumber ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                @if (_error is not null) { <p class="aviso aviso-error" role="alert">@_error</p> }
            </IndicadorDeCarga>
        </div>
    }
</div>

<SfDialog @bind-Visible="_mostrarRegistro" Header="Registrar una decisión de asamblea" Width="640px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@_detalle.Activa" Texto="Registrando…">
                <label class="campo">Clase *
                    <select class="e-input" @bind="_clase">
                        @foreach (var c in new[] { 1, 2, 3 }) { <option value="@c">@TextosDeAsamblea.Clase(c)</option> }
                    </select>
                </label>
                <label class="campo">Ejercicio * <input class="e-input" type="number" min="2000" @bind="_ejercicio" /></label>
                <label class="campo">Fondo aprobado en el acta * <input class="e-input" type="number" min="0" step="0.01" @bind="_fondo" /></label>
                <label class="campo">Porcentaje decidido (en puntos, p. ej. 4,5) <input class="e-input" type="number" min="0" step="0.0001" @bind="_puntos" /></label>
                <label class="campo">o valor total decidido <input class="e-input" type="number" min="0" step="0.01" @bind="_valor" /></label>
                <label class="campo">Base
                    <select class="e-input" @bind="_base">
                        <option value="0">La de la entidad</option>
                        <option value="1">Saldo promedio diario</option>
                        <option value="2">Saldo al 31 de diciembre</option>
                    </select>
                </label>
                @if (_clase == 2)
                {
                    <label class="campo">Destino
                        <select class="e-input" @bind="_destino">
                            <option value="0">El de la entidad</option>
                            <option value="1">A aportes</option>
                            <option value="2">A una cuenta de ahorro</option>
                            <option value="3">Pago por orden de giro</option>
                        </select>
                    </label>
                    @if (_destino == 2) { <label class="campo">Código de la línea de ahorro * <input class="e-input" maxlength="20" @bind="_lineaDestino" /></label> }
                }
                <label class="campo campo-ancho">Corrige la decisión reversada (su número, opcional)
                    <select class="e-input" @bind="_corrige">
                        <option value="">Ninguna</option>
                        @foreach (var r in _decisiones.Where(x => x.Status == 5)) { <option value="@r.PublicId">@r.Number (@r.Year)</option> }
                    </select>
                </label>
                <label class="campo campo-ancho">Motivo * <textarea class="e-input" rows="2" maxlength="500" @bind="_motivo"></textarea></label>
                @if (_error is not null) { <p class="aviso aviso-error" role="alert">@_error</p> }
                <div class="toolbar">
                    <SfButton CssClass="e-primary" Disabled="@(_detalle.Activa || string.IsNullOrWhiteSpace(_motivo) || (_puntos is null) == (_valor is null))"
                              OnClick="@RegistrarAsync">Registrar</SfButton>
                    <SfButton CssClass="e-outline" OnClick="@(() => _mostrarRegistro = false)">Volver</SfButton>
                </div>
            </IndicadorDeCarga>
        </Content>
    </DialogTemplates>
</SfDialog>
</PermissionGate>

@code {
    private static readonly CultureInfo Es = CultureInfo.GetCultureInfo("es-CO");
    private static readonly string[] Permisos = ["Lending.Assembly.Approve"];

    private readonly EstadoDeCarga _carga = new(), _detalle = new();
    private List<DecisionDeAsambleaDto> _decisiones = [];
    private DecisionDeAsambleaDto? _actual;
    private SimulacionDeAsambleaDto? _simulacion;
    private List<AdjuntoDto> _soportes = [];
    private readonly HashSet<Guid> _elegidos = [];
    private int? _anio;
    private string _estado = string.Empty;
    private string? _error, _motivo, _motivoAplicar, _motivoAccion, _punto, _lineaDestino, _corrige;
    private bool _mostrarRegistro;
    private int _clase = 1, _base, _destino, _ejercicio = DateTime.Today.Year - 1;
    private decimal? _fondo, _puntos, _valor;
    private ClaveDeOperacion _clave = new();

    protected override Task OnInitializedAsync() => CargarAsync();

    private async Task CambiarEstadoAsync(string? estado)
    {
        _estado = estado ?? string.Empty;
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        using var carga = _carga.Iniciar();
        var r = await Cliente.DecisionesDeAsambleaAsync(_anio, null, int.TryParse(_estado, NumberStyles.Integer, CultureInfo.InvariantCulture, out var e) ? e : null);
        if (!r.IsSuccess || r.Value is null) { _decisiones = []; await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudieron leer las decisiones."); return; }
        _decisiones = [.. r.Value];
    }

    private async Task AbrirAsync(Guid decision)
    {
        using var carga = _detalle.Iniciar();
        _simulacion = null;
        _error = null;
        _motivoAccion = null;
        _elegidos.Clear();
        var r = await Cliente.DecisionDeAsambleaAsync(decision);
        if (!r.IsSuccess || r.Value is null) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo leer la decisión."); return; }
        _actual = r.Value;
        await CargarSoportesAsync();
    }

    private async Task CargarSoportesAsync()
    {
        if (_actual is null) { _soportes = []; return; }
        var r = await Adjuntos.ListarAsync(TextosDeAsamblea.DuenoDeSoportes, _actual.PublicId);
        _soportes = r.Value ?? [];
    }

    private void Elegir(Guid soporte, bool elegido)
    {
        if (elegido) _elegidos.Add(soporte); else _elegidos.Remove(soporte);
    }

    private async Task SimularAsync()
    {
        if (_actual is null) return;
        using var carga = _detalle.Iniciar();
        _error = null;
        var r = await Cliente.SimularDecisionDeAsambleaAsync(_actual.PublicId);
        if (!r.IsSuccess || r.Value is null) { _error = string.Join(" ", LineasDeCreditoClient.Explicar(r)); return; }
        _simulacion = r.Value;
        _clave = new ClaveDeOperacion();
    }

    private async Task AplicarAsync()
    {
        if (_actual is null || _simulacion is null) return;
        Guid? punto = null;
        if (_actual.SessionItemPublicId is null)
        {
            if (!Guid.TryParse(_punto?.Trim(), out var p)) { _error = "Digite el identificador del punto del acta cerrada de la asamblea."; return; }
            punto = p;
        }
        using var carga = _detalle.Iniciar();
        _error = null;
        var r = await Cliente.AplicarDecisionDeAsambleaAsync(_actual.PublicId, new AplicarDecisionDeAsambleaRequest(punto, _simulacion.Sha256, [.. _elegidos],
            _motivoAplicar ?? string.Empty), _clave);
        if (!r.IsSuccess || r.Value is null) { _error = string.Join(" ", LineasDeCreditoClient.Explicar(r)); return; }
        await Notification.SuccessAsync($"Decisión {r.Value.Number} aplicada: {Pesos(r.Value.AppliedTotal)} a {r.Value.Lines.Count} asociado(s).");
        _actual = r.Value;
        _simulacion = null;
        await CargarAsync();
    }

    private async Task DescartarAsync()
    {
        if (_actual is null) return;
        using var carga = _detalle.Iniciar();
        var r = await Cliente.DescartarDecisionDeAsambleaAsync(_actual.PublicId, _motivoAccion ?? string.Empty, new ClaveDeOperacion());
        if (!r.IsSuccess || r.Value is null) { _error = string.Join(" ", LineasDeCreditoClient.Explicar(r)); return; }
        _actual = r.Value;
        _motivoAccion = null;
        await CargarAsync();
    }

    private async Task ReversarAsync()
    {
        if (_actual is null) return;
        using var carga = _detalle.Iniciar();
        var r = await Cliente.ReversarDecisionDeAsambleaAsync(_actual.PublicId, _motivoAccion ?? string.Empty, new ClaveDeOperacion());
        if (!r.IsSuccess || r.Value is null) { _error = string.Join(" ", LineasDeCreditoClient.Explicar(r)); return; }
        await Notification.SuccessAsync($"Decisión {r.Value.Number} reversada entera: para corregirla, registre otra que la corrija.");
        _actual = r.Value;
        _motivoAccion = null;
        await CargarAsync();
    }

    private void AbrirRegistro()
    {
        _clase = 1;
        _ejercicio = DateTime.Today.Year - 1;
        _fondo = _puntos = _valor = null;
        _base = _destino = 0;
        _lineaDestino = _corrige = _motivo = _error = null;
        _clave = new ClaveDeOperacion();
        _mostrarRegistro = true;
    }

    private async Task RegistrarAsync()
    {
        using var carga = _detalle.Iniciar();
        _error = null;
        var r = await Cliente.RegistrarDecisionDeAsambleaAsync(new RegistrarDecisionDeAsambleaRequest(_clase, _ejercicio, _fondo ?? 0m,
            _puntos is { } p ? decimal.Round(p / 100m, 6) : null, _valor, _base == 0 ? null : _base, _clase == 2 && _destino != 0 ? _destino : null,
            _clase == 2 && _destino == 2 ? _lineaDestino : null, Guid.TryParse(_corrige, out var c) ? c : null, _motivo ?? string.Empty), _clave);
        if (!r.IsSuccess || r.Value is null) { _error = string.Join(" ", LineasDeCreditoClient.Explicar(r)); return; }
        _mostrarRegistro = false;
        await Notification.SuccessAsync($"Decisión {r.Value.Number} registrada en borrador: simúlela y llévela al orden del día de la asamblea.");
        await CargarAsync();
        await AbrirAsync(r.Value.PublicId);
    }

    private static string Pesos(decimal valor) => "$ " + valor.ToString("N2", Es);

    private static string Porcentaje(decimal fraccion) => (fraccion * 100m).ToString("0.####", Es) + " %";
}
