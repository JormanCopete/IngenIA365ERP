@using System.Globalization
@using IngenIA365ERP.Shared.Services.Cartera
@using IngenIA365ERP.Shared.Services.Http
@using IngenIA365ERP.Shared.Services.Inventario
@inject CaptacionesClient Cliente
@inject INotificationService Notification

@* Feature 014, US5 (T139; FR-039, FR-060 a FR-064; contracts/api.md §4): los intereses de una cuenta en su ficha. Las liquidaciones del proceso y las
   manuales (con su retención, su componente inflacionario y el neto abonado), la simulación a cualquier fecha sin efectos —con la explicación día por día:
   saldo, base, tramo, tasa e interés, y por qué un día causó cero— y la liquidación manual de un período vencido (idempotente). Y la cancelación de la
   cuenta: la vista previa (lo que se liquidaría, el GMF, lo que se entregaría y lo que la impide) y la entrega por traslado a otra cuenta del titular o por
   orden de giro a su cuenta registrada. *@
<div class="info-card">
    <h4>Intereses</h4>
    <IndicadorDeCarga Cargando="@_cargaLiquidaciones.Activa">
        @if (_liquidaciones.Count == 0)
        {
            <p class="texto-tenue">La cuenta todavía no tiene liquidaciones de intereses.</p>
        }
        else
        {
            <div class="tabla-desplazable">
                <table class="data-grid">
                    <thead>
                        <tr><th>Período</th><th>Operación</th><th class="numero">Causado</th><th class="numero">Abonado</th><th class="numero">Retención</th>
                            <th class="numero">Neto</th><th>Retención</th><th>Origen</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var l in _liquidaciones)
                        {
                            <tr>
                                <td>@l.PeriodFrom.ToString("dd/MM/yyyy") – @l.PeriodTo.ToString("dd/MM/yyyy")</td>
                                <td>@l.OperationNumber@(l.Reversed ? " (reversada)" : "")</td>
                                <td class="numero">@Decimales(l.Accrued)</td>
                                <td class="numero">@Pesos(l.Settled)</td>
                                <td class="numero">@Pesos(l.Withholding)</td>
                                <td class="numero">@Pesos(l.Net)</td>
                                <td>@TextosDeIntereses.MotivoSinRetencion(l.WithholdingExemptionReason)@(l.InflationaryComponent is { } c && c > 0m ? $" · componente {Pesos(c)}" : "")</td>
                                <td>@(l.Origin == "Process" ? "Proceso" : "Manual")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <div class="toolbar">
            <label class="campo">Simular al <input class="e-input" type="date" @bind="_fechaDeSimulacion" /></label>
            <SfButton CssClass="e-outline" OnClick="@SimularAsync">Simular la liquidación</SfButton>
            <PermissionGate Required="Lending.Interest.Settle">
                <label class="campo">Fin del período <input class="e-input" type="date" @bind="_finDelPeriodo" /></label>
                <label class="campo">Motivo <input class="e-input" @bind="_motivo" /></label>
                <SfButton CssClass="e-outline" Disabled="@(_guardado.Activa || string.IsNullOrWhiteSpace(_motivo))" OnClick="@LiquidarAsync">Liquidar el período</SfButton>
            </PermissionGate>
        </div>
        @foreach (var e in _errores) { <p class="aviso aviso-error" role="alert">@e</p> }
    </IndicadorDeCarga>

    @if (_simulacion is { } s)
    {
        <IndicadorDeCarga Cargando="@_cargaSimulacion.Activa">
            <dl class="form-grid">
                <div><dt>Período</dt><dd>@s.PeriodFrom.ToString("dd/MM/yyyy") – @s.PeriodTo.ToString("dd/MM/yyyy")</dd></div>
                <div><dt>Causado</dt><dd>@Decimales(s.Accrued)</dd></div>
                <div><dt>A abonar</dt><dd>@Pesos(s.Interest) (redondeo @Decimales(s.RoundingAdjustment))</dd></div>
                <div><dt>Retención</dt><dd>@Pesos(s.Withholding.Amount) · @TextosDeIntereses.MotivoSinRetencion(s.Withholding.ExemptionReason)</dd></div>
                <div><dt>Neto</dt><dd>@Pesos(s.Net)</dd></div>
            </dl>
            <p class="texto-tenue">@s.Withholding.Explanation</p>
            <div class="tabla-desplazable">
                <table class="data-grid">
                    <thead><tr><th>Día</th><th class="numero">Saldo</th><th class="numero">Base</th><th>Tramo</th><th class="numero">Tasa EA</th><th class="numero">Interés</th><th>Nota</th></tr></thead>
                    <tbody>
                        @foreach (var d in s.Explanation)
                        {
                            <tr>
                                <td>@d.Date.ToString("dd/MM/yyyy")</td>
                                <td class="numero">@Pesos(d.Balance)</td>
                                <td class="numero">@Pesos(d.Base)</td>
                                <td>@d.RateTier</td>
                                <td class="numero">@((d.AnnualRate * 100m).ToString("0.####", Es)) %</td>
                                <td class="numero">@Decimales(d.Interest)</td>
                                <td>@(d.Suspended ? "Suspendida" : d.BelowMinimum ? "Bajo el mínimo para interés" : "")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </IndicadorDeCarga>
    }
</div>

@if (Cuenta.Status != TextosDeCaptaciones.Cancelada)
{
    <PermissionGate Required="Lending.Accounts.Close">
        <div class="info-card">
            <h4>Cancelación</h4>
            <IndicadorDeCarga Cargando="@_cargaPrevia.Activa">
                <div class="toolbar">
                    <SfButton CssClass="e-outline" OnClick="@VistaPreviaAsync">Ver lo que dejaría la cancelación</SfButton>
                </div>
                @if (_previa is { } p)
                {
                    <dl class="form-grid">
                        <div><dt>Intereses a la fecha (neto)</dt><dd>@(p.Settlement is { } st ? Pesos(st.Net) : "No causa")</dd></div>
                        <div><dt>Saldo después de liquidar</dt><dd>@Pesos(p.BalanceAfterSettlement)</dd></div>
                        <div><dt>GMF de la entrega</dt><dd>@Pesos(p.Gmf)</dd></div>
                        <div><dt>Se entrega</dt><dd>@Pesos(p.ToDeliver)</dd></div>
                    </dl>
                    @if (p.Blockers.Count > 0)
                    {
                        @foreach (var b in p.Blockers) { <p class="aviso aviso-error">@TextosDeIntereses.Bloqueo(b.Kind): @b.Detail</p> }
                    }
                    else
                    {
                        <div class="form-grid">
                            <label class="campo">Entrega
                                <select class="e-input" @bind="_entrega">
                                    <option value="@TextosDeIntereses.EntregaPorTraslado">Trasladar a otra cuenta del titular</option>
                                    <option value="@TextosDeIntereses.EntregaPorGiro">Orden de giro a la cuenta registrada del titular</option>
                                </select>
                            </label>
                            @if (_entrega == TextosDeIntereses.EntregaPorTraslado)
                            {
                                <label class="campo">Cuenta destino
                                    <select class="e-input" @bind="_destino">
                                        <option value="">Elija la cuenta</option>
                                        @foreach (var d in _destinos) { <option value="@d.PublicId">@d.Number · @d.Line.Name</option> }
                                    </select>
                                </label>
                            }
                            <label class="campo">Motivo <input class="e-input" @bind="_motivoDeCancelacion" /></label>
                        </div>
                        <SfButton CssClass="e-primary" Disabled="@(_guardado.Activa || string.IsNullOrWhiteSpace(_motivoDeCancelacion)
                                                                  || (_entrega == TextosDeIntereses.EntregaPorTraslado && _destino is null))"
                                  OnClick="@CancelarAsync">Cancelar la cuenta</SfButton>
                    }
                }
                @foreach (var e in _erroresDeCancelacion) { <p class="aviso aviso-error" role="alert">@e</p> }
            </IndicadorDeCarga>
        </div>
    </PermissionGate>
}

@code {
    private static readonly CultureInfo Es = CultureInfo.GetCultureInfo("es-CO");

    [Parameter, EditorRequired] public CuentaDto Cuenta { get; set; } = default!;
    [Parameter] public EventCallback OnCambio { get; set; }

    private readonly EstadoDeCarga _cargaLiquidaciones = new(), _cargaSimulacion = new(), _cargaPrevia = new(), _guardado = new();
    private List<LiquidacionDeInteresesDto> _liquidaciones = [];
    private List<CuentaEnListaDto> _destinos = [];
    private SimulacionDeInteresesDto? _simulacion;
    private VistaPreviaDeCancelacionDto? _previa;
    private List<string> _errores = [], _erroresDeCancelacion = [];
    private DateOnly _fechaDeSimulacion = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly _finDelPeriodo = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private string? _motivo, _motivoDeCancelacion;
    private int _entrega = TextosDeIntereses.EntregaPorTraslado;
    private Guid? _destino;
    private ClaveDeOperacion _clave = new(), _claveDeCancelacion = new();
    private Guid _cuentaLeida;

    protected override async Task OnParametersSetAsync()
    {
        if (Cuenta.PublicId == _cuentaLeida) return;
        _cuentaLeida = Cuenta.PublicId;
        _finDelPeriodo = _finDelPeriodo.AddDays(-1);
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        using var carga = _cargaLiquidaciones.Iniciar();
        _liquidaciones = [.. (await Cliente.LiquidacionesAsync(Cuenta.PublicId)).Value?.Items ?? []];
    }

    private async Task SimularAsync()
    {
        using var carga = _cargaSimulacion.Iniciar();
        _errores = [];
        var r = await Cliente.SimularInteresesAsync(Cuenta.PublicId, new SimularInteresesRequest(_fechaDeSimulacion));
        if (!r.IsSuccess) { _errores = [.. LineasDeCreditoClient.Explicar(r)]; return; }
        _simulacion = r.Value;
    }

    private async Task LiquidarAsync()
    {
        using var carga = _guardado.Iniciar();
        _errores = [];
        var r = await Cliente.LiquidarInteresesAsync(Cuenta.PublicId, new LiquidarInteresesRequest(_finDelPeriodo, _motivo!.Trim()), _clave);
        if (!r.IsSuccess) { _errores = [.. LineasDeCreditoClient.Explicar(r)]; return; }
        _clave = new ClaveDeOperacion();
        await Notification.SuccessAsync(r.Value is { AlreadyExisted: true } ya
            ? $"El período ya estaba liquidado con la operación {ya.OperationNumber}."
            : $"Intereses liquidados: {Pesos(r.Value?.Net ?? 0m)} netos.");
        await CargarAsync();
        await OnCambio.InvokeAsync();
    }

    private async Task VistaPreviaAsync()
    {
        using var carga = _cargaPrevia.Iniciar();
        _erroresDeCancelacion = [];
        var r = await Cliente.VistaPreviaDeCancelacionAsync(Cuenta.PublicId);
        if (!r.IsSuccess) { _erroresDeCancelacion = [.. LineasDeCreditoClient.Explicar(r)]; return; }
        _previa = r.Value;
        var cuentas = await Cliente.CuentasAsync(titular: Cuenta.Holder.PersonPublicId, tamano: 50);
        _destinos = [.. (cuentas.Value?.Items ?? []).Where(a => a.PublicId != Cuenta.PublicId && a.Nature == TextosDeCaptaciones.Captacion)];
    }

    private async Task CancelarAsync()
    {
        using var carga = _guardado.Iniciar();
        _erroresDeCancelacion = [];
        var entrega = _entrega == TextosDeIntereses.EntregaPorTraslado
            ? new EntregaDeCancelacionRequest(TextosDeIntereses.EntregaPorTraslado, _destino, null)
            : new EntregaDeCancelacionRequest(TextosDeIntereses.EntregaPorGiro, null, new BeneficiarioDeGiroRequest(Cuenta.Holder.PersonPublicId));
        var r = await Cliente.CancelarCuentaAsync(Cuenta.PublicId, new CancelarCuentaRequest(null, entrega, [Cuenta.Holder.PersonPublicId],
            _motivoDeCancelacion!.Trim()), _claveDeCancelacion);
        if (!r.IsSuccess) { _erroresDeCancelacion = [.. LineasDeCreditoClient.Explicar(r)]; return; }
        _claveDeCancelacion = new ClaveDeOperacion();
        _previa = null;
        await Notification.SuccessAsync($"Cuenta cancelada con la operación {r.Value?.OperationNumber}: se entregaron {Pesos(r.Value?.Delivered ?? 0m)}.");
        await CargarAsync();
        await OnCambio.InvokeAsync();
    }

    private static string Pesos(decimal valor) => "$ " + valor.ToString("N0", Es);

    private static string Decimales(decimal valor) => "$ " + valor.ToString("N2", Es);
}
