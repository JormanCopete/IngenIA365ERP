@page "/reportes/comprobante-nomina"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification
@inject IJSRuntime JS

<PageTitle>Comprobante de Nomina - IngenIA365ERP</PageTitle>

<div class="page-header">
    <h3>Comprobante de Pago de Nomina</h3>
    <div style="display:flex;gap:8px;">
        <SfButton CssClass="e-primary" IconCss="e-icons e-search" OnClick="LoadPreview">Vista Previa</SfButton>
        <SfButton CssClass="e-info" IconCss="e-icons e-download" OnClick="DownloadPdf" Disabled="@(_payslip is null)">PDF</SfButton>
    </div>
</div>

<!-- Filters -->
<div style="display:flex;gap:12px;margin-bottom:16px;flex-wrap:wrap;align-items:end;">
    <div>
        <label>Ano</label>
        <SfNumericTextBox TValue="int" @bind-Value="_year" Min="2000" Max="2099" Format="####" Width="120px" CssClass="e-small" />
    </div>
    <div>
        <label>Mes</label>
        <SfDropDownList TValue="int" TItem="MonthOption" @bind-Value="_month" DataSource="_months" CssClass="e-small" Width="160px">
            <DropDownListFieldSettings Text="Name" Value="Value" />
        </SfDropDownList>
    </div>
    <div>
        <label>Periodo</label>
        <SfDropDownList TValue="int" TItem="PeriodOption" @bind-Value="_period" DataSource="_periods" CssClass="e-small" Width="160px">
            <DropDownListFieldSettings Text="Name" Value="Value" />
        </SfDropDownList>
    </div>
    <div>
        <label>Empleado</label>
        <SfDropDownList TValue="string" TItem="EmployeeOption" @bind-Value="_employeeId" DataSource="_employees"
                        CssClass="e-small" Width="300px" Placeholder="Seleccione empleado" AllowFiltering="true">
            <DropDownListFieldSettings Text="Display" Value="Id" />
        </SfDropDownList>
    </div>
</div>

@if (_loading)
{
    <SfProgressBar Type="ProgressType.Linear" IsIndeterminate="true" Height="4"
                   TrackColor="#333" ProgressColor="#00bcd4" />
}

@if (_payslip is not null)
{
    <!-- Employee Header -->
    <div style="padding:16px;border:1px solid #333;border-radius:8px;margin-bottom:16px;background:#1e1e2e;">
        <div style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;">
            <div>
                <h4 style="margin:0 0 4px;">@_payslip.EmployeeName</h4>
                <span style="color:#999;">Doc: @_payslip.DocumentNumber | Cargo: @_payslip.Position</span>
            </div>
            <div style="text-align:right;">
                <span style="color:#999;">Periodo:</span> @_payslip.PeriodLabel<br />
                <span style="color:#999;">Salario Base:</span> @_payslip.BaseSalary.ToString("N2")
            </div>
        </div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;">
        <!-- Devengados -->
        <div>
            <h4 style="color:#4caf50;margin-bottom:8px;">Devengados</h4>
            <SfGrid TValue="PayslipLine" DataSource="_payslip.Earnings" AllowSorting="false">
                <GridColumns>
                    <GridColumn Field="Concept" HeaderText="Concepto" Width="250" />
                    <GridColumn Field="Hours" HeaderText="Horas" Width="80" TextAlign="TextAlign.Center" />
                    <GridColumn Field="Amount" HeaderText="Valor" Width="150" Format="N2" TextAlign="TextAlign.Right" />
                </GridColumns>
                <GridAggregates>
                    <GridAggregate>
                        <GridAggregateColumns>
                            <GridAggregateColumn Field="Amount" Type="AggregateType.Sum" Format="N2">
                                <FooterTemplate>@{ var s = context as AggregateTemplateContext; }<b style="color:#4caf50;">@s?.Sum</b></FooterTemplate>
                            </GridAggregateColumn>
                        </GridAggregateColumns>
                    </GridAggregate>
                </GridAggregates>
            </SfGrid>
        </div>

        <!-- Deducciones -->
        <div>
            <h4 style="color:#f44336;margin-bottom:8px;">Deducciones</h4>
            <SfGrid TValue="PayslipLine" DataSource="_payslip.Deductions" AllowSorting="false">
                <GridColumns>
                    <GridColumn Field="Concept" HeaderText="Concepto" Width="250" />
                    <GridColumn Field="Hours" HeaderText="Horas" Width="80" TextAlign="TextAlign.Center" />
                    <GridColumn Field="Amount" HeaderText="Valor" Width="150" Format="N2" TextAlign="TextAlign.Right" />
                </GridColumns>
                <GridAggregates>
                    <GridAggregate>
                        <GridAggregateColumns>
                            <GridAggregateColumn Field="Amount" Type="AggregateType.Sum" Format="N2">
                                <FooterTemplate>@{ var s = context as AggregateTemplateContext; }<b style="color:#f44336;">@s?.Sum</b></FooterTemplate>
                            </GridAggregateColumn>
                        </GridAggregateColumns>
                    </GridAggregate>
                </GridAggregates>
            </SfGrid>
        </div>
    </div>

    <!-- Net Pay -->
    <div style="margin-top:24px;padding:20px;border:2px solid #00bcd4;border-radius:8px;text-align:center;">
        <span style="font-size:14px;color:#999;">NETO A PAGAR</span>
        <h2 style="margin:4px 0 0;color:#00bcd4;">@_payslip.NetPay.ToString("N2")</h2>
    </div>
}
else if (!_loading && _searched)
{
    <p style="color:#999;">No se encontro comprobante de nomina para los parametros seleccionados.</p>
}

@code {
    private int _year = DateTime.Today.Year;
    private int _month = DateTime.Today.Month;
    private int _period = 1;
    private string? _employeeId;
    private bool _loading;
    private bool _searched;
    private PayslipData? _payslip;
    private List<EmployeeOption> _employees = [];

    private static readonly List<MonthOption> _months =
    [
        new(1, "01 - Enero"), new(2, "02 - Febrero"), new(3, "03 - Marzo"),
        new(4, "04 - Abril"), new(5, "05 - Mayo"), new(6, "06 - Junio"),
        new(7, "07 - Julio"), new(8, "08 - Agosto"), new(9, "09 - Septiembre"),
        new(10, "10 - Octubre"), new(11, "11 - Noviembre"), new(12, "12 - Diciembre")
    ];

    private static readonly List<PeriodOption> _periods =
    [
        new(1, "Primera quincena"),
        new(2, "Segunda quincena"),
        new(3, "Mensual")
    ];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _employees = await Http.GetFromJsonAsync<List<EmployeeOption>>("/api/payroll/employees/active") ?? [];
        }
        catch
        {
            // Employee list will be empty; user can retry
        }
    }

    private async Task LoadPreview()
    {
        if (string.IsNullOrEmpty(_employeeId))
        {
            await Notification.ErrorAsync("Seleccione un empleado.");
            return;
        }

        _loading = true;
        _searched = true;
        try
        {
            _payslip = await Http.GetFromJsonAsync<PayslipData>(
                $"/api/reports/payroll/payslip?employeeId={_employeeId}&year={_year}&month={_month}&period={_period}");
        }
        catch (Exception ex)
        {
            await Notification.ErrorAsync(ex.Message);
        }
        _loading = false;
    }

    private async Task DownloadPdf()
    {
        if (string.IsNullOrEmpty(_employeeId))
        {
            await Notification.ErrorAsync("Seleccione un empleado.");
            return;
        }

        try
        {
            var response = await Http.GetAsync(
                $"/api/reports/payroll/payslip/pdf?employeeId={_employeeId}&year={_year}&month={_month}&period={_period}");
            if (response.IsSuccessStatusCode)
            {
                var bytes = await response.Content.ReadAsByteArrayAsync();
                var base64 = Convert.ToBase64String(bytes);
                await JS.InvokeVoidAsync("eval",
                    $"{{const a=document.createElement('a');a.href='data:application/pdf;base64,{base64}';a.download='ComprobanteNomina_{_year}_{_month:D2}_{_period}.pdf';a.click();}}");
            }
            else
            {
                await Notification.ErrorAsync("Error generando PDF");
            }
        }
        catch (Exception ex)
        {
            await Notification.ErrorAsync(ex.Message);
        }
    }

    private class PayslipData
    {
        public string EmployeeName { get; set; } = "";
        public string DocumentNumber { get; set; } = "";
        public string Position { get; set; } = "";
        public string PeriodLabel { get; set; } = "";
        public decimal BaseSalary { get; set; }
        public decimal NetPay { get; set; }
        public List<PayslipLine> Earnings { get; set; } = [];
        public List<PayslipLine> Deductions { get; set; } = [];
    }

    private class PayslipLine
    {
        public string Concept { get; set; } = "";
        public decimal? Hours { get; set; }
        public decimal Amount { get; set; }
    }

    private class EmployeeOption
    {
        public string Id { get; set; } = "";
        public string Display { get; set; } = "";
    }

    private record MonthOption(int Value, string Name);
    private record PeriodOption(int Value, string Name);
}
