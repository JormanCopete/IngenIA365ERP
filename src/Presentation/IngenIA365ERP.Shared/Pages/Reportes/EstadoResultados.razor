@page "/reportes/estado-resultados"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification
@inject IJSRuntime JS

<PageTitle>Estado de Resultados - IngenIA365ERP</PageTitle>

<div class="pagina">
    <div class="page-header">
        <h3>Estado de Resultados</h3>
        <div>
            <SfButton CssClass="e-primary" IconCss="e-icons e-search" OnClick="LoadPreview">Vista Previa</SfButton>
            <SfButton CssClass="e-info" IconCss="e-icons e-download" OnClick="DownloadPdf">PDF</SfButton>
        </div>
    </div>

    <!-- Filters -->
    <div class="toolbar">
        <div>
            <label>Ano</label>
            <SfNumericTextBox TValue="int" @bind-Value="_year" Min="2000" Max="2099" Format="####" Width="120px" CssClass="e-small" />
        </div>
        <div>
            <label>Mes</label>
            <SfDropDownList TValue="int" TItem="MonthOption" @bind-Value="_month" DataSource="_months" CssClass="e-small" Width="160px">
                <DropDownListFieldSettings Text="Name" Value="Value" />
            </SfDropDownList>
        </div>
    </div>

    @if (_loading)
    {
        <SfProgressBar Type="ProgressType.Linear" IsIndeterminate="true" Height="4"
                       TrackColor="var(--borde)" ProgressColor="var(--acento)" />
    }

    @if (_data is not null && _data.Count > 0)
    {
        <!-- Summary Cards -->
        <div class="rejilla-tarjetas">
            <div class="info-card">
                <span class="label">Total Ingresos</span>
                <span style="color:var(--exito-texto);">@_totalIncome.ToString("N2")</span>
            </div>
            <div class="info-card">
                <span class="label">Total Gastos</span>
                <span style="color:var(--peligro-texto);">@_totalExpenses.ToString("N2")</span>
            </div>
            <div class="info-card">
                <span class="label">@(_netResult >= 0 ? "Utilidad Neta" : "Perdida Neta")</span>
                <span style="color:@(_netResult >= 0 ? "var(--exito)" : "var(--peligro)");font-weight:var(--peso-fuerte);">@_netResult.ToString("N2")</span>
            </div>
        </div>

        <!-- Income Section -->
        <h4 style="color:var(--exito-texto);">Ingresos</h4>
        <SfGrid TValue="ResultLine" DataSource="@_data.Where(d => d.Section == "Ingresos").ToList()" AllowSorting="true">
            <GridColumns>
                <GridColumn Field="AccountCode" HeaderText="Cuenta" Width="140" />
                <GridColumn Field="AccountName" HeaderText="Nombre" Width="350" />
                <GridColumn Field="Amount" HeaderText="Valor" Width="180" Format="N2" TextAlign="TextAlign.Right" />
            </GridColumns>
            <GridAggregates>
                <GridAggregate>
                    <GridAggregateColumns>
                        <GridAggregateColumn Field="Amount" Type="AggregateType.Sum" Format="N2">
                            <FooterTemplate>@{ var s = context as AggregateTemplateContext; }<b>@s?.Sum</b></FooterTemplate>
                        </GridAggregateColumn>
                    </GridAggregateColumns>
                </GridAggregate>
            </GridAggregates>
        </SfGrid>

        <!-- Expenses Section -->
        <h4 style="color:var(--peligro-texto);">Gastos</h4>
        <SfGrid TValue="ResultLine" DataSource="@_data.Where(d => d.Section == "Gastos").ToList()" AllowSorting="true">
            <GridColumns>
                <GridColumn Field="AccountCode" HeaderText="Cuenta" Width="140" />
                <GridColumn Field="AccountName" HeaderText="Nombre" Width="350" />
                <GridColumn Field="Amount" HeaderText="Valor" Width="180" Format="N2" TextAlign="TextAlign.Right" />
            </GridColumns>
            <GridAggregates>
                <GridAggregate>
                    <GridAggregateColumns>
                        <GridAggregateColumn Field="Amount" Type="AggregateType.Sum" Format="N2">
                            <FooterTemplate>@{ var s = context as AggregateTemplateContext; }<b>@s?.Sum</b></FooterTemplate>
                        </GridAggregateColumn>
                    </GridAggregateColumns>
                </GridAggregate>
            </GridAggregates>
        </SfGrid>

        <!-- Net Result -->
        <div style="padding:var(--pad-lg);border:2px solid @(_netResult >= 0 ? "var(--exito)" : "var(--peligro)");border-radius:var(--radio);text-align:center;">
            <h4 style="margin:0;color:@(_netResult >= 0 ? "var(--exito)" : "var(--peligro)");">
                @(_netResult >= 0 ? "UTILIDAD NETA" : "PERDIDA NETA"): @Math.Abs(_netResult).ToString("N2")
            </h4>
        </div>
    }
    else if (!_loading && _data is not null)
    {
        <p class="texto-tenue">No se encontraron datos para el periodo seleccionado.</p>
    }
</div>

@code {
    private int _year = DateTime.Today.Year;
    private int _month = DateTime.Today.Month;
    private bool _loading;
    private List<ResultLine>? _data;
    private decimal _totalIncome;
    private decimal _totalExpenses;
    private decimal _netResult;

    private static readonly List<MonthOption> _months =
    [
        new(1, "01 - Enero"), new(2, "02 - Febrero"), new(3, "03 - Marzo"),
        new(4, "04 - Abril"), new(5, "05 - Mayo"), new(6, "06 - Junio"),
        new(7, "07 - Julio"), new(8, "08 - Agosto"), new(9, "09 - Septiembre"),
        new(10, "10 - Octubre"), new(11, "11 - Noviembre"), new(12, "12 - Diciembre")
    ];

    private async Task LoadPreview()
    {
        _loading = true;
        try
        {
            _data = await Http.GetListAsync<ResultLine>(
                $"/api/reports/accounting/income-statement?year={_year}&month={_month}");

            _totalIncome = _data?.Where(d => d.Section == "Ingresos").Sum(d => d.Amount) ?? 0;
            _totalExpenses = _data?.Where(d => d.Section == "Gastos").Sum(d => d.Amount) ?? 0;
            _netResult = _totalIncome - _totalExpenses;
        }
        catch (Exception ex)
        {
            await Notification.ErrorAsync(ex.Message);
        }
        _loading = false;
    }

    private async Task DownloadPdf()
    {
        try
        {
            var response = await Http.GetAsync(
                $"/api/reports/accounting/income-statement/pdf?year={_year}&month={_month}");
            if (response.IsSuccessStatusCode)
            {
                var bytes = await response.Content.ReadAsByteArrayAsync();
                var base64 = Convert.ToBase64String(bytes);
                await JS.InvokeVoidAsync("eval",
                    $"{{const a=document.createElement('a');a.href='data:application/pdf;base64,{base64}';a.download='EstadoResultados_{_year}_{_month:D2}.pdf';a.click();}}");
            }
            else
            {
                await Notification.ErrorAsync("Error generando PDF");
            }
        }
        catch (Exception ex)
        {
            await Notification.ErrorAsync(ex.Message);
        }
    }

    private class ResultLine
    {
        public string Section { get; set; } = "";
        public string AccountCode { get; set; } = "";
        public string AccountName { get; set; } = "";
        public decimal Amount { get; set; }
    }

    private record MonthOption(int Value, string Name);
}
