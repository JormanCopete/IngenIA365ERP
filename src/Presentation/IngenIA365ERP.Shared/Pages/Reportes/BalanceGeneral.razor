@page "/reportes/balance-general"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification
@inject IJSRuntime JS

<PageTitle>Balance General - IngenIA365ERP</PageTitle>

<div class="page-header">
    <h3>Balance General</h3>
    <div style="display:flex;gap:8px;">
        <SfButton CssClass="e-primary" IconCss="e-icons e-search" OnClick="LoadPreview">Vista Previa</SfButton>
        <SfButton CssClass="e-info" IconCss="e-icons e-download" OnClick="DownloadPdf">PDF</SfButton>
    </div>
</div>

<!-- Filters -->
<div style="display:flex;gap:12px;margin-bottom:16px;flex-wrap:wrap;align-items:end;">
    <div>
        <label>Ano</label>
        <SfNumericTextBox TValue="int" @bind-Value="_year" Min="2000" Max="2099" Format="####" Width="120px" CssClass="e-small" />
    </div>
    <div>
        <label>Mes</label>
        <SfDropDownList TValue="int" TItem="MonthOption" @bind-Value="_month" DataSource="_months" CssClass="e-small" Width="160px">
            <DropDownListFieldSettings Text="Name" Value="Value" />
        </SfDropDownList>
    </div>
    <div>
        <label>Sucursal</label>
        <SfDropDownList TValue="string" TItem="BranchOption" @bind-Value="_branch" DataSource="_branches" CssClass="e-small" Width="200px" Placeholder="Todas">
            <DropDownListFieldSettings Text="Name" Value="Code" />
        </SfDropDownList>
    </div>
</div>

@if (_loading)
{
    <SfProgressBar Type="ProgressType.Linear" IsIndeterminate="true" Height="4"
                   TrackColor="var(--borde)" ProgressColor="var(--acento)" />
}

@if (_data is not null && _data.Count > 0)
{
    <!-- Summary Cards -->
    <div style="display:flex;gap:24px;margin-bottom:16px;flex-wrap:wrap;">
        <div class="info-card">
            <span class="label">Total Activos</span>
            <span style="color:var(--exito-texto);">@_data.Where(d => d.Group == "Activos").Sum(d => d.Balance).ToString("N2")</span>
        </div>
        <div class="info-card">
            <span class="label">Total Pasivos</span>
            <span style="color:var(--peligro-texto);">@_data.Where(d => d.Group == "Pasivos").Sum(d => d.Balance).ToString("N2")</span>
        </div>
        <div class="info-card">
            <span class="label">Patrimonio</span>
            <span style="color:var(--info-texto);">@_data.Where(d => d.Group == "Patrimonio").Sum(d => d.Balance).ToString("N2")</span>
        </div>
    </div>

    <SfGrid @ref="_grid" TValue="BalanceLine" DataSource="_data" AllowPaging="true" AllowSorting="true"
            AllowGrouping="true" AllowExcelExport="true">
        <GridGroupSettings Columns="@(new[] { "Group" })" />
        <GridPageSettings PageSize="50" />
        <GridColumns>
            <GridColumn Field="Group" HeaderText="Grupo" Width="140" />
            <GridColumn Field="AccountCode" HeaderText="Cuenta" Width="140" />
            <GridColumn Field="AccountName" HeaderText="Nombre" Width="300" />
            <GridColumn Field="Balance" HeaderText="Saldo" Width="180" Format="N2" TextAlign="TextAlign.Right">
                <Template>
                    @{
                        var line = context as BalanceLine;
                        var color = line?.Balance >= 0 ? "" : "color:var(--peligro-texto);";
                    }
                    <span style="@color">@line?.Balance.ToString("N2")</span>
                </Template>
            </GridColumn>
        </GridColumns>
        <GridAggregates>
            <GridAggregate>
                <GridAggregateColumns>
                    <GridAggregateColumn Field="Balance" Type="AggregateType.Sum" Format="N2">
                        <FooterTemplate>@{ var s = context as AggregateTemplateContext; }<b>@s?.Sum</b></FooterTemplate>
                    </GridAggregateColumn>
                </GridAggregateColumns>
            </GridAggregate>
        </GridAggregates>
    </SfGrid>
}
else if (!_loading && _data is not null)
{
    <p style="color:var(--texto-tenue);">No se encontraron datos para el periodo seleccionado.</p>
}

@code {
    private SfGrid<BalanceLine>? _grid;
    private int _year = DateTime.Today.Year;
    private int _month = DateTime.Today.Month;
    private string? _branch;
    private bool _loading;
    private List<BalanceLine>? _data;

    private static readonly List<MonthOption> _months =
    [
        new(1, "01 - Enero"), new(2, "02 - Febrero"), new(3, "03 - Marzo"),
        new(4, "04 - Abril"), new(5, "05 - Mayo"), new(6, "06 - Junio"),
        new(7, "07 - Julio"), new(8, "08 - Agosto"), new(9, "09 - Septiembre"),
        new(10, "10 - Octubre"), new(11, "11 - Noviembre"), new(12, "12 - Diciembre")
    ];

    private List<BranchOption> _branches =
    [
        new("", "Todas"),
        new("001", "Principal"),
        new("002", "Sucursal Norte"),
        new("003", "Sucursal Sur")
    ];

    private async Task LoadPreview()
    {
        _loading = true;
        try
        {
            var branchParam = string.IsNullOrEmpty(_branch) ? "" : $"&branch={_branch}";
            _data = await Http.GetListAsync<BalanceLine>(
                $"/api/reports/accounting/balance-general?year={_year}&month={_month}{branchParam}");
        }
        catch (Exception ex)
        {
            await Notification.ErrorAsync(ex.Message);
        }
        _loading = false;
    }

    private async Task DownloadPdf()
    {
        try
        {
            var branchParam = string.IsNullOrEmpty(_branch) ? "" : $"&branch={_branch}";
            var response = await Http.GetAsync(
                $"/api/reports/accounting/balance-general/pdf?year={_year}&month={_month}{branchParam}");
            if (response.IsSuccessStatusCode)
            {
                var bytes = await response.Content.ReadAsByteArrayAsync();
                var base64 = Convert.ToBase64String(bytes);
                await JS.InvokeVoidAsync("eval",
                    $"{{const a=document.createElement('a');a.href='data:application/pdf;base64,{base64}';a.download='BalanceGeneral_{_year}_{_month:D2}.pdf';a.click();}}");
            }
            else
            {
                await Notification.ErrorAsync("Error generando PDF");
            }
        }
        catch (Exception ex)
        {
            await Notification.ErrorAsync(ex.Message);
        }
    }

    private class BalanceLine
    {
        public string Group { get; set; } = "";
        public string AccountCode { get; set; } = "";
        public string AccountName { get; set; } = "";
        public decimal Balance { get; set; }
    }

    private record MonthOption(int Value, string Name);
    private record BranchOption(string Code, string Name);
}

<style>
    .info-card { padding: 12px; border: 1px solid var(--borde); border-radius: 4px; min-width: 140px; }
    .info-card .label { display: block; font-size: 12px; color: var(--texto-tenue); margin-bottom: 4px; }
</style>
