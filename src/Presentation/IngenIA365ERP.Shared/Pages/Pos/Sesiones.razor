@page "/pos/sesiones"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using IngenIA365ERP.Shared.Services.Http
@using IngenIA365ERP.Shared.Services.Inventario
@using IngenIA365ERP.Shared.Services.Ventas
@inject VentasClient Ventas
@inject MediosDePagoClient Medios
@inject IngenIA365ERP.Shared.Services.Recaudo.SesionesClient SesionesDeRecaudo
@inject INotificationService Notification
@inject NavigationManager Nav

<PageTitle>Mi caja - IngenIA365ERP</PageTitle>

@* 2026-11-24 (pedido del dueño): «Mi caja» del punto de venta, igual a la de Recaudo. Sólo lo del cajero: abrir su caja (punto, caja libre y base), y
   con la caja abierta ir a vender, registrar un movimiento de caja y arquear y cerrar (/pos/sesiones/{id}/cierre, el arqueo en dos pasos). La lista de
   las cajas con sus filtros está aparte, en «Cajas del día» (/pos/cajas). Una caja tiene a lo sumo una sesión abierta y un cajero una sola (lo decide el
   servidor). Antes (feature 012, I3, T641) la lista de sesiones iba debajo de la apertura. *@
<PermissionGate Required="Inventory.CashSessions.View" MostrarAviso="true">
<div class="pagina">
    <div class="page-header">
        <h3>Mi caja</h3>
        <div class="toolbar">
            <SfButton CssClass="e-outline" IconCss="e-icons e-refresh" Disabled="@_carga.Activa" OnClick="@CargarAsync">Actualizar</SfButton>
            <a class="e-btn e-flat" href="/pos/cajas">Cajas del día</a>
            <a class="e-btn e-flat" href="/pos/cierre-del-dia">Cierre del día</a>
        </div>
    </div>

    <IndicadorDeCarga Cargando="@_carga.Activa" Texto="Buscando su caja…">
        @if (_mia is not { } m)
        {
            @if (!_carga.Activa)
            {
                <PermissionGate Required="Inventory.CashSessions.Open" MostrarAviso="true">
                    <AperturaDeCaja Puntos="@_puntos" Punto="@_punto" PuntoChanged="@ElegirPuntoAsync" EtiquetaDelPunto="Punto de venta" Cajas="@_cajas"
                                    Denominaciones="@_denominaciones" Forma="@_politica.FormaDelEfectivo" Ocupado="@_guardado.Activa"
                                    AyudaDeLaCaja="La caja donde va a cobrar hoy; las abiertas por otra persona no se pueden elegir."
                                    AyudaDeLaBase="El efectivo que recibe para dar vueltas; no es venta. Sin efectivo, deje 0."
                                    Abrir="@AbrirAsync" />
                </PermissionGate>
            }
        }
        else
        {
            <MiCajaAbierta Caja="@($"{m.PointOfSale.Name} · caja {m.CashRegister.Code}")" Dia="@m.OperatingDate" AbiertaEl="@m.OpenedAt" Base="@m.OpeningBase"
                           Movido="@($"{m.SalesCount} venta(s) por {m.SalesTotal:N0}")" EtiquetaDeLoMovido="Vendido" Esperados="@_esperados" Ciego="@_ciego"
                           UrlParaCerrar="@UrlDelCierre(m)">
                <Avisos>
                    @if (m.LinkedSessionPublicId is not null)
                    {
                        <p class="aviso aviso-info">Caja única: esta caja se abrió con su caja de Recaudo y se cierra con el arqueo de Recaudo.</p>
                    }
                    @if (!m.PointOfSale.PosEnabled)
                    {
                        <p class="texto-tenue">Este punto cobra en oficina.</p>
                    }
                </Avisos>
                <Acciones>
                    @if (m.PointOfSale.PosEnabled)
                    {
                        <PermissionGate Required="Inventory.Pos.Sell">
                            <a class="e-btn e-primary" href="/pos">Ir a vender</a>
                        </PermissionGate>
                    }
                    else
                    {
                        <a class="e-btn e-primary" href="/ventas/documentos">Ventas de oficina</a>
                    }
                    <PermissionGate Required="Inventory.CashSessions.Close">
                        @if (m.LinkedSessionPublicId is null)
                        {
                            <a class="e-btn e-outline" href="@UrlDelCierre(m)">Arquear y cerrar</a>
                        }
                        else
                        {
                            <a class="e-btn e-outline" href="/recaudo/sesiones">Cerrar en Recaudo (caja única)</a>
                        }
                    </PermissionGate>
                    <PermissionGate Required="Inventory.CashMovements.Create">
                        <a class="e-btn e-outline" href="@($"/pos/movimientos-de-caja?sesion={m.CashSessionPublicId}")">Movimiento de caja</a>
                    </PermissionGate>
                    <a class="e-btn e-flat" href="@($"/pos/sesiones/{m.CashSessionPublicId}")">Ver el detalle</a>
                </Acciones>
            </MiCajaAbierta>
        }
    </IndicadorDeCarga>
</div>
</PermissionGate>

@code {
    private readonly EstadoDeCarga _carga = new(), _guardado = new();
    private readonly ClaveDeOperacion _claveAbrir = new();
    private SesionDeCajaDto? _mia;
    private IReadOnlyList<(string Medio, decimal Esperado)>? _esperados;
    private bool _ciego;
    private PoliticaDeCaja _politica = PoliticaDeCaja.PorDefecto;
    private IReadOnlyList<OpcionDeCaja> _puntos = [], _cajas = [];
    private IReadOnlyList<DenominacionDeConteo> _denominaciones = [];
    private Guid? _punto;

    private static string UrlDelCierre(SesionDeCajaDto s) => $"/pos/sesiones/{s.CashSessionPublicId}/cierre";

    protected override Task OnInitializedAsync() => CargarAsync();

    private async Task CargarAsync()
    {
        using var carga = _carga.Iniciar();
        _politica = await SesionesDeRecaudo.PoliticaAsync();
        var mia = await Ventas.MiSesionAbiertaAsync();
        _mia = mia.IsSuccess ? mia.Value : null;
        if (!mia.IsSuccess) await Notification.ErrorAsync(mia.ErrorMessage ?? "No se pudo consultar su caja.");
        _esperados = null;
        _ciego = false;
        if (_mia is { } m)
        {
            var e = await Ventas.EsperadoAsync(m.CashSessionPublicId);
            _ciego = e is { IsSuccess: true, Value.Blind: true };
            if (e is { IsSuccess: true, Value: { Blind: false } esperado })
                _esperados = esperado.Lines.Where(l => l.Expected is not null && l.PaymentMeans.CountMethod != 4)
                    .Select(l => (l.PaymentMeans.Name, l.Expected!.Value)).ToList();
            return;
        }
        var puntos = await Ventas.ListarPuntosAsync(activos: true);
        _puntos = puntos.IsSuccess ? (puntos.Value ?? []).Select(p => new OpcionDeCaja(p.PointOfSalePublicId, $"{p.Code} · {p.Name}")).ToList() : [];
        var denominaciones = await Medios.DenominacionesAsync(DiaDeCaja.Hoy());
        _denominaciones = denominaciones.IsSuccess
            ? (denominaciones.Value ?? []).Where(d => d.IsActive).Select(d => new DenominacionDeConteo(d.CashDenominationPublicId, d.Value, d.Kind != 1)).ToList()
            : [];
        if (_puntos.Count == 1) await ElegirPuntoAsync(_puntos[0].Id);
    }

    private async Task ElegirPuntoAsync(Guid? punto)
    {
        _punto = punto;
        _cajas = [];
        if (punto is not { } p) return;
        var r = await Ventas.ListarCajasAsync(p);
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudieron consultar las cajas."); return; }
        _cajas = (r.Value ?? []).Where(c => c.IsActive).Select(c => new OpcionDeCaja(c.CashRegisterPublicId, $"{c.Code} · {c.Name}", c.OpenSession?.CashierName)).ToList();
    }

    private async Task AbrirAsync(BaseDeApertura pedido)
    {
        using var guardado = _guardado.Iniciar();
        var conteo = pedido.Billetes is { Count: > 0 } billetes ? billetes.Select(p => new ConteoDeDenominacionRequest(p.Key, p.Value)).ToList() : null;
        var r = await Ventas.AbrirSesionAsync(new AbrirSesionRequest(pedido.Caja, pedido.Billetes is null ? pedido.Valor : null, conteo), _claveAbrir);
        if (!r.IsSuccess || r.Value is null) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo abrir la caja."); return; }
        foreach (var aviso in r.Value.Warnings) await Notification.InfoAsync(aviso.Message);
        await Notification.SuccessAsync("Caja abierta.");
        if (r.Value.Session.PointOfSale.PosEnabled) Nav.NavigateTo("/pos");
        else await CargarAsync();
    }
}
