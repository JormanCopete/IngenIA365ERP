    private CampanaDeSuspendidas? _campana;

    /// <summary>
    /// 2026-11-12 (pedido del dueño): la tabla única de comandos del POS. La despachan pos.js (<see cref="Tecla"/>) y los botones de la
    /// barra de atajos (<see cref="EjecutarComandoAsync"/>); <c>Aplica</c> deshabilita el botón y vuelve muda la tecla en el modo que no
    /// corresponde. Cada tecla con acción tiene que estar reservada en pos.js (lo vigila una prueba de arquitectura).
    /// </summary>
    private TablaDeComandos _comandos = default!;

    /// <summary>2026-11-12: el diálogo de suspender se abrió desde F9 (o la campana) con una venta en curso: suspendida, abre la lista.</summary>
    private bool _luegoRecuperar;

    /// <summary>Lo último que se le dijo a pos.js sobre la tirilla en pantalla (Enter = «Nueva venta»).</summary>
    private bool _entregadaEnJs;

    private string TituloDelDialogo => _dialogo switch
    {
        Dialogo.Buscar => "Buscar producto (F2)",
        Dialogo.Cantidad => "Cantidad (F3)",
        Dialogo.Cliente => "Cliente (F4)",
        Dialogo.Vendedor => "Vendedor (F6)",
        Dialogo.Descuento => "Descuento (F7)",
        Dialogo.Suspender => _luegoRecuperar ? "Suspender y ver las suspendidas (F9)" : "Suspender la venta (F8)",
        Dialogo.Recuperar => "Recuperar una venta (F9)",
        Dialogo.Descartar => "Descartar la venta",
        Dialogo.Reimprimir => "Reimprimir la última venta",
        _ => "",
    };

    private Guid SesionId => _sesion?.CashSessionPublicId ?? Guid.Empty;

    // ---------------------------------------------- 2026-11-12: el modo de búsqueda de la cooperativa en el campo de lectura --

    /// <summary>Comercial.BusquedaDeProductos: «VentanaF2» (F2 o un código desconocido abren la búsqueda) o «EnElCampo» (la lista bajo el campo).</summary>
    private ModoDeBusquedaDeProductos _modoDeBusqueda = ModoDeBusquedaDeProductos.VentanaF2;

    private readonly EstadoDeCarga _busquedaEnLinea = new();
    private CancellationTokenSource? _esperaEnLinea;
    private List<ProductoEncontradoDto> _resultadosEnLinea = [];
    private int _marcadoEnLinea = -1;
    private bool _listaAbierta;
    private string? _mensajeEnLinea;

    private bool BuscaEnElCampo => _modoDeBusqueda == ModoDeBusquedaDeProductos.EnElCampo;

    private string PlaceholderDeLaLectura => BuscaEnElCampo ? "Lea el código, escriba 3* y lea, o escriba el nombre" : "Lea el código o escriba 3* y lea";

    private string AyudaDeLaLectura => BuscaEnElCampo
        ? "Lea el código de barras con el lector o escriba el código y Enter. «3*» antes de leer multiplica la cantidad. Si escribe parte del nombre, los productos salen bajo el campo: ↑ ↓ los recorren, Enter elige y Esc cierra la lista."
        : "Lea el código de barras con el lector o escriba el código y Enter. «3*» antes de leer multiplica la cantidad. F2 busca por nombre con lo que haya escrito aquí.";

    /// <summary>En «EnElCampo», 200 ms después de la última tecla busca lo escrito (sin el «3*») y muestra la lista bajo el campo.</summary>
    private async Task AlEscribirLaLecturaAsync()
    {
        _esperaEnLinea?.Cancel();
        // Lo marcado era de lo escrito antes: el Enter del lector que llegue antes de la búsqueda nueva es una lectura exacta.
        _marcadoEnLinea = -1;
        if (!BuscaEnElCampo || _modo != Modo.Vendiendo || _pideSerie is not null) { CerrarLaLista(); return; }
        var q = LecturaDelPos.Interpretar(_lectura).Codigo;
        if (q is not { Length: >= 2 }) { CerrarLaLista(); return; }
        _esperaEnLinea = new CancellationTokenSource();
        var token = _esperaEnLinea.Token;
        try
        {
            await Task.Delay(SelectorDeProducto.EsperaEnMilisegundos, token);
            _listaAbierta = true;
            _mensajeEnLinea = null;
            using var carga = _busquedaEnLinea.Iniciar();
            StateHasChanged();
            var r = await Inventario.BuscarProductosAsync(q, _venta?.Warehouse.PublicId, false, null, null, token, paraVenta: true,
                precio: new ContextoDePrecioDeBusqueda(Borrador: _venta?.DraftPublicId, SesionDeCaja: _venta is null ? SesionId : null));
            token.ThrowIfCancellationRequested();
            _resultadosEnLinea = r.IsSuccess ? [.. r.Value?.Items ?? []] : [];
            _marcadoEnLinea = _resultadosEnLinea.Count > 0 ? 0 : -1;
            _mensajeEnLinea = !r.IsSuccess ? r.ErrorMessage ?? "No se pudo buscar." : _resultadosEnLinea.Count == 0 ? $"Ningún producto coincide con «{q}»." : null;
        }
        catch (OperationCanceledException)
        {
            // Llegó otra tecla, o el Enter del lector: lo nuevo reemplaza a esta búsqueda.
        }
    }

    private void CerrarLaLista()
    {
        _esperaEnLinea?.Cancel();
        _listaAbierta = false;
        _resultadosEnLinea = [];
        _marcadoEnLinea = -1;
        _mensajeEnLinea = null;
    }

    /// <summary>Elegir de la lista es como leer su código, con el multiplicador de lo escrito («3*arroz») o el pendiente.</summary>
    private async Task ElegirDeLaListaAsync(ProductoEncontradoDto producto)
    {
        var lectura = LecturaDelPos.Interpretar(_lectura).ConMultiplicador(_multiplicador);
        CerrarLaLista();
        _lectura = null;
        _multiplicador = null;
        await LeerCodigoAsync(producto.Code, lectura.Error is null ? lectura.Cantidad : null);
        await EnfocarLecturaAsync();
    }

    // ------------------------------------------------------------------------------------ arranque --

    protected override void OnInitialized()
    {
        _comandos = CrearComandos();
        if (Menu is not null) Menu.Cambio += AlCambiarElMenu;
    }

    protected override async Task OnInitializedAsync()
    {
        using var carga = _arranque.Iniciar();
        var sesion = await Ventas.MiSesionAbiertaAsync();
        if (!sesion.IsSuccess) { await Notification.ErrorAsync(sesion.ErrorMessage ?? "No se pudo consultar su sesión de caja."); return; }
        _sesion = sesion.Value;
        if (_sesion is null) return;
        if (!_sesion.PointOfSale.PosEnabled) { _sinPos = true; return; }
        _modoDeBusqueda = await BusquedaDeProductos.ModoAsync();

        var punto = await Ventas.ObtenerPuntoAsync(_sesion.PointOfSale.PointOfSalePublicId);
        _caja = punto.IsSuccess ? punto.Value?.CashRegisters?.FirstOrDefault(c => c.CashRegisterPublicId == _sesion.CashRegister.PublicId) : null;

        // Feature 022 (FR-043): los billetes del catálogo para el efectivo del panel (Alt+1…); sin ellos queda «Exacto» y «Recibido».
        var billetes = await MediosDePago.DenominacionesAsync(_sesion.OperatingDate);
        if (billetes.IsSuccess && billetes.Value is not null)
            _billetes = billetes.Value.Where(b => b.Kind == 1 && b.IsActive).Select(b => b.Value).Distinct().OrderBy(v => v).ToList();

        var borradores = await Ventas.VentasDelPosAsync(sesion: SesionId);
        if (borradores.IsSuccess && borradores.Value?.FirstOrDefault(b => b.Suspended is null) is { } abierta)
            await CargarVentaAsync(abierta.DraftPublicId);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_sesion is null || _sinPos) return;
        if (!_montado)
        {
            _montado = true;
            _referencia = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("ingeniaPos.montar", _referencia, "pos-lectura");
                await RecordarCajaAsync();
            }
            catch (JSException ex)
            {
                await Notification.WarningAsync($"El teclado del POS no se pudo preparar ({ex.Message}); use los botones y el campo de lectura.");
            }
        }

        // 2026-11-12: con la tirilla en pantalla, Enter fuera del campo es «Nueva venta»; pos.js lo sabe por aquí, en un solo sitio.
        var entregada = _modo == Modo.Entregada;
        if (entregada == _entregadaEnJs) return;
        _entregadaEnJs = entregada;
        try
        {
            await JS.InvokeVoidAsync("ingeniaPos.entregada", entregada);
        }
        catch (JSException ex)
        {
            _avisoCaja ??= $"El teclado del POS no responde ({ex.Message}): tras cobrar, use el botón «Nueva venta».";
        }
    }

    /// <summary>
    /// La caja del equipo en localStorage: si la recordada no es la de la sesión, se avisa (decide el servidor: la sesión abierta del
    /// usuario manda) y se recuerda la de la sesión.
    /// </summary>
    private async Task RecordarCajaAsync()
    {
        if (_sesion is null) return;
        var recordada = await JS.InvokeAsync<string?>("ingeniaPos.leerCaja");
        var actual = _sesion.CashRegister.PublicId.ToString();
        if (!string.IsNullOrEmpty(recordada) && recordada != actual)
        {
            _avisoCaja = $"Este equipo tenía otra caja; su sesión abierta es de la caja {_sesion.CashRegister.Code} y es la que se usa.";
            StateHasChanged();
        }
        await JS.InvokeAsync<bool>("ingeniaPos.guardarCaja", actual);
    }

    private async Task CargarVentaAsync(Guid id)
    {
        var r = await Ventas.ObtenerVentaAsync(id);
        if (r.IsSuccess && r.Value is { } venta) Mostrar(venta);
    }

    private void Mostrar(VentaDelPosDto venta)
    {
        _venta = venta;
        _elegida = venta.LastLine?.LinePublicId ?? venta.Lines.OrderBy(l => l.LineNumber).LastOrDefault()?.LinePublicId;
        _cliente = venta.Customer is { IsFinalConsumer: false, PersonPublicId: { } p }
            ? new PersonSearchPicker.PersonSearchItem { PublicId = p, FullName = venta.Customer.Name }
            : null;
    }

    // --------------------------------------------------------------------------------- el teclado --

    // El POS está listo para vender (hay sesión y su punto vende en el POS), y los modos en que aplica cada comando.
    private bool Lista => _sesion is not null && !_sinPos;
    private bool Vendiendo => Lista && _modo == Modo.Vendiendo;
    private bool ConVenta => Vendiendo && _venta is not null;
    private bool PuedeEmpezar => Lista && (_modo is Modo.Vendiendo or Modo.Entregada);

    /// <summary>
    /// 2026-11-12 (pedido del dueño): los comandos del POS, en el orden de la barra (FR-059). Lo que antes era un switch en
    /// <see cref="Tecla"/> y una lista aparte en AtajosDelPos es esta tabla: la tecla y el botón hacen lo mismo y aplican en los mismos
    /// modos. Con la tirilla en pantalla, F2 y F9 empiezan la venta siguiente.
    /// </summary>
    private TablaDeComandos CrearComandos() => new(
    [
        new("F2", "buscar", BuscarAsync, () => PuedeEmpezar),
        new("F3", "cantidad", CantidadAsync, () => Vendiendo && LineaElegida is not null),
        new("F4", "cliente", () => AbrirAsync(Dialogo.Cliente), () => ConVenta),
        new("F6", "vendedor", VendedorAsync, () => ConVenta),
        new("F7", "descuento", DescuentoAsync, () => ConVenta),
        new("F8", "suspender", () => PedirSuspenderAsync(luegoRecuperar: false), () => ConVenta),
        new("F9", "recuperar", PedirSuspendidasAsync, () => PuedeEmpezar, PorQueNo: PorQueNoSuspendidas),
        new("F10", "cobrar", CobrarOEmpezarAsync, () => (Vendiendo && _venta is { Lines.Count: > 0 }) || (Lista && _modo == Modo.Cobrando)),
        new("Delete", "quitar línea", QuitarLineaAsync, () => Vendiendo && LineaElegida is not null && !_mostrarDialogo, TeclaVisible: "Supr"),
        new("Enter", "nueva venta", NuevaVentaAsync, () => Lista && _modo == Modo.Entregada && !_mostrarDialogo),
        new("Escape", "volver", EscapeAsync, () => Lista, TeclaVisible: "Esc"),
        ComandoDeTeclado.Pista("3*", "multiplica"),
        new("Ctrl+Alt+M", "movimiento de caja", () => IrAsync("/pos/movimientos-de-caja"), () => Lista),
        new("Ctrl+Alt+C", "cerrar caja", () => IrAsync($"/pos/sesiones/{SesionId}/cierre"), () => Lista),
        new("Ctrl+Alt+R", "reimprimir", () => AbrirConMotivoAsync(Dialogo.Reimprimir), () => Lista && _ultimoDocumento is not null),
        new("Ctrl+Alt+D", "descartar venta", () => AbrirConMotivoAsync(Dialogo.Descartar), () => ConVenta),
    ]);

    /// <summary>Lo que avisa pos.js: una tecla reservada.</summary>
    [JSInvokable]
    public Task Tecla(string tecla) => InvokeAsync(async () =>
    {
        if (_sesion is null || _sinPos) return;
        // 2026-11-12: con el menú abierto la venta está tapada: Esc cierra el menú y ninguna otra tecla llega a ella.
        if (MenuAbierto)
        {
            if (tecla == "Escape") Menu!.Cerrar();
            return;
        }
        await EjecutarComandoAsync(tecla);
        StateHasChanged();
    });

    /// <summary>El despachador único de los comandos: lo llaman la tecla (<see cref="Tecla"/>), los botones de la barra y la campana.</summary>
    private async Task EjecutarComandoAsync(string tecla)
    {
        var r = await _comandos.EjecutarAsync(tecla);
        if (r is { Estado: EstadoDeComando.NoAplica, Aviso: { } aviso }) await Notification.WarningAsync(aviso);
    }

    /// <summary>Lo que avisa pos.js: una ráfaga del lector que cayó fuera del campo de lectura.</summary>
    [JSInvokable]
    public Task Lector(string texto) => InvokeAsync(async () =>
    {
        if (_sesion is null || _sinPos) return;
        // 2026-11-12: una lectura con el menú abierto es para vender: se cierra el menú y la lectura sigue.
        if (MenuAbierto) Menu!.Cerrar();
        if (_mostrarDialogo) return;
        // 2026-11-12: con la tirilla en pantalla, la lectura es el primer producto de la venta siguiente (no se pierde).
        if (_modo == Modo.Entregada) NuevaVenta();
        if (_modo != Modo.Vendiendo) return;
        _lectura = texto;
        await LeerLoEscritoAsync();
        StateHasChanged();
    });

    private async Task BuscarAsync()
    {
        if (_modo == Modo.Entregada) NuevaVenta(enfocar: false);
        // 2026-11-12 (S1): en «EnElCampo» F2 sólo trae el foco al campo de lectura (la lista sale ahí mismo); en «VentanaF2», la búsqueda.
        if (BuscaEnElCampo) { await EnfocarLecturaAsync(); return; }
        _textoBuscado = string.IsNullOrWhiteSpace(_lectura) ? null : _lectura.Trim();
        _lectura = null;
        await AbrirAsync(Dialogo.Buscar);
    }

    private async Task CantidadAsync()
    {
        if (LineaElegida is not { } linea) return;
        _cantidad = linea.Quantity;
        await AbrirAsync(Dialogo.Cantidad);
    }

    private async Task VendedorAsync()
    {
        await VendedoresAsync();
        await AbrirAsync(Dialogo.Vendedor);
    }

    private async Task DescuentoAsync()
    {
        _porcentaje = null;
        _valorDescuento = null;
        _precio = null;
        _volverAlPrecioDeLista = false;
        _descuentoDeLinea = LineaElegida is not null;
        await AbrirAsync(Dialogo.Descuento);
    }

    private async Task PedirSuspenderAsync(bool luegoRecuperar)
    {
        _rotulo = null;
        _luegoRecuperar = luegoRecuperar;
        await AbrirAsync(Dialogo.Suspender);
    }

    /// <summary>
    /// F9 o la campana. 2026-11-12: con la tirilla en pantalla empieza la venta siguiente; con una venta en curso ya no se queda callado:
    /// ofrece suspenderla y abrir la lista (el diálogo de F8 con su aviso). Sin venta, la lista.
    /// </summary>
    private async Task PedirSuspendidasAsync()
    {
        if (_modo == Modo.Entregada) NuevaVenta(enfocar: false);
        if (_venta is not null)
        {
            await PedirSuspenderAsync(luegoRecuperar: true);
            return;
        }
        await AbrirSuspendidasAsync();
    }

    private string? PorQueNoSuspendidas() => !Lista ? null : _modo switch
    {
        Modo.Cobrando => "Está cobrando: confirme la venta o vuelva a ella (Esc) antes de ver las suspendidas.",
        Modo.Esperando => "La venta espera una aprobación: termine con ella antes de ver las suspendidas.",
        _ => null,
    };

    private Task CobrarOEmpezarAsync() => _modo == Modo.Cobrando ? CobrarAsync() : EmpezarACobrarAsync();

    private Task NuevaVentaAsync()
    {
        NuevaVenta();
        return Task.CompletedTask;
    }

    private Task IrAsync(string ruta)
    {
        Nav.NavigateTo(ruta);
        return Task.CompletedTask;
    }

    private Task AbrirConMotivoAsync(Dialogo dialogo)
    {
        _motivo = null;
        return AbrirAsync(dialogo);
    }

    private LineaDelPosDto? LineaElegida => _venta?.Lines.FirstOrDefault(l => l.LinePublicId == _elegida);

    private async Task AlPulsarAsync(KeyboardEventArgs e)
    {
        if (_listaAbierta && _resultadosEnLinea.Count > 0 && (e.Key == "ArrowUp" || e.Key == "ArrowDown"))
        {
            _marcadoEnLinea = Math.Clamp(_marcadoEnLinea + (e.Key == "ArrowUp" ? -1 : 1), 0, _resultadosEnLinea.Count - 1);
            return;
        }
        if (e.Key == "ArrowUp" || e.Key == "ArrowDown") { MoverEleccion(e.Key == "ArrowUp" ? -1 : 1); return; }
        if (e.Key != "Enter") return;
        if (_listaAbierta && _modo == Modo.Vendiendo && _marcadoEnLinea >= 0 && _marcadoEnLinea < _resultadosEnLinea.Count)
        {
            await ElegirDeLaListaAsync(_resultadosEnLinea[_marcadoEnLinea]);
            return;
        }
        // El Enter del lector llega antes que la búsqueda por nombre: la lectura exacta manda.
        CerrarLaLista();
        if (_modo == Modo.Entregada)
        {
            // 2026-11-12: lo que se escribió o leyó en el campo con la tirilla en pantalla es el primer producto de la venta siguiente.
            var escrito = _lectura;
            NuevaVenta();
            if (string.IsNullOrWhiteSpace(escrito)) return;
            _lectura = escrito;
            await LeerLoEscritoAsync();
            return;
        }
        if (_modo == Modo.Cobrando)
        {
            // Feature 022: las teclas de los medios se pulsan en la barra de medios del panel.
            _lectura = null;
            if (_panel is not null) await _panel.EnfocarAsync();
            return;
        }
        await LeerLoEscritoAsync();
    }

    private void MoverEleccion(int paso)
    {
        if (_venta is not { Lines.Count: > 0 } v) return;
        var lineas = v.Lines.OrderBy(l => l.LineNumber).ToList();
        var i = lineas.FindIndex(l => l.LinePublicId == _elegida);
        _elegida = lineas[Math.Clamp(i < 0 ? lineas.Count - 1 : i + paso, 0, lineas.Count - 1)].LinePublicId;
    }

    // ------------------------------------------------------------------------------------ vender --

    private async Task LeerLoEscritoAsync()
    {
        // I6 (T941): si el último producto leído controla serie, esta lectura es su serie.
        if (_pideSerie is { } producto && !string.IsNullOrWhiteSpace(_lectura))
        {
            var serie = _lectura.Trim();
            _lectura = null;
            await LeerCodigoAsync(serie, null);
            if (_pideSerie == producto) _pideSerie = null;
            return;
        }
        var lectura = LecturaDelPos.Interpretar(_lectura).ConMultiplicador(_multiplicador);
        _lectura = null;
        if (lectura.Error is { } error) { await Notification.WarningAsync(error); return; }
        if (lectura.EsSoloMultiplicador) { _multiplicador = lectura.Cantidad; return; }
        if (lectura.Codigo is not { } codigo) return;
        _multiplicador = null;
        await LeerCodigoAsync(codigo, lectura.Cantidad);
    }

    private async Task LeerCodigoAsync(string codigo, decimal? cantidad)
    {
        using var trabajo = _trabajo.Iniciar();
        // I6 (T941): la serie leída viaja como código: el servidor reconoce una serie en existencia y agrega su unidad.
        var r = _venta is null
            ? await Ventas.AbrirVentaAsync(new AbrirVentaRequest(SesionId, new PrimeraLecturaRequest(codigo, cantidad)), _claveAbrir)
            : await Ventas.LeerAsync(_venta.DraftPublicId, new LecturaRequest(codigo, Quantity: cantidad), _claveLectura);
        if (r.IsSuccess && r.Value is { } venta) { _pideSerie = null; Mostrar(venta); return; }
        switch (r.ErrorCode)
        {
            case "Inventory.Serial.Required":
                // I6 (T941): pedir la serie sin ratón: la siguiente lectura va como serie de este producto.
                _pideSerie = codigo;
                break;
            case "Inventory.Product.NotFound" when BuscaEnElCampo:
                // «EnElCampo»: el código desconocido queda en el campo y la lista busca con él.
                await Notification.WarningAsync($"«{codigo}» no es un código conocido: elíjalo de la lista o escriba el nombre.");
                _lectura = codigo;
                _ = AlEscribirLaLecturaAsync();
                break;
            case "Inventory.Product.NotFound":
                await Notification.WarningAsync($"«{codigo}» no es un código conocido: búsquelo.");
                _textoBuscado = codigo;
                await AbrirAsync(Dialogo.Buscar);
                break;
            case "Inventory.Pos.NotEnabled":
                _sinPos = true;
                break;
            default:
                await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo leer el producto.");
                break;
        }
    }

    private async Task ProductoElegidoAsync(ProductoElegido elegido)
    {
        _mostrarDialogo = false;
        var codigo = elegido.Empaque is not null ? elegido.Producto.MatchedBarcode ?? elegido.Producto.Code : elegido.Producto.Code;
        var cantidad = _multiplicador;
        _multiplicador = null;
        await LeerCodigoAsync(codigo, cantidad);
    }

    private async Task CambiarCantidadAsync()
    {
        if (_venta is null || LineaElegida is not { } linea || _cantidad is not > 0) return;
        await CambiarLineaAsync(linea.LinePublicId, new LineaRequest(Quantity: _cantidad));
    }

    private async Task AplicarDescuentoAsync()
    {
        if (_venta is null) return;
        var descuento = _porcentaje is > 0 ? new DescuentoRequest(Percent: _porcentaje / 100m) : _valorDescuento is > 0 ? new DescuentoRequest(Amount: _valorDescuento) : null;
        if (_descuentoDeLinea && LineaElegida is { } linea)
        {
            await CambiarLineaAsync(linea.LinePublicId, new LineaRequest(UnitPrice: _volverAlPrecioDeLista ? null : _precio, Discount: descuento,
                ClearUnitPrice: _volverAlPrecioDeLista ? true : null));
            return;
        }
        await CambiarCabeceraAsync(new CabeceraDeVentaRequest(DocumentDiscount: descuento ?? new DescuentoRequest(Percent: 0m)));
    }

    private async Task CambiarLineaAsync(Guid linea, LineaRequest request)
    {
        if (_venta is null) return;
        using var trabajo = _trabajo.Iniciar();
        var r = await Ventas.CambiarLineaAsync(_venta.DraftPublicId, linea, request, _claveLinea);
        if (!r.IsSuccess || r.Value is null) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo cambiar la línea."); return; }
        Mostrar(r.Value);
        _elegida = linea;
        _mostrarDialogo = false;
    }

    private async Task QuitarLineaAsync()
    {
        if (_venta is null || LineaElegida is not { } linea) return;
        using var trabajo = _trabajo.Iniciar();
        var r = await Ventas.QuitarLineaAsync(_venta.DraftPublicId, linea.LinePublicId, _claveLinea);
        if (!r.IsSuccess || r.Value is null) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo quitar la línea."); return; }
        Mostrar(r.Value);
    }

    private async Task<bool> CambiarCabeceraAsync(CabeceraDeVentaRequest request)
    {
        if (_venta is null) return false;
        using var trabajo = _trabajo.Iniciar();
        var r = await Ventas.CambiarCabeceraAsync(_venta.DraftPublicId, request, _claveCabecera);
        if (!r.IsSuccess || r.Value is null) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo cambiar la venta."); return false; }
        Mostrar(r.Value);
