@page "/pos"
@layout PosLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using IngenIA365ERP.Shared.Services.Http
@using IngenIA365ERP.Shared.Services.Inventario
@using IngenIA365ERP.Shared.Services.Ventas
@using IngenIA365ERP.Shared.Services.Teclado
@inject VentasClient Ventas
@inject InventarioClient Inventario
@inject IImpresionDeDocumentos Impresion
@inject INotificationService Notification
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject MediosDePagoClient MediosDePago
@inject HttpClient Http
@inject BusquedaDeProductosDeLaCooperativa BusquedaDeProductos
@implements IAsyncDisposable

<PageTitle>Punto de venta - IngenIA365ERP</PageTitle>

@* Feature 012, I3 (T640, T645; FR-019, FR-054, FR-058, FR-059, SC-004, SC-008; contracts/api.md §20.2–§20.3): la venta en el punto de
   venta, sin ratón. El campo de lectura está siempre enfocado: Enter lee el código exacto (de barras, de empaque o de producto), «3*»
   multiplica y un código desconocido abre la búsqueda. Cada lectura es UNA petición y la venta vive en el servidor desde la primera,
   ligada a la sesión abierta del usuario, que se busca al arrancar. La caja del equipo se recuerda en localStorage (con try/catch; decide
   el servidor). Tres pasos: cobrar (F10 abre el panel), confirmar (F10 otra vez) y entregar la tirilla. Un descuento sobre el tope o una
   política dejan la venta esperando: se consulta cada 2 s o decide el aprobador presente. Un punto sin POS cobra en oficina (FR-058).
   I6 (T941; FR-026, US15-2, US15-4, US15-5): cada línea muestra su lote asignado (el que vence primero, cambiable con SelectorDeLote en la
   línea elegida) y si está vencido; un producto con serie deja la lectura esperando la serie (Inventory.Serial.Required): la siguiente
   lectura del lector —por el campo o por la ráfaga de pos.js— es la serie de la unidad, y Esc la cancela; un lote vencido con Bloquear lo
   rechaza el servidor (Inventory.Lot.Expired) y con Advertir sale con aviso; un combo es una sola línea que al confirmar descuenta sus
   componentes.
   2026-11-12 (revisión comercial, pedido del dueño): (1) cerrada la venta, la tirilla queda a la derecha con «Nueva venta» enfocado
   (después de imprimir el foco vuelve de la impresión); Enter o Esc desde cualquier parte —salvo otro botón o un diálogo— dejan la
   pantalla limpia para la siguiente, y una lectura del lector con la tirilla en pantalla empieza la venta siguiente con ese producto.
   (2) La pantalla cabe en la ventana: las líneas y la columna derecha (con la tirilla) se desplazan por dentro y la barra de atajos
   queda siempre abajo; bajo 900 px, una sola columna que se desplaza con el campo de lectura fijo arriba. (3) Los atajos son botones
   de una sola tabla de comandos (_comandos: tecla, rótulo, acción y cuándo aplica) que usan por igual pos.js y la barra: no pueden
   decir cosas distintas, y el botón se deshabilita cuando el comando no aplica. (4) La campana cuenta las suspendidas de esta caja y
   abre la lista como F9; con una venta en curso, F9 ofrece suspenderla y abrir la lista en vez de no hacer nada. (5) El botón de menú
   abre el menú lateral de PosLayout sobre la venta: mientras está abierto la venta queda inerte, Esc cierra el menú primero y ninguna
   otra tecla llega a la venta; al cerrarlo el foco vuelve a donde trabaja la caja. *@
<div class="pos-pantalla" inert="@MenuAbierto">
<div class="pos-barra">
    @if (Menu is { } menu)
    {
        <button type="button" class="pos-boton-barra" title="Menú de la aplicación" aria-label="Abrir el menú de la aplicación" aria-controls="pos-menu"
                aria-expanded="@(menu.Abierto ? "true" : "false")" @onclick="menu.Alternar">
            <span class="e-icons e-menu" aria-hidden="true"></span>
        </button>
    }
    <span class="pos-marca">Punto de venta</span>
    <span class="pos-contexto">
        @if (_sesion is { } s)
        {
            @($"{s.PointOfSale.Code} · {s.PointOfSale.Name} — caja {s.CashRegister.Code} — {s.Cashier.Name} — {s.OperatingDate:dd/MM/yyyy}")
        }
    </span>
    @if (_venta?.Customer is { } cliente)
    {
        <span>Cliente: @cliente.Name</span>
    }
    @if (_venta?.Salesperson is { } vendedor)
    {
        <span>Vendedor: @vendedor.Name</span>
    }
    @if (_sesion is not null && !_sinPos)
    {
        <PermissionGate Required="Inventory.Pos.Sell">
            <CampanaDeSuspendidas @ref="_campana" Sesion="@SesionId" Abrir="@(() => EjecutarComandoAsync("F9"))" />
        </PermissionGate>
    }
    <a class="e-btn e-flat" href="/pos/sesiones">Caja</a>
</div>

<PermissionGate Required="Inventory.Pos.Sell" MostrarAviso="true">
<div class="pos-contenido">
    <IndicadorDeCarga Cargando="@_arranque.Activa" Texto="Buscando su sesión de caja…">
        @if (_sinPos)
        {
            <div class="aviso aviso-info">
                <p>El punto @(_sesion?.PointOfSale.Name) no vende en el POS: cobra en oficina.</p>
                <a class="e-btn e-primary" href="/ventas/documentos">Ir a las ventas de oficina</a>
            </div>
        }
        else if (!_arranque.Activa && _sesion is null)
        {
            <div class="aviso aviso-alerta">
                <p>No tiene una sesión de caja abierta. Abra la caja para vender.</p>
                <a class="e-btn e-primary" href="/pos/sesiones">Abrir la caja</a>
            </div>
        }
        else if (_sesion is not null)
        {
            @if (_avisoCaja is not null)
            {
                <p class="aviso aviso-info">@_avisoCaja</p>
            }
            <div class="pos-venta">
                <div class="pos-columna">
                    <div class="pos-lectura">
                        <label class="campo campo-ancho">
                            Lectura
                            @if (_multiplicador is { } x) { <span class="pos-multiplicador"> × @x.ToString("0.####")</span> }
                            <input id="pos-lectura" class="e-input" autocomplete="off" data-ayuda="@AyudaDeLaLectura" @bind="_lectura" @bind:event="oninput" @bind:after="AlEscribirLaLecturaAsync" data-enter="propio" @onkeydown="@AlPulsarAsync"
                                   disabled="@(_modo is Modo.Esperando or Modo.Cobrando)" aria-expanded="@(_listaAbierta ? "true" : "false")"
                                   placeholder="@(_pideSerie is { } ps ? $"Lea la serie de {ps}" : PlaceholderDeLaLectura)" />
                        </label>
                        @if (_listaAbierta)
                        {
                            @* 2026-11-12: en el modo «EnElCampo» de la cooperativa, los resultados por nombre salen bajo el campo (↑ ↓ Enter Esc). *@
                            <IndicadorDeCarga Cargando="@_busquedaEnLinea.Activa" Compacto="true" Texto="Buscando…">
                                <ResultadosDeProducto Id="pos-resultados" Mensaje="@_mensajeEnLinea" Resultados="@_resultadosEnLinea" Marcado="@_marcadoEnLinea"
                                                      ConPrecio="true" ConDisponible="@(_venta is not null)" Elegir="@ElegirDeLaListaAsync" />
                            </IndicadorDeCarga>
                        }
                    </div>
                    <div class="pos-desplazable">
                    <IndicadorDeCarga Cargando="@_trabajo.Activa" Texto="…" Compacto="true">
                        @if (_pideSerie is { } pide)
                        {
                            @* I6 (T941): el producto controla serie: la siguiente lectura es su serie, sin tocar el ratón. Esc la cancela. *@
                            <p class="aviso aviso-info">@pide controla serie: lea la serie de la unidad (Esc cancela).</p>
                        }
                        @if (_venta is { Lines.Count: > 0 } v)
                        {
                            <LineasDeVenta Lineas="@v.Lines" @bind-Elegida="_elegida" Ultima="@v.LastLine?.LinePublicId" />
                            @if (LineaElegida is { TracksLot: true, SerialNumber: null } conLote && _modo == Modo.Vendiendo)
                            {
                                @* I6 (T941): el lote de la línea elegida, visible y cambiable (el vencido con Bloquear lo rechaza el servidor). *@
                                <div class="toolbar">
                                    <SelectorDeLote Producto="@conLote.Product.PublicId" Bodega="@_venta?.Warehouse.PublicId" ControlaLote="true"
                                                    Lote="@conLote.LotCode" LoteChanged="@(lote => CambiarLineaAsync(conLote.LinePublicId, new LineaRequest(LotCode: lote)))" />
                                </div>
                            }
                        }
                        else if (_modo is Modo.Vendiendo)
                        {
                            <p class="texto-tenue">Lea el primer producto para empezar la venta.</p>
                        }
                        @if (_venta?.Warnings is { Count: > 0 } avisos)
                        {
                            <ul class="aviso aviso-alerta">@foreach (var a in avisos) { <li>@a.Message</li> }</ul>
                        }
                        @if (_venta is { PendingApprovals.Count: > 0 } pendiente && _modo == Modo.Vendiendo)
                        {
                            <AprobacionEnCaja VentaId="@pendiente.DraftPublicId" Pendientes="@pendiente.PendingApprovals" Resuelta="@AprobacionResueltaAsync" />
                        }
                    </IndicadorDeCarga>
                    @* I4 (T758): las ventas de esta sesión que esperan la validación de la DIAN, para imprimirlas o enviarlas al validarse. Van al
                       final de las líneas, dentro de lo que se desplaza: así nunca empujan la barra de atajos fuera de la pantalla. *@
                    <PendientesDeEntrega @ref="_pendientes" Sesion="@SesionId" Formato="@FormatoDeTirilla" />
                    </div>
                </div>

                <div class="pos-columna pos-desplazable">
                    @if (_modo == Modo.Entregada && _resultado is { } res)
                    {
                        <div class="pos-total">
                            <div class="pos-renglon"><span>Venta</span><span>@res.Prefix@res.Number</span></div>
                            <div class="pos-renglon"><span>Total</span><span class="pos-a-pagar">@res.Total.ToString("N0")</span></div>
                            @if (res.Change > 0m) { <div class="pos-renglon pos-vueltas"><span>Vueltas</span><span>@res.Change.ToString("N0")</span></div> }
                        </div>
                        @* «Nueva venta» arriba de la tirilla: con el foco en él, una tirilla larga se desplaza sin esconder el botón. *@
                        <div class="toolbar">
                            <SfButton id="pos-nueva-venta" CssClass="e-primary" OnClick="@(() => EjecutarComandoAsync("Enter"))">Nueva venta (Enter)</SfButton>
                            @if (_tirilla is not null) { <SfButton CssClass="e-outline" OnClick="@ImprimirAsync">Imprimir</SfButton> }
                        </div>
                        @if (_tirilla is not null)
                        {
                            <TirillaDeVenta Tirilla="@_tirilla" />
                        }
                        else
                        {
                            <p class="aviso aviso-info">La venta quedó confirmada; su entrega espera la validación. Queda en «pendientes de entrega» de la caja.</p>
                        }
                    }
                    else if (_modo == Modo.Esperando && _resultado is { } espera)
                    {
                        <AprobacionEnCaja VentaId="@espera.DocumentPublicId" SolicitudDelDocumento="@espera.ApprovalRequestPublicId"
                                          Pendientes="@(_venta?.PendingApprovals ?? [])" Resuelta="@CobroAprobadoAsync" />
                    }
                    else
                    {
                        <div class="pos-total">
                            <div class="pos-renglon"><span>Subtotal</span><span>@(_venta?.Totals.Subtotal.ToString("N0") ?? "0")</span></div>
                            <div class="pos-renglon"><span>Descuentos</span><span>@(_venta?.Totals.DiscountTotal.ToString("N0") ?? "0")</span></div>
                            <div class="pos-renglon"><span>Impuestos</span><span>@(_venta?.Totals.TaxTotal.ToString("N0") ?? "0")</span></div>
                            <div class="pos-renglon"><span>A pagar</span><span class="pos-a-pagar">@(_venta?.Totals.AmountDue.ToString("N0") ?? "0")</span></div>
                        </div>
                        @if (_modo == Modo.Cobrando)
                        {
                            <p class="aviso aviso-info">Registrando los pagos: Esc vuelve a la venta sin perderlos.</p>
                        }
                    }
                </div>
            </div>
        }
    </IndicadorDeCarga>
</div>

<AtajosDelPos Comandos="@_comandos" Ejecutar="@EjecutarComandoAsync" />

@* 2026-11-09 (pedido del dueño): el cobro en popup. F10 lo abre y, abierto, cierra la venta; Esc vuelve a la venta con los pagos
   registrados (los dos los atrapa pos.js y llegan por Tecla). La evaluación del crédito va bajo los datos del pago a crédito. *@
@if (_venta is { } cobrar)
{
    <DialogoDeCobro Visible="@(_modo == Modo.Cobrando)" Titulo="@($"Medios de pago · venta {cobrar.Customer.Name}")" IdConfirmar="pos-confirmar"
                    PuedeConfirmar="@(_cobro.Problema(!cobrar.Customer.IsFinalConsumer) is null)" Ocupado="@_trabajo.Activa" AtiendeEscape="false"
                    Confirmar="@CobrarAsync" Volver="@VolverAVender" Abierto="@EnfocarPanelAsync">
        <PanelDeMediosDePago @ref="_panel" Cobro="@_cobro" Medios="@_medios" Cambio="@StateHasChanged" Billetes="@_billetes" Bancos="@_bancos"
                             ClienteIdentificado="@(!cobrar.Customer.IsFinalConsumer)" IdConfirmar="pos-confirmar">
            <DetalleDelPago Context="pago">
                <EvaluacionDeCredito Pago="@pago" Cliente="@(cobrar.Customer.IsFinalConsumer ? null : cobrar.Customer.PersonPublicId)" Cambio="@StateHasChanged"
                                     PuntoDeVenta="@_sesion?.PointOfSale.PointOfSalePublicId" TipoDeDocumento="@cobrar.DocumentType.PublicId" Fecha="@cobrar.OperationDate" />
            </DetalleDelPago>
        </PanelDeMediosDePago>
    </DialogoDeCobro>
}

@* ------------------------------------------------------------------------------------ diálogos --*@
<SfDialog @bind-Visible="_mostrarDialogo" Header="@TituloDelDialogo" Width="620px" IsModal="true" ShowCloseIcon="true" Closed="@EnfocarSegunElModoAsync">
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@_trabajo.Activa" Texto="…">
                <div data-zona-teclado>
                @switch (_dialogo)
                {
                    case Dialogo.Buscar:
                        <SelectorDeProducto Modo="ModoDeBusquedaDeProductos.EnElCampo" Etiqueta="Producto" Bodega="@_venta?.Warehouse.PublicId" Elegido="@ProductoElegidoAsync" TextoInicial="@_textoBuscado" AutoEnfocar="true"
                                            Precio="@(new ContextoDePrecioDeBusqueda(Borrador: _venta?.DraftPublicId, SesionDeCaja: _venta is null ? SesionId : null))" />
                        break;
                    case Dialogo.Cantidad:
                        <label class="campo">Cantidad <input id="pos-dialogo" class="e-input numero" type="number" min="0" step="any" @bind="_cantidad" data-ayuda="La cantidad de la línea elegida. Enter lleva a «Aplicar» y otro Enter la cambia." /></label>
                        <div class="toolbar"><SfButton CssClass="e-primary" OnClick="@CambiarCantidadAsync">Aplicar</SfButton></div>
                        break;
                    case Dialogo.Cliente:
                        <ClienteDelPos Seleccionado="@_cliente" SeleccionadoChanged="@CambiarClienteAsync" />
                        <label class="campo-check"><input type="checkbox" data-ayuda="Marque si el comprador pide factura electrónica a su nombre en vez del documento equivalente." checked="@(_venta?.DocumentType.Role == TextosDeVentas.RolFacturaAPedido)" @onchange="@(e => CambiarRolAsync(e.Value is true))" /> El comprador pide factura</label>
                        break;
                    case Dialogo.Vendedor:
                        <label class="campo">Vendedor
                            <select class="e-input" data-ayuda="Quien hizo la venta. Escriba la primera letra del nombre para buscarlo." @onchange="@(e => CambiarVendedorAsync(e.Value?.ToString()))">
                                <option value="">Sin vendedor</option>
                                @foreach (var v in _vendedores) { <option value="@v.SalespersonPublicId" selected="@(_venta?.Salesperson?.SalespersonPublicId == v.SalespersonPublicId)">@v.Person.Name</option> }
                            </select>
                        </label>
                        break;
                    case Dialogo.Descuento:
                        <label class="campo-check"><input type="radio" name="alcance" data-ayuda="El descuento se aplica sólo a la línea elegida." checked="@_descuentoDeLinea" @onchange="@(() => _descuentoDeLinea = true)" /> A la línea elegida</label>
                        <label class="campo-check"><input type="radio" name="alcance" data-ayuda="El descuento se aplica al total de la venta." checked="@(!_descuentoDeLinea)" @onchange="@(() => _descuentoDeLinea = false)" /> Al total</label>
                        <div class="form-grid">
                            <label class="campo">Porcentaje <input id="pos-dialogo" class="e-input numero" type="number" min="0" max="100" step="any" @bind="_porcentaje" data-ayuda="El descuento en porcentaje (de 0 a 100). Use este o el valor, no los dos." /></label>
                            <label class="campo">o valor <input class="e-input numero" type="number" min="0" step="any" @bind="_valorDescuento" data-ayuda="El descuento en pesos. Use este o el porcentaje, no los dos." /></label>
                            @if (_descuentoDeLinea)
                            {
                                <label class="campo">Precio digitado <input class="e-input numero" type="number" min="0" step="any" @bind="_precio" data-ayuda="Un precio digitado reemplaza el de la lista; bajo el tope pide aprobación." /></label>
                                <label class="campo-check"><input type="checkbox" @bind="_volverAlPrecioDeLista" data-ayuda="Quita el precio digitado y vuelve al de la lista que aplica." /> Volver al precio de la lista</label>
                            }
                        </div>
                        <p class="texto-tenue">Sobre su tope, la línea queda esperando la aprobación de alguien con un tope suficiente.</p>
                        <div class="toolbar"><SfButton CssClass="e-primary" OnClick="@AplicarDescuentoAsync">Aplicar</SfButton></div>
                        break;
                    case Dialogo.Suspender:
                        @if (_luegoRecuperar)
                        {
                            @* 2026-11-12: F9 (o la campana) con una venta en curso no se queda callado: ofrece suspenderla y abrir la lista. *@
                            <p class="aviso aviso-info">Hay una venta en curso. Para ver las suspendidas, suspéndala aquí o termínela primero; Esc la deja como está.</p>
                        }
                        <label class="campo campo-ancho">Rótulo <input id="pos-dialogo" class="e-input" @bind="_rotulo" maxlength="60" placeholder="Para reconocerla al recuperarla" data-ayuda="Un nombre corto para reconocer la venta al recuperarla con F9 (el cliente, la mesa…)." /></label>
                        <div class="toolbar"><SfButton CssClass="e-primary" OnClick="@SuspenderAsync">@(_luegoRecuperar ? "Suspender y ver las suspendidas" : "Suspender")</SfButton></div>
                        break;
                    case Dialogo.Recuperar:
                        @if (_suspendidas.Count == 0)
                        {
                            <p class="texto-tenue">No hay ventas suspendidas en este punto.</p>
                        }
                        @* Feature 022 (FR-062): la lista se recorre con ↑ ↓ y Enter recupera la marcada. 2026-11-12: primero las de esta caja (las
                           que cuenta la campana) y después las del resto del punto, que también se recuperan aquí; al abrirla se marca la primera. *@
                        <ul id="pos-dialogo" class="lista-de-busqueda" role="listbox" tabindex="0" aria-label="Ventas suspendidas" data-enter="propio"
                            data-prevenir="ArrowUp ArrowDown Enter" @onkeydown="TeclaEnSuspendidasAsync"
                            data-ayuda="↑ ↓ recorren las ventas suspendidas del punto, primero las de esta caja; Enter recupera la marcada en esta caja.">
                            @for (var i = 0; i < _suspendidas.Count; i++)
                            {
                                var indice = i;
                                var suspendida = _suspendidas[i];
                                var deEstaCaja = DeEstaCaja(suspendida);
                                if (indice == 0 && deEstaCaja)
                                {
                                    <li role="presentation" class="lista-de-busqueda-grupo">De esta caja</li>
                                }
                                else if (!deEstaCaja && (indice == 0 || DeEstaCaja(_suspendidas[indice - 1])))
                                {
                                    <li role="presentation" class="lista-de-busqueda-grupo">De otras cajas del punto</li>
                                }
                                <li role="option" aria-selected="@(indice == _marcadaSuspendida ? "true" : "false")" @onclick="@(() => RecuperarAsync(suspendida.DraftPublicId))">
                                    <span class="principal">@(suspendida.Suspended?.Label ?? "Sin rótulo")</span>
                                    <span class="secundario">@suspendida.Suspended?.SuspendedByName · @suspendida.Suspended?.SuspendedAt?.ToLocalTime().ToString("HH:mm")@(deEstaCaja || string.IsNullOrEmpty(suspendida.CashierName) ? null : $" · caja de {suspendida.CashierName}")</span>
                                    <span class="derecha">@suspendida.Lines línea(s) · @suspendida.Total.ToString("N0")</span>
                                </li>
                            }
                        </ul>
                        break;
                    case Dialogo.Descartar:
                        <label class="campo campo-ancho">Motivo * <input id="pos-dialogo" class="e-input" @bind="_motivo" maxlength="300" data-ayuda="El motivo queda en la auditoría." /></label>
                        <div class="toolbar"><SfButton CssClass="e-primary" Disabled="@string.IsNullOrWhiteSpace(_motivo)" OnClick="@DescartarAsync">Descartar la venta</SfButton></div>
                        break;
                    case Dialogo.Reimprimir:
                        <label class="campo campo-ancho">Motivo de la copia <input id="pos-dialogo" class="e-input" @bind="_motivo" maxlength="300" data-ayuda="El motivo queda en la auditoría." /></label>
                        <div class="toolbar"><SfButton CssClass="e-primary" OnClick="@ReimprimirAsync">Reimprimir (COPIA)</SfButton></div>
                        break;
                }
                </div>
            </IndicadorDeCarga>
        </Content>
    </DialogTemplates>
</SfDialog>
</PermissionGate>
</div>

@code {
    private enum Modo { Vendiendo, Cobrando, Esperando, Entregada }

    private enum Dialogo { Ninguno, Buscar, Cantidad, Cliente, Vendedor, Descuento, Suspender, Recuperar, Descartar, Reimprimir }

    private readonly EstadoDeCarga _arranque = new(), _trabajo = new();
    private readonly ClaveDeOperacion _claveAbrir = new(), _claveLectura = new(), _claveCabecera = new(), _claveLinea = new(), _claveSuspender = new(),
        _claveRecuperar = new(), _claveDescartar = new(), _claveCobro = new(), _claveEntrega = new(), _claveReimpresion = new();
    private DotNetObjectReference<PuntoDeVenta>? _referencia;
    private SesionDeCajaDto? _sesion;
    private PendientesDeEntrega? _pendientes;
    private CajaDto? _caja;
    private VentaDelPosDto? _venta;
    private ResultadoDeCobroDto? _resultado;
    private TirillaDto? _tirilla;
    private PanelDeMediosDePago? _panel;
    private CobroMultiple _cobro = new(0m);
    private IReadOnlyList<MedioDisponible> _medios = [];
    private IReadOnlyList<decimal> _billetes = [];
    private IReadOnlyList<OpcionDeMedio> _bancos = [];
    private sealed record BancoDeCheque(Guid PublicId, string Name);
    /// <summary>De qué venta son los pagos de <see cref="_cobro"/>: volver a la venta los conserva para la misma venta.</summary>
    private Guid? _cobroDe;

    /// <summary>Feature 022 (FR-031): lo que se escribió o el código desconocido, para abrir la búsqueda F2 con eso.</summary>
    private string? _textoBuscado;
    private int _marcadaSuspendida;
    private Modo _modo = Modo.Vendiendo;
    private Dialogo _dialogo = Dialogo.Ninguno;
    private bool _mostrarDialogo, _sinPos, _montado, _descuentoDeLinea = true, _volverAlPrecioDeLista;
    private string? _lectura, _avisoCaja, _rotulo, _motivo;

    /// <summary>I6 (T941): el código del producto que controla serie y espera que se lea la serie de la unidad.</summary>
    private string? _pideSerie;
    private decimal? _multiplicador, _cantidad, _porcentaje, _valorDescuento, _precio;
    private Guid? _elegida, _ultimoDocumento;
    private PersonSearchPicker.PersonSearchItem? _cliente;
    private List<VendedorDto> _vendedores = [];
    private List<ResumenDeVentaPosDto> _suspendidas = [];

    /// <summary>2026-11-12: el menú lateral de PosLayout (en cascada); abierto, tapa la venta y ninguna tecla llega a ella.</summary>
    [CascadingParameter] public MenuLateralDelPos? Menu { get; set; }

    private bool MenuAbierto => Menu?.Abierto == true;

