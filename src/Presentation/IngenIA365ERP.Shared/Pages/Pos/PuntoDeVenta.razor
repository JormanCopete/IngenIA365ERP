    private Task CambiarVendedorAsync(string? valor) =>
        CambiarCabeceraAsync(Guid.TryParse(valor, out var v) ? new CabeceraDeVentaRequest(SalespersonPublicId: v) : new CabeceraDeVentaRequest(ClearSalesperson: true));

    private async Task VendedoresAsync()
    {
        if (_vendedores.Count > 0) return;
        var r = await Inventario.VendedoresAsync(null, conRetirados: false, 1, 200);
        _vendedores = r.IsSuccess ? [.. r.Value!.Items.Where(v => v.IsActive)] : [];
        if (!r.IsSuccess) await Notification.WarningAsync(r.ErrorMessage ?? "No se pudieron consultar los vendedores.");
    }

    private async Task SuspendidasAsync()
    {
        if (_sesion is null) return;
        var r = await Ventas.VentasDelPosAsync(punto: _sesion.PointOfSale.PointOfSalePublicId, suspendidas: true);
        _suspendidas = r.IsSuccess ? [.. r.Value ?? []] : [];
        if (!r.IsSuccess) await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudieron consultar las ventas suspendidas.");
    }

    private async Task SuspenderAsync()
    {
        if (_venta is null) return;
        using var trabajo = _trabajo.Iniciar();
        var r = await Ventas.SuspenderAsync(_venta.DraftPublicId, string.IsNullOrWhiteSpace(_rotulo) ? null : _rotulo.Trim(), _claveSuspender);
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo suspender la venta."); return; }
        _mostrarDialogo = false;
        await Notification.InfoAsync("Venta suspendida: se recupera con F9 en cualquier caja del punto.");
        NuevaVenta();
    }

