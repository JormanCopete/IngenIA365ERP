    private async Task AprobacionResueltaAsync(VentaDelPosDto venta)
    {
        Mostrar(venta);
        await Notification.InfoAsync("Los descuentos pendientes ya se decidieron.");
        StateHasChanged();
    }

    // ------------------------------------------------------------------------------------ cobrar --

    private async Task EmpezarACobrarAsync()
    {
        if (_venta is not { Lines.Count: > 0 } venta) return;
        if (venta.PendingApprovals.Any(p => p.Status == "Pending")) { await Notification.WarningAsync("Hay descuentos esperando aprobación."); return; }
        _cobro = new CobroDelPos(venta.Totals.AmountDue);
        _modo = Modo.Cobrando;
        await ReservarTeclasRapidasAsync(venta.AvailablePaymentMeans.Select(m => m.QuickKey).OfType<string>().Where(k => k.Length is 2 or 3 && k[0] == 'F'));
    }

    private async Task ReservarTeclasRapidasAsync(IEnumerable<string> teclas)
    {
        try
        {
            await JS.InvokeVoidAsync("ingeniaPos.reservar", teclas.ToArray());
        }
        catch (JSException ex)
        {
            await Notification.WarningAsync($"Las teclas rápidas no quedaron reservadas ({ex.Message}); use los botones de los medios.");
        }
    }

    private void VolverAVender()
    {
        _modo = Modo.Vendiendo;
        _ = ReservarTeclasRapidasAsync([]);
    }

    private async Task CobrarAsync()
    {
        if (_venta is null || _modo != Modo.Cobrando) return;
        if (_cobro.Problema() is { } problema) { await Notification.WarningAsync(problema); return; }
        using var trabajo = _trabajo.Iniciar();
        var r = await Ventas.CobrarAsync(_venta.DraftPublicId, new CobroRequest(_cobro.Pedido(SesionId), _venta.Totals.AmountDue, null), _claveCobro);
        if (!r.IsSuccess || r.Value is null)
        {
            switch (r.ErrorCode)
            {
                case "Inventory.Document.TotalChanged":
                    await Notification.WarningAsync("El total cambió: revise la venta y cobre de nuevo.");
                    await CargarVentaAsync(_venta.DraftPublicId);
                    VolverAVender();
                    break;
                case "Inventory.Discount.ApprovalPending":
                    await Notification.WarningAsync(r.ErrorMessage ?? "Hay descuentos esperando aprobación.");
                    await CargarVentaAsync(_venta.DraftPublicId);
                    VolverAVender();
                    break;
                default:
                    await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo cobrar.");
                    break;
            }
            return;
        }
        _resultado = r.Value;
        _ultimoDocumento = r.Value.DocumentPublicId;
        _ = ReservarTeclasRapidasAsync([]);
        foreach (var aviso in r.Value.Warnings) await Notification.InfoAsync(aviso.Message);
        if (r.Value.Status == 1)
        {
            _modo = Modo.Esperando;
            return;
        }
        await EntregarAsync(r.Value.Ticket);
    }

    private async Task CobroAprobadoAsync(VentaDelPosDto venta)
    {
        if (venta.Status == 2)
        {
            using var trabajo = _trabajo.Iniciar();
            var entrega = await Ventas.EntregarAsync(venta.DraftPublicId, new EntregaRequest(TextosDeVentas.NombreDeFormato(FormatoDeTirilla)), _claveEntrega);
            if (!entrega.IsSuccess) await Notification.WarningAsync(entrega.ErrorMessage ?? "La venta quedó confirmada; la tirilla se entrega desde las ventas pendientes de entrega.");
            await EntregarAsync(entrega.Value?.Ticket);
        }
        else
        {
            Mostrar(venta);
            _modo = Modo.Vendiendo;
            await Notification.WarningAsync("La aprobación se rechazó: la venta volvió a borrador para corregirla.");
        }
        StateHasChanged();
    }

    private async Task EntregarAsync(TirillaDto? tirilla)
    {
        _tirilla = tirilla;
        _modo = Modo.Entregada;
        _venta = null;
        if (tirilla is not null) await ImprimirAsync();
        // I4 (T758): sin tirilla la venta quedó pendiente de entrega (la validación no llegó en la espera del POS).
        else if (_pendientes is not null) await _pendientes.ActualizarAsync();
    }

    private int FormatoDeTirilla => _caja?.PrintFormat is 58 ? 58 : 80;

    private async Task ImprimirAsync()
    {
        if (_tirilla is null) return;
        if (!await Impresion.ImprimirAsync(HtmlDeTirilla.Documento(_tirilla), $"{_tirilla.Document.ClassLabel} {_tirilla.Document.Prefix}{_tirilla.Document.Number}"))
            await Notification.WarningAsync("No se pudo abrir la impresión en este equipo: la tirilla está en pantalla.");
    }

    private async Task ReimprimirAsync()
    {
        if (_ultimoDocumento is not { } documento) return;
        using var trabajo = _trabajo.Iniciar();
        var r = await Ventas.ReimprimirAsync(documento, new EntregaRequest(TextosDeVentas.NombreDeFormato(FormatoDeTirilla), Reason: string.IsNullOrWhiteSpace(_motivo) ? null : _motivo.Trim()),
            _claveReimpresion);
        if (!r.IsSuccess || r.Value?.Ticket is null) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo reimprimir."); return; }
        _mostrarDialogo = false;
        _tirilla = r.Value.Ticket;
        await ImprimirAsync();
    }

    private void NuevaVenta()
    {
        _venta = null;
        _resultado = null;
        _tirilla = null;
        _cliente = null;
        _modo = Modo.Vendiendo;
        _ = EnfocarLecturaAsync();
    }

    // --------------------------------------------------------------------------------- diálogos --

    private async Task AbrirAsync(Dialogo dialogo)
    {
        _dialogo = dialogo;
        _mostrarDialogo = true;
        StateHasChanged();
        await Task.Delay(50);
        await Enfocar("pos-dialogo");
    }

    private async Task EscapeAsync()
    {
        if (_mostrarDialogo) { _mostrarDialogo = false; return; }
        if (_modo == Modo.Cobrando) { VolverAVender(); return; }
        if (_modo == Modo.Entregada) { NuevaVenta(); return; }
        if (_pideSerie is not null) { _pideSerie = null; _lectura = null; return; }
        _multiplicador = null;
        _lectura = null;
        await EnfocarLecturaAsync();
    }

    private Task EnfocarLecturaAsync() => Enfocar("pos-lectura");

    private async Task Enfocar(string id)
    {
        try
        {
            await JS.InvokeVoidAsync("ingeniaPos.enfocar", id);
        }
        catch (JSException ex)
        {
            // Sin pos.js no hay a dónde mover el foco; el campo se puede tocar igual.
            _avisoCaja ??= $"El foco automático no está disponible ({ex.Message}).";
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_montado)
        {
            try
            {
                await JS.InvokeVoidAsync("ingeniaPos.desmontar");
            }
            catch (JSDisconnectedException)
            {
                // El circuito ya se cerró: no queda teclado que desmontar.
                _montado = false;
            }
        }
        _referencia?.Dispose();
    }
}
