    }

    private Task CambiarClienteAsync(PersonSearchPicker.PersonSearchItem? persona) =>
        CambiarCabeceraAsync(persona is null ? new CabeceraDeVentaRequest(ClearCustomer: true) : new CabeceraDeVentaRequest(CustomerPersonPublicId: persona.PublicId));

    private Task CambiarRolAsync(bool factura) =>
        CambiarCabeceraAsync(new CabeceraDeVentaRequest(Role: TextosDeVentas.NombreDeRolDeCaja(factura ? TextosDeVentas.RolFacturaAPedido : TextosDeVentas.RolVentaPos)));

    private Task CambiarVendedorAsync(string? valor) =>
        CambiarCabeceraAsync(Guid.TryParse(valor, out var v) ? new CabeceraDeVentaRequest(SalespersonPublicId: v) : new CabeceraDeVentaRequest(ClearSalesperson: true));

    private async Task VendedoresAsync()
    {
        if (_vendedores.Count > 0) return;
        var r = await Inventario.VendedoresAsync(null, conRetirados: false, 1, 200);
        _vendedores = r.IsSuccess ? [.. r.Value!.Items.Where(v => v.IsActive)] : [];
        if (!r.IsSuccess) await Notification.WarningAsync(r.ErrorMessage ?? "No se pudieron consultar los vendedores.");
    }

    private async Task SuspendidasAsync()
    {
        if (_sesion is null) return;
        var r = await Ventas.VentasDelPosAsync(punto: _sesion.PointOfSale.PointOfSalePublicId, suspendidas: true);
        if (!r.IsSuccess)
        {
            _suspendidas = [];
            await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudieron consultar las ventas suspendidas.");
            return;
        }
        // 2026-11-12: primero las de esta caja (las que cuenta la campana, que de paso se pone al día); después las del resto del punto.
        _suspendidas = [.. (r.Value ?? []).OrderBy(s => DeEstaCaja(s) ? 0 : 1)];
        _campana?.Fijar(_suspendidas.Count(DeEstaCaja));
    }

    private bool DeEstaCaja(ResumenDeVentaPosDto venta) => venta.CashSessionPublicId == SesionId;

    /// <summary>La lista de suspendidas (F9), con la primera marcada cada vez que se abre.</summary>
    private async Task AbrirSuspendidasAsync()
    {
        using (_trabajo.Iniciar())
            await SuspendidasAsync();
        _marcadaSuspendida = 0;
        await AbrirAsync(Dialogo.Recuperar);
    }

    private async Task TeclaEnSuspendidasAsync(KeyboardEventArgs e)
    {
        if (_suspendidas.Count == 0) return;
        switch (e.Key)
        {
            case "ArrowDown": _marcadaSuspendida = Math.Min(_marcadaSuspendida + 1, _suspendidas.Count - 1); break;
            case "ArrowUp": _marcadaSuspendida = Math.Max(_marcadaSuspendida - 1, 0); break;
            case "Enter": await RecuperarAsync(_suspendidas[Math.Clamp(_marcadaSuspendida, 0, _suspendidas.Count - 1)].DraftPublicId); break;
        }
    }

    private async Task SuspenderAsync()
    {
        if (_venta is null) return;
        using (_trabajo.Iniciar())
        {
            var r = await Ventas.SuspenderAsync(_venta.DraftPublicId, string.IsNullOrWhiteSpace(_rotulo) ? null : _rotulo.Trim(), _claveSuspender);
            if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo suspender la venta."); return; }
        }
        var luegoRecuperar = _luegoRecuperar;
        _luegoRecuperar = false;
        await Notification.InfoAsync("Venta suspendida: se recupera con F9 en cualquier caja del punto.");
        NuevaVenta(enfocar: !luegoRecuperar);
        if (luegoRecuperar)
        {
            // 2026-11-12: «Suspender y ver las suspendidas»: el mismo diálogo pasa a la lista (que también pone al día la campana).
            await AbrirSuspendidasAsync();
            return;
        }
        _mostrarDialogo = false;
        if (_campana is not null) await _campana.ActualizarAsync();
    }

    private async Task RecuperarAsync(Guid id)
    {
        using (_trabajo.Iniciar())
        {
            var r = await Ventas.RecuperarAsync(id, SesionId, _claveRecuperar);
            if (!r.IsSuccess || r.Value is null) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo recuperar la venta."); return; }
            _mostrarDialogo = false;
            Mostrar(r.Value);
        }
        if (_campana is not null) await _campana.ActualizarAsync();
    }

    private async Task DescartarAsync()
    {
        if (_venta is null || string.IsNullOrWhiteSpace(_motivo)) return;
        using (_trabajo.Iniciar())
        {
            var r = await Ventas.DescartarVentaAsync(_venta.DraftPublicId, _motivo.Trim(), _claveDescartar);
            if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo descartar la venta."); return; }
        }
        _mostrarDialogo = false;
        NuevaVenta();
        if (_campana is not null) await _campana.ActualizarAsync();
    }

    private async Task AprobacionResueltaAsync(VentaDelPosDto venta)
    {
        Mostrar(venta);
        await Notification.InfoAsync("Los descuentos pendientes ya se decidieron.");
        StateHasChanged();
    }

    // ------------------------------------------------------------------------------------ cobrar --

    private async Task EmpezarACobrarAsync()
    {
        if (_venta is not { Lines.Count: > 0 } venta) return;
        if (venta.PendingApprovals.Any(p => p.Status == "Pending")) { await Notification.WarningAsync("Hay descuentos esperando aprobación."); return; }
        CerrarLaLista();
        _medios = venta.AvailablePaymentMeans.Select(AdaptadoresDeCobro.DesdeVenta).ToList();
        // Volver a la venta y seguir cobrando conserva los pagos ya registrados si son de la misma venta y sus medios siguen ofrecidos;
        // si cambió el total, el panel dice cuánto falta o sobra.
        if (_cobroDe == venta.DraftPublicId && _cobro.Pagos.All(p => _medios.Any(m => m.Codigo == p.Medio.Codigo)))
            _cobro.CambiarAPagar(venta.Totals.AmountDue);
        else
            _cobro = new CobroMultiple(venta.Totals.AmountDue);
        _cobroDe = venta.DraftPublicId;
        if (_bancos.Count == 0 && _medios.Any(m => m.EsCheque))
            _bancos = (await Http.TryGetListAsync<BancoDeCheque>("/api/core/banks?PageNumber=1&PageSize=500&SortBy=name")).Select(b => new OpcionDeMedio(b.PublicId, b.Name)).ToList();
        _modo = Modo.Cobrando;
    }

    private async Task EnfocarPanelAsync()
    {
        if (_panel is not null) await _panel.EnfocarAsync();
    }

    private void VolverAVender()
    {
        _modo = Modo.Vendiendo;
        _ = EnfocarLecturaAsync();
    }

    private async Task CobrarAsync()
    {
        if (_venta is null || _modo != Modo.Cobrando) return;
        if (_cobro.Problema(!_venta.Customer.IsFinalConsumer) is { } problema) { await Notification.WarningAsync(problema); return; }
        using var trabajo = _trabajo.Iniciar();
        var r = await Ventas.CobrarAsync(_venta.DraftPublicId, new CobroRequest(AdaptadoresDeCobro.ParaVenta(_cobro, SesionId), _venta.Totals.AmountDue, null), _claveCobro);
        if (!r.IsSuccess || r.Value is null)
        {
            switch (r.ErrorCode)
            {
                case "Inventory.Document.TotalChanged":
                    await Notification.WarningAsync("El total cambió: revise la venta y cobre de nuevo.");
                    await CargarVentaAsync(_venta.DraftPublicId);
                    VolverAVender();
                    break;
                case "Inventory.Discount.ApprovalPending":
                    await Notification.WarningAsync(r.ErrorMessage ?? "Hay descuentos esperando aprobación.");
                    await CargarVentaAsync(_venta.DraftPublicId);
                    VolverAVender();
                    break;
                default:
                    await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo cobrar.");
                    break;
            }
            return;
        }
        _resultado = r.Value;
        _ultimoDocumento = r.Value.DocumentPublicId;
        foreach (var aviso in r.Value.Warnings) await Notification.InfoAsync(aviso.Message);
        if (r.Value.Status == 1)
        {
            _modo = Modo.Esperando;
            return;
        }
        await EntregarAsync(r.Value.Ticket);
    }

    private async Task CobroAprobadoAsync(VentaDelPosDto venta)
    {
        if (venta.Status == 2)
        {
            using var trabajo = _trabajo.Iniciar();
            var entrega = await Ventas.EntregarAsync(venta.DraftPublicId, new EntregaRequest(TextosDeVentas.NombreDeFormato(FormatoDeTirilla)), _claveEntrega);
            if (!entrega.IsSuccess) await Notification.WarningAsync(entrega.ErrorMessage ?? "La venta quedó confirmada; la tirilla se entrega desde las ventas pendientes de entrega.");
            await EntregarAsync(entrega.Value?.Ticket);
        }
        else
        {
            Mostrar(venta);
            _modo = Modo.Vendiendo;
            await Notification.WarningAsync("La aprobación se rechazó: la venta volvió a borrador para corregirla.");
        }
        StateHasChanged();
    }

    private async Task EntregarAsync(TirillaDto? tirilla)
    {
        // Feature 023 (D7): la tirilla salió antes de que la DIAN validara; la emisión sigue detrás y el comprador recibe la representación
        // completa por correo al validarse. Se avisa sin detener la caja.
        if (tirilla?.Electronic is { } electronica && string.IsNullOrEmpty(electronica.UniqueCode)
            && electronica.Legend?.Contains("pendiente de validación DIAN", StringComparison.OrdinalIgnoreCase) == true)
            await Notification.InfoAsync("La DIAN aún no valida esta venta: la tirilla salió sin código único y la emisión sigue sola.");

        // Feature 023 (D5): con «Imprimir directo» la tirilla no se muestra: salen las copias de la caja y la pantalla queda lista para la
        // venta siguiente. Si la impresión falla, se muestra como siempre para reimprimir (Ctrl+Alt+R).
        if (tirilla is not null && _caja is { DirectPrint: true } caja)
        {
            _tirilla = tirilla;
            var impresas = 0;
            for (var i = 0; i < Math.Max(1, (int)caja.PrintCopies); i++)
            {
                if (!await Impresion.ImprimirAsync(HtmlDeTirilla.Documento(tirilla), $"{tirilla.Document.ClassLabel} {tirilla.Document.Prefix}{tirilla.Document.Number}")) break;
                impresas++;
            }
            if (impresas > 0)
            {
                NuevaVenta();
                return;
            }
            await Notification.WarningAsync("No se pudo imprimir directo en este equipo: la tirilla queda en pantalla para reimprimirla.");
        }

        _tirilla = tirilla;
        _modo = Modo.Entregada;
        _venta = null;
        // 2026-11-12: lo que quedó escrito en el campo era de la venta cerrada, no de la siguiente.
        LimpiarLaLectura();
        // La tirilla y «Nueva venta» se pintan antes de abrir la impresión: al volver de ella, el foco va al botón.
        StateHasChanged();
        if (tirilla is not null && _caja is not { DirectPrint: true }) await ImprimirAsync();
        else
        {
            // I4 (T758): sin tirilla la venta quedó pendiente de entrega (la validación no llegó en la espera del POS).
            if (_pendientes is not null) await _pendientes.ActualizarAsync();
            await EnfocarSegunElModoAsync();
        }
    }

    private int FormatoDeTirilla => _caja?.PrintFormat is 58 ? 58 : 80;

    private async Task ImprimirAsync()
    {
        if (_tirilla is null) return;
        if (!await Impresion.ImprimirAsync(HtmlDeTirilla.Documento(_tirilla), $"{_tirilla.Document.ClassLabel} {_tirilla.Document.Prefix}{_tirilla.Document.Number}"))
            await Notification.WarningAsync("No se pudo abrir la impresión en este equipo: la tirilla está en pantalla.");
        // 2026-11-12: la impresión se queda con el foco; vuelve a «Nueva venta» (tirilla en pantalla) o al campo de lectura.
        if (!_mostrarDialogo) await EnfocarSegunElModoAsync();
    }

    private async Task ReimprimirAsync()
    {
        if (_ultimoDocumento is not { } documento) return;
        using var trabajo = _trabajo.Iniciar();
        var r = await Ventas.ReimprimirAsync(documento, new EntregaRequest(TextosDeVentas.NombreDeFormato(FormatoDeTirilla), Reason: string.IsNullOrWhiteSpace(_motivo) ? null : _motivo.Trim()),
            _claveReimpresion);
        if (!r.IsSuccess || r.Value?.Ticket is null) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo reimprimir."); return; }
        _mostrarDialogo = false;
        _tirilla = r.Value.Ticket;
        await ImprimirAsync();
    }

    /// <summary>
    /// Deja la pantalla lista para la venta siguiente. 2026-11-12: también limpia lo escrito en el campo, el multiplicador, la serie que se
    /// esperaba, el texto de la búsqueda y la lista bajo el campo: antes quedaban de la venta anterior.
    /// </summary>
    private void NuevaVenta(bool enfocar = true)
    {
        _venta = null;
        _resultado = null;
        _tirilla = null;
        _cliente = null;
        _cobro = new CobroMultiple(0m);
        _cobroDe = null;
        _elegida = null;
        _modo = Modo.Vendiendo;
        LimpiarLaLectura();
        if (enfocar) _ = EnfocarLecturaAsync();
    }

    private void LimpiarLaLectura()
    {
        CerrarLaLista();
        _lectura = null;
        _multiplicador = null;
        _pideSerie = null;
        _textoBuscado = null;
    }

    // --------------------------------------------------------------------------------- diálogos --

    private async Task AbrirAsync(Dialogo dialogo)
    {
        _dialogo = dialogo;
        _mostrarDialogo = true;
        StateHasChanged();
        await Task.Delay(50);
        await Enfocar("pos-dialogo");
    }

    private async Task EscapeAsync()
    {
        if (_listaAbierta) { CerrarLaLista(); return; }
        if (_mostrarDialogo) { _mostrarDialogo = false; _luegoRecuperar = false; return; }
        if (_modo == Modo.Cobrando) { VolverAVender(); return; }
        if (_modo == Modo.Entregada) { NuevaVenta(); return; }
        if (_pideSerie is not null) { _pideSerie = null; _lectura = null; return; }
        _multiplicador = null;
        _lectura = null;
        await EnfocarLecturaAsync();
    }

    private Task EnfocarLecturaAsync() => Enfocar("pos-lectura");

    /// <summary>2026-11-12: el foco donde trabaja la caja: «Nueva venta» con la tirilla en pantalla; si no, el campo de lectura.</summary>
    private Task EnfocarSegunElModoAsync() => _modo == Modo.Entregada ? Enfocar("pos-nueva-venta") : EnfocarLecturaAsync();

    /// <summary>2026-11-12: abrir el menú vuelve inerte la venta (re-render); cerrarlo devuelve el foco a donde trabaja la caja.</summary>
    private void AlCambiarElMenu() => _ = InvokeAsync(async () =>
    {
        StateHasChanged();
        if (MenuAbierto || !Lista) return;
        await Task.Yield();
        await EnfocarSegunElModoAsync();
    });

    private async Task Enfocar(string id)
    {
        try
        {
            await JS.InvokeVoidAsync("ingeniaPos.enfocar", id);
        }
        catch (JSException ex)
        {
            // Sin pos.js no hay a dónde mover el foco; el campo se puede tocar igual.
            _avisoCaja ??= $"El foco automático no está disponible ({ex.Message}).";
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (Menu is not null) Menu.Cambio -= AlCambiarElMenu;
        _esperaEnLinea?.Cancel();
        if (_montado)
        {
            try
            {
                await JS.InvokeVoidAsync("ingeniaPos.desmontar");
            }
            catch (JSDisconnectedException)
            {
                // El circuito ya se cerró: no queda teclado que desmontar.
                _montado = false;
            }
        }
        _referencia?.Dispose();
    }
}
