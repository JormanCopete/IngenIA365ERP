@page "/pos/sesiones/{Id:guid}/cierre"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using IngenIA365ERP.Shared.Services.Http
@using IngenIA365ERP.Shared.Services.Inventario
@using IngenIA365ERP.Shared.Services.Nomina
@using IngenIA365ERP.Shared.Services.Ventas
@inject VentasClient Ventas
@inject MediosDePagoClient Medios
@inject INotificationService Notification
@inject DescargaDeArchivos Descargas

<PageTitle>Cierre de caja - IngenIA365ERP</PageTitle>

@* Feature 012, I3 (T641; FR-099, FR-100, US5-4, US5-10, US5-11; contracts/api.md §21.2): el cierre de la sesión con arqueo por medio de
   pago. Cada medio se cuenta como dice su forma de arqueo: el efectivo por denominaciones, las tarjetas por el lote de cada datáfono (con
   el cotejo que el medio pida), los que se cotejan por referencias marcando una a una, y los que no se arquean no se piden. Con arqueo
   ciego no se muestra lo esperado. Una diferencia fuera de la tolerancia pide el motivo; el servidor decide su tratamiento (sobrante,
   faltante al cajero o al gasto) y el documento de diferencia. El retiro de cierre lleva el efectivo a la caja fuerte, a otra caja o a
   consignar. Cerrada, el arqueo se puede recontar y se descarga en PDF (CashCountReport). *@
<PermissionGate Required="Inventory.CashSessions.Close" MostrarAviso="true">
<div class="pagina">
    <div class="page-header">
        <h3>Cierre de la caja</h3>
        <div class="toolbar">
            <a class="e-btn e-outline" href="@($"/pos/sesiones/{Id}")">Volver a la sesión</a>
            @if (_resultado is not null)
            {
                <SfButton CssClass="e-outline" IconCss="e-icons e-download" OnClick="@DescargarArqueoAsync">Informe del arqueo</SfButton>
            }
        </div>
    </div>

    <IndicadorDeCarga Cargando="@(_carga.Activa || _guardado.Activa)" Texto="@(_guardado.Activa ? "Cerrando…" : "Calculando lo esperado…")">
        @if (_esperado is { } esperado)
        {
            @if (esperado.Blind)
            {
                <p class="aviso aviso-info">Arqueo ciego: cuente sin ver lo esperado; la diferencia se ve al cerrar.</p>
            }
            @foreach (var linea in esperado.Lines.Where(l => l.PaymentMeans.CountMethod != 4))
            {
                var l = linea;
                var conteo = _conteos[l.PaymentMeans.PublicId];
                <div class="info-card">
                    <h4>@l.PaymentMeans.Code · @l.PaymentMeans.Name <span class="texto-tenue">(@TextosDeVentas.FormaDeArqueo(l.PaymentMeans.CountMethod))</span></h4>
                    @if (!esperado.Blind)
                    {
                        <p class="texto-tenue">Base @N(l.OpeningBase) · ventas @N(l.Sales) · reintegros @N(l.Refunds) · entradas @N(l.MovementsIn) · salidas @N(l.MovementsOut) · reclasificado @N(l.ReclassificationsIn)/@N(l.ReclassificationsOut) → <b>esperado @N(l.Expected)</b> · tolerancia @l.Tolerance.ToString("N0") · @l.PaymentsCount pago(s)</p>
                    }
                    @switch (l.PaymentMeans.CountMethod)
                    {
                        case TextosDeVentas.ArqueoPorDenominaciones:
                            <ConteoPorDenominaciones Denominaciones="@_denominaciones" Cantidades="@conteo.Denominaciones" TotalChanged="@(t => conteo.Total = t)" />
                            break;
                        case TextosDeVentas.ArqueoPorLote:
                            <LotesDeDatafono Datafonos="@(l.Terminals ?? [])" Lotes="@conteo.Lotes" Cambio="@(() => conteo.Total = conteo.Lotes.Sum(x => x.Total))" />
                            break;
                        case TextosDeVentas.ArqueoPorReferencias:
                            <table class="data-grid">
                                <thead><tr><th>Cotejado</th><th>Documento</th><th>Referencia</th><th class="numero">Valor</th></tr></thead>
                                <tbody>
                                    @foreach (var r in l.References ?? [])
                                    {
                                        var id = r.DocumentPaymentPublicId;
                                        <tr><td><input type="checkbox" checked="@conteo.Cotejados.Contains(id)" @onchange="@(e => Cotejar(conteo, id, e.Value, r.Amount))" /></td>
                                            <td>@r.DocumentNumber</td><td>@r.Reference</td><td class="numero">@r.Amount.ToString("N0")</td></tr>
                                    }
                                </tbody>
                            </table>
                            break;
                    }
                    <div class="form-grid">
                        <label class="campo">Total contado <input class="e-input numero" type="number" min="0" step="any" @bind="conteo.Total" /></label>
                        @if (!esperado.Blind && l.Expected is { } e && Math.Abs(conteo.Total - e) > l.Tolerance)
                        {
                            <span class="aviso aviso-alerta">Diferencia @((conteo.Total - e).ToString("N0"))</span>
                        }
                        <label class="campo campo-ancho">Motivo de la diferencia <input class="e-input" @bind="conteo.Motivo" maxlength="300" /></label>
                    </div>
                </div>
            }

            @if (_resultado is null)
            {
                <div class="info-card">
                    <div class="form-grid">
                        <label class="campo">Retiro de cierre
                            <select class="e-input" value="@(_destino?.ToString() ?? "")" @onchange="@(e => _destino = int.TryParse(e.Value?.ToString(), out var d) ? d : null)">
                                <option value="">Sin retiro (el efectivo queda en la caja)</option>
                                @foreach (var (v, t) in TextosDeVentas.DestinosDeMovimiento) { <option value="@v">A @t.ToLowerInvariant()</option> }
                            </select>
                        </label>
                    </div>
                    <div class="toolbar">
                        <SfButton CssClass="e-primary" Disabled="@_guardado.Activa" OnClick="@CerrarAsync">Cerrar la caja</SfButton>
                    </div>
                </div>
            }
        }

        @if (_resultado is { } res)
        {
            <div class="info-card">
                <h4>Resultado del arqueo</h4>
                <table class="data-grid">
                    <thead><tr><th>Medio</th><th class="numero">Esperado</th><th class="numero">Contado</th><th class="numero">Diferencia</th><th>Tratamiento</th></tr></thead>
                    <tbody>
                        @foreach (var l in res.Lines)
                        {
                            <tr><td>@l.PaymentMeansCode</td><td class="numero">@l.Expected.ToString("N0")</td><td class="numero">@l.Counted.ToString("N0")</td>
                                <td class="numero">@l.Difference.ToString("N0")</td><td>@(l.WithinTolerance ? "Dentro de la tolerancia" : TextosDeVentas.TratamientoDeDiferencia(l.Treatment))</td></tr>
                        }
                    </tbody>
                </table>
                @if (res.DifferenceDocument is { } dif) { <p>Documento de diferencia: @(dif.Number ?? "(en aprobación)") · @TextosDeInventario.Estado(dif.Status)</p> }
                @if (res.ClosingWithdrawalDocument is { } ret) { <p>Retiro de cierre: @(ret.Number ?? "(en aprobación)") · @TextosDeInventario.Estado(ret.Status)</p> }
                @if (res.Batch is { } lote) { <p>Lote contable @lote.Number (@lote.Trigger).</p> }
                <div class="toolbar">
                    <SfButton CssClass="e-outline" Disabled="@_guardado.Activa" OnClick="@RecontarAsync">Recontar con lo digitado</SfButton>
                    <a class="e-btn e-flat" href="/pos/cierre-del-dia">Cierre del día</a>
                </div>
            </div>
        }
    </IndicadorDeCarga>
</div>
</PermissionGate>

@code {
    private sealed class ConteoDeMedio
    {
        public decimal Total { get; set; }
        public string? Motivo { get; set; }
        public Dictionary<Guid, int> Denominaciones { get; } = [];
        public List<LotesDeDatafono.LoteForm> Lotes { get; } = [];
        public HashSet<Guid> Cotejados { get; } = [];
    }

    [Parameter] public Guid Id { get; set; }

    private readonly EstadoDeCarga _carga = new(), _guardado = new();
    private readonly ClaveDeOperacion _claveCierre = new(), _claveRecuento = new();
    private EsperadoDeSesionDto? _esperado;
    private List<DenominacionDto> _denominaciones = [];
    private readonly Dictionary<Guid, ConteoDeMedio> _conteos = [];
    private ResultadoDeCierreDto? _resultado;
    private int? _destino;

    protected override async Task OnParametersSetAsync()
    {
        using var carga = _carga.Iniciar();
        var denominaciones = await Medios.DenominacionesAsync(DateOnly.FromDateTime(DateTime.Today));
        _denominaciones = denominaciones.IsSuccess ? [.. denominaciones.Value ?? []] : [];
        var r = await Ventas.EsperadoAsync(Id);
        if (!r.IsSuccess || r.Value is null) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo calcular lo esperado."); return; }
        _esperado = r.Value;
        _conteos.Clear();
        foreach (var l in r.Value.Lines)
        {
            var conteo = new ConteoDeMedio();
            foreach (var t in l.Terminals ?? []) conteo.Lotes.Add(new LotesDeDatafono.LoteForm { CardTerminalPublicId = t.CardTerminalPublicId, Count = t.PaymentsCount });
            _conteos[l.PaymentMeans.PublicId] = conteo;
        }
    }

    private static void Cotejar(ConteoDeMedio conteo, Guid pago, object? valor, decimal monto)
    {
        if (valor is true) { if (conteo.Cotejados.Add(pago)) conteo.Total += monto; }
        else if (conteo.Cotejados.Remove(pago)) conteo.Total -= monto;
    }

    private IReadOnlyList<ConteoPorMedioRequest> Conteos()
    {
        if (_esperado is null) return [];
        return _esperado.Lines.Where(l => l.PaymentMeans.CountMethod != 4).Select(l =>
        {
            var c = _conteos[l.PaymentMeans.PublicId];
            var metodo = l.PaymentMeans.CountMethod;
            return new ConteoPorMedioRequest(
                l.PaymentMeans.PublicId,
                CountedTotal: c.Total,
                Denominations: metodo == TextosDeVentas.ArqueoPorDenominaciones && c.Denominaciones.Count > 0
                    ? c.Denominaciones.Select(p => new ConteoDeDenominacionRequest(p.Key, p.Value)).ToList() : null,
                TerminalBatches: metodo == TextosDeVentas.ArqueoPorLote
                    ? c.Lotes.Where(x => !string.IsNullOrWhiteSpace(x.BatchNumber)).Select(x => new LoteDeDatafonoRequest(x.CardTerminalPublicId, x.BatchNumber.Trim(), x.Total, x.Count)).ToList()
                    : null,
                ReferenceChecks: metodo == TextosDeVentas.ArqueoPorReferencias
                    ? (l.References ?? []).Select(r => new CotejoDeReferenciaRequest(r.DocumentPaymentPublicId, c.Cotejados.Contains(r.DocumentPaymentPublicId))).ToList()
                    : null,
                Reason: string.IsNullOrWhiteSpace(c.Motivo) ? null : c.Motivo.Trim());
        }).ToList();
    }

    private async Task CerrarAsync()
    {
        using var guardado = _guardado.Iniciar();
        var retiro = _destino is { } d ? new RetiroDeCierreRequest(TextosDeVentas.NombreDeDestino(d)) : null;
        var r = await Ventas.CerrarSesionAsync(Id, new CerrarSesionRequest(Conteos(), retiro), _claveCierre);
        if (!r.IsSuccess || r.Value is null) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo cerrar la caja."); return; }
        _resultado = r.Value;
        await Notification.SuccessAsync("Caja cerrada.");
    }

    private async Task RecontarAsync()
    {
        using var guardado = _guardado.Iniciar();
        var r = await Ventas.RecontarSesionAsync(Id, Conteos(), _claveRecuento);
        if (!r.IsSuccess || r.Value is null) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo recontar."); return; }
        _resultado = r.Value;
        await Notification.SuccessAsync("Arqueo recontado.");
    }

    private async Task DescargarArqueoAsync()
    {
        using var carga = _carga.Iniciar();
        var r = await Ventas.DescargarArqueoAsync(Id);
        if (!r.IsSuccess || r.Value is null) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo generar el informe del arqueo."); return; }
        await Descargas.GuardarAsync(r.Value.Nombre, r.Value.TipoContenido, r.Value.Contenido);
    }

    private static string N(decimal? v) => v?.ToString("N0") ?? "—";
}
