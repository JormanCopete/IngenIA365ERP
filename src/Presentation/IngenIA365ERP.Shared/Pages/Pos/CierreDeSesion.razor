@page "/pos/sesiones/{Id:guid}/cierre"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using IngenIA365ERP.Shared.Services.Http
@using IngenIA365ERP.Shared.Services.Inventario
@using IngenIA365ERP.Shared.Services.Nomina
@using IngenIA365ERP.Shared.Services.Ventas
@inject VentasClient Ventas
@inject MediosDePagoClient Medios
@inject IngenIA365ERP.Shared.Services.Recaudo.SesionesClient SesionesDeRecaudo
@inject INotificationService Notification
@inject DescargaDeArchivos Descargas

<PageTitle>Arqueo de caja - IngenIA365ERP</PageTitle>

@* 2026-11-24 (pedido del dueño): el cierre de la caja del punto de venta con el arqueo común en dos pasos (ArqueoDeCaja), el mismo de Recaudo. Con el
   arqueo sencillo (Caja.ArqueoEstricto apagado) cada medio se cuenta con un total, el motivo se pide sólo fuera de la tolerancia y el faltante va al
   gasto; con el estricto, las tarjetas por lote de datáfono y las referencias marcando una a una, como desde la feature 012 (I3, T641). El retiro de
   cierre lleva el efectivo a la caja fuerte o a consignar. Cerrada, el arqueo se puede recontar y se descarga en PDF (CashCountReport). Sirve también
   para cerrar la caja de otra persona (con Inventory.CashSessions.ViewAll). *@
<PermissionGate Required="Inventory.CashSessions.Close" MostrarAviso="true">
<div class="pagina">
    <div class="page-header">
        <h3>Arquear y cerrar la caja</h3>
        <div class="toolbar">
            <a class="e-btn e-flat" href="/pos/sesiones">Mi caja</a>
            <a class="e-btn e-flat" href="/pos/cajas">Cajas del día</a>
        </div>
    </div>

    <IndicadorDeCarga Cargando="@_carga.Activa" Texto="Calculando lo que debería haber…">
        @if (_sesion is { } s)
        {
            <p class="texto-apoyo">Caja @s.CashRegister.Code de @s.PointOfSale.Name · @s.Cashier.Name · día @s.OperatingDate.ToString("dd/MM/yyyy") · @s.SalesCount venta(s)
                por @s.SalesTotal.ToString("N0")</p>
            @if (_resultado is { } res)
            {
                <ResultadoDelArqueo Lineas="@Lineas(res)">
                    <ChildContent>
                        @if (res.DifferenceDocument is { } dif)
                        {
                            <p>Documento de diferencia: @(dif.Number ?? "(en aprobación)") · @TextosDeInventario.Estado(dif.Status)</p>
                        }
                        @if (res.ClosingWithdrawalDocument is { } ret)
                        {
                            <p>Retiro de cierre: @(ret.Number ?? "(en aprobación)") · @TextosDeInventario.Estado(ret.Status)</p>
                        }
                    </ChildContent>
                    <Acciones>
                        <SfButton CssClass="e-outline" IconCss="e-icons e-download" OnClick="@DescargarArqueoAsync">Informe del arqueo</SfButton>
                        @if (res.DifferenceDocument is { Number: null })
                        {
                            <SfButton CssClass="e-flat" Disabled="@_guardado.Activa" OnClick="@RecontarAsync">Recontar con lo digitado</SfButton>
                        }
                        <a class="e-btn e-primary" href="/pos/sesiones">Listo</a>
                    </Acciones>
                </ResultadoDelArqueo>
            }
            else if (s.Status != TextosDeVentas.SesionAbierta)
            {
                <p class="aviso aviso-info">Esta caja ya está cerrada. <a href="@($"/pos/sesiones/{Id}")">Ver su arqueo</a>.</p>
            }
            else if (s.LinkedSessionPublicId is not null)
            {
                <p class="aviso aviso-info">Caja única: esta caja se cierra con el arqueo de Recaudo. <a href="/recaudo/sesiones">Ir a Mi caja de Recaudo</a>.</p>
            }
            else
            {
                <ArqueoDeCaja Medios="@_medios" Denominaciones="@_denominaciones" FormaDelEfectivo="@_politica.FormaDelEfectivo" Estricto="@_politica.Estricto"
                              Ciego="@_ciego" Ocupado="@_guardado.Activa" Confirmar="@CerrarAsync">
                    <Extra>
                        <label class="campo">Al cerrar, el efectivo
                            <select class="e-input" value="@(_destino ?? "")" @onchange="@(e => _destino = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString())">
                                <option value="">Queda en la caja</option>
                                <option value="Safe">Va a la caja fuerte</option>
                                <option value="Deposit">Va a consignar</option>
                            </select>
                            <span class="hint">Con fondo fijo, sale lo contado menos el fondo.</span>
                        </label>
                    </Extra>
                    <Cancelar>
                        <a class="e-btn e-flat" href="/pos/sesiones">Cancelar</a>
                    </Cancelar>
                </ArqueoDeCaja>
            }
        }
        else if (!_carga.Activa)
        {
            <p class="aviso aviso-alerta">@(_error ?? "No se encontró la caja.")</p>
        }
    </IndicadorDeCarga>
</div>
</PermissionGate>

@code {
    [Parameter] public Guid Id { get; set; }

    private readonly EstadoDeCarga _carga = new(), _guardado = new();
    private readonly ClaveDeOperacion _claveCierre = new(), _claveRecuento = new();
    private SesionDeCajaDto? _sesion;
    private string? _error;
    private bool _ciego;
    private PoliticaDeCaja _politica = PoliticaDeCaja.PorDefecto;
    private List<MedioAContar> _medios = [];
    private IReadOnlyList<DenominacionDeConteo> _denominaciones = [];
    private ResultadoDeCierreDto? _resultado;
    private string? _destino;

    protected override async Task OnParametersSetAsync()
    {
        using var carga = _carga.Iniciar();
        _resultado = null;
        var detalle = await Ventas.ObtenerSesionAsync(Id);
        _sesion = detalle.IsSuccess ? detalle.Value?.Session : null;
        _error = detalle.IsSuccess ? null : detalle.ErrorMessage;
        if (_sesion is not { Status: TextosDeVentas.SesionAbierta }) return;

        _politica = await SesionesDeRecaudo.PoliticaAsync();
        var denominaciones = await Medios.DenominacionesAsync(DiaDeCaja.Hoy());
        _denominaciones = denominaciones.IsSuccess
            ? (denominaciones.Value ?? []).Where(d => d.IsActive).Select(d => new DenominacionDeConteo(d.CashDenominationPublicId, d.Value, d.Kind != 1)).ToList()
            : [];
        var r = await Ventas.EsperadoAsync(Id);
        if (!r.IsSuccess || r.Value is null) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo calcular lo esperado."); return; }
        _ciego = r.Value.Blind;
        _medios = r.Value.Lines.Where(l => l.PaymentMeans.CountMethod != 4).Select(l =>
        {
            var metodo = l.PaymentMeans.CountMethod;
            var medio = new MedioAContar
            {
                Id = l.PaymentMeans.PublicId,
                Codigo = l.PaymentMeans.Code,
                Nombre = l.PaymentMeans.Name,
                Forma = metodo == TextosDeVentas.ArqueoPorDenominaciones ? FormaDeContar.Efectivo
                    : !_politica.Estricto ? FormaDeContar.Total
                    : metodo == TextosDeVentas.ArqueoPorLote ? FormaDeContar.Lotes
                    : metodo == TextosDeVentas.ArqueoPorReferencias ? FormaDeContar.Referencias : FormaDeContar.Total,
                Esperado = r.Value.Blind ? null : l.Expected,
                Tolerancia = l.Tolerance,
                DetalleDelEsperado = l.Expected is null ? null
                    : $"base {l.OpeningBase:N0} · ventas {l.Sales:N0} · reintegros {l.Refunds:N0} · entradas {l.MovementsIn:N0} · salidas {l.MovementsOut:N0}",
                Datafonos = (l.Terminals ?? []).Select(t => new DatafonoDeConteo(t.CardTerminalPublicId, t.AcquirerCode is { } a ? $"{t.Code} · {a}" : t.Code,
                    t.Expected, t.PaymentsCount)).ToList(),
                Referencias = (l.References ?? []).Select(x => new ReferenciaDeConteo(x.DocumentPaymentPublicId, x.DocumentNumber ?? "", x.Reference ?? "", x.Amount)).ToList(),
            };
            // Con el arqueo estricto por lote, un renglón por datáfono listo para digitar.
            if (medio.Forma == FormaDeContar.Lotes)
                foreach (var t in medio.Datafonos) medio.Lotes.Add(new LoteDigitado { Datafono = t.Id, Cantidad = t.Pagos });
            return medio;
        }).ToList();
    }

    private IReadOnlyList<ConteoPorMedioRequest> Conteos() => _medios.Select(m =>
    {
        var motivo = string.IsNullOrWhiteSpace(m.Motivo) ? null : m.Motivo.Trim();
        return m.Forma switch
        {
            FormaDeContar.Efectivo => new ConteoPorMedioRequest(m.Id, CountedTotal: m.Contado,
                Denominations: IngenIA365ERP.Shared.Services.Recaudo.FormasDeConteo.PorBilletes(_politica.FormaDelEfectivo, m.PorBilletes) && m.Billetes.Count > 0
                    ? m.Billetes.Select(b => new ConteoDeDenominacionRequest(b.Key, b.Value)).ToList() : null,
                Reason: motivo),
            FormaDeContar.Lotes => new ConteoPorMedioRequest(m.Id, CountedTotal: m.Contado,
                TerminalBatches: m.Lotes.Where(l => l.Datafono is not null && !string.IsNullOrWhiteSpace(l.Numero))
                    .Select(l => new LoteDeDatafonoRequest(l.Datafono!.Value, l.Numero.Trim(), l.Valor, l.Cantidad)).ToList() is { Count: > 0 } lotes ? lotes : null,
                Reason: motivo),
            FormaDeContar.Referencias => new ConteoPorMedioRequest(m.Id, CountedTotal: m.Contado,
                ReferenceChecks: m.Referencias.Select(r => new CotejoDeReferenciaRequest(r.Id, m.Cotejados.Contains(r.Id))).ToList(), Reason: motivo),
            _ => new ConteoPorMedioRequest(m.Id, CountedTotal: m.Contado, Reason: motivo),
        };
    }).ToList();

    private async Task CerrarAsync()
    {
        using var guardado = _guardado.Iniciar();
        var retiro = _destino is { } d ? new RetiroDeCierreRequest(d) : null;
        var r = await Ventas.CerrarSesionAsync(Id, new CerrarSesionRequest(Conteos(), retiro), _claveCierre);
        if (!r.IsSuccess || r.Value is null) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo cerrar la caja."); return; }
        _resultado = r.Value;
        await Notification.SuccessAsync("Caja cerrada.");
    }

    private async Task RecontarAsync()
    {
        using var guardado = _guardado.Iniciar();
        var r = await Ventas.RecontarSesionAsync(Id, Conteos(), _claveRecuento);
        if (!r.IsSuccess || r.Value is null) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo recontar."); return; }
        _resultado = r.Value;
        await Notification.SuccessAsync("Arqueo recontado.");
    }

    private IReadOnlyList<LineaDelResultado> Lineas(ResultadoDeCierreDto r) => r.Lines.Select(l => new LineaDelResultado(
        _medios.FirstOrDefault(m => m.Codigo == l.PaymentMeansCode)?.Nombre ?? l.PaymentMeansCode, l.Expected, l.Counted, l.Difference,
        l.Difference == 0m ? "Cuadra" : TextosDeVentas.TratamientoDeDiferencia(l.Treatment))).ToList();

    private async Task DescargarArqueoAsync()
    {
        using var carga = _carga.Iniciar();
        var r = await Ventas.DescargarArqueoAsync(Id);
        if (!r.IsSuccess || r.Value is null) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo generar el informe del arqueo."); return; }
        await Descargas.GuardarAsync(r.Value.Nombre, r.Value.TipoContenido, r.Value.Contenido);
    }
}
