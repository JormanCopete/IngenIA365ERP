@page "/cartera/codigos-movimiento"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification

<PageTitle>Codigos de Movimiento - IngenIA365ERP</PageTitle>

<div class="page-header">
    <h3>Codigos de Movimiento</h3>
    <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@OpenCreate">Nuevo</SfButton>
</div>

<SfGrid @ref="_grid" TValue="TransactionCodeItem" DataSource="@_items"
    AllowPaging="true" AllowSorting="true" AllowFiltering="true">
    <GridColumns>
        <GridColumn Field="Code" HeaderText="Codigo" Width="100" TextAlign="TextAlign.Center" />
        <GridColumn Field="Name" HeaderText="Nombre" Width="250" />
        <GridColumn Field="TransactionType" HeaderText="Tipo Transaccion" Width="150" />
        <GridColumn Field="AccountCode" HeaderText="Cuenta Contable" Width="150" />
        <GridColumn HeaderText="Acciones" Width="150" TextAlign="TextAlign.Center">
            <Template>
                @{
                    var item = context as TransactionCodeItem;
                    <SfButton CssClass="e-flat e-small" IconCss="e-icons e-edit" OnClick="@(() => OpenEdit(item!))" />
                    <SfButton CssClass="e-flat e-small e-danger" IconCss="e-icons e-trash" OnClick="@(() => OpenDelete(item!))" />
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

<SfDialog @bind-Visible="_showDialog" Header="@_dialogTitle" Width="500px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <div style="padding:10px;display:flex;flex-direction:column;gap:16px;">
                <div>
                    <label>Codigo *</label>
                    <SfTextBox @bind-Value="_model.Code" Placeholder="Codigo (max 3)" MaxLength="3" />
                </div>
                <div>
                    <label>Nombre *</label>
                    <SfTextBox @bind-Value="_model.Name" Placeholder="Nombre del movimiento" />
                </div>
                <div>
                    <label>Tipo de Transaccion</label>
                    <SfTextBox @bind-Value="_model.TransactionType" Placeholder="Tipo (max 3)" MaxLength="3" />
                </div>
                <div>
                    <label>Cuenta Contable</label>
                    <SfTextBox @bind-Value="_model.AccountCode" Placeholder="Codigo cuenta contable" MaxLength="15" />
                </div>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _showDialog = false)" />
        <DialogButton Content="Guardar" IsPrimary="true" OnClick="@Save" />
    </DialogButtons>
</SfDialog>

<ConfirmDialog @bind-Visible="_showConfirm" OnConfirm="ConfirmDelete"
    Message="Esta seguro de eliminar este registro?" />

@code {
    private SfGrid<TransactionCodeItem>? _grid;
    private List<TransactionCodeItem> _items = [];
    private TransactionCodeModel _model = new();
    private Guid? _editId;
    private bool _showDialog, _showConfirm;
    private string _dialogTitle = "";
    private Guid _deleteId;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        try { _items = await Http.GetListAsync<TransactionCodeItem>("/api/lending/transaction-codes?pageSize=500") ?? []; }
        catch { _items = []; }
    }

    private void OpenCreate() { _model = new(); _editId = null; _dialogTitle = "Nuevo Codigo de Movimiento"; _showDialog = true; }

    private void OpenEdit(TransactionCodeItem item)
    {
        _model = new()
        {
            Code = item.Code,
            Name = item.Name,
            TransactionType = item.TransactionType,
            AccountCode = item.AccountCode
        };
        _editId = item.PublicId;
        _dialogTitle = "Editar Codigo de Movimiento";
        _showDialog = true;
    }

    private void OpenDelete(TransactionCodeItem item) { _deleteId = item.PublicId; _showConfirm = true; }

    private async Task Save()
    {
        HttpResponseMessage res;
        if (_editId.HasValue)
            res = await Http.PutAsJsonAsync($"/api/lending/transaction-codes/{_editId}", _model);
        else
            res = await Http.PostAsJsonAsync("/api/lending/transaction-codes", _model);

        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro guardado");
            _showDialog = false;
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al guardar");
    }

    private async Task ConfirmDelete()
    {
        var res = await Http.DeleteAsync($"/api/lending/transaction-codes/{_deleteId}");
        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro eliminado");
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al eliminar");
    }

    private class TransactionCodeItem
    {
        public Guid PublicId { get; set; }
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
        public string TransactionType { get; set; } = "";
        public string AccountCode { get; set; } = "";
    }

    private class TransactionCodeModel
    {
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
        public string TransactionType { get; set; } = "";
        public string AccountCode { get; set; } = "";
    }
}
