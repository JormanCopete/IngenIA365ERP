@page "/cartera/creditos/{PortfolioId:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Nav
@inject INotificationService Notification

<PageTitle>Credito #@(_detail?.PortfolioNumber) - IngenIA365ERP</PageTitle>

<div class="page-header" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;">
    <h3>Credito #@(_detail?.PortfolioNumber ?? 0) - @(_detail?.PersonName ?? "Cargando...")</h3>
    <div style="display:flex;gap:8px;">
        <SfButton CssClass="e-flat" IconCss="e-icons e-arrow-left"
                  OnClick='@(() => Nav.NavigateTo("/cartera/creditos"))'>Volver a Cartera</SfButton>
        @if (_detail is not null && _detail.CurrentBalance > 0)
        {
            <SfButton CssClass="e-success" IconCss="e-icons e-money"
                      OnClick='@(() => Nav.NavigateTo($"/cartera/recaudos?portfolio={PortfolioId}"))'>Registrar Pago</SfButton>
        }
    </div>
</div>

@if (_loading)
{
    <div style="display:flex;justify-content:center;padding:40px;">
        <SfSpinner Visible="true" />
    </div>
}
else if (_detail is not null)
{
    <!-- Summary cards -->
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:12px;margin-bottom:20px;">
        <div class="kpi-card">
            <span class="kpi-label">Monto Aprobado</span>
            <span class="kpi-value">@_detail.ApprovedAmount.ToString("N0")</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-label">Saldo Actual</span>
            <span class="kpi-value" style="@(_detail.CurrentBalance > 0 ? "color:var(--alerta-texto)" : "color:var(--exito-texto)")">@_detail.CurrentBalance.ToString("N0")</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-label">Cuotas Pagadas</span>
            <span class="kpi-value">@_detail.PaidInstallments / @_detail.TermMonths</span>
        </div>
        <div class="kpi-card" style="@(_detail.DaysOverdue > 0 ? "border-color:var(--peligro)" : "")">
            <span class="kpi-label">Dias en Mora</span>
            <span class="kpi-value" style="@(_detail.DaysOverdue > 0 ? "color:var(--peligro-texto)" : "color:var(--exito-texto)")">@_detail.DaysOverdue</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-label">Clasificacion</span>
            @{ var catColor = _detail.Category switch { "A" => "var(--riesgo-a-txt)", "B" => "var(--riesgo-b-txt)", "C" => "var(--riesgo-c-txt)", "D" => "var(--riesgo-d-txt)", "E" => "var(--riesgo-e-txt)", _ => "var(--riesgo-nd-txt)" }; }
            <span class="kpi-value" style="color:@catColor">@_detail.Category</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-label">Tasa Anual</span>
            <span class="kpi-value">@_detail.InterestRate.ToString("N2")%</span>
        </div>
    </div>

    <SfTab>
        <TabItems>
            <!-- Tab 1: Resumen -->
            <TabItem>
                <ChildContent><TabHeader Text="Resumen" IconCss="e-icons e-description" /></ChildContent>
                <ContentTemplate>
                    <div style="padding:16px;">
                        <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:10px;max-width:600px;">
                            <span style="color:var(--texto-tenue);">Numero:</span><span>@_detail.PortfolioNumber</span>
                            <span style="color:var(--texto-tenue);">Asociado:</span><span>@_detail.PersonName</span>
                            <span style="color:var(--texto-tenue);">Documento:</span><span>@_detail.IdentificationNumber</span>
                            <span style="color:var(--texto-tenue);">Linea de Credito:</span><span>@_detail.CreditLineName</span>
                            <span style="color:var(--texto-tenue);">Desembolso:</span><span>@_detail.DisbursementDate</span>
                            <span style="color:var(--texto-tenue);">Vencimiento:</span><span>@(_detail.MaturityDate?.ToString() ?? "-")</span>
                            <span style="color:var(--texto-tenue);">Ultimo Pago:</span><span>@(_detail.LastPaymentDate?.ToString() ?? "Sin pagos")</span>
                            <span style="color:var(--texto-tenue);">Periodicidad:</span><span>@GetPeriodicityText(_detail.PaymentPeriodicity)</span>
                            <span style="color:var(--texto-tenue);">Tipo Garantia:</span><span>@_detail.GuaranteeType</span>
                            <span style="color:var(--texto-tenue);">Tipo Descuento:</span><span>@_detail.DeductionType</span>
                            <span style="color:var(--texto-tenue);">Cuota:</span><span>@_detail.InstallmentAmount.ToString("N0")</span>
                        </div>
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- Tab 2: Cuotas -->
            <TabItem>
                <ChildContent><TabHeader Text="@($"Cuotas ({_detail.Installments.Count})")" IconCss="e-icons e-list-unordered" /></ChildContent>
                <ContentTemplate>
                    <div style="padding:16px;">
                        <SfGrid TValue="InstallmentRow" DataSource="_detail.Installments" AllowPaging="true"
                                AllowSorting="true" GridLines="GridLine.Both">
                            <GridPageSettings PageSize="24" />
                            <GridColumns>
                                <GridColumn Field="@nameof(InstallmentRow.Period)" HeaderText="Cuota" Width="70" TextAlign="TextAlign.Center" />
                                <GridColumn Field="@nameof(InstallmentRow.ProcessDate)" HeaderText="Fecha" Width="110" Format="d" />
                                <GridColumn Field="@nameof(InstallmentRow.AccruedCapital)" HeaderText="Capital" Width="120" TextAlign="TextAlign.Right" Format="N0" />
                                <GridColumn Field="@nameof(InstallmentRow.AccruedInterest)" HeaderText="Interes" Width="120" TextAlign="TextAlign.Right" Format="N0" />
                                <GridColumn Field="@nameof(InstallmentRow.TotalAmount)" HeaderText="Total" Width="120" TextAlign="TextAlign.Right" Format="N0" />
                                <GridColumn Field="@nameof(InstallmentRow.PaidCapital)" HeaderText="Pag.Cap" Width="110" TextAlign="TextAlign.Right" Format="N0" />
                                <GridColumn Field="@nameof(InstallmentRow.PaidInterest)" HeaderText="Pag.Int" Width="110" TextAlign="TextAlign.Right" Format="N0" />
                                <GridColumn Field="@nameof(InstallmentRow.BalanceCapital)" HeaderText="Sdo.Cap" Width="110" TextAlign="TextAlign.Right" Format="N0" />
                                <GridColumn Field="@nameof(InstallmentRow.BalanceInterest)" HeaderText="Sdo.Int" Width="110" TextAlign="TextAlign.Right" Format="N0" />
                                <GridColumn Field="@nameof(InstallmentRow.Status)" HeaderText="Estado" Width="100" TextAlign="TextAlign.Center">
                                    <Template>
                                        @{
                                            var inst = context as InstallmentRow;
                                            var stColor = inst?.Status switch
                                            {
                                                "Pagada" => "color:var(--exito-texto)",
                                                "Parcial" => "color:var(--alerta-texto)",
                                                _ => "color:var(--peligro-texto)"
                                            };
                                        }
                                        <span style="@stColor;font-weight:bold;">@inst?.Status</span>
                                    </Template>
                                </GridColumn>
                            </GridColumns>
                        </SfGrid>
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- Tab 3: Movimientos -->
            <TabItem>
                <ChildContent><TabHeader Text="@($"Movimientos ({_detail.RecentTransactions.Count})")" IconCss="e-icons e-edit" /></ChildContent>
                <ContentTemplate>
                    <div style="padding:16px;">
                        <SfGrid TValue="TransactionRow" DataSource="_detail.RecentTransactions" AllowPaging="true"
                                AllowSorting="true" GridLines="GridLine.Both">
                            <GridPageSettings PageSize="20" />
                            <GridColumns>
                                <GridColumn Field="@nameof(TransactionRow.TransactionDate)" HeaderText="Fecha" Width="110" Format="d" />
                                <GridColumn Field="@nameof(TransactionRow.VoucherType)" HeaderText="Tipo" Width="70" TextAlign="TextAlign.Center" />
                                <GridColumn Field="@nameof(TransactionRow.DocumentNumber)" HeaderText="Documento" Width="110" TextAlign="TextAlign.Center" />
                                <GridColumn Field="@nameof(TransactionRow.TransactionCode)" HeaderText="Codigo" Width="80" TextAlign="TextAlign.Center" />
                                <GridColumn Field="@nameof(TransactionRow.DebitAmount)" HeaderText="Debito" Width="130" TextAlign="TextAlign.Right" Format="N0" />
                                <GridColumn Field="@nameof(TransactionRow.CreditAmount)" HeaderText="Credito" Width="130" TextAlign="TextAlign.Right" Format="N0" />
                                <GridColumn Field="@nameof(TransactionRow.Description)" HeaderText="Descripcion" Width="300" />
                            </GridColumns>
                        </SfGrid>
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- Tab 4: Garantias (placeholder) -->
            <TabItem>
                <ChildContent><TabHeader Text="Garantias" IconCss="e-icons e-lock" /></ChildContent>
                <ContentTemplate>
                    <div style="padding:16px;">
                        <p style="color:var(--texto-tenue);">Garantias asociadas al credito se mostraran aqui.</p>
                    </div>
                </ContentTemplate>
            </TabItem>
        </TabItems>
    </SfTab>
}

<style>
    .kpi-card {
        background: var(--sf-card-bg, var(--superficie-1));
        border: 1px solid var(--borde);
        border-radius: 8px;
        padding: 12px;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }
    .kpi-value { font-size: 22px; font-weight: bold; color: var(--acento); }
    .kpi-label { font-size: 12px; color: var(--texto-tenue); margin-bottom: 4px; }
</style>

@code {
    [Parameter] public Guid PortfolioId { get; set; }

    private bool _loading = true;
    private PortfolioDetailResponse? _detail;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try
        {
            _detail = await Http.GetFromJsonAsync<PortfolioDetailResponse>($"api/lending/portfolios/{PortfolioId}");
        }
        catch (Exception ex)
        {
            await Notification.ErrorAsync($"Error cargando credito: {ex.Message}");
        }
        _loading = false;
    }

    private string GetPeriodicityText(string code) => code switch
    {
        "1" => "Mensual", "2" => "Quincenal", "3" => "Decadal", "4" => "Semanal", "5" => "Diario",
        _ => code
    };

    // --- Response types ---
    record InstallmentRow(Guid PublicId, int Period, DateOnly? ProcessDate, decimal AccruedCapital,
        decimal AccruedInterest, decimal TotalAmount, decimal PaidCapital, decimal PaidInterest,
        decimal BalanceCapital, decimal BalanceInterest, decimal DefaultInterest, string Status);

    record TransactionRow(Guid PublicId, string VoucherType, long DocumentNumber,
        DateOnly TransactionDate, string TransactionCode, decimal DebitAmount,
        decimal CreditAmount, string Description);

    record PortfolioDetailResponse(
        Guid PublicId, long PortfolioNumber, string PersonName, string IdentificationNumber,
        string CreditLineName, DateOnly DisbursementDate, DateOnly? MaturityDate,
        DateOnly? LastPaymentDate, decimal CurrentBalance, decimal ApprovedAmount,
        decimal InterestRate, int TermMonths, decimal InstallmentAmount,
        int PaidInstallments, decimal PendingInstallmentCount, int DaysOverdue,
        string Category, string GuaranteeType, string DeductionType, string PaymentPeriodicity,
        List<InstallmentRow> Installments, List<TransactionRow> RecentTransactions);
}
