@page "/cartera/parametros-periodicidad"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification

<PageTitle>Parametros de Periodicidad - IngenIA365ERP</PageTitle>

<div class="page-header">
    <h3>Parametros de Periodicidad</h3>
    <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@OpenCreate">Nuevo</SfButton>
</div>

<SfGrid @ref="_grid" TValue="ItemModel" DataSource="@_items" AllowPaging="true" AllowSorting="true" AllowFiltering="true">
    <GridColumns>
        <GridColumn Field="CompanyCode" HeaderText="Empresa" Width="120" TextAlign="TextAlign.Center" />
        <GridColumn Field="DeductionClass" HeaderText="Clase Descuento" Width="140" TextAlign="TextAlign.Center" />
        <GridColumn Field="Periodicity" HeaderText="Periodicidad" Width="120" TextAlign="TextAlign.Center" />
        <GridColumn Field="StartDay" HeaderText="Dia Inicio" Width="110" TextAlign="TextAlign.Center" />
        <GridColumn Field="EndDay" HeaderText="Dia Fin" Width="110" TextAlign="TextAlign.Center" />
        <GridColumn Field="DayCount" HeaderText="Dias" Width="100" TextAlign="TextAlign.Center" />
        <GridColumn HeaderText="Acciones" Width="150" TextAlign="TextAlign.Center">
            <Template>
                @{
                    var item = context as ItemModel;
                    <SfButton CssClass="e-flat e-small" IconCss="e-icons e-edit" OnClick="@(() => OpenEdit(item!))" />
                    <SfButton CssClass="e-flat e-small e-danger" IconCss="e-icons e-trash" OnClick="@(() => OpenDelete(item!))" />
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

<SfDialog @bind-Visible="_showDialog" Header="@_dialogTitle" Width="500px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <div style="padding:10px;display:flex;flex-direction:column;gap:16px;">
                <SfTextBox @bind-Value="_model.CompanyCode" Placeholder="Codigo Empresa" FloatLabelType="FloatLabelType.Always" />
                <SfTextBox @bind-Value="_model.DeductionClass" Placeholder="Clase de Descuento" FloatLabelType="FloatLabelType.Always" />
                <SfTextBox @bind-Value="_model.Periodicity" Placeholder="Periodicidad" FloatLabelType="FloatLabelType.Always" />
                <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;">
                    <SfNumericTextBox TValue="int" @bind-Value="_model.StartDay" Placeholder="Dia Inicio" FloatLabelType="FloatLabelType.Always" />
                    <SfNumericTextBox TValue="int" @bind-Value="_model.EndDay" Placeholder="Dia Fin" FloatLabelType="FloatLabelType.Always" />
                    <SfTextBox @bind-Value="_model.DayCount" Placeholder="Dias" FloatLabelType="FloatLabelType.Always" />
                </div>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _showDialog = false)" />
        <DialogButton Content="Guardar" IsPrimary="true" OnClick="@Save" />
    </DialogButtons>
</SfDialog>

<ConfirmDialog @bind-Visible="_showConfirm" OnConfirm="ConfirmDelete" Message="Esta seguro de eliminar este registro?" />

@code {
    private SfGrid<ItemModel>? _grid;
    private List<ItemModel> _items = [];
    private FormModel _model = new();
    private Guid? _editId;
    private bool _showDialog, _showConfirm;
    private string _dialogTitle = "";
    private Guid _deleteId;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        try { var r = await Http.GetFromJsonAsync<Paged>("/api/lending/periodicity-parameters?pageSize=500"); _items = r?.Items ?? []; }
        catch { _items = []; }
    }

    private void OpenCreate() { _model = new(); _editId = null; _dialogTitle = "Nuevo Parametro Periodicidad"; _showDialog = true; }

    private void OpenEdit(ItemModel item)
    {
        _model = new()
        {
            CompanyCode = item.CompanyCode, DeductionClass = item.DeductionClass,
            Periodicity = item.Periodicity, StartDay = item.StartDay, EndDay = item.EndDay, DayCount = item.DayCount
        };
        _editId = item.PublicId; _dialogTitle = "Editar Parametro Periodicidad"; _showDialog = true;
    }

    private void OpenDelete(ItemModel item) { _deleteId = item.PublicId; _showConfirm = true; }

    private async Task Save()
    {
        var res = _editId.HasValue
            ? await Http.PutAsJsonAsync($"/api/lending/periodicity-parameters/{_editId}", _model)
            : await Http.PostAsJsonAsync("/api/lending/periodicity-parameters", _model);
        if (res.IsSuccessStatusCode) { await Notification.SuccessAsync("Guardado"); _showDialog = false; await LoadData(); }
        else await Notification.ShowErrorAsync(res, "Error al guardar");
    }

    private async Task ConfirmDelete()
    {
        var res = await Http.DeleteAsync($"/api/lending/periodicity-parameters/{_deleteId}");
        if (res.IsSuccessStatusCode) { await Notification.SuccessAsync("Eliminado"); await LoadData(); }
        else await Notification.ShowErrorAsync(res, "Error al eliminar");
    }

    private class Paged { public List<ItemModel> Items { get; set; } = []; }
    private class ItemModel
    {
        public Guid PublicId { get; set; }
        public string CompanyCode { get; set; } = "";
        public string DeductionClass { get; set; } = "";
        public string Periodicity { get; set; } = "";
        public int StartDay { get; set; }
        public int EndDay { get; set; }
        public string DayCount { get; set; } = "";
    }
    private class FormModel
    {
        public string CompanyCode { get; set; } = "";
        public string DeductionClass { get; set; } = "";
        public string Periodicity { get; set; } = "";
        public int StartDay { get; set; }
        public int EndDay { get; set; }
        public string DayCount { get; set; } = "";
    }
}
