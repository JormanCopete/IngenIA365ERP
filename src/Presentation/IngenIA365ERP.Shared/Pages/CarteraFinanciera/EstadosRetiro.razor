@page "/cartera/estados-retiro"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification

<PageTitle>Estados de Retiro - IngenIA365ERP</PageTitle>

<div class="page-header">
    <h3>Estados de Retiro</h3>
    <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@OpenCreate">Nuevo</SfButton>
</div>

<SfGrid @ref="_grid" TValue="ItemModel" DataSource="@_items" AllowPaging="true" AllowSorting="true" AllowFiltering="true">
    <GridColumns>
        <GridColumn Field="PersonCode" HeaderText="Codigo Persona" Width="140" />
        <GridColumn Field="RequestDate" HeaderText="Fecha Solicitud" Width="140" Format="d" TextAlign="TextAlign.Center" />
        <GridColumn Field="ReasonCode" HeaderText="Motivo" Width="100" TextAlign="TextAlign.Center" />
        <GridColumn Field="Status" HeaderText="Estado" Width="100" TextAlign="TextAlign.Center" />
        <GridColumn Field="EffectiveDate" HeaderText="Fecha Efectiva" Width="140" Format="d" TextAlign="TextAlign.Center" />
        <GridColumn Field="Period" HeaderText="Periodo" Width="100" TextAlign="TextAlign.Center" />
        <GridColumn Field="Remarks" HeaderText="Observaciones" Width="220" />
        <GridColumn HeaderText="Acciones" Width="150" TextAlign="TextAlign.Center">
            <Template>
                @{
                    var item = context as ItemModel;
                    <SfButton CssClass="e-flat e-small" IconCss="e-icons e-edit" OnClick="@(() => OpenEdit(item!))" />
                    <SfButton CssClass="e-flat e-small e-danger" IconCss="e-icons e-trash" OnClick="@(() => OpenDelete(item!))" />
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

<SfDialog @bind-Visible="_showDialog" Header="@_dialogTitle" Width="550px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <div class="pagina">
                <SfTextBox @bind-Value="_model.PersonCode" Placeholder="Codigo Persona" FloatLabelType="FloatLabelType.Always" />
                <SfDatePicker TValue="DateTime" @bind-Value="_model.RequestDate" Placeholder="Fecha Solicitud" FloatLabelType="FloatLabelType.Always" />
                <SfTextBox @bind-Value="_model.ReasonCode" Placeholder="Codigo Motivo" FloatLabelType="FloatLabelType.Always" />
                <SfTextBox @bind-Value="_model.Status" Placeholder="Estado" FloatLabelType="FloatLabelType.Always" />
                <SfDatePicker TValue="DateTime?" @bind-Value="_model.EffectiveDate" Placeholder="Fecha Efectiva" FloatLabelType="FloatLabelType.Always" />
                <SfNumericTextBox TValue="int" @bind-Value="_model.Period" Placeholder="Periodo" FloatLabelType="FloatLabelType.Always" />
                <SfTextBox @bind-Value="_model.Remarks" Placeholder="Observaciones" FloatLabelType="FloatLabelType.Always" Multiline="true" />
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _showDialog = false)" />
        <DialogButton Content="Guardar" IsPrimary="true" OnClick="@Save" />
    </DialogButtons>
</SfDialog>

<ConfirmDialog @bind-Visible="_showConfirm" OnConfirm="ConfirmDelete" Message="Esta seguro de eliminar este registro?" />

@code {
    private SfGrid<ItemModel>? _grid;
    private List<ItemModel> _items = [];
    private FormModel _model = new();
    private Guid? _editId;
    private bool _showDialog, _showConfirm;
    private string _dialogTitle = "";
    private Guid _deleteId;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        try { var r = await Http.GetFromJsonAsync<Paged>("/api/lending/withdrawal-statuses?pageSize=500"); _items = r?.Items ?? []; }
        catch { _items = []; }
    }

    private void OpenCreate() { _model = new(); _editId = null; _dialogTitle = "Nuevo Estado de Retiro"; _showDialog = true; }

    private void OpenEdit(ItemModel item)
    {
        _model = new()
        {
            PersonCode = item.PersonCode, RequestDate = item.RequestDate, ReasonCode = item.ReasonCode,
            Status = item.Status, EffectiveDate = item.EffectiveDate, Period = item.Period, Remarks = item.Remarks
        };
        _editId = item.PublicId; _dialogTitle = "Editar Estado de Retiro"; _showDialog = true;
    }

    private void OpenDelete(ItemModel item) { _deleteId = item.PublicId; _showConfirm = true; }

    private async Task Save()
    {
        var res = _editId.HasValue
            ? await Http.PutAsJsonAsync($"/api/lending/withdrawal-statuses/{_editId}", _model)
            : await Http.PostAsJsonAsync("/api/lending/withdrawal-statuses", _model);
        if (res.IsSuccessStatusCode) { await Notification.SuccessAsync("Guardado"); _showDialog = false; await LoadData(); }
        else await Notification.ShowErrorAsync(res, "Error al guardar");
    }

    private async Task ConfirmDelete()
    {
        var res = await Http.DeleteAsync($"/api/lending/withdrawal-statuses/{_deleteId}");
        if (res.IsSuccessStatusCode) { await Notification.SuccessAsync("Eliminado"); await LoadData(); }
        else await Notification.ShowErrorAsync(res, "Error al eliminar");
    }

    private class Paged { public List<ItemModel> Items { get; set; } = []; }
    private class ItemModel
    {
        public Guid PublicId { get; set; }
        public string PersonCode { get; set; } = "";
        public DateTime RequestDate { get; set; }
        public string ReasonCode { get; set; } = "";
        public string Status { get; set; } = "";
        public DateTime? EffectiveDate { get; set; }
        public int Period { get; set; }
        public string Remarks { get; set; } = "";
    }
    private class FormModel
    {
        public string PersonCode { get; set; } = "";
        public DateTime RequestDate { get; set; } = DateTime.Today;
        public string ReasonCode { get; set; } = "";
        public string Status { get; set; } = "";
        public DateTime? EffectiveDate { get; set; }
        public int Period { get; set; }
        public string Remarks { get; set; } = "";
    }
}
