@page "/cartera/parametros-sipla"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification

<PageTitle>Parametros SIPLA - IngenIA365ERP</PageTitle>

<div class="page-header">
    <h3>Parametros SIPLA</h3>
    <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@OpenCreate">Nuevo</SfButton>
</div>

<SfGrid @ref="_grid" TValue="ItemModel" DataSource="@_items" AllowPaging="true" AllowSorting="true" AllowFiltering="true">
    <GridColumns>
        <GridColumn Field="ConceptCode" HeaderText="Codigo Concepto" Width="140" TextAlign="TextAlign.Center" />
        <GridColumn Field="CompanyCode" HeaderText="Empresa" Width="120" TextAlign="TextAlign.Center" />
        <GridColumn Field="MonthlyCreditMoves" HeaderText="Movtos Credito Mes" Width="160" Format="N2" TextAlign="TextAlign.Right" />
        <GridColumn Field="MaxBalance" HeaderText="Saldo Maximo" Width="140" Format="N2" TextAlign="TextAlign.Right" />
        <GridColumn Field="AccountCount" HeaderText="No. Cuentas" Width="120" TextAlign="TextAlign.Right" />
        <GridColumn Field="AnnualTransactions" HeaderText="Transacciones Anuales" Width="170" TextAlign="TextAlign.Right" />
        <GridColumn HeaderText="Acciones" Width="150" TextAlign="TextAlign.Center">
            <Template>
                @{
                    var item = context as ItemModel;
                    <SfButton CssClass="e-flat e-small" IconCss="e-icons e-edit" OnClick="@(() => OpenEdit(item!))" />
                    <SfButton CssClass="e-flat e-small e-danger" IconCss="e-icons e-trash" OnClick="@(() => OpenDelete(item!))" />
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

<SfDialog @bind-Visible="_showDialog" Header="@_dialogTitle" Width="500px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <div style="padding:10px;display:flex;flex-direction:column;gap:16px;">
                <SfTextBox @bind-Value="_model.ConceptCode" Placeholder="Codigo Concepto" FloatLabelType="FloatLabelType.Always" />
                <SfTextBox @bind-Value="_model.CompanyCode" Placeholder="Codigo Empresa" FloatLabelType="FloatLabelType.Always" />
                <SfNumericTextBox TValue="decimal" @bind-Value="_model.MonthlyCreditMoves" Placeholder="Movimientos Credito Mensuales" Format="N2" FloatLabelType="FloatLabelType.Always" />
                <SfNumericTextBox TValue="decimal" @bind-Value="_model.MaxBalance" Placeholder="Saldo Maximo" Format="N2" FloatLabelType="FloatLabelType.Always" />
                <SfNumericTextBox TValue="int" @bind-Value="_model.AccountCount" Placeholder="Numero de Cuentas" FloatLabelType="FloatLabelType.Always" />
                <SfNumericTextBox TValue="int" @bind-Value="_model.AnnualTransactions" Placeholder="Transacciones Anuales" FloatLabelType="FloatLabelType.Always" />
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _showDialog = false)" />
        <DialogButton Content="Guardar" IsPrimary="true" OnClick="@Save" />
    </DialogButtons>
</SfDialog>

<ConfirmDialog @bind-Visible="_showConfirm" OnConfirm="ConfirmDelete" Message="Esta seguro de eliminar este registro?" />

@code {
    private SfGrid<ItemModel>? _grid;
    private List<ItemModel> _items = [];
    private FormModel _model = new();
    private Guid? _editId;
    private bool _showDialog, _showConfirm;
    private string _dialogTitle = "";
    private Guid _deleteId;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        try { var r = await Http.GetFromJsonAsync<Paged>("/api/lending/sipla-parameters?pageSize=500"); _items = r?.Items ?? []; }
        catch { _items = []; }
    }

    private void OpenCreate() { _model = new(); _editId = null; _dialogTitle = "Nuevo Parametro SIPLA"; _showDialog = true; }

    private void OpenEdit(ItemModel item)
    {
        _model = new()
        {
            ConceptCode = item.ConceptCode, CompanyCode = item.CompanyCode,
            MonthlyCreditMoves = item.MonthlyCreditMoves, MaxBalance = item.MaxBalance,
            AccountCount = item.AccountCount, AnnualTransactions = item.AnnualTransactions
        };
        _editId = item.PublicId; _dialogTitle = "Editar Parametro SIPLA"; _showDialog = true;
    }

    private void OpenDelete(ItemModel item) { _deleteId = item.PublicId; _showConfirm = true; }

    private async Task Save()
    {
        var res = _editId.HasValue
            ? await Http.PutAsJsonAsync($"/api/lending/sipla-parameters/{_editId}", _model)
            : await Http.PostAsJsonAsync("/api/lending/sipla-parameters", _model);
        if (res.IsSuccessStatusCode) { await Notification.SuccessAsync("Guardado"); _showDialog = false; await LoadData(); }
        else await Notification.ShowErrorAsync(res, "Error al guardar");
    }

    private async Task ConfirmDelete()
    {
        var res = await Http.DeleteAsync($"/api/lending/sipla-parameters/{_deleteId}");
        if (res.IsSuccessStatusCode) { await Notification.SuccessAsync("Eliminado"); await LoadData(); }
        else await Notification.ShowErrorAsync(res, "Error al eliminar");
    }

    private class Paged { public List<ItemModel> Items { get; set; } = []; }
    private class ItemModel
    {
        public Guid PublicId { get; set; }
        public string ConceptCode { get; set; } = "";
        public string CompanyCode { get; set; } = "";
        public decimal MonthlyCreditMoves { get; set; }
        public decimal MaxBalance { get; set; }
        public int AccountCount { get; set; }
        public int AnnualTransactions { get; set; }
    }
    private class FormModel
    {
        public string ConceptCode { get; set; } = "";
        public string CompanyCode { get; set; } = "";
        public decimal MonthlyCreditMoves { get; set; }
        public decimal MaxBalance { get; set; }
        public int AccountCount { get; set; }
        public int AnnualTransactions { get; set; }
    }
}
