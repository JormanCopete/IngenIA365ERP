@page "/cartera/tasas-interes"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification

<PageTitle>Tasas de Interes - IngenIA365ERP</PageTitle>

<div class="page-header">
    <h3>Tasas de Interes</h3>
    <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@OpenCreate">Nuevo</SfButton>
</div>

<SfGrid @ref="_grid" TValue="InterestRateItem" DataSource="@_items"
    AllowPaging="true" AllowSorting="true" AllowFiltering="true">
    <GridColumns>
        <GridColumn Field="Period" HeaderText="Periodo" Width="120" TextAlign="TextAlign.Center" />
        <GridColumn Field="CreditLineCode" HeaderText="Linea Credito" Width="140" />
        <GridColumn Field="PortfolioBalance" HeaderText="Saldo Cartera" Width="180" Format="N2" TextAlign="TextAlign.Right" />
        <GridColumn Field="CostCenterId" HeaderText="Centro Costo" Width="140" />
        <GridColumn Field="PortfolioClass" HeaderText="Clase Cartera" Width="130" TextAlign="TextAlign.Center" />
        <GridColumn HeaderText="Acciones" Width="150" TextAlign="TextAlign.Center">
            <Template>
                @{
                    var item = context as InterestRateItem;
                    <SfButton CssClass="e-flat e-small" IconCss="e-icons e-edit" OnClick="@(() => OpenEdit(item!))" />
                    <SfButton CssClass="e-flat e-small e-danger" IconCss="e-icons e-trash" OnClick="@(() => OpenDelete(item!))" />
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

<SfDialog @bind-Visible="_showDialog" Header="@_dialogTitle" Width="500px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <div class="pagina">
                <div>
                    <label>Periodo *</label>
                    <SfNumericTextBox TValue="int" @bind-Value="_model.Period"
                        Placeholder="202601" Format="N0" Min="0" />
                </div>
                <div>
                    <label>Codigo Linea de Credito *</label>
                    <SfTextBox @bind-Value="_model.CreditLineCode" Placeholder="Codigo (max 5)" MaxLength="5" />
                </div>
                <div>
                    <label>Saldo de Cartera</label>
                    <SfNumericTextBox TValue="decimal" @bind-Value="_model.PortfolioBalance"
                        Placeholder="0.00" Decimals="2" Format="N2" Min="0" />
                </div>
                <div>
                    <label>Centro de Costo</label>
                    <SfTextBox @bind-Value="_model.CostCenterId" Placeholder="Centro de costo" MaxLength="10" />
                </div>
                <div>
                    <label>Clase de Cartera</label>
                    <SfNumericTextBox TValue="int?" @bind-Value="_model.PortfolioClass"
                        Placeholder="0" Format="N0" />
                </div>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _showDialog = false)" />
        <DialogButton Content="Guardar" IsPrimary="true" OnClick="@Save" />
    </DialogButtons>
</SfDialog>

<ConfirmDialog @bind-Visible="_showConfirm" OnConfirm="ConfirmDelete"
    Message="Esta seguro de eliminar este registro?" />

@code {
    private SfGrid<InterestRateItem>? _grid;
    private List<InterestRateItem> _items = [];
    private InterestRateModel _model = new();
    private Guid? _editId;
    private bool _showDialog, _showConfirm;
    private string _dialogTitle = "";
    private Guid _deleteId;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        try { _items = await Http.GetListAsync<InterestRateItem>("/api/lending/interest-rates?pageSize=500") ?? []; }
        catch { _items = []; }
    }

    private void OpenCreate() { _model = new(); _editId = null; _dialogTitle = "Nueva Tasa de Interes"; _showDialog = true; }

    private void OpenEdit(InterestRateItem item)
    {
        _model = new()
        {
            Period = item.Period,
            CreditLineCode = item.CreditLineCode,
            PortfolioBalance = item.PortfolioBalance,
            CostCenterId = item.CostCenterId,
            PortfolioClass = item.PortfolioClass
        };
        _editId = item.PublicId;
        _dialogTitle = "Editar Tasa de Interes";
        _showDialog = true;
    }

    private void OpenDelete(InterestRateItem item) { _deleteId = item.PublicId; _showConfirm = true; }

    private async Task Save()
    {
        HttpResponseMessage res;
        if (_editId.HasValue)
            res = await Http.PutAsJsonAsync($"/api/lending/interest-rates/{_editId}", _model);
        else
            res = await Http.PostAsJsonAsync("/api/lending/interest-rates", _model);

        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro guardado");
            _showDialog = false;
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al guardar");
    }

    private async Task ConfirmDelete()
    {
        var res = await Http.DeleteAsync($"/api/lending/interest-rates/{_deleteId}");
        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro eliminado");
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al eliminar");
    }

    private class InterestRateItem
    {
        public Guid PublicId { get; set; }
        public int Period { get; set; }
        public string CreditLineCode { get; set; } = "";
        public decimal PortfolioBalance { get; set; }
        public string CostCenterId { get; set; } = "";
        public int? PortfolioClass { get; set; }
    }

    private class InterestRateModel
    {
        public int Period { get; set; }
        public string CreditLineCode { get; set; } = "";
        public decimal PortfolioBalance { get; set; }
        public string CostCenterId { get; set; } = "";
        public int? PortfolioClass { get; set; }
    }
}
