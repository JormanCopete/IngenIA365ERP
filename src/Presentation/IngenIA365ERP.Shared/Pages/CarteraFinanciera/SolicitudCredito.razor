@page "/cartera/solicitudes/nueva"
@page "/cartera/solicitudes/{ApplicationId:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Nav
@inject INotificationService Notification

<PageTitle>@(_isNew ? "Nueva Solicitud" : $"Solicitud #{_detail?.ApplicationNumber}") - IngenIA365ERP</PageTitle>

<!-- Toolbar -->
<div class="page-header">
    <h3>@(_isNew ? "Nueva Solicitud de Credito" : $"Solicitud #{_detail?.ApplicationNumber}")</h3>
    <div>
        <SfButton CssClass="e-flat" IconCss="e-icons e-arrow-left"
                  OnClick='@(() => Nav.NavigateTo("/cartera/solicitudes"))'>Volver</SfButton>
        @if (_isNew || _detail?.Status == "R")
        {
            <SfButton CssClass="e-primary" IconCss="e-icons e-save" Disabled="@_saving"
                      OnClick="SaveApplication">Guardar</SfButton>
        }
        @if (!_isNew && _detail?.Status == "R")
        {
            <SfButton CssClass="e-success" IconCss="e-icons e-check" OnClick="@(() => _showApprove = true)">Aprobar</SfButton>
            <SfButton CssClass="e-danger" IconCss="e-icons e-close" OnClick="@(() => _showReject = true)">Rechazar</SfButton>
        }
        @if (!_isNew && _detail?.Status == "A")
        {
            <SfButton CssClass="e-info" IconCss="e-icons e-money" OnClick="@(() => _showDisburse = true)">Desembolsar</SfButton>
        }
    </div>
</div>

<!-- Status badge -->
@if (_detail is not null)
{
    var (badgeCss, _) = GetStatusBadge(_detail.Status);
    <div style="margin-bottom:var(--gap-md);">
        <span class="badge @badgeCss" style="font-size:var(--texto-md);padding:var(--pad-xs) var(--pad-md);">@_detail.StatusText</span>
    </div>
}

@if (_loading)
{
    <div style="display:flex;justify-content:center;padding:var(--gap-xl);">
        <SfSpinner Visible="true" />
    </div>
}
else
{
    <SfTab>
        <TabItems>
            <!-- Tab 1: Solicitante -->
            <TabItem>
                <ChildContent><TabHeader Text="Solicitante" IconCss="e-icons e-people" /></ChildContent>
                <ContentTemplate>
                    <div class="panel-pestana">
                        <div class="rejilla-campos">
                            <div class="campo-ancho">
                                <label>Buscar Asociado *</label>
                                <div class="actions">
                                    <SfTextBox @bind-Value="_searchTerm" Placeholder="Cedula o nombre del asociado"
                                               Enabled="@(_isNew || _detail?.Status == "R")" />
                                    <SfButton CssClass="e-primary e-small" IconCss="e-icons e-search"
                                              OnClick="SearchPerson" Disabled="@string.IsNullOrWhiteSpace(_searchTerm)">Buscar</SfButton>
                                </div>
                            </div>
                        </div>
                        @if (_searchResults.Count > 0)
                        {
                            <div class="lista-resultados">
                                @foreach (var p in _searchResults)
                                {
                                    <div class="item-resultado" @onclick="() => SelectPerson(p)">
                                        <strong>@p.FullName</strong> - @p.IdentificationNumber
                                        @if (p.IsAssociate) { <span style="color:var(--exito-texto);margin-left:var(--gap-sm);">[Asociado]</span> }
                                    </div>
                                }
                            </div>
                        }
                        @if (_selectedPerson is not null)
                        {
                            <div class="panel-resumen">
                                <h5>@_selectedPerson.FullName</h5>
                                <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:var(--gap-sm);font-size:var(--texto-sm);">
                                    <span>Documento: @_selectedPerson.IdentificationNumber</span>
                                    <span>Asociado: @(_selectedPerson.IsAssociate ? "Si" : "No")</span>
                                    <span>Ciudad: @(_selectedPerson.CityName ?? "-")</span>
                                </div>
                            </div>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- Tab 2: Datos del Credito -->
            <TabItem>
                <ChildContent><TabHeader Text="Datos Credito" IconCss="e-icons e-money" /></ChildContent>
                <ContentTemplate>
                    <div class="panel-pestana">
                        <div class="rejilla-campos">
                            <div>
                                <label>Linea de Credito *</label>
                                <SfDropDownList TValue="string" TItem="CreditLineItem" @bind-Value="_form.CreditLinePublicId"
                                                DataSource="_creditLines" Placeholder="Seleccione linea"
                                                Enabled="@(_isNew || _detail?.Status == "R")">
                                    <DropDownListFieldSettings Text="Description" Value="PublicId" />
                                    <DropDownListEvents TValue="string" TItem="CreditLineItem" ValueChange="OnCreditLineChanged" />
                                </SfDropDownList>
                            </div>
                            <div>
                                <label>Monto Solicitado *</label>
                                <SfNumericTextBox TValue="decimal" @bind-Value="_form.RequestedAmount" Format="N0" Min="0"
                                                  Enabled="@(_isNew || _detail?.Status == "R")" />
                            </div>
                            <div>
                                <label>Plazo (meses) *</label>
                                <SfNumericTextBox TValue="int" @bind-Value="_form.RequestedTerm" Min="1" Max="360"
                                                  Enabled="@(_isNew || _detail?.Status == "R")" />
                            </div>
                            <div>
                                <label>Tasa Anual (%)</label>
                                <SfNumericTextBox TValue="decimal" @bind-Value="_form.InterestRate" Format="N2" Readonly="true" CssClass="e-disabled" />
                            </div>
                            <div>
                                <label>Tipo Garantia *</label>
                                <SfDropDownList TValue="string" TItem="GuaranteeItem" @bind-Value="_form.GuaranteeType"
                                                DataSource="_guaranteeTypes" Placeholder="Seleccione"
                                                Enabled="@(_isNew || _detail?.Status == "R")">
                                    <DropDownListFieldSettings Text="Text" Value="Value" />
                                </SfDropDownList>
                            </div>
                            <div class="campo-ancho">
                                <label>Destino / Proposito</label>
                                <SfTextBox @bind-Value="_form.Purpose" Multiline="true"
                                           Enabled="@(_isNew || _detail?.Status == "R")" />
                            </div>
                        </div>
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- Tab 3: Garantias (placeholder) -->
            <TabItem>
                <ChildContent><TabHeader Text="Garantias" IconCss="e-icons e-lock" /></ChildContent>
                <ContentTemplate>
                    <div class="panel-pestana">
                        <p class="texto-tenue">Administracion de garantias disponible despues de guardar la solicitud.</p>
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- Tab 4: Tabla Amortizacion -->
            <TabItem>
                <ChildContent><TabHeader Text="Amortizacion" IconCss="e-icons e-list-unordered" /></ChildContent>
                <ContentTemplate>
                    <div class="panel-pestana">
                        <SfButton CssClass="e-primary e-small" IconCss="e-icons e-refresh" OnClick="CalculateAmortization"
                                  Disabled="@(_form.RequestedAmount <= 0 || _form.RequestedTerm <= 0)">Calcular Tabla</SfButton>

                        @if (_amortization.Count > 0)
                        {
                            <div style="margin-top:var(--gap-md);">
                                <SfGrid TValue="AmortizationLine" DataSource="_amortization" AllowPaging="false" GridLines="GridLine.Both">
                                    <GridColumns>
                                        <GridColumn Field="@nameof(AmortizationLine.Period)" HeaderText="Cuota" Width="70" TextAlign="TextAlign.Center" />
                                        <GridColumn Field="@nameof(AmortizationLine.PaymentDate)" HeaderText="Fecha" Width="110" Format="d" />
                                        <GridColumn Field="@nameof(AmortizationLine.Capital)" HeaderText="Capital" Width="130" TextAlign="TextAlign.Right" Format="N0" />
                                        <GridColumn Field="@nameof(AmortizationLine.Interest)" HeaderText="Interes" Width="130" TextAlign="TextAlign.Right" Format="N0" />
                                        <GridColumn Field="@nameof(AmortizationLine.Total)" HeaderText="Total" Width="130" TextAlign="TextAlign.Right" Format="N0" />
                                        <GridColumn Field="@nameof(AmortizationLine.RemainingBalance)" HeaderText="Saldo" Width="140" TextAlign="TextAlign.Right" Format="N0" />
                                    </GridColumns>
                                </SfGrid>
                            </div>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- Tab 5: Resumen -->
            <TabItem>
                <ChildContent><TabHeader Text="Resumen" IconCss="e-icons e-description" /></ChildContent>
                <ContentTemplate>
                    <div class="panel-pestana">
                        @if (_detail is not null)
                        {
                            <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:var(--gap-md);max-width:600px;">
                                <span class="texto-tenue">Solicitud:</span><span>@_detail.ApplicationNumber</span>
                                <span class="texto-tenue">Asociado:</span><span>@_detail.PersonName</span>
                                <span class="texto-tenue">Documento:</span><span>@_detail.IdentificationNumber</span>
                                <span class="texto-tenue">Linea:</span><span>@_detail.CreditLineName</span>
                                <span class="texto-tenue">Monto Solicitado:</span><span>@_detail.RequestedAmount.ToString("N0")</span>
                                <span class="texto-tenue">Monto Aprobado:</span><span>@_detail.ApprovedAmount.ToString("N0")</span>
                                <span class="texto-tenue">Plazo:</span><span>@_detail.Term meses</span>
                                <span class="texto-tenue">Tasa:</span><span>@_detail.InterestRate.ToString("N2")%</span>
                                <span class="texto-tenue">Cuota:</span><span>@_detail.InstallmentAmount.ToString("N0")</span>
                                <span class="texto-tenue">Fecha Solicitud:</span><span>@_detail.ApplicationDate</span>
                                <span class="texto-tenue">Fecha Aprobacion:</span><span>@(_detail.ApprovalDate?.ToString() ?? "-")</span>
                                <span class="texto-tenue">Fecha Desembolso:</span><span>@(_detail.DisbursementDate?.ToString() ?? "-")</span>
                                <span class="texto-tenue">Elaboro:</span><span>@_detail.EntryUserId</span>
                                <span class="texto-tenue">Autorizo:</span><span>@_detail.AuthorizingUserId</span>
                            </div>
                            @if (!string.IsNullOrEmpty(_detail.Remarks))
                            {
                                <div class="panel-resumen">
                                    <h5>Observaciones</h5>
                                    <pre class="texto-tenue" style="white-space:pre-wrap;font-size:var(--texto-sm);">@_detail.Remarks</pre>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="texto-tenue">Guarde la solicitud para ver el resumen.</p>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>
        </TabItems>
    </SfTab>
}

<!-- Approval Dialog -->
<SfDialog Width="450px" IsModal="true" @bind-Visible="_showApprove" Header="Aprobar Solicitud"
          ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <div style="display:flex;flex-direction:column;gap:var(--gap-md);">
                <div>
                    <label>Monto Aprobado *</label>
                    <SfNumericTextBox TValue="decimal" @bind-Value="_approveForm.ApprovedAmount" Format="N0" Min="0" />
                </div>
                <div>
                    <label>Plazo Aprobado *</label>
                    <SfNumericTextBox TValue="int" @bind-Value="_approveForm.ApprovedTerm" Min="1" Max="360" />
                </div>
                <div>
                    <label>Tasa Aprobada *</label>
                    <SfNumericTextBox TValue="decimal" @bind-Value="_approveForm.ApprovedRate" Format="N2" />
                </div>
                <div>
                    <label>Numero Acta</label>
                    <SfTextBox @bind-Value="_approveForm.MinutesNumber" />
                </div>
                <div>
                    <label>Observaciones</label>
                    <SfTextBox @bind-Value="_approveForm.Notes" Multiline="true" />
                </div>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _showApprove = false)" />
        <DialogButton Content="Aprobar" CssClass="e-success" IsPrimary="true" OnClick="ApproveApplication" />
    </DialogButtons>
</SfDialog>

<!-- Reject Dialog -->
<SfDialog Width="400px" IsModal="true" @bind-Visible="_showReject" Header="Rechazar Solicitud"
          ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <div>
                <label>Motivo de Rechazo *</label>
                <SfTextBox @bind-Value="_rejectReason" Multiline="true" />
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _showReject = false)" />
        <DialogButton Content="Rechazar" CssClass="e-danger" IsPrimary="true" OnClick="RejectApplication" />
    </DialogButtons>
</SfDialog>

<!-- Disburse Dialog -->
<SfDialog Width="400px" IsModal="true" @bind-Visible="_showDisburse" Header="Desembolsar Credito"
          ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <div style="display:flex;flex-direction:column;gap:var(--gap-md);">
                <div>
                    <label>Fecha de Desembolso *</label>
                    <SfDatePicker TValue="DateTime" @bind-Value="_disburseDate" Format="dd/MM/yyyy" />
                </div>
                <div>
                    <label>Cuenta Banco (opcional)</label>
                    <SfTextBox @bind-Value="_bankAccountCode" Placeholder="Codigo cuenta contable" />
                </div>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _showDisburse = false)" />
        <DialogButton Content="Desembolsar" CssClass="e-info" IsPrimary="true" OnClick="DisburseApplication" />
    </DialogButtons>
</SfDialog>

@code {
    [Parameter] public Guid? ApplicationId { get; set; }

    private bool _isNew => ApplicationId == null || ApplicationId == Guid.Empty;
    private bool _loading = true;
    private bool _saving;

    // Data
    private ApplicationDetailResponse? _detail;
    private List<PersonSearchResult> _searchResults = [];
    private PersonSearchResult? _selectedPerson;
    private List<AmortizationLine> _amortization = [];
    private List<CreditLineItem> _creditLines = [];
    private string _searchTerm = "";

    // Form
    private ApplicationForm _form = new();

    // Dialogs
    private bool _showApprove, _showReject, _showDisburse;
    private ApproveForm _approveForm = new();
    private string _rejectReason = "";
    private DateTime _disburseDate = DateTime.Today;
    private string _bankAccountCode = "";

    private List<GuaranteeItem> _guaranteeTypes =
    [
        new("PG", "Pagare"),
        new("HI", "Hipoteca"),
        new("PR", "Prenda"),
        new("CD", "CDAT"),
        new("FI", "Fianza"),
        new("AP", "Aportes")
    ];

    protected override async Task OnInitializedAsync()
    {
        await LoadCreditLines();
    }

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        if (!_isNew)
        {
            try
            {
                _detail = await Http.GetFromJsonAsync<ApplicationDetailResponse>($"api/lending/loan-applications/{ApplicationId}");
                if (_detail is not null)
                {
                    _form = new()
                    {
                        CreditLinePublicId = "", // resolved from detail
                        RequestedAmount = _detail.RequestedAmount,
                        RequestedTerm = _detail.Term,
                        InterestRate = _detail.InterestRate,
                        GuaranteeType = _detail.GuaranteeType,
                        Purpose = _detail.Remarks
                    };
                    _approveForm = new()
                    {
                        ApprovedAmount = _detail.ApprovedAmount > 0 ? _detail.ApprovedAmount : _detail.RequestedAmount,
                        ApprovedTerm = _detail.Term,
                        ApprovedRate = _detail.InterestRate
                    };
                    _selectedPerson = new(_detail.PersonName, _detail.IdentificationNumber, default, true, false, null, null);
                }
            }
            catch (Exception ex)
            {
                await Notification.ErrorAsync($"Error cargando solicitud: {ex.Message}");
            }
        }
        _loading = false;
    }

    private async Task LoadCreditLines()
    {
        try
        {
            // Load from CreditLineParameters via a simple endpoint
            // For now, create sample data - will be wired to actual endpoint
            _creditLines = [];
        }
        catch { /* graceful fallback */ }
    }

    private async Task SearchPerson()
    {
        if (string.IsNullOrWhiteSpace(_searchTerm)) return;
        try
        {
            _searchResults = await Http.GetListAsync<PersonSearchResult>(
                $"api/core/people/search?q={Uri.EscapeDataString(_searchTerm)}") ?? [];
        }
        catch (Exception ex)
        {
            await Notification.ErrorAsync($"Error buscando: {ex.Message}");
        }
    }

    private void SelectPerson(PersonSearchResult person)
    {
        _selectedPerson = person;
        _searchResults = [];
    }

    private async Task OnCreditLineChanged(Syncfusion.Blazor.DropDowns.ChangeEventArgs<string, CreditLineItem> args)
    {
        if (args.ItemData is not null)
            _form.InterestRate = args.ItemData.InterestRate;
    }

    private async Task CalculateAmortization()
    {
        try
        {
            _amortization = await Http.GetListAsync<AmortizationLine>(
                $"api/lending/loan-applications/{ApplicationId}/amortization") ?? [];

            if (_amortization.Count == 0 && _form.RequestedAmount > 0 && _form.RequestedTerm > 0)
            {
                // Client-side preview for new applications
                var rate = _form.InterestRate / 100m / 12m;
                decimal installment;
                if (rate > 0)
                {
                    var factor = (double)rate * Math.Pow(1 + (double)rate, _form.RequestedTerm)
                                 / (Math.Pow(1 + (double)rate, _form.RequestedTerm) - 1);
                    installment = _form.RequestedAmount * (decimal)factor;
                }
                else installment = _form.RequestedAmount / _form.RequestedTerm;
                installment = Math.Round(installment, 0);

                var balance = _form.RequestedAmount;
                _amortization = [];
                for (int i = 1; i <= _form.RequestedTerm; i++)
                {
                    var interest = Math.Round(balance * rate, 0);
                    var capital = installment - interest;
                    if (i == _form.RequestedTerm) capital = balance;
                    if (capital > balance) capital = balance;
                    _amortization.Add(new(i, DateOnly.FromDateTime(DateTime.Today.AddMonths(i)),
                        capital, interest, capital + interest, balance - capital));
                    balance -= capital;
                    if (balance < 0) balance = 0;
                }
            }
        }
        catch (Exception ex)
        {
            await Notification.ErrorAsync($"Error: {ex.Message}");
        }
    }

    private async Task SaveApplication()
    {
        if (_selectedPerson is null)
        {
            await Notification.WarningAsync("Seleccione un asociado.");
            return;
        }
        _saving = true;
        try
        {
            var payload = new
            {
                PersonPublicId = _selectedPerson.PublicId,
                CreditLinePublicId = _form.CreditLinePublicId,
                _form.RequestedAmount,
                _form.RequestedTerm,
                _form.Purpose,
                _form.GuaranteeType
            };
            var response = await Http.PostAsJsonAsync("api/lending/loan-applications", payload);
            if (response.IsSuccessStatusCode)
            {
                var publicId = await response.Content.ReadFromJsonAsync<Guid>();
                await Notification.SuccessAsync("Solicitud creada exitosamente.");
                Nav.NavigateTo($"/cartera/solicitudes/{publicId}");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                await Notification.ErrorAsync($"Error: {error}");
            }
        }
        catch (Exception ex) { await Notification.ErrorAsync(ex.Message); }
        finally { _saving = false; }
    }

    private async Task ApproveApplication()
    {
        try
        {
            var payload = new
            {
                _approveForm.ApprovedAmount,
                _approveForm.ApprovedTerm,
                _approveForm.ApprovedRate,
                ApproverNotes = _approveForm.Notes,
                _approveForm.MinutesNumber
            };
            var response = await Http.PostAsJsonAsync($"api/lending/loan-applications/{ApplicationId}/approve", payload);
            if (response.IsSuccessStatusCode)
            {
                _showApprove = false;
                await Notification.SuccessAsync("Solicitud aprobada.");
                Nav.NavigateTo($"/cartera/solicitudes/{ApplicationId}", forceLoad: true);
            }
            else await Notification.ErrorAsync(await response.Content.ReadAsStringAsync());
        }
        catch (Exception ex) { await Notification.ErrorAsync(ex.Message); }
    }

    private async Task RejectApplication()
    {
        if (string.IsNullOrWhiteSpace(_rejectReason)) { await Notification.WarningAsync("Ingrese motivo de rechazo."); return; }
        try
        {
            var payload = new { RejectionReason = _rejectReason };
            var response = await Http.PostAsJsonAsync($"api/lending/loan-applications/{ApplicationId}/reject", payload);
            if (response.IsSuccessStatusCode)
            {
                _showReject = false;
                await Notification.SuccessAsync("Solicitud rechazada.");
                Nav.NavigateTo($"/cartera/solicitudes/{ApplicationId}", forceLoad: true);
            }
            else await Notification.ErrorAsync(await response.Content.ReadAsStringAsync());
        }
        catch (Exception ex) { await Notification.ErrorAsync(ex.Message); }
    }

    private async Task DisburseApplication()
    {
        try
        {
            var payload = new
            {
                DisbursementDate = DateOnly.FromDateTime(_disburseDate),
                BankAccountCode = string.IsNullOrEmpty(_bankAccountCode) ? (string?)null : _bankAccountCode,
                VoucherTypeCode = (string?)null
            };
            var response = await Http.PostAsJsonAsync($"api/lending/loan-applications/{ApplicationId}/disburse", payload);
            if (response.IsSuccessStatusCode)
            {
                _showDisburse = false;
                await Notification.SuccessAsync("Credito desembolsado exitosamente.");
                Nav.NavigateTo($"/cartera/solicitudes/{ApplicationId}", forceLoad: true);
            }
            else await Notification.ErrorAsync(await response.Content.ReadAsStringAsync());
        }
        catch (Exception ex) { await Notification.ErrorAsync(ex.Message); }
    }

    private (string css, string text) GetStatusBadge(string status) => status switch
    {
        "R" => ("badge-radicada", "Radicada"),
        "A" => ("badge-aprobada", "Aprobada"),
        "X" => ("badge-rechazada", "Rechazada"),
        "D" => ("badge-desembolsada", "Desembolsada"),
        _ => ("badge-cancelada", status)
    };

    // --- Local types ---
    record PersonSearchResult(string FullName, string IdentificationNumber, Guid PublicId,
        bool IsAssociate, bool IsEmployee, string? CityName, string? Status);
    record CreditLineItem(string PublicId, string Description, decimal InterestRate, int MaxTerm, decimal MaxAmount);
    record GuaranteeItem(string Value, string Text);
    record AmortizationLine(int Period, DateOnly PaymentDate, decimal Capital, decimal Interest, decimal Total, decimal RemainingBalance);

    class ApplicationForm
    {
        public string CreditLinePublicId { get; set; } = "";
        public decimal RequestedAmount { get; set; }
        public int RequestedTerm { get; set; }
        public decimal InterestRate { get; set; }
        public string GuaranteeType { get; set; } = "";
        public string? Purpose { get; set; }
    }

    class ApproveForm
    {
        public decimal ApprovedAmount { get; set; }
        public int ApprovedTerm { get; set; }
        public decimal ApprovedRate { get; set; }
        public string? MinutesNumber { get; set; }
        public string? Notes { get; set; }
    }

    record ApplicationDetailResponse(
        Guid PublicId, int ApplicationNumber, string PersonCode, string PersonName,
        string IdentificationNumber, string CreditLineName, int CreditLineId,
        decimal RequestedAmount, decimal ApprovedAmount, int Term, decimal InterestRate,
        decimal InstallmentAmount, string Status, string StatusText,
        DateOnly ApplicationDate, DateOnly? ApprovalDate, DateOnly? DisbursementDate,
        string GuaranteeType, string Periodicity, string? Remarks,
        decimal Salary, decimal OtherIncome, decimal MonthlyDeductions, decimal PaymentCapacity,
        string Codeudor1, string Codeudor2, string EntryUserId, string AuthorizingUserId);
}
