@page "/cartera/ahorros/{AccountId:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Nav
@inject INotificationService Notification

<PageTitle>Cuenta #@(_detail?.AccountNumber) - IngenIA365ERP</PageTitle>

<div class="page-header" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;">
    <h3>Cuenta #@(_detail?.AccountNumber ?? 0) - @(_detail?.PersonName ?? "Cargando...")</h3>
    <div style="display:flex;gap:8px;">
        <SfButton CssClass="e-flat" IconCss="e-icons e-arrow-left"
                  OnClick='@(() => Nav.NavigateTo("/cartera/ahorros"))'>Volver</SfButton>
    </div>
</div>

@if (_loading)
{
    <div style="display:flex;justify-content:center;padding:40px;">
        <SfSpinner Visible="true" />
    </div>
}
else if (_detail is not null)
{
    <!-- Summary cards -->
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:12px;margin-bottom:20px;">
        <div class="kpi-card">
            <span class="kpi-label">No. Cuenta</span>
            <span class="kpi-value">@_detail.AccountNumber</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-label">Saldo</span>
            <span class="kpi-value" style="color:@(_detail.Balance > 0 ? "#27ae60" : "#888")">@_detail.Balance.ToString("N0")</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-label">Linea de Ahorro</span>
            <span class="kpi-value" style="font-size:14px;">@_detail.SavingsLineName</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-label">Fecha Apertura</span>
            <span class="kpi-value" style="font-size:14px;">@_detail.CreationDate</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-label">Estado</span>
            <span class="kpi-value" style="color:@(_detail.Status == "Activa" ? "#27ae60" : "#e74c3c")">@_detail.Status</span>
        </div>
    </div>

    <SfTab>
        <TabItems>
            <!-- Tab 1: Datos -->
            <TabItem>
                <ChildContent><TabHeader Text="Datos" IconCss="e-icons e-description" /></ChildContent>
                <ContentTemplate>
                    <div style="padding:16px;">
                        <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:10px;max-width:600px;">
                            <span style="color:#888;">Asociado:</span><span>@_detail.PersonName</span>
                            <span style="color:#888;">Codigo:</span><span>@_detail.PersonCode</span>
                            <span style="color:#888;">No. Cuenta:</span><span>@_detail.AccountNumber</span>
                            <span style="color:#888;">Linea:</span><span>@_detail.SavingsLineName</span>
                            <span style="color:#888;">Periodicidad:</span><span>@_detail.Periodicity</span>
                            <span style="color:#888;">Ciclo de Pago:</span><span>@_detail.PaymentCycle</span>
                            <span style="color:#888;">Vencimiento:</span><span>@(_detail.MaturityDate?.ToString() ?? "Sin vencimiento")</span>
                        </div>
                    </div>
                </ContentTemplate>
            </TabItem>
            <!-- Tab 2: Movimientos -->
            <TabItem>
                <ChildContent><TabHeader Text="Movimientos" IconCss="e-icons e-list-unordered" /></ChildContent>
                <ContentTemplate>
                    <div style="padding:16px;">
                        <SfGrid TValue="DepositEntryRow" DataSource="_detail.Entries" AllowPaging="true" AllowSorting="true"
                                GridLines="GridLine.Both">
                            <GridPageSettings PageSize="15" />
                            <GridColumns>
                                <GridColumn Field="@nameof(DepositEntryRow.EntryDate)" HeaderText="Fecha" Width="120" Format="d" />
                                <GridColumn Field="@nameof(DepositEntryRow.EntryTypeText)" HeaderText="Tipo" Width="100" TextAlign="TextAlign.Center">
                                    <Template>
                                        @{
                                            var entry = context as DepositEntryRow;
                                            var css = entry?.EntryType == "D" ? "badge-deposito" : "badge-retiro";
                                        }
                                        <span class="@css">@entry?.EntryTypeText</span>
                                    </Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(DepositEntryRow.Amount)" HeaderText="Monto" Width="140" TextAlign="TextAlign.Right" Format="N0" />
                                <GridColumn Field="@nameof(DepositEntryRow.UserId)" HeaderText="Usuario" Width="120" />
                            </GridColumns>
                        </SfGrid>
                    </div>
                </ContentTemplate>
            </TabItem>
            <!-- Tab 3: Operaciones -->
            <TabItem>
                <ChildContent><TabHeader Text="Operaciones" IconCss="e-icons e-settings" /></ChildContent>
                <ContentTemplate>
                    <div style="padding:16px;display:flex;gap:12px;flex-wrap:wrap;">
                        @if (_detail.Status == "Activa")
                        {
                            <SfButton CssClass="e-success" IconCss="e-icons e-plus" OnClick="ShowDepositDialog">Depositar</SfButton>
                            <SfButton CssClass="e-warning" IconCss="e-icons e-minus" OnClick="ShowWithdrawDialog">Retirar</SfButton>
                            <SfButton CssClass="e-danger" IconCss="e-icons e-close" OnClick="ShowCloseDialog">Cerrar Cuenta</SfButton>
                        }
                        else
                        {
                            <p style="color:#888;">La cuenta esta cerrada. No se permiten operaciones.</p>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>
        </TabItems>
    </SfTab>
}

<!-- Dialog: Depositar -->
<SfDialog @bind-Visible="_showDepositDialog" Header="Depositar" Width="380px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <div style="display:flex;flex-direction:column;gap:12px;padding:8px;">
                <label>Monto</label>
                <SfNumericTextBox TValue="decimal" @bind-Value="_operationAmount" Min="1" Format="N0" />
                <label>Referencia (opcional)</label>
                <SfTextBox @bind-Value="_operationReference" />
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _showDepositDialog = false)" />
        <DialogButton Content="Depositar" IsPrimary="true" OnClick="ExecuteDeposit" />
    </DialogButtons>
</SfDialog>

<!-- Dialog: Retirar -->
<SfDialog @bind-Visible="_showWithdrawDialog" Header="Retirar" Width="380px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <div style="display:flex;flex-direction:column;gap:12px;padding:8px;">
                <label>Saldo disponible: <strong>@(_detail?.Balance.ToString("N0") ?? "0")</strong></label>
                <label>Monto</label>
                <SfNumericTextBox TValue="decimal" @bind-Value="_operationAmount" Min="1" Format="N0" />
                <label>Referencia (opcional)</label>
                <SfTextBox @bind-Value="_operationReference" />
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _showWithdrawDialog = false)" />
        <DialogButton Content="Retirar" IsPrimary="true" OnClick="ExecuteWithdraw" />
    </DialogButtons>
</SfDialog>

<!-- Dialog: Cerrar cuenta -->
<SfDialog @bind-Visible="_showCloseDialog" Header="Cerrar Cuenta" Width="400px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <div style="padding:8px;">
                <p>Esta seguro de cerrar esta cuenta?</p>
                @if (_detail?.Balance > 0)
                {
                    <p style="color:#f39c12;">Se realizara un retiro automatico del saldo restante de <strong>@_detail.Balance.ToString("N0")</strong>.</p>
                }
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _showCloseDialog = false)" />
        <DialogButton Content="Cerrar Cuenta" CssClass="e-danger" OnClick="ExecuteClose" />
    </DialogButtons>
</SfDialog>

<style>
    .badge-deposito { background:#27ae60; color:#fff; padding:2px 10px; border-radius:12px; font-size:12px; }
    .badge-retiro { background:#e74c3c; color:#fff; padding:2px 10px; border-radius:12px; font-size:12px; }
</style>

@code {
    [Parameter] public Guid AccountId { get; set; }

    private SavingsAccountDetail? _detail;
    private bool _loading = true;

    // Operation dialogs
    private bool _showDepositDialog;
    private bool _showWithdrawDialog;
    private bool _showCloseDialog;
    private decimal _operationAmount;
    private string _operationReference = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadDetail();
    }

    private async Task LoadDetail()
    {
        _loading = true;
        try
        {
            _detail = await Http.GetFromJsonAsync<SavingsAccountDetail>($"api/lending/savings-accounts/{AccountId}");
        }
        catch (Exception ex)
        {
            await Notification.ErrorAsync($"Error: {ex.Message}");
        }
        _loading = false;
    }

    private void ShowDepositDialog()
    {
        _operationAmount = 0;
        _operationReference = "";
        _showDepositDialog = true;
    }

    private void ShowWithdrawDialog()
    {
        _operationAmount = 0;
        _operationReference = "";
        _showWithdrawDialog = true;
    }

    private void ShowCloseDialog()
    {
        _showCloseDialog = true;
    }

    private async Task ExecuteDeposit()
    {
        if (_operationAmount <= 0) { await Notification.ErrorAsync("Ingrese un monto valido."); return; }
        try
        {
            var response = await Http.PostAsJsonAsync($"api/lending/savings-accounts/{AccountId}/deposit",
                new { Amount = _operationAmount, Reference = _operationReference });
            if (response.IsSuccessStatusCode)
            {
                await Notification.SuccessAsync("Deposito registrado.");
                _showDepositDialog = false;
                await LoadDetail();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                await Notification.ErrorAsync($"Error: {error}");
            }
        }
        catch (Exception ex) { await Notification.ErrorAsync($"Error: {ex.Message}"); }
    }

    private async Task ExecuteWithdraw()
    {
        if (_operationAmount <= 0) { await Notification.ErrorAsync("Ingrese un monto valido."); return; }
        try
        {
            var response = await Http.PostAsJsonAsync($"api/lending/savings-accounts/{AccountId}/withdraw",
                new { Amount = _operationAmount, Reference = _operationReference });
            if (response.IsSuccessStatusCode)
            {
                await Notification.SuccessAsync("Retiro registrado.");
                _showWithdrawDialog = false;
                await LoadDetail();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                await Notification.ErrorAsync($"Error: {error}");
            }
        }
        catch (Exception ex) { await Notification.ErrorAsync($"Error: {ex.Message}"); }
    }

    private async Task ExecuteClose()
    {
        try
        {
            var response = await Http.PostAsync($"api/lending/savings-accounts/{AccountId}/close", null);
            if (response.IsSuccessStatusCode)
            {
                await Notification.SuccessAsync("Cuenta cerrada.");
                _showCloseDialog = false;
                Nav.NavigateTo("/cartera/ahorros");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                await Notification.ErrorAsync($"Error: {error}");
            }
        }
        catch (Exception ex) { await Notification.ErrorAsync($"Error: {ex.Message}"); }
    }

    // --- Local types ---
    record SavingsAccountDetail(Guid PublicId, string PersonCode, string PersonName, long AccountNumber,
        int SavingsLineId, string SavingsLineName, DateOnly CreationDate, DateOnly? MaturityDate,
        string Periodicity, string PaymentCycle, decimal Balance, string Status,
        List<DepositEntryRow> Entries);

    record DepositEntryRow(Guid PublicId, DateOnly EntryDate, string EntryType, string EntryTypeText,
        decimal Amount, string UserId);
}
