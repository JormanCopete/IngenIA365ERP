@page "/nomina/parametros-retencion"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification

<PageTitle>Parametros de Retencion - IngenIA365ERP</PageTitle>

<div class="page-header">
    <h3>Parametros de Retencion en la Fuente</h3>
    <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@OpenCreate">Nuevo</SfButton>
</div>

<SfGrid @ref="_grid" TValue="ItemModel" DataSource="@_items" AllowPaging="true" AllowSorting="true" AllowFiltering="true">
    <GridColumns>
        <GridColumn Field="PayrollCompanyId" HeaderText="Empresa" Width="110" TextAlign="TextAlign.Center" />
        <GridColumn Field="UvtRangeStart" HeaderText="UVT Desde" Width="120" TextAlign="TextAlign.Right" />
        <GridColumn Field="UvtRangeEnd" HeaderText="UVT Hasta" Width="120" TextAlign="TextAlign.Right" />
        <GridColumn Field="Rate" HeaderText="Tarifa" Width="130" Format="N4" TextAlign="TextAlign.Right" />
        <GridColumn Field="AdditionalUvt" HeaderText="UVT Adicional" Width="130" TextAlign="TextAlign.Right" />
        <GridColumn HeaderText="Acciones" Width="150" TextAlign="TextAlign.Center">
            <Template>
                @{
                    var item = context as ItemModel;
                    <SfButton CssClass="e-flat e-small" IconCss="e-icons e-edit" OnClick="@(() => OpenEdit(item!))" />
                    <SfButton CssClass="e-flat e-small e-danger" IconCss="e-icons e-trash" OnClick="@(() => OpenDelete(item!))" />
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

<SfDialog @bind-Visible="_showDialog" Header="@_dialogTitle" Width="500px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <div class="pagina">
                <SfNumericTextBox TValue="int" @bind-Value="_model.PayrollCompanyId" Placeholder="Empresa Nomina" FloatLabelType="FloatLabelType.Always" />
                <SfNumericTextBox TValue="int" @bind-Value="_model.UvtRangeStart" Placeholder="UVT Rango Inicio" FloatLabelType="FloatLabelType.Always" />
                <SfNumericTextBox TValue="int" @bind-Value="_model.UvtRangeEnd" Placeholder="UVT Rango Fin" FloatLabelType="FloatLabelType.Always" />
                <SfNumericTextBox TValue="decimal" @bind-Value="_model.Rate" Placeholder="Tarifa" Format="N4" FloatLabelType="FloatLabelType.Always" />
                <SfNumericTextBox TValue="int" @bind-Value="_model.AdditionalUvt" Placeholder="UVT Adicional" FloatLabelType="FloatLabelType.Always" />
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _showDialog = false)" />
        <DialogButton Content="Guardar" IsPrimary="true" OnClick="@Save" />
    </DialogButtons>
</SfDialog>

<ConfirmDialog @bind-Visible="_showConfirm" OnConfirm="ConfirmDelete" Message="Esta seguro de eliminar este registro?" />

@code {
    private SfGrid<ItemModel>? _grid;
    private List<ItemModel> _items = [];
    private FormModel _model = new();
    private Guid? _editId;
    private bool _showDialog, _showConfirm;
    private string _dialogTitle = "";
    private Guid _deleteId;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        try { var r = await Http.GetFromJsonAsync<Paged>("/api/payroll/withholding-parameters?pageSize=500"); _items = r?.Items ?? []; }
        catch { _items = []; }
    }

    private void OpenCreate() { _model = new(); _editId = null; _dialogTitle = "Nuevo Parametro de Retencion"; _showDialog = true; }

    private void OpenEdit(ItemModel item)
    {
        _model = new()
        {
            PayrollCompanyId = item.PayrollCompanyId, UvtRangeStart = item.UvtRangeStart,
            UvtRangeEnd = item.UvtRangeEnd, Rate = item.Rate, AdditionalUvt = item.AdditionalUvt
        };
        _editId = item.PublicId; _dialogTitle = "Editar Parametro de Retencion"; _showDialog = true;
    }

    private void OpenDelete(ItemModel item) { _deleteId = item.PublicId; _showConfirm = true; }

    private async Task Save()
    {
        var res = _editId.HasValue
            ? await Http.PutAsJsonAsync($"/api/payroll/withholding-parameters/{_editId}", _model)
            : await Http.PostAsJsonAsync("/api/payroll/withholding-parameters", _model);
        if (res.IsSuccessStatusCode) { await Notification.SuccessAsync("Guardado"); _showDialog = false; await LoadData(); }
        else await Notification.ShowErrorAsync(res, "Error al guardar");
    }

    private async Task ConfirmDelete()
    {
        var res = await Http.DeleteAsync($"/api/payroll/withholding-parameters/{_deleteId}");
        if (res.IsSuccessStatusCode) { await Notification.SuccessAsync("Eliminado"); await LoadData(); }
        else await Notification.ShowErrorAsync(res, "Error al eliminar");
    }

    private class Paged { public List<ItemModel> Items { get; set; } = []; }
    private class ItemModel
    {
        public Guid PublicId { get; set; }
        public int PayrollCompanyId { get; set; }
        public int UvtRangeStart { get; set; }
        public int UvtRangeEnd { get; set; }
        public decimal Rate { get; set; }
        public int AdditionalUvt { get; set; }
    }
    private class FormModel
    {
        public int PayrollCompanyId { get; set; }
        public int UvtRangeStart { get; set; }
        public int UvtRangeEnd { get; set; }
        public decimal Rate { get; set; }
        public int AdditionalUvt { get; set; }
    }
}
