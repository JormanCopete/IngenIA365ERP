@page "/nomina/periodos-pago"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification

<PageTitle>Periodos de Pago - IngenIA365ERP</PageTitle>

<div class="page-header">
    <h3>Periodos de Pago</h3>
    <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@OpenCreate">Nuevo</SfButton>
</div>

<SfGrid @ref="_grid" TValue="ItemModel" DataSource="@_items" AllowPaging="true" AllowSorting="true" AllowFiltering="true">
    <GridColumns>
        <GridColumn Field="PlanId" HeaderText="Plan" Width="100" TextAlign="TextAlign.Center" />
        <GridColumn Field="Description" HeaderText="Descripcion" Width="220" />
        <GridColumn Field="StartDate" HeaderText="Fecha Inicio" Width="140" Format="d" TextAlign="TextAlign.Center" />
        <GridColumn Field="EndDate" HeaderText="Fecha Fin" Width="140" Format="d" TextAlign="TextAlign.Center" />
        <GridColumn Field="PeriodId" HeaderText="Periodo" Width="100" TextAlign="TextAlign.Center" />
        <GridColumn Field="Status" HeaderText="Estado" Width="100" TextAlign="TextAlign.Center" />
        <GridColumn Field="StatusMessage" HeaderText="Mensaje Estado" Width="180" />
        <GridColumn HeaderText="Acciones" Width="150" TextAlign="TextAlign.Center">
            <Template>
                @{
                    var item = context as ItemModel;
                    <SfButton CssClass="e-flat e-small" IconCss="e-icons e-edit" OnClick="@(() => OpenEdit(item!))" />
                    <SfButton CssClass="e-flat e-small e-danger" IconCss="e-icons e-trash" OnClick="@(() => OpenDelete(item!))" />
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

<SfDialog @bind-Visible="_showDialog" Header="@_dialogTitle" Width="550px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <div style="padding:10px;display:flex;flex-direction:column;gap:16px;">
                <SfNumericTextBox TValue="int" @bind-Value="_model.PlanId" Placeholder="Plan" FloatLabelType="FloatLabelType.Always" />
                <SfNumericTextBox TValue="int" @bind-Value="_model.PayrollCompanyId" Placeholder="Empresa Nomina" FloatLabelType="FloatLabelType.Always" />
                <SfTextBox @bind-Value="_model.Description" Placeholder="Descripcion" FloatLabelType="FloatLabelType.Always" />
                <SfDatePicker TValue="DateTime" @bind-Value="_model.StartDate" Placeholder="Fecha Inicio" FloatLabelType="FloatLabelType.Always" />
                <SfDatePicker TValue="DateTime" @bind-Value="_model.EndDate" Placeholder="Fecha Fin" FloatLabelType="FloatLabelType.Always" />
                <SfNumericTextBox TValue="int" @bind-Value="_model.PeriodId" Placeholder="Periodo" FloatLabelType="FloatLabelType.Always" />
                <SfNumericTextBox TValue="int" @bind-Value="_model.Status" Placeholder="Estado" FloatLabelType="FloatLabelType.Always" />
                <SfTextBox @bind-Value="_model.StatusMessage" Placeholder="Mensaje Estado" FloatLabelType="FloatLabelType.Always" />
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _showDialog = false)" />
        <DialogButton Content="Guardar" IsPrimary="true" OnClick="@Save" />
    </DialogButtons>
</SfDialog>

<ConfirmDialog @bind-Visible="_showConfirm" OnConfirm="ConfirmDelete" Message="Esta seguro de eliminar este registro?" />

@code {
    private SfGrid<ItemModel>? _grid;
    private List<ItemModel> _items = [];
    private FormModel _model = new();
    private Guid? _editId;
    private bool _showDialog, _showConfirm;
    private string _dialogTitle = "";
    private Guid _deleteId;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        try { var r = await Http.GetFromJsonAsync<Paged>("/api/payroll/pay-periods?pageSize=500"); _items = r?.Items ?? []; }
        catch { _items = []; }
    }

    private void OpenCreate() { _model = new(); _editId = null; _dialogTitle = "Nuevo Periodo de Pago"; _showDialog = true; }

    private void OpenEdit(ItemModel item)
    {
        _model = new()
        {
            PlanId = item.PlanId, PayrollCompanyId = item.PayrollCompanyId, Description = item.Description,
            StartDate = item.StartDate, EndDate = item.EndDate, PeriodId = item.PeriodId,
            Status = item.Status, StatusMessage = item.StatusMessage
        };
        _editId = item.PublicId; _dialogTitle = "Editar Periodo de Pago"; _showDialog = true;
    }

    private void OpenDelete(ItemModel item) { _deleteId = item.PublicId; _showConfirm = true; }

    private async Task Save()
    {
        var res = _editId.HasValue
            ? await Http.PutAsJsonAsync($"/api/payroll/pay-periods/{_editId}", _model)
            : await Http.PostAsJsonAsync("/api/payroll/pay-periods", _model);
        if (res.IsSuccessStatusCode) { await Notification.SuccessAsync("Guardado"); _showDialog = false; await LoadData(); }
        else await Notification.ShowErrorAsync(res, "Error al guardar");
    }

    private async Task ConfirmDelete()
    {
        var res = await Http.DeleteAsync($"/api/payroll/pay-periods/{_deleteId}");
        if (res.IsSuccessStatusCode) { await Notification.SuccessAsync("Eliminado"); await LoadData(); }
        else await Notification.ShowErrorAsync(res, "Error al eliminar");
    }

    private class Paged { public List<ItemModel> Items { get; set; } = []; }
    private class ItemModel
    {
        public Guid PublicId { get; set; }
        public int PlanId { get; set; }
        public int PayrollCompanyId { get; set; }
        public string Description { get; set; } = "";
        public DateTime StartDate { get; set; }
        public DateTime EndDate { get; set; }
        public int PeriodId { get; set; }
        public int Status { get; set; }
        public string StatusMessage { get; set; } = "";
    }
    private class FormModel
    {
        public int PlanId { get; set; }
        public int PayrollCompanyId { get; set; }
        public string Description { get; set; } = "";
        public DateTime StartDate { get; set; } = DateTime.Today;
        public DateTime EndDate { get; set; } = DateTime.Today;
        public int PeriodId { get; set; }
        public int Status { get; set; }
        public string StatusMessage { get; set; } = "";
    }
}
