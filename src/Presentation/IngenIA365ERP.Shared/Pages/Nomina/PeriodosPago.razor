@page "/nomina/periodos-pago"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using IngenIA365ERP.Shared.Services.Nomina
@inject NominaClient Nomina
@inject INotificationService Notification

<PageTitle>Períodos de pago - IngenIA365ERP</PageTitle>

<div class="page-header">
    <h3>Períodos de pago</h3>
    <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@AbrirNuevo">Nuevo</SfButton>
</div>

<div class="toolbar">
    @if (_planes.Count > 1)
    {
        <label>
            Plan
            <select class="e-input" value="@_filtroPlan" @onchange="FiltrarPorPlan">
                <option value="">Todos los planes</option>
                @foreach (var p in _planes)
                {
                    <option value="@p.PublicId">@p.Name (@p.PeriodicidadTexto)</option>
                }
            </select>
        </label>
    }
    <label>
        Estado
        <select class="e-input" value="@_filtroEstado" @onchange="FiltrarPorEstado">
            <option value="">Todos</option>
            <option value="Open">Abiertos</option>
            <option value="Calculated">Calculados</option>
            <option value="Approved">Aprobados</option>
            <option value="Reversed">Reversados</option>
        </select>
    </label>
</div>

<SfGrid TValue="PeriodoPagoDto" DataSource="@_items" AllowPaging="true" AllowSorting="true">
    <GridPageSettings PageSize="20" />
    <GridColumns>
        @if (_planes.Count > 1)
        {
            <GridColumn Field="PlanName" HeaderText="Plan" Width="150" />
        }
        <GridColumn Field="PlanId" HeaderText="Planilla" Width="90" TextAlign="TextAlign.Center" />
        <GridColumn Field="Description" HeaderText="Descripción" Width="200" />
        <GridColumn Field="StartDate" HeaderText="Desde" Width="120" Format="d" TextAlign="TextAlign.Center" />
        <GridColumn Field="EndDate" HeaderText="Hasta" Width="120" Format="d" TextAlign="TextAlign.Center" />
        <GridColumn HeaderText="Estado" Width="120" TextAlign="TextAlign.Center">
            <Template>
                @{
                    var item = (PeriodoPagoDto)context;
                    <span class="e-badge @ClaseEstado(item.Status)">@item.EstadoTexto</span>
                }
            </Template>
        </GridColumn>
        <GridColumn Field="ApprovedBy" HeaderText="Aprobó" Width="140" />
        <GridColumn Field="StatusMessage" HeaderText="Nota" Width="180" />
        <GridColumn HeaderText="Acciones" Width="120" TextAlign="TextAlign.Center">
            <Template>
                @{
                    var item = (PeriodoPagoDto)context;
                    if (item.Status == "Open")
                    {
                        <SfButton CssClass="e-flat e-small" IconCss="e-icons e-edit" Title="Editar" OnClick="@(() => AbrirEditar(item))" />
                        <SfButton CssClass="e-flat e-small e-danger" IconCss="e-icons e-trash" Title="Eliminar" OnClick="@(() => AbrirEliminar(item))" />
                    }
                    else
                    {
                        <span class="texto-tenue">Sólo consulta</span>
                    }
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

<SfDialog @bind-Visible="_mostrarDialogo" Header="@_titulo" Width="560px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <EditForm Model="_modelo" OnValidSubmit="Guardar">
                <DataAnnotationsValidator />
                <div class="pagina">
                    @if (_editId is null && _planes.Count > 1)
                    {
                        <label class="campo">
                            Plan de nómina
                            <select class="e-input" @bind="_modelo.PlanPublicId">
                                @foreach (var p in _planes)
                                {
                                    <option value="@p.PublicId">@p.Name (@p.PeriodicidadTexto)</option>
                                }
                            </select>
                        </label>
                    }
                    <SfTextBox @bind-Value="_modelo.Description" Placeholder="Descripción (p. ej. Marzo 2026)" FloatLabelType="FloatLabelType.Always" />
                    <ValidationMessage For="() => _modelo.Description" />
                    <SfDatePicker TValue="DateTime" @bind-Value="_modelo.StartDate" Placeholder="Desde" FloatLabelType="FloatLabelType.Always" />
                    <SfDatePicker TValue="DateTime" @bind-Value="_modelo.EndDate" Placeholder="Hasta" FloatLabelType="FloatLabelType.Always" />
                    <ValidationMessage For="() => _modelo.EndDate" />
                    <SfTextBox @bind-Value="_modelo.PayDate" Placeholder="Fecha de pago (texto)" FloatLabelType="FloatLabelType.Always" />
                    @if (_editId is null)
                    {
                        <SfNumericTextBox TValue="int" @bind-Value="_modelo.PayrollCompanyId" Placeholder="Empresa de nómina" FloatLabelType="FloatLabelType.Always" />
                        <SfNumericTextBox TValue="int" @bind-Value="_modelo.PlanId" Placeholder="Número de planilla (0 = siguiente)" FloatLabelType="FloatLabelType.Always" />
                    }
                    <SfTextBox @bind-Value="_modelo.StatusMessage" Placeholder="Nota" FloatLabelType="FloatLabelType.Always" />
                    <p class="texto-tenue">El estado lo mueven calcular, aprobar y reversar en Liquidación; aquí no se edita.</p>
                </div>
                <div class="toolbar">
                    <SfButton CssClass="e-flat" type="button" OnClick="@(() => _mostrarDialogo = false)">Cancelar</SfButton>
                    <SfButton CssClass="e-primary" type="submit" Disabled="@_guardando">Guardar</SfButton>
                </div>
            </EditForm>
        </Content>
    </DialogTemplates>
</SfDialog>

<ConfirmDialog @bind-Visible="_mostrarConfirmar" OnConfirm="ConfirmarEliminar" Message="¿Eliminar este período de pago? Sólo se puede si está abierto y sin novedades." />

@code {
    private List<PeriodoPagoDto> _items = [];
    private List<PlanNominaDto> _planes = [];
    private Modelo _modelo = new();
    private Guid? _editId;
    private Guid _eliminarId;
    private bool _mostrarDialogo, _mostrarConfirmar, _guardando;
    private string _titulo = string.Empty;
    private string _filtroPlan = string.Empty;
    private string _filtroEstado = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var planes = await Nomina.ListarPlanesAsync();
        if (planes.IsSuccess) _planes = planes.Value!.ToList();
        else await Notification.ErrorAsync(planes.ErrorMessage ?? "No se pudieron cargar los planes de nómina.");
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        Guid? plan = Guid.TryParse(_filtroPlan, out var g) ? g : null;
        var res = await Nomina.ListarPeriodosAsync(plan, string.IsNullOrEmpty(_filtroEstado) ? null : _filtroEstado, 1, 500);
        if (res.IsSuccess) _items = res.Value!.Items.OrderByDescending(p => p.StartDate).ToList();
        else await Notification.ErrorAsync(res.ErrorMessage ?? "No se pudieron cargar los períodos.");
    }

    private async Task FiltrarPorPlan(Microsoft.AspNetCore.Components.ChangeEventArgs e) { _filtroPlan = e.Value?.ToString() ?? string.Empty; await CargarAsync(); }
    private async Task FiltrarPorEstado(Microsoft.AspNetCore.Components.ChangeEventArgs e) { _filtroEstado = e.Value?.ToString() ?? string.Empty; await CargarAsync(); }

    private void AbrirNuevo()
    {
        var porDefecto = _planes.FirstOrDefault(p => p.IsDefault) ?? _planes.FirstOrDefault();
        var hoy = DateTime.Today;
        _modelo = new Modelo
        {
            PlanPublicId = porDefecto?.PublicId.ToString() ?? string.Empty,
            StartDate = new DateTime(hoy.Year, hoy.Month, 1),
            EndDate = new DateTime(hoy.Year, hoy.Month, DateTime.DaysInMonth(hoy.Year, hoy.Month)),
            Description = hoy.ToString("MMMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("es-CO")),
        };
        _editId = null;
        _titulo = "Nuevo período de pago";
        _mostrarDialogo = true;
    }

    private void AbrirEditar(PeriodoPagoDto item)
    {
        _modelo = new Modelo
        {
            PlanPublicId = item.PlanPublicId.ToString(),
            PlanId = item.PlanId,
            PayrollCompanyId = item.PayrollCompanyId,
            Description = item.Description ?? string.Empty,
            PayDate = item.PayDate,
            StartDate = item.StartDate,
            EndDate = item.EndDate,
            StatusMessage = item.StatusMessage,
        };
        _editId = item.PublicId;
        _titulo = "Editar período de pago";
        _mostrarDialogo = true;
    }

    private void AbrirEliminar(PeriodoPagoDto item) { _eliminarId = item.PublicId; _mostrarConfirmar = true; }

    private async Task Guardar()
    {
        if (_guardando) return;
        _guardando = true;
        try
        {
            if (_editId is null)
            {
                Guid? plan = Guid.TryParse(_modelo.PlanPublicId, out var g) ? g : null;
                var res = await Nomina.CrearPeriodoAsync(new CrearPeriodoPagoRequest(
                    plan, _modelo.PlanId, _modelo.PayrollCompanyId, _modelo.Description, _modelo.PayDate,
                    _modelo.StartDate, _modelo.EndDate, null, _modelo.StatusMessage, 0));
                if (!res.IsSuccess) { await Notification.ErrorAsync(res.ErrorMessage ?? "No se pudo crear el período."); return; }
                await Notification.SuccessAsync("Período creado.");
            }
            else
            {
                var res = await Nomina.ActualizarPeriodoAsync(new ActualizarPeriodoPagoRequest(
                    _editId.Value, _modelo.Description, _modelo.PayDate, _modelo.StartDate, _modelo.EndDate, _modelo.StatusMessage));
                if (!res.IsSuccess) { await Notification.ErrorAsync(res.ErrorMessage ?? "No se pudo actualizar el período."); return; }
                await Notification.SuccessAsync("Período actualizado.");
            }
            _mostrarDialogo = false;
            await CargarAsync();
        }
        finally { _guardando = false; }
    }

    private async Task ConfirmarEliminar()
    {
        var res = await Nomina.EliminarPeriodoAsync(_eliminarId);
        if (res.IsSuccess) { await Notification.SuccessAsync("Período eliminado."); await CargarAsync(); }
        else await Notification.ErrorAsync(res.ErrorMessage ?? "No se pudo eliminar el período.");
    }

    private static string ClaseEstado(string status) => status switch
    {
        "Open" => "e-badge-info",
        "Calculated" => "e-badge-warning",
        "Approved" => "e-badge-success",
        "Reversed" => "e-badge-danger",
        _ => "e-badge-secondary",
    };

    private sealed class Modelo
    {
        public string PlanPublicId { get; set; } = string.Empty;
        public int PlanId { get; set; }
        public int PayrollCompanyId { get; set; }

        [StringLength(100, ErrorMessage = "Máximo 100 caracteres.")]
        public string Description { get; set; } = string.Empty;

        public string? PayDate { get; set; }
        public DateTime StartDate { get; set; } = DateTime.Today;

        [FechaFinal(nameof(StartDate), ErrorMessage = "La fecha final debe ser igual o posterior a la inicial.")]
        public DateTime EndDate { get; set; } = DateTime.Today;

        [StringLength(100, ErrorMessage = "Máximo 100 caracteres.")]
        public string StatusMessage { get; set; } = string.Empty;
    }

    private sealed class FechaFinalAttribute(string otraPropiedad) : ValidationAttribute
    {
        protected override ValidationResult? IsValid(object? value, ValidationContext context)
        {
            var otra = context.ObjectType.GetProperty(otraPropiedad)?.GetValue(context.ObjectInstance) as DateTime?;
            return value is DateTime fin && otra is DateTime inicio && fin < inicio
                ? new ValidationResult(ErrorMessage ?? "Fecha inválida", [context.MemberName ?? string.Empty])
                : ValidationResult.Success;
        }
    }
}
