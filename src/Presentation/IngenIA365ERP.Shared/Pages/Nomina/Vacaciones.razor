@page "/nomina/vacaciones"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using IngenIA365ERP.Shared.Services.Nomina
@using IngenIA365ERP.Shared.Components.Nomina
@inject NominaClient Nomina
@inject INotificationService Notification
@inject NavigationManager Nav
@inject DescargaDeArchivos Descargas

@*
    Feature 010 US4 (R6, FR-014 a FR-017; contracts/api.md §5 y §3.3). El saldo de vacaciones es
    DERIVADO —causado + saldo inicial − disfrutado − compensado − pagado al retiro ± ajustes— y nunca se
    guarda. Registrar un disfrute exige ver antes cuántos hábiles son con la semana laboral de la
    empresa y el calendario de festivos (vista previa obligatoria, FR-015); al guardar nacen el
    movimiento y la liquidación en borrador en una sola acción; aprobarla contabiliza contra la
    provisión y deja la ausencia en cada período que cubre (D-01). La compensación en dinero tiene tope
    (FR-016) y la pantalla lo muestra antes de pedirla.
*@

<PageTitle>Vacaciones - IngenIA365ERP</PageTitle>

<PermissionGate Required="Payroll.Vacations.View" MostrarAviso="true">
<div class="page-header">
    <h3>Vacaciones</h3>
    <div>
        <SfDatePicker TValue="DateTime" @bind-Value="_alDia" Placeholder="Saldo al día" Width="150px" />
        <SfTextBox @bind-Value="_buscar" Placeholder="Buscar por nombre o documento" ShowClearButton="true" Width="240px"
                   ValueChange="@((Syncfusion.Blazor.Inputs.ChangedEventArgs _) => CargarSaldosAsync())" />
        <SfButton CssClass="e-outline" IconCss="e-icons e-refresh" OnClick="@CargarTodoAsync">Ver</SfButton>
        <SfButton CssClass="e-outline" IconCss="e-icons e-download" OnClick="@(() => DescargarSaldosAsync("xlsx"))" Title="Saldos en Excel">Excel</SfButton>
        <SfButton CssClass="e-outline" IconCss="e-icons e-export-pdf" OnClick="@(() => DescargarSaldosAsync("pdf"))" Title="Saldos en PDF">PDF</SfButton>
        @* Registrar cruza dos endpoints: la vista previa obligatoria de hábiles es Register y el registro
           que crea la liquidación es Calculate. El botón exige los dos (D-40): hasta el 2026-09-21 iba
           sólo detrás de Calculate y un rol sin Register abría el diálogo y nunca podía terminar. *@
        <PermissionGate Required="Payroll.Vacations.Register">
            <PermissionGate Required="Payroll.Vacations.Calculate">
                <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@(() => AbrirRegistro(null))">Registrar disfrute o compensación</SfButton>
            </PermissionGate>
        </PermissionGate>
    </div>
</div>

<div class="info-card">
    <span class="label">Saldo derivado, nunca digitado</span>
    <p>Días hábiles causados (días trabajados por el calendario comercial, menos suspensiones del contrato, por los días de vacaciones por año del parámetro legal, sobre 360), más el saldo inicial, menos lo disfrutado, compensado y pagado al retiro, más o menos los ajustes con motivo. Los hábiles de un disfrute se cuentan con la semana laboral de la empresa (Nómina › Políticas) y el calendario de festivos, y quedan congelados en el movimiento.</p>
</div>

<SfTab @bind-SelectedItem="_pestana">
    <TabItems>
        <TabItem>
            <ChildContent><TabHeader Text="Saldos por empleado" IconCss="e-icons e-people" /></ChildContent>
            <ContentTemplate>
                <div class="contenido-tab">
                <IndicadorDeCarga Cargando="@_carga.Activa">
                <SfGrid TValue="SaldoVacacionesDto" DataSource="@_saldos" AllowSorting="true" AllowPaging="true">
                    <GridPageSettings PageSize="25" />
                    <GridColumns>
                        <GridColumn Field="Name" HeaderText="Empleado" Width="200" />
                        <GridColumn Field="Document" HeaderText="Documento" Width="110" />
                        <GridColumn Field="HireDate" HeaderText="Ingreso" Width="105" Format="dd/MM/yyyy" Type="ColumnType.Date" />
                        <GridColumn Field="WorkedDays" HeaderText="Trabajados" Width="100" TextAlign="TextAlign.Right" />
                        <GridColumn HeaderText="Causados" Width="95" TextAlign="TextAlign.Right"><Template>@(((SaldoVacacionesDto)context).AccruedDays.ToString("0.##"))</Template></GridColumn>
                        <GridColumn HeaderText="Inicial" Width="85" TextAlign="TextAlign.Right"><Template>@(((SaldoVacacionesDto)context).OpeningDays.ToString("0.##"))</Template></GridColumn>
                        <GridColumn HeaderText="Disfrutados" Width="100" TextAlign="TextAlign.Right"><Template>@(((SaldoVacacionesDto)context).EnjoyedDays.ToString("0.##"))</Template></GridColumn>
                        <GridColumn HeaderText="Compensados" Width="110" TextAlign="TextAlign.Right"><Template>@(((SaldoVacacionesDto)context).CompensatedDays.ToString("0.##"))</Template></GridColumn>
                        <GridColumn HeaderText="Ajustes" Width="85" TextAlign="TextAlign.Right"><Template>@(((SaldoVacacionesDto)context).AdjustedDays.ToString("+0.##;-0.##;0"))</Template></GridColumn>
                        <GridColumn HeaderText="Pendientes" Width="100" TextAlign="TextAlign.Right">
                            <Template>
                                @{
                                    var s = (SaldoVacacionesDto)context;
                                    <span class="@(s.PendingDays < 0 ? "e-badge e-badge-danger" : s.PendingDays > 30 ? "e-badge e-badge-warning" : "e-badge e-badge-success")">@s.PendingDays.ToString("0.##")</span>
                                }
                            </Template>
                        </GridColumn>
                        <GridColumn HeaderText="Último disfrute" Width="115"><Template>@(((SaldoVacacionesDto)context).LastEnjoymentTo?.ToString("dd/MM/yyyy") ?? "—")</Template></GridColumn>
                        <GridColumn HeaderText="Acciones" Width="170" TextAlign="TextAlign.Center">
                            <Template>
                                @{
                                    var s = (SaldoVacacionesDto)context;
                                    <SfButton CssClass="e-flat e-small" IconCss="e-icons e-description" Title="Saldo explicado y movimientos" OnClick="@(() => AbrirFichaAsync(s))" />
                                    <PermissionGate Required="Payroll.Vacations.Register">
                                        <PermissionGate Required="Payroll.Vacations.Calculate">
                                            <SfButton CssClass="e-flat e-small" IconCss="e-icons e-plus" Title="Registrar disfrute o compensación" OnClick="@(() => AbrirRegistro(s))" />
                                        </PermissionGate>
                                    </PermissionGate>
                                    <PermissionGate Required="Payroll.Vacations.Register">
                                        <SfButton CssClass="e-flat e-small" IconCss="e-icons e-edit" Title="Ajuste con motivo" OnClick="@(() => AbrirAjuste(s))" />
                                    </PermissionGate>
                                    <SfButton CssClass="e-flat e-small" IconCss="e-icons e-user" Title="Abrir la ficha" OnClick="@(() => Nav.NavigateTo($"/nomina/empleados/{s.EmployeePublicId}"))" />
                                }
                            </Template>
                        </GridColumn>
                    </GridColumns>
                </SfGrid>
                </IndicadorDeCarga>
                </div>
            </ContentTemplate>
        </TabItem>
        <TabItem>
            <ChildContent><TabHeader Text="Liquidaciones" IconCss="e-icons e-table" /></ChildContent>
            <ContentTemplate>
                <div class="contenido-tab">
                <div class="toolbar">
                    <SfNumericTextBox TValue="int?" @bind-Value="_anio" Placeholder="Año del corte" Width="130px" Format="0" ShowSpinButton="false" />
                    <select class="e-input" @bind="_estado">
                        <option value="">Vivas (sin reemplazadas)</option>
                        <option value="Draft">Borrador</option>
                        <option value="Approved">Aprobadas</option>
                        <option value="Reversed">Reversadas</option>
                        <option value="Superseded">Reemplazadas o descartadas</option>
                    </select>
                    <SfButton CssClass="e-outline" IconCss="e-icons e-refresh" OnClick="@CargarLiquidacionesAsync">Ver</SfButton>
                </div>
                <IndicadorDeCarga Cargando="@_cargaLiquidaciones.Activa">
                <SfGrid TValue="LiquidacionVacacionesDto" DataSource="@_liquidaciones" AllowSorting="true" AllowPaging="true">
                    <GridPageSettings PageSize="25" />
                    <GridColumns>
                        <GridColumn Field="EmployeeName" HeaderText="Empleado" Width="190" />
                        <GridColumn Field="TipoTexto" HeaderText="Tipo" Width="120" />
                        <GridColumn Field="FechasTexto" HeaderText="Fechas" Width="190" />
                        <GridColumn HeaderText="Hábiles" Width="80" TextAlign="TextAlign.Right"><Template>@(((LiquidacionVacacionesDto)context).WorkingDays.ToString("0.##"))</Template></GridColumn>
                        <GridColumn Field="CalendarDays" HeaderText="Calendario" Width="95" TextAlign="TextAlign.Right" />
                        <GridColumn Field="Amount" HeaderText="Neto" Width="120" Format="N0" TextAlign="TextAlign.Right" />
                        <GridColumn HeaderText="Estado" Width="120">
                            <Template>
                                @{
                                    var l = (LiquidacionVacacionesDto)context;
                                    <span class="@(l.EstaAprobada ? "e-badge e-badge-success" : l.EsBorrador ? "e-badge e-badge-info" : "e-badge")">@l.EstadoTexto v@l.Version</span>
                                }
                            </Template>
                        </GridColumn>
                        <GridColumn Field="CutoffDate" HeaderText="Corte" Width="100" Format="dd/MM/yyyy" Type="ColumnType.Date" />
                        <GridColumn Field="AccountingDocumentNumber" HeaderText="Comprobante" Width="120" />
                        <GridColumn HeaderText="Acciones" Width="210" TextAlign="TextAlign.Center">
                            <Template>
                                @{
                                    var l = (LiquidacionVacacionesDto)context;
                                    <SfButton CssClass="e-flat e-small" IconCss="e-icons e-description" Title="Detalle con explicación" OnClick="@(() => AbrirDetalleAsync(l))" />
                                    @if (l.SePuedeAprobar)
                                    {
                                        <PermissionGate Required="Payroll.Vacations.Approve">
                                            <SfButton CssClass="e-flat e-small" IconCss="e-icons e-check" Title="Aprobar" OnClick="@(() => AbrirAprobacion(l))" />
                                        </PermissionGate>
                                    }
                                    @if (l.EsBorrador)
                                    {
                                        <PermissionGate Required="Payroll.Vacations.Calculate">
                                            <SfButton CssClass="e-flat e-small" IconCss="e-icons e-repeat" Title="@(l.EstaDesactualizada ? "Desactualizado: recalcular antes de aprobar" : "Recalcular (versión nueva)")" OnClick="@(() => RecalcularAsync(l))" />
                                            <SfButton CssClass="e-flat e-small" IconCss="e-icons e-trash" Title="Descartar el borrador y anular el movimiento" OnClick="@(() => AbrirMotivo(l, descartar: true))" />
                                        </PermissionGate>
                                    }
                                    @if (l.EstaAprobada)
                                    {
                                        <PermissionGate Required="Payroll.Vacations.Reverse">
                                            <SfButton CssClass="e-flat e-small" IconCss="e-icons e-undo" Title="Reversar (asiento espejo)" OnClick="@(() => AbrirMotivo(l, descartar: false))" />
                                        </PermissionGate>
                                        <PermissionGate Required="Payroll.Disbursement.Generate">
                                            <SfButton CssClass="e-flat e-small" IconCss="e-icons e-export" Title="Archivo de dispersión para el banco" OnClick="@(() => { _corridaDispersion = l.RunPublicId; _mostrarDispersion = true; })" />
                                        </PermissionGate>
                                    }
                                }
                            </Template>
                        </GridColumn>
                    </GridColumns>
                </SfGrid>
                </IndicadorDeCarga>
                </div>
            </ContentTemplate>
        </TabItem>
    </TabItems>
</SfTab>
</PermissionGate>

@* --------------------------------------------------------------- ficha de saldo --- *@
<SfDialog @bind-Visible="_mostrarFicha" Header="@($"Vacaciones de {_fichaDe?.Name}")" Width="900px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@_cargaFicha.Activa">
            <div class="pagina">
                @if (_ficha is not null)
                {
                    <div class="kpi-grid">
                        <div class="kpi-card"><span class="label">Causados</span><strong>@_ficha.Balance.AccruedDays.ToString("0.##")</strong></div>
                        <div class="kpi-card"><span class="label">Saldo inicial</span><strong>@_ficha.Balance.OpeningDays.ToString("0.##")</strong></div>
                        <div class="kpi-card"><span class="label">Disfrutados</span><strong>@_ficha.Balance.EnjoyedDays.ToString("0.##")</strong></div>
                        <div class="kpi-card"><span class="label">Compensados</span><strong>@_ficha.Balance.CompensatedDays.ToString("0.##")</strong></div>
                        <div class="kpi-card"><span class="label">Pendientes</span><strong>@_ficha.Balance.PendingDays.ToString("0.##")</strong></div>
                        @if (_ficha.MaxCompensableDays is { } max)
                        {
                            <div class="kpi-card"><span class="label">Compensables en dinero</span><strong>@max.ToString("0.##")</strong><span class="texto-tenue">@(_ficha.CompensablePercent?.ToString("0.##")) % de lo causado</span></div>
                        }
                    </div>
                    <span class="label">Cómo se llega al saldo (al @_ficha.Balance.AsOf.ToString("dd/MM/yyyy"))</span>
                    <ol class="explicacion-pasos">
                        @foreach (var p in _ficha.Explanation)
                        {
                            <li><span>@p.Label</span> @if (p.Value is { } v) { <strong class="monto">@v.ToString("0.##")</strong> } else if (p.Text is not null) { <em class="texto-tenue">@p.Text</em> }</li>
                        }
                    </ol>
                }
                <span class="label">Movimientos</span>
                @if (_movimientos.Count == 0)
                {
                    <div class="sin-datos">Sin movimientos registrados.</div>
                }
                else
                {
                    <table class="data-grid">
                        <thead><tr><th>Tipo</th><th>Fechas</th><th class="monto">Hábiles</th><th class="monto">Calendario</th><th>Estado</th><th>Liquidación</th><th>Registró</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var m in _movimientos)
                            {
                                <tr class="@(m.Status == 2 ? "texto-tenue" : "")">
                                    <td>@m.TipoTexto</td>
                                    <td>@m.StartDate.ToString("dd/MM/yyyy")@(m.EndDate is { } h ? $" – {h:dd/MM/yyyy}" : "")@if (!string.IsNullOrWhiteSpace(m.Notes)) { <span class="texto-tenue"> · @m.Notes</span> }</td>
                                    <td class="monto">@m.BusinessDays.ToString("+0.##;-0.##;0")</td>
                                    <td class="monto">@(m.CalendarDays > 0 ? m.CalendarDays.ToString() : "")</td>
                                    <td>@m.EstadoTexto @if (m.Status == 2) { <span class="texto-tenue">(@m.CancelReason)</span> }</td>
                                    <td>@(m.RunStatus is null ? "—" : $"{m.RunStatus}{(m.Amount is { } a ? $" · {a:N0}" : "")}")</td>
                                    <td class="texto-tenue">@m.CreatedBy · @m.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @if (m.EsAnulable)
                                        {
                                            <PermissionGate Required="Payroll.Vacations.Register">
                                                <SfButton CssClass="e-flat e-small" IconCss="e-icons e-close" Title="Anular con motivo" OnClick="@(() => AbrirAnulacion(m))" />
                                            </PermissionGate>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
            </IndicadorDeCarga>
        </Content>
    </DialogTemplates>
</SfDialog>

@* ------------------------------------------------------- registrar disfrute/compensación --- *@
<SfDialog @bind-Visible="_mostrarRegistro" Header="Registrar disfrute o compensación" Width="760px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@_guardado.Activa" Texto="Guardando…">
            <div class="pagina">
                @if (_registroDe is null)
                {
                    <SfTextBox @bind-Value="_buscarEmpleado" Placeholder="Empleado (nombre o documento)" FloatLabelType="FloatLabelType.Always" ShowClearButton="true"
                               ValueChange="@((Syncfusion.Blazor.Inputs.ChangedEventArgs _) => BuscarEmpleadosAsync())" />
                    @if (_empleadosEncontrados.Count > 0)
                    {
                        <ul class="lista-resultados">
                            @foreach (var e in _empleadosEncontrados)
                            {
                                <li><a href="javascript:void(0)" @onclick="@(() => ElegirEmpleado(e))">@e.FullName · @e.IdentificationNumber</a></li>
                            }
                        </ul>
                    }
                }
                else
                {
                    <div class="info-card">
                        <span class="label">@_registroDe.Name · @_registroDe.Document</span>
                        <p>Pendientes al @_registroDe.AsOf.ToString("dd/MM/yyyy"): <strong>@_registroDe.PendingDays.ToString("0.##")</strong> días hábiles (causados @_registroDe.AccruedDays.ToString("0.##"), inicial @_registroDe.OpeningDays.ToString("0.##"), disfrutados @_registroDe.EnjoyedDays.ToString("0.##"), compensados @_registroDe.CompensatedDays.ToString("0.##")).
                        @if (_maximoCompensable is { } max) { <span> Compensables en dinero: <strong>@max.ToString("0.##")</strong>.</span> }</p>
                    </div>
                }

                <div class="toolbar">
                    <label class="campo-check"><input type="radio" name="tipo" checked="@(_esDisfrute)" @onchange="@(() => CambiarTipo(true))" /> Disfrute (fechas)</label>
                    <label class="campo-check"><input type="radio" name="tipo" checked="@(!_esDisfrute)" @onchange="@(() => CambiarTipo(false))" /> Compensación en dinero (días hábiles)</label>
                </div>

                @if (_esDisfrute)
                {
                    <div class="rejilla-campos">
                        <div><SfDatePicker TValue="DateTime?" @bind-Value="_desde" Placeholder="Desde *" FloatLabelType="FloatLabelType.Always" ValueChange="@((Syncfusion.Blazor.Calendars.ChangedEventArgs<DateTime?> _) => InvalidarVista())" /></div>
                        <div><SfDatePicker TValue="DateTime?" @bind-Value="_hasta" Placeholder="Hasta *" FloatLabelType="FloatLabelType.Always" ValueChange="@((Syncfusion.Blazor.Calendars.ChangedEventArgs<DateTime?> _) => InvalidarVista())" /></div>
                    </div>
                    <div class="toolbar">
                        <SfButton CssClass="e-outline" IconCss="e-icons e-eye" type="button" OnClick="@VerHabilesAsync" Disabled="@(_desde is null || _hasta is null || _cargaVista.Activa)">Ver días hábiles</SfButton>
                        <span class="texto-tenue">La vista previa es obligatoria: se guarda con los hábiles que se muestran aquí.</span>
                    </div>
                    <IndicadorDeCarga Cargando="@_cargaVista.Activa" Texto="Contando…">
                    @if (_vista is not null)
                    {
                        <div class="info-card">
                            <span class="label">@_vista.WorkingDays días hábiles · @_vista.CalendarDays calendario (semana de @_vista.SemanaTexto)</span>
                            @if (_vista.Skipped.Count > 0)
                            {
                                <p>Se saltan: @string.Join(", ", _vista.Skipped.Select(s => $"{s.Date:dd/MM} ({s.Text})")).</p>
                            }
                            else
                            {
                                <p>Ningún domingo ni festivo en el rango.</p>
                            }
                            @foreach (var aviso in _vista.Avisos)
                            {
                                <p class="texto-tenue">@aviso.Message</p>
                            }
                            @if (_vista.WorkingDays == 0)
                            {
                                <p class="texto-tenue">Sin días hábiles: el rango no se puede registrar.</p>
                            }
                            else if (_registroDe is not null && _vista.WorkingDays > _registroDe.PendingDays)
                            {
                                <p class="texto-tenue">Consume más de lo pendiente: quedarían @((_registroDe.PendingDays - _vista.WorkingDays).ToString("0.##")) días (vacaciones anticipadas).</p>
                            }
                        </div>
                    }
                    </IndicadorDeCarga>
                }
                else
                {
                    <div class="rejilla-campos">
                        <div><SfNumericTextBox TValue="decimal?" @bind-Value="_diasCompensacion" Placeholder="Días hábiles a compensar *" FloatLabelType="FloatLabelType.Always" Decimals="2" Min="0.5m" Format="0.##" /></div>
                        <div><SfDatePicker TValue="DateTime?" @bind-Value="_fechaPago" Placeholder="Fecha de pago (hoy si se deja vacía)" FloatLabelType="FloatLabelType.Always" /></div>
                    </div>
                    @if (_maximoCompensable is { } max && _diasCompensacion is { } dias && dias > max)
                    {
                        <p class="texto-tenue">Supera el máximo compensable (@max.ToString("0.##")): la ley sólo permite pagar en dinero una parte de lo causado (CST art. 189).</p>
                    }
                }

                <SfTextBox @bind-Value="_notas" MaxLength="300" Multiline="true" Placeholder="Notas" FloatLabelType="FloatLabelType.Always" />

                @if (_pideRetroactivo)
                {
                    <div class="info-card alerta">
                        <span class="label">Un período cubierto ya está aprobado</span>
                        <p>La nómina de ese período es inmutable. La novedad de esos días puede quedar como ajuste retroactivo en el período abierto siguiente.</p>
                        <label class="campo-check"><input type="checkbox" @bind="_aceptaRetroactivo" /> Acepto el ajuste retroactivo.</label>
                    </div>
                }

                <div class="toolbar">
                    <SfButton CssClass="e-flat" type="button" OnClick="@(() => _mostrarRegistro = false)">Cancelar</SfButton>
                    <SfButton CssClass="e-primary" type="button" OnClick="@RegistrarAsync" Disabled="@(!PuedeRegistrar)">Registrar y calcular</SfButton>
                </div>
            </div>
            </IndicadorDeCarga>
        </Content>
    </DialogTemplates>
</SfDialog>

@* ------------------------------------------------------------- resultado del registro --- *@
<SfDialog @bind-Visible="_mostrarResultado" Header="Liquidación de vacaciones en borrador" Width="720px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            @if (_resultado is not null)
            {
                <div class="pagina">
                    <div class="kpi-grid">
                        <div class="kpi-card"><span class="label">Hábiles</span><strong>@_resultado.WorkingDays.ToString("0.##")</strong></div>
                        <div class="kpi-card"><span class="label">Calendario</span><strong>@_resultado.CalendarDays</strong></div>
                        <div class="kpi-card"><span class="label">Valor</span><strong>@_resultado.Amount.ToString("N0")</strong></div>
                        <div class="kpi-card"><span class="label">Neto</span><strong>@_resultado.Totals.Net.ToString("N0")</strong></div>
                    </div>
                    <p class="texto-tenue">Corte @_resultado.CutoffDate.ToString("dd/MM/yyyy") · versión @_resultado.Version. El borrador se aprueba en la pestaña Liquidaciones.</p>
                    @if (_resultado.Novelties.Count > 0)
                    {
                        <span class="label">Al aprobar quedará en la nómina ordinaria</span>
                        <ul>
                            @foreach (var n in _resultado.Novelties)
                            {
                                <li>@n.ConceptCode · período @n.PeriodLabel: @n.Days día(s) del @n.From.ToString("dd/MM") al @n.To.ToString("dd/MM")@(n.Retroactive ? " (ajuste retroactivo)" : "")</li>
                            }
                        </ul>
                    }
                    @if (_resultado.Warnings.Count > 0)
                    {
                        <span class="label">Avisos</span>
                        <ul>@foreach (var w in _resultado.Warnings) { <li>@w.Message</li> }</ul>
                    }
                    @if (_resultado.Blockers.Count > 0)
                    {
                        <span class="label">Bloqueos</span>
                        <ul>@foreach (var b in _resultado.Blockers) { <li>@b.BanderaTexto: @b.Detail</li> }</ul>
                    }
                    @if (_resultado.Excluded.Count > 0)
                    {
                        <span class="label">Sin derecho</span>
                        <ul>@foreach (var x in _resultado.Excluded) { <li>@x.Name: @x.Reason</li> }</ul>
                    }
                </div>
            }
        </Content>
    </DialogTemplates>
</SfDialog>

@* ------------------------------------------------------------------------ ajuste --- *@
<SfDialog @bind-Visible="_mostrarAjuste" Header="@($"Ajuste al saldo de {_ajusteDe?.Name}")" Width="560px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@_guardado.Activa" Texto="Guardando…">
            <div class="pagina">
                <p class="texto-tenue">Positivo suma al saldo (días reconocidos por acuerdo); negativo lo resta (días tomados sin registro). Queda auditado con su motivo.</p>
                <SfNumericTextBox TValue="decimal?" @bind-Value="_diasAjuste" Placeholder="Días hábiles (con signo) *" FloatLabelType="FloatLabelType.Always" Decimals="2" Format="+0.##;-0.##;0" />
                <SfTextBox @bind-Value="_motivo" MaxLength="300" Multiline="true" Placeholder="Motivo *" FloatLabelType="FloatLabelType.Always" />
                <div class="toolbar">
                    <SfButton CssClass="e-flat" type="button" OnClick="@(() => _mostrarAjuste = false)">Cancelar</SfButton>
                    <SfButton CssClass="e-primary" type="button" OnClick="@AjustarAsync" Disabled="@(_guardado.Activa || _diasAjuste is null or 0m || string.IsNullOrWhiteSpace(_motivo))">Registrar ajuste</SfButton>
                </div>
            </div>
            </IndicadorDeCarga>
        </Content>
    </DialogTemplates>
</SfDialog>

@* ------------------------------------------------------------------- aprobación --- *@
<SfDialog @bind-Visible="_mostrarAprobacion" Header="Aprobar la liquidación de vacaciones" Width="680px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@_guardado.Activa" Texto="Aprobando…">
            @if (_aprobando is not null)
            {
                <div class="pagina">
                    <div class="info-card">
                        <span class="label">Qué se aprueba</span>
                        <p><strong>@_aprobando.EmployeeName</strong> · @_aprobando.TipoTexto @_aprobando.FechasTexto: @_aprobando.WorkingDays.ToString("0.##") hábiles, neto <strong>@_aprobando.Amount.ToString("N0")</strong>, borrador v@_aprobando.Version.</p>
                        <p class="texto-tenue">Al aprobar se genera el comprobante VacationRun contra la provisión de vacaciones en la misma operación, el movimiento queda liquidado y la ausencia entra a la nómina de cada período que cubre el disfrute.</p>
                    </div>
                    <SfDatePicker TValue="DateTime?" @bind-Value="_fechaComprobante" Placeholder="Fecha del comprobante (por defecto el corte)" FloatLabelType="FloatLabelType.Always" />
                    <label class="campo-check"><input type="checkbox" @bind="_confirmar" /> Confirmo aprobar esta liquidación.</label>
                    @if (_pideSegundaConfirmacion)
                    {
                        <div class="info-card">
                            <span class="label">Segunda confirmación</span>
                            <p>Quien calculó es quien aprueba. La cooperativa lo permite, pero queda registrado como aprobado sin segregación de funciones.</p>
                            <label class="campo-check"><input type="checkbox" @bind="_confirmarSinSegregacion" /> Confirmo aprobar sin segregación de funciones.</label>
                        </div>
                    }
                    @if (_pideRetroactivoAprobar)
                    {
                        <div class="info-card alerta">
                            <span class="label">Un período cubierto ya está aprobado</span>
                            <p>La novedad de esos días quedará como ajuste retroactivo en el período abierto siguiente.</p>
                            <label class="campo-check"><input type="checkbox" @bind="_aceptaRetroactivoAprobar" /> Acepto el ajuste retroactivo.</label>
                        </div>
                    }
                    <div class="toolbar">
                        <SfButton CssClass="e-flat" type="button" OnClick="@(() => _mostrarAprobacion = false)">Cancelar</SfButton>
                        <SfButton CssClass="e-primary" type="button" OnClick="@AprobarAsync" Disabled="@(!_confirmar || _guardado.Activa)">Aprobar</SfButton>
                    </div>
                </div>
            }
            </IndicadorDeCarga>
        </Content>
    </DialogTemplates>
</SfDialog>

@* ------------------------------------------------------ recalcular con ajuste retroactivo --- *@
