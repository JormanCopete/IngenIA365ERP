<SfDialog @bind-Visible="_mostrarDetalle" Header="@(_detalle is null ? "Detalle" : $"{_detalle.EmployeeName} · {_detalle.Document}")" Width="920px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@_cargaDetalle.Activa">
            @if (_detalle is not null)
            {
                <div class="pagina">
                    <div class="kpi-grid">
                        <div class="kpi-card"><span class="label">Días</span><strong>@_detalle.DaysWorked</strong></div>
                        <div class="kpi-card"><span class="label">Devengado</span><strong>@_detalle.Totals.Earnings.ToString("N0")</strong></div>
                        <div class="kpi-card"><span class="label">Deducido</span><strong>@_detalle.Totals.Deductions.ToString("N0")</strong></div>
                        <div class="kpi-card"><span class="label">Neto</span><strong>@_detalle.Totals.Net.ToString("N0")</strong></div>
                    </div>
                    @if (_detalle.Refusals.Count > 0)
                    {
                        <div class="info-card alerta"><span class="label">El motor avisa</span><ul>@foreach (var r in _detalle.Refusals) { <li>@r</li> }</ul></div>
                    }
                    @if (_detalle.Skips.Count > 0)
                    {
                        <span class="label">Rubros omitidos</span>
                        <ul>@foreach (var s in _detalle.Skips) { <li class="texto-tenue">@s</li> }</ul>
                    }
                    <span class="label">Líneas</span>
                    @foreach (var grupo in _detalle.Lines.GroupBy(l => l.NaturalezaTexto))
                    {
                        <h4>@grupo.Key</h4>
                        <table class="data-grid">
                            <thead><tr><th></th><th>Concepto</th><th class="monto">Cantidad</th><th class="monto">Base</th><th class="monto">Valor</th></tr></thead>
                            <tbody>
                                @foreach (var l in grupo)
                                {
                                    <tr>
                                        <td><SfButton CssClass="e-flat e-small" IconCss="@(_lineaAbierta == l.PublicId ? "e-icons e-chevron-up" : "e-icons e-chevron-down")" OnClick="@(() => _lineaAbierta = _lineaAbierta == l.PublicId ? null : l.PublicId)" /></td>
                                        <td>@l.ConceptCode · @l.ConceptName @(l.AffectsAccounting ? string.Empty : " (sin asiento)")</td>
                                        <td class="monto">@(l.Quantity?.ToString("0.##"))</td>
                                        <td class="monto">@(l.BaseAmount?.ToString("N2"))</td>
                                        <td class="monto"><strong>@l.Amount.ToString("N0")</strong></td>
                                    </tr>
                                    @if (_lineaAbierta == l.PublicId)
                                    {
                                        <tr><td colspan="5"><ExplicacionDeLinea Explicacion="@l.Explanation" /></td></tr>
                                    }
                                }
                            </tbody>
                        </table>
                    }
                </div>
            }
            </IndicadorDeCarga>
        </Content>
    </DialogTemplates>
</SfDialog>

<GenerarDispersion @bind-Visible="_mostrarDispersion" RunPublicId="@_corridaDispersion" Etiqueta="Liquidación de vacaciones" />

@code {
    // Feature 010 (US8): el archivo de dispersión se genera desde esta relación de pago.
    private bool _mostrarDispersion;
    private Guid _corridaDispersion;
    /// <summary>Llegar con <c>?corrida=</c> (desde el comprobante contable, «Ver en Nómina») abre la pestaña Liquidaciones en el año del corte y el detalle de esa corrida.</summary>
    [SupplyParameterFromQuery(Name = "corrida")] public Guid? Corrida { get; set; }

    private int _pestana;

    // Indicadores de carga por zona (docs/manual/indicador-de-carga.md).
    private readonly EstadoDeCarga _carga = new(), _cargaLiquidaciones = new(), _cargaFicha = new(), _cargaVista = new(), _cargaDetalle = new(), _guardado = new();

    private List<SaldoVacacionesDto> _saldos = [];
    private List<LiquidacionVacacionesDto> _liquidaciones = [];
    private DateTime _alDia = DateTime.Today;
    private string? _buscar;
    private int? _anio;
    private string _estado = string.Empty;

    // ficha
    private bool _mostrarFicha;
    private SaldoVacacionesDto? _fichaDe;
    private SaldoVacacionesDetalleDto? _ficha;
    private List<MovimientoVacacionesDto> _movimientos = [];

    // registro
    private bool _mostrarRegistro, _esDisfrute = true, _pideRetroactivo, _aceptaRetroactivo;
    private SaldoVacacionesDto? _registroDe;
    private decimal? _maximoCompensable;
    private string? _buscarEmpleado;
    private List<EmpleadoResumenDto> _empleadosEncontrados = [];
    private DateTime? _desde, _hasta, _fechaPago;
    private decimal? _diasCompensacion;
    private string? _notas;
    private VistaPreviaHabilesDto? _vista;
    private bool _mostrarResultado;
    private VacacionesCalculadasDto? _resultado;

    // ajuste
    private bool _mostrarAjuste;
    private SaldoVacacionesDto? _ajusteDe;
    private decimal? _diasAjuste;

    // aprobación
    private bool _mostrarAprobacion, _confirmar, _pideSegundaConfirmacion, _confirmarSinSegregacion, _pideRetroactivoAprobar, _aceptaRetroactivoAprobar;
    private LiquidacionVacacionesDto? _aprobando;
    private DateTime? _fechaComprobante;

    // recálculo con ajuste retroactivo (mismo aviso que registro y aprobación)
    private bool _mostrarRecalculoRetroactivo, _aceptaRetroactivoRecalcular;
    private LiquidacionVacacionesDto? _recalculando;

    // motivo
    private bool _mostrarMotivo;
    private string _tituloMotivo = string.Empty, _textoMotivo = string.Empty, _motivo = string.Empty;
    private Func<string, Task<InvitationApiResult<EmptyResponse>>>? _accionConMotivo;

    // detalle
    private bool _mostrarDetalle;
    private DetalleEmpleadoCorridaDto? _detalle;
    private Guid? _lineaAbierta;

    protected override async Task OnInitializedAsync()
    {
        ResumenCorridaDto? desdeEnlace = null;
        if (Corrida is { } id)
        {
            var r = await Nomina.ResumenAsync(id);
            if (r.IsSuccess) { desdeEnlace = r.Value; _anio = desdeEnlace!.CutoffDate?.Year; _pestana = 1; }
        }
        await CargarTodoAsync();
        if (desdeEnlace is { EmployeePublicId: { } empleado }) await AbrirDetalleAsync(desdeEnlace.PublicId, empleado);
    }

    private async Task CargarTodoAsync()
    {
        await CargarSaldosAsync();
        await CargarLiquidacionesAsync();
    }

    private async Task CargarSaldosAsync()
    {
        using var carga = _carga.Iniciar();
        var res = await Nomina.SaldosDeVacacionesAsync(DateOnly.FromDateTime(_alDia), _buscar);
        if (!res.IsSuccess)
        {
            await Notification.ErrorAsync(res.ErrorCode == "Generic.NotFound" ? NotificationServiceExtensions.SinPermiso : res.ErrorMessage ?? "No se pudieron cargar los saldos de vacaciones.");
            return;
        }
        _saldos = (res.Value ?? []).ToList();
    }

    private async Task CargarLiquidacionesAsync()
    {
        using var carga = _cargaLiquidaciones.Iniciar();
        var res = await Nomina.LiquidacionesDeVacacionesAsync(null, _anio, string.IsNullOrWhiteSpace(_estado) ? null : _estado);
        if (!res.IsSuccess)
        {
            await Notification.ErrorAsync(res.ErrorMessage ?? "No se pudieron cargar las liquidaciones de vacaciones.");
            return;
        }
        _liquidaciones = (res.Value ?? []).ToList();
    }

    private async Task DescargarSaldosAsync(string formato)
    {
        var res = await Nomina.DescargarSaldosDeVacacionesAsync(DateOnly.FromDateTime(_alDia), formato, _buscar);
        if (!res.IsSuccess) { await Notification.ErrorAsync(res.ErrorMessage ?? "No se pudo descargar el reporte."); return; }
        await Descargas.GuardarAsync(res.Value!.Nombre, res.Value.TipoContenido, res.Value.Contenido);
    }

    // ------------------------------------------------------------------ ficha --

    private async Task AbrirFichaAsync(SaldoVacacionesDto s)
    {
        _fichaDe = s; _ficha = null; _movimientos = [];
        _mostrarFicha = true;
        await CargarFichaAsync();
    }

    private async Task CargarFichaAsync()
    {
        if (_fichaDe is null) return;
        using var carga = _cargaFicha.Iniciar();
        var saldo = await Nomina.SaldoDeVacacionesAsync(_fichaDe.EmployeePublicId, DateOnly.FromDateTime(_alDia));
        var movs = await Nomina.MovimientosDeVacacionesAsync(_fichaDe.EmployeePublicId);
        if (!saldo.IsSuccess || !movs.IsSuccess)
        {
            await Notification.ErrorAsync(saldo.ErrorMessage ?? movs.ErrorMessage ?? "No se pudo cargar el saldo.");
            return;
        }
        _ficha = saldo.Value;
        _movimientos = (movs.Value ?? []).ToList();
    }

    private void AbrirAnulacion(MovimientoVacacionesDto m)
    {
        _motivo = string.Empty;
        _tituloMotivo = "Anular el movimiento";
        _textoMotivo = m.RunStatus is "Draft" or "Stale"
            ? "El movimiento tiene una liquidación en borrador: se descarta con él. Las fechas quedan libres."
            : "El movimiento queda anulado con su motivo; el saldo se recalcula al instante.";
        _accionConMotivo = async motivo =>
        {
            var r = await Nomina.AnularMovimientoDeVacacionesAsync(m.MovementPublicId, motivo);
            if (r.IsSuccess) { await CargarFichaAsync(); await CargarTodoAsync(); }
            return r;
        };
        _mostrarMotivo = true;
    }

    // ---------------------------------------------------------------- registro --

    private void AbrirRegistro(SaldoVacacionesDto? s)
    {
        _registroDe = s;
        _maximoCompensable = null;
        _buscarEmpleado = null;
        _empleadosEncontrados = [];
        _esDisfrute = true;
        _desde = _hasta = _fechaPago = null;
        _diasCompensacion = null;
        _notas = null;
        _vista = null;
        _pideRetroactivo = _aceptaRetroactivo = false;
        _mostrarRegistro = true;
        if (s is not null) _ = CargarMaximoAsync(s.EmployeePublicId);
    }

    private async Task CargarMaximoAsync(Guid empleadoId)
    {
        var r = await Nomina.SaldoDeVacacionesAsync(empleadoId, DateOnly.FromDateTime(_alDia));
        if (r.IsSuccess) { _maximoCompensable = r.Value!.MaxCompensableDays; _registroDe = r.Value.Balance; StateHasChanged(); }
    }

    private async Task BuscarEmpleadosAsync()
    {
        if (string.IsNullOrWhiteSpace(_buscarEmpleado)) { _empleadosEncontrados = []; return; }
        var r = await Nomina.BuscarEmpleadosAsync(_buscarEmpleado);
        _empleadosEncontrados = r.IsSuccess ? (r.Value?.Items ?? []).ToList() : [];
    }

    private async Task ElegirEmpleado(EmpleadoResumenDto e)
    {
        _empleadosEncontrados = [];
        var r = await Nomina.SaldoDeVacacionesAsync(e.PublicId, DateOnly.FromDateTime(_alDia));
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo leer el saldo del empleado."); return; }
        _registroDe = r.Value!.Balance;
        _maximoCompensable = r.Value.MaxCompensableDays;
    }

    private void CambiarTipo(bool disfrute) { _esDisfrute = disfrute; _vista = null; _pideRetroactivo = false; }

    private void InvalidarVista() => _vista = null;

    private async Task VerHabilesAsync()
    {
        if (_desde is null || _hasta is null) return;
        using var carga = _cargaVista.Iniciar();
        var r = await Nomina.DiasHabilesAsync(DateOnly.FromDateTime(_desde.Value), DateOnly.FromDateTime(_hasta.Value), _registroDe?.EmployeePublicId);
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudieron contar los días hábiles."); return; }
        _vista = r.Value;
    }

    private bool PuedeRegistrar =>
        !_guardado.Activa && _registroDe is not null
        && (_esDisfrute ? _vista is { WorkingDays: > 0 } && _desde is not null && _hasta is not null : _diasCompensacion is > 0m)
        && (!_pideRetroactivo || _aceptaRetroactivo);

    private async Task RegistrarAsync()
    {
        if (!PuedeRegistrar || _registroDe is null) return;
        using var guardado = _guardado.Iniciar();
        var request = new RegistrarVacacionesRequest(
            _registroDe.EmployeePublicId,
            _esDisfrute ? "Enjoyment" : "Compensation",
            _esDisfrute ? DateOnly.FromDateTime(_desde!.Value) : null,
            _esDisfrute ? DateOnly.FromDateTime(_hasta!.Value) : null,
            _esDisfrute ? null : _diasCompensacion,
            _esDisfrute || _fechaPago is null ? null : DateOnly.FromDateTime(_fechaPago.Value),
            string.IsNullOrWhiteSpace(_notas) ? null : _notas.Trim(),
            _aceptaRetroactivo);
        var res = await Nomina.RegistrarVacacionesAsync(request);
        if (!res.IsSuccess)
        {
            if (res.ErrorCode == "Payroll.Vacation.PeriodApproved") { _pideRetroactivo = true; }
            await Notification.ErrorAsync(res.ErrorCode == "Generic.NotFound" ? NotificationServiceExtensions.SinPermiso : res.ErrorMessage ?? "No se pudo registrar.");
            return;
        }
        _resultado = res.Value;
        _mostrarRegistro = false;
        _mostrarResultado = true;
        await Notification.SuccessAsync("Movimiento registrado y liquidación calculada en borrador.");
        await CargarTodoAsync();
    }

    // ------------------------------------------------------------------ ajuste --

    private void AbrirAjuste(SaldoVacacionesDto s)
    {
        _ajusteDe = s; _diasAjuste = null; _motivo = string.Empty;
        _mostrarAjuste = true;
    }

    private async Task AjustarAsync()
    {
        if (_ajusteDe is null || _diasAjuste is null or 0m || string.IsNullOrWhiteSpace(_motivo)) return;
        using var guardado = _guardado.Iniciar();
        var res = await Nomina.AjustarVacacionesAsync(_ajusteDe.EmployeePublicId, _diasAjuste.Value, _motivo.Trim());
        if (!res.IsSuccess) { await Notification.ErrorAsync(res.ErrorMessage ?? "No se pudo registrar el ajuste."); return; }
        await Notification.SuccessAsync("Ajuste registrado.");
        _mostrarAjuste = false;
        await CargarSaldosAsync();
    }

    // -------------------------------------------------------------- aprobación --

    private void AbrirAprobacion(LiquidacionVacacionesDto l)
    {
        _aprobando = l;
        _fechaComprobante = null;
        _confirmar = _pideSegundaConfirmacion = _confirmarSinSegregacion = _pideRetroactivoAprobar = _aceptaRetroactivoAprobar = false;
        _mostrarAprobacion = true;
    }

    private async Task AprobarAsync()
    {
        if (_aprobando is null || !_confirmar) return;
        using var guardado = _guardado.Iniciar();
        var res = await Nomina.AprobarVacacionesAsync(_aprobando.RunPublicId, new AprobarLiquidacionRequest(
            true, _fechaComprobante is { } f ? DateOnly.FromDateTime(f) : null, ConfirmEmpty: false,
            ConfirmWithoutSegregation: _confirmarSinSegregacion, AcceptRetroactive: _aceptaRetroactivoAprobar));
        if (!res.IsSuccess)
        {
            if (res.ErrorCode == "Payroll.Settlement.ConfirmationRequired" && !_confirmarSinSegregacion) _pideSegundaConfirmacion = true;
            if (res.ErrorCode == "Payroll.Vacation.PeriodApproved") _pideRetroactivoAprobar = true;
            await Notification.ErrorAsync(res.ErrorCode == "Generic.NotFound" ? NotificationServiceExtensions.SinPermiso : res.ErrorMessage ?? "No se pudo aprobar.");
            return;
        }
        await Notification.SuccessAsync(string.IsNullOrEmpty(res.Value!.Number)
            ? "Liquidación aprobada (sin comprobante: la nómina ordinaria paga los días)."
            : $"Liquidación aprobada. Comprobante {res.Value.Number} del {res.Value.PostingDate:dd/MM/yyyy}.");
        _mostrarAprobacion = false;
        await CargarTodoAsync();
    }

    private async Task RecalcularAsync(LiquidacionVacacionesDto l, bool aceptarRetroactivo = false)
    {
        if (_guardado.Activa) return;
        using var guardado = _guardado.Iniciar();
        var res = await Nomina.RecalcularVacacionesAsync(l.RunPublicId, aceptarRetroactivo);
        if (!res.IsSuccess)
        {
            // Entre el registro y el recálculo se aprobó la nómina de un período que cubre el disfrute:
            // la API lo dice con PeriodApproved y admite AcceptRetroactive, como al registrar y al
            // aprobar. Hasta el 2026-09-21 la pantalla sólo mostraba el mensaje y la única salida era
            // descartar el borrador y registrar de nuevo, perdiendo la versión.
            if (res.ErrorCode == "Payroll.Vacation.PeriodApproved" && !aceptarRetroactivo)
            {
                _recalculando = l;
                _aceptaRetroactivoRecalcular = false;
                _mostrarRecalculoRetroactivo = true;
            }
            await Notification.ErrorAsync(res.ErrorCode == "Generic.NotFound" ? NotificationServiceExtensions.SinPermiso : res.ErrorMessage ?? "No se pudo recalcular.");
            return;
        }
        _mostrarRecalculoRetroactivo = false;
        _resultado = res.Value;
        _mostrarResultado = true;
        await CargarLiquidacionesAsync();
    }

    private void AbrirMotivo(LiquidacionVacacionesDto l, bool descartar)
    {
        _motivo = string.Empty;
        _tituloMotivo = descartar ? "Descartar el borrador" : "Reversar la liquidación";
        _textoMotivo = descartar
            ? "El borrador queda descartado y el movimiento anulado; las fechas quedan libres para registrarlo de nuevo."
            : "Se genera el asiento espejo, el movimiento vuelve a registrado y las novedades de ausencia de los períodos aún abiertos se anulan. Si hay pagos marcados, retírelos primero.";
        _accionConMotivo = async motivo =>
        {
            if (descartar) return SinCuerpo(await Nomina.DescartarVacacionesAsync(l.RunPublicId, motivo));
            return SinCuerpo(await Nomina.ReversarVacacionesAsync(l.RunPublicId, motivo));
        };
        _mostrarMotivo = true;
    }

    /// <summary>Reversar y descartar responden cuerpos distintos; el diálogo de motivo sólo necesita saber si salió bien.</summary>
    private static InvitationApiResult<EmptyResponse> SinCuerpo<T>(InvitationApiResult<T> r) =>
        r.IsSuccess ? InvitationApiResult<EmptyResponse>.Success(new EmptyResponse()) : InvitationApiResult<EmptyResponse>.Failure(r.ErrorCode ?? "Error", r.ErrorMessage ?? "No se pudo completar.", r.StatusCode ?? 0);

    private async Task ConfirmarMotivoAsync()
    {
        if (_accionConMotivo is null || string.IsNullOrWhiteSpace(_motivo)) return;
        using var guardado = _guardado.Iniciar();
        var res = await _accionConMotivo(_motivo.Trim());
        if (!res.IsSuccess) { await Notification.ErrorAsync(res.ErrorCode == "Generic.NotFound" ? NotificationServiceExtensions.SinPermiso : res.ErrorMessage ?? "No se pudo completar."); return; }
        await Notification.SuccessAsync("Listo.");
        _mostrarMotivo = false;
        await CargarTodoAsync();
    }

    // ----------------------------------------------------------------- detalle --

    private Task AbrirDetalleAsync(LiquidacionVacacionesDto l) => AbrirDetalleAsync(l.RunPublicId, l.EmployeePublicId);

    private async Task AbrirDetalleAsync(Guid corridaId, Guid empleadoId)
    {
        _detalle = null; _lineaAbierta = null;
        _mostrarDetalle = true;
        using var carga = _cargaDetalle.Iniciar();
        var res = await Nomina.DetalleEmpleadoAsync(corridaId, empleadoId);
        if (!res.IsSuccess) { await Notification.ErrorAsync(res.ErrorMessage ?? "No se pudo cargar el detalle."); return; }
        _detalle = res.Value;
    }
}
