<SfDialog @bind-Visible="_mostrarDetalle" Header="@(_detalle is null ? "Detalle" : $"{_detalle.EmployeeName} · {_detalle.Document}")" Width="920px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@_cargaDetalle.Activa">
            @if (_detalle is not null)
            {
                <div class="pagina">
                    <div class="kpi-grid">
                        <div class="kpi-card"><span class="label">Días liquidados</span><strong>@_detalle.DaysWorked</strong></div>
                        <div class="kpi-card"><span class="label">Cesantías + intereses</span><strong>@_detalle.Totals.Earnings.ToString("N0")</strong></div>
                        <div class="kpi-card"><span class="label">Retención</span><strong>@_detalle.Totals.Deductions.ToString("N0")</strong></div>
                        <div class="kpi-card"><span class="label">Neto</span><strong>@_detalle.Totals.Net.ToString("N0")</strong></div>
                    </div>
                    @if (_detalle.Refusals.Count > 0)
                    {
                        <div class="info-card alerta"><span class="label">Avisos del cálculo</span><ul>@foreach (var r in _detalle.Refusals) { <li>@r</li> }</ul></div>
                    }
                    <span class="label">Tramos de salario del año</span>
                    <table class="data-grid">
                        <thead><tr><th>Desde</th><th>Hasta</th><th class="monto">Días</th><th class="monto">Ausencias</th><th class="monto">Salario mensual</th></tr></thead>
                        <tbody>
                            @foreach (var t in _detalle.SalaryTranches)
                            {
                                <tr><td>@t.From.ToString("dd/MM/yyyy")</td><td>@t.To.ToString("dd/MM/yyyy")</td><td class="monto">@t.Days</td><td class="monto">@t.AbsenceDays</td><td class="monto">@t.MonthlySalary.ToString("N0")</td></tr>
                            }
                        </tbody>
                    </table>
                    <span class="label">Bases</span>
                    <ol class="explicacion-pasos">
                        @foreach (var b in _detalle.Bases)
                        {
                            <li><span>@b.Label</span> @if (b.Value is { } v) { <strong class="monto">@v.ToString("N2")</strong> } else if (b.Text is not null) { <em class="texto-tenue">@b.Text</em> }</li>
                        }
                    </ol>
                    <span class="label">Líneas</span>
                    @foreach (var grupo in _detalle.Lines.GroupBy(l => l.NaturalezaTexto))
                    {
                        <h4>@grupo.Key</h4>
                        <table class="data-grid">
                            <thead><tr><th></th><th>Concepto</th><th class="monto">Días</th><th class="monto">Base</th><th class="monto">Factor</th><th class="monto">Valor</th></tr></thead>
                            <tbody>
                                @foreach (var l in grupo)
                                {
                                    <tr>
                                        <td><SfButton CssClass="e-flat e-small" IconCss="@(_lineaAbierta == l.PublicId ? "e-icons e-chevron-up" : "e-icons e-chevron-down")" OnClick="@(() => _lineaAbierta = _lineaAbierta == l.PublicId ? null : l.PublicId)" /></td>
                                        <td>@l.ConceptCode · @l.ConceptName @(l.AffectsAccounting ? string.Empty : " (sin asiento)")</td>
                                        <td class="monto">@(l.Quantity?.ToString("0.##"))</td>
                                        <td class="monto">@(l.BaseAmount?.ToString("N2"))</td>
                                        <td class="monto">@(l.Factor?.ToString("0.####"))</td>
                                        <td class="monto"><strong>@l.Amount.ToString("N0")</strong></td>
                                    </tr>
                                    @if (_lineaAbierta == l.PublicId)
                                    {
                                        <tr><td colspan="6"><ExplicacionDeLinea Explicacion="@l.Explanation" /></td></tr>
                                    }
                                }
                            </tbody>
                        </table>
                    }
                    @if (_detalle.Skips.Count > 0)
                    {
                        <details>
                            <summary class="texto-tenue">Rubros que no aplicaron (@_detalle.Skips.Count)</summary>
                            <ul class="texto-tenue">@foreach (var s in _detalle.Skips) { <li>@s</li> }</ul>
                        </details>
                    }
                    @if (_seleccion is { Status: "Approved" or "Reversed" })
                    {
                        <div class="toolbar">
                            <SfButton CssClass="e-outline" IconCss="e-icons e-file-document" Disabled="@_ocupado" OnClick="@(() => DescargarComprobanteAsync(_detalle.EmployeePublicId))">Comprobante PDF</SfButton>
                        </div>
                    }
                </div>
            }
            </IndicadorDeCarga>
        </Content>
    </DialogTemplates>
</SfDialog>

<GenerarDispersion @bind-Visible="_mostrarDispersion" RunPublicId="@(_corrida?.PublicId ?? Guid.Empty)" Etiqueta="Intereses a las cesantías (lo que va al empleado)" FechaDePagoPropuesta="@(_corrida?.PayDate?.ToDateTime(TimeOnly.MinValue))" />

@code {
    // Feature 010 (US8): el archivo de dispersión se genera desde esta relación de pago.
    private bool _mostrarDispersion;
    /// <summary>Llegar con <c>?corrida=</c> (desde el comprobante contable, «Ver en Nómina») elige esa corrida al cargar y se para en su año.</summary>
    [SupplyParameterFromQuery(Name = "corrida")] public Guid? Corrida { get; set; }

    /// <summary>El enlace se consume una sola vez: después manda lo que la persona calcule o elija (<see cref="SeleccionDeCesantias"/>).</summary>
    private Guid? _corridaDelEnlace;

    // Indicadores por zona (docs/manual/indicador-de-carga.md): la lista del año, la corrida elegida y el
    // detalle del empleado cargan por separado; _ocupado es la bandera de las acciones.
    private readonly EstadoDeCarga _cargaLista = new();
    private readonly EstadoDeCarga _carga = new();
    private readonly EstadoDeCarga _cargaDetalle = new();

    private int _anio = DateTime.Today.Year;
    private List<LiquidacionCesantiasDto> _lista = [];
    private LiquidacionCesantiasDto? _seleccion;
    private ResumenCorridaDto? _corrida;
    private List<EmpleadoDeCorridaDto> _empleados = [];
    private RelacionDeConsignacionDto? _relacion;
    private RelacionDePagoDto? _relacionPago;
    private List<ExcluidoDeLiquidacionDto> _excluidos = [];
    private bool _excluidosConocidos;
    private List<string> _avisos = [];
    private DetalleEmpleadoCorridaDto? _detalle;
    private Guid? _lineaAbierta;
    private string _buscarEmpleado = string.Empty;
    private bool _ocupado, _mostrarNueva, _mostrarAprobacion, _mostrarDescartar, _mostrarReversar, _mostrarMarcarConsignado, _mostrarMarcarPago, _mostrarDetalle;
    private string _motivo = string.Empty;
    private List<string>? _pagadosAntesDeReversar;
    private FondoConsignacionDto? _fondoAMarcar;

    private readonly NuevaLiquidacion _nueva = new();
    private readonly Aprobacion _aprobacion = new();
    private readonly Consignacion _consignacion = new();
    private readonly MarcaDePago _marca = new();

    private sealed class NuevaLiquidacion
    {
        public int Anio { get; set; } = DateTime.Today.Year;
        public DateTime Corte { get; set; } = new(DateTime.Today.Year, 12, 31);
    }

    private sealed class Aprobacion
    {
        public DateTime FechaComprobante { get; set; }
        public DateTime FechaPagoIntereses { get; set; }
        public bool Confirmar { get; set; }
        public bool ConfirmarVacia { get; set; }
        public bool ConfirmarSinSegregacion { get; set; }
        public bool PideSegundaConfirmacion { get; set; }
    }

    private sealed class Consignacion
    {
        public DateTime Fecha { get; set; } = DateTime.Today;
        public string? Referencia { get; set; }
    }

    private sealed class MarcaDePago
    {
        public DateTime Fecha { get; set; } = DateTime.Today;
        public string Medio { get; set; } = "Transfer";
        public string? Referencia { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        if (Corrida is { } id)
        {
            _corridaDelEnlace = id;
            var r = await Nomina.ResumenAsync(id);
            if (r.IsSuccess && r.Value!.Year is { } anio) _anio = anio;
        }
        await CargarListaAsync();
    }

    private static string Insignia(string status) => status switch
    {
        "Approved" => "e-badge e-badge-success",
        "Reversed" => "e-badge e-badge-danger",
        "Draft" => "e-badge e-badge-info",
        "Stale" => "e-badge e-badge-warning",
        _ => "e-badge",
    };

    /// <param name="elegir">La corrida que debe quedar elegida (la recién calculada o recalculada); nula, la regla de <see cref="SeleccionDeCesantias"/>.</param>
    private async Task CargarListaAsync(Guid? elegir = null)
    {
        using var carga = _cargaLista.Iniciar();
        var res = await Nomina.ListarCesantiasAnualesAsync(_anio);
        if (!res.IsSuccess) { await Notification.ErrorAsync(res.ErrorCode == "Generic.NotFound" ? NotificationServiceExtensions.SinPermiso : res.ErrorMessage ?? "No se pudieron cargar las liquidaciones de cesantías."); return; }
        _lista = res.Value!.ToList();
        var vigente = SeleccionDeCesantias.Elegir(_lista, elegir, _seleccion?.RunPublicId, _corridaDelEnlace);
        _corridaDelEnlace = null;
        if (vigente is null) { _seleccion = null; _corrida = null; _relacion = null; return; }
        await SeleccionarAsync(vigente);
    }

    private async Task SeleccionarAsync(LiquidacionCesantiasDto l)
    {
        using var carga = _carga.Iniciar();
        if (_seleccion?.RunPublicId != l.RunPublicId) { _excluidos = []; _excluidosConocidos = false; _avisos = []; }
        _seleccion = l;
        _corrida = null; _empleados = []; _relacion = null; _relacionPago = null;
        // Resumen, relación de consignación y empleados dependen sólo de la corrida: salen a la vez.
        var resumen = Nomina.ResumenAsync(l.RunPublicId);
        var relacion = Nomina.RelacionDeConsignacionAsync(l.RunPublicId);
        var empleados = Nomina.EmpleadosDeCorridaAsync(l.RunPublicId, buscar: string.IsNullOrWhiteSpace(_buscarEmpleado) ? null : _buscarEmpleado);
        await Task.WhenAll(resumen, relacion, empleados);
        var r = await resumen;
        if (r.IsSuccess) _corrida = r.Value; else await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo cargar la liquidación.");
        var c = await relacion;
        if (c.IsSuccess) _relacion = c.Value; else await Notification.ErrorAsync(c.ErrorMessage ?? "No se pudo cargar la relación de consignación.");
        var e = await empleados;
        if (e.IsSuccess) _empleados = e.Value!.ToList(); else await Notification.ErrorAsync(e.ErrorMessage ?? "No se pudieron cargar los empleados.");
        if (_corrida?.Warnings is { Count: > 0 } avisos && _avisos.Count == 0) _avisos = avisos.Select(a => a.Message).ToList();
        StateHasChanged();
    }

    private async Task CargarEmpleadosAsync()
    {
        using var carga = _carga.Iniciar();
        if (_seleccion is null) return;
        var res = await Nomina.EmpleadosDeCorridaAsync(_seleccion.RunPublicId, buscar: string.IsNullOrWhiteSpace(_buscarEmpleado) ? null : _buscarEmpleado);
        if (res.IsSuccess) _empleados = res.Value!.ToList(); else await Notification.ErrorAsync(res.ErrorMessage ?? "No se pudieron cargar los empleados.");
        StateHasChanged();
    }

    private async Task CargarRelacionPagoAsync()
    {
        using var carga = _carga.Iniciar();
        if (_seleccion is null) return;
        var res = await Nomina.RelacionDePagoAsync(_seleccion.RunPublicId);
        if (res.IsSuccess) _relacionPago = res.Value; else await Notification.ErrorAsync(res.ErrorMessage ?? "No se pudo cargar la relación de pago de intereses.");
    }

    // ------------------------------------------------------------------ calcular --

    private void AbrirNueva()
    {
        _nueva.Anio = _anio;
        _nueva.Corte = new DateTime(_anio, 12, 31);
        _mostrarNueva = true;
    }

    private void RecibirCalculo(LiquidacionCalculadaDto r, string verbo)
    {
        _excluidos = r.Excluded.ToList();
        _excluidosConocidos = true;
        _avisos = r.Warnings.Select(w => w.Message).ToList();
        _ = Notification.SuccessAsync(r.Resumen(verbo));
    }

    private async Task CalcularAsync()
    {
        if (_ocupado) return;
        _ocupado = true;
        try
        {
            var corte = DateOnly.FromDateTime(_nueva.Corte);
            var res = await Nomina.CalcularCesantiasAsync(new CalcularCesantiasRequest(_nueva.Anio, corte));
            if (!res.IsSuccess) { await Notification.ErrorAsync(res.ErrorMessage ?? "No se pudo calcular."); return; }
            _mostrarNueva = false;
            _anio = _nueva.Anio;
            // La recién calculada queda elegida aunque se haya llegado con ?corrida=; elegirla vacía los
            // excluidos y los avisos, así que RecibirCalculo va después del refresco.
            await CargarListaAsync(elegir: res.Value!.RunPublicId);
            RecibirCalculo(res.Value, "Borrador");
        }
        finally { _ocupado = false; }
    }

    private async Task RecalcularAsync()
    {
        if (_seleccion is null || _ocupado) return;
        _ocupado = true;
        try
        {
            var res = await Nomina.RecalcularCesantiasAsync(_seleccion.RunPublicId);
            if (!res.IsSuccess) { await Notification.ErrorAsync(res.ErrorMessage ?? "No se pudo recalcular."); return; }
            await CargarListaAsync(elegir: res.Value!.RunPublicId);
            RecibirCalculo(res.Value, "Recalculado");
        }
        finally { _ocupado = false; }
    }

    // ------------------------------------------------------------------- aprobar --

    private void AbrirAprobacion()
    {
        if (_seleccion is null) return;
        _aprobacion.FechaComprobante = _seleccion.CutoffDate.ToDateTime(TimeOnly.MinValue);
        _aprobacion.FechaPagoIntereses = (_relacion?.InterestDueDate ?? _seleccion.CutoffDate).ToDateTime(TimeOnly.MinValue);
        _aprobacion.Confirmar = _aprobacion.ConfirmarVacia = _aprobacion.ConfirmarSinSegregacion = _aprobacion.PideSegundaConfirmacion = false;
        _mostrarAprobacion = true;
    }

    private bool PuedeAprobar =>
        !_ocupado && _aprobacion.Confirmar && _corrida is not null
        && (_corrida.EmployeeCount > 0 || _aprobacion.ConfirmarVacia)
        && _corrida.Blockers.Count == 0
        && (!_aprobacion.PideSegundaConfirmacion || _aprobacion.ConfirmarSinSegregacion);

    private async Task AprobarAsync()
    {
        if (_seleccion is null || _ocupado) return;
        _ocupado = true;
        try
        {
            var res = await Nomina.AprobarCesantiasAsync(_seleccion.RunPublicId, new AprobarLiquidacionRequest(
                Confirm: true,
                PostingDate: DateOnly.FromDateTime(_aprobacion.FechaComprobante),
                PayDate: DateOnly.FromDateTime(_aprobacion.FechaPagoIntereses),
                ConfirmEmpty: _aprobacion.ConfirmarVacia,
                ConfirmWithoutSegregation: _aprobacion.ConfirmarSinSegregacion));
            if (!res.IsSuccess)
            {
                if (res.ErrorCode == "Payroll.Settlement.ConfirmationRequired" && (res.ErrorMessage ?? string.Empty).Contains("segregaci", StringComparison.OrdinalIgnoreCase))
                {
                    _aprobacion.PideSegundaConfirmacion = true;
                    await Notification.WarningAsync(res.ErrorMessage ?? "Se requiere una segunda confirmación.");
                    return;
                }
                await Notification.ErrorAsync(res.ErrorMessage ?? "No se pudo aprobar.");
                return;
            }
            _mostrarAprobacion = false;
            await Notification.SuccessAsync($"Cesantías e intereses aprobados. Comprobante {res.Value!.Number} del {res.Value.PostingDate:dd/MM/yyyy}; total {res.Value.Total:N0}.");
            await CargarListaAsync();
        }
        finally { _ocupado = false; }
    }

    // ------------------------------------------------------- descartar / reversar --

    private async Task DescartarAsync()
    {
        if (_seleccion is null || _ocupado) return;
        _ocupado = true;
        try
        {
            var res = await Nomina.DescartarCesantiasAsync(_seleccion.RunPublicId, _motivo.Trim());
            if (!res.IsSuccess) { await Notification.ErrorAsync(res.ErrorMessage ?? "No se pudo descartar el borrador."); return; }
            _mostrarDescartar = false;
            await Notification.SuccessAsync("Borrador descartado.");
            _seleccion = null;
            await CargarListaAsync();
        }
        finally { _ocupado = false; }
    }

    private async Task AbrirReversarAsync()
    {
        if (_seleccion is null) return;
        _motivo = string.Empty;
        _pagadosAntesDeReversar = null;
        var rel = await Nomina.RelacionDePagoAsync(_seleccion.RunPublicId);
        if (rel.IsSuccess) _pagadosAntesDeReversar = rel.Value!.Rows.Where(r => r.Paid).Select(r => r.EmployeeName).ToList();
        _mostrarReversar = true;
    }

    private async Task ReversarAsync()
    {
        if (_seleccion is null || _ocupado) return;
        _ocupado = true;
        try
        {
            var res = await Nomina.ReversarCesantiasAsync(_seleccion.RunPublicId, _motivo.Trim());
            if (!res.IsSuccess) { await Notification.ErrorAsync(res.ErrorMessage ?? "No se pudo reversar."); return; }
            _mostrarReversar = false;
            await Notification.SuccessAsync($"Liquidación reversada con el comprobante {res.Value!.ReversalNumber}. Se puede liquidar de nuevo.");
            await CargarListaAsync();
        }
        finally { _ocupado = false; }
    }

    // ------------------------------------------------------------ consignación --

    private void AbrirMarcarConsignado(FondoConsignacionDto fondo)
    {
        _fondoAMarcar = fondo;
        _consignacion.Fecha = DateTime.Today;
        _consignacion.Referencia = null;
        _mostrarMarcarConsignado = true;
    }

    private async Task MarcarConsignadoAsync()
    {
        if (_seleccion is null || _fondoAMarcar?.FundPublicId is not { } fondoId || _ocupado) return;
        _ocupado = true;
        try
        {
            var res = await Nomina.MarcarConsignadoAsync(_seleccion.RunPublicId, fondoId,
                new MarcarConsignadoRequest(DateOnly.FromDateTime(_consignacion.Fecha), string.IsNullOrWhiteSpace(_consignacion.Referencia) ? null : _consignacion.Referencia.Trim()));
            if (!res.IsSuccess) { await Notification.ErrorAsync(res.ErrorMessage ?? "No se pudo registrar la consignación."); return; }
            _mostrarMarcarConsignado = false;
            await Notification.SuccessAsync($"Consignación a {res.Value!.FundName} registrada: {res.Value.Amount:N0} el {res.Value.DepositedAt:dd/MM/yyyy}.");
            await CargarListaAsync();
        }
        finally { _ocupado = false; }
    }

    private async Task DescargarConsignacionAsync(string formato, Guid? fondoId)
    {
        if (_seleccion is null || _ocupado) return;
        _ocupado = true;
        try
        {
            var res = await Nomina.DescargarConsignacionAsync(_seleccion.RunPublicId, formato, fondoId);
            if (!res.IsSuccess) { await Notification.ErrorAsync(res.ErrorMessage ?? "No se pudo exportar la relación de consignación."); return; }
            await Descargas.GuardarAsync(res.Value!.Nombre, res.Value.TipoContenido, res.Value.Contenido);
        }
        finally { _ocupado = false; }
    }

    // ------------------------------------------------------ pago de intereses --

    private async Task MarcarPagadosAsync()
    {
        if (_seleccion is null || _ocupado) return;
        _ocupado = true;
        try
        {
            var res = await Nomina.MarcarPagadosAsync(_seleccion.RunPublicId, new MarcarPagoRequest(null, _marca.Fecha, _marca.Medio, _marca.Referencia));
            if (!res.IsSuccess) { await Notification.ErrorAsync(res.ErrorMessage ?? "No se pudo marcar el pago."); return; }
            _mostrarMarcarPago = false;
            await Notification.SuccessAsync($"{res.Value} empleado(s) marcados con los intereses pagados.");
            await CargarRelacionPagoAsync();
        }
        finally { _ocupado = false; }
    }

    private async Task DescargarComprobanteAsync(Guid empleadoId)
    {
        if (_seleccion is null || _ocupado) return;
        _ocupado = true;
        try
        {
            var res = await Nomina.ComprobanteAsync(_seleccion.RunPublicId, empleadoId);
