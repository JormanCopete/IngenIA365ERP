        }
        finally { _ocupado = false; }
    }

    // ------------------------------------------------------------------ detalle --

    private async Task AbrirDetalleAsync(Guid empleadoId)
    {
        if (_seleccion is null) return;
        _detalle = null; _lineaAbierta = null;
        _mostrarDetalle = true;
        using var carga = _cargaDetalle.Iniciar();
        var res = await Nomina.DetalleEmpleadoAsync(_seleccion.RunPublicId, empleadoId);
        if (!res.IsSuccess) { await Notification.ErrorAsync(res.ErrorMessage ?? "No se pudo cargar el detalle."); _mostrarDetalle = false; return; }
        _detalle = res.Value;
    }
}
