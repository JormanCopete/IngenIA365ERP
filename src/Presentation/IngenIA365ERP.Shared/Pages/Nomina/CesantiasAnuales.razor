@page "/nomina/cesantias-anuales"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using IngenIA365ERP.Shared.Services.Nomina
@using IngenIA365ERP.Shared.Models.Nomina
@using IngenIA365ERP.Shared.Components.Nomina
@inject NominaClient Nomina
@inject INotificationService Notification
@inject IngenIA365ERP.Shared.Services.Nomina.DescargaDeArchivos Descargas

@*
    Feature 010 US2 (FR-010 a FR-012; contracts/api.md §3.2): las cesantías e intereses del año como
    una corrida más (Kind = Severance): se calculan a 31-12 (o a otro corte del año), se revisan por
    empleado con la explicación paso a paso, se aprueban con el comprobante NM que cancela las
    provisiones y deja la cuenta por pagar al fondo (cesantías) y al empleado (intereses), y de ahí
    salen dos entregas distintas: la relación de pago de los intereses (al empleado, ≤ 31-01) y la
    relación de consignación por fondo (≤ 14-02), que se exporta y se marca consignada fondo por
    fondo. «/nomina/cesantias» es el catálogo de fondos; esta pantalla es la liquidación anual.
*@

<PageTitle>Cesantías e intereses del año - IngenIA365ERP</PageTitle>

<PermissionGate Required="Payroll.Severance.View" MostrarAviso="true">
<ChildContent>
<div class="page-header">
    <h3>Cesantías e intereses del año</h3>
    <div>
        <label>
            Año
            <SfNumericTextBox TValue="int" @bind-Value="_anio" Min="2000" Max="2100" Decimals="0" Format="0" ShowSpinButton="true" Width="110px"
                              ValueChange="@((Syncfusion.Blazor.Inputs.ChangeEventArgs<int> _) => CargarListaAsync())" />
        </label>
        <PermissionGate Required="Payroll.Severance.Calculate">
            <SfButton CssClass="e-primary" IconCss="e-icons e-plus" Disabled="@_ocupado" OnClick="@AbrirNueva">Nueva liquidación</SfButton>
        </PermissionGate>
    </div>
</div>

<IndicadorDeCarga Cargando="@(_cargaLista.Activa || _ocupado)" Texto="@(_ocupado ? "Procesando…" : "Cargando…")">
@if (_lista.Count == 0 && !_cargaLista.Activa)
{
    <div class="info-card">
        <span class="label">Sin liquidaciones de @_anio</span>
        <p>Todavía no se han liquidado las cesantías e intereses de @_anio. «Nueva liquidación» calcula a todos los empleados vigentes en el año (integrales, aprendices en etapa lectiva y retirados con definitiva aprobada quedan fuera con su razón) y deja un borrador para revisar antes de aprobar.</p>
    </div>
}
else if (_lista.Count > 0)
{
    <table class="data-grid">
        <thead><tr><th>Versión</th><th>Corte</th><th>Estado</th><th class="monto">Empleados</th><th class="monto">Cesantías</th><th class="monto">Intereses</th><th>Fondos</th><th>Comprobante</th><th>Calculada</th></tr></thead>
        <tbody>
            @foreach (var l in _lista)
            {
                <tr class="@(_seleccion?.RunPublicId == l.RunPublicId ? "resaltada" : "")" @onclick="() => SeleccionarAsync(l)" title="Elegir esta versión">
                    <td>v@l.Version</td>
                    <td>@l.CutoffDate.ToString("dd/MM/yyyy")</td>
                    <td><span class="@Insignia(l.Status)">@l.EstadoTexto</span></td>
                    <td class="monto">@l.Employees</td>
                    <td class="monto">@l.SeveranceTotal.ToString("N0")</td>
                    <td class="monto">@l.InterestTotal.ToString("N0")</td>
                    <td>@(l.Funds.Count(f => f.FundPublicId is not null)) fondo(s)@(l.EstaAprobada ? $" · {l.FondosConsignados} consignado(s)" : "")</td>
                    <td>@(l.PostedDocumentNumber ?? "—")</td>
                    <td class="texto-tenue">@l.CalculatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @l.CalculatedBy</td>
                </tr>
            }
        </tbody>
    </table>
}
</IndicadorDeCarga>

@if (_seleccion is not null)
{
    <div class="toolbar">
        <PermissionGate Required="Payroll.Severance.Calculate">
            @if (_seleccion.EsBorrador)
            {
                <SfButton CssClass="e-primary" IconCss="e-icons e-refresh" Disabled="@_ocupado" OnClick="@RecalcularAsync">Recalcular</SfButton>
                <SfButton CssClass="e-outline e-danger" IconCss="e-icons e-trash" Disabled="@_ocupado" OnClick="@(() => { _motivo = string.Empty; _mostrarDescartar = true; })" Title="Deja este borrador como descartado, con motivo. Sin contabilidad.">Descartar borrador</SfButton>
            }
        </PermissionGate>
        <PermissionGate Required="Payroll.Severance.Approve">
            @if (_seleccion.SePuedeAprobar)
            {
                <SfButton CssClass="e-success" IconCss="e-icons e-check" Disabled="@_ocupado" OnClick="@AbrirAprobacion">Aprobar</SfButton>
            }
        </PermissionGate>
        <PermissionGate Required="Payroll.Severance.Reverse">
            @if (_seleccion.EstaAprobada)
            {
                <SfButton CssClass="e-outline e-danger" IconCss="e-icons e-undo" Disabled="@_ocupado" OnClick="@AbrirReversarAsync" Title="Deshace la aprobación con un asiento espejo; las consignaciones ya marcadas quedan como historial">Reversar</SfButton>
            }
        </PermissionGate>
        <SfButton CssClass="e-outline" IconCss="e-icons e-download" Disabled="@_ocupado" OnClick="@(() => DescargarConsignacionAsync("xlsx", null))" Title="Relación de consignación en Excel: una hoja por fondo">Excel</SfButton>
        <SfButton CssClass="e-outline" IconCss="e-icons e-download" Disabled="@_ocupado" OnClick="@(() => DescargarConsignacionAsync("pdf", null))">PDF</SfButton>
        <SfButton CssClass="e-outline" IconCss="e-icons e-download" Disabled="@_ocupado" OnClick="@(() => DescargarConsignacionAsync("docx", null))">Word</SfButton>
    </div>

    <IndicadorDeCarga Cargando="@(_carga.Activa || _ocupado)" Texto="@(_ocupado ? "Procesando…" : "Cargando…")">
    @if (_corrida is not null)
    {
        <div class="info-card">
            <span class="label">Estado</span>
            @if (_corrida.Status is "Draft" or "Stale")
            {
                <p><strong>Borrador v@_corrida.Version</strong> de las cesantías e intereses @_seleccion.Year (corte @_seleccion.CutoffDate.ToString("dd/MM/yyyy")), calculado por @_corrida.CalculatedBy el @_corrida.CalculatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm"). Al aprobar, el comprobante NM cancela las provisiones de cesantías e intereses, deja la cuenta por pagar de las cesantías <strong>al fondo</strong> y la de los intereses <strong>al empleado</strong>.</p>
            }
            else if (_corrida.Status == "Approved")
            {
                <p><strong>Aprobado</strong> por @_corrida.ApprovedBy el @_corrida.ApprovedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · comprobante @_corrida.AccountingDocumentNumber
                   · intereses a pagar el @(_corrida.PayDate?.ToString("dd/MM/yyyy") ?? "—")@(_corrida.ApprovedWithoutSegregation ? " · aprobado sin segregación de funciones" : string.Empty)</p>
            }
            else if (_corrida.Status == "Reversed")
            {
                <p><strong>Reversado</strong> por @_corrida.ReversedBy el @_corrida.ReversedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm"): @_corrida.ReversalReason</p>
            }
            else
            {
                <p><strong>@_seleccion.EstadoTexto</strong> · v@_corrida.Version</p>
            }
            @if (_relacion is { DueDate: { } limite } && _relacion.TieneFondosSinConsignar && _seleccion.EstaAprobada)
            {
                <p class="@(limite < DateOnly.FromDateTime(DateTime.Today) ? "texto-alerta" : "texto-tenue")">Fecha límite para consignar a los fondos: <strong>@limite.ToString("dd/MM/yyyy")</strong>@(limite < DateOnly.FromDateTime(DateTime.Today) ? " — vencida: hay fondos sin marcar." : ".")</p>
            }
            @if (_relacion is { InterestDueDate: { } limiteInt } && _seleccion.EstaAprobada)
            {
                <p class="texto-tenue">Los intereses se pagan al empleado hasta el @limiteInt.ToString("dd/MM/yyyy") (relación de pago de intereses).</p>
            }
            @if (_avisos.Count > 0)
            {
                <ul class="texto-tenue">@foreach (var a in _avisos) { <li>@a</li> }</ul>
            }
        </div>

        <SfTab>
            <TabItems>
                <TabItem>
                    <ChildContent><TabHeader Text="Resumen" /></ChildContent>
                    <ContentTemplate>
                        <div class="kpi-grid">
                            <div class="kpi-card"><span class="label">Cesantías (al fondo)</span><strong>@_seleccion.SeveranceTotal.ToString("N0")</strong></div>
                            <div class="kpi-card"><span class="label">Intereses (al empleado)</span><strong>@_seleccion.InterestTotal.ToString("N0")</strong></div>
                            <div class="kpi-card"><span class="label">Retención</span><strong>@_corrida.Totals.Deductions.ToString("N0")</strong></div>
                            <div class="kpi-card"><span class="label">Neto</span><strong>@_corrida.Totals.Net.ToString("N0")</strong></div>
                            <div class="kpi-card"><span class="label">Ajuste de provisión</span><strong>@_corrida.Totals.Provisions.ToString("N0")</strong></div>
                            <div class="kpi-card"><span class="label">Empleados</span><strong>@_corrida.EmployeeCount</strong></div>
                        </div>
                        @if (_corrida.Blockers.Count > 0)
                        {
                            <span class="label">Bloqueos para aprobar (@_corrida.Blockers.Count)</span>
                            <table class="data-grid">
                                <thead><tr><th>Empleado</th><th>Bloqueo</th><th>Detalle</th></tr></thead>
                                <tbody>
                                    @foreach (var b in _corrida.Blockers)
                                    {
                                        <tr><td><a href="" @onclick="() => AbrirDetalleAsync(b.EmployeePublicId)" @onclick:preventDefault>@b.EmployeeName</a></td><td>@b.BanderaTexto</td><td class="texto-tenue">@b.Detail</td></tr>
                                    }
                                </tbody>
                            </table>
                        }
                        <span class="label">Por concepto</span>
                        <table class="data-grid">
                            <thead><tr><th>Concepto</th><th>Tipo</th><th class="monto">Empleados</th><th class="monto">Valor</th></tr></thead>
                            <tbody>
                                @foreach (var c in _corrida.ByConcept)
                                {
                                    <tr><td>@c.Code · @c.Name</td><td>@c.NaturalezaTexto</td><td class="monto">@c.Employees</td><td class="monto">@c.Amount.ToString("N0")</td></tr>
                                }
                            </tbody>
                        </table>
                        <p class="texto-tenue">Hash de insumos: <code>@_corrida.InputsHash</code></p>
                    </ContentTemplate>
                </TabItem>
                <TabItem>
                    <ChildContent><TabHeader Text="Empleados" /></ChildContent>
                    <ContentTemplate>
                        <div class="toolbar">
                            <SfTextBox @bind-Value="_buscarEmpleado" Placeholder="Buscar" ShowClearButton="true" ValueChange="@(async (Syncfusion.Blazor.Inputs.ChangedEventArgs e) => await CargarEmpleadosAsync())" />
                        </div>
                        <SfGrid TValue="EmpleadoDeCorridaDto" DataSource="@_empleados" AllowPaging="true" AllowSorting="true">
                            <GridPageSettings PageSize="25" />
                            <GridEvents TValue="EmpleadoDeCorridaDto" RowSelected="@(async (RowSelectEventArgs<EmpleadoDeCorridaDto> e) => await AbrirDetalleAsync(e.Data.EmployeePublicId))" />
                            <GridColumns>
                                <GridColumn Field="EmployeeName" HeaderText="Empleado" Width="220" />
                                <GridColumn Field="Document" HeaderText="Documento" Width="120" />
                                <GridColumn Field="DaysWorked" HeaderText="Días" Width="70" TextAlign="TextAlign.Center" />
                                <GridColumn Field="TotalEarnings" HeaderText="Cesantías + intereses" Width="150" Format="N0" TextAlign="TextAlign.Right" />
                                <GridColumn Field="TotalDeductions" HeaderText="Retención" Width="110" Format="N0" TextAlign="TextAlign.Right" />
                                <GridColumn Field="NetPay" HeaderText="Neto" Width="120" Format="N0" TextAlign="TextAlign.Right" />
                                <GridColumn HeaderText="Banderas" Width="200">
                                    <Template>
                                        @{
                                            var e = (EmpleadoDeCorridaDto)context;
                                            if (e.TieneBloqueos) { <span class="e-badge e-badge-warning">@e.BanderasTexto</span> }
                                        }
                                    </Template>
                                </GridColumn>
                            </GridColumns>
                        </SfGrid>
                    </ContentTemplate>
                </TabItem>
                <TabItem>
                    <ChildContent><TabHeader Text="@($"Excluidos ({_excluidos.Count})")" /></ChildContent>
                    <ContentTemplate>
                        @if (_excluidos.Count == 0)
                        {
                            <p class="texto-tenue">@(_excluidosConocidos ? "Nadie quedó fuera en este cálculo." : "La lista de excluidos se muestra con el cálculo: recalculá para verla.")</p>
                        }
                        else
                        {
                            <table class="data-grid">
                                <thead><tr><th>Empleado</th><th>Razón</th><th>Detalle</th></tr></thead>
                                <tbody>
                                    @foreach (var x in _excluidos)
                                    {
                                        <tr><td>@x.Name</td><td><span class="e-badge">@x.RazonTexto</span></td><td class="texto-tenue">@x.Reason</td></tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </ContentTemplate>
                </TabItem>
                <TabItem>
                    <ChildContent><TabHeader Text="Consignación por fondo" /></ChildContent>
                    <ContentTemplate>
                        @if (_relacion is null)
                        {
                            <p class="texto-tenue">Sin relación de consignación.</p>
                        }
                        else
                        {
                            <div class="toolbar">
                                <span class="texto-tenue">@_relacion.Employees empleado(s) en @_relacion.Funds.Count bloque(s) · total a consignar <strong>@_relacion.GrandTotal.ToString("N0")</strong> · intereses (al empleado) @_relacion.InterestGrandTotal.ToString("N0")</span>
                            </div>
                            @foreach (var f in _relacion.Funds)
                            {
                                <div class="info-card">
                                    <div class="toolbar">
                                        <span class="label">@f.FundName@(f.FundNit is null ? "" : $" · NIT {f.FundNit}")@(f.PilaCode is null ? "" : $" · PILA {f.PilaCode}")</span>
                                        @if (f.SinFondo)
                                        {
                                            <span class="e-badge e-badge-danger">Sin fondo en la ficha: asignalo en Empleados antes de consignar</span>
                                        }
                                        else if (f.Consignado)
                                        {
                                            <span class="e-badge e-badge-success">Consignado el @f.DepositedAt?.ToString("dd/MM/yyyy") · @f.DepositedBy@(string.IsNullOrEmpty(f.Reference) ? "" : $" · ref. {f.Reference}")</span>
                                        }
                                        else
                                        {
                                            <span class="e-badge">Pendiente</span>
                                            <PermissionGate Required="Payroll.Severance.MarkDeposited">
                                                @if (_seleccion.EstaAprobada)
                                                {
                                                    <SfButton CssClass="e-primary e-small" IconCss="e-icons e-check" Disabled="@_ocupado" OnClick="@(() => AbrirMarcarConsignado(f))">Marcar consignado</SfButton>
                                                }
                                            </PermissionGate>
                                        }
                                        @if (!f.SinFondo)
                                        {
                                            <SfButton CssClass="e-flat e-small" IconCss="e-icons e-download" Title="Relación de este fondo en Excel" Disabled="@_ocupado" OnClick="@(() => DescargarConsignacionAsync("xlsx", f.FundPublicId))" />
                                        }
                                    </div>
                                    <table class="data-grid">
                                        <thead><tr><th>Documento</th><th>Empleado</th><th>Ingreso</th><th class="monto">Base</th><th class="monto">Días</th><th class="monto">Cesantías</th><th class="monto">Intereses</th></tr></thead>
                                        <tbody>
                                            @foreach (var l in f.Lines)
                                            {
                                                <tr>
                                                    <td>@l.DocumentType @l.Document</td>
                                                    <td><a href="" @onclick="() => AbrirDetalleAsync(l.EmployeePublicId)" @onclick:preventDefault>@l.Name</a></td>
                                                    <td>@l.HireDate.ToString("dd/MM/yyyy")</td>
                                                    <td class="monto">@l.BaseSalary.ToString("N0")</td>
                                                    <td class="monto">@l.Days.ToString("0.##")</td>
                                                    <td class="monto">@l.Amount.ToString("N0")</td>
                                                    <td class="monto texto-tenue">@l.Interest.ToString("N0")</td>
                                                </tr>
                                            }
                                            <tr class="resaltada"><td colspan="5"><strong>Total @f.FundName · @f.Employees empleado(s)</strong></td><td class="monto"><strong>@f.Total.ToString("N0")</strong></td><td class="monto texto-tenue">@f.InterestTotal.ToString("N0")</td></tr>
                                        </tbody>
                                    </table>
                                </div>
                            }
                        }
                    </ContentTemplate>
                </TabItem>
                @if (_seleccion.Status is "Approved" or "Reversed")
                {
                    <TabItem>
                        <ChildContent><TabHeader Text="Relación de pago de intereses" /></ChildContent>
                        <ContentTemplate>
                            @if (_relacionPago is null)
                            {
                                <SfButton CssClass="e-outline" OnClick="@CargarRelacionPagoAsync">Cargar relación de pago</SfButton>
                            }
                            else
                            {
                                <div class="toolbar">
                                    <span class="texto-tenue">@_relacionPago.PaidCount de @_relacionPago.Employees pagados · neto total @_relacionPago.TotalNet.ToString("N0") · pagado @_relacionPago.PaidNet.ToString("N0"). El neto es intereses menos retención: las cesantías van al fondo, no aquí.</span>
                                    @if (_seleccion.EstaAprobada && _relacionPago.PaidCount < _relacionPago.Employees)
                                    {
                                        <PermissionGate Required="Payroll.Payments.Mark">
                                            <SfButton CssClass="e-primary" IconCss="e-icons e-check" Disabled="@_ocupado" OnClick="@(() => { _marca.Fecha = _corrida.PayDate?.ToDateTime(TimeOnly.MinValue) ?? DateTime.Today; _marca.Referencia = null; _mostrarMarcarPago = true; })">Marcar pagados</SfButton>
                                        </PermissionGate>
                                        <PermissionGate Required="Payroll.Disbursement.Generate">
                                            <SfButton CssClass="e-outline" IconCss="e-icons e-export" Disabled="@_ocupado" OnClick="@(() => _mostrarDispersion = true)" Title="Archivo plano para el banco con los que tienen cuenta; «marcar enviado» los deja pagados en una acción">Archivo de dispersión</SfButton>
                                        </PermissionGate>
                                    }
                                    <SfButton CssClass="e-outline" IconCss="e-icons e-download" Disabled="@_ocupado" OnClick="@DescargarTodosLosComprobantesAsync" Title="Todos los comprobantes en un PDF">Comprobantes PDF</SfButton>
                                </div>
                                <SfGrid TValue="FilaRelacionDePagoDto" DataSource="@_relacionPago.Rows" AllowPaging="true" AllowSorting="true">
                                    <GridPageSettings PageSize="25" />
                                    <GridColumns>
                                        <GridColumn Field="EmployeeName" HeaderText="Empleado" Width="200" />
                                        <GridColumn Field="Document" HeaderText="Documento" Width="110" />
                                        <GridColumn Field="BankName" HeaderText="Banco" Width="140" />
                                        <GridColumn Field="BankAccountNumber" HeaderText="Cuenta" Width="140" />
                                        <GridColumn Field="NetPay" HeaderText="Neto" Width="120" Format="N0" TextAlign="TextAlign.Right" />
                                        <GridColumn HeaderText="Pago" Width="220">
                                            <Template>
                                                @{
                                                    var f = (FilaRelacionDePagoDto)context;
                                                    if (f.Paid) { <span class="e-badge e-badge-success">Pagado @f.PaidAt?.ToLocalTime().ToString("dd/MM/yyyy") · @f.PaymentMethod@(string.IsNullOrEmpty(f.Reference) ? "" : $" · {f.Reference}")</span> }
                                                    else { <span class="e-badge">Pendiente</span> }
                                                }
                                            </Template>
                                        </GridColumn>
                                        <GridColumn HeaderText="" Width="80">
                                            <Template>
                                                @{
                                                    var f = (FilaRelacionDePagoDto)context;
                                                    <SfButton CssClass="e-flat e-small" IconCss="e-icons e-file-document" Title="Comprobante PDF" OnClick="@(() => DescargarComprobanteAsync(f.EmployeePublicId))" />
                                                }
                                            </Template>
                                        </GridColumn>
                                    </GridColumns>
                                </SfGrid>
                            }
                        </ContentTemplate>
                    </TabItem>
                }
                <TabItem>
                    <ChildContent><TabHeader Text="Historial" /></ChildContent>
                    <ContentTemplate>
                        <p class="texto-tenue">Cada cálculo del año deja una versión. Las reemplazadas, descartadas y reversadas se conservan con quién, cuándo y por qué.</p>
                        <table class="data-grid">
                            <thead><tr><th>Versión</th><th>Corte</th><th>Estado</th><th>Calculada</th><th class="monto">Empleados</th><th class="monto">Cesantías</th><th class="monto">Intereses</th><th>Aprobación</th><th>Comprobante</th></tr></thead>
                            <tbody>
                                @foreach (var h in _lista)
                                {
                                    <tr class="@(h.RunPublicId == _seleccion.RunPublicId ? "" : "texto-tenue")">
                                        <td>v@h.Version</td>
                                        <td>@h.CutoffDate.ToString("dd/MM/yyyy")</td>
                                        <td>@h.EstadoTexto</td>
                                        <td>@h.CalculatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @h.CalculatedBy</td>
                                        <td class="monto">@h.Employees</td>
                                        <td class="monto">@h.SeveranceTotal.ToString("N0")</td>
                                        <td class="monto">@h.InterestTotal.ToString("N0")</td>
                                        <td>@(h.ApprovedAt is { } ap ? $"{ap.ToLocalTime():dd/MM/yyyy HH:mm} · {h.ApprovedBy}" : "—")</td>
                                        <td>@(h.PostedDocumentNumber ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </ContentTemplate>
                </TabItem>
            </TabItems>
        </SfTab>
    }
    </IndicadorDeCarga>
}

</ChildContent>
</PermissionGate>

@* ------------------------------------------------------------- nueva liquidación --- *@
<SfDialog @bind-Visible="_mostrarNueva" Header="Nueva liquidación de cesantías e intereses" Width="560px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@_ocupado" Texto="Calculando…">
            <div class="pagina">
                <div class="info-card">
                    <span class="label">Qué se calcula</span>
                    <p>Cesantías e intereses de todos los empleados vigentes en el año @_nueva.Anio hasta la fecha de corte, con la base del último salario (o el promedio del año si cambió en la ventana de estabilidad), los días del año menos suspensiones, y la retención sobre lo que se paga al empleado. Quien no tiene derecho queda en la lista de excluidos con su razón.</p>
                </div>
                <div class="rejilla-campos">
                    <div><SfNumericTextBox TValue="int" @bind-Value="_nueva.Anio" Min="2000" Max="2100" Decimals="0" Format="0" Placeholder="Año" FloatLabelType="FloatLabelType.Always" /></div>
                    <div><SfDatePicker TValue="DateTime" @bind-Value="_nueva.Corte" Format="dd/MM/yyyy" Placeholder="Fecha de corte (31 de diciembre)" FloatLabelType="FloatLabelType.Always" /></div>
                </div>
                <p class="hint">El corte es el 31 de diciembre. Otra fecha dentro del año sirve para un cierre anticipado; el comprobante se fecha al corte y no puede ser posterior a hoy.</p>
            </div>
            </IndicadorDeCarga>
        </Content>
        <FooterTemplate>
            <SfButton CssClass="e-flat" OnClick="@(() => _mostrarNueva = false)">Cancelar</SfButton>
            <SfButton CssClass="e-primary" Disabled="@_ocupado" OnClick="@CalcularAsync">Calcular</SfButton>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@* --------------------------------------------------------------------- aprobar --- *@
<SfDialog @bind-Visible="_mostrarAprobacion" Header="Aprobar las cesantías e intereses" Width="680px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@_ocupado" Texto="Aprobando…">
            @if (_corrida is not null && _seleccion is not null)
            {
                <div class="pagina">
                    <div class="info-card">
                        <span class="label">Qué se aprueba</span>
                        <p>Cesantías e intereses <strong>@_seleccion.Year</strong>, borrador v@_corrida.Version con <strong>@_corrida.EmployeeCount</strong> empleado(s):
                           cesantías <strong>@_seleccion.SeveranceTotal.ToString("N0")</strong> (cuenta por pagar a los fondos), intereses <strong>@_seleccion.InterestTotal.ToString("N0")</strong> (cuenta por pagar a cada empleado), retención @_corrida.Totals.Deductions.ToString("N0").</p>
                        <p class="texto-tenue">El comprobante NM cancela las provisiones acumuladas y lleva la diferencia al gasto (o la libera). Después: relación de pago de los intereses y consignación por fondo.</p>
                    </div>
                    @if (_corrida.Blockers.Count > 0)
                    {
                        <div class="info-card alerta">
                            <span class="label">Hay @_corrida.Blockers.Count bloqueo(s)</span>
                            <p>Una liquidación especial no admite excepciones: corregí la causa en la ficha o en las novedades y recalculá.</p>
                        </div>
                    }
                    <div class="rejilla-campos">
                        <div><SfDatePicker TValue="DateTime" @bind-Value="_aprobacion.FechaComprobante" Format="dd/MM/yyyy" Placeholder="Fecha del comprobante (por defecto el corte)" FloatLabelType="FloatLabelType.Always" /></div>
                        <div><SfDatePicker TValue="DateTime" @bind-Value="_aprobacion.FechaPagoIntereses" Format="dd/MM/yyyy" Placeholder="Fecha de pago de los intereses" FloatLabelType="FloatLabelType.Always" /></div>
                    </div>
                    <p class="hint">La fecha del comprobante va entre el corte y hoy (D-04: la provisión se cancela en el mes correcto). La de pago de los intereses es propia de esta liquidación@(_relacion?.InterestDueDate is { } li ? $"; la ley da hasta el {li:dd/MM/yyyy}" : "").</p>
                    @if (_corrida.EmployeeCount == 0)
                    {
                        <label class="campo-check"><input type="checkbox" @bind="_aprobacion.ConfirmarVacia" /> Entiendo que la liquidación no tiene empleados y quiero aprobarla vacía.</label>
                    }
                    <label class="campo-check"><input type="checkbox" @bind="_aprobacion.Confirmar" /> Confirmo aprobar las cesantías e intereses @_seleccion.Year con @_corrida.EmployeeCount empleado(s) y total @_corrida.Totals.Net.ToString("N0").</label>
                    @if (_aprobacion.PideSegundaConfirmacion)
                    {
                        <div class="info-card">
                            <span class="label">Segunda confirmación</span>
                            <p>Vos calculaste esta liquidación. La cooperativa permite aprobarla igual, pero queda registrada como aprobada sin segregación de funciones.</p>
                            <label class="campo-check"><input type="checkbox" @bind="_aprobacion.ConfirmarSinSegregacion" /> Confirmo aprobar sin segregación de funciones.</label>
                        </div>
                    }
                </div>
            }
            </IndicadorDeCarga>
        </Content>
        <FooterTemplate>
            <SfButton CssClass="e-flat" OnClick="@(() => _mostrarAprobacion = false)">Cancelar</SfButton>
            <SfButton CssClass="e-success" Disabled="@(!PuedeAprobar)" OnClick="@AprobarAsync">Aprobar</SfButton>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

