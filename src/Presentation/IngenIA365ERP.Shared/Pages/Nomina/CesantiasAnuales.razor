            </IndicadorDeCarga>
        </Content>
        <FooterTemplate>
            <SfButton CssClass="e-flat" OnClick="@(() => _mostrarReversar = false)">Cancelar</SfButton>
            <SfButton CssClass="e-danger" Disabled="@(_ocupado || string.IsNullOrWhiteSpace(_motivo) || _pagadosAntesDeReversar is { Count: > 0 })" OnClick="@ReversarAsync">Reversar</SfButton>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

