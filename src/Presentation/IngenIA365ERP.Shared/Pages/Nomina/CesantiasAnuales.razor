        }
        finally { _ocupado = false; }
    }

    private async Task DescargarTodosLosComprobantesAsync()
    {
        if (_seleccion is null || _ocupado) return;
        _ocupado = true;
        try
        {
            var res = await Nomina.TodosLosComprobantesAsync(_seleccion.RunPublicId);
            if (!res.IsSuccess) { await Notification.ErrorAsync(res.ErrorMessage ?? "No se pudieron generar los comprobantes."); return; }
