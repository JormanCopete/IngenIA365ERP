@page "/nomina/cuentas-concepto"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification

<PageTitle>Cuentas por Concepto - IngenIA365ERP</PageTitle>

<div class="page-header">
    <h3>Cuentas por Concepto</h3>
    <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@OpenCreate">Nuevo</SfButton>
</div>

<SfGrid @ref="_grid" TValue="ItemModel" DataSource="@_items" AllowPaging="true" AllowSorting="true" AllowFiltering="true">
    <GridColumns>
        <GridColumn Field="ConceptId" HeaderText="Concepto" Width="120" TextAlign="TextAlign.Center" />
        <GridColumn Field="CostCenterId" HeaderText="Centro Costo" Width="130" />
        <GridColumn Field="ExpenseAccountCode" HeaderText="Cuenta Gasto" Width="160" />
        <GridColumn Field="CounterAccountCode" HeaderText="Contrapartida" Width="160" />
        <GridColumn Field="ProvisionAccountCode" HeaderText="Cuenta Provision" Width="160" />
        <GridColumn HeaderText="Acciones" Width="150" TextAlign="TextAlign.Center">
            <Template>
                @{
                    var item = context as ItemModel;
                    <SfButton CssClass="e-flat e-small" IconCss="e-icons e-edit" OnClick="@(() => OpenEdit(item!))" />
                    <SfButton CssClass="e-flat e-small e-danger" IconCss="e-icons e-trash" OnClick="@(() => OpenDelete(item!))" />
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

<SfDialog @bind-Visible="_showDialog" Header="@_dialogTitle" Width="500px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <div class="pagina">
                <SfNumericTextBox TValue="int" @bind-Value="_model.ConceptId" Placeholder="Concepto" FloatLabelType="FloatLabelType.Always" />
                <SfTextBox @bind-Value="_model.CostCenterId" Placeholder="Centro de Costo" FloatLabelType="FloatLabelType.Always" />
                <SfTextBox @bind-Value="_model.ExpenseAccountCode" Placeholder="Cuenta Gasto" FloatLabelType="FloatLabelType.Always" />
                <SfTextBox @bind-Value="_model.CounterAccountCode" Placeholder="Contrapartida" FloatLabelType="FloatLabelType.Always" />
                <SfTextBox @bind-Value="_model.ProvisionAccountCode" Placeholder="Cuenta Provision" FloatLabelType="FloatLabelType.Always" />
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _showDialog = false)" />
        <DialogButton Content="Guardar" IsPrimary="true" OnClick="@Save" />
    </DialogButtons>
</SfDialog>

<ConfirmDialog @bind-Visible="_showConfirm" OnConfirm="ConfirmDelete" Message="Esta seguro de eliminar este registro?" />

@code {
    private SfGrid<ItemModel>? _grid;
    private List<ItemModel> _items = [];
    private FormModel _model = new();
    private Guid? _editId;
    private bool _showDialog, _showConfirm;
    private string _dialogTitle = "";
    private Guid _deleteId;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        try { var r = await Http.GetFromJsonAsync<Paged>("/api/payroll/concept-accounts?pageSize=500"); _items = r?.Items ?? []; }
        catch { _items = []; }
    }

    private void OpenCreate() { _model = new(); _editId = null; _dialogTitle = "Nueva Cuenta por Concepto"; _showDialog = true; }

    private void OpenEdit(ItemModel item)
    {
        _model = new()
        {
            ConceptId = item.ConceptId, CostCenterId = item.CostCenterId,
            ExpenseAccountCode = item.ExpenseAccountCode, CounterAccountCode = item.CounterAccountCode,
            ProvisionAccountCode = item.ProvisionAccountCode
        };
        _editId = item.PublicId; _dialogTitle = "Editar Cuenta por Concepto"; _showDialog = true;
    }

    private void OpenDelete(ItemModel item) { _deleteId = item.PublicId; _showConfirm = true; }

    private async Task Save()
    {
        var res = _editId.HasValue
            ? await Http.PutAsJsonAsync($"/api/payroll/concept-accounts/{_editId}", _model)
            : await Http.PostAsJsonAsync("/api/payroll/concept-accounts", _model);
        if (res.IsSuccessStatusCode) { await Notification.SuccessAsync("Guardado"); _showDialog = false; await LoadData(); }
        else await Notification.ShowErrorAsync(res, "Error al guardar");
    }

    private async Task ConfirmDelete()
    {
        var res = await Http.DeleteAsync($"/api/payroll/concept-accounts/{_deleteId}");
        if (res.IsSuccessStatusCode) { await Notification.SuccessAsync("Eliminado"); await LoadData(); }
        else await Notification.ShowErrorAsync(res, "Error al eliminar");
    }

    private class Paged { public List<ItemModel> Items { get; set; } = []; }
    private class ItemModel
    {
        public Guid PublicId { get; set; }
        public int ConceptId { get; set; }
        public string CostCenterId { get; set; } = "";
        public string ExpenseAccountCode { get; set; } = "";
        public string CounterAccountCode { get; set; } = "";
        public string ProvisionAccountCode { get; set; } = "";
    }
    private class FormModel
    {
        public int ConceptId { get; set; }
        public string CostCenterId { get; set; } = "";
        public string ExpenseAccountCode { get; set; } = "";
        public string CounterAccountCode { get; set; } = "";
        public string ProvisionAccountCode { get; set; } = "";
    }
}
