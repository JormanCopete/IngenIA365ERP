@page "/nomina/arl-tarifas"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification

<PageTitle>Clases de riesgo ARL - IngenIA365ERP</PageTitle>

<div class="page-header">
    <h3>Clases de riesgo ARL</h3>
    <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@OpenCreate">Nuevo</SfButton>
</div>

<p class="hint">
    Las cinco clases (I a V) que se asignan en la ficha de cada empleado; sin clase la liquidación no calcula
    el aporte a ARL. El porcentaje que se liquida es el parámetro legal ARL_CLASE_{I..V}_PCT vigente
    (Nómina › Parámetros legales); la tarifa de esta tabla es informativa.
</p>

<SfGrid @ref="_grid" TValue="ItemModel" DataSource="@_items" AllowPaging="true" AllowSorting="true" AllowFiltering="true">
    <GridColumns>
        <GridColumn Field="Code" HeaderText="Codigo" Width="100" TextAlign="TextAlign.Center" />
        <GridColumn Field="Name" HeaderText="Nivel de Riesgo" Width="250" />
        <GridColumn Field="ShortName" HeaderText="Nombre Corto" Width="180" />
        <GridColumn Field="Rate" HeaderText="Tarifa (%)" Width="150" Format="N3" TextAlign="TextAlign.Right" />
        <GridColumn HeaderText="Acciones" Width="150" TextAlign="TextAlign.Center">
            <Template>
                @{
                    var item = context as ItemModel;
                    <SfButton CssClass="e-flat e-small" IconCss="e-icons e-edit" OnClick="@(() => OpenEdit(item!))" />
                    <SfButton CssClass="e-flat e-small e-danger" IconCss="e-icons e-trash" OnClick="@(() => OpenDelete(item!))" />
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

<SfDialog @bind-Visible="_showDialog" Header="@_dialogTitle" Width="500px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <div class="pagina">
                <SfNumericTextBox TValue="int" @bind-Value="_model.Code" Placeholder="Clase (1 a 5)" Min="1" Max="5" FloatLabelType="FloatLabelType.Always" />
                <SfTextBox @bind-Value="_model.Name" Placeholder="Nivel de Riesgo" FloatLabelType="FloatLabelType.Always" />
                <SfTextBox @bind-Value="_model.ShortName" Placeholder="Nombre Corto" FloatLabelType="FloatLabelType.Always" />
                <SfNumericTextBox TValue="decimal" @bind-Value="_model.Rate" Placeholder="Tarifa (%)" Format="N3" FloatLabelType="FloatLabelType.Always" />
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _showDialog = false)" />
        <DialogButton Content="Guardar" IsPrimary="true" OnClick="@Save" />
    </DialogButtons>
</SfDialog>

<ConfirmDialog @bind-Visible="_showConfirm" OnConfirm="ConfirmDelete" Message="Esta seguro de eliminar este registro?" />

@code {
    private SfGrid<ItemModel>? _grid;
    private List<ItemModel> _items = [];
    private FormModel _model = new();
    private Guid? _editId;
    private bool _showDialog, _showConfirm;
    private string _dialogTitle = "";
    private Guid _deleteId;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        try { var r = await Http.GetFromJsonAsync<Paged>("/api/payroll/work-risk-rates?pageSize=500"); _items = r?.Items ?? []; }
        catch { _items = []; }
    }

    private void OpenCreate() { _model = new(); _editId = null; _dialogTitle = "Nueva Tarifa ARL"; _showDialog = true; }

    private void OpenEdit(ItemModel item)
    {
        _model = new() { Code = item.Code, Name = item.Name, ShortName = item.ShortName, Rate = item.Rate };
        _editId = item.PublicId; _dialogTitle = "Editar Tarifa ARL"; _showDialog = true;
    }

    private void OpenDelete(ItemModel item) { _deleteId = item.PublicId; _showConfirm = true; }

    private async Task Save()
    {
        var res = _editId.HasValue
            ? await Http.PutAsJsonAsync($"/api/payroll/work-risk-rates/{_editId}", _model)
            : await Http.PostAsJsonAsync("/api/payroll/work-risk-rates", _model);
        if (res.IsSuccessStatusCode) { await Notification.SuccessAsync("Guardado"); _showDialog = false; await LoadData(); }
        else await Notification.ShowErrorAsync(res, "Error al guardar");
    }

    private async Task ConfirmDelete()
    {
        var res = await Http.DeleteAsync($"/api/payroll/work-risk-rates/{_deleteId}");
        if (res.IsSuccessStatusCode) { await Notification.SuccessAsync("Eliminado"); await LoadData(); }
        else await Notification.ShowErrorAsync(res, "Error al eliminar");
    }

    private class Paged { public List<ItemModel> Items { get; set; } = []; }
    private class ItemModel
    {
        public Guid PublicId { get; set; }
        public int Code { get; set; }
        public string Name { get; set; } = "";
        public string ShortName { get; set; } = "";
        public decimal Rate { get; set; }
    }
    private class FormModel
    {
        public int Code { get; set; }
        public string Name { get; set; } = "";
        public string ShortName { get; set; } = "";
        public decimal Rate { get; set; }
    }
}
