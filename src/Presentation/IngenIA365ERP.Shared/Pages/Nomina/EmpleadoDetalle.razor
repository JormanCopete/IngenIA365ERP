@page "/nomina/empleados/{EmployeeId:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification
@inject NavigationManager Nav

<PageTitle>Detalle Empleado - IngenIA365ERP</PageTitle>

<div class="page-header">
    <h3>@(_employee is not null ? $"Empleado: {_employee.FirstName} {_employee.LastName}" : "Detalle Empleado")</h3>
    <div>
        <SfButton CssClass="e-flat" IconCss="e-icons e-arrow-left"
                  OnClick='@(() => Nav.NavigateTo("/nomina/empleados"))'>Volver a Lista</SfButton>
        @if (_employee is not null && _employee.Status == 1)
        {
            <SfButton CssClass="e-primary" IconCss="e-icons e-save"
                      Disabled="@(!_hasChanges || _saving)"
                      OnClick="SaveLaborData">Guardar Cambios</SfButton>
            <SfButton CssClass="e-danger" IconCss="e-icons e-close"
                      OnClick="@(() => _showTerminateConfirm = true)">Terminar Contrato</SfButton>
        }
    </div>
</div>

@if (_employee is not null)
{
    var statusBadge = _employee.Status == 1 ? "e-badge e-badge-success"
                    : _employee.Status == -1 ? "e-badge e-badge-danger"
                    : "e-badge e-badge-warning";
    var statusText = _employee.Status == 1 ? "Activo"
                   : _employee.Status == -1 ? "Retirado" : "Inactivo";
    <div style="margin-bottom:var(--gap-md);">
        <span class="@statusBadge" style="font-size:var(--texto-md);padding:var(--pad-xs) var(--pad-md);">@statusText</span>
        @if (_employee.Status == -1 && _employee.TerminationDate.HasValue)
        {
            <span class="texto-tenue" style="margin-left:var(--gap-sm);font-size:var(--texto-sm);">
                Terminado el @_employee.TerminationDate.Value.ToString("dd/MM/yyyy")
                @if (!string.IsNullOrEmpty(_employee.TerminationCause))
                {
                    <span> — @_employee.TerminationCause</span>
                }
            </span>
        }
    </div>
}

@if (_loading)
{
    <div class="module-placeholder">
        <SfSpinner Visible="true" />
    </div>
}
else if (_employee is null)
{
    <div class="module-placeholder">
        <div class="placeholder-icon">
            <span class="e-icons e-people"></span>
        </div>
        <p>Empleado no encontrado.</p>
    </div>
}
else
{
    <SfTab>
        <TabItems>
            @* ===== Tab 1: Datos Personales (read-only, vienen de Persona) ===== *@
            <TabItem>
                <ChildContent>
                    <TabHeader Text="Datos Personales" />
                </ChildContent>
                <ContentTemplate>
                    <div class="rejilla-campos panel-pestana">
                        <div>
                            <label>Nombres</label>
                            <SfTextBox Value="@_employee.FirstName" Readonly="true" CssClass="e-disabled" />
                        </div>
                        <div>
                            <label>Apellidos</label>
                            <SfTextBox Value="@_employee.LastName" Readonly="true" CssClass="e-disabled" />
                        </div>
                        <div>
                            <label>Numero Documento</label>
                            <SfTextBox Value="@_employee.IdentificationNumber" Readonly="true" CssClass="e-disabled" />
                        </div>
                        <div>
                            <label>Correo Electronico</label>
                            <SfTextBox Value="@_employee.Email" Readonly="true" CssClass="e-disabled" />
                        </div>
                        <div>
                            <label>Telefono</label>
                            <SfTextBox Value="@_employee.Phone" Readonly="true" CssClass="e-disabled" />
                        </div>
                        <div>
                            <label>Movil</label>
                            <SfTextBox Value="@_employee.Mobile" Readonly="true" CssClass="e-disabled" />
                        </div>
                        <div class="campo-ancho">
                            <label>Direccion</label>
                            <SfTextBox Value="@_employee.Address" Readonly="true" CssClass="e-disabled" />
                        </div>
                    </div>
                    <div class="hint" style="padding:0 var(--pad-lg) var(--pad-md);">
                        Los datos personales se administran desde el modulo
                        <a href="/maestros/personas">Maestros - Personas</a>. Aqui son de solo lectura.
                    </div>
                </ContentTemplate>
            </TabItem>

            @* ===== Tab 2: Datos Laborales (editables) ===== *@
            <TabItem>
                <ChildContent>
                    <TabHeader Text="Datos Laborales" />
                </ChildContent>
                <ContentTemplate>
                    <div class="rejilla-campos panel-pestana">
                        <div>
                            <label>Salario Base <span style="color:var(--peligro-texto)">*</span></label>
                            <SfNumericTextBox TValue="decimal" @bind-Value="_labor.BaseSalary"
                                              Format="N2" Min="0" Step="50000m"
                                              ValueChange="@((Syncfusion.Blazor.Inputs.ChangeEventArgs<decimal> e) => MarkChanged())" />
                        </div>
                        <div>
                            <label>Tipo de Contrato <span style="color:var(--peligro-texto)">*</span></label>
                            <SfDropDownList TValue="int" TItem="ContractTypeOption"
                                            @bind-Value="_labor.ContractType"
                                            DataSource="@_contractTypes" Placeholder="Seleccione">
                                <DropDownListFieldSettings Text="Name" Value="Value" />
                                <DropDownListEvents TValue="int" TItem="ContractTypeOption"
                                                    ValueChange="@((Syncfusion.Blazor.DropDowns.ChangeEventArgs<int, ContractTypeOption> e) => MarkChanged())" />
                            </SfDropDownList>
                        </div>
                        <div>
                            <label>Fecha de Ingreso</label>
                            <SfDatePicker TValue="DateTime" Value="@_employee.HireDate"
                                          Format="dd/MM/yyyy" Readonly="true" CssClass="e-disabled" />
                        </div>

                        <div>
                            <label>EPS</label>
                            <SfDropDownList TValue="Guid?" TItem="LookupOption"
                                            @bind-Value="_labor.HealthInsurancePublicId"
                                            DataSource="@_eps"
                                            Placeholder="Seleccione EPS"
                                            AllowFiltering="true">
                                <DropDownListFieldSettings Text="Name" Value="PublicId" />
                                <DropDownListEvents TValue="Guid?" TItem="LookupOption"
                                                    ValueChange="@((Syncfusion.Blazor.DropDowns.ChangeEventArgs<Guid?, LookupOption> e) => MarkChanged())" />
                            </SfDropDownList>
                        </div>
                        <div>
                            <label>Fondo de Pension</label>
                            <SfDropDownList TValue="Guid?" TItem="LookupOption"
                                            @bind-Value="_labor.PensionProviderPublicId"
                                            DataSource="@_pensions"
                                            Placeholder="Seleccione AFP"
                                            AllowFiltering="true">
                                <DropDownListFieldSettings Text="Name" Value="PublicId" />
                                <DropDownListEvents TValue="Guid?" TItem="LookupOption"
                                                    ValueChange="@((Syncfusion.Blazor.DropDowns.ChangeEventArgs<Guid?, LookupOption> e) => MarkChanged())" />
                            </SfDropDownList>
                        </div>
                        <div>
                            <label>ARL (Riesgos Laborales)</label>
                            <SfDropDownList TValue="Guid?" TItem="LookupOption"
                                            @bind-Value="_labor.WorkRiskProviderPublicId"
                                            DataSource="@_arl"
                                            Placeholder="Seleccione ARL"
                                            AllowFiltering="true">
                                <DropDownListFieldSettings Text="Name" Value="PublicId" />
                                <DropDownListEvents TValue="Guid?" TItem="LookupOption"
                                                    ValueChange="@((Syncfusion.Blazor.DropDowns.ChangeEventArgs<Guid?, LookupOption> e) => MarkChanged())" />
                            </SfDropDownList>
                        </div>

                        <div>
                            <label>Banco</label>
                            <SfDropDownList TValue="Guid?" TItem="LookupOption"
                                            @bind-Value="_labor.BankPublicId"
                                            DataSource="@_banks"
                                            Placeholder="Seleccione banco"
                                            AllowFiltering="true">
                                <DropDownListFieldSettings Text="Name" Value="PublicId" />
                                <DropDownListEvents TValue="Guid?" TItem="LookupOption"
                                                    ValueChange="@((Syncfusion.Blazor.DropDowns.ChangeEventArgs<Guid?, LookupOption> e) => MarkChanged())" />
                            </SfDropDownList>
                        </div>
                        <div>
                            <label>Numero de Cuenta</label>
                            <SfTextBox @bind-Value="_labor.BankAccountNumber"
                                       Placeholder="Numero de cuenta"
                                       HtmlAttributes="@(new Dictionary<string, object> { { "maxlength", "25" } })"
                                       ValueChange="@((Syncfusion.Blazor.Inputs.ChangedEventArgs e) => MarkChanged())" />
                        </div>
                        <div>
                            <label>Tipo de Cuenta</label>
                            <SfDropDownList TValue="int" TItem="AccountTypeOption"
                                            @bind-Value="_labor.AccountType"
                                            DataSource="@_accountTypes" Placeholder="Seleccione">
                                <DropDownListFieldSettings Text="Name" Value="Value" />
                                <DropDownListEvents TValue="int" TItem="AccountTypeOption"
                                                    ValueChange="@((Syncfusion.Blazor.DropDowns.ChangeEventArgs<int, AccountTypeOption> e) => MarkChanged())" />
                            </SfDropDownList>
                        </div>
                    </div>
                </ContentTemplate>
            </TabItem>

            @* ===== Tab 3: Historial Salarial ===== *@
            <TabItem>
                <ChildContent>
                    <TabHeader Text="Historial Salarial" />
                </ChildContent>
                <ContentTemplate>
                    <div class="panel-pestana">
                        <SfGrid TValue="SalaryHistoryItem" DataSource="@_employee.SalaryHistory"
                                AllowPaging="true" AllowSorting="true">
                            <GridPageSettings PageSize="15" />
                            <GridColumns>
                                <GridColumn Field="@nameof(SalaryHistoryItem.EffectiveDate)" HeaderText="Fecha Vigencia" Width="160"
                                            Format="dd/MM/yyyy" Type="ColumnType.Date" />
                                <GridColumn Field="@nameof(SalaryHistoryItem.NewSalary)" HeaderText="Nuevo Salario" Width="180"
                                            Format="N2" TextAlign="TextAlign.Right" />
                                <GridColumn Field="@nameof(SalaryHistoryItem.UserName)" HeaderText="Modificado Por" Width="200" />
                            </GridColumns>
                        </SfGrid>
                        @if (_employee.SalaryHistory.Count == 0)
                        {
                            <div class="sin-datos">Sin registros de cambios salariales.</div>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>

            @* ===== Tab 4: Movimientos Recientes de Nomina ===== *@
            <TabItem>
                <ChildContent>
                    <TabHeader Text="Movimientos Recientes" />
                </ChildContent>
                <ContentTemplate>
                    <div class="panel-pestana">
                        <SfGrid TValue="RecentEntryItem" DataSource="@_employee.RecentEntries"
                                AllowPaging="true" AllowSorting="true">
                            <GridPageSettings PageSize="15" />
                            <GridColumns>
                                <GridColumn Field="@nameof(RecentEntryItem.PeriodDescription)" HeaderText="Periodo" Width="200" />
                                <GridColumn Field="@nameof(RecentEntryItem.ConceptName)" HeaderText="Concepto" Width="300" />
                                <GridColumn Field="@nameof(RecentEntryItem.Amount)" HeaderText="Valor" Width="160"
                                            Format="N2" TextAlign="TextAlign.Right" />
                            </GridColumns>
                        </SfGrid>
                        @if (_employee.RecentEntries.Count == 0)
                        {
                            <div class="sin-datos">Sin movimientos recientes.</div>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>
        </TabItems>
    </SfTab>
}

@* ===== Dialogo Terminar Contrato ===== *@
<SfDialog @bind-Visible="_showTerminateConfirm" Header="Terminar Contrato" Width="450px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <div class="panel-pestana">
                <p style="margin-bottom:var(--pad-lg);">
                    ¿Seguro que desea terminar el contrato de
                    <strong>@_employee?.FirstName @_employee?.LastName</strong>?
                </p>
                <div style="display:flex;flex-direction:column;gap:var(--gap-md);">
                    <div>
                        <label>Fecha de Terminacion <span style="color:var(--peligro-texto)">*</span></label>
                        <SfDatePicker TValue="DateTime" @bind-Value="_terminationDate" Format="dd/MM/yyyy" />
                    </div>
                    <div>
                        <label>Motivo</label>
                        <SfTextBox @bind-Value="_terminationCause" Placeholder="Motivo (opcional)" Multiline="true" />
                    </div>
                </div>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _showTerminateConfirm = false)" />
        <DialogButton Content="Terminar Contrato" CssClass="e-danger" IsPrimary="true"
                      OnClick="TerminateContract" Disabled="@_saving" />
    </DialogButtons>
</SfDialog>

@code {
    [Parameter] public Guid EmployeeId { get; set; }

    private bool _loading = true;
    private bool _hasChanges;
    private bool _saving;
    private EmployeeDetailDto? _employee;
    private LaborData _labor = new();

    // Lookups
    private List<LookupOption> _eps = new();
    private List<LookupOption> _pensions = new();
    private List<LookupOption> _arl = new();
    private List<LookupOption> _banks = new();

    // Tipos de contrato (alineados al ContractType int del backend; rango 0-10).
    private List<ContractTypeOption> _contractTypes = new()
    {
        new(1, "Indefinido"),
        new(2, "Termino Fijo"),
        new(3, "Obra o Labor"),
        new(4, "Prestacion de Servicios"),
        new(5, "Aprendizaje"),
        new(6, "Practica / Pasantia")
    };

    private List<AccountTypeOption> _accountTypes = new()
    {
        new(0, "(Ninguno)"),
        new(1, "Ahorros"),
        new(2, "Corriente")
    };

    // Terminate dialog
    private bool _showTerminateConfirm;
    private DateTime _terminationDate = DateTime.Today;
    private string _terminationCause = "";

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(
            LoadEmployee(),
            LoadEps(),
            LoadPensions(),
            LoadArl(),
            LoadBanks()
        );
        _loading = false;
    }

    // --- Carga ---

    private async Task LoadEmployee()
    {
        try
        {
            _employee = await Http.GetFromJsonAsync<EmployeeDetailDto>($"/api/payroll/employees/{EmployeeId}");
            if (_employee is null) return;

            // Sincroniza el modelo editable con la respuesta del backend.
            _labor = new LaborData
            {
                BaseSalary = _employee.Salary,
                ContractType = _employee.ContractType,
                HealthInsurancePublicId = _employee.HealthInsurancePublicId,
                PensionProviderPublicId = _employee.PensionProviderPublicId,
                WorkRiskProviderPublicId = _employee.WorkRiskProviderPublicId,
                BankPublicId = _employee.PayrollBankPublicId,
                BankAccountNumber = _employee.PayrollBankAccountNumber ?? "",
                AccountType = _employee.PayrollBankAccountType
            };
            _hasChanges = false;
        }
        catch (Exception ex)
        {
            await Notification.ErrorAsync($"Error al cargar empleado: {ex.Message}");
        }
    }

    private async Task LoadEps()
    {
        try
        {
            _eps = (await Http.GetListAsync<LookupRaw>("/api/payroll/health-insurance?PageNumber=1&PageSize=500"))
                .Select(e => new LookupOption(e.PublicId, e.Name)).ToList();
        }
        catch { _eps = new List<LookupOption>(); }
    }

    private async Task LoadPensions()
    {
        try
        {
            _pensions = (await Http.GetListAsync<LookupRaw>("/api/payroll/pension-providers?PageNumber=1&PageSize=500"))
                .Select(p => new LookupOption(p.PublicId, p.Name)).ToList();
        }
        catch { _pensions = new List<LookupOption>(); }
    }

    private async Task LoadArl()
    {
        try
        {
            _arl = (await Http.GetListAsync<LookupRaw>("/api/payroll/work-risk?PageNumber=1&PageSize=500"))
                .Select(a => new LookupOption(a.PublicId, a.Name)).ToList();
        }
        catch { _arl = new List<LookupOption>(); }
    }

    private async Task LoadBanks()
    {
        try
        {
            _banks = (await Http.GetListAsync<LookupRaw>("/api/core/banks?PageNumber=1&PageSize=500"))
                .Select(b => new LookupOption(b.PublicId, b.Name)).ToList();
        }
        catch { _banks = new List<LookupOption>(); }
    }

    private void MarkChanged() => _hasChanges = true;

    // --- Guardar cambios laborales ---

    private async Task SaveLaborData()
    {
        if (_saving || _employee is null) return;

        if (_labor.BaseSalary <= 0)
        {
            await Notification.WarningAsync("El salario base debe ser mayor a 0.");
            return;
        }

        _saving = true;
        try
        {
            // Payload alineado a UpdateEmployeeCommand (banca renombrada a Payroll*)
            var payload = new
            {
                BaseSalary = _labor.BaseSalary,
                ContractType = _labor.ContractType,
                HealthInsurancePublicId = _labor.HealthInsurancePublicId,
                PensionProviderPublicId = _labor.PensionProviderPublicId,
                WorkRiskProviderPublicId = _labor.WorkRiskProviderPublicId,
                PayrollBankPublicId = _labor.BankPublicId,
                PayrollBankAccountNumber = string.IsNullOrWhiteSpace(_labor.BankAccountNumber) ? null : _labor.BankAccountNumber,
                PayrollBankAccountType = _labor.AccountType
            };

            var res = await Http.PutAsJsonAsync($"/api/payroll/employees/{EmployeeId}", payload);
            if (res.IsSuccessStatusCode)
            {
                await Notification.SuccessAsync("Datos laborales actualizados correctamente.");
                _hasChanges = false;
                await LoadEmployee();
            }
            else
            {
                await Notification.ShowErrorAsync(res, "Error al guardar cambios");
            }
        }
        catch (Exception ex)
        {
            await Notification.ErrorAsync($"Error inesperado: {ex.Message}");
        }
        finally
        {
            _saving = false;
        }
    }

    // --- Terminar contrato ---

    private async Task TerminateContract()
    {
        if (_saving) return;

        _saving = true;
        try
        {
            var payload = new
            {
                TerminationDate = _terminationDate,
                TerminationCause = _terminationCause
            };
            var res = await Http.PostAsJsonAsync($"/api/payroll/employees/{EmployeeId}/terminate", payload);
            if (res.IsSuccessStatusCode)
            {
                await Notification.SuccessAsync("Contrato terminado correctamente.");
                _showTerminateConfirm = false;
                _terminationCause = "";
                await LoadEmployee();
            }
            else
            {
                await Notification.ShowErrorAsync(res, "Error al terminar contrato");
            }
        }
        catch (Exception ex)
        {
            await Notification.ErrorAsync($"Error inesperado: {ex.Message}");
        }
        finally
        {
            _saving = false;
        }
    }

    // --- Modelos ---

    /// <summary>Coincide con EmployeeDetailDto del backend (modelo actualizado).</summary>
    private class EmployeeDetailDto
    {
        public Guid PublicId { get; set; }
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
        public string IdentificationNumber { get; set; } = "";
        public string Email { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Mobile { get; set; } = "";
        public string Address { get; set; } = "";
        public decimal Salary { get; set; }
        public int ContractType { get; set; }
        public DateTime HireDate { get; set; }
        public DateTime? TerminationDate { get; set; }
        public string TerminationCause { get; set; } = "";
        public int Status { get; set; }
        public string HealthInsuranceName { get; set; } = "";
        public string PensionProviderName { get; set; } = "";
        public string WorkRiskProviderName { get; set; } = "";
        public string PayrollBankAccountNumber { get; set; } = "";
        public int PayrollBankAccountType { get; set; }
        public Guid? HealthInsurancePublicId { get; set; }
        public Guid? PensionProviderPublicId { get; set; }
        public Guid? WorkRiskProviderPublicId { get; set; }
        public Guid? PayrollBankPublicId { get; set; }
        public string? PayrollBankName { get; set; }
        public List<SalaryHistoryItem> SalaryHistory { get; set; } = new();
        public List<RecentEntryItem> RecentEntries { get; set; } = new();
    }

    private class LaborData
    {
        public decimal BaseSalary { get; set; }
        public int ContractType { get; set; }
        public Guid? HealthInsurancePublicId { get; set; }
        public Guid? PensionProviderPublicId { get; set; }
        public Guid? WorkRiskProviderPublicId { get; set; }
        public Guid? BankPublicId { get; set; }
        public string BankAccountNumber { get; set; } = "";
        public int AccountType { get; set; }
    }

    private class SalaryHistoryItem
    {
        public DateTime EffectiveDate { get; set; }
        public decimal NewSalary { get; set; }
        public string? UserName { get; set; }
    }

    private class RecentEntryItem
    {
        public string ConceptName { get; set; } = "";
        public decimal? Amount { get; set; }
        public string PeriodDescription { get; set; } = "";
    }

    private class LookupRaw
    {
        public Guid PublicId { get; set; }
        public string Name { get; set; } = "";
    }

    private class LookupOption
    {
        public Guid? PublicId { get; set; }
        public string Name { get; set; } = "";
        public LookupOption(Guid publicId, string name) { PublicId = publicId; Name = name; }
    }

    private record ContractTypeOption(int Value, string Name);
    private record AccountTypeOption(int Value, string Name);
}
