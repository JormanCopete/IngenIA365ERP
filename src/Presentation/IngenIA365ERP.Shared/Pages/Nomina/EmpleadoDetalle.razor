@page "/nomina/empleados/{EmployeeId:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification
@inject NavigationManager Nav

<PageTitle>Detalle Empleado - IngenIA365ERP</PageTitle>

<!-- Toolbar -->
<div class="page-header" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;">
    <h3>@(_employee is not null ? $"Empleado: {_employee.FullName}" : "Detalle Empleado")</h3>
    <div style="display:flex;gap:8px;flex-wrap:wrap;">
        <SfButton CssClass="e-flat" IconCss="e-icons e-arrow-left"
                  OnClick='@(() => Nav.NavigateTo("/nomina/empleados"))'>Volver a Lista</SfButton>
        <SfButton CssClass="e-primary" IconCss="e-icons e-save" Disabled="@(!_hasChanges)"
                  OnClick="SaveLaborData">Guardar Cambios Laborales</SfButton>
        @if (_employee is not null && _employee.IsActive)
        {
            <SfButton CssClass="e-danger" IconCss="e-icons e-close"
                      OnClick="@(() => _showTerminateConfirm = true)">Terminar Contrato</SfButton>
        }
    </div>
</div>

<!-- Status badge -->
@if (_employee is not null)
{
    var badge = _employee.IsActive ? "e-badge e-badge-success" : "e-badge e-badge-danger";
    var text = _employee.IsActive ? "Activo" : "Inactivo";
    <div style="margin-bottom:12px;">
        <span class="@badge" style="font-size:14px;padding:4px 12px;">@text</span>
        @if (!_employee.IsActive && _employee.TerminationDate.HasValue)
        {
            <span style="margin-left:8px;color:#888;font-size:13px;">Terminado el @_employee.TerminationDate.Value.ToString("dd/MM/yyyy")</span>
        }
    </div>
}

@if (_employee is null && !_loading)
{
    <div style="text-align:center;padding:60px;color:#888;">
        <span class="e-icons e-people" style="font-size:48px;display:block;margin-bottom:12px;"></span>
        <p>Empleado no encontrado.</p>
    </div>
}
else if (_loading)
{
    <div style="text-align:center;padding:60px;">
        <SfSpinner Visible="true" />
    </div>
}
else
{
    <SfTab>
        <TabItems>
            <!-- Tab: Datos Personales -->
            <TabItem>
                <ChildContent>
                    <TabHeader Text="Datos Personales" />
                </ChildContent>
                <ContentTemplate>
                    <div style="padding:20px;display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:16px;">
                        <div>
                            <label>Nombre Completo</label>
                            <SfTextBox Value="@_employee!.FullName" Readonly="true" CssClass="e-disabled" />
                        </div>
                        <div>
                            <label>Tipo Documento</label>
                            <SfTextBox Value="@_employee.DocumentType" Readonly="true" CssClass="e-disabled" />
                        </div>
                        <div>
                            <label>Numero Documento</label>
                            <SfTextBox Value="@_employee.DocumentNumber" Readonly="true" CssClass="e-disabled" />
                        </div>
                        <div>
                            <label>Correo Electronico</label>
                            <SfTextBox Value="@_employee.Email" Readonly="true" CssClass="e-disabled" />
                        </div>
                        <div>
                            <label>Telefono</label>
                            <SfTextBox Value="@_employee.Phone" Readonly="true" CssClass="e-disabled" />
                        </div>
                        <div style="grid-column:span 2;">
                            <label>Direccion</label>
                            <SfTextBox Value="@_employee.Address" Readonly="true" CssClass="e-disabled" />
                        </div>
                        <div>
                            <label>Ciudad</label>
                            <SfTextBox Value="@_employee.City" Readonly="true" CssClass="e-disabled" />
                        </div>
                    </div>
                    <div style="padding:0 20px 12px;color:#888;font-size:12px;">
                        Los datos personales se administran desde el modulo de Personas (Core). Aqui son de solo lectura.
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- Tab: Datos Laborales -->
            <TabItem>
                <ChildContent>
                    <TabHeader Text="Datos Laborales" />
                </ChildContent>
                <ContentTemplate>
                    <div style="padding:20px;display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:16px;">
                        <div>
                            <label>Cargo *</label>
                            <SfTextBox @bind-Value="_labor.Position" Placeholder="Cargo del empleado"
                                       ValueChange="@((Syncfusion.Blazor.Inputs.ChangedEventArgs e) => MarkChanged())" />
                        </div>
                        <div>
                            <label>Departamento *</label>
                            <SfDropDownList TValue="string" TItem="DropOption" @bind-Value="_labor.DepartmentCode"
                                            DataSource="_departments" Placeholder="Seleccione">
                                <DropDownListFieldSettings Text="Name" Value="Value" />
                                <DropDownListEvents TValue="string" TItem="DropOption"
                                                    ValueChange="@((Syncfusion.Blazor.DropDowns.ChangeEventArgs<string, DropOption> e) => MarkChanged())" />
                            </SfDropDownList>
                        </div>
                        <div>
                            <label>Salario Base *</label>
                            <SfNumericTextBox TValue="decimal" @bind-Value="_labor.BaseSalary" Format="N2" Min="0"
                                              ValueChange="@((Syncfusion.Blazor.Inputs.ChangeEventArgs<decimal> e) => MarkChanged())" />
                        </div>
                        <div>
                            <label>Tipo Contrato *</label>
                            <SfDropDownList TValue="string" TItem="DropOption" @bind-Value="_labor.ContractType"
                                            DataSource="_contractTypes" Placeholder="Seleccione">
                                <DropDownListFieldSettings Text="Name" Value="Value" />
                                <DropDownListEvents TValue="string" TItem="DropOption"
                                                    ValueChange="@((Syncfusion.Blazor.DropDowns.ChangeEventArgs<string, DropOption> e) => MarkChanged())" />
                            </SfDropDownList>
                        </div>
                        <div>
                            <label>Fecha Ingreso</label>
                            <SfDatePicker TValue="DateTime" @bind-Value="_labor.HireDate" Format="dd/MM/yyyy" Readonly="true" CssClass="e-disabled" />
                        </div>
                        <div>
                            <label>EPS *</label>
                            <SfDropDownList TValue="string" TItem="DropOption" @bind-Value="_labor.HealthInsuranceCode"
                                            DataSource="_epsList" Placeholder="Seleccione">
                                <DropDownListFieldSettings Text="Name" Value="Value" />
                                <DropDownListEvents TValue="string" TItem="DropOption"
                                                    ValueChange="@((Syncfusion.Blazor.DropDowns.ChangeEventArgs<string, DropOption> e) => MarkChanged())" />
                            </SfDropDownList>
                        </div>
                        <div>
                            <label>Pension *</label>
                            <SfDropDownList TValue="string" TItem="DropOption" @bind-Value="_labor.PensionCode"
                                            DataSource="_pensionList" Placeholder="Seleccione">
                                <DropDownListFieldSettings Text="Name" Value="Value" />
                                <DropDownListEvents TValue="string" TItem="DropOption"
                                                    ValueChange="@((Syncfusion.Blazor.DropDowns.ChangeEventArgs<string, DropOption> e) => MarkChanged())" />
                            </SfDropDownList>
                        </div>
                        <div>
                            <label>ARL / Riesgo Laboral *</label>
                            <SfDropDownList TValue="string" TItem="DropOption" @bind-Value="_labor.WorkRiskCode"
                                            DataSource="_arlList" Placeholder="Seleccione">
                                <DropDownListFieldSettings Text="Name" Value="Value" />
                                <DropDownListEvents TValue="string" TItem="DropOption"
                                                    ValueChange="@((Syncfusion.Blazor.DropDowns.ChangeEventArgs<string, DropOption> e) => MarkChanged())" />
                            </SfDropDownList>
                        </div>
                        <div>
                            <label>Cuenta Bancaria</label>
                            <SfTextBox @bind-Value="_labor.BankAccount" Placeholder="Numero de cuenta"
                                       ValueChange="@((Syncfusion.Blazor.Inputs.ChangedEventArgs e) => MarkChanged())" />
                        </div>
                        <div>
                            <label>Banco</label>
                            <SfTextBox @bind-Value="_labor.BankName" Placeholder="Nombre del banco"
                                       ValueChange="@((Syncfusion.Blazor.Inputs.ChangedEventArgs e) => MarkChanged())" />
                        </div>
                        <div>
                            <label>Tipo Cuenta</label>
                            <SfDropDownList TValue="string" TItem="DropOption" @bind-Value="_labor.BankAccountType"
                                            DataSource="_accountTypes" Placeholder="Seleccione">
                                <DropDownListFieldSettings Text="Name" Value="Value" />
                                <DropDownListEvents TValue="string" TItem="DropOption"
                                                    ValueChange="@((Syncfusion.Blazor.DropDowns.ChangeEventArgs<string, DropOption> e) => MarkChanged())" />
                            </SfDropDownList>
                        </div>
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- Tab: Historial -->
            <TabItem>
                <ChildContent>
                    <TabHeader Text="Historial" />
                </ChildContent>
                <ContentTemplate>
                    <div style="padding:20px;">
                        <h4 style="margin-top:0;">Historial de Cambios Salariales</h4>
                        <SfGrid TValue="SalaryHistoryItem" DataSource="@_salaryHistory"
                                AllowPaging="true" AllowSorting="true">
                            <GridPageSettings PageSize="15" />
                            <GridColumns>
                                <GridColumn Field="EffectiveDate" HeaderText="Fecha Vigencia" Width="130" Format="dd/MM/yyyy" />
                                <GridColumn Field="PreviousSalary" HeaderText="Salario Anterior" Width="150" Format="N2" TextAlign="TextAlign.Right" />
                                <GridColumn Field="NewSalary" HeaderText="Nuevo Salario" Width="150" Format="N2" TextAlign="TextAlign.Right" />
                                <GridColumn Field="ChangePercentage" HeaderText="% Cambio" Width="100" Format="N2" TextAlign="TextAlign.Right" />
                                <GridColumn Field="Reason" HeaderText="Motivo" Width="250" />
                                <GridColumn Field="ChangedBy" HeaderText="Modificado Por" Width="150" />
                            </GridColumns>
                        </SfGrid>
                        @if (_salaryHistory.Count == 0)
                        {
                            <div style="text-align:center;padding:30px;color:#888;">Sin registros de cambios salariales.</div>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- Tab: Nomina Actual -->
            <TabItem>
                <ChildContent>
                    <TabHeader Text="Nomina Actual" />
                </ChildContent>
                <ContentTemplate>
                    <div style="padding:20px;">
                        @if (!string.IsNullOrEmpty(_currentPeriod))
                        {
                            <div style="margin-bottom:12px;">
                                <span style="font-size:12px;color:#666;">Periodo actual:</span>
                                <strong style="margin-left:8px;">@_currentPeriod</strong>
                            </div>
                        }
                        <SfGrid TValue="PayrollEntryItem" DataSource="@_payrollEntries"
                                AllowSorting="true">
                            <GridColumns>
                                <GridColumn Field="ConceptCode" HeaderText="Codigo" Width="100" />
                                <GridColumn Field="ConceptName" HeaderText="Concepto" Width="280" />
                                <GridColumn Field="EntryType" HeaderText="Tipo" Width="100" TextAlign="TextAlign.Center">
                                    <Template>
                                        @{
                                            var entry = context as PayrollEntryItem;
                                            var cssClass = entry?.EntryType == "D" ? "e-badge e-badge-success" : "e-badge e-badge-danger";
                                            var label = entry?.EntryType == "D" ? "Devengado" : "Deduccion";
                                            <span class="@cssClass" style="padding:2px 8px;font-size:11px;">@label</span>
                                        }
                                    </Template>
                                </GridColumn>
                                <GridColumn Field="Amount" HeaderText="Valor" Width="140" Format="N2" TextAlign="TextAlign.Right" />
                            </GridColumns>
                        </SfGrid>

                        @if (_payrollEntries.Count > 0)
                        {
                            <div style="display:flex;justify-content:flex-end;gap:24px;margin-top:16px;padding:12px;background:var(--sf-grid-header-bg, #f5f5f5);border-radius:4px;">
                                <div style="text-align:right;">
                                    <span style="font-size:12px;color:#666;">Total Devengados</span><br/>
                                    <strong style="font-size:16px;color:#2e7d32;">@TotalEarnings.ToString("N2")</strong>
                                </div>
                                <div style="text-align:right;">
                                    <span style="font-size:12px;color:#666;">Total Deducciones</span><br/>
                                    <strong style="font-size:16px;color:#c62828;">@TotalDeductions.ToString("N2")</strong>
                                </div>
                                <div style="text-align:right;">
                                    <span style="font-size:12px;color:#666;">Neto a Pagar</span><br/>
                                    <strong style="font-size:18px;">@NetPay.ToString("N2")</strong>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div style="text-align:center;padding:30px;color:#888;">No hay liquidacion de nomina para el periodo actual.</div>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>
        </TabItems>
    </SfTab>
}

<!-- Terminate contract confirmation -->
<SfDialog @bind-Visible="_showTerminateConfirm" Header="Terminar Contrato" Width="450px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <div style="padding:16px;">
                <p style="margin-bottom:16px;">Esta seguro de terminar el contrato de <strong>@_employee?.FullName</strong>?</p>
                <div style="display:flex;flex-direction:column;gap:12px;">
                    <div>
                        <label>Fecha de Terminacion *</label>
                        <SfDatePicker TValue="DateTime" @bind-Value="_terminationDate" Format="dd/MM/yyyy" />
                    </div>
                    <div>
                        <label>Motivo *</label>
                        <SfTextBox @bind-Value="_terminationReason" Placeholder="Motivo de la terminacion" Multiline="true" />
                    </div>
                </div>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _showTerminateConfirm = false)" />
        <DialogButton Content="Terminar Contrato" CssClass="e-danger" IsPrimary="true"
                       Disabled="@(string.IsNullOrWhiteSpace(_terminationReason))"
                       OnClick="TerminateContract" />
    </DialogButtons>
</SfDialog>

@code {
    [Parameter] public Guid EmployeeId { get; set; }

    private bool _loading = true;
    private bool _hasChanges;
    private EmployeeDto? _employee;
    private LaborData _labor = new();
    private List<SalaryHistoryItem> _salaryHistory = [];
    private List<PayrollEntryItem> _payrollEntries = [];
    private string _currentPeriod = "";

    // Terminate dialog
    private bool _showTerminateConfirm;
    private DateTime _terminationDate = DateTime.Today;
    private string _terminationReason = "";

    // Dropdown sources
    private List<DropOption> _departments = [];
    private List<DropOption> _epsList = [];
    private List<DropOption> _pensionList = [];
    private List<DropOption> _arlList = [];
    private List<DropOption> _contractTypes =
    [
        new("I", "Indefinido"),
        new("F", "Fijo"),
        new("O", "Obra o Labor"),
        new("P", "Prestacion de Servicios"),
        new("A", "Aprendizaje")
    ];
    private List<DropOption> _accountTypes =
    [
        new("A", "Ahorros"),
        new("C", "Corriente")
    ];

    private decimal TotalEarnings => _payrollEntries.Where(e => e.EntryType == "D").Sum(e => e.Amount);
    private decimal TotalDeductions => _payrollEntries.Where(e => e.EntryType == "R").Sum(e => e.Amount);
    private decimal NetPay => TotalEarnings - TotalDeductions;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(
            LoadEmployee(),
            LoadDepartments(),
            LoadEps(),
            LoadPensions(),
            LoadArl()
        );
        _loading = false;
    }

    private async Task LoadEmployee()
    {
        try
        {
            _employee = await Http.GetFromJsonAsync<EmployeeDto>($"/api/payroll/employees/{EmployeeId}");
            if (_employee is null) return;

            _labor = new()
            {
                Position = _employee.Position,
                DepartmentCode = _employee.DepartmentCode,
                BaseSalary = _employee.BaseSalary,
                ContractType = _employee.ContractType,
                HireDate = _employee.HireDate,
                HealthInsuranceCode = _employee.HealthInsuranceCode,
                PensionCode = _employee.PensionCode,
                WorkRiskCode = _employee.WorkRiskCode,
                BankAccount = _employee.BankAccount ?? "",
                BankName = _employee.BankName ?? "",
                BankAccountType = _employee.BankAccountType ?? ""
            };

            // Load history and current payroll in parallel
            await Task.WhenAll(LoadSalaryHistory(), LoadCurrentPayroll());
        }
        catch { await Notification.ErrorAsync("Error al cargar empleado"); }
    }

    private async Task LoadDepartments()
    {
        try
        {
            var items = await Http.GetFromJsonAsync<List<CatalogItem>>("/api/core/departments?pageSize=200");
            _departments = (items ?? []).Select(d => new DropOption(d.Code, $"{d.Code} - {d.Name}")).ToList();
        }
        catch { _departments = []; }
    }

    private async Task LoadEps()
    {
        try
        {
            var items = await Http.GetFromJsonAsync<List<CatalogItem>>("/api/payroll/eps?pageSize=100");
            _epsList = (items ?? []).Select(e => new DropOption(e.Code, $"{e.Code} - {e.Name}")).ToList();
        }
        catch { _epsList = []; }
    }

    private async Task LoadPensions()
    {
        try
        {
            var items = await Http.GetFromJsonAsync<List<CatalogItem>>("/api/payroll/pensions?pageSize=100");
            _pensionList = (items ?? []).Select(p => new DropOption(p.Code, $"{p.Code} - {p.Name}")).ToList();
        }
        catch { _pensionList = []; }
    }

    private async Task LoadArl()
    {
        try
        {
            var items = await Http.GetFromJsonAsync<List<CatalogItem>>("/api/payroll/arl?pageSize=100");
            _arlList = (items ?? []).Select(a => new DropOption(a.Code, $"{a.Code} - {a.Name}")).ToList();
        }
        catch { _arlList = []; }
    }

    private async Task LoadSalaryHistory()
    {
        try
        {
            _salaryHistory = await Http.GetFromJsonAsync<List<SalaryHistoryItem>>(
                $"/api/payroll/employees/{EmployeeId}/salary-history") ?? [];
        }
        catch { _salaryHistory = []; }
    }

    private async Task LoadCurrentPayroll()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<CurrentPayrollDto>(
                $"/api/payroll/employees/{EmployeeId}/current-payroll");
            if (result is not null)
            {
                _currentPeriod = result.PeriodName;
                _payrollEntries = result.Entries ?? [];
            }
        }
        catch { _payrollEntries = []; }
    }

    private void MarkChanged() => _hasChanges = true;

    private async Task SaveLaborData()
    {
        var payload = new
        {
            _labor.Position,
            _labor.DepartmentCode,
            _labor.BaseSalary,
            _labor.ContractType,
            _labor.HealthInsuranceCode,
            _labor.PensionCode,
            _labor.WorkRiskCode,
            _labor.BankAccount,
            _labor.BankName,
            _labor.BankAccountType
        };

        try
        {
            var res = await Http.PutAsJsonAsync($"/api/payroll/employees/{EmployeeId}", payload);
            if (res.IsSuccessStatusCode)
            {
                await Notification.SuccessAsync("Datos laborales actualizados");
                _hasChanges = false;
                await LoadEmployee();
            }
            else
            {
                var error = await res.Content.ReadAsStringAsync();
                await Notification.ErrorAsync($"Error al guardar: {error}");
            }
        }
        catch (Exception ex) { await Notification.ErrorAsync($"Error: {ex.Message}"); }
    }

    private async Task TerminateContract()
    {
        if (string.IsNullOrWhiteSpace(_terminationReason)) return;

        var payload = new
        {
            TerminationDate = _terminationDate,
            Reason = _terminationReason
        };

        try
        {
            var res = await Http.PostAsJsonAsync($"/api/payroll/employees/{EmployeeId}/terminate", payload);
            if (res.IsSuccessStatusCode)
            {
                await Notification.SuccessAsync("Contrato terminado exitosamente");
                _showTerminateConfirm = false;
                _terminationReason = "";
                await LoadEmployee();
            }
            else
            {
                var error = await res.Content.ReadAsStringAsync();
                await Notification.ErrorAsync($"Error al terminar contrato: {error}");
            }
        }
        catch (Exception ex) { await Notification.ErrorAsync($"Error: {ex.Message}"); }
    }

    // Models
    private class EmployeeDto
    {
        public Guid PublicId { get; set; }
        public string FullName { get; set; } = "";
        public string DocumentType { get; set; } = "";
        public string DocumentNumber { get; set; } = "";
        public string Email { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Address { get; set; } = "";
        public string City { get; set; } = "";
        public string Position { get; set; } = "";
        public string DepartmentCode { get; set; } = "";
        public decimal BaseSalary { get; set; }
        public string ContractType { get; set; } = "";
        public DateTime HireDate { get; set; }
        public string HealthInsuranceCode { get; set; } = "";
        public string PensionCode { get; set; } = "";
        public string WorkRiskCode { get; set; } = "";
        public string? BankAccount { get; set; }
        public string? BankName { get; set; }
        public string? BankAccountType { get; set; }
        public bool IsActive { get; set; }
        public DateTime? TerminationDate { get; set; }
    }

    private class LaborData
    {
        public string Position { get; set; } = "";
        public string DepartmentCode { get; set; } = "";
        public decimal BaseSalary { get; set; }
        public string ContractType { get; set; } = "";
        public DateTime HireDate { get; set; }
        public string HealthInsuranceCode { get; set; } = "";
        public string PensionCode { get; set; } = "";
        public string WorkRiskCode { get; set; } = "";
        public string BankAccount { get; set; } = "";
        public string BankName { get; set; } = "";
        public string BankAccountType { get; set; } = "";
    }

    private class SalaryHistoryItem
    {
        public DateOnly EffectiveDate { get; set; }
        public decimal PreviousSalary { get; set; }
        public decimal NewSalary { get; set; }
        public decimal ChangePercentage { get; set; }
        public string Reason { get; set; } = "";
        public string ChangedBy { get; set; } = "";
    }

    private class PayrollEntryItem
    {
        public string ConceptCode { get; set; } = "";
        public string ConceptName { get; set; } = "";
        public string EntryType { get; set; } = "";
        public decimal Amount { get; set; }
    }

    private class CurrentPayrollDto
    {
        public string PeriodName { get; set; } = "";
        public List<PayrollEntryItem> Entries { get; set; } = [];
    }

    private class CatalogItem
    {
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
    }

    private record DropOption(string Value, string Name);
}
