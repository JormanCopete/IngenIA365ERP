@page "/nomina/empleados/{EmployeeId:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@using IngenIA365ERP.Shared.Services.Nomina
@using IngenIA365ERP.Shared.Components.Nomina
@inject HttpClient Http
@inject NominaClient Nomina
@inject INotificationService Notification
@inject NavigationManager Nav

<PageTitle>Detalle Empleado - IngenIA365ERP</PageTitle>

<div class="page-header">
    <h3>@(_employee is not null ? $"Empleado: {_employee.FirstName} {_employee.LastName}" : "Detalle Empleado")</h3>
    <div>
        <SfButton CssClass="e-flat" IconCss="e-icons e-arrow-left"
                  OnClick='@(() => Nav.NavigateTo("/nomina/empleados"))'>Volver a Lista</SfButton>
        @if (_employee is not null && _employee.Status == 1)
        {
            <SfButton CssClass="e-primary" IconCss="e-icons e-save"
                      Disabled="@(!_hasChanges || _saving)"
                      OnClick="SaveLaborData">Guardar Cambios</SfButton>
            @if (_employee.Termination is { Status: 0 })
            {
                <SfButton CssClass="e-outline" IconCss="e-icons e-eye"
                          OnClick="@AbrirDefinitiva">Ver liquidación definitiva</SfButton>
            }
            else
            {
                <PermissionGate Required="Payroll.Settlements.Calculate">
                    <SfButton CssClass="e-danger" IconCss="e-icons e-close"
                              OnClick="@(() => { _registroDeTerminacion?.Reiniciar(); _mostrarTerminacion = true; })">Terminar contrato</SfButton>
                </PermissionGate>
            }
        }
    </div>
</div>

@if (_employee is not null)
{
    var statusBadge = _employee.Status == 1 ? "e-badge e-badge-success"
                    : _employee.Status == -1 ? "e-badge e-badge-danger"
                    : "e-badge e-badge-warning";
    var statusText = _employee.Status == 1 ? "Activo"
                   : _employee.Status == -1 ? "Retirado" : "Inactivo";
    <div style="margin-bottom:var(--gap-md);">
        <span class="@statusBadge" style="font-size:var(--texto-md);padding:var(--pad-xs) var(--pad-md);">@statusText</span>
        @if (_employee.Status == -1 && _employee.TerminationDate.HasValue)
        {
            <span class="texto-tenue" style="margin-left:var(--gap-sm);font-size:var(--texto-sm);">
                Terminado el @_employee.TerminationDate.Value.ToString("dd/MM/yyyy")
                @if (!string.IsNullOrEmpty(_employee.TerminationCause))
                {
                    <span> — @_employee.TerminationCause</span>
                }
            </span>
        }
    </div>
}

@if (_loading)
{
    <IndicadorDeCarga Cargando="true" Texto="Cargando la ficha…"><div class="module-placeholder"></div></IndicadorDeCarga>
}
else if (_employee is null)
{
    <div class="module-placeholder">
        <div class="placeholder-icon">
            <span class="e-icons e-people"></span>
        </div>
        <p>Empleado no encontrado.</p>
    </div>
}
else
{
    @* Velo de la ficha mientras se guardan los datos laborales; el guardado ya deshabilita el botón. *@
    <IndicadorDeCarga Cargando="@_saving" Texto="Guardando…">
    <SfTab>
        <TabItems>
            @* ===== Tab 1: Datos Personales (read-only, vienen de Persona) ===== *@
            <TabItem>
                <ChildContent>
                    <TabHeader Text="Datos Personales" />
                </ChildContent>
                <ContentTemplate>
                    <div class="rejilla-campos panel-pestana">
                        <div>
                            <label>Nombres</label>
                            <SfTextBox Value="@_employee.FirstName" Readonly="true" CssClass="e-disabled" />
                        </div>
                        <div>
                            <label>Apellidos</label>
                            <SfTextBox Value="@_employee.LastName" Readonly="true" CssClass="e-disabled" />
                        </div>
                        <div>
                            <label>Numero Documento</label>
                            <SfTextBox Value="@_employee.IdentificationNumber" Readonly="true" CssClass="e-disabled" />
                        </div>
                        <div>
                            <label>Correo Electronico</label>
                            <SfTextBox Value="@_employee.Email" Readonly="true" CssClass="e-disabled" />
                        </div>
                        <div>
                            <label>Telefono</label>
                            <SfTextBox Value="@_employee.Phone" Readonly="true" CssClass="e-disabled" />
                        </div>
                        <div>
                            <label>Movil</label>
                            <SfTextBox Value="@_employee.Mobile" Readonly="true" CssClass="e-disabled" />
                        </div>
                        <div class="campo-ancho">
                            <label>Direccion</label>
                            <SfTextBox Value="@_employee.Address" Readonly="true" CssClass="e-disabled" />
                        </div>
                    </div>
                    <div class="hint" style="padding:0 var(--pad-lg) var(--pad-md);">
                        Los datos personales se administran desde el modulo
                        <a href="/maestros/personas">Maestros - Personas</a>. Aqui son de solo lectura.
                    </div>
                </ContentTemplate>
            </TabItem>

            @* ===== Tab 2: Datos Laborales (editables) ===== *@
            <TabItem>
                <ChildContent>
                    <TabHeader Text="Datos Laborales" />
                </ChildContent>
                <ContentTemplate>
                    <div class="rejilla-campos panel-pestana">
                        <div>
                            <label>Salario Base <span style="color:var(--peligro-texto)">*</span></label>
                            <SfNumericTextBox TValue="decimal" @bind-Value="_labor.BaseSalary"
                                              Format="N2" Min="0" Step="50000m"
                                              ValueChange="@((Syncfusion.Blazor.Inputs.ChangeEventArgs<decimal> e) => MarkChanged())" />
                        </div>
                        <div>
                            <label>Tipo de Contrato <span style="color:var(--peligro-texto)">*</span></label>
                            <SfDropDownList TValue="int" TItem="ContractTypeOption"
                                            @bind-Value="_labor.ContractType"
                                            DataSource="@_contractTypes" Placeholder="Seleccione">
                                <DropDownListFieldSettings Text="Name" Value="Value" />
                                <DropDownListEvents TValue="int" TItem="ContractTypeOption"
                                                    ValueChange="@((Syncfusion.Blazor.DropDowns.ChangeEventArgs<int, ContractTypeOption> e) => MarkChanged())" />
                            </SfDropDownList>
                        </div>
                        <div>
                            <label>Fecha de Ingreso</label>
                            <SfDatePicker TValue="DateTime" Value="@_employee.HireDate"
                                          Format="dd/MM/yyyy" Readonly="true" CssClass="e-disabled" />
                        </div>

                        <div>
                            <label>EPS</label>
                            <SfDropDownList TValue="Guid?" TItem="LookupOption"
                                            @bind-Value="_labor.HealthInsurancePublicId"
                                            DataSource="@_eps"
                                            Placeholder="Seleccione EPS"
                                            AllowFiltering="true">
                                <DropDownListFieldSettings Text="Name" Value="PublicId" />
                                <DropDownListEvents TValue="Guid?" TItem="LookupOption"
                                                    ValueChange="@((Syncfusion.Blazor.DropDowns.ChangeEventArgs<Guid?, LookupOption> e) => MarkChanged())" />
                            </SfDropDownList>
                        </div>
                        <div>
                            <label>Fondo de Pension</label>
                            <SfDropDownList TValue="Guid?" TItem="LookupOption"
                                            @bind-Value="_labor.PensionProviderPublicId"
                                            DataSource="@_pensions"
                                            Placeholder="Seleccione AFP"
                                            AllowFiltering="true">
                                <DropDownListFieldSettings Text="Name" Value="PublicId" />
                                <DropDownListEvents TValue="Guid?" TItem="LookupOption"
                                                    ValueChange="@((Syncfusion.Blazor.DropDowns.ChangeEventArgs<Guid?, LookupOption> e) => MarkChanged())" />
                            </SfDropDownList>
                        </div>
                        <div>
                            <label>ARL (Riesgos Laborales)</label>
                            <SfDropDownList TValue="Guid?" TItem="LookupOption"
                                            @bind-Value="_labor.WorkRiskProviderPublicId"
                                            DataSource="@_arl"
                                            Placeholder="Seleccione ARL"
                                            AllowFiltering="true">
                                <DropDownListFieldSettings Text="Name" Value="PublicId" />
                                <DropDownListEvents TValue="Guid?" TItem="LookupOption"
                                                    ValueChange="@((Syncfusion.Blazor.DropDowns.ChangeEventArgs<Guid?, LookupOption> e) => MarkChanged())" />
                            </SfDropDownList>
                        </div>

                        <div>
                            <label>Banco</label>
                            <SfDropDownList TValue="Guid?" TItem="LookupOption"
                                            @bind-Value="_labor.BankPublicId"
                                            DataSource="@_banks"
                                            Placeholder="Seleccione banco"
                                            AllowFiltering="true">
                                <DropDownListFieldSettings Text="Name" Value="PublicId" />
                                <DropDownListEvents TValue="Guid?" TItem="LookupOption"
                                                    ValueChange="@((Syncfusion.Blazor.DropDowns.ChangeEventArgs<Guid?, LookupOption> e) => MarkChanged())" />
                            </SfDropDownList>
                        </div>
                        <div>
                            <label>Numero de Cuenta</label>
                            <SfTextBox @bind-Value="_labor.BankAccountNumber"
                                       Placeholder="Numero de cuenta"
                                       HtmlAttributes="@(new Dictionary<string, object> { { "maxlength", "25" } })"
                                       ValueChange="@((Syncfusion.Blazor.Inputs.ChangedEventArgs e) => MarkChanged())" />
                        </div>
                        <div>
                            <label>Tipo de Cuenta</label>
                            <SfDropDownList TValue="int" TItem="AccountTypeOption"
                                            @bind-Value="_labor.AccountType"
                                            DataSource="@_accountTypes" Placeholder="Seleccione">
                                <DropDownListFieldSettings Text="Name" Value="Value" />
                                <DropDownListEvents TValue="int" TItem="AccountTypeOption"
                                                    ValueChange="@((Syncfusion.Blazor.DropDowns.ChangeEventArgs<int, AccountTypeOption> e) => MarkChanged())" />
                            </SfDropDownList>
                        </div>
                    </div>
                </ContentTemplate>
            </TabItem>

            @* ===== Tab: PILA y DIAN (feature 010, contracts/api.md §12) ===== *@
            <TabItem>
                <ChildContent>
                    <TabHeader Text="PILA y DIAN" />
                </ChildContent>
                <ContentTemplate>
                    <div class="panel-pestana">
                        <div class="info-card">
                            <span class="label">Clase: @_employee.ClaseTexto</span>
                            <p>Lo que la planilla PILA y el documento de nómina electrónica leen de la ficha. Lo que quede vacío se deriva: el tipo de cotizante desde la clase y la etapa, el lugar de trabajo y la actividad económica desde los datos de la empresa, el medio de pago desde la forma de pago.</p>
                        </div>

                        <h4>Aprendiz</h4>
                        <div class="rejilla-campos">
                            <div>
                                <label>Etapa del contrato de aprendizaje @(_employee.EsAprendizOPasante ? "*" : "")</label>
                                <SfDropDownList TValue="int?" TItem="OpcionEntera" @bind-Value="_labor.ApprenticeStage"
                                                DataSource="@_etapas" Placeholder="@(_employee.EsAprendizOPasante ? "Obligatoria para aprendiz o pasante" : "No aplica a esta clase")" ShowClearButton="true">
                                    <DropDownListFieldSettings Text="Name" Value="Value" />
                                    <DropDownListEvents TValue="int?" TItem="OpcionEntera"
                                                        ValueChange="@((Syncfusion.Blazor.DropDowns.ChangeEventArgs<int?, OpcionEntera> e) => MarkChanged())" />
                                </SfDropDownList>
                                <span class="hint">Lectiva: sin prestaciones y apoyo parcial. Práctica: cotiza como dependiente. La clase se cambia en «Retención y plan».</span>
                            </div>
                        </div>

                        <h4>PILA</h4>
                        <div class="rejilla-campos">
                            <div>
                                <label>Tipo de cotizante (campo 5)</label>
                                <SfTextBox @bind-Value="_labor.PilaContributorType" Placeholder="Vacío = derivado (01, 12, 19, 51…)" HtmlAttributes="@Largo(2)"
                                           ValueChange="@((Syncfusion.Blazor.Inputs.ChangedEventArgs e) => MarkChanged())" />
                            </div>
                            <div>
                                <label>Subtipo de cotizante (campo 6)</label>
                                <SfTextBox @bind-Value="_labor.PilaContributorSubtype" Placeholder="00 no aplica, 01 pensionado activo…" HtmlAttributes="@Largo(2)"
                                           ValueChange="@((Syncfusion.Blazor.Inputs.ChangedEventArgs e) => MarkChanged())" />
                            </div>
                            <div>
                                <label>Departamento DIVIPOLA del lugar de trabajo</label>
                                <SfTextBox @bind-Value="_labor.DivipolaDepartment" Placeholder="2 dígitos; vacío = el de la empresa" HtmlAttributes="@Largo(2)"
                                           ValueChange="@((Syncfusion.Blazor.Inputs.ChangedEventArgs e) => MarkChanged())" />
                            </div>
                            <div>
                                <label>Municipio DIVIPOLA del lugar de trabajo</label>
                                <SfTextBox @bind-Value="_labor.DivipolaMunicipality" Placeholder="3 dígitos" HtmlAttributes="@Largo(3)"
                                           ValueChange="@((Syncfusion.Blazor.Inputs.ChangedEventArgs e) => MarkChanged())" />
                            </div>
                            <div>
                                <label>Actividad económica (Decreto 768/2022)</label>
                                <SfTextBox @bind-Value="_labor.EconomicActivityCode" Placeholder="Hasta 7 dígitos; vacío = la de la empresa" HtmlAttributes="@Largo(7)"
                                           ValueChange="@((Syncfusion.Blazor.Inputs.ChangedEventArgs e) => MarkChanged())" />
                            </div>
                            <div>
                                <label>Centro de trabajo (campo 62)</label>
                                <SfTextBox @bind-Value="_labor.WorkCenter" Placeholder="Código del centro de trabajo" HtmlAttributes="@Largo(9)"
                                           ValueChange="@((Syncfusion.Blazor.Inputs.ChangedEventArgs e) => MarkChanged())" />
                            </div>
                            <div>
                                <label>Tipo de salario</label>
                                <SfDropDownList TValue="string" TItem="OpcionTexto" @bind-Value="_labor.SalaryTypeCode" DataSource="@_tiposSalario" Placeholder="Seleccione">
                                    <DropDownListFieldSettings Text="Name" Value="Value" />
                                    <DropDownListEvents TValue="string" TItem="OpcionTexto"
                                                        ValueChange="@((Syncfusion.Blazor.DropDowns.ChangeEventArgs<string, OpcionTexto> e) => MarkChanged())" />
                                </SfDropDownList>
                            </div>
                            <div>
                                <label>Régimen de transición (Ley 2381/2024)</label>
                                <SfDropDownList TValue="int" TItem="OpcionEntera" @bind-Value="_labor.PensionTransitionRegime" DataSource="@_regimenes" Placeholder="Seleccione">
                                    <DropDownListFieldSettings Text="Name" Value="Value" />
                                    <DropDownListEvents TValue="int" TItem="OpcionEntera"
                                                        ValueChange="@((Syncfusion.Blazor.DropDowns.ChangeEventArgs<int, OpcionEntera> e) => MarkChanged())" />
                                </SfDropDownList>
                                <span class="hint">«No consta» es alerta en la PILA desde abril de 2027.</span>
                            </div>
                            <div class="campo-ancho">
                                <label class="campo-check"><input type="checkbox" @bind="_labor.HighRiskPension" @bind:after="MarkChanged" /> Alto riesgo para pensión (campo 79; DIAN AltoRiesgoPension)</label>
                                <label class="campo-check"><input type="checkbox" @bind="_labor.ForeignNotPensionObligated" @bind:after="MarkChanged" /> Extranjero no obligado a cotizar pensión (campo 8)</label>
                                <label class="campo-check"><input type="checkbox" @bind="_labor.ColombianAbroad" @bind:after="MarkChanged" /> Colombiano en el exterior (campo 9)</label>
                            </div>
                        </div>

                        <h4>DIAN (nómina electrónica)</h4>
                        <div class="rejilla-campos">
                            <div>
                                <label>Tipo y subtipo de trabajador</label>
                                <SfTextBox Value="@($"{(_labor.PilaContributorType ?? "derivado")} / {(_labor.PilaContributorSubtype ?? "00")}")" Readonly="true" CssClass="e-disabled" />
                                <span class="hint">Son los mismos códigos del cotizante PILA (tabla 5.5.1 del anexo DIAN).</span>
                            </div>
                            <div>
                                <label>Tipo de contrato DIAN</label>
                                <SfDropDownList TValue="int?" TItem="OpcionEntera" @bind-Value="_labor.ContractTypeDian" DataSource="@_contratosDian" Placeholder="Seleccione" ShowClearButton="true">
                                    <DropDownListFieldSettings Text="Name" Value="Value" />
                                    <DropDownListEvents TValue="int?" TItem="OpcionEntera"
                                                        ValueChange="@((Syncfusion.Blazor.DropDowns.ChangeEventArgs<int?, OpcionEntera> e) => MarkChanged())" />
                                </SfDropDownList>
                                <span class="hint">El «Tipo de contrato» de Datos laborales es el código del legado y no se reinterpreta.</span>
                            </div>
                            <div>
                                <label>Medio de pago DIAN (tabla 5.3.3.2)</label>
                                <SfTextBox @bind-Value="_labor.DianPaymentMethodCode" Placeholder="Vacío = derivado (47 transferencia, 20 cheque, 10 efectivo)" HtmlAttributes="@Largo(3)"
                                           ValueChange="@((Syncfusion.Blazor.Inputs.ChangedEventArgs e) => MarkChanged())" />
                            </div>
                            <div class="campo-ancho">
                                <label>Dirección del lugar de trabajo</label>
                                <SfTextBox @bind-Value="_labor.WorkAddress" Placeholder="Vacío = dirección de la empresa" HtmlAttributes="@Largo(120)"
                                           ValueChange="@((Syncfusion.Blazor.Inputs.ChangedEventArgs e) => MarkChanged())" />
                            </div>
                        </div>

                        <h4>Dispersión bancaria</h4>
                        <div class="rejilla-campos">
                            <div>
                                <label>Banco de dispersión</label>
                                <SfDropDownList TValue="Guid?" TItem="LookupOption" @bind-Value="_labor.DisbursementBankPublicId" DataSource="@_banks"
                                                Placeholder="Vacío = el banco de la cuenta de nómina" AllowFiltering="true" ShowClearButton="true">
                                    <DropDownListFieldSettings Text="Name" Value="PublicId" />
                                    <DropDownListEvents TValue="Guid?" TItem="LookupOption"
                                                        ValueChange="@((Syncfusion.Blazor.DropDowns.ChangeEventArgs<Guid?, LookupOption> e) => MarkChanged())" />
                                </SfDropDownList>
                            </div>
                            <div>
                                <label>Código ACH del banco</label>
                                <SfTextBox Value="@(_employee.DisbursementBankTransferCode ?? "—")" Readonly="true" CssClass="e-disabled" />
                                <span class="hint">Viene del catálogo de bancos (Maestros › Bancos, «Código de transferencia»).</span>
                            </div>
                        </div>
                    </div>
                </ContentTemplate>
            </TabItem>

            @* ===== Tab: Prestaciones (feature 010: saldos y porcentaje vigente) ===== *@
            <TabItem>
                <ChildContent>
                    <TabHeader Text="Prestaciones" />
                </ChildContent>
                <ContentTemplate>
                    <div class="panel-pestana">
                        <div class="rejilla-campos">
                            <div class="info-card">
                                <span class="label">Saldo inicial de prestaciones</span>
                                @if (_employee.OpeningBalance is { } sb)
                                {
                                    <p>Al @sb.AsOfDate.ToString("dd/MM/yyyy") (@(sb.Kind == 2 ? "ajuste" : "apertura")): vacaciones <strong>@sb.PendingVacationDays.ToString("N2")</strong> días · cesantías <strong>@sb.AccruedSeverance.ToString("N2")</strong> · intereses <strong>@sb.AccruedSeveranceInterest.ToString("N2")</strong> · prima <strong>@sb.AccruedServiceBonus.ToString("N2")</strong></p>
                                    <p class="texto-tenue">Digitado por @sb.EnteredBy el @sb.EnteredAt.ToLocalTime().ToString("dd/MM/yyyy")@(sb.ConsumedByRunPublicId is null ? "" : " · ya consumido por una liquidación aprobada")</p>
                                }
                                else
                                {
                                    <p>Sin saldo inicial digitado. Si ingresó antes del arranque de la nómina, la prima y las cesantías saldrían cortas.</p>
                                }
                                <SfButton CssClass="e-flat e-small" IconCss="e-icons e-edit" OnClick='@(() => Nav.NavigateTo("/nomina/saldos-iniciales"))'>Ir a Saldos iniciales</SfButton>
                            </div>
                            <div class="info-card">
                                <span class="label">Saldo de vacaciones</span>
                                @if (_employee.VacationBalance is { } sv)
                                {
                                    <p><strong>@sv.PendingDays.ToString("N2")</strong> días hábiles pendientes al @sv.AsOf.ToString("dd/MM/yyyy")</p>
                                    <p class="texto-tenue">Se deriva de los días causados, el saldo inicial, los disfrutes, compensaciones y ajustes registrados; el detalle paso a paso y los movimientos están en Vacaciones.</p>
                                }
                                else
                                {
                                    <p class="texto-tenue">Sin saldo calculado todavía: se deriva de los días causados, el saldo inicial y los disfrutes registrados.</p>
                                }
                                <SfButton CssClass="e-flat e-small" IconCss="e-icons e-calendar" OnClick='@(() => Nav.NavigateTo("/nomina/vacaciones"))'>Ir a Vacaciones</SfButton>
                            </div>
                            <div class="info-card">
                                <span class="label">Retención en la fuente</span>
                                @if (_employee.CurrentWithholdingRate is { } tasa)
                                {
                                    <p>Procedimiento @tasa.Procedure · porcentaje fijo vigente <strong>@tasa.RatePercent.ToString("0.##") %</strong> (@tasa.OrigenTexto), desde @tasa.ValidFrom.ToString("dd/MM/yyyy")@(tasa.ValidTo is { } h ? $" hasta {h:dd/MM/yyyy}" : "")</p>
                                }
                                else
                                {
                                    <p class="texto-tenue">Sin porcentaje fijo vigente: en procedimiento 1 se aplica la tabla cada período; en procedimiento 2 la liquidación se bloquea hasta registrarlo en «Retención y plan».</p>
                                }
                            </div>
                            <div class="info-card">
                                <span class="label">Terminación del contrato</span>
                                @if (_employee.Termination is { } t)
                                {
                                    <p>@t.EstadoTexto el @t.TerminationDate.ToString("dd/MM/yyyy") · motivo <strong>@t.ReasonName</strong>@(t.GeneratesSeverancePay ? " (genera indemnización)" : "")</p>
                                    <p class="texto-tenue">@(t.Status == 0 ? "La liquidación definitiva está en borrador: la ficha sigue vigente hasta aprobarla." : t.Status == 1 ? "Liquidada y aprobada: la ficha quedó retirada; un reingreso es una ficha nueva." : "")</p>
                                    <SfButton CssClass="e-flat e-small" IconCss="e-icons e-eye" OnClick="@AbrirDefinitiva">Ver la liquidación definitiva</SfButton>
                                }
                                else
                                {
                                    <p class="texto-tenue">Sin terminación registrada. El retiro se registra con «Terminar contrato»: crea la liquidación definitiva en borrador y la ficha se cierra al aprobarla.</p>
                                }
                            </div>
                        </div>
                    </div>
                </ContentTemplate>
            </TabItem>

            @* ===== Tab 3: Historial Salarial ===== *@
            <TabItem>
                <ChildContent>
                    <TabHeader Text="Historial Salarial" />
                </ChildContent>
                <ContentTemplate>
                    <div class="panel-pestana">
                        <SfGrid TValue="HistorialSalarialFichaDto" DataSource="@_employee.SalaryHistory"
                                AllowPaging="true" AllowSorting="true">
                            <GridPageSettings PageSize="15" />
                            <GridColumns>
                                <GridColumn Field="@nameof(HistorialSalarialFichaDto.EffectiveDate)" HeaderText="Fecha Vigencia" Width="160"
                                            Format="dd/MM/yyyy" Type="ColumnType.Date" />
                                <GridColumn Field="@nameof(HistorialSalarialFichaDto.NewSalary)" HeaderText="Nuevo Salario" Width="180"
                                            Format="N2" TextAlign="TextAlign.Right" />
                                <GridColumn Field="@nameof(HistorialSalarialFichaDto.UserName)" HeaderText="Modificado Por" Width="200" />
                            </GridColumns>
                        </SfGrid>
                        @if (_employee.SalaryHistory.Count == 0)
                        {
                            <div class="sin-datos">Sin registros de cambios salariales.</div>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>

            @* ===== Tab 4: Movimientos Recientes de Nomina ===== *@
            <TabItem>
                <ChildContent>
                    <TabHeader Text="Movimientos Recientes" />
                </ChildContent>
                <ContentTemplate>
                    <div class="panel-pestana">
                        <SfGrid TValue="MovimientoRecienteFichaDto" DataSource="@_employee.RecentEntries"
                                AllowPaging="true" AllowSorting="true">
                            <GridPageSettings PageSize="15" />
                            <GridColumns>
                                <GridColumn Field="@nameof(MovimientoRecienteFichaDto.PeriodDescription)" HeaderText="Periodo" Width="200" />
                                <GridColumn Field="@nameof(MovimientoRecienteFichaDto.ConceptName)" HeaderText="Concepto" Width="300" />
                                <GridColumn Field="@nameof(MovimientoRecienteFichaDto.Amount)" HeaderText="Valor" Width="160"
                                            Format="N2" TextAlign="TextAlign.Right" />
                            </GridColumns>
                        </SfGrid>
                        @if (_employee.RecentEntries.Count == 0)
                        {
                            <div class="sin-datos">Sin movimientos recientes.</div>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>

            @* ===== Tab 5: Retención y plan (feature 005, US3) ===== *@
            <TabItem>
                <ChildContent>
                    <TabHeader Text="Retención y plan" />
                </ChildContent>
                <ContentTemplate>
                    <IngenIA365ERP.Shared.Components.Nomina.RetencionYPlan EmployeeId="EmployeeId" />
                </ContentTemplate>
            </TabItem>
        </TabItems>
    </SfTab>
    </IndicadorDeCarga>
}

@* ===== Terminar contrato (feature 010, US3): registra la terminación y abre la definitiva ===== *@
<DialogoDeTerminacion @ref="_registroDeTerminacion" @bind-Visible="_mostrarTerminacion"
                      EmpleadoPublicId="@EmployeeId" EmpleadoNombre="@($"{_employee?.FirstName} {_employee?.LastName}".Trim())"
                      ContratoDeLaFicha="@_employee?.Dian?.ContractTypeDian"
                      OnRegistrada="@(t => Nav.NavigateTo($"/nomina/liquidacion-definitiva/{t.RunPublicId}"))" />

@code {
    [Parameter] public Guid EmployeeId { get; set; }

    private bool _loading = true;
    private bool _hasChanges;
    private bool _saving;
    private FichaEmpleadoDto? _employee;
    private LaborData _labor = new();

    // Lookups
    private List<LookupOption> _eps = new();
    private List<LookupOption> _pensions = new();
    private List<LookupOption> _arl = new();
    private List<LookupOption> _banks = new();

    // Tipos de contrato (alineados al ContractType int del backend; rango 0-10).
    private List<ContractTypeOption> _contractTypes = new()
    {
        new(1, "Indefinido"),
        new(2, "Termino Fijo"),
        new(3, "Obra o Labor"),
        new(4, "Prestacion de Servicios"),
        new(5, "Aprendizaje"),
        new(6, "Practica / Pasantia")
    };

    private List<AccountTypeOption> _accountTypes = new()
    {
        new(0, "(Ninguno)"),
        new(1, "Ahorros"),
        new(2, "Corriente")
    };

    // Terminar contrato (feature 010): el diálogo compartido registra la terminación y navega a la definitiva.
    private bool _mostrarTerminacion;
    private DialogoDeTerminacion? _registroDeTerminacion;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(
            LoadEmployee(),
            LoadEps(),
            LoadPensions(),
            LoadArl(),
            LoadBanks()
        );
        _loading = false;
    }

    // --- Carga ---

    private async Task LoadEmployee()
    {
        var res = await Nomina.FichaDeEmpleadoAsync(EmployeeId);
        if (!res.IsSuccess || res.Value is null)
        {
            _employee = null;
            await Notification.ErrorAsync($"Error al cargar empleado: {res.ErrorMessage}");
            return;
        }
        _employee = res.Value;

        // Sincroniza el modelo editable con la respuesta del backend.
        var pila = _employee.Pila;
        var dian = _employee.Dian;
        _labor = new LaborData
        {
            BaseSalary = _employee.Salary,
            ContractType = _employee.ContractType,
            HealthInsurancePublicId = _employee.HealthInsurancePublicId,
            PensionProviderPublicId = _employee.PensionProviderPublicId,
            WorkRiskProviderPublicId = _employee.WorkRiskProviderPublicId,
            BankPublicId = _employee.PayrollBankPublicId,
            BankAccountNumber = _employee.PayrollBankAccountNumber ?? "",
            AccountType = _employee.PayrollBankAccountType,
            // Feature 010
            ApprenticeStage = _employee.ApprenticeStage,
            DisbursementBankPublicId = _employee.DisbursementBankPublicId,
            PilaContributorType = pila?.ContributorType,
            PilaContributorSubtype = pila?.ContributorSubtype,
            DivipolaDepartment = pila?.DivipolaDepartment,
            DivipolaMunicipality = pila?.DivipolaMunicipality,
            EconomicActivityCode = pila?.EconomicActivityCode,
            WorkCenter = pila?.WorkCenter,
            SalaryTypeCode = pila?.SalaryTypeCode ?? "F",
            ForeignNotPensionObligated = pila?.ForeignNotPensionObligated ?? false,
            ColombianAbroad = pila?.ColombianAbroad ?? false,
            PensionTransitionRegime = pila?.PensionTransitionRegime ?? 0,
            HighRiskPension = pila?.HighRiskPension ?? false,
            ContractTypeDian = dian?.ContractTypeDian,
            DianPaymentMethodCode = dian?.PaymentMethodCode,
            WorkAddress = dian?.WorkAddress,
        };
        _hasChanges = false;
    }

    private async Task LoadEps()
    {
        try
        {
            _eps = (await Http.GetListAsync<LookupRaw>("/api/payroll/health-insurance?PageNumber=1&PageSize=500"))
                .Select(e => new LookupOption(e.PublicId, e.Name)).ToList();
        }
        catch { _eps = new List<LookupOption>(); }
    }

    private async Task LoadPensions()
    {
        try
        {
            _pensions = (await Http.GetListAsync<LookupRaw>("/api/payroll/pension-providers?PageNumber=1&PageSize=500"))
                .Select(p => new LookupOption(p.PublicId, p.Name)).ToList();
        }
        catch { _pensions = new List<LookupOption>(); }
    }

    private async Task LoadArl()
    {
        try
        {
            _arl = (await Http.GetListAsync<LookupRaw>("/api/payroll/work-risk?PageNumber=1&PageSize=500"))
                .Select(a => new LookupOption(a.PublicId, a.Name)).ToList();
        }
        catch { _arl = new List<LookupOption>(); }
    }

    private async Task LoadBanks()
    {
        try
        {
            _banks = (await Http.GetListAsync<LookupRaw>("/api/core/banks?PageNumber=1&PageSize=500"))
                .Select(b => new LookupOption(b.PublicId, b.Name)).ToList();
        }
        catch { _banks = new List<LookupOption>(); }
    }

    private void MarkChanged() => _hasChanges = true;

    // --- Guardar cambios laborales ---

    private async Task SaveLaborData()
    {
        if (_saving || _employee is null) return;

        if (_labor.BaseSalary <= 0)
        {
            await Notification.WarningAsync("El salario base debe ser mayor a 0.");
            return;
        }
        // Validación del lado del cliente alineada con PilaEmployeeInputValidator (Principio VIII).
        if (_employee.EsAprendizOPasante && _labor.ApprenticeStage is null)
        {
            await Notification.WarningAsync("Un aprendiz o pasante necesita la etapa (lectiva o práctica) en la pestaña «PILA y DIAN».");
            return;
        }
        if (string.IsNullOrEmpty(_labor.DivipolaDepartment) != string.IsNullOrEmpty(_labor.DivipolaMunicipality))
        {
            await Notification.WarningAsync("Departamento y municipio DIVIPOLA van juntos: los dos o ninguno.");
            return;
        }

        _saving = true;
        try
        {
            // Payload alineado a UpdateEmployeeCommand (banca renombrada a Payroll*). El comando
            // reemplaza la ficha entera: lo que esta pantalla no edita (clase ARL, fondo de
            // cesantías, caja, fecha de ingreso) va tal como llegó, o el PUT lo borraría. Los
            // bloques PILA/DIAN (feature 010) viajan completos; los enums, por nombre.
            var payload = new
            {
                BaseSalary = _labor.BaseSalary,
                ContractType = _labor.ContractType,
                HireDate = _employee.HireDate,
                HealthInsurancePublicId = _labor.HealthInsurancePublicId,
                PensionProviderPublicId = _labor.PensionProviderPublicId,
                WorkRiskProviderPublicId = _labor.WorkRiskProviderPublicId,
                WorkRiskRatePublicId = _employee.WorkRiskRatePublicId,
                SeveranceProviderPublicId = _employee.SeveranceProviderPublicId,
                FamilyCompensationFundPublicId = _employee.FamilyCompensationFundPublicId,
                PayrollBankPublicId = _labor.BankPublicId,
                PayrollBankAccountNumber = string.IsNullOrWhiteSpace(_labor.BankAccountNumber) ? null : _labor.BankAccountNumber,
                PayrollBankAccountType = _labor.AccountType,
                Pila = new
                {
                    ContributorType = Vacio(_labor.PilaContributorType),
                    ContributorSubtype = Vacio(_labor.PilaContributorSubtype),
                    DivipolaDepartment = Vacio(_labor.DivipolaDepartment),
                    DivipolaMunicipality = Vacio(_labor.DivipolaMunicipality),
                    EconomicActivityCode = Vacio(_labor.EconomicActivityCode),
                    WorkCenter = Vacio(_labor.WorkCenter),
                    SalaryTypeCode = _labor.SalaryTypeCode,
                    ForeignNotPensionObligated = _labor.ForeignNotPensionObligated,
                    ColombianAbroad = _labor.ColombianAbroad,
                    PensionTransitionRegime = _labor.PensionTransitionRegime switch { 1 => "Yes", 2 => "No", _ => "Unknown" },
                    HighRiskPension = _labor.HighRiskPension,
                },
                Dian = new
                {
                    ContractTypeDian = _labor.ContractTypeDian switch
                    {
                        1 => "FixedTerm", 2 => "Indefinite", 3 => "WorkOrLabor", 4 => "Apprenticeship", 5 => "Internship", _ => (string?)null,
                    },
                    HighRiskPension = _labor.HighRiskPension,
                    PaymentMethodCode = Vacio(_labor.DianPaymentMethodCode),
                    WorkAddress = Vacio(_labor.WorkAddress),
                },
                ApprenticeStage = _labor.ApprenticeStage switch { 1 => "Lective", 2 => "Practical", _ => (string?)null },
                DisbursementBankPublicId = _labor.DisbursementBankPublicId,
                ClearDisbursementBank = _labor.DisbursementBankPublicId is null && _employee.DisbursementBankPublicId is not null,
            };

            var res = await Http.PutAsJsonAsync($"/api/payroll/employees/{EmployeeId}", payload);
            if (res.IsSuccessStatusCode)
            {
                await Notification.SuccessAsync("Datos laborales actualizados correctamente.");
                _hasChanges = false;
                await LoadEmployee();
            }
            else
            {
                await Notification.ShowErrorAsync(res, "Error al guardar cambios");
            }
        }
        catch (Exception ex)
        {
            await Notification.ErrorAsync($"Error inesperado: {ex.Message}");
        }
        finally
        {
            _saving = false;
        }
    }

    // --- Terminar contrato ---

    /// <summary>La pantalla de la definitiva filtrada por este empleado: si tiene una terminación viva, abre su liquidación.</summary>
    private void AbrirDefinitiva() => Nav.NavigateTo($"/nomina/liquidacion-definitiva?empleado={EmployeeId}");

    // --- Modelos ---


    private class LaborData
    {
        public decimal BaseSalary { get; set; }
        public int ContractType { get; set; }
        public Guid? HealthInsurancePublicId { get; set; }
        public Guid? PensionProviderPublicId { get; set; }
        public Guid? WorkRiskProviderPublicId { get; set; }
        public Guid? BankPublicId { get; set; }
        public string BankAccountNumber { get; set; } = "";
        public int AccountType { get; set; }

        // Feature 010 (contracts/api.md §12)
        public int? ApprenticeStage { get; set; }
        public Guid? DisbursementBankPublicId { get; set; }
        public string? PilaContributorType { get; set; }
        public string? PilaContributorSubtype { get; set; }
        public string? DivipolaDepartment { get; set; }
        public string? DivipolaMunicipality { get; set; }
        public string? EconomicActivityCode { get; set; }
        public string? WorkCenter { get; set; }
        public string SalaryTypeCode { get; set; } = "F";
        public bool ForeignNotPensionObligated { get; set; }
        public bool ColombianAbroad { get; set; }
        public int PensionTransitionRegime { get; set; }
        public bool HighRiskPension { get; set; }
        public int? ContractTypeDian { get; set; }
        public string? DianPaymentMethodCode { get; set; }
        public string? WorkAddress { get; set; }
    }

    private static string? Vacio(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();
    private static Dictionary<string, object> Largo(int max) => new() { { "maxlength", max.ToString() } };

    private record OpcionEntera(int? Value, string Name);
    private record OpcionTexto(string Value, string Name);

    private readonly List<OpcionEntera> _etapas = [new(1, "Lectiva"), new(2, "Práctica")];
    private readonly List<OpcionEntera> _regimenes = [new(0, "No consta"), new(1, "Sí, en transición"), new(2, "No")];
    private readonly List<OpcionEntera> _contratosDian =
    [
        new(1, "1 · Término fijo"), new(2, "2 · Indefinido"), new(3, "3 · Obra o labor"), new(4, "4 · Aprendizaje"), new(5, "5 · Prácticas o pasantías"),
    ];
    private readonly List<OpcionTexto> _tiposSalario = [new("F", "F · Fijo"), new("V", "V · Variable"), new("X", "X · Integral")];



    private class LookupRaw
    {
        public Guid PublicId { get; set; }
        public string Name { get; set; } = "";
    }

    private class LookupOption
    {
        public Guid? PublicId { get; set; }
        public string Name { get; set; } = "";
        public LookupOption(Guid publicId, string name) { PublicId = publicId; Name = name; }
    }

    private record ContractTypeOption(int Value, string Name);
    private record AccountTypeOption(int Value, string Name);
}
