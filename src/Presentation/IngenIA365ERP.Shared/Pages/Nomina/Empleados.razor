@page "/nomina/empleados"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@using IngenIA365ERP.Shared.Components.Nomina
@inject HttpClient Http
@inject INotificationService Notification
@inject NavigationManager Nav
@inject PersonasClient Personas
@inject PermisosDelUsuario Permisos

<PageTitle>Empleados - IngenIA365ERP</PageTitle>

<div class="page-header">
    <h3>Empleados</h3>
    <div>
        <SfTextBox Placeholder="Buscar por documento, nombre o apellido..." @bind-Value="_search"
                   Width="320px"
                   ValueChange="@((Syncfusion.Blazor.Inputs.ChangedEventArgs e) => OnSearchChanged())" />
        <SfCheckBox @bind-Checked="_activeOnly" Label="Solo activos"
                    ValueChange="@((Syncfusion.Blazor.Buttons.ChangeEventArgs<bool> e) => LoadData())" />
        <PermissionGate Required="Payroll.Employees.Create">
            <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@OpenSelectPersonDialog">Nuevo empleado</SfButton>
        </PermissionGate>
    </div>
</div>

<IndicadorDeCarga Cargando="@_carga.Activa">
<SfGrid @ref="_grid" TValue="EmployeeRow" DataSource="@_items"
        AllowPaging="true" AllowSorting="true" AllowFiltering="true">
    <GridPageSettings PageSize="20" />
    <GridColumns>
        <GridColumn Field="@nameof(EmployeeRow.IdentificationNumber)" HeaderText="Documento" Width="130" />
        <GridColumn Field="@nameof(EmployeeRow.FullName)" HeaderText="Nombre completo" Width="260" />
        <GridColumn Field="@nameof(EmployeeRow.Salary)" HeaderText="Salario" Width="140"
                    Format="N2" TextAlign="TextAlign.Right" />
        <GridColumn Field="@nameof(EmployeeRow.HireDate)" HeaderText="Fecha ingreso" Width="130"
                    Format="dd/MM/yyyy" Type="ColumnType.Date" />
        <GridColumn HeaderText="Estado" Width="110" TextAlign="TextAlign.Center">
            <Template>
                @{
                    var emp = context as EmployeeRow;
                    var css = emp?.StatusText == "Activo" ? "e-badge e-badge-success marca-rol"
                            : emp?.StatusText == "Retirado" ? "e-badge e-badge-danger marca-rol"
                            : "e-badge e-badge-warning marca-rol";
                    <span class="@css">@emp?.StatusText</span>
                }
            </Template>
        </GridColumn>
        <GridColumn Field="@nameof(EmployeeRow.Email)" HeaderText="Email" Width="220" />
        <GridColumn HeaderText="Acciones" Width="170" TextAlign="TextAlign.Center"
                    AllowFiltering="false" AllowSorting="false">
            <Template>
                @{
                    var emp = context as EmployeeRow;
                    <SfButton CssClass="e-flat e-small" IconCss="e-icons e-eye"
                              OnClick="@(() => Nav.NavigateTo($"/nomina/empleados/{emp!.PublicId}"))" Title="Detalle: historial salarial, movimientos, retención y plan" />
                    <PermissionGate Required="Payroll.Employees.Update">
                        <SfButton CssClass="e-flat e-small" IconCss="e-icons e-edit"
                                  OnClick="@(() => OpenEditFromRow(emp!))" Title="Editar" />
                    </PermissionGate>
                    @if (emp?.StatusText == "Activo")
                    {
                        <PermissionGate Required="Payroll.Settlements.Calculate">
                            <SfButton CssClass="e-flat e-small e-danger" IconCss="e-icons e-close"
                                      OnClick="@(() => OpenTerminate(emp!))" Title="Terminar contrato: registra la terminación y crea la liquidación definitiva" />
                        </PermissionGate>
                    }
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>
</IndicadorDeCarga>

@* ===== Diálogo: elegir la persona (o crearla, si puede) ===== *@
<SfDialog @bind-Visible="_showSelectPerson" Header="Nuevo empleado: ¿quién es?"
          Width="600px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <div class="panel-pestana">
                <p class="muted">
                    Buscá la persona por documento o nombre. Si ya está registrada, se completa su ficha laboral;
                    @(_puedeCrearPersona ? "si no existe, podés crearla aquí mismo y registrarla como empleado en un solo paso." : "si no existe, pedile el registro a quien administra Maestros › Personas.")
                </p>
                <PersonSearchPicker OnPersonSelected="HandlePersonSelected" ShowHelpText="false"
                                    PermitirCrear="@_puedeCrearPersona" OnCrearPersona="AbrirAltaConPersonaNueva" />
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _showSelectPerson = false)" />
    </DialogButtons>
</SfDialog>

@* ===== Diálogo: registrar / editar empleado ===== *@
<SfDialog @bind-Visible="_showEditDialog" Header="@_dialogTitle"
          Width="900px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@(_guardado.Activa || _cargaDialogo.Activa)" Texto="@(_guardado.Activa ? "Guardando…" : "Cargando…")">
            @if (!_personaNueva)
            {
                <div class="persona-solo-lectura">
                    <span class="muted">
                        Datos personales de <strong>@_personaModelo.NombreVisible</strong> — se leen aquí; se editan en Personas.
                    </span>
                    <PermissionGate Required="Core.People.Update">
                        <SfButton CssClass="e-small" IconCss="e-icons e-edit" OnClick="@(() => _showPersonaDialog = true)">Editar datos de la persona</SfButton>
                    </PermissionGate>
                </div>
            }
            <SfTab>
                <TabItems>
                    <TabItem>
                        <ChildContent><TabHeader Text="Identificación" /></ChildContent>
                        <ContentTemplate>
                            <PersonaCampos Seccion="SeccionDePersona.Identificacion" Modelo="@_personaModelo" Deshabilitado="@(!_personaNueva)" />
                        </ContentTemplate>
                    </TabItem>
                    <TabItem>
                        <ChildContent><TabHeader Text="Contacto" /></ChildContent>
                        <ContentTemplate>
                            <PersonaCampos Seccion="SeccionDePersona.Contacto" Modelo="@_personaModelo" Deshabilitado="@(!_personaNueva)" Ciudades="@_ciudades" />
                        </ContentTemplate>
                    </TabItem>
                    <TabItem>
                        <ChildContent><TabHeader Text="Demografía" /></ChildContent>
                        <ContentTemplate>
                            <PersonaCampos Seccion="SeccionDePersona.Demografia" Modelo="@_personaModelo" Deshabilitado="@(!_personaNueva)" />
                        </ContentTemplate>
                    </TabItem>

                    @* === Datos laborales (PAY_Employees) === *@
                    <TabItem>
                        <ChildContent><TabHeader Text="Datos laborales" /></ChildContent>
                        <ContentTemplate>
                            <div class="rejilla-campos panel-pestana">
                                <div>
                                    <label>Salario base <span class="obligatorio">*</span></label>
                                    <SfNumericTextBox TValue="decimal" @bind-Value="_employeeModel.BaseSalary"
                                                      Format="N2" Min="0" Step="50000m" Placeholder="0,00" />
                                </div>
                                <div>
                                    <label>Tipo de contrato <span class="obligatorio">*</span></label>
                                    <SfDropDownList TValue="int" TItem="ContractTypeOption"
                                                    @bind-Value="_employeeModel.ContractType"
                                                    DataSource="@_contractTypes">
                                        <DropDownListFieldSettings Text="Name" Value="Value" />
                                    </SfDropDownList>
                                </div>
                                <div>
                                    <label>Fecha de ingreso <span class="obligatorio">*</span></label>
                                    <SfDatePicker TValue="DateTime" @bind-Value="_employeeModel.HireDate" Format="dd/MM/yyyy" />
                                </div>
                                <div>
                                    <label>Plan de nómina <span class="obligatorio">*</span></label>
                                    @if (_planes.Count <= 1)
                                    {
                                        <p class="texto-tenue">@(_planes.FirstOrDefault()?.Name ?? "Plan por defecto") — único plan de la cooperativa. Para quincenales u otra periodicidad, creá otro en Nómina › Planes de nómina.</p>
                                    }
                                    else
                                    {
                                        <SfDropDownList TValue="Guid?" TItem="LookupOption"
                                                        @bind-Value="_employeeModel.PayrollPlanPublicId"
                                                        DataSource="@_planesLookup"
                                                        Placeholder="Seleccione plan">
                                            <DropDownListFieldSettings Text="Name" Value="PublicId" />
                                        </SfDropDownList>
                                        @if (_employeePublicId is not null && _employeeModel.PayrollPlanPublicId != _planOriginal)
                                        {
                                            <label class="hint">Rige desde
                                                <SfDatePicker TValue="DateTime" @bind-Value="_planDesde" Format="dd/MM/yyyy" Width="170px" />
                                            </label>
                                            <p class="hint">El cambio de plan lleva fecha de efecto: no puede caer dentro de un período abierto o calculado del plan actual.</p>
                                        }
                                    }
                                </div>
                                <div>
                                    <label>EPS</label>
                                    <SfDropDownList TValue="Guid?" TItem="LookupOption" @bind-Value="_employeeModel.HealthInsurancePublicId"
                                                    DataSource="@_eps" AllowFiltering="true" Placeholder="Seleccione EPS">
                                        <DropDownListFieldSettings Text="Name" Value="PublicId" />
                                    </SfDropDownList>
                                </div>
                                <div>
                                    <label>Fondo de pensión</label>
                                    <SfDropDownList TValue="Guid?" TItem="LookupOption" @bind-Value="_employeeModel.PensionProviderPublicId"
                                                    DataSource="@_pensions" AllowFiltering="true" Placeholder="Seleccione AFP">
                                        <DropDownListFieldSettings Text="Name" Value="PublicId" />
                                    </SfDropDownList>
                                </div>
                                <div>
                                    <label>ARL (riesgos laborales)</label>
                                    <SfDropDownList TValue="Guid?" TItem="LookupOption" @bind-Value="_employeeModel.WorkRiskProviderPublicId"
                                                    DataSource="@_arl" AllowFiltering="true" Placeholder="Seleccione ARL">
                                        <DropDownListFieldSettings Text="Name" Value="PublicId" />
                                    </SfDropDownList>
                                </div>
                                <div>
                                    <label>Clase de riesgo ARL</label>
                                    <SfDropDownList TValue="Guid?" TItem="LookupOption" @bind-Value="_employeeModel.WorkRiskRatePublicId"
                                                    DataSource="@_arlClases" Placeholder="Seleccione la clase (I a V)">
                                        <DropDownListFieldSettings Text="Name" Value="PublicId" />
                                    </SfDropDownList>
                                </div>
                                <p class="campo-ancho hint">
                                    Sin clase de riesgo la liquidación no calcula el aporte a ARL y queda bloqueada
                                    para aprobar. Las clases se administran en Nómina › Clases de riesgo ARL.
                                </p>
                                <div>
                                    <label>Fondo de cesantías</label>
                                    <SfDropDownList TValue="Guid?" TItem="LookupOption" @bind-Value="_employeeModel.SeveranceProviderPublicId"
                                                    DataSource="@_cesantias" AllowFiltering="true" Placeholder="Seleccione fondo">
                                        <DropDownListFieldSettings Text="Name" Value="PublicId" />
                                    </SfDropDownList>
                                </div>
                                <div>
                                    <label>Caja de compensación</label>
                                    <SfDropDownList TValue="Guid?" TItem="LookupOption" @bind-Value="_employeeModel.FamilyCompensationFundPublicId"
                                                    DataSource="@_cajas" AllowFiltering="true" Placeholder="Seleccione caja">
                                        <DropDownListFieldSettings Text="Name" Value="PublicId" />
                                    </SfDropDownList>
                                </div>
                            </div>
                        </ContentTemplate>
                    </TabItem>

                    @* === Banca nómina (PAY_Employees) === *@
                    <TabItem>
                        <ChildContent><TabHeader Text="Banca nómina" /></ChildContent>
                        <ContentTemplate>
                            <div class="rejilla-campos panel-pestana">
                                <p class="campo-ancho hint">Cuenta donde se consigna el salario del empleado por nómina.</p>
                                <div>
                                    <label>Banco</label>
                                    <SfDropDownList TValue="Guid?" TItem="LookupOption" @bind-Value="_employeeModel.PayrollBankPublicId"
                                                    DataSource="@_banks" AllowFiltering="true" Placeholder="Seleccione banco">
                                        <DropDownListFieldSettings Text="Name" Value="PublicId" />
                                    </SfDropDownList>
                                </div>
                                <div>
                                    <label>Tipo de cuenta</label>
                                    <SfDropDownList TValue="int" TItem="AccountTypeOption" @bind-Value="_employeeModel.PayrollBankAccountType"
                                                    DataSource="@_accountTypes">
                                        <DropDownListFieldSettings Text="Name" Value="Value" />
                                    </SfDropDownList>
                                </div>
                                <div class="campo-ancho">
                                    <label>Número de cuenta</label>
                                    <SfTextBox @bind-Value="_employeeModel.PayrollBankAccountNumber"
                                               HtmlAttributes="@(new Dictionary<string, object> { { "maxlength", "25" } })" />
                                </div>
                            </div>
                        </ContentTemplate>
                    </TabItem>
                </TabItems>
            </SfTab>

            @if (_colision is not null)
            {
                <div class="aviso aviso-error aviso-documento">
                    <span>@_colision.Mensaje</span>
                    @if (_colision.Eliminada)
                    {
                        <PermissionGate Required="Core.People.Delete">
                            <SfButton CssClass="e-small" OnClick="@RestaurarYUsarAsync" Disabled="@_saving">Restaurar persona</SfButton>
                        </PermissionGate>
                        <PermissionGate Required="Core.People.Delete" Fallback="@PedirRestauracion" />
                    }
                    else
                    {
                        <SfButton CssClass="e-small" OnClick="@UsarExistenteAsync" Disabled="@_saving">Usar esa persona</SfButton>
                    }
                </div>
            }
            </IndicadorDeCarga>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@CancelEdit" />
        <DialogButton Content="@(_isNewEmployee ? "Registrar" : "Guardar cambios")"
                      IsPrimary="true" OnClick="@Save" Disabled="@(_saving || _guardado.Activa)" />
    </DialogButtons>
</SfDialog>

@* El único sitio que escribe la persona: el diálogo compartido de Personas (FR-005). *@
<PersonaDialog @bind-Visible="_showPersonaDialog" PersonaPublicId="@_personPublicId" OnGuardado="@PersonaEditadaAsync" />

@* ===== Terminar contrato (feature 010, US3): el diálogo compartido registra la terminación y abre la definitiva ===== *@
<DialogoDeTerminacion @ref="_registroDeTerminacion" @bind-Visible="_showTerminateDialog"
                      EmpleadoPublicId="@_terminating?.PublicId" EmpleadoNombre="@_terminating?.FullName"
                      OnRegistrada="@(t => Nav.NavigateTo($"/nomina/liquidacion-definitiva/{t.RunPublicId}"))" />

@code {
    /// <summary>Feature 008: llegar con <c>?persona=</c> (desde Personas › Roles › «Registrar como empleado…») abre el diálogo con esa persona.</summary>
    [SupplyParameterFromQuery(Name = "persona")] public Guid? Persona { get; set; }

    // Indicadores de carga por zona (ver docs/manual/indicador-de-carga.md): la lista y los
    // catálogos del formulario salen a la vez y el velo dura hasta el último.
    private readonly EstadoDeCarga _carga = new(), _cargaDialogo = new(), _guardado = new();
    private SfGrid<EmployeeRow>? _grid;
    private List<EmployeeRow> _items = new();
    private string _search = "";
    private bool _activeOnly = false;   // Mostrar TODOS por defecto
    private System.Threading.CancellationTokenSource? _searchDebounce;
    private bool _puedeCrearPersona;
    private Guid? _personaAbiertaPorRuta;

    // Diálogo: elegir persona
    private bool _showSelectPerson;

    // Diálogo: registrar / editar
    private bool _showEditDialog, _showPersonaDialog;
    private bool _saving;
    private bool _isNewEmployee;
    /// <summary>Modo alta en un paso: la persona no existe todavía y sus campos se editan aquí (FR-001).</summary>
    private bool _personaNueva;
    private string _dialogTitle = "";
    private Guid? _employeePublicId;     // null si es nuevo
    private Guid? _personPublicId;       // null si la persona es nueva
    private PersonaFormularioModelo _personaModelo = PersonaFormularioModelo.Nuevo();
    private EmployeeModel _employeeModel = new();
    private Colision? _colision;

    // Terminar contrato
    private bool _showTerminateDialog;
    private EmployeeRow? _terminating;
    private DialogoDeTerminacion? _registroDeTerminacion;

    // Catálogos
    private List<LookupOption> _eps = new();
    private List<LookupOption> _pensions = new();
    private List<LookupOption> _arl = new();
    private List<LookupOption> _arlClases = new();
    private List<LookupOption> _cesantias = new();
    private List<PlanLookup> _planes = new();
    private List<LookupOption> _planesLookup = new();
    private Guid? _planOriginal;
    private DateTime _planDesde = DateTime.Today;
    private List<LookupOption> _cajas = new();
    private List<LookupOption> _banks = new();
    private IReadOnlyList<OpcionDeCiudad> _ciudades = [];

    private List<ContractTypeOption> _contractTypes = new()
    {
        new(1, "Indefinido"), new(2, "Término fijo"), new(3, "Obra o labor"),
        new(4, "Prestación de servicios"), new(5, "Aprendizaje"),
        new(6, "Práctica / pasantía")
    };
    private List<AccountTypeOption> _accountTypes = new()
    {
        new(0, "(Ninguno)"), new(1, "Ahorros"), new(2, "Corriente")
    };

    private RenderFragment PedirRestauracion => @<span>Pedile la restauración a quien administra Maestros › Personas.</span>;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadLookups(), LoadData(), CalcularPermisosAsync());
    }

    protected override async Task OnParametersSetAsync()
    {
        // Llegada desde Personas con ?persona=: una sola vez por valor.
        if (Persona is { } id && _personaAbiertaPorRuta != id)
        {
            _personaAbiertaPorRuta = id;
            await AbrirConPersonaExistenteAsync(id);
        }
    }

    private async Task CalcularPermisosAsync() =>
        _puedeCrearPersona = await Permisos.TieneAsync("Core.People.Create");

    private async Task LoadLookups()
    {
        using var carga = _carga.Iniciar();
        // Los catálogos salen a la vez; se espera a que terminen todos, se toma cada resultado
        // por separado, se muestran los que sí llegaron y se avisa cuáles fallaron (Principio IX).
        var epsTask = Http.GetListAsync<LookupRaw>("/api/payroll/health-insurance?PageNumber=1&PageSize=500");
        var pensionsTask = Http.GetListAsync<LookupRaw>("/api/payroll/pension-providers?PageNumber=1&PageSize=500");
        var arlTask = Http.GetListAsync<LookupRaw>("/api/payroll/work-risk?PageNumber=1&PageSize=500");
        var arlClasesTask = Http.GetListAsync<LookupRaw>("/api/payroll/work-risk-rates?PageNumber=1&PageSize=50");
        var cesantiasTask = Http.GetListAsync<LookupRaw>("/api/payroll/severance-providers?PageNumber=1&PageSize=500");
        var cajasTask = Http.GetListAsync<LookupRaw>("/api/payroll/family-compensation-funds?PageNumber=1&PageSize=500");
        var planesTask = Http.GetListAsync<PlanLookup>("/api/payroll/plans?includeInactive=false");
        var banksTask = Http.GetListAsync<LookupRaw>("/api/core/banks?PageNumber=1&PageSize=500");
        var citiesTask = Personas.ListarCiudadesAsync();

        // WhenAll no termina hasta que terminan todas, incluso si alguna ya falló; la excepción
        // agregada se ignora aquí porque cada tarea se revisa una por una justo debajo.
        try { await Task.WhenAll(epsTask, pensionsTask, arlTask, arlClasesTask, cesantiasTask, cajasTask, planesTask, banksTask, citiesTask); }
        catch { /* se revisa tarea por tarea */ }

        var caidos = new List<string>();
        _eps = Resultado(epsTask, "EPS", caidos).Select(x => new LookupOption(x.PublicId, x.Name)).ToList();
        _pensions = Resultado(pensionsTask, "fondos de pensión", caidos).Select(x => new LookupOption(x.PublicId, x.Name)).ToList();
        _arl = Resultado(arlTask, "ARL", caidos).Select(x => new LookupOption(x.PublicId, x.Name)).ToList();
        _arlClases = Resultado(arlClasesTask, "clases de riesgo ARL", caidos).Select(x => new LookupOption(x.PublicId, x.Name)).ToList();
        _cesantias = Resultado(cesantiasTask, "fondos de cesantías", caidos).Select(x => new LookupOption(x.PublicId, x.Name)).ToList();
        _cajas = Resultado(cajasTask, "cajas de compensación", caidos).Select(x => new LookupOption(x.PublicId, x.Name)).ToList();
        _planes = Resultado(planesTask, "planes de nómina", caidos);
        _planesLookup = _planes.Select(p => new LookupOption(p.PublicId, $"{p.Name} ({(p.Periodicity switch { "Biweekly" => "quincenal", "TenDay" => "decadal", "Weekly" => "semanal", _ => "mensual" })})")).ToList();
        _banks = Resultado(banksTask, "bancos", caidos).Select(x => new LookupOption(x.PublicId, x.Name)).ToList();
        _ciudades = Resultado(citiesTask, "ciudades", caidos);

        if (caidos.Count > 0)
            await Notification.ErrorAsync($"No se pudieron cargar estos catálogos: {string.Join("; ", caidos)}. " +
                                          "Las listas del formulario quedan incompletas: recargá la página antes de editar un empleado.");
    }

    /// <summary>
    /// Toma el resultado de un catálogo ya terminado; si falló, lo anota con el motivo y devuelve
    /// una lista vacía para que los demás catálogos igual se muestren.
    /// </summary>
    private static T Resultado<T>(Task<T> tarea, string nombre, List<string> caidos) where T : new()
    {
        if (tarea.IsCompletedSuccessfully) return tarea.Result;
        var motivo = tarea.Exception?.GetBaseException().Message ?? "cancelado";
        caidos.Add($"{nombre} ({motivo})");
        return new T();
    }

    private static IReadOnlyList<OpcionDeCiudad> Resultado(Task<IReadOnlyList<OpcionDeCiudad>> tarea, string nombre, List<string> caidos)
    {
        if (tarea.IsCompletedSuccessfully) return tarea.Result;
        caidos.Add($"{nombre} ({tarea.Exception?.GetBaseException().Message ?? "cancelado"})");
        return [];
    }

    private async Task LoadData()
    {
        using var carga = _carga.Iniciar();
        try
        {
            var url = "/api/payroll/employees?PageNumber=1&PageSize=500"
                   + (_activeOnly ? "&ActiveOnly=true" : "")
                   + (string.IsNullOrWhiteSpace(_search) ? "" : $"&Search={Uri.EscapeDataString(_search)}");
            _items = await Http.GetListAsync<EmployeeRow>(url);
        }
        catch (Exception ex)
        {
            _items = new List<EmployeeRow>();
            await Notification.ErrorAsync($"No se pudieron cargar los empleados: {ex.Message}");
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
            if (_grid is not null) await _grid.Refresh();
        }
    }

    private async Task OnSearchChanged()
    {
        _searchDebounce?.Cancel();
        _searchDebounce = new System.Threading.CancellationTokenSource();
        var token = _searchDebounce.Token;
        try
        {
            await Task.Delay(350, token);
            if (!token.IsCancellationRequested) await LoadData();
        }
        catch (TaskCanceledException) { }
    }

    // ---------- Elegir o crear la persona ----------

    private void OpenSelectPersonDialog() => _showSelectPerson = true;

    private Task HandlePersonSelected(PersonSearchPicker.PersonSearchItem person)
    {
        _showSelectPerson = false;
        return AbrirConPersonaExistenteAsync(person.PublicId);
    }

    /// <summary>
    /// Persona existente: sus datos se muestran de sólo lectura (FR-005). Si tiene ficha viva se
    /// edita esa; si no —nunca fue empleada o su contrato terminó—, se registra una nueva (FR-017).
    /// </summary>
    private async Task AbrirConPersonaExistenteAsync(Guid personaId)
    {
        using var carga = _cargaDialogo.Iniciar();
        _colision = null;
        var persona = await Personas.ObtenerAsync(personaId);
        if (!persona.IsSuccess || persona.Value is null)
        {
            await Notification.ErrorAsync($"No se pudo cargar la persona: {persona.ErrorMessage}");
            return;
        }
        _personPublicId = personaId;
        _personaNueva = false;
        _personaModelo = PersonaFormularioModelo.DesdeDto(persona.Value);

        if (persona.Value.IsEmployee)
        {
            // Sólo la ficha viva; una retirada no cuenta y la consulta ya no la devuelve.
            var existente = await Http.GetAsync($"/api/payroll/employees/by-person/{personaId}");
            if (existente.IsSuccessStatusCode)
            {
                var ficha = await existente.Content.ReadFromJsonAsync<EmployeeDetailDto>();
                if (ficha is not null)
                {
                    AbrirEdicion(ficha);
                    return;
                }
            }
            else if (existente.StatusCode != System.Net.HttpStatusCode.NotFound)
            {
                await Notification.ShowErrorAsync(existente, "No se pudo cargar la ficha del empleado");
                return;
            }
        }

        AbrirRegistro($"Registrar empleado: {_personaModelo.NombreVisible}");
    }

    /// <summary>Alta en un paso (FR-001): la persona no existe; se digita aquí y se guarda junto con la ficha.</summary>
    private void AbrirAltaConPersonaNueva(string termino)
    {
        _showSelectPerson = false;
        _colision = null;
        _personPublicId = null;
        _personaNueva = true;
        // Sólo dígitos → es el documento; con nombre, el documento queda vacío.
        _personaModelo = PersonaFormularioModelo.Nuevo(termino.All(char.IsDigit) ? termino : null);
        AbrirRegistro("Registrar empleado (persona nueva)");
    }

    private void AbrirRegistro(string titulo)
    {
        _employeePublicId = null;
        _isNewEmployee = true;
        _dialogTitle = titulo;
        _employeeModel = new EmployeeModel
        {
            HireDate = DateTime.Today,
            ContractType = 1,
            PayrollBankAccountType = 1,
            // Con un solo plan no se pregunta; con varios se preselecciona el por defecto.
            PayrollPlanPublicId = (_planes.FirstOrDefault(p => p.IsDefault) ?? _planes.FirstOrDefault())?.PublicId,
        };
        _planOriginal = _employeeModel.PayrollPlanPublicId;
        _showEditDialog = true;
    }

    private void AbrirEdicion(EmployeeDetailDto ficha)
    {
        _employeePublicId = ficha.PublicId;
        _isNewEmployee = false;
        _dialogTitle = $"Editar empleado: {ficha.FirstName} {ficha.LastName}";
        _employeeModel = MapEmployeeDto(ficha);
        _planOriginal = ficha.PayrollPlanPublicId; _planDesde = DateTime.Today;
        _showEditDialog = true;
    }

    // ---------- Editar desde la grilla ----------

    private async Task OpenEditFromRow(EmployeeRow row)
    {
        using var carga = _cargaDialogo.Iniciar();
        try
        {
            var ficha = await Http.GetFromJsonAsync<EmployeeDetailDto>($"/api/payroll/employees/{row.PublicId}");
            if (ficha is null)
            {
                await Notification.ErrorAsync("No se cargó el empleado.");
                return;
            }
            // La ficha ya dice de quién es (feature 008): antes se buscaba la persona por documento.
            var persona = await Personas.ObtenerAsync(ficha.PersonPublicId);
            if (!persona.IsSuccess || persona.Value is null)
            {
                await Notification.ErrorAsync($"No se cargó la persona del empleado: {persona.ErrorMessage}");
                return;
            }
            _personPublicId = ficha.PersonPublicId;
            _personaNueva = false;
            _personaModelo = PersonaFormularioModelo.DesdeDto(persona.Value);
            _colision = null;
            AbrirEdicion(ficha);
        }
        catch (Exception ex)
        {
            await Notification.ErrorAsync($"Error al cargar empleado: {ex.Message}");
        }
    }

    /// <summary>Volvió el diálogo compartido de Personas: se refrescan los datos de sólo lectura.</summary>
    private async Task PersonaEditadaAsync(Guid personaId)
    {
        var persona = await Personas.ObtenerAsync(personaId);
        if (persona.IsSuccess && persona.Value is not null)
            _personaModelo = PersonaFormularioModelo.DesdeDto(persona.Value);
        await LoadData();
    }

    private void CancelEdit()
    {
        _showEditDialog = false;
        _employeePublicId = null;
        _colision = null;
        _personaModelo = PersonaFormularioModelo.Nuevo();
        _employeeModel = new EmployeeModel();
    }

    // ---------- Guardar ----------

    private async Task Save()
    {
        if (_saving) return;

        if (_personaNueva)
        {
            var avisos = _personaModelo.Validar();
            if (avisos.Count > 0) { await Notification.WarningAsync(avisos[0]); return; }
        }
        if (_employeeModel.BaseSalary <= 0)
        {
            await Notification.WarningAsync("El salario base debe ser mayor a 0.");
            return;
        }
        if (_employeeModel.HireDate == default)
        {
            await Notification.WarningAsync("La fecha de ingreso es obligatoria.");
            return;
        }

        _saving = true;
        _colision = null;
        using var guardado = _guardado.Iniciar();
        try
        {
            if (_isNewEmployee && _personaNueva)
            {
                // Un solo paso: persona y ficha juntas o ninguna (FR-001).
                var r = await Personas.RegistrarEmpleadoConPersonaAsync(
                    new AltaEmpleadoConPersonaRequest(_personaModelo.AInput(), PayloadLaboral()));
                if (!r.IsSuccess) { await FalloDelAltaAsync(r.ErrorCode, r.ErrorMessage); return; }
                await Notification.SuccessAsync("Persona y empleado registrados correctamente.");
                _showEditDialog = false;
                await LoadData();
                return;
            }

            // Persona existente: la ficha va sola; los datos personales NO se tocan desde aquí (FR-005).
            HttpResponseMessage resEmp;
            if (_isNewEmployee)
            {
                resEmp = await Http.PostAsJsonAsync("/api/payroll/employees",
                    PayloadLaboral() with { PersonPublicId = _personPublicId!.Value });
            }
            else
            {
                var updatePayload = new
                {
                    BaseSalary = _employeeModel.BaseSalary,
                    ContractType = _employeeModel.ContractType,
                    HireDate = _employeeModel.HireDate,
                    HealthInsurancePublicId = _employeeModel.HealthInsurancePublicId,
                    PensionProviderPublicId = _employeeModel.PensionProviderPublicId,
                    WorkRiskProviderPublicId = _employeeModel.WorkRiskProviderPublicId,
                    WorkRiskRatePublicId = _employeeModel.WorkRiskRatePublicId,
                    SeveranceProviderPublicId = _employeeModel.SeveranceProviderPublicId,
                    FamilyCompensationFundPublicId = _employeeModel.FamilyCompensationFundPublicId,
                    PayrollBankPublicId = _employeeModel.PayrollBankPublicId,
                    PayrollBankAccountNumber = string.IsNullOrWhiteSpace(_employeeModel.PayrollBankAccountNumber)
                        ? null : _employeeModel.PayrollBankAccountNumber,
                    PayrollBankAccountType = _employeeModel.PayrollBankAccountType
                };
                resEmp = await Http.PutAsJsonAsync($"/api/payroll/employees/{_employeePublicId}", updatePayload);
                // El plan no va en el PUT: cambiarlo lleva fecha de efecto y sus propias reglas.
                if (resEmp.IsSuccessStatusCode && _employeeModel.PayrollPlanPublicId is { } planNuevo && planNuevo != _planOriginal)
                {
                    var resPlan = await Http.PostAsJsonAsync($"/api/payroll/employees/{_employeePublicId}/plan",
                        new { PlanPublicId = planNuevo, EffectiveFrom = _planDesde });
                    if (!resPlan.IsSuccessStatusCode)
                    {
                        await Notification.ShowErrorAsync(resPlan, "Los datos se guardaron, pero el cambio de plan no");
                        resEmp = resPlan;
                    }
                }
            }

            if (resEmp.IsSuccessStatusCode)
            {
                await Notification.SuccessAsync(_isNewEmployee
                    ? "Empleado registrado correctamente."
                    : "Empleado actualizado correctamente.");
                _showEditDialog = false;
                await LoadData();
            }
            else
            {
                await Notification.ShowErrorAsync(resEmp, "Error al guardar datos del empleado");
            }
        }
        catch (Exception ex)
        {
            await Notification.ErrorAsync($"Error inesperado: {ex.Message}");
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>La parte laboral del alta; el mismo objeto sirve para el compuesto y para el registro sobre persona existente.</summary>
    private PayloadLaboralDto PayloadLaboral() => new(
        _employeeModel.BaseSalary, _employeeModel.ContractType, _employeeModel.HireDate,
        _employeeModel.HealthInsurancePublicId, _employeeModel.PensionProviderPublicId, _employeeModel.WorkRiskProviderPublicId,
        _employeeModel.WorkRiskRatePublicId, _employeeModel.SeveranceProviderPublicId, _employeeModel.FamilyCompensationFundPublicId,
        _employeeModel.PayrollPlanPublicId, _employeeModel.PayrollBankPublicId,
        string.IsNullOrWhiteSpace(_employeeModel.PayrollBankAccountNumber) ? null : _employeeModel.PayrollBankAccountNumber,
        _employeeModel.PayrollBankAccountType);

    /// <summary>Documento duplicado o de una eliminada: se ofrece la salida junto al formulario (FR-007, FR-016); lo demás, como aviso.</summary>
    private async Task FalloDelAltaAsync(string? codigo, string? mensaje)
    {
        switch (codigo)
        {
            case ErroresDePersona.DocumentoDuplicado:
                _colision = new Colision(mensaje ?? "Ya existe una persona con ese documento.", Eliminada: false);
                break;
            case ErroresDePersona.DocumentoEliminado:
                _colision = new Colision(mensaje ?? "Ese documento pertenece a una persona eliminada.", Eliminada: true);
                break;
            default:
                await Notification.ErrorAsync(codigo == "Generic.NotFound"
                    ? $"Error al registrar: {NotificationServiceExtensions.SinPermiso}"
                    : $"Error al registrar: {mensaje}");
                break;
        }
    }

    /// <summary>«Usar esa persona»: el documento ya es de alguien; se sigue con ella como existente, conservando lo laboral digitado.</summary>
    private async Task UsarExistenteAsync()
    {
        var quien = await Personas.PorDocumentoAsync(_personaModelo.TaxId.Trim());
        if (!quien.IsSuccess || quien.Value is null)
        {
            await Notification.ErrorAsync($"No se pudo abrir la persona existente: {quien.ErrorMessage}");
            return;
        }
        await ContinuarConExistenteAsync(quien.Value.PublicId);
    }

    /// <summary>«Restaurar persona»: misma fila; después se sigue con ella como existente.</summary>
    private async Task RestaurarYUsarAsync()
    {
        if (_saving) return;
        _saving = true;
        using var guardado = _guardado.Iniciar();
        try
        {
            var quien = await Personas.PorDocumentoAsync(_personaModelo.TaxId.Trim());
            if (!quien.IsSuccess || quien.Value is null)
            {
                await Notification.ErrorAsync($"No se encontró la persona eliminada: {quien.ErrorMessage}");
                return;
            }
            var r = await Personas.RestaurarAsync(quien.Value.PublicId);
            if (!r.IsSuccess)
            {
                await Notification.ErrorAsync(r.ErrorCode == "Generic.NotFound"
                    ? NotificationServiceExtensions.SinPermiso
                    : $"No se pudo restaurar: {r.ErrorMessage}");
                return;
            }
            await Notification.SuccessAsync($"Persona restaurada: {quien.Value.FullName}.");
            await ContinuarConExistenteAsync(quien.Value.PublicId);
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>Cambia el diálogo a persona existente sin perder los datos laborales ya digitados.</summary>
    private async Task ContinuarConExistenteAsync(Guid personaId)
    {
        var laboral = _employeeModel;
        var titulo = _dialogTitle;
        await AbrirConPersonaExistenteAsync(personaId);
        if (_isNewEmployee)
        {
            _employeeModel = laboral;
        }
        else if (titulo != _dialogTitle)
        {
            await Notification.InfoAsync("Esa persona ya es empleada: se abrió su ficha para editarla.");
        }
    }

