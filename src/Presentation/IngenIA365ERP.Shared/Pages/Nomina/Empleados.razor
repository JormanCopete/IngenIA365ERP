        _showTerminateDialog = true;
    }

    // ---------- Mapeos ----------

    private static EmployeeModel MapEmployeeDto(EmployeeDetailDto e) => new()
    {
        BaseSalary = e.Salary,
        ContractType = e.ContractType == 0 ? 1 : e.ContractType,
        HireDate = e.HireDate == default ? DateTime.Today : e.HireDate,
        HealthInsurancePublicId = e.HealthInsurancePublicId,
        PensionProviderPublicId = e.PensionProviderPublicId,
        WorkRiskProviderPublicId = e.WorkRiskProviderPublicId,
        WorkRiskRatePublicId = e.WorkRiskRatePublicId,
        SeveranceProviderPublicId = e.SeveranceProviderPublicId,
        FamilyCompensationFundPublicId = e.FamilyCompensationFundPublicId,
        PayrollPlanPublicId = e.PayrollPlanPublicId,
        PayrollBankPublicId = e.PayrollBankPublicId,
        PayrollBankAccountNumber = e.PayrollBankAccountNumber ?? "",
        PayrollBankAccountType = e.PayrollBankAccountType
    };

