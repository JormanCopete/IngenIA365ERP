@page "/nomina/arl"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification
@inject PersonasClient Personas
@inject PermisosDelUsuario Permisos

<PageTitle>ARL - IngenIA365ERP</PageTitle>

<div class="page-header">
    <h3>ARL (Administradoras de Riesgos Laborales)</h3>
    <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@OpenCreate">Nuevo</SfButton>
</div>

<IndicadorDeCarga Cargando="@_carga.Activa">
<SfGrid @ref="_grid" TValue="ItemModel" DataSource="@_items" AllowPaging="true" AllowSorting="true" AllowFiltering="true">
    <GridColumns>
        <GridColumn Field="Code" HeaderText="Código" Width="120" />
        <GridColumn Field="Name" HeaderText="Nombre" Width="250" />
        <GridColumn Field="ShortName" HeaderText="Nombre Corto" Width="180" />
        <GridColumn Field="TaxId" HeaderText="NIT" Width="140" />
        <GridColumn Field="CheckDigit" HeaderText="DV" Width="80" TextAlign="TextAlign.Center" />
        <GridColumn Field="PilaCode" HeaderText="Código PILA" Width="120" />
        <GridColumn Field="PersonName" HeaderText="Tercero" Width="200" />
        <GridColumn Field="Factor" HeaderText="Factor" Width="120" Format="N4" TextAlign="TextAlign.Right" />
        <GridColumn HeaderText="Acciones" Width="150" TextAlign="TextAlign.Center">
            <Template>
                @{
                    var item = context as ItemModel;
                    <SfButton CssClass="e-flat e-small" IconCss="e-icons e-edit" OnClick="@(() => OpenEdit(item!))" />
                    <SfButton CssClass="e-flat e-small e-danger" IconCss="e-icons e-trash" OnClick="@(() => OpenDelete(item!))" />
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>
</IndicadorDeCarga>

<SfDialog @bind-Visible="_showDialog" Header="@_dialogTitle" Width="500px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@_guardado.Activa" Texto="Guardando…">
            <div class="pagina">
                <CampoCodigo Catalogo="arl" @bind-Value="_model.Code" Largo="10" Obligatorio="true"
                             EditandoPublicId="_editId" OnEditarExistente="EditarExistente" DuplicadoChanged="@(d => _codigoRepetido = d)" />
                <SfTextBox @bind-Value="_model.Name" Placeholder="Nombre *" MaxLength="100" FloatLabelType="FloatLabelType.Always" />
                <SfTextBox @bind-Value="_model.ShortName" Placeholder="Nombre corto" MaxLength="50" FloatLabelType="FloatLabelType.Always" />
                <SfTextBox @bind-Value="_model.TaxId" Placeholder="NIT" MaxLength="20" FloatLabelType="FloatLabelType.Always" />
                <SfNumericTextBox TValue="int" @bind-Value="_model.CheckDigit" Placeholder="Dígito de verificación" Min="0" Max="9" FloatLabelType="FloatLabelType.Always" />
                <SfTextBox @bind-Value="_model.PilaCode" Placeholder="Código PILA (6 posiciones, el del listado del operador)" MaxLength="6" FloatLabelType="FloatLabelType.Always" />
                <div class="campo">
                    <label>Persona que la representa como tercero (feature 009)</label>
                    <PersonSearchPicker @bind-Selected="_persona" ShowHelpText="false" PermitirCrear="@_puedeCrearPersona" OnCrearPersona="@CrearPersonaAsync" TextoSinResultados="Regístrela en Maestros › Personas y vuelva a buscarla." />
                    <span class="texto-tenue">Con ella se contabilizan los aportes en las cuentas que exigen tercero.</span>
                </div>
                <SfNumericTextBox TValue="decimal" @bind-Value="_model.Factor" Placeholder="Factor" Format="N4" FloatLabelType="FloatLabelType.Always" />
            </div>
        </IndicadorDeCarga>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _showDialog = false)" />
        <DialogButton Content="Guardar" IsPrimary="true" OnClick="@Save" Disabled="@_guardado.Activa" />
    </DialogButtons>
</SfDialog>

<PersonaDialog @bind-Visible="_mostrarPersona" DocumentoInicial="@_documentoInicial" OnGuardado="@PersonaGuardadaAsync" />

<ConfirmDialog @bind-Visible="_showConfirm" OnConfirm="ConfirmDelete" Message="Esta seguro de eliminar este registro?" />

@code {
    // Indicadores de carga por zona (ver docs/manual/indicador-de-carga.md).
    private readonly EstadoDeCarga _carga = new(), _guardado = new();
    private SfGrid<ItemModel>? _grid;
    private List<ItemModel> _items = [];
    private FormModel _model = new();
    private Guid? _editId;
    private bool _codigoRepetido;
    private bool _showDialog, _showConfirm;
    private string _dialogTitle = "";
    private Guid _deleteId;

    protected override async Task OnInitializedAsync()
    {
        _puedeCrearPersona = await Permisos.TieneAsync("Core.People.Create");
        await LoadData();
    }

    private async Task LoadData()
    {
        using var carga = _carga.Iniciar();
        try { var r = await Http.GetFromJsonAsync<Paged>("/api/payroll/work-risk?pageSize=500"); _items = r?.Items ?? []; }
        catch (Exception ex) { _items = []; await Notification.ErrorAsync($"No se pudo cargar la lista: {ex.Message}"); }
    }

    private void OpenCreate() { _model = new(); _persona = null; _editId = null; _dialogTitle = "Nueva ARL"; _showDialog = true; }

    private void EditarExistente(Guid publicId)
    {
        var item = _items.FirstOrDefault(i => i.PublicId == publicId);
        if (item is not null) { _codigoRepetido = false; OpenEdit(item); }
    }

    private void OpenEdit(ItemModel item)
    {
        _model = new() { Code = item.Code, Name = item.Name, ShortName = item.ShortName, TaxId = item.TaxId, CheckDigit = item.CheckDigit, Factor = item.Factor, PilaCode = item.PilaCode };
        _persona = item.PersonPublicId is { } pid ? new PersonSearchPicker.PersonSearchItem { PublicId = pid, FullName = item.PersonName ?? "" } : null;
        _editId = item.PublicId; _dialogTitle = "Editar ARL"; _showDialog = true;
    }

    private void OpenDelete(ItemModel item) { _deleteId = item.PublicId; _showConfirm = true; }

    private async Task Save()
    {
        using var guardado = _guardado.Iniciar();
        if (string.IsNullOrWhiteSpace(_model.Code) || string.IsNullOrWhiteSpace(_model.Name))
        {
            await Notification.WarningAsync("El código y el nombre son obligatorios.");
            return;
        }
        if (_codigoRepetido)
        {
            await Notification.WarningAsync("Ese código ya existe: editá ese registro o usá otro código.");
            return;
        }
        _model.PersonPublicId = _persona?.PublicId;
        var res = _editId.HasValue
            ? await Http.PutAsJsonAsync($"/api/payroll/work-risk/{_editId}", _model)
            : await Http.PostAsJsonAsync("/api/payroll/work-risk", _model);
        if (res.IsSuccessStatusCode) { await Notification.SuccessAsync("Guardado"); _showDialog = false; await LoadData(); }
        else await Notification.ShowErrorAsync(res, "Error al guardar");
    }

    private async Task ConfirmDelete()
    {
        var res = await Http.DeleteAsync($"/api/payroll/work-risk/{_deleteId}");
        if (res.IsSuccessStatusCode) { await Notification.SuccessAsync("Eliminado"); await LoadData(); }
        else await Notification.ShowErrorAsync(res, "Error al eliminar");
    }

    private class Paged { public List<ItemModel> Items { get; set; } = []; }
    private class ItemModel
    {
        public Guid? PersonPublicId { get; set; }
        public string? PersonName { get; set; }
        public Guid PublicId { get; set; }
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
        public string ShortName { get; set; } = "";
        public string TaxId { get; set; } = "";
        public int CheckDigit { get; set; }
        public string? PilaCode { get; set; }
        public decimal Factor { get; set; }
    }
    private class FormModel
    {
        public Guid? PersonPublicId { get; set; }
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
        public string ShortName { get; set; } = "";
        public string TaxId { get; set; } = "";
        public int CheckDigit { get; set; }
        public string? PilaCode { get; set; }
        public decimal Factor { get; set; }
    }
    // Feature 009 (FR-088): la persona que representa a la entidad como tercero contable.
    private PersonSearchPicker.PersonSearchItem? _persona;
    private bool _puedeCrearPersona;
    private bool _mostrarPersona;
    private string? _documentoInicial;

    private async Task CrearPersonaAsync(string termino)
    {
        _documentoInicial = termino.All(char.IsDigit) ? termino : null;
        _mostrarPersona = true;
        await Task.CompletedTask;
    }

    private async Task PersonaGuardadaAsync(Guid publicId)
    {
        _mostrarPersona = false;
        var r = await Personas.ObtenerAsync(publicId);
        if (r.IsSuccess && r.Value is { } p)
            _persona = new PersonSearchPicker.PersonSearchItem { PublicId = p.PublicId, IdentificationNumber = p.TaxId, FullName = p.NombreVisible };
    }
}
