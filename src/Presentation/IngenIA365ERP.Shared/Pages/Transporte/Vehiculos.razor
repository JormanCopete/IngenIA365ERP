@page "/transporte/vehiculos"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using IngenIA365ERP.Shared.Services.Http
@using IngenIA365ERP.Shared.Services.Transporte
@using IngenIA365ERP.Shared.Services.Recaudo
@using IngenIA365ERP.Shared.Services.Nomina
@inject VehiculosClient Api
@inject ServiciosDeTransporteClient ServiciosApi
@inject InformesDeRecaudoYTesoreriaClient InformesApi
@inject DescargaDeArchivos Descargas
@inject INotificationService Notification
@inject NavigationManager Nav

<PageTitle>Vehículos - IngenIA365ERP</PageTitle>

@* Feature 020 (US2, US3; FR-005 a FR-016, FR-025): el parque automotor de la cooperativa. Se busca por placa, número interno, radio-móvil o
   documento o nombre del propietario. «Nuevo» registra un vehículo con un propietario que ya existe; si la persona no existe, se crea
   desde el diálogo único de persona. Las plantillas cargan y actualizan en lote con las mismas reglas.
   2026-11-25 (pedido del dueño): filtros por vinculación y por servicio («suscrito a», «no suscrito a», «sin ningún servicio», todos en el
   servidor), columna de servicios con la marca de precio pactado, tamaño de página y exportar a Excel lo filtrado (el informe de vehículos con
   los mismos filtros). *@
<PermissionGate Required="Transport.Vehicles.View" MostrarAviso="true">
<div class="pagina">
    <div class="page-header">
        <h3>Vehículos</h3>
        <div class="toolbar">
            <PermissionGate Required="Transport.Vehicles.Export">
                <SfButton CssClass="e-outline" IconCss="e-icons e-download" Disabled="@(_carga.Activa || _exportando.Activa)" OnClick="@ExportarAsync">Exportar a Excel</SfButton>
            </PermissionGate>
            <PermissionGate Required="Transport.Vehicles.Create">
                <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@Abrir">Nuevo vehículo</SfButton>
            </PermissionGate>
        </div>
    </div>

    <PanelDeFiltros HayFiltros="@HayFiltros" Limpiar="@LimpiarAsync">
        <Principales>
            <label class="campo campo-ancho">Buscar
                <input class="e-input" placeholder="Placa, número interno, radio-móvil, documento o nombre del propietario" @bind="_filtros.Q" @bind:event="oninput"
                       data-enter="propio" @onkeyup="@BuscarConEnter" />
            </label>
            <label class="campo">Estado
                <select class="e-input" value="@(_filtros.Estado?.ToString() ?? "")" @onchange="@(e => { _filtros.Estado = Entero(e.Value); return BuscarAsync(); })">
                    <option value="">Todos</option>
                    <option value="1">Activos</option>
                    <option value="2">Inactivos</option>
                    <option value="3">Retirados</option>
                </select>
            </label>
            <label class="campo">Vinculación
                <select class="e-input" value="@(_filtros.Vinculacion?.ToString() ?? "")" @onchange="@(e => { _filtros.Vinculacion = Entero(e.Value); return BuscarAsync(); })">
                    <option value="">Todas</option>
                    <option value="1">Asociados</option>
                    <option value="2">Externos</option>
                </select>
            </label>
            <label class="campo">Servicio
                <select class="e-input" value="@_servicio" @onchange="@(e => CambiarServicioAsync(e.Value?.ToString()))">
                    <option value="">Cualquiera</option>
                    <option value="@ConAlguno">Con algún servicio</option>
                    <option value="@SinNinguno">Sin ningún servicio</option>
                    @foreach (var s in _servicios) { <option value="@s.PublicId">@s.Name</option> }
                </select>
            </label>
            @if (_filtros.Servicio is not null)
            {
                <label class="campo">Suscripción
                    <select class="e-input" value="@_filtros.FiltroDeServicio" @onchange="@(e => { _filtros.FiltroDeServicio = e.Value?.ToString(); return BuscarAsync(); })">
                        <option value="Subscribed">Suscritos</option>
                        <option value="NotSubscribed">No suscritos</option>
                    </select>
                </label>
            }
            <div class="campo">
                <SfButton CssClass="e-outline" IconCss="e-icons e-search" Disabled="@_carga.Activa" OnClick="@BuscarAsync">Buscar</SfButton>
            </div>
        </Principales>
    </PanelDeFiltros>

    <IndicadorDeCarga Cargando="@_carga.Activa">
        @if (_pagina is null || _pagina.Items.Count == 0)
        {
            <p class="texto-tenue">No hay vehículos con ese criterio.</p>
        }
        else
        {
            <div class="toolbar">
                <span class="texto-tenue">@Rango()</span>
                <label class="campo">Por página
                    <select class="e-input" value="@_tamano" @onchange="@(e => { _tamano = Entero(e.Value) ?? 50; return BuscarAsync(); })">
                        @foreach (var t in Tamanos) { <option value="@t">@t</option> }
                    </select>
                </label>
            </div>
            <div class="tabla-desplazable">
                <table class="data-grid">
                    <thead><tr><th>Placa</th><th>N.º interno</th><th>Radio-móvil</th><th>Estado</th><th>Propietario</th><th>Vinculación</th><th>Servicios</th><th>Marca y línea</th><th>Modelo</th></tr></thead>
                    <tbody>
                        @foreach (var v in _pagina.Items)
                        {
                            <tr>
                                <td><a class="enlace" href="@($"/transporte/vehiculos/{v.PublicId}")">@v.Plate</a></td><td>@v.InternalNumber</td><td>@v.RadioCode</td>
                                <td>@TextosDeTransporte.Estado(v.Status) <span class="texto-tenue">desde @v.StatusSince.ToString("dd/MM/yyyy")</span></td>
                                <td>@v.OwnerTaxId · @v.OwnerName</td><td>@TextosDeTransporte.Vinculacion(v.Affiliation)</td>
                                <td>
                                    @if (v.Services is { Count: > 0 } servicios)
                                    {
                                        @foreach (var s in servicios)
                                        {
                                            <span class="@(s.AgreedPrice ? "badge badge-ok" : "badge")" title="@TituloDeServicio(s)">@TextoDeServicio(s)</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="texto-tenue">Ninguno</span>
                                    }
                                </td>
                                <td>@v.Brand @v.Line</td><td>@v.ModelYear</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="toolbar">
                <SfButton CssClass="e-flat" Disabled="@(_pagina.PageNumber <= 1 || _carga.Activa)" OnClick="@(() => IrAAsync(_pagina.PageNumber - 1))">Anterior</SfButton>
                <span>Página @_pagina.PageNumber de @Paginas</span>
                <SfButton CssClass="e-flat" Disabled="@(_pagina.PageNumber >= Paginas || _carga.Activa)" OnClick="@(() => IrAAsync(_pagina.PageNumber + 1))">Siguiente</SfButton>
            </div>
            <p class="texto-apoyo">Los servicios son las suscripciones que no han terminado; las que empiezan más adelante dicen «desde». En verde, con precio pactado.</p>
        }
    </IndicadorDeCarga>

    <PermissionGate Required="Transport.Vehicles.Import">
        <div class="info-card">
            <h4>Cargar y actualizar vehículos en lote</h4>
            <p>Descargue la plantilla, llénela desde la fila 2 y revísela: no se guarda nada hasta aplicar, y con un solo error no se guarda ninguno.
               El propietario debe existir en Maestros › Personas: la plantilla no crea personas. Al actualizar se cambian sólo las celdas con valor.</p>
            <ImportarPlantilla RutaBase="@VehiculosClient.Ruta" ConDatos="false" PreguntaSiExiste="Si la placa ya existe"
                               PermisoDeDescarga="Transport.Vehicles.View" PermisoDeImportacion="Transport.Vehicles.Import" Aplicado="@(_ => CargarAsync())" />
        </div>
        <div class="info-card">
            <h4>Cambios en lote: activar, inactivar, retirar o cambiar propietario</h4>
            <p>Cada fila lleva la placa, la acción, la fecha efectiva y el motivo; para cambiar de propietario, el documento del nuevo. Se aplican las mismas
               reglas que uno a uno.</p>
            <ImportarPlantilla RutaBase="@($"{VehiculosClient.Ruta}/changes")" ConDatos="false"
                               PermisoDeDescarga="Transport.Vehicles.View" PermisoDeImportacion="Transport.Vehicles.Import" Aplicado="@(_ => CargarAsync())" />
        </div>
    </PermissionGate>
</div>

<SfDialog @bind-Visible="_mostrar" Header="Nuevo vehículo" Width="760px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@_guardado.Activa" Texto="Guardando…">
                <div class="form-grid">
                    <label class="campo campo-ancho">Propietario *
                        <PersonSearchPicker Selected="_propietario" SelectedChanged="@(p => _propietario = p)" PermitirCrear="true" OnCrearPersona="@CrearPersona" Compacto="true" />
                    </label>
                    <label class="campo">Placa * <input class="e-input" @bind="_v.Plate" maxlength="10" /></label>
                    <label class="campo">Número interno * <input class="e-input" @bind="_v.InternalNumber" maxlength="10" /></label>
                    <label class="campo">Radio-móvil <input class="e-input" @bind="_v.RadioCode" maxlength="20" /></label>
                    <label class="campo">Fecha de ingreso <input type="date" class="e-input" value="@_v.JoinedOn?.ToString("yyyy-MM-dd")" @onchange="@(e => _v.JoinedOn = Fecha(e.Value))" /></label>
                    <label class="campo">Línea <input class="e-input" @bind="_v.Line" maxlength="60" /></label>
                    <label class="campo">Modelo <input type="number" class="e-input" @bind="_v.ModelYear" /></label>
                    <label class="campo">Color <input class="e-input" @bind="_v.Color" maxlength="40" /></label>
                </div>
                <p class="texto-apoyo">La ficha técnica completa, la vinculación y los equipos se llenan en la ficha del vehículo después de crearlo.</p>
                <div class="toolbar">
                    <SfButton CssClass="e-primary" Disabled="@(_guardado.Activa || _propietario is null || string.IsNullOrWhiteSpace(_v.Plate) || string.IsNullOrWhiteSpace(_v.InternalNumber))" OnClick="@GuardarAsync">Guardar</SfButton>
                    <SfButton CssClass="e-outline" OnClick="@(() => _mostrar = false)">Cancelar</SfButton>
                </div>
            </IndicadorDeCarga>
        </Content>
    </DialogTemplates>
</SfDialog>

<PersonaDialog @bind-Visible="_crearPersona" DocumentoInicial="@_documentoNuevo" CapturarAutorizacion="true" Compacto="true" OnGuardado="@PersonaCreada" />
</PermissionGate>

@code {
    private const string ConAlguno = "any", SinNinguno = "none";
    private static readonly int[] Tamanos = [25, 50, 100, 200];

    private readonly EstadoDeCarga _carga = new(), _guardado = new(), _exportando = new();
    private ClaveDeOperacion _clave = new();
    private PaginaDeTransporteDto<VehiculoListadoDto>? _pagina;
    private FiltrosDeVehiculosDto _filtros = new();
    private List<ServicioDeTransporteDto> _servicios = [];
    private string _servicio = "";
    private int _numero = 1, _tamano = 50;
    private bool _mostrar, _crearPersona;
    private VehiculoEntradaDto _v = new();
    private PersonSearchPicker.PersonSearchItem? _propietario;
    private string? _documentoNuevo;

    private bool HayFiltros => !string.IsNullOrWhiteSpace(_filtros.Q) || _filtros.Estado is not null || _filtros.Vinculacion is not null
                               || _filtros.FiltroDeServicio is not null;

    private int Paginas => _pagina is null || _pagina.PageSize == 0 ? 1 : Math.Max(1, (int)Math.Ceiling(_pagina.TotalCount / (double)_pagina.PageSize));

    protected override async Task OnInitializedAsync()
    {
        // Los servicios para el filtro: quien no puede verlos no tiene el filtro por uno en particular (sigue «con alguno» y «sin ninguno»).
        var s = await ServiciosApi.ServiciosAsync(incluirInactivos: true);
        _servicios = s.IsSuccess ? [.. s.Value ?? []] : [];
        await CargarAsync();
    }

    private async Task BuscarConEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await BuscarAsync();
    }

    private Task BuscarAsync()
    {
        _numero = 1;
        return CargarAsync();
    }

    private Task CambiarServicioAsync(string? valor)
    {
        _servicio = valor ?? "";
        (_filtros.Servicio, _filtros.FiltroDeServicio) = _servicio switch
        {
            ConAlguno => ((Guid?)null, "Any"),
            SinNinguno => (null, "None"),
            _ when Guid.TryParse(_servicio, out var id) => (id, _filtros.FiltroDeServicio is "NotSubscribed" ? "NotSubscribed" : "Subscribed"),
            _ => (null, (string?)null),
        };
        return BuscarAsync();
    }

    private Task LimpiarAsync()
    {
        _filtros = new FiltrosDeVehiculosDto();
        _servicio = "";
        return BuscarAsync();
    }

    private async Task IrAAsync(int numero)
    {
        _numero = Math.Max(1, numero);
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        using var carga = _carga.Iniciar();
        var r = await Api.ListarAsync(_filtros, _numero, _tamano);
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudieron consultar los vehículos."); return; }
        _pagina = r.Value;
    }

    private async Task ExportarAsync()
    {
        using var carga = _exportando.Iniciar();
        var r = await InformesApi.DescargarAsync("transport", "vehiculos", _filtros.ComoQuery(), "xlsx");
        if (!r.IsSuccess || r.Value is null) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo exportar."); return; }
        await Descargas.GuardarAsync(r.Value.Nombre, r.Value.TipoContenido, r.Value.Contenido);
    }

    private string Rango()
    {
        if (_pagina is null || _pagina.TotalCount == 0) return "0 vehículos.";
        var desde = (_pagina.PageNumber - 1) * _pagina.PageSize + 1;
        var hasta = desde + _pagina.Items.Count - 1;
        return $"{desde:N0}–{hasta:N0} de {_pagina.TotalCount:N0} vehículo(s).";
    }

    private static string TextoDeServicio(ServicioDelListadoDto s) =>
        s.Name + (s.AgreedPrice ? " · pactado" : "") + (s.Upcoming ? $" · desde {s.From:dd/MM}" : "");

    private static string TituloDeServicio(ServicioDelListadoDto s) =>
        $"Desde {s.From:dd/MM/yyyy}" + (s.To is { } h ? $" hasta {h:dd/MM/yyyy}" : ", sin fin") + (s.AgreedPrice ? "; con precio pactado" : "; precio del producto");

    private void Abrir()
    {
        _v = new VehiculoEntradaDto { JoinedOn = DateOnly.FromDateTime(DateTime.Today) };
        _propietario = null;
        _clave = new();
        _mostrar = true;
    }

    private void CrearPersona(string documento)
    {
        _documentoNuevo = documento;
        _crearPersona = true;
    }

    private void PersonaCreada(Guid persona)
    {
        _crearPersona = false;
        _propietario = new PersonSearchPicker.PersonSearchItem { PublicId = persona, IdentificationNumber = _documentoNuevo ?? "", FullName = "Persona recién creada" };
    }

    private async Task GuardarAsync()
    {
        if (_propietario is null) return;
        using (_guardado.Iniciar())
        {
            var r = await Api.CrearAsync(_v, _propietario.PublicId, _clave);
            if (!r.IsSuccess || r.Value is null)
            {
                await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo registrar el vehículo.");
                return;
            }
            _mostrar = false;
            await Notification.SuccessAsync($"Vehículo {_v.Plate.ToUpperInvariant()} registrado.");
            Nav.NavigateTo($"/transporte/vehiculos/{r.Value.VehiclePublicId}");
        }
    }

    private static int? Entero(object? valor) => int.TryParse(valor?.ToString(), out var n) ? n : null;

    private static DateOnly? Fecha(object? valor) => DateOnly.TryParse(valor?.ToString(), out var f) ? f : null;
}
