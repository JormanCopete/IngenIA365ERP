@page "/transporte/servicios"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using IngenIA365ERP.Shared.Services.Inventario
@using IngenIA365ERP.Shared.Services.Transporte
@inject ServiciosDeTransporteClient Api
@inject HttpClient Http
@inject CentralAuthClient Auth
@inject INotificationService Notification
@inject ConectoresClient Conectores

<PageTitle>Servicios por vehículo - IngenIA365ERP</PageTitle>

@* Feature 020 (US6; R9, R11; FR-028, FR-044, FR-056, FR-058, FR-059): los servicios que la cooperativa factura por vehículo (radio, app…).
   Cada uno es un producto de Comercial de clase servicio, con su prioridad (orden de líneas y de reparto de pagos), la línea de Cartera de
   su obligación (marcada de servicio, sin interés), los medios de pago a crédito para asociados y externos (que admitan pago parcial) y,
   si avisa a un sistema externo, su conector. Abajo, la política de facturación con vigencia y la plantilla de suscripciones. *@
<PermissionGate AnyOf="@(new[] { "Transport.Services.View", "Transport.ServiceSetup.Manage" })" Required="" MostrarAviso="true">
<div class="pagina">
    <div class="page-header">
        <h3>Servicios por vehículo</h3>
        <div class="toolbar">
            <PermissionGate Required="Transport.ServiceSetup.Manage">
                <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@(() => Abrir(null))">Nuevo servicio</SfButton>
            </PermissionGate>
        </div>
    </div>

    @if (_aviso is not null)
    {
        <div class="aviso aviso-alerta"><p>@_aviso</p></div>
    }

    <IndicadorDeCarga Cargando="@(_carga.Activa || _guardado.Activa)" Texto="@(_guardado.Activa ? "Guardando…" : "Cargando…")">
        @if (_servicios.Count == 0)
        {
            <p class="texto-tenue">No hay servicios configurados.</p>
        }
        else
        {
            <table class="data-grid">
                <thead><tr><th>Prioridad</th><th>Servicio</th><th>Línea de Cartera</th><th>Crédito asociados</th><th>Crédito externos</th><th>Conector</th><th>Estado</th><th></th></tr></thead>
                <tbody>
                    @foreach (var s in _servicios)
                    {
                        <tr>
                            <td>@s.Priority</td><td>@s.Name (@s.ProductCode)</td><td>@s.CreditLineCode</td><td>@s.AssociateCreditMeansCode</td><td>@s.CustomerCreditMeansCode</td>
                            <td>@(s.ConnectorName ?? "No avisa")</td><td>@(s.IsActive ? "Activo" : "Inactivo")</td>
                            <td><PermissionGate Required="Transport.ServiceSetup.Manage"><SfButton CssClass="e-flat" OnClick="@(() => Abrir(s))">Editar</SfButton></PermissionGate></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </IndicadorDeCarga>

    <div class="info-card">
        <h4>Política de facturación</h4>
        <IndicadorDeCarga Cargando="@_carga.Activa">
            <table class="data-grid">
                <thead><tr><th>Desde</th><th>Hasta</th><th>Cobro a mitad de mes</th><th>Tipo de documento</th><th>Bodega</th><th>Día de vencimiento</th></tr></thead>
                <tbody>
                    @foreach (var p in _politicas)
                    {
                        <tr>
                            <td>@p.ValidFrom.ToString("dd/MM/yyyy")</td><td>@p.ValidTo?.ToString("dd/MM/yyyy")</td><td>@(p.Proration == 2 ? "Proporcional a los días" : "Mes completo")</td>
                            <td>@p.SalesDocumentTypeCode</td><td>@p.WarehouseCode</td><td>@(p.DueDay == 0 ? "Último del mes" : p.DueDay.ToString())</td>
                        </tr>
                    }
                </tbody>
            </table>
            <PermissionGate Required="Transport.ServiceSetup.Manage">
                <div class="form-grid">
                    <label class="campo">Desde <input type="date" class="e-input" value="@_p.ValidFrom.ToString("yyyy-MM-dd")" @onchange="@(e => _p.ValidFrom = DateOnly.TryParse(e.Value?.ToString(), out var f) ? f : _p.ValidFrom)" /></label>
                    <label class="campo">Cobro a mitad de mes
                        <select class="e-input" @bind="_p.Proration"><option value="1">Mes completo</option><option value="2">Proporcional a los días</option></select>
                    </label>
                    <label class="campo">Tipo de documento de venta * <input class="e-input" @bind="_p.SalesDocumentTypeCode" maxlength="10" /></label>
                    <label class="campo">Bodega * <input class="e-input" @bind="_p.WarehouseCode" maxlength="10" /></label>
                    <label class="campo">Día de vencimiento (0 = último) <input type="number" class="e-input" @bind="_p.DueDay" min="0" max="28" /></label>
                </div>
                <div class="toolbar"><SfButton CssClass="e-outline" Disabled="@(_guardado.Activa || string.IsNullOrWhiteSpace(_p.SalesDocumentTypeCode))" OnClick="@GuardarPoliticaAsync">Guardar política</SfButton></div>
            </PermissionGate>
        </IndicadorDeCarga>
    </div>

    <PermissionGate Required="Transport.Services.Manage">
        <div class="info-card">
            <h4>Suscripciones en lote</h4>
            <p>Cada fila lleva la placa, el código del producto, la fecha de inicio y, si se pactó, el precio mensual con impuestos.</p>
            <ImportarPlantilla RutaBase="@ServiciosDeTransporteClient.RutaDeSuscripciones" ConDatos="false" PreguntaSiExiste="Si la suscripción ya existe"
                               PermisoDeDescarga="Transport.Services.View" PermisoDeImportacion="Transport.Services.Manage" />
        </div>
    </PermissionGate>
</div>

<SfDialog @bind-Visible="_mostrar" Header="@(_editando is null ? "Nuevo servicio" : "Editar servicio")" Width="640px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@_guardado.Activa" Texto="Guardando…">
                <div class="form-grid">
                    @if (_editando is null)
                    {
                        <label class="campo">Código del producto * <input class="e-input" @bind="_producto" maxlength="30" placeholder="El código en Comercial" /></label>
                    }
                    else
                    {
                        <label class="campo">Producto <input class="e-input" value="@($"{_editando.ProductCode} · {_editando.Name}")" disabled /></label>
                    }
                    <label class="campo">Prioridad (1 = primero) <input type="number" class="e-input" @bind="_s.Priority" min="1" max="99" /></label>
                    <label class="campo">Línea de Cartera <input class="e-input" @bind="_s.CreditLineCode" maxlength="10" /></label>
                    <label class="campo">Medio a crédito para asociados <input class="e-input" @bind="_s.AssociateCreditMeansCode" maxlength="10" /></label>
                    <label class="campo">Medio a crédito para externos <input class="e-input" @bind="_s.CustomerCreditMeansCode" maxlength="10" /></label>
                    <label class="campo">Conector que avisa al sistema externo
                        <select class="e-input" value="@(_s.ConnectorPublicId?.ToString() ?? "")" @onchange="@(e => _s.ConnectorPublicId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null)">
                            <option value="">No avisa</option>
                            @if (_editando?.ConnectorPublicId is { } actual && _conectores.All(x => x.PublicId != actual))
                            {
                                <option value="@actual">@_editando.ConnectorName (ya no está habilitado)</option>
                            }
                            @foreach (var c in _conectores)
                            {
                                <option value="@c.PublicId">@c.Name (@c.Code)</option>
                            }
                        </select>
                    </label>
                    <label class="campo-check"><input type="checkbox" @bind="_s.IsActive" /> Activo</label>
                </div>
                @if (_conectores.Count == 0)
                {
                    <p class="texto-apoyo">No hay conectores habilitados para la cooperativa: los habilita el administrador de la plataforma y sus credenciales se ponen en Administración › Conectores externos.</p>
                }
                else
                {
                    <p class="texto-apoyo">Cuando la línea del servicio queda pagada, el conector avisa al sistema externo por el valor de la línea.</p>
                }
                <div class="toolbar">
                    <SfButton CssClass="e-primary" Disabled="@_guardado.Activa" OnClick="@GuardarAsync">Guardar</SfButton>
                    <SfButton CssClass="e-outline" OnClick="@(() => _mostrar = false)">Cancelar</SfButton>
                </div>
            </IndicadorDeCarga>
        </Content>
    </DialogTemplates>
</SfDialog>
</PermissionGate>

@code {
    private sealed record CodigoEncontrado(bool Existe, Guid? PublicId, string? Nombre);

    private readonly EstadoDeCarga _carga = new(), _guardado = new();
    private List<ServicioDeTransporteDto> _servicios = [];
    private List<PoliticaDeFacturacionDto> _politicas = [];
    private List<ConectorDeLaCooperativaDto> _conectores = [];
    private ServicioEntradaDto _s = new();
    private PoliticaEntradaDto _p = new();
    private ServicioDeTransporteDto? _editando;
    private string? _producto, _aviso;
    private bool _mostrar;

    protected override Task OnInitializedAsync() => CargarAsync();

    private async Task CargarAsync()
    {
        using var carga = _carga.Iniciar();
        var s = await Api.ServiciosAsync(incluirInactivos: true);
        _servicios = s.IsSuccess ? [.. s.Value ?? []] : [];
        var p = await Api.PoliticasAsync();
        _politicas = p.IsSuccess ? [.. p.Value ?? []] : [];
        // Sin Core.Connectors.View la lista falla y el selector sólo ofrece «No avisa»: ligar exige ver el conector.
        var c = await Conectores.ListarAsync();
        _conectores = c.IsSuccess ? [.. c.Value ?? []] : [];
        var previa = await Api.VistaPreviaAsync(DateTime.Today.ToString("yyyyMM"));
        _aviso = previa.IsSuccess ? previa.Value?.Warning : null;
    }

    private void Abrir(ServicioDeTransporteDto? s)
    {
        _editando = s;
        _producto = null;
        _s = s is null ? new ServicioEntradaDto() : new ServicioEntradaDto
        {
            ProductPublicId = s.ProductPublicId, Priority = s.Priority, CreditLineCode = s.CreditLineCode, AssociateCreditMeansCode = s.AssociateCreditMeansCode,
            CustomerCreditMeansCode = s.CustomerCreditMeansCode, ConnectorPublicId = s.ConnectorPublicId, IsActive = s.IsActive,
        };
        _mostrar = true;
    }

    private async Task GuardarAsync()
    {
        using (_guardado.Iniciar())
        {
            if (_editando is null)
            {
                if (string.IsNullOrWhiteSpace(_producto)) { await Notification.WarningAsync("Indique el código del producto."); return; }
                var hallado = await IngenIA365ERP.Shared.Services.Ventas.EnvioDeVentas.EnviarAsync<CodigoEncontrado>(Http, Auth, HttpMethod.Get,
                    $"/api/catalogos/productos/codigo/{Uri.EscapeDataString(_producto.Trim())}", null, null, default);
                if (!hallado.IsSuccess || hallado.Value is not { Existe: true, PublicId: { } id }) { await Notification.WarningAsync($"No existe el producto {_producto}."); return; }
                _s.ProductPublicId = id;
            }
            var r = _editando is null ? await Api.CrearServicioAsync(_s) : await Api.CambiarServicioAsync(_editando.PublicId, _s);
            if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo guardar el servicio."); return; }
            _mostrar = false;
        }
        await CargarAsync();
    }

    private async Task GuardarPoliticaAsync()
    {
        using (_guardado.Iniciar())
        {
            var r = await Api.PonerPoliticaAsync(_p);
            if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo guardar la política."); return; }
            await Notification.SuccessAsync("Política guardada.");
        }
        await CargarAsync();
    }
}
