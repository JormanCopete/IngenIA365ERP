@page "/home"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IFormFactor FormFactor

<PageTitle>Home - IngenIA365ERP</PageTitle>

<div class="pagina">
    <div class="page-header">
        <h1>IngenIA365ERP</h1>
    </div>

    <p>ERP Financiero para Cooperativas Colombianas.</p>
    <p class="muted">Ejecutando en <em>@factor</em> usando <em>@platform</em>.</p>
</div>

@code {
    private string factor => FormFactor.GetFormFactor();
    private string platform => FormFactor.GetPlatform();
}
