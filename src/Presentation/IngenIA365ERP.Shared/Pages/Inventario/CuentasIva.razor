@page "/inventario/cuentas-iva"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification

<PageTitle>Cuentas IVA - IngenIA365ERP</PageTitle>

<div class="page-header">
    <h3>Cuentas IVA</h3>
    <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@OpenCreate">Nuevo</SfButton>
</div>

<SfGrid @ref="_grid" TValue="VatAccountItem" DataSource="@_items"
    AllowPaging="true" AllowSorting="true" AllowFiltering="true">
    <GridColumns>
        <GridColumn Field="ProductGroupId" HeaderText="Grupo" Width="100" TextAlign="TextAlign.Right" />
        <GridColumn Field="TransactionTypeId" HeaderText="Tipo Movto" Width="100" TextAlign="TextAlign.Right" />
        <GridColumn Field="WarehouseId" HeaderText="Bodega" Width="100" TextAlign="TextAlign.Right" />
        <GridColumn Field="LocationId" HeaderText="Ubicacion" Width="100" TextAlign="TextAlign.Right" />
        <GridColumn Field="VatRate" HeaderText="Tasa IVA" Width="100" Format="N3" TextAlign="TextAlign.Right" />
        <GridColumn Field="AccountType" HeaderText="Tipo" Width="80" />
        <GridColumn Field="AccountCode" HeaderText="Cuenta" Width="130" />
        <GridColumn HeaderText="Acciones" Width="150" TextAlign="TextAlign.Center">
            <Template>
                @{
                    var item = context as VatAccountItem;
                    <SfButton CssClass="e-flat e-small" IconCss="e-icons e-edit" OnClick="@(() => OpenEdit(item!))" />
                    <SfButton CssClass="e-flat e-small e-danger" IconCss="e-icons e-trash" OnClick="@(() => OpenDelete(item!))" />
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

<SfDialog @bind-Visible="_showDialog" Header="@_dialogTitle" Width="500px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <div style="padding:10px;display:flex;flex-direction:column;gap:16px;">
                <div>
                    <label>Grupo de Producto *</label>
                    <SfNumericTextBox TValue="int" @bind-Value="_model.ProductGroupId" Placeholder="Id grupo" Min="0" />
                </div>
                <div>
                    <label>Tipo de Movimiento *</label>
                    <SfNumericTextBox TValue="int" @bind-Value="_model.TransactionTypeId" Placeholder="Id tipo movimiento" Min="0" />
                </div>
                <div>
                    <label>Bodega *</label>
                    <SfNumericTextBox TValue="int" @bind-Value="_model.WarehouseId" Placeholder="Id bodega" Min="0" />
                </div>
                <div>
                    <label>Ubicacion *</label>
                    <SfNumericTextBox TValue="int" @bind-Value="_model.LocationId" Placeholder="Id ubicacion" Min="0" />
                </div>
                <div>
                    <label>Tasa IVA (%) *</label>
                    <SfNumericTextBox TValue="decimal" @bind-Value="_model.VatRate" Placeholder="0.000" Decimals="3" Format="N3" Min="0" Max="100" />
                </div>
                <div>
                    <label>Tipo Cuenta</label>
                    <SfTextBox @bind-Value="_model.AccountType" Placeholder="Tipo de cuenta" />
                </div>
                <div>
                    <label>Cuenta Contable</label>
                    <SfTextBox @bind-Value="_model.AccountCode" Placeholder="Codigo cuenta contable" />
                </div>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _showDialog = false)" />
        <DialogButton Content="Guardar" IsPrimary="true" OnClick="@Save" />
    </DialogButtons>
</SfDialog>

<ConfirmDialog @bind-Visible="_showConfirm" OnConfirm="ConfirmDelete"
    Message="Esta seguro de eliminar este registro?" />

@code {
    private SfGrid<VatAccountItem>? _grid;
    private List<VatAccountItem> _items = [];
    private VatAccountModel _model = new();
    private Guid? _editId;
    private bool _showDialog, _showConfirm;
    private string _dialogTitle = "";
    private Guid _deleteId;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        try { _items = await Http.GetFromJsonAsync<List<VatAccountItem>>("/api/inventory/vat-accounts?pageSize=500") ?? []; }
        catch { _items = []; }
    }

    private void OpenCreate() { _model = new(); _editId = null; _dialogTitle = "Nueva Cuenta IVA"; _showDialog = true; }

    private void OpenEdit(VatAccountItem item)
    {
        _model = new()
        {
            ProductGroupId = item.ProductGroupId,
            TransactionTypeId = item.TransactionTypeId,
            WarehouseId = item.WarehouseId,
            LocationId = item.LocationId,
            VatRate = item.VatRate,
            AccountType = item.AccountType,
            AccountCode = item.AccountCode
        };
        _editId = item.PublicId;
        _dialogTitle = "Editar Cuenta IVA";
        _showDialog = true;
    }

    private void OpenDelete(VatAccountItem item) { _deleteId = item.PublicId; _showConfirm = true; }

    private async Task Save()
    {
        HttpResponseMessage res;
        if (_editId.HasValue)
            res = await Http.PutAsJsonAsync($"/api/inventory/vat-accounts/{_editId}", _model);
        else
            res = await Http.PostAsJsonAsync("/api/inventory/vat-accounts", _model);

        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro guardado");
            _showDialog = false;
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al guardar");
    }

    private async Task ConfirmDelete()
    {
        var res = await Http.DeleteAsync($"/api/inventory/vat-accounts/{_deleteId}");
        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro eliminado");
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al eliminar");
    }

    private class VatAccountItem
    {
        public Guid PublicId { get; set; }
        public int ProductGroupId { get; set; }
        public int TransactionTypeId { get; set; }
        public int WarehouseId { get; set; }
        public int LocationId { get; set; }
        public decimal VatRate { get; set; }
        public string? AccountType { get; set; }
        public string? AccountCode { get; set; }
    }

    private class VatAccountModel
    {
        public int ProductGroupId { get; set; }
        public int TransactionTypeId { get; set; }
        public int WarehouseId { get; set; }
        public int LocationId { get; set; }
        public decimal VatRate { get; set; }
        public string? AccountType { get; set; }
        public string? AccountCode { get; set; }
    }
}
