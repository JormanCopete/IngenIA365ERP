@page "/inventario/grupos-secundarios"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification

<PageTitle>Grupos Secundarios - IngenIA365ERP</PageTitle>

<div class="page-header">
    <h3>Grupos Secundarios</h3>
    <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@OpenCreate">Nuevo</SfButton>
</div>

<SfGrid @ref="_grid" TValue="SecondaryGroupItem" DataSource="@_items"
    AllowPaging="true" AllowSorting="true" AllowFiltering="true">
    <GridColumns>
        <GridColumn Field="GroupCode" HeaderText="Codigo" Width="120" TextAlign="TextAlign.Right" />
        <GridColumn Field="Name" HeaderText="Nombre" Width="300" />
        <GridColumn Field="ShortName" HeaderText="Resumido" Width="200" />
        <GridColumn HeaderText="Acciones" Width="150" TextAlign="TextAlign.Center">
            <Template>
                @{
                    var item = context as SecondaryGroupItem;
                    <SfButton CssClass="e-flat e-small" IconCss="e-icons e-edit" OnClick="@(() => OpenEdit(item!))" />
                    <SfButton CssClass="e-flat e-small e-danger" IconCss="e-icons e-trash" OnClick="@(() => OpenDelete(item!))" />
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

<SfDialog @bind-Visible="_showDialog" Header="@_dialogTitle" Width="450px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <div style="padding:10px;display:flex;flex-direction:column;gap:16px;">
                <div>
                    <label>Codigo *</label>
                    <SfNumericTextBox TValue="int" @bind-Value="_model.GroupCode" Placeholder="Codigo grupo" Min="0" />
                </div>
                <div>
                    <label>Nombre *</label>
                    <SfTextBox @bind-Value="_model.Name" Placeholder="Nombre del grupo secundario" />
                </div>
                <div>
                    <label>Resumido</label>
                    <SfTextBox @bind-Value="_model.ShortName" Placeholder="Nombre corto" />
                </div>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _showDialog = false)" />
        <DialogButton Content="Guardar" IsPrimary="true" OnClick="@Save" />
    </DialogButtons>
</SfDialog>

<ConfirmDialog @bind-Visible="_showConfirm" OnConfirm="ConfirmDelete"
    Message="Esta seguro de eliminar este registro?" />

@code {
    private SfGrid<SecondaryGroupItem>? _grid;
    private List<SecondaryGroupItem> _items = [];
    private SecondaryGroupModel _model = new();
    private Guid? _editId;
    private bool _showDialog, _showConfirm;
    private string _dialogTitle = "";
    private Guid _deleteId;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        try { _items = await Http.GetListAsync<SecondaryGroupItem>("/api/inventory/secondary-groups?pageSize=500") ?? []; }
        catch { _items = []; }
    }

    private void OpenCreate() { _model = new(); _editId = null; _dialogTitle = "Nuevo Grupo Secundario"; _showDialog = true; }

    private void OpenEdit(SecondaryGroupItem item)
    {
        _model = new() { GroupCode = item.GroupCode, Name = item.Name, ShortName = item.ShortName };
        _editId = item.PublicId;
        _dialogTitle = "Editar Grupo Secundario";
        _showDialog = true;
    }

    private void OpenDelete(SecondaryGroupItem item) { _deleteId = item.PublicId; _showConfirm = true; }

    private async Task Save()
    {
        HttpResponseMessage res;
        if (_editId.HasValue)
            res = await Http.PutAsJsonAsync($"/api/inventory/secondary-groups/{_editId}", _model);
        else
            res = await Http.PostAsJsonAsync("/api/inventory/secondary-groups", _model);

        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro guardado");
            _showDialog = false;
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al guardar");
    }

    private async Task ConfirmDelete()
    {
        var res = await Http.DeleteAsync($"/api/inventory/secondary-groups/{_deleteId}");
        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro eliminado");
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al eliminar");
    }

    private class SecondaryGroupItem
    {
        public Guid PublicId { get; set; }
        public int GroupCode { get; set; }
        public string Name { get; set; } = "";
        public string? ShortName { get; set; }
    }

    private class SecondaryGroupModel
    {
        public int GroupCode { get; set; }
        public string Name { get; set; } = "";
        public string? ShortName { get; set; }
    }
}
