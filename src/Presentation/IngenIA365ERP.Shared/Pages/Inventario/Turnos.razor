@page "/inventario/turnos"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification

<PageTitle>Turnos - IngenIA365ERP</PageTitle>

<div class="pagina">
    <div class="page-header">
        <h3>Turnos</h3>
        <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@OpenCreate">Nuevo</SfButton>
    </div>

    <SfGrid @ref="_grid" TValue="ShiftItem" DataSource="@_items"
        AllowPaging="true" AllowSorting="true" AllowFiltering="true">
        <GridColumns>
            <GridColumn Field="ShiftCode" HeaderText="Codigo" Width="120" TextAlign="TextAlign.Right" />
            <GridColumn Field="Name" HeaderText="Nombre" Width="300" />
            <GridColumn Field="StartTime" HeaderText="Hora Inicio" Width="120" />
            <GridColumn Field="EndTime" HeaderText="Hora Fin" Width="120" />
            <GridColumn HeaderText="Acciones" Width="150" TextAlign="TextAlign.Center">
                <Template>
                    @{
                        var item = context as ShiftItem;
                        <SfButton CssClass="e-flat e-small" IconCss="e-icons e-edit" OnClick="@(() => OpenEdit(item!))" />
                        <SfButton CssClass="e-flat e-small e-danger" IconCss="e-icons e-trash" OnClick="@(() => OpenDelete(item!))" />
                    }
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
</div>

<SfDialog @bind-Visible="_showDialog" Header="@_dialogTitle" Width="450px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <div class="pagina">
                <div>
                    <label>Codigo *</label>
                    <SfNumericTextBox TValue="int" @bind-Value="_model.ShiftCode" Placeholder="Codigo turno" Min="0" />
                </div>
                <div>
                    <label>Nombre *</label>
                    <SfTextBox @bind-Value="_model.Name" Placeholder="Nombre del turno" />
                </div>
                <div>
                    <label>Hora Inicio</label>
                    <SfTextBox @bind-Value="_model.StartTime" Placeholder="Ej: 08:00" />
                </div>
                <div>
                    <label>Hora Fin</label>
                    <SfTextBox @bind-Value="_model.EndTime" Placeholder="Ej: 17:00" />
                </div>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _showDialog = false)" />
        <DialogButton Content="Guardar" IsPrimary="true" OnClick="@Save" />
    </DialogButtons>
</SfDialog>

<ConfirmDialog @bind-Visible="_showConfirm" OnConfirm="ConfirmDelete"
    Message="Esta seguro de eliminar este registro?" />

@code {
    private SfGrid<ShiftItem>? _grid;
    private List<ShiftItem> _items = [];
    private ShiftModel _model = new();
    private Guid? _editId;
    private bool _showDialog, _showConfirm;
    private string _dialogTitle = "";
    private Guid _deleteId;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        try { _items = await Http.GetListAsync<ShiftItem>("/api/inventory/shifts?pageSize=500") ?? []; }
        catch { _items = []; }
    }

    private void OpenCreate() { _model = new(); _editId = null; _dialogTitle = "Nuevo Turno"; _showDialog = true; }

    private void OpenEdit(ShiftItem item)
    {
        _model = new() { ShiftCode = item.ShiftCode, Name = item.Name, StartTime = item.StartTime, EndTime = item.EndTime };
        _editId = item.PublicId;
        _dialogTitle = "Editar Turno";
        _showDialog = true;
    }

    private void OpenDelete(ShiftItem item) { _deleteId = item.PublicId; _showConfirm = true; }

    private async Task Save()
    {
        HttpResponseMessage res;
        if (_editId.HasValue)
            res = await Http.PutAsJsonAsync($"/api/inventory/shifts/{_editId}", _model);
        else
            res = await Http.PostAsJsonAsync("/api/inventory/shifts", _model);

        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro guardado");
            _showDialog = false;
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al guardar");
    }

    private async Task ConfirmDelete()
    {
        var res = await Http.DeleteAsync($"/api/inventory/shifts/{_deleteId}");
        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro eliminado");
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al eliminar");
    }

    private class ShiftItem
    {
        public Guid PublicId { get; set; }
        public int ShiftCode { get; set; }
        public string Name { get; set; } = "";
        public string? StartTime { get; set; }
        public string? EndTime { get; set; }
    }

    private class ShiftModel
    {
        public int ShiftCode { get; set; }
        public string Name { get; set; } = "";
        public string? StartTime { get; set; }
        public string? EndTime { get; set; }
    }
}
