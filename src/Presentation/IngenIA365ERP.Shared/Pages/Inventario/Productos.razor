@page "/inventario/productos"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification

<PageTitle>Productos - IngenIA365ERP</PageTitle>

<div class="pagina">
    <div class="page-header">
        <h3>Productos</h3>
        <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@OpenCreate">Nuevo</SfButton>
    </div>

    <SfGrid @ref="_grid" TValue="ProductItem" DataSource="@_items"
        AllowPaging="true" AllowSorting="true" AllowFiltering="true">
        <GridColumns>
            <GridColumn Field="ProductCode" HeaderText="Codigo" Width="100" TextAlign="TextAlign.Right" />
            <GridColumn Field="Name" HeaderText="Nombre" Width="250" />
            <GridColumn Field="ShortName" HeaderText="Resumido" Width="150" />
            <GridColumn Field="UnitOfMeasure" HeaderText="Medida" Width="80" />
            <GridColumn Field="CostPrice" HeaderText="Costo" Width="120" Format="N2" TextAlign="TextAlign.Right" />
            <GridColumn Field="SalePrice" HeaderText="Precio Venta" Width="120" Format="N2" TextAlign="TextAlign.Right" />
            <GridColumn Field="VatRate" HeaderText="% IVA" Width="80" Format="N3" TextAlign="TextAlign.Right" />
            <GridColumn Field="CurrentStock" HeaderText="Stock" Width="80" TextAlign="TextAlign.Right" />
            <GridColumn Field="IsActive" HeaderText="Activo" Width="80" DisplayAsCheckBox="true" />
            <GridColumn HeaderText="Acciones" Width="150" TextAlign="TextAlign.Center">
                <Template>
                    @{
                        var item = context as ProductItem;
                        <SfButton CssClass="e-flat e-small" IconCss="e-icons e-edit" OnClick="@(() => OpenEdit(item!))" />
                        <SfButton CssClass="e-flat e-small e-danger" IconCss="e-icons e-trash" OnClick="@(() => OpenDelete(item!))" />
                    }
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
</div>

<SfDialog @bind-Visible="_showDialog" Header="@_dialogTitle" Width="600px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <div class="pagina">
                <div>
                    <label>Codigo *</label>
                    <SfNumericTextBox TValue="int" @bind-Value="_model.ProductCode" Placeholder="Codigo producto" Min="0" />
                </div>
                <div>
                    <label>Nombre *</label>
                    <SfTextBox @bind-Value="_model.Name" Placeholder="Nombre del producto" />
                </div>
                <div>
                    <label>Resumido</label>
                    <SfTextBox @bind-Value="_model.ShortName" Placeholder="Nombre corto" />
                </div>
                <div>
                    <label>Unidad de Medida</label>
                    <SfTextBox @bind-Value="_model.UnitOfMeasure" Placeholder="Ej: UND, KG, LT" />
                </div>
                <div>
                    <label>Costo</label>
                    <SfNumericTextBox TValue="decimal" @bind-Value="_model.CostPrice" Placeholder="0.00" Decimals="2" Format="N2" Min="0" />
                </div>
                <div>
                    <label>Precio Venta</label>
                    <SfNumericTextBox TValue="decimal" @bind-Value="_model.SalePrice" Placeholder="0.00" Decimals="2" Format="N2" Min="0" />
                </div>
                <div>
                    <label>Tasa IVA (%)</label>
                    <SfNumericTextBox TValue="decimal" @bind-Value="_model.VatRate" Placeholder="0.000" Decimals="3" Format="N3" Min="0" Max="100" />
                </div>
                <div>
                    <label>Codigo de Barras</label>
                    <SfTextBox @bind-Value="_model.Barcode" Placeholder="Codigo de barras" />
                </div>
                <div>
                    <label>Stock Minimo</label>
                    <SfNumericTextBox TValue="int" @bind-Value="_model.MinStock" Placeholder="0" Min="0" />
                </div>
                <div>
                    <label>Stock Maximo</label>
                    <SfNumericTextBox TValue="int" @bind-Value="_model.MaxStock" Placeholder="0" Min="0" />
                </div>
                <div>
                    <SfCheckBox @bind-Checked="_model.IsActive" Label="Activo" />
                </div>
                <div>
                    <SfCheckBox @bind-Checked="_model.ControlsStock" Label="Controla Existencias" />
                </div>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _showDialog = false)" />
        <DialogButton Content="Guardar" IsPrimary="true" OnClick="@Save" />
    </DialogButtons>
</SfDialog>

<ConfirmDialog @bind-Visible="_showConfirm" OnConfirm="ConfirmDelete"
    Message="Esta seguro de eliminar este registro?" />

@code {
    private SfGrid<ProductItem>? _grid;
    private List<ProductItem> _items = [];
    private ProductModel _model = new();
    private Guid? _editId;
    private bool _showDialog, _showConfirm;
    private string _dialogTitle = "";
    private Guid _deleteId;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        try { _items = await Http.GetListAsync<ProductItem>("/api/inventory/products?pageSize=500") ?? []; }
        catch { _items = []; }
    }

    private void OpenCreate() { _model = new() { IsActive = true }; _editId = null; _dialogTitle = "Nuevo Producto"; _showDialog = true; }

    private void OpenEdit(ProductItem item)
    {
        _model = new()
        {
            ProductCode = item.ProductCode,
            Name = item.Name,
            ShortName = item.ShortName,
            UnitOfMeasure = item.UnitOfMeasure,
            CostPrice = item.CostPrice,
            SalePrice = item.SalePrice,
            VatRate = item.VatRate,
            Barcode = item.Barcode,
            MinStock = item.MinStock,
            MaxStock = item.MaxStock,
            IsActive = item.IsActive,
            ControlsStock = item.ControlsStock
        };
        _editId = item.PublicId;
        _dialogTitle = "Editar Producto";
        _showDialog = true;
    }

    private void OpenDelete(ProductItem item) { _deleteId = item.PublicId; _showConfirm = true; }

    private async Task Save()
    {
        HttpResponseMessage res;
        if (_editId.HasValue)
            res = await Http.PutAsJsonAsync($"/api/inventory/products/{_editId}", _model);
        else
            res = await Http.PostAsJsonAsync("/api/inventory/products", _model);

        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro guardado");
            _showDialog = false;
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al guardar");
    }

    private async Task ConfirmDelete()
    {
        var res = await Http.DeleteAsync($"/api/inventory/products/{_deleteId}");
        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro eliminado");
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al eliminar");
    }

    private class ProductItem
    {
        public Guid PublicId { get; set; }
        public int ProductCode { get; set; }
        public string Name { get; set; } = "";
        public string? ShortName { get; set; }
        public string? UnitOfMeasure { get; set; }
        public decimal CostPrice { get; set; }
        public decimal SalePrice { get; set; }
        public decimal VatRate { get; set; }
        public int CurrentStock { get; set; }
        public bool IsActive { get; set; }
        public string? Barcode { get; set; }
        public int MinStock { get; set; }
        public int MaxStock { get; set; }
        public bool ControlsStock { get; set; }
    }

    private class ProductModel
    {
        public int ProductCode { get; set; }
        public string Name { get; set; } = "";
        public string? ShortName { get; set; }
        public string? UnitOfMeasure { get; set; }
        public decimal CostPrice { get; set; }
        public decimal SalePrice { get; set; }
        public decimal VatRate { get; set; }
        public string? Barcode { get; set; }
        public int MinStock { get; set; }
        public int MaxStock { get; set; }
        public bool IsActive { get; set; } = true;
        public bool ControlsStock { get; set; }
    }
}
