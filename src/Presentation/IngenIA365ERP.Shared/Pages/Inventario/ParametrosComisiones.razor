@page "/inventario/parametros-comisiones"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification

<PageTitle>Parametros de Comisiones - IngenIA365ERP</PageTitle>

<div class="page-header">
    <h3>Parametros de Comisiones</h3>
    <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@OpenCreate">Nuevo</SfButton>
</div>

<SfGrid @ref="_grid" TValue="CommissionParamItem" DataSource="@_items"
    AllowPaging="true" AllowSorting="true" AllowFiltering="true">
    <GridColumns>
        <GridColumn Field="InvoiceTypeId" HeaderText="Tipo Factura" Width="120" TextAlign="TextAlign.Right" />
        <GridColumn Field="CommissionGroupId" HeaderText="Grupo Comision" Width="130" TextAlign="TextAlign.Right" />
        <GridColumn Field="GroupId" HeaderText="Grupo" Width="100" TextAlign="TextAlign.Right" />
        <GridColumn Field="SalesRangeStart" HeaderText="Rango Inicio" Width="130" Format="N2" TextAlign="TextAlign.Right" />
        <GridColumn Field="SalesRangeEnd" HeaderText="Rango Fin" Width="130" Format="N2" TextAlign="TextAlign.Right" />
        <GridColumn Field="CommissionRate" HeaderText="% Comision" Width="120" Format="N3" TextAlign="TextAlign.Right" />
        <GridColumn HeaderText="Acciones" Width="150" TextAlign="TextAlign.Center">
            <Template>
                @{
                    var item = context as CommissionParamItem;
                    <SfButton CssClass="e-flat e-small" IconCss="e-icons e-edit" OnClick="@(() => OpenEdit(item!))" />
                    <SfButton CssClass="e-flat e-small e-danger" IconCss="e-icons e-trash" OnClick="@(() => OpenDelete(item!))" />
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

<SfDialog @bind-Visible="_showDialog" Header="@_dialogTitle" Width="500px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <div style="padding:10px;display:flex;flex-direction:column;gap:16px;">
                <div>
                    <label>Tipo de Factura *</label>
                    <SfNumericTextBox TValue="int" @bind-Value="_model.InvoiceTypeId" Placeholder="Id tipo factura" Min="0" />
                </div>
                <div>
                    <label>Grupo de Comision *</label>
                    <SfNumericTextBox TValue="int" @bind-Value="_model.CommissionGroupId" Placeholder="Id grupo comision" Min="0" />
                </div>
                <div>
                    <label>Grupo *</label>
                    <SfNumericTextBox TValue="int" @bind-Value="_model.GroupId" Placeholder="Id grupo" Min="0" />
                </div>
                <div>
                    <label>Rango Ventas Inicio</label>
                    <SfNumericTextBox TValue="decimal" @bind-Value="_model.SalesRangeStart" Placeholder="0.00" Decimals="2" Format="N2" Min="0" />
                </div>
                <div>
                    <label>Rango Ventas Fin</label>
                    <SfNumericTextBox TValue="decimal" @bind-Value="_model.SalesRangeEnd" Placeholder="0.00" Decimals="2" Format="N2" Min="0" />
                </div>
                <div>
                    <label>Tasa Comision (%)</label>
                    <SfNumericTextBox TValue="decimal" @bind-Value="_model.CommissionRate" Placeholder="0.000" Decimals="3" Format="N3" Min="0" Max="100" />
                </div>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _showDialog = false)" />
        <DialogButton Content="Guardar" IsPrimary="true" OnClick="@Save" />
    </DialogButtons>
</SfDialog>

<ConfirmDialog @bind-Visible="_showConfirm" OnConfirm="ConfirmDelete"
    Message="Esta seguro de eliminar este registro?" />

@code {
    private SfGrid<CommissionParamItem>? _grid;
    private List<CommissionParamItem> _items = [];
    private CommissionParamModel _model = new();
    private Guid? _editId;
    private bool _showDialog, _showConfirm;
    private string _dialogTitle = "";
    private Guid _deleteId;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        try { _items = await Http.GetFromJsonAsync<List<CommissionParamItem>>("/api/inventory/commission-parameters?pageSize=500") ?? []; }
        catch { _items = []; }
    }

    private void OpenCreate() { _model = new(); _editId = null; _dialogTitle = "Nuevo Parametro de Comision"; _showDialog = true; }

    private void OpenEdit(CommissionParamItem item)
    {
        _model = new()
        {
            InvoiceTypeId = item.InvoiceTypeId,
            CommissionGroupId = item.CommissionGroupId,
            GroupId = item.GroupId,
            SalesRangeStart = item.SalesRangeStart,
            SalesRangeEnd = item.SalesRangeEnd,
            CommissionRate = item.CommissionRate
        };
        _editId = item.PublicId;
        _dialogTitle = "Editar Parametro de Comision";
        _showDialog = true;
    }

    private void OpenDelete(CommissionParamItem item) { _deleteId = item.PublicId; _showConfirm = true; }

    private async Task Save()
    {
        HttpResponseMessage res;
        if (_editId.HasValue)
            res = await Http.PutAsJsonAsync($"/api/inventory/commission-parameters/{_editId}", _model);
        else
            res = await Http.PostAsJsonAsync("/api/inventory/commission-parameters", _model);

        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro guardado");
            _showDialog = false;
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al guardar");
    }

    private async Task ConfirmDelete()
    {
        var res = await Http.DeleteAsync($"/api/inventory/commission-parameters/{_deleteId}");
        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro eliminado");
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al eliminar");
    }

    private class CommissionParamItem
    {
        public Guid PublicId { get; set; }
        public int InvoiceTypeId { get; set; }
        public int CommissionGroupId { get; set; }
        public int GroupId { get; set; }
        public decimal SalesRangeStart { get; set; }
        public decimal SalesRangeEnd { get; set; }
        public decimal CommissionRate { get; set; }
    }

    private class CommissionParamModel
    {
        public int InvoiceTypeId { get; set; }
        public int CommissionGroupId { get; set; }
        public int GroupId { get; set; }
        public decimal SalesRangeStart { get; set; }
        public decimal SalesRangeEnd { get; set; }
        public decimal CommissionRate { get; set; }
    }
}
