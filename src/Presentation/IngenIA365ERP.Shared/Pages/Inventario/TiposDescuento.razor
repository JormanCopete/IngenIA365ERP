@page "/inventario/tipos-descuento"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification

<PageTitle>Tipos de Descuento - IngenIA365ERP</PageTitle>

<div class="pagina">
    <div class="page-header">
        <h3>Tipos de Descuento</h3>
        <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@OpenCreate">Nuevo</SfButton>
    </div>

    <SfGrid @ref="_grid" TValue="DiscountTypeItem" DataSource="@_items"
        AllowPaging="true" AllowSorting="true" AllowFiltering="true">
        <GridColumns>
            <GridColumn Field="TypeCode" HeaderText="Codigo" Width="120" TextAlign="TextAlign.Right" />
            <GridColumn Field="Name" HeaderText="Nombre" Width="300" />
            <GridColumn Field="ShortName" HeaderText="Resumido" Width="200" />
            <GridColumn Field="DiscountClass" HeaderText="Clase" Width="100" TextAlign="TextAlign.Right" />
            <GridColumn HeaderText="Acciones" Width="150" TextAlign="TextAlign.Center">
                <Template>
                    @{
                        var item = context as DiscountTypeItem;
                        <SfButton CssClass="e-flat e-small" IconCss="e-icons e-edit" OnClick="@(() => OpenEdit(item!))" />
                        <SfButton CssClass="e-flat e-small e-danger" IconCss="e-icons e-trash" OnClick="@(() => OpenDelete(item!))" />
                    }
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
</div>

<SfDialog @bind-Visible="_showDialog" Header="@_dialogTitle" Width="450px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <div class="pagina">
                <div>
                    <label>Codigo *</label>
                    <SfNumericTextBox TValue="int" @bind-Value="_model.TypeCode" Placeholder="Codigo tipo" Min="0" />
                </div>
                <div>
                    <label>Nombre *</label>
                    <SfTextBox @bind-Value="_model.Name" Placeholder="Nombre del tipo de descuento" />
                </div>
                <div>
                    <label>Resumido</label>
                    <SfTextBox @bind-Value="_model.ShortName" Placeholder="Nombre corto" />
                </div>
                <div>
                    <label>Clase de Descuento</label>
                    <SfNumericTextBox TValue="int?" @bind-Value="_model.DiscountClass" Placeholder="Clase" Min="0" />
                </div>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _showDialog = false)" />
        <DialogButton Content="Guardar" IsPrimary="true" OnClick="@Save" />
    </DialogButtons>
</SfDialog>

<ConfirmDialog @bind-Visible="_showConfirm" OnConfirm="ConfirmDelete"
    Message="Esta seguro de eliminar este registro?" />

@code {
    private SfGrid<DiscountTypeItem>? _grid;
    private List<DiscountTypeItem> _items = [];
    private DiscountTypeModel _model = new();
    private Guid? _editId;
    private bool _showDialog, _showConfirm;
    private string _dialogTitle = "";
    private Guid _deleteId;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        try { _items = await Http.GetListAsync<DiscountTypeItem>("/api/inventory/discount-types?pageSize=500") ?? []; }
        catch { _items = []; }
    }

    private void OpenCreate() { _model = new(); _editId = null; _dialogTitle = "Nuevo Tipo de Descuento"; _showDialog = true; }

    private void OpenEdit(DiscountTypeItem item)
    {
        _model = new() { TypeCode = item.TypeCode, Name = item.Name, ShortName = item.ShortName, DiscountClass = item.DiscountClass };
        _editId = item.PublicId;
        _dialogTitle = "Editar Tipo de Descuento";
        _showDialog = true;
    }

    private void OpenDelete(DiscountTypeItem item) { _deleteId = item.PublicId; _showConfirm = true; }

    private async Task Save()
    {
        HttpResponseMessage res;
        if (_editId.HasValue)
            res = await Http.PutAsJsonAsync($"/api/inventory/discount-types/{_editId}", _model);
        else
            res = await Http.PostAsJsonAsync("/api/inventory/discount-types", _model);

        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro guardado");
            _showDialog = false;
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al guardar");
    }

    private async Task ConfirmDelete()
    {
        var res = await Http.DeleteAsync($"/api/inventory/discount-types/{_deleteId}");
        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro eliminado");
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al eliminar");
    }

    private class DiscountTypeItem
    {
        public Guid PublicId { get; set; }
        public int TypeCode { get; set; }
        public string Name { get; set; } = "";
        public string? ShortName { get; set; }
        public int? DiscountClass { get; set; }
    }

    private class DiscountTypeModel
    {
        public int TypeCode { get; set; }
        public string Name { get; set; } = "";
        public string? ShortName { get; set; }
        public int? DiscountClass { get; set; }
    }
}
