@page "/inventario/ajustes"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using IngenIA365ERP.Shared.Services.Inventario
@inject InventarioClient Inventario
@inject INotificationService Notification
@inject NavigationManager Nav

<PageTitle>Ajustes de inventario - IngenIA365ERP</PageTitle>

@* Feature 012, T266 (FR-005, FR-006, FR-037; contracts/api.md §9.2, §10): la lista del grupo de ajustes —ajustes positivos y
   negativos, consumos internos, bajas y sus anulaciones— de las bodegas del alcance, con filtros por clase, estado, bodega,
   fecha y número. El valor al costo sólo llega con Inventory.Costs.Read. «Nuevo ajuste» abre el borrador. *@
<PermissionGate Required="Inventory.Adjustments.View" MostrarAviso="true">
<div class="pagina">
    <div class="page-header">
        <h3>Ajustes de inventario</h3>
        <div class="toolbar">
            <SfButton CssClass="e-outline" IconCss="e-icons e-refresh" Disabled="@_carga.Activa" OnClick="@CargarAsync">Actualizar</SfButton>
            <PermissionGate Required="Inventory.Adjustments.Create">
                <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@(() => Nav.NavigateTo("/inventario/ajustes/nuevo"))">Nuevo ajuste</SfButton>
            </PermissionGate>
        </div>
    </div>

    <div class="toolbar">
        <label class="campo">Clase
            <select class="e-input" value="@(_clase?.ToString() ?? "")" @onchange="@(e => { _clase = int.TryParse(e.Value?.ToString(), out var c) ? c : null; return BuscarAsync(); })">
                <option value="">Todas</option>
                @foreach (var c in ClasesDeAjuste) { <option value="@c">@TextosDeInventario.Clase(c)</option> }
            </select>
        </label>
        <label class="campo">Estado
            <select class="e-input" value="@(_estado?.ToString() ?? "")" @onchange="@(e => { _estado = int.TryParse(e.Value?.ToString(), out var s) ? s : null; return BuscarAsync(); })">
                <option value="">Todos</option>
                @foreach (var (valor, texto) in TextosDeInventario.Estados) { <option value="@valor">@texto</option> }
            </select>
        </label>
        <label class="campo">Bodega
            <select class="e-input" value="@(_bodega?.ToString() ?? "")" @onchange="@(e => { _bodega = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null; return BuscarAsync(); })">
                <option value="">Todas las del alcance</option>
                @foreach (var b in _bodegas) { <option value="@b.PublicId">@b.Code · @b.Name</option> }
            </select>
        </label>
        <label class="campo">Desde <input type="date" class="e-input" value="@(_desde?.ToString("yyyy-MM-dd"))" @onchange="@(e => { _desde = LeerFecha(e.Value); return BuscarAsync(); })" /></label>
        <label class="campo">Hasta <input type="date" class="e-input" value="@(_hasta?.ToString("yyyy-MM-dd"))" @onchange="@(e => { _hasta = LeerFecha(e.Value); return BuscarAsync(); })" /></label>
        <label class="campo">Número <input class="e-input" @bind="_numero" @bind:after="BuscarAsync" /></label>
    </div>

    <IndicadorDeCarga Cargando="@_carga.Activa">
        @if (!_carga.Activa && _documentos.Count == 0)
        {
            <p class="texto-tenue">No hay ajustes con estos filtros en las bodegas de su alcance.</p>
        }
        else
        {
            <div class="tabla-desplazable">
                <table class="data-grid">
                    <thead>
                        <tr><th>Número</th><th>Fecha</th><th>Clase</th><th>Tipo</th><th>Bodega</th><th>Estado</th><th>Creado por</th>@if (_conValor) { <th class="numero">Valor al costo</th> }</tr>
                    </thead>
                    <tbody>
                        @foreach (var d in _documentos)
                        {
                            <tr>
                                <td><a href="@($"/inventario/ajustes/{d.PublicId}")">@(d.DisplayNumber ?? "(borrador)")</a></td>
                                <td>@d.OperationDate.ToString("dd/MM/yyyy")</td>
                                <td>@TextosDeInventario.Clase(d.Class)</td>
                                <td>@d.DocumentType.Code</td>
                                <td>@d.Warehouse?.Code</td>
                                <td>@TextosDeInventario.Estado(d.Status)@(d.VoidedBy is { } a ? $" por {a.DisplayNumber}" : "")</td>
                                <td>@d.CreatedBy.Name</td>
                                @if (_conValor) { <td class="numero">@d.CostValue?.ToString("N2")</td> }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="toolbar">
                <SfButton CssClass="e-flat" Disabled="@(_pagina <= 1 || _carga.Activa)" OnClick="@(() => PaginaAsync(-1))">Anterior</SfButton>
                <span class="texto-tenue">Página @_pagina · @_total documento(s)</span>
                <SfButton CssClass="e-flat" Disabled="@(_pagina * TamanoDePagina >= _total || _carga.Activa)" OnClick="@(() => PaginaAsync(1))">Siguiente</SfButton>
            </div>
        }
    </IndicadorDeCarga>
</div>
</PermissionGate>

@code {
    private const int TamanoDePagina = 20;
    private const int GrupoDeAjustes = 2;

    /// <summary>Las clases de ajuste de I1, el movimiento entre ubicaciones (US10) y la anulación (el ensamble llega en I6).</summary>
    private static readonly int[] ClasesDeAjuste =
    [
        InventarioClient.ClasesDeAjuste.Positivo, InventarioClient.ClasesDeAjuste.Negativo, InventarioClient.ClasesDeAjuste.ConsumoInterno,
        InventarioClient.ClasesDeAjuste.Baja, InventarioClient.ClasesDeAjuste.MovimientoEntreUbicaciones, 34,
    ];

    private readonly EstadoDeCarga _carga = new();
    private List<ResumenDeDocumentoDto> _documentos = [];
    private List<BodegaDto> _bodegas = [];
    private int? _clase, _estado;
    private Guid? _bodega;
    private DateOnly? _desde, _hasta;
    private string? _numero;
    private int _pagina = 1;
    private long _total;

    private bool _conValor => _documentos.Any(d => d.CostValue is not null);

    protected override async Task OnInitializedAsync()
    {
        var bodegas = await Inventario.ListarBodegasAsync();
        _bodegas = bodegas.IsSuccess ? [.. bodegas.Value ?? []] : [];
        await CargarAsync();
    }

    private Task BuscarAsync()
    {
        _pagina = 1;
        return CargarAsync();
    }

    private async Task CargarAsync()
    {
        using var carga = _carga.Iniciar();
        var r = await Inventario.ListarAjustesAsync(new FiltroDeDocumentosDeInventario
        {
            Group = GrupoDeAjustes, Class = _clase, Status = _estado, WarehousePublicId = _bodega, From = _desde, To = _hasta,
            Number = string.IsNullOrWhiteSpace(_numero) ? null : _numero, Page = _pagina, PageSize = TamanoDePagina,
        });
        if (!r.IsSuccess)
        {
            _documentos = [];
            _total = 0;
            await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudieron consultar los ajustes.");
            return;
        }
        _documentos = [.. r.Value!.Items];
        _total = r.Value.TotalCount;
    }

    private async Task PaginaAsync(int paso)
    {
        _pagina = Math.Max(1, _pagina + paso);
        await CargarAsync();
    }

    private static DateOnly? LeerFecha(object? valor) =>
        DateOnly.TryParse(valor?.ToString(), System.Globalization.CultureInfo.InvariantCulture, out var f) ? f : null;
}
