@page "/inventario/movimientos"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Nav
@inject INotificationService Notification

<PageTitle>Movimientos de Inventario - IngenIA365ERP</PageTitle>

<div class="page-header" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;">
    <h3>Movimientos de Inventario</h3>
    <SfButton CssClass="e-primary" IconCss="e-icons e-plus"
              OnClick='@(() => Nav.NavigateTo("/inventario/movimientos/nuevo"))'>Nuevo Movimiento</SfButton>
</div>

<!-- Filters -->
<div style="display:flex;gap:12px;margin-bottom:16px;flex-wrap:wrap;align-items:flex-end;">
    <div>
        <label>Tipo</label>
        <SfDropDownList TValue="string" TItem="DropOption" @bind-Value="_filterType"
                        DataSource="_docTypes" Placeholder="Todos" CssClass="e-small">
            <DropDownListFieldSettings Text="Name" Value="Value" />
        </SfDropDownList>
    </div>
    <div>
        <label>Desde</label>
        <SfDatePicker TValue="DateTime?" @bind-Value="_filterDateFrom" Format="dd/MM/yyyy" CssClass="e-small" />
    </div>
    <div>
        <label>Hasta</label>
        <SfDatePicker TValue="DateTime?" @bind-Value="_filterDateTo" Format="dd/MM/yyyy" CssClass="e-small" />
    </div>
    <SfButton CssClass="e-primary e-small" OnClick="LoadData">Buscar</SfButton>
</div>

<SfGrid @ref="_grid" TValue="DocumentItem" DataSource="@_items"
        AllowPaging="true" AllowSorting="true">
    <GridPageSettings PageSize="20" />
    <GridEvents RowSelected="OnRowSelected" TValue="DocumentItem" />
    <GridColumns>
        <GridColumn Field="DocumentNumber" HeaderText="Numero" Width="110" Format="N0" TextAlign="TextAlign.Right" />
        <GridColumn Field="DocumentType" HeaderText="Tipo" Width="80" TextAlign="TextAlign.Center" />
        <GridColumn Field="Date" HeaderText="Fecha" Width="110" Format="dd/MM/yyyy" />
        <GridColumn Field="TransactionTypeName" HeaderText="Tipo Movimiento" Width="200" />
        <GridColumn Field="TotalAmount" HeaderText="Valor Total" Width="140" Format="N2" TextAlign="TextAlign.Right" />
        <GridColumn Field="IsVoided" HeaderText="Anulado" Width="90" DisplayAsCheckBox="true" TextAlign="TextAlign.Center" />
    </GridColumns>
</SfGrid>

@code {
    private SfGrid<DocumentItem>? _grid;
    private List<DocumentItem> _items = [];
    private string _filterType = "";
    private DateTime? _filterDateFrom;
    private DateTime? _filterDateTo;

    private List<DropOption> _docTypes =
    [
        new("", "Todos"),
        new("E", "Entrada"),
        new("S", "Salida"),
        new("T", "Traslado"),
        new("A", "Ajuste")
    ];

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        try
        {
            var url = "/api/inventory/documents?pageSize=100";
            if (!string.IsNullOrEmpty(_filterType)) url += $"&documentType={_filterType}";
            if (_filterDateFrom.HasValue) url += $"&dateFrom={DateOnly.FromDateTime(_filterDateFrom.Value):yyyy-MM-dd}";
            if (_filterDateTo.HasValue) url += $"&dateTo={DateOnly.FromDateTime(_filterDateTo.Value):yyyy-MM-dd}";

            var result = await Http.GetFromJsonAsync<PagedResult<DocumentItem>>(url);
            _items = result?.Items ?? [];
        }
        catch { _items = []; }
    }

    private void OnRowSelected(RowSelectEventArgs<DocumentItem> args)
    {
        if (args.Data is not null)
            Nav.NavigateTo($"/inventario/movimientos/{args.Data.PublicId}");
    }

    private class DocumentItem
    {
        public Guid PublicId { get; set; }
        public string DocumentType { get; set; } = "";
        public decimal DocumentNumber { get; set; }
        public DateOnly Date { get; set; }
        public string WarehouseName { get; set; } = "";
        public string TransactionTypeName { get; set; } = "";
        public decimal TotalAmount { get; set; }
        public bool IsVoided { get; set; }
    }

    private class PagedResult<T>
    {
        public List<T> Items { get; set; } = [];
        public int TotalCount { get; set; }
    }

    private record DropOption(string Value, string Name);
}
