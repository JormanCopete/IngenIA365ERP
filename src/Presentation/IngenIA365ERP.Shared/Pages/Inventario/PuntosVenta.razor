@page "/inventario/puntos-venta"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification

<PageTitle>Puntos de Venta - IngenIA365ERP</PageTitle>

<div class="page-header">
    <h3>Puntos de Venta</h3>
    <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@OpenCreate">Nuevo</SfButton>
</div>

<SfGrid @ref="_grid" TValue="SalesPointItem" DataSource="@_items"
    AllowPaging="true" AllowSorting="true" AllowFiltering="true">
    <GridColumns>
        <GridColumn Field="PointCode" HeaderText="Codigo" Width="100" TextAlign="TextAlign.Right" />
        <GridColumn Field="UserId" HeaderText="Usuario" Width="150" />
        <GridColumn Field="PrinterName" HeaderText="Impresora" Width="150" />
        <GridColumn Field="Status" HeaderText="Estado" Width="80" TextAlign="TextAlign.Right" />
        <GridColumn Field="BaseAmount" HeaderText="Base" Width="120" Format="N2" TextAlign="TextAlign.Right" />
        <GridColumn HeaderText="Acciones" Width="150" TextAlign="TextAlign.Center">
            <Template>
                @{
                    var item = context as SalesPointItem;
                    <SfButton CssClass="e-flat e-small" IconCss="e-icons e-edit" OnClick="@(() => OpenEdit(item!))" />
                    <SfButton CssClass="e-flat e-small e-danger" IconCss="e-icons e-trash" OnClick="@(() => OpenDelete(item!))" />
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

<SfDialog @bind-Visible="_showDialog" Header="@_dialogTitle" Width="500px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <div style="padding:10px;display:flex;flex-direction:column;gap:16px;">
                <div>
                    <label>Codigo Punto *</label>
                    <SfNumericTextBox TValue="int" @bind-Value="_model.PointCode" Placeholder="Codigo punto de venta" Min="0" />
                </div>
                <div>
                    <label>Usuario</label>
                    <SfTextBox @bind-Value="_model.UserId" Placeholder="Id usuario" />
                </div>
                <div>
                    <label>Impresora</label>
                    <SfTextBox @bind-Value="_model.PrinterName" Placeholder="Nombre de la impresora" />
                </div>
                <div>
                    <label>Estado</label>
                    <SfNumericTextBox TValue="int" @bind-Value="_model.Status" Placeholder="0" Min="0" />
                </div>
                <div>
                    <label>Base</label>
                    <SfNumericTextBox TValue="decimal" @bind-Value="_model.BaseAmount" Placeholder="0.00" Decimals="2" Format="N2" Min="0" />
                </div>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _showDialog = false)" />
        <DialogButton Content="Guardar" IsPrimary="true" OnClick="@Save" />
    </DialogButtons>
</SfDialog>

<ConfirmDialog @bind-Visible="_showConfirm" OnConfirm="ConfirmDelete"
    Message="Esta seguro de eliminar este registro?" />

@code {
    private SfGrid<SalesPointItem>? _grid;
    private List<SalesPointItem> _items = [];
    private SalesPointModel _model = new();
    private Guid? _editId;
    private bool _showDialog, _showConfirm;
    private string _dialogTitle = "";
    private Guid _deleteId;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        try { _items = await Http.GetFromJsonAsync<List<SalesPointItem>>("/api/inventory/sales-points?pageSize=500") ?? []; }
        catch { _items = []; }
    }

    private void OpenCreate() { _model = new(); _editId = null; _dialogTitle = "Nuevo Punto de Venta"; _showDialog = true; }

    private void OpenEdit(SalesPointItem item)
    {
        _model = new()
        {
            PointCode = item.PointCode,
            UserId = item.UserId,
            PrinterName = item.PrinterName,
            Status = item.Status,
            BaseAmount = item.BaseAmount
        };
        _editId = item.PublicId;
        _dialogTitle = "Editar Punto de Venta";
        _showDialog = true;
    }

    private void OpenDelete(SalesPointItem item) { _deleteId = item.PublicId; _showConfirm = true; }

    private async Task Save()
    {
        HttpResponseMessage res;
        if (_editId.HasValue)
            res = await Http.PutAsJsonAsync($"/api/inventory/sales-points/{_editId}", _model);
        else
            res = await Http.PostAsJsonAsync("/api/inventory/sales-points", _model);

        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro guardado");
            _showDialog = false;
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al guardar");
    }

    private async Task ConfirmDelete()
    {
        var res = await Http.DeleteAsync($"/api/inventory/sales-points/{_deleteId}");
        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro eliminado");
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al eliminar");
    }

    private class SalesPointItem
    {
        public Guid PublicId { get; set; }
        public int PointCode { get; set; }
        public string? UserId { get; set; }
        public string? PrinterName { get; set; }
        public int Status { get; set; }
        public decimal BaseAmount { get; set; }
    }

    private class SalesPointModel
    {
        public int PointCode { get; set; }
        public string? UserId { get; set; }
        public string? PrinterName { get; set; }
        public int Status { get; set; }
        public decimal BaseAmount { get; set; }
    }
}
