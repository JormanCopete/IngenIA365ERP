@page "/inventario/marcas"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using IngenIA365ERP.Shared.Services.Inventario
@using static IngenIA365ERP.Shared.Components.Inventario.CatalogoDeInventarioModelo
@inject InventarioClient Inventario

<PageTitle>Marcas - IngenIA365ERP</PageTitle>

@* Feature 012, T235 (FR-023; contracts/api.md §3.3; plantilla 4): la marca entra a la búsqueda de sus productos; renombrarla
   la recalcula. Una marca con productos activos se puede inactivar: los productos la conservan. *@
<PermissionGate Required="Inventory.Catalog.View" MostrarAviso="true">
    <CatalogoDeInventario Titulo="Marcas"
                          RutaBase="@InventarioClient.RutaDeMarcas"
                          RutaDePlantilla="@InventarioClient.RutaDeMarcas"
                          CatalogoDeCodigo="marcas"
                          AvisoAlInactivar="Los productos de una marca inactiva la conservan; sólo deja de ofrecerse en productos nuevos."
                          Campos="@_campos"
                          Cargar="@CargarAsync"
                          Guardar="@GuardarAsync" />
</PermissionGate>

@code {
    private static readonly IReadOnlyList<CampoDeCatalogo> _campos = [new("productos", "Productos", EnFormulario: false)];

    private async Task<ResultadoDeInventario<IReadOnlyList<FilaDeCatalogo>>> CargarAsync(bool inactivas) =>
        Filas(await Inventario.ListarMarcasAsync(inactivas), m => new FilaDeCatalogo(m.PublicId, m.Code, m.Name, m.IsActive, false,
            new Dictionary<string, string?> { ["productos"] = m.Products.ToString() }));

    private async Task<(bool, string?)> GuardarAsync(FilaDeCatalogo? fila, string? codigo, string nombre, IReadOnlyDictionary<string, string?> v, Services.Http.ClaveDeOperacion clave) =>
        Resultado(await Inventario.GuardarMarcaAsync(fila?.PublicId, new CodigoYNombreRequest(codigo, nombre), clave));
}
