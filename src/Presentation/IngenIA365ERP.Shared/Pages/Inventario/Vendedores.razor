@page "/inventario/vendedores"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification

<PageTitle>Vendedores - IngenIA365ERP</PageTitle>

<div class="page-header">
    <h3>Vendedores</h3>
    <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@OpenCreate">Nuevo</SfButton>
</div>

<SfGrid @ref="_grid" TValue="SalespersonItem" DataSource="@_items"
    AllowPaging="true" AllowSorting="true" AllowFiltering="true">
    <GridColumns>
        <GridColumn Field="IdNumber" HeaderText="Cedula" Width="130" />
        <GridColumn Field="Name" HeaderText="Nombre" Width="200" />
        <GridColumn Field="LastName" HeaderText="Apellido" Width="200" />
        <GridColumn Field="Phone" HeaderText="Telefono" Width="120" />
        <GridColumn Field="Mobile" HeaderText="Celular" Width="120" />
        <GridColumn Field="AppliesCommission" HeaderText="Comision" Width="100" DisplayAsCheckBox="true" />
        <GridColumn HeaderText="Acciones" Width="150" TextAlign="TextAlign.Center">
            <Template>
                @{
                    var item = context as SalespersonItem;
                    <SfButton CssClass="e-flat e-small" IconCss="e-icons e-edit" OnClick="@(() => OpenEdit(item!))" />
                    <SfButton CssClass="e-flat e-small e-danger" IconCss="e-icons e-trash" OnClick="@(() => OpenDelete(item!))" />
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

<SfDialog @bind-Visible="_showDialog" Header="@_dialogTitle" Width="550px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <div style="padding:10px;display:flex;flex-direction:column;gap:16px;">
                <div>
                    <label>Cedula *</label>
                    <SfTextBox @bind-Value="_model.IdNumber" Placeholder="Numero de cedula" />
                </div>
                <div>
                    <label>Nombre *</label>
                    <SfTextBox @bind-Value="_model.Name" Placeholder="Nombre" />
                </div>
                <div>
                    <label>Apellido</label>
                    <SfTextBox @bind-Value="_model.LastName" Placeholder="Apellido" />
                </div>
                <div>
                    <label>Direccion</label>
                    <SfTextBox @bind-Value="_model.Address" Placeholder="Direccion" />
                </div>
                <div>
                    <label>Telefono</label>
                    <SfTextBox @bind-Value="_model.Phone" Placeholder="Telefono" />
                </div>
                <div>
                    <label>Celular</label>
                    <SfTextBox @bind-Value="_model.Mobile" Placeholder="Celular" />
                </div>
                <div>
                    <SfCheckBox @bind-Checked="_model.AppliesCommission" Label="Aplica Comision" />
                </div>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _showDialog = false)" />
        <DialogButton Content="Guardar" IsPrimary="true" OnClick="@Save" />
    </DialogButtons>
</SfDialog>

<ConfirmDialog @bind-Visible="_showConfirm" OnConfirm="ConfirmDelete"
    Message="Esta seguro de eliminar este registro?" />

@code {
    private SfGrid<SalespersonItem>? _grid;
    private List<SalespersonItem> _items = [];
    private SalespersonModel _model = new();
    private Guid? _editId;
    private bool _showDialog, _showConfirm;
    private string _dialogTitle = "";
    private Guid _deleteId;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        try { _items = await Http.GetListAsync<SalespersonItem>("/api/inventory/salespeople?pageSize=500") ?? []; }
        catch { _items = []; }
    }

    private void OpenCreate() { _model = new(); _editId = null; _dialogTitle = "Nuevo Vendedor"; _showDialog = true; }

    private void OpenEdit(SalespersonItem item)
    {
        _model = new()
        {
            IdNumber = item.IdNumber,
            Name = item.Name,
            LastName = item.LastName,
            Address = item.Address,
            Phone = item.Phone,
            Mobile = item.Mobile,
            AppliesCommission = item.AppliesCommission
        };
        _editId = item.PublicId;
        _dialogTitle = "Editar Vendedor";
        _showDialog = true;
    }

    private void OpenDelete(SalespersonItem item) { _deleteId = item.PublicId; _showConfirm = true; }

    private async Task Save()
    {
        HttpResponseMessage res;
        if (_editId.HasValue)
            res = await Http.PutAsJsonAsync($"/api/inventory/salespeople/{_editId}", _model);
        else
            res = await Http.PostAsJsonAsync("/api/inventory/salespeople", _model);

        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro guardado");
            _showDialog = false;
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al guardar");
    }

    private async Task ConfirmDelete()
    {
        var res = await Http.DeleteAsync($"/api/inventory/salespeople/{_deleteId}");
        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro eliminado");
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al eliminar");
    }

    private class SalespersonItem
    {
        public Guid PublicId { get; set; }
        public string IdNumber { get; set; } = "";
        public string Name { get; set; } = "";
        public string? LastName { get; set; }
        public string? Address { get; set; }
        public string? Phone { get; set; }
        public string? Mobile { get; set; }
        public bool AppliesCommission { get; set; }
    }

    private class SalespersonModel
    {
        public string IdNumber { get; set; } = "";
        public string Name { get; set; } = "";
        public string? LastName { get; set; }
        public string? Address { get; set; }
        public string? Phone { get; set; }
        public string? Mobile { get; set; }
        public bool AppliesCommission { get; set; }
    }
}
