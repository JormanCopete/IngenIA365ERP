@page "/inventario/kardex"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification

<PageTitle>Kardex - IngenIA365ERP</PageTitle>

<div class="pagina">
    <div class="page-header">
        <h3>Kardex de Inventario</h3>
    </div>

    <!-- Product search -->
    <div class="toolbar">
        <div style="flex:1;min-width:280px;">
            <label>Producto</label>
            <div class="acciones">
                <SfTextBox @bind-Value="_productSearch" Placeholder="Buscar por codigo o nombre de producto" />
                <SfButton CssClass="e-primary" IconCss="e-icons e-search" OnClick="SearchProduct">Buscar</SfButton>
            </div>
        </div>
        @if (_selectedProduct is not null)
        {
            <div>
                <label>Bodega</label>
                <SfDropDownList TValue="string" TItem="DropOption" @bind-Value="_filterWarehouse"
                                DataSource="_warehouseOptions" Placeholder="Todas" CssClass="e-small">
                    <DropDownListFieldSettings Text="Name" Value="Value" />
                </SfDropDownList>
            </div>
            <div>
                <label>Desde</label>
                <SfDatePicker TValue="DateTime?" @bind-Value="_dateFrom" Format="dd/MM/yyyy" CssClass="e-small" />
            </div>
            <div>
                <label>Hasta</label>
                <SfDatePicker TValue="DateTime?" @bind-Value="_dateTo" Format="dd/MM/yyyy" CssClass="e-small" />
            </div>
            <SfButton CssClass="e-primary e-small" OnClick="LoadMovements">Filtrar</SfButton>
        }
    </div>

    <!-- Product selector results -->
    <SfDialog @bind-Visible="_showProductResults" Header="Seleccionar Producto" Width="650px" IsModal="true" ShowCloseIcon="true">
        <DialogTemplates>
            <Content>
                <div style="padding:var(--pad-md);">
                    <SfGrid TValue="ProductItem" DataSource="_productResults" AllowPaging="true" Height="300">
                        <GridPageSettings PageSize="10" />
                        <GridEvents RowSelected="OnProductChosen" TValue="ProductItem" />
                        <GridColumns>
                            <GridColumn Field="ProductCode" HeaderText="Codigo" Width="100" />
                            <GridColumn Field="Name" HeaderText="Nombre" Width="280" />
                            <GridColumn Field="UnitOfMeasure" HeaderText="Medida" Width="80" />
                            <GridColumn Field="CurrentStock" HeaderText="Stock Total" Width="100" Format="N2" TextAlign="TextAlign.Right" />
                        </GridColumns>
                    </SfGrid>
                </div>
            </Content>
        </DialogTemplates>
    </SfDialog>

    @if (_selectedProduct is not null)
    {
        <!-- Product info + stock summary -->
        <div class="panel-producto">
            <div>
                <span class="label">Producto seleccionado</span>
                <strong class="titulo">@_selectedProduct.ProductCode - @_selectedProduct.Name</strong>
                <span class="texto-tenue medida">(@_selectedProduct.UnitOfMeasure)</span>
            </div>
            <SfButton CssClass="e-flat e-small" IconCss="e-icons e-close" OnClick="ClearProduct">Cambiar producto</SfButton>
        </div>

        <!-- Stock per warehouse KPI cards -->
        @if (_stockSummary.Count > 0)
        {
            <div class="kpi-grid">
                @foreach (var ws in _stockSummary)
                {
                    <div class="kpi-card">
                        <span class="kpi-label">@ws.WarehouseName</span>
                        <strong class="kpi-value" style="color:@(ws.Stock >= 0 ? "var(--exito)" : "var(--peligro)");">@ws.Stock.ToString("N2")</strong>
                        <span class="kpi-label">Costo prom: @ws.AverageCost.ToString("N2")</span>
                    </div>
                }
                <div class="kpi-card tarjeta-total">
                    <span class="kpi-label">Stock Total</span>
                    <strong class="kpi-value">@_stockSummary.Sum(s => s.Stock).ToString("N2")</strong>
                    <span class="kpi-label">Todas las bodegas</span>
                </div>
            </div>
        }

        <!-- Movements grid -->
        <div class="page-header">
            <h4>Movimientos</h4>
            <SfButton CssClass="e-flat e-small" IconCss="e-icons e-export-excel" OnClick="ExportToExcel">Exportar a Excel</SfButton>
        </div>

        <SfGrid @ref="_movementsGrid" TValue="KardexMovement" DataSource="@_movements"
                AllowPaging="true" AllowSorting="true" AllowExcelExport="true">
            <GridPageSettings PageSize="25" />
            <GridColumns>
                <GridColumn Field="Date" HeaderText="Fecha" Width="110" Format="dd/MM/yyyy" />
                <GridColumn Field="DocumentType" HeaderText="Tipo Doc" Width="90" TextAlign="TextAlign.Center" />
                <GridColumn Field="DocumentNumber" HeaderText="Numero" Width="100" TextAlign="TextAlign.Right" />
                <GridColumn Field="WarehouseName" HeaderText="Bodega" Width="140" />
                <GridColumn Field="EntryQty" HeaderText="Entrada" Width="110" Format="N2" TextAlign="TextAlign.Right" />
                <GridColumn Field="ExitQty" HeaderText="Salida" Width="110" Format="N2" TextAlign="TextAlign.Right" />
                <GridColumn Field="Balance" HeaderText="Saldo" Width="110" Format="N2" TextAlign="TextAlign.Right" />
                <GridColumn Field="UnitCost" HeaderText="Costo Unit" Width="120" Format="N2" TextAlign="TextAlign.Right" />
            </GridColumns>
        </SfGrid>

        @if (_movements.Count == 0 && !_loading)
        {
            <div class="estado-vacio">
                <span class="e-icons e-description icono"></span>
                No se encontraron movimientos para los filtros seleccionados.
            </div>
        }
    }
    else
    {
        <div class="estado-vacio">
            <span class="e-icons e-search icono"></span>
            <p>Busque y seleccione un producto para ver su kardex.</p>
        </div>
    }
</div>

@code {
    private string _productSearch = "";
    private bool _showProductResults;
    private List<ProductItem> _productResults = [];
    private ProductItem? _selectedProduct;

    private string _filterWarehouse = "";
    private DateTime? _dateFrom;
    private DateTime? _dateTo;
    private bool _loading;

    private List<DropOption> _warehouseOptions = [new("", "Todas")];
    private List<StockSummaryItem> _stockSummary = [];
    private List<KardexMovement> _movements = [];
    private SfGrid<KardexMovement>? _movementsGrid;

    protected override async Task OnInitializedAsync()
    {
        await LoadWarehouses();
    }

    private async Task LoadWarehouses()
    {
        try
        {
            var items = await Http.GetListAsync<CatalogItem>("/api/inventory/warehouses?pageSize=200");
            _warehouseOptions = [new("", "Todas"), .. (items ?? []).Select(w => new DropOption(w.Code, $"{w.Code} - {w.Name}"))];
        }
        catch { /* keep default */ }
    }

    private async Task SearchProduct()
    {
        if (string.IsNullOrWhiteSpace(_productSearch)) return;
        try
        {
            _productResults = await Http.GetListAsync<ProductItem>(
                $"/api/inventory/products?search={_productSearch}&pageSize=50") ?? [];

            if (_productResults.Count == 1)
            {
                await SelectProduct(_productResults[0]);
            }
            else if (_productResults.Count > 1)
            {
                _showProductResults = true;
            }
            else
            {
                await Notification.ErrorAsync("No se encontraron productos");
            }
        }
        catch { await Notification.ErrorAsync("Error al buscar productos"); }
    }

    private async Task OnProductChosen(RowSelectEventArgs<ProductItem> args)
    {
        if (args.Data is not null)
        {
            _showProductResults = false;
            await SelectProduct(args.Data);
        }
    }

    private async Task SelectProduct(ProductItem product)
    {
        _selectedProduct = product;
        _productSearch = $"{product.ProductCode} - {product.Name}";
        await Task.WhenAll(LoadStockSummary(), LoadMovements());
    }

    private void ClearProduct()
    {
        _selectedProduct = null;
        _productSearch = "";
        _stockSummary = [];
        _movements = [];
    }

    private async Task LoadStockSummary()
    {
        if (_selectedProduct is null) return;
        try
        {
            _stockSummary = await Http.GetListAsync<StockSummaryItem>(
                $"/api/inventory/stock/{_selectedProduct.PublicId}/summary") ?? [];
        }
        catch { _stockSummary = []; }
    }

    private async Task LoadMovements()
    {
        if (_selectedProduct is null) return;
        _loading = true;
        try
        {
            var url = $"/api/inventory/stock/{_selectedProduct.PublicId}/movements?pageSize=500";
            if (!string.IsNullOrEmpty(_filterWarehouse)) url += $"&warehouse={_filterWarehouse}";
            if (_dateFrom.HasValue) url += $"&dateFrom={DateOnly.FromDateTime(_dateFrom.Value):yyyy-MM-dd}";
            if (_dateTo.HasValue) url += $"&dateTo={DateOnly.FromDateTime(_dateTo.Value):yyyy-MM-dd}";

            _movements = await Http.GetListAsync<KardexMovement>(url) ?? [];
        }
        catch { _movements = []; }
        finally { _loading = false; }
    }

    private async Task ExportToExcel()
    {
        if (_movementsGrid is not null)
        {
            var props = new Syncfusion.Blazor.Grids.ExcelExportProperties
            {
                FileName = $"Kardex_{_selectedProduct?.ProductCode}_{DateTime.Now:yyyyMMdd}.xlsx"
            };
            await _movementsGrid.ExportToExcelAsync(props);
        }
    }

    // Models
    private class ProductItem
    {
        public Guid PublicId { get; set; }
        public string ProductCode { get; set; } = "";
        public string Name { get; set; } = "";
        public string UnitOfMeasure { get; set; } = "";
        public decimal CurrentStock { get; set; }
    }

    private class StockSummaryItem
    {
        public string WarehouseCode { get; set; } = "";
        public string WarehouseName { get; set; } = "";
        public decimal Stock { get; set; }
        public decimal AverageCost { get; set; }
    }

    private class KardexMovement
    {
        public DateOnly Date { get; set; }
        public string DocumentType { get; set; } = "";
        public long DocumentNumber { get; set; }
        public string WarehouseName { get; set; } = "";
        public decimal EntryQty { get; set; }
        public decimal ExitQty { get; set; }
        public decimal Balance { get; set; }
        public decimal UnitCost { get; set; }
    }

    private class CatalogItem
    {
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
    }

    private record DropOption(string Value, string Name);
}
