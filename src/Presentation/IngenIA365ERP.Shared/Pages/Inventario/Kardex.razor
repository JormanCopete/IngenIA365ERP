@page "/inventario/kardex"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using IngenIA365ERP.Shared.Services.Inventario
@using IngenIA365ERP.Shared.Services.Nomina
@using IngenIA365ERP.Shared.Services.Reportes
@inject InventarioClient Inventario
@inject INotificationService Notification
@inject DescargaDeArchivos Descargas

<PageTitle>Kardex - IngenIA365ERP</PageTitle>

@* Feature 012, T265 (FR-019, FR-033; contracts/api.md §6.1, §27): el kardex de UN producto por la vista «kardex» del centro de
   informes (no hay ruta de kardex bajo /api/inventory). Producto obligatorio, bodega, rango (hasta 5 años) y si muestra las
   líneas de ajuste de costo. La primera fila es el saldo al día anterior a «desde»; el orden es el del kardex (fecha de
   operación y registro). Las columnas de costo y valor llegan vacías sin Inventory.Costs.Read, y la nota lo dice. El
   documento de cada línea abre su pantalla por la columna oculta _documento. Exportar exige Inventory.Reports.Export. *@
<PermissionGate Required="Inventory.Reports.View" MostrarAviso="true">
<div class="pagina">
    <div class="page-header">
        <h3>Kardex</h3>
        <div class="toolbar">
            @if (_tabla is not null && _producto is not null)
            {
                <PermissionGate Required="Inventory.Reports.Export">
                    <SfButton CssClass="e-outline" IconCss="e-icons e-download" Disabled="@_carga.Activa" OnClick="@(() => DescargarAsync("xlsx"))">Excel</SfButton>
                    <SfButton CssClass="e-outline" IconCss="e-icons e-download" Disabled="@_carga.Activa" OnClick="@(() => DescargarAsync("pdf"))">PDF</SfButton>
                </PermissionGate>
            }
            <a class="e-btn e-outline" href="/inventario/existencias">Existencias</a>
        </div>
    </div>

    <div class="info-card">
        <SelectorDeProducto Etiqueta="Producto *" Bodega="@_bodega" Elegido="@ElegirAsync" />
        @if (_producto is { } p)
        {
            <p class="texto-apoyo">Producto: <b>@p.Code · @p.Name</b> (unidad base @p.BaseUnitCode)</p>
        }
        <div class="toolbar">
            <label class="campo">Bodega
                <select class="e-input" value="@(_bodega?.ToString() ?? "")" @onchange="@(e => _bodega = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null)">
                    <option value="">Todas las del alcance</option>
                    @foreach (var b in _bodegas) { <option value="@b.PublicId">@b.Code · @b.Name</option> }
                </select>
            </label>
            <label class="campo">Desde <input type="date" class="e-input" value="@_desde.ToString("yyyy-MM-dd")" @onchange="@(e => _desde = LeerFecha(e.Value) ?? _desde)" /></label>
            <label class="campo">Hasta <input type="date" class="e-input" value="@_hasta.ToString("yyyy-MM-dd")" @onchange="@(e => _hasta = LeerFecha(e.Value) ?? _hasta)" /></label>
            <SfCheckBox @bind-Checked="_conAjustes" TChecked="bool" Label="Mostrar ajustes de costo" />
            <SfButton CssClass="e-primary" IconCss="e-icons e-search" Disabled="@(_carga.Activa || _producto is null)" OnClick="@ConsultarAsync">Consultar</SfButton>
        </div>
    </div>

    <IndicadorDeCarga Cargando="@_carga.Activa">
        @if (_tabla is null)
        {
            <p class="texto-tenue">Lea o escriba el producto, elija la bodega y el rango, y pulse «Consultar».</p>
        }
        else
        {
            <p class="texto-apoyo">@_tabla.Subtitulo</p>
            <div class="tabla-desplazable">
                <table class="data-grid">
                    <thead>
                        <tr>
                            @foreach (var (c, _) in Visibles) { <th class="@(c.EsNumerica ? "numero" : "")">@c.Nombre</th> }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var fila in _tabla.Filas)
                        {
                            <tr class="@(fila.Resaltada ? "resaltada" : "")">
                                @foreach (var (c, i) in Visibles)
                                {
                                    var texto = TablaReporteDto.Texto(fila.Valores[i], c.Tipo);
                                    <td class="@(c.EsNumerica ? "numero" : "")">
                                        @if (c.Nombre == "Documento" && Oculto(fila, "_documento") is { } documento && EsAjuste(texto))
                                        {
                                            <a href="@($"/inventario/ajustes/{documento}")">@texto</a>
                                        }
                                        else
                                        {
                                            @texto
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @foreach (var nota in _tabla.Notas) { <p class="texto-tenue">@nota</p> }
        }
    </IndicadorDeCarga>
</div>
</PermissionGate>

@code {
    private readonly EstadoDeCarga _carga = new();
    private List<BodegaDto> _bodegas = [];
    private ProductoEncontradoDto? _producto;
    private Guid? _bodega;
    private DateOnly _desde = new(DateTime.Today.Year, DateTime.Today.Month, 1), _hasta = DateOnly.FromDateTime(DateTime.Today);
    private bool _conAjustes = true, _iniciado;
    private TablaReporteDto? _tabla;

    /// <summary>Llega desde Existencias con el producto (y la bodega): se consulta sola.</summary>
    [SupplyParameterFromQuery(Name = "product")] public Guid? Producto { get; set; }
    [SupplyParameterFromQuery(Name = "warehouse")] public Guid? Bodega { get; set; }

    /// <summary>Las columnas que se pintan (sin las ocultas «_»), con su índice en la fila.</summary>
    private IEnumerable<(ColumnaReporteDto Columna, int Indice)> Visibles =>
        _tabla is null ? [] : _tabla.Columnas.Select((c, i) => (c, i)).Where(x => !x.c.EsOculta);

    protected override async Task OnParametersSetAsync()
    {
        if (_iniciado) return;
        _iniciado = true;
        var bodegas = await Inventario.ListarBodegasAsync(incluirTransito: true);
        _bodegas = bodegas.IsSuccess ? [.. bodegas.Value ?? []] : [];
        _bodega = Bodega;
        if (Producto is { } id)
        {
            var existencia = await Inventario.ExistenciaDelProductoAsync(id);
            if (existencia.IsSuccess && existencia.Value is { } e)
            {
                _producto = new ProductoEncontradoDto(e.Product.PublicId, e.Product.Code, e.Product.Name, null, null, e.Product.BaseUnitCode,
                    e.Product.Status, null, null, null);
                await ConsultarAsync();
            }
        }
    }

    private Task ElegirAsync(ProductoElegido elegido)
    {
        _producto = elegido.Producto;
        _tabla = null;
        return ConsultarAsync();
    }

    private async Task ConsultarAsync()
    {
        if (_producto is null) return;
        using var carga = _carga.Iniciar();
        var r = await Inventario.KardexAsync(_producto.PublicId, _bodega, null, _desde, _hasta, _conAjustes);
        if (!r.IsSuccess)
        {
            _tabla = null;
            await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo consultar el kardex.");
            return;
        }
        _tabla = r.Value;
    }

    private async Task DescargarAsync(string formato)
    {
        if (_producto is null) return;
        using var carga = _carga.Iniciar();
        var r = await Inventario.DescargarKardexAsync(_producto.PublicId, _bodega, null, _desde, _hasta, _conAjustes, formato);
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo exportar el kardex."); return; }
        await Descargas.GuardarAsync(r.Value!.Nombre, r.Value.TipoContenido, r.Value.Contenido);
    }

    /// <summary>El valor de una columna oculta de la fila (el PublicId del documento).</summary>
    private string? Oculto(FilaReporteDto fila, string clave)
    {
        var indice = _tabla!.Columnas.ToList().FindIndex(c => c.Clave == clave);
        if (indice < 0 || indice >= fila.Valores.Count) return null;
        var valor = fila.Valores[indice];
        return valor.ValueKind == System.Text.Json.JsonValueKind.String ? valor.GetString() : null;
    }

    /// <summary>Por ahora sólo los ajustes (y sus anulaciones) tienen pantalla de documento; las demás clases la suman con su historia.</summary>
    private static bool EsAjuste(string documento) =>
        documento.StartsWith("PositiveAdjustment", StringComparison.Ordinal) || documento.StartsWith("NegativeAdjustment", StringComparison.Ordinal)
        || documento.StartsWith("InternalConsumption", StringComparison.Ordinal) || documento.StartsWith("WriteOff", StringComparison.Ordinal)
        || documento.StartsWith("Voiding", StringComparison.Ordinal);

    private static DateOnly? LeerFecha(object? valor) =>
        DateOnly.TryParse(valor?.ToString(), System.Globalization.CultureInfo.InvariantCulture, out var f) ? f : null;
}
