@page "/inventario/bodegas"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification

<PageTitle>Bodegas - IngenIA365ERP</PageTitle>

<div class="page-header">
    <h3>Bodegas</h3>
    <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@OpenCreate">Nuevo</SfButton>
</div>

<SfGrid @ref="_grid" TValue="WarehouseItem" DataSource="@_items"
    AllowPaging="true" AllowSorting="true" AllowFiltering="true">
    <GridColumns>
        <GridColumn Field="WarehouseCode" HeaderText="Codigo" Width="120" TextAlign="TextAlign.Right" />
        <GridColumn Field="Description" HeaderText="Descripcion" Width="300" />
        <GridColumn Field="ShortDescription" HeaderText="Resumido" Width="200" />
        <GridColumn Field="LocationId" HeaderText="Ubicacion" Width="120" TextAlign="TextAlign.Right" />
        <GridColumn HeaderText="Acciones" Width="150" TextAlign="TextAlign.Center">
            <Template>
                @{
                    var item = context as WarehouseItem;
                    <SfButton CssClass="e-flat e-small" IconCss="e-icons e-edit" OnClick="@(() => OpenEdit(item!))" />
                    <SfButton CssClass="e-flat e-small e-danger" IconCss="e-icons e-trash" OnClick="@(() => OpenDelete(item!))" />
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

<SfDialog @bind-Visible="_showDialog" Header="@_dialogTitle" Width="500px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <div style="padding:10px;display:flex;flex-direction:column;gap:16px;">
                <div>
                    <label>Codigo *</label>
                    <SfNumericTextBox TValue="int" @bind-Value="_model.WarehouseCode" Placeholder="Codigo bodega" Min="0" />
                </div>
                <div>
                    <label>Descripcion *</label>
                    <SfTextBox @bind-Value="_model.Description" Placeholder="Descripcion de la bodega" />
                </div>
                <div>
                    <label>Resumido</label>
                    <SfTextBox @bind-Value="_model.ShortDescription" Placeholder="Descripcion corta" />
                </div>
                <div>
                    <label>Ubicacion *</label>
                    <SfNumericTextBox TValue="int" @bind-Value="_model.LocationId" Placeholder="Id ubicacion" Min="0" />
                </div>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _showDialog = false)" />
        <DialogButton Content="Guardar" IsPrimary="true" OnClick="@Save" />
    </DialogButtons>
</SfDialog>

<ConfirmDialog @bind-Visible="_showConfirm" OnConfirm="ConfirmDelete"
    Message="Esta seguro de eliminar este registro?" />

@code {
    private SfGrid<WarehouseItem>? _grid;
    private List<WarehouseItem> _items = [];
    private WarehouseModel _model = new();
    private Guid? _editId;
    private bool _showDialog, _showConfirm;
    private string _dialogTitle = "";
    private Guid _deleteId;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        try { _items = await Http.GetFromJsonAsync<List<WarehouseItem>>("/api/inventory/warehouses?pageSize=500") ?? []; }
        catch { _items = []; }
    }

    private void OpenCreate() { _model = new(); _editId = null; _dialogTitle = "Nueva Bodega"; _showDialog = true; }

    private void OpenEdit(WarehouseItem item)
    {
        _model = new()
        {
            WarehouseCode = item.WarehouseCode,
            Description = item.Description,
            ShortDescription = item.ShortDescription,
            LocationId = item.LocationId
        };
        _editId = item.PublicId;
        _dialogTitle = "Editar Bodega";
        _showDialog = true;
    }

    private void OpenDelete(WarehouseItem item) { _deleteId = item.PublicId; _showConfirm = true; }

    private async Task Save()
    {
        HttpResponseMessage res;
        if (_editId.HasValue)
            res = await Http.PutAsJsonAsync($"/api/inventory/warehouses/{_editId}", _model);
        else
            res = await Http.PostAsJsonAsync("/api/inventory/warehouses", _model);

        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro guardado");
            _showDialog = false;
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al guardar");
    }

    private async Task ConfirmDelete()
    {
        var res = await Http.DeleteAsync($"/api/inventory/warehouses/{_deleteId}");
        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro eliminado");
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al eliminar");
    }

    private class WarehouseItem
    {
        public Guid PublicId { get; set; }
        public int WarehouseCode { get; set; }
        public string Description { get; set; } = "";
        public string? ShortDescription { get; set; }
        public int LocationId { get; set; }
    }

    private class WarehouseModel
    {
        public int WarehouseCode { get; set; }
        public string Description { get; set; } = "";
        public string? ShortDescription { get; set; }
        public int LocationId { get; set; }
    }
}
