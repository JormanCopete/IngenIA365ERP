@page "/inventario/cuentas-producto"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification

<PageTitle>Cuentas de Producto - IngenIA365ERP</PageTitle>

<div class="pagina">
    <div class="page-header">
        <h3>Cuentas de Producto</h3>
        <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@OpenCreate">Nuevo</SfButton>
    </div>

    <SfGrid @ref="_grid" TValue="ProductAccountItem" DataSource="@_items"
        AllowPaging="true" AllowSorting="true" AllowFiltering="true">
        <GridColumns>
            <GridColumn Field="ProductGroupId" HeaderText="Grupo" Width="100" TextAlign="TextAlign.Right" />
            <GridColumn Field="TransactionTypeId" HeaderText="Tipo Movto" Width="100" TextAlign="TextAlign.Right" />
            <GridColumn Field="WarehouseId" HeaderText="Bodega" Width="100" TextAlign="TextAlign.Right" />
            <GridColumn Field="LocationId" HeaderText="Ubicacion" Width="100" TextAlign="TextAlign.Right" />
            <GridColumn Field="VatAccountCode" HeaderText="Cuenta IVA" Width="130" />
            <GridColumn Field="DiscountAccountCode" HeaderText="Cuenta Dcto" Width="130" />
            <GridColumn Field="TaxableSalesAccountCode" HeaderText="Ventas Gravadas" Width="140" />
            <GridColumn Field="NetAccountCode" HeaderText="Cuenta Neto" Width="130" />
            <GridColumn HeaderText="Acciones" Width="150" TextAlign="TextAlign.Center">
                <Template>
                    @{
                        var item = context as ProductAccountItem;
                        <SfButton CssClass="e-flat e-small" IconCss="e-icons e-edit" OnClick="@(() => OpenEdit(item!))" />
                        <SfButton CssClass="e-flat e-small e-danger" IconCss="e-icons e-trash" OnClick="@(() => OpenDelete(item!))" />
                    }
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
</div>

<SfDialog @bind-Visible="_showDialog" Header="@_dialogTitle" Width="550px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <div class="pagina">
                <div>
                    <label>Grupo de Producto *</label>
                    <SfNumericTextBox TValue="int" @bind-Value="_model.ProductGroupId" Placeholder="Id grupo" Min="0" />
                </div>
                <div>
                    <label>Tipo de Movimiento *</label>
                    <SfNumericTextBox TValue="int" @bind-Value="_model.TransactionTypeId" Placeholder="Id tipo movimiento" Min="0" />
                </div>
                <div>
                    <label>Bodega *</label>
                    <SfNumericTextBox TValue="int" @bind-Value="_model.WarehouseId" Placeholder="Id bodega" Min="0" />
                </div>
                <div>
                    <label>Ubicacion *</label>
                    <SfNumericTextBox TValue="int" @bind-Value="_model.LocationId" Placeholder="Id ubicacion" Min="0" />
                </div>
                <div>
                    <label>Cuenta IVA</label>
                    <SfTextBox @bind-Value="_model.VatAccountCode" Placeholder="Cuenta contable IVA" />
                </div>
                <div>
                    <label>Cuenta Descuentos</label>
                    <SfTextBox @bind-Value="_model.DiscountAccountCode" Placeholder="Cuenta contable descuentos" />
                </div>
                <div>
                    <label>Ventas Gravadas</label>
                    <SfTextBox @bind-Value="_model.TaxableSalesAccountCode" Placeholder="Cuenta ventas gravadas" />
                </div>
                <div>
                    <label>Ventas No Gravadas</label>
                    <SfTextBox @bind-Value="_model.NonTaxableSalesAccountCode" Placeholder="Cuenta ventas no gravadas" />
                </div>
                <div>
                    <label>Cuenta Neto</label>
                    <SfTextBox @bind-Value="_model.NetAccountCode" Placeholder="Cuenta neto" />
                </div>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _showDialog = false)" />
        <DialogButton Content="Guardar" IsPrimary="true" OnClick="@Save" />
    </DialogButtons>
</SfDialog>

<ConfirmDialog @bind-Visible="_showConfirm" OnConfirm="ConfirmDelete"
    Message="Esta seguro de eliminar este registro?" />

@code {
    private SfGrid<ProductAccountItem>? _grid;
    private List<ProductAccountItem> _items = [];
    private ProductAccountModel _model = new();
    private Guid? _editId;
    private bool _showDialog, _showConfirm;
    private string _dialogTitle = "";
    private Guid _deleteId;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        try { _items = await Http.GetListAsync<ProductAccountItem>("/api/inventory/product-accounts?pageSize=500") ?? []; }
        catch { _items = []; }
    }

    private void OpenCreate() { _model = new(); _editId = null; _dialogTitle = "Nueva Cuenta de Producto"; _showDialog = true; }

    private void OpenEdit(ProductAccountItem item)
    {
        _model = new()
        {
            ProductGroupId = item.ProductGroupId,
            TransactionTypeId = item.TransactionTypeId,
            WarehouseId = item.WarehouseId,
            LocationId = item.LocationId,
            VatAccountCode = item.VatAccountCode,
            DiscountAccountCode = item.DiscountAccountCode,
            TaxableSalesAccountCode = item.TaxableSalesAccountCode,
            NonTaxableSalesAccountCode = item.NonTaxableSalesAccountCode,
            NetAccountCode = item.NetAccountCode
        };
        _editId = item.PublicId;
        _dialogTitle = "Editar Cuenta de Producto";
        _showDialog = true;
    }

    private void OpenDelete(ProductAccountItem item) { _deleteId = item.PublicId; _showConfirm = true; }

    private async Task Save()
    {
        HttpResponseMessage res;
        if (_editId.HasValue)
            res = await Http.PutAsJsonAsync($"/api/inventory/product-accounts/{_editId}", _model);
        else
            res = await Http.PostAsJsonAsync("/api/inventory/product-accounts", _model);

        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro guardado");
            _showDialog = false;
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al guardar");
    }

    private async Task ConfirmDelete()
    {
        var res = await Http.DeleteAsync($"/api/inventory/product-accounts/{_deleteId}");
        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro eliminado");
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al eliminar");
    }

    private class ProductAccountItem
    {
        public Guid PublicId { get; set; }
        public int ProductGroupId { get; set; }
        public int TransactionTypeId { get; set; }
        public int WarehouseId { get; set; }
        public int LocationId { get; set; }
        public string? VatAccountCode { get; set; }
        public string? DiscountAccountCode { get; set; }
        public string? TaxableSalesAccountCode { get; set; }
        public string? NonTaxableSalesAccountCode { get; set; }
        public string? NetAccountCode { get; set; }
    }

    private class ProductAccountModel
    {
        public int ProductGroupId { get; set; }
        public int TransactionTypeId { get; set; }
        public int WarehouseId { get; set; }
        public int LocationId { get; set; }
        public string? VatAccountCode { get; set; }
        public string? DiscountAccountCode { get; set; }
        public string? TaxableSalesAccountCode { get; set; }
        public string? NonTaxableSalesAccountCode { get; set; }
        public string? NetAccountCode { get; set; }
    }
}
