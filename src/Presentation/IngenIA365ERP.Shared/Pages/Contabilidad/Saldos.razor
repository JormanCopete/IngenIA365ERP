@page "/contabilidad/saldos"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification

<PageTitle>Saldos de Cuentas - IngenIA365ERP</PageTitle>

<div class="page-header">
    <h3>Saldos de Cuentas</h3>
    <SfButton CssClass="e-primary e-small" IconCss="e-icons e-export-excel" OnClick="ExportExcel">Exportar Excel</SfButton>
</div>

<!-- Filters -->
<div style="display:flex;gap:12px;margin-bottom:16px;flex-wrap:wrap;align-items:end;">
    <div>
        <label>Anio</label>
        <SfNumericTextBox TValue="int" @bind-Value="_year" Format="####" Min="2000" Max="2099"
                          CssClass="e-small" Width="100px" />
    </div>
    <div>
        <label>Mes</label>
        <SfDropDownList TValue="int" TItem="MonthOption" @bind-Value="_month" DataSource="_months"
                        CssClass="e-small" Width="150px">
            <DropDownListFieldSettings Text="Name" Value="Value" />
        </SfDropDownList>
    </div>
    <div>
        <label>Cuenta Desde</label>
        <SfTextBox @bind-Value="_accountFrom" Placeholder="Ej: 1" CssClass="e-small" Width="130px" />
    </div>
    <div>
        <label>Cuenta Hasta</label>
        <SfTextBox @bind-Value="_accountTo" Placeholder="Ej: 9999" CssClass="e-small" Width="130px" />
    </div>
    <div>
        <label>Nivel</label>
        <SfNumericTextBox TValue="int?" @bind-Value="_level" Min="1" Max="10" Step="1"
                          CssClass="e-small" Width="80px" Placeholder="Todos" />
    </div>
    <div>
        <label>Sucursal</label>
        <SfDropDownList TValue="string" TItem="DropOption" @bind-Value="_branchFilter" DataSource="_branches"
                        CssClass="e-small" Width="150px">
            <DropDownListFieldSettings Text="Name" Value="Value" />
        </SfDropDownList>
    </div>
    <div>
        <label>Centro Costo</label>
        <SfDropDownList TValue="string" TItem="DropOption" @bind-Value="_costCenterFilter" DataSource="_costCenters"
                        CssClass="e-small" Width="150px">
            <DropDownListFieldSettings Text="Name" Value="Value" />
        </SfDropDownList>
    </div>
    <SfButton CssClass="e-primary e-small" IconCss="e-icons e-search" OnClick="LoadData">Consultar</SfButton>
</div>

<SfGrid @ref="_grid" TValue="BalanceItem" DataSource="_items" AllowPaging="true" AllowSorting="true"
        AllowFiltering="true" AllowExcelExport="true" Height="500">
    <GridPageSettings PageSize="50" />
    <GridColumns>
        <GridColumn Field="AccountCode" HeaderText="Cuenta" Width="140" />
        <GridColumn Field="AccountName" HeaderText="Nombre" Width="280" />
        <GridColumn Field="Level" HeaderText="Nivel" Width="70" TextAlign="TextAlign.Center" />
        <GridColumn Field="Nature" HeaderText="Naturaleza" Width="100" TextAlign="TextAlign.Center" />
        <GridColumn Field="PreviousBalance" HeaderText="Saldo Anterior" Width="160" Format="N2" TextAlign="TextAlign.Right" />
        <GridColumn Field="Debits" HeaderText="Debitos" Width="150" Format="N2" TextAlign="TextAlign.Right" />
        <GridColumn Field="Credits" HeaderText="Creditos" Width="150" Format="N2" TextAlign="TextAlign.Right" />
        <GridColumn Field="NewBalance" HeaderText="Nuevo Saldo" Width="160" Format="N2" TextAlign="TextAlign.Right">
            <Template>
                @{
                    var item = context as BalanceItem;
                    var color = item?.NewBalance >= 0 ? "inherit" : "var(--peligro-texto)";
                }
                <span style="color:@color;font-weight:bold;">@item?.NewBalance.ToString("N2")</span>
            </Template>
        </GridColumn>
    </GridColumns>
    <GridAggregates>
        <GridAggregate>
            <GridAggregateColumns>
                <GridAggregateColumn Field="PreviousBalance" Type="AggregateType.Sum" Format="N2">
                    <FooterTemplate>
                        @{ var sum = (context as AggregateTemplateContext); }
                        <span><b>@sum?.Sum</b></span>
                    </FooterTemplate>
                </GridAggregateColumn>
                <GridAggregateColumn Field="Debits" Type="AggregateType.Sum" Format="N2">
                    <FooterTemplate>
                        @{ var sum = (context as AggregateTemplateContext); }
                        <span><b>@sum?.Sum</b></span>
                    </FooterTemplate>
                </GridAggregateColumn>
                <GridAggregateColumn Field="Credits" Type="AggregateType.Sum" Format="N2">
                    <FooterTemplate>
                        @{ var sum = (context as AggregateTemplateContext); }
                        <span><b>@sum?.Sum</b></span>
                    </FooterTemplate>
                </GridAggregateColumn>
                <GridAggregateColumn Field="NewBalance" Type="AggregateType.Sum" Format="N2">
                    <FooterTemplate>
                        @{ var sum = (context as AggregateTemplateContext); }
                        <span><b>@sum?.Sum</b></span>
                    </FooterTemplate>
                </GridAggregateColumn>
            </GridAggregateColumns>
        </GridAggregate>
    </GridAggregates>
</SfGrid>

@code {
    private SfGrid<BalanceItem>? _grid;
    private List<BalanceItem> _items = [];

    // Filters
    private int _year = DateTime.Today.Year;
    private int _month = DateTime.Today.Month;
    private string _accountFrom = "";
    private string _accountTo = "";
    private int? _level;
    private string _branchFilter = "";
    private string _costCenterFilter = "";

    // Dropdowns
    private List<DropOption> _branches = [new("", "Todas")];
    private List<DropOption> _costCenters = [new("", "Todos")];

    private List<MonthOption> _months =
    [
        new(1, "01 - Enero"), new(2, "02 - Febrero"), new(3, "03 - Marzo"),
        new(4, "04 - Abril"), new(5, "05 - Mayo"), new(6, "06 - Junio"),
        new(7, "07 - Julio"), new(8, "08 - Agosto"), new(9, "09 - Septiembre"),
        new(10, "10 - Octubre"), new(11, "11 - Noviembre"), new(12, "12 - Diciembre")
    ];

    protected override async Task OnInitializedAsync()
    {
        await LoadDropdowns();
        await LoadData();
    }

    private async Task LoadDropdowns()
    {
        try
        {
            var branchTask = Http.GetListAsync<CatalogItem>("/api/core/branches?pageSize=200");
            var ccTask = Http.GetListAsync<CatalogItem>("/api/accounting/cost-centers?pageSize=200");
            await Task.WhenAll(branchTask, ccTask);

            if (branchTask.Result is not null)
                _branches = [new("", "Todas"), .. branchTask.Result.Select(b => new DropOption(b.Code, $"{b.Code} - {b.Name}"))];
            if (ccTask.Result is not null)
                _costCenters = [new("", "Todos"), .. ccTask.Result.Select(c => new DropOption(c.Code, $"{c.Code} - {c.Name}"))];
        }
        catch { /* keep defaults */ }
    }

    private async Task LoadData()
    {
        try
        {
            var url = $"/api/accounting/balances?year={_year}&month={_month}&pageSize=1000";
            if (!string.IsNullOrEmpty(_accountFrom)) url += $"&accountFrom={_accountFrom}";
            if (!string.IsNullOrEmpty(_accountTo)) url += $"&accountTo={_accountTo}";
            if (_level.HasValue) url += $"&level={_level}";
            if (!string.IsNullOrEmpty(_branchFilter)) url += $"&branchCode={_branchFilter}";
            if (!string.IsNullOrEmpty(_costCenterFilter)) url += $"&costCenterCode={_costCenterFilter}";

            var r = await Http.GetFromJsonAsync<PagedResult<BalanceItem>>(url);
            _items = r?.Items ?? [];
        }
        catch
        {
            _items = [];
            await Notification.ErrorAsync("Error al cargar saldos");
        }
    }

    private async Task ExportExcel()
    {
        if (_grid is not null)
            await _grid.ExportToExcelAsync();
    }

    // Models
    private class PagedResult<T> { public List<T> Items { get; set; } = []; public int TotalCount { get; set; } }

    private class BalanceItem
    {
        public string AccountCode { get; set; } = "";
        public string AccountName { get; set; } = "";
        public int Level { get; set; }
        public string Nature { get; set; } = "";
        public decimal PreviousBalance { get; set; }
        public decimal Debits { get; set; }
        public decimal Credits { get; set; }
        public decimal NewBalance { get; set; }
    }

    private class CatalogItem
    {
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
    }

    private record DropOption(string Value, string Name);
    private record MonthOption(int Value, string Name);
}
