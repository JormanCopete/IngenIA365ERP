@page "/contabilidad/movimientos"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification

<PageTitle>Movimientos Contables - IngenIA365ERP</PageTitle>

<div class="page-header">
    <h3>Movimientos Contables</h3>
    <SfButton CssClass="e-primary e-small" IconCss="e-icons e-export-excel" OnClick="ExportExcel">Exportar Excel</SfButton>
</div>

<!-- Filters -->
<div style="display:flex;gap:12px;margin-bottom:16px;flex-wrap:wrap;align-items:end;">
    <div>
        <label>Fecha Desde</label>
        <SfDatePicker TValue="DateTime?" @bind-Value="_dateFrom" Format="dd/MM/yyyy" CssClass="e-small" />
    </div>
    <div>
        <label>Fecha Hasta</label>
        <SfDatePicker TValue="DateTime?" @bind-Value="_dateTo" Format="dd/MM/yyyy" CssClass="e-small" />
    </div>
    <div>
        <label>Cuenta</label>
        <div style="display:flex;gap:4px;">
            <SfTextBox @bind-Value="_accountFilter" Placeholder="Codigo cuenta" CssClass="e-small" Width="140px" />
            <SfButton CssClass="e-flat e-small" IconCss="e-icons e-search" OnClick="@(() => _showAccountSearch = true)" />
        </div>
    </div>
    <div>
        <label>Tercero</label>
        <div style="display:flex;gap:4px;">
            <SfTextBox @bind-Value="_personFilter" Placeholder="NIT" CssClass="e-small" Width="140px" />
            <SfButton CssClass="e-flat e-small" IconCss="e-icons e-search" OnClick="@(() => _showPersonSearch = true)" />
        </div>
    </div>
    <div>
        <label>Tipo Comprobante</label>
        <SfDropDownList TValue="string" TItem="DropOption" @bind-Value="_voucherTypeFilter" DataSource="_voucherTypes" CssClass="e-small" Width="180px">
            <DropDownListFieldSettings Text="Name" Value="Value" />
        </SfDropDownList>
    </div>
    <div>
        <label>Sucursal</label>
        <SfDropDownList TValue="string" TItem="DropOption" @bind-Value="_branchFilter" DataSource="_branches" CssClass="e-small" Width="150px">
            <DropDownListFieldSettings Text="Name" Value="Value" />
        </SfDropDownList>
    </div>
    <div>
        <label>Centro Costo</label>
        <SfDropDownList TValue="string" TItem="DropOption" @bind-Value="_costCenterFilter" DataSource="_costCenters" CssClass="e-small" Width="150px">
            <DropDownListFieldSettings Text="Name" Value="Value" />
        </SfDropDownList>
    </div>
    <SfButton CssClass="e-primary e-small" IconCss="e-icons e-search" OnClick="LoadData">Buscar</SfButton>
    <SfButton CssClass="e-flat e-small" OnClick="ClearFilters">Limpiar</SfButton>
</div>

<SfGrid @ref="_grid" TValue="JournalEntryItem" DataSource="_items" AllowPaging="true" AllowSorting="true" AllowFiltering="true"
        AllowExcelExport="true" Height="500">
    <GridPageSettings PageSize="50" />
    <GridColumns>
        <GridColumn Field="DocumentDate" HeaderText="Fecha" Width="110" Format="d" Type="ColumnType.Date" />
        <GridColumn Field="VoucherTypeCode" HeaderText="Comprobante" Width="110" />
        <GridColumn Field="DocumentNumber" HeaderText="Numero" Width="100" />
        <GridColumn Field="AccountCode" HeaderText="Cuenta" Width="120" />
        <GridColumn Field="AccountName" HeaderText="Nombre Cuenta" Width="220" />
        <GridColumn Field="PersonCode" HeaderText="Tercero" Width="120" />
        <GridColumn Field="PersonName" HeaderText="Nombre Tercero" Width="200" />
        <GridColumn Field="Description" HeaderText="Descripcion" Width="250" />
        <GridColumn Field="Debit" HeaderText="Debito" Width="140" Format="N2" TextAlign="TextAlign.Right" />
        <GridColumn Field="Credit" HeaderText="Credito" Width="140" Format="N2" TextAlign="TextAlign.Right" />
    </GridColumns>
    <GridAggregates>
        <GridAggregate>
            <GridAggregateColumns>
                <GridAggregateColumn Field="Debit" Type="AggregateType.Sum" Format="N2">
                    <FooterTemplate>
                        @{ var sum = (context as AggregateTemplateContext); }
                        <span><b>@sum?.Sum</b></span>
                    </FooterTemplate>
                </GridAggregateColumn>
                <GridAggregateColumn Field="Credit" Type="AggregateType.Sum" Format="N2">
                    <FooterTemplate>
                        @{ var sum = (context as AggregateTemplateContext); }
                        <span><b>@sum?.Sum</b></span>
                    </FooterTemplate>
                </GridAggregateColumn>
            </GridAggregateColumns>
        </GridAggregate>
    </GridAggregates>
</SfGrid>

<!-- Account search dialog -->
<SfDialog @bind-Visible="_showAccountSearch" Header="Buscar Cuenta" Width="600px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <div style="padding:10px;">
                <div style="display:flex;gap:8px;margin-bottom:12px;">
                    <SfTextBox @bind-Value="_accountSearchText" Placeholder="Codigo o nombre" CssClass="e-small" />
                    <SfButton CssClass="e-primary e-small" OnClick="SearchAccounts">Buscar</SfButton>
                </div>
                <SfGrid TValue="AccountItem" DataSource="_accountSearchResults" AllowPaging="true" Height="300">
                    <GridPageSettings PageSize="10" />
                    <GridEvents RowSelected="OnAccountSelected" TValue="AccountItem" />
                    <GridColumns>
                        <GridColumn Field="AccountCode" HeaderText="Codigo" Width="140" />
                        <GridColumn Field="Name" HeaderText="Nombre" Width="300" />
                    </GridColumns>
                </SfGrid>
            </div>
        </Content>
    </DialogTemplates>
</SfDialog>

<!-- Person search dialog -->
<SfDialog @bind-Visible="_showPersonSearch" Header="Buscar Tercero" Width="600px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <div style="padding:10px;">
                <div style="display:flex;gap:8px;margin-bottom:12px;">
                    <SfTextBox @bind-Value="_personSearchText" Placeholder="NIT o nombre" CssClass="e-small" />
                    <SfButton CssClass="e-primary e-small" OnClick="SearchPersons">Buscar</SfButton>
                </div>
                <SfGrid TValue="PersonItem" DataSource="_personSearchResults" AllowPaging="true" Height="300">
                    <GridPageSettings PageSize="10" />
                    <GridEvents RowSelected="OnPersonSelected" TValue="PersonItem" />
                    <GridColumns>
                        <GridColumn Field="IdentificationNumber" HeaderText="NIT" Width="140" />
                        <GridColumn Field="FullName" HeaderText="Nombre" Width="300" />
                    </GridColumns>
                </SfGrid>
            </div>
        </Content>
    </DialogTemplates>
</SfDialog>

@code {
    private SfGrid<JournalEntryItem>? _grid;
    private List<JournalEntryItem> _items = [];

    // Filters
    private DateTime? _dateFrom = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime? _dateTo = DateTime.Today;
    private string _accountFilter = "";
    private string _personFilter = "";
    private string _voucherTypeFilter = "";
    private string _branchFilter = "";
    private string _costCenterFilter = "";

    // Dropdowns
    private List<DropOption> _voucherTypes = [new("", "Todos")];
    private List<DropOption> _branches = [new("", "Todas")];
    private List<DropOption> _costCenters = [new("", "Todos")];

    // Account search
    private bool _showAccountSearch;
    private string _accountSearchText = "";
    private List<AccountItem> _accountSearchResults = [];

    // Person search
    private bool _showPersonSearch;
    private string _personSearchText = "";
    private List<PersonItem> _personSearchResults = [];

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadDropdowns());
        await LoadData();
    }

    private async Task LoadDropdowns()
    {
        try
        {
            var typesTask = Http.GetFromJsonAsync<List<CatalogItem>>("/api/accounting/voucher-types?pageSize=100");
            var branchTask = Http.GetFromJsonAsync<List<CatalogItem>>("/api/core/branches?pageSize=200");
            var ccTask = Http.GetFromJsonAsync<List<CatalogItem>>("/api/accounting/cost-centers?pageSize=200");

            await Task.WhenAll(typesTask, branchTask, ccTask);

            var types = typesTask.Result;
            var branchItems = branchTask.Result;
            var ccItems = ccTask.Result;

            if (types is not null) _voucherTypes = [new("", "Todos"), .. types.Select(t => new DropOption(t.Code, $"{t.Code} - {t.Name}"))];
            if (branchItems is not null) _branches = [new("", "Todas"), .. branchItems.Select(b => new DropOption(b.Code, $"{b.Code} - {b.Name}"))];
            if (ccItems is not null) _costCenters = [new("", "Todos"), .. ccItems.Select(c => new DropOption(c.Code, $"{c.Code} - {c.Name}"))];
        }
        catch { /* keep defaults */ }
    }

    private async Task LoadData()
    {
        try
        {
            var url = "/api/accounting/journal-entries?pageSize=500";
            if (_dateFrom.HasValue) url += $"&dateFrom={_dateFrom:yyyy-MM-dd}";
            if (_dateTo.HasValue) url += $"&dateTo={_dateTo:yyyy-MM-dd}";
            if (!string.IsNullOrEmpty(_accountFilter)) url += $"&accountCode={_accountFilter}";
            if (!string.IsNullOrEmpty(_personFilter)) url += $"&personCode={_personFilter}";
            if (!string.IsNullOrEmpty(_voucherTypeFilter)) url += $"&voucherType={_voucherTypeFilter}";
            if (!string.IsNullOrEmpty(_branchFilter)) url += $"&branchCode={_branchFilter}";
            if (!string.IsNullOrEmpty(_costCenterFilter)) url += $"&costCenterCode={_costCenterFilter}";

            var r = await Http.GetFromJsonAsync<PagedResult<JournalEntryItem>>(url);
            _items = r?.Items ?? [];
        }
        catch
        {
            _items = [];
            await Notification.ErrorAsync("Error al cargar movimientos");
        }
    }

    private void ClearFilters()
    {
        _dateFrom = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        _dateTo = DateTime.Today;
        _accountFilter = "";
        _personFilter = "";
        _voucherTypeFilter = "";
        _branchFilter = "";
        _costCenterFilter = "";
    }

    private async Task ExportExcel()
    {
        if (_grid is not null)
            await _grid.ExportToExcelAsync();
    }

    // Account search
    private async Task SearchAccounts()
    {
        try
        {
            _accountSearchResults = await Http.GetFromJsonAsync<List<AccountItem>>(
                $"/api/accounting/chart-of-accounts?search={_accountSearchText}&pageSize=50") ?? [];
        }
        catch { _accountSearchResults = []; }
    }

    private void OnAccountSelected(RowSelectEventArgs<AccountItem> args)
    {
        if (args.Data is not null) _accountFilter = args.Data.AccountCode;
        _showAccountSearch = false;
    }

    // Person search
    private async Task SearchPersons()
    {
        try
        {
            _personSearchResults = await Http.GetFromJsonAsync<List<PersonItem>>(
                $"/api/core/people?search={_personSearchText}&pageSize=50") ?? [];
        }
        catch { _personSearchResults = []; }
    }

    private void OnPersonSelected(RowSelectEventArgs<PersonItem> args)
    {
        if (args.Data is not null) _personFilter = args.Data.IdentificationNumber;
        _showPersonSearch = false;
    }

    // Models
    private class PagedResult<T> { public List<T> Items { get; set; } = []; public int TotalCount { get; set; } }

    private class JournalEntryItem
    {
        public DateTime DocumentDate { get; set; }
        public string VoucherTypeCode { get; set; } = "";
        public long DocumentNumber { get; set; }
        public string AccountCode { get; set; } = "";
        public string AccountName { get; set; } = "";
        public string PersonCode { get; set; } = "";
        public string PersonName { get; set; } = "";
        public string Description { get; set; } = "";
        public decimal Debit { get; set; }
        public decimal Credit { get; set; }
    }

    private class CatalogItem
    {
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
    }

    private class AccountItem
    {
        public string AccountCode { get; set; } = "";
        public string Name { get; set; } = "";
    }

    private class PersonItem
    {
        public string IdentificationNumber { get; set; } = "";
        public string FullName { get; set; } = "";
    }

    private record DropOption(string Value, string Name);
}
