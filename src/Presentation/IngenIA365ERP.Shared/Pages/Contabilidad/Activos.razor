    private void Nuevo()
    {
        _m = new Modelo();
        _editandoId = null;
        _bloqueado = false;
        _motivo = "";
        _editando = true;
    }

    private void Editar(ActivoDto a)
    {
        _m = new Modelo
        {
            Code = a.Code, Name = a.Name, Kind = a.Kind,
            AssetAccountCode = a.AssetAccount.Code, AccumulatedAccountCode = a.AccumulatedAccount?.Code, ExpenseAccountCode = a.ExpenseAccount.Code,
            BranchPublicId = a.BranchPublicId.ToString(), CostCenterPublicId = a.CostCenterPublicId?.ToString() ?? "",
            Supplier = a.SupplierPersonPublicId is { } s ? new PersonSearchPicker.PersonSearchItem { PublicId = s, FullName = a.SupplierName ?? "" } : null,
            PurchaseDate = a.PurchaseDate.ToDateTime(TimeOnly.MinValue), PurchaseDocument = a.PurchaseDocument, Cost = a.Cost, ResidualValue = a.ResidualValue,
            LifeMonths = a.LifeMonths, StartDate = a.StartDate.ToDateTime(TimeOnly.MinValue), OpeningAccumulated = a.OpeningAccumulated, OpeningElapsedMonths = a.OpeningElapsedMonths,
        };
        _editandoId = a.PublicId;
        _bloqueado = a.HasPostedInstallments;
        _motivo = "";
        _ficha = null;
        _editando = true;
    }

    private async Task GuardarAsync()
    {
        // El buscador resuelve el código inicial a la cuenta al abrir; si no lo hizo, la cuenta sigue siendo la que el activo traía.
        var cuentaActivo = _m.AssetAccount?.PublicId;
        var cuentaGasto = _m.ExpenseAccount?.PublicId;
        if (cuentaActivo is null || cuentaGasto is null || !Guid.TryParse(_m.BranchPublicId, out var sucursal))
        {
            await Notification.WarningAsync("Indique la cuenta del activo, la de gasto y la sucursal.");
            return;
        }
        var input = new ActivoInput(_m.Code, _m.Name, _m.Kind, cuentaActivo.Value, _m.AccumulatedAccount?.PublicId, cuentaGasto.Value, sucursal,
            Guid.TryParse(_m.CostCenterPublicId, out var centro) ? centro : null, _m.Supplier?.PublicId,
            DateOnly.FromDateTime(_m.PurchaseDate), _m.PurchaseDocument, _m.Cost, _m.ResidualValue, _m.LifeMonths,
            new DateOnly(_m.StartDate.Year, _m.StartDate.Month, 1), _m.OpeningAccumulated, _m.OpeningElapsedMonths);
        using var guardado = _guardado.Iniciar();
        if (_editandoId is { } id)
        {
            var r = await Contabilidad.CorregirActivoAsync(id, input, string.IsNullOrWhiteSpace(_motivo) ? null : _motivo.Trim());
            if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo corregir el activo."); return; }
            await Notification.SuccessAsync("Activo corregido.");
        }
        else
        {
            var r = await Contabilidad.RegistrarActivoAsync(input);
            if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo registrar el activo."); return; }
            await Notification.SuccessAsync("Activo registrado.");
        }
        _editando = false;
        await CargarAsync();
    }

    private void AbrirBaja(ActivoDto a)
    {
        _aDarDeBaja = a;
        _ficha = null;
        _fechaBaja = DateTime.Today;
        _cuentaBaja = null;
        _motivo = "";
    }

    private async Task DarDeBajaAsync()
    {
        if (_aDarDeBaja is not { } a || _cuentaBaja is not { } cuenta) return;
        using var guardado = _guardado.Iniciar();
        var r = await Contabilidad.DarDeBajaActivoAsync(a.PublicId, DateOnly.FromDateTime(_fechaBaja), cuenta.PublicId, _motivo.Trim());
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo dar de baja el activo."); return; }
        await Notification.SuccessAsync("Activo dado de baja.");
        _aDarDeBaja = null;
        await CargarAsync();
    }

