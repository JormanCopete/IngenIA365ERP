    private async Task CorrerAsync()
    {
        using (_corriendo.Iniciar())
        {
            var r = await Contabilidad.CorrerDepreciacionAsync(_anio, _mes);
            if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo correr la depreciación."); return; }
            await Notification.SuccessAsync($"Depreciación contabilizada: {r.Value!.DocumentNumber} por {Pesos(r.Value.Total)}.");
        }
        _vista = null;
        await CargarCorridasAsync();
        await CargarAsync();
    }

    private async Task ReversarAsync()
    {
        if (_aReversar is not { } corrida) return;
        using (_corriendo.Iniciar())
        {
            var r = await Contabilidad.ReversarCorridaDeActivosAsync(corrida.PublicId, _motivo.Trim());
            if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo reversar la corrida."); return; }
            await Notification.SuccessAsync($"Corrida reversada con {r.Value!.ReversalDocumentNumber}.");
        }
        _aReversar = null;
        await CargarCorridasAsync();
        await CargarAsync();
    }

    private static string Pesos(decimal valor) => valor.ToString("C0", Cultura);
