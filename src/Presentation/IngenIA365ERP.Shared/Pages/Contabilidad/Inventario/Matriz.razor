    }

    private void ElegirTarifa(string? codigo)
    {
        _f.Tarifa = string.IsNullOrWhiteSpace(codigo) ? null : codigo;
        var fecha = _f.Desde ?? DateOnly.FromDateTime(DateTime.Today);
        var vigente = _catalogo?.Dimensions.TaxRates.Where(t => t.Code == codigo && t.ValidFrom <= fecha && (t.ValidTo is null || t.ValidTo >= fecha))
            .OrderByDescending(t => t.ValidFrom).FirstOrDefault();
        _f.TarifaEnPuntos = vigente?.Rate is { } r ? r * 100m : null;
    }

    /// <summary>Al elegir la cuenta se leen sus reglas y se muestran (FR-016 de la 009).</summary>
    private async Task ElegirCuentaAsync(CuentaBuscadaDto? cuenta)
    {
        _cuenta = cuenta;
        _reglasDeLaCuenta = null;
        if (cuenta is null) return;
        using var carga = _cargaCuenta.Iniciar();
        var r = await Contabilidad.ObtenerCuentaAsync(cuenta.PublicId);
        if (r.IsSuccess && r.Value is { } c) _reglasDeLaCuenta = ReglasDeCuentaModelo.Desde(c);
    }

    private async Task CrearAsync()
    {
        if (!PuedeCrear) return;
        using var guardado = _guardado.Iniciar();
        var permitidas = DimensionesDelRol.ToHashSet();
        string? Si(string dimension, string? valor) => permitidas.Contains(dimension) && !string.IsNullOrWhiteSpace(valor) ? valor : null;
        var dimensiones = new DimensionesDeReglaDeInventarioRequest(
            Si("accountingGroupCode", _f.Grupo), Si("warehouseCode", _f.Bodega), Si("pointOfSaleCode", _f.Punto), Si("paymentMeansCode", _f.Medio),
            Si("taxRateCode", _f.Tarifa), permitidas.Contains("taxRate") && _f.TarifaEnPuntos is { } p ? p / 100m : null, Si("reasonCode", _f.Causa),
            permitidas.Contains("branch") ? _f.Sucursal : null, permitidas.Contains("costCenter") ? _f.Centro : null);
        var r = await Integracion.CrearReglaAsync(new CrearReglaDeInventarioRequest(_f.Operacion!, _f.Rol!, dimensiones, _cuenta!.PublicId, _f.Desde!.Value,
            string.IsNullOrWhiteSpace(_f.Notas) ? null : _f.Notas.Trim(), _f.Motivo!.Trim(), _f.Hasta));
        if (!r.IsSuccess || r.Value is null)
        {
            await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo guardar la regla.");
            return;
        }
        _mostrarAlta = false;
        await AvisarAsync(r.Value, "Regla guardada.");
        _resaltada = r.Value.RulePublicId;
        await CargarAsync();
    }

    private async Task GuardarVersionAsync()
    {
        if (_editando is null || _cuenta is null || _f.Desde is not { } desde || string.IsNullOrWhiteSpace(_f.Motivo)) return;
        using var guardado = _guardado.Iniciar();
        var r = await Integracion.NuevaVersionDeReglaAsync(_editando.RulePublicId, new VersionDeReglaDeInventarioRequest(_cuenta.PublicId, desde,
            string.IsNullOrWhiteSpace(_f.Notas) ? null : _f.Notas.Trim(), _f.Motivo.Trim()));
        if (!r.IsSuccess || r.Value is null)
        {
            await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo guardar la versión.");
            return;
        }
        _mostrarVersion = false;
        await AvisarAsync(r.Value, "Versión guardada: la anterior se cerró la víspera.");
        _resaltada = r.Value.RulePublicId;
        await CargarAsync();
    }

    private async Task DesactivarAsync()
    {
        if (_editando is null || _f.Hasta is not { } hasta || string.IsNullOrWhiteSpace(_f.Motivo)) return;
        using var guardado = _guardado.Iniciar();
        var r = await Integracion.DesactivarReglaAsync(_editando.RulePublicId, new DesactivarReglaDeInventarioRequest(hasta, _f.Motivo.Trim()));
        if (!r.IsSuccess)
        {
            await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo desactivar la regla.");
            return;
        }
        _mostrarDesactivar = false;
        await Notification.SuccessAsync("Regla desactivada.");
        await CargarAsync();
    }

    private async Task AvisarAsync(ReglaGuardadaDeInventarioDto guardada, string exito)
    {
        await Notification.SuccessAsync(exito);
        foreach (var aviso in guardada.Warnings) await Notification.WarningAsync(aviso.Message);
    }

    private static string Dimensiones(DimensionesDeReglaDeInventarioDto d)
    {
        var partes = new[]
        {
            d.AccountingGroupCode is { } g ? $"grupo {g}" : null,
            d.WarehouseCode is { } w ? $"bodega {w}" : null,
            d.PointOfSaleCode is { } p ? $"punto {p}" : null,
            d.PaymentMeansCode is { } m ? $"medio {m}" : null,
            d.TaxRateCode is { } t ? $"tarifa {t}{(d.TaxRate is { } v ? $" {v * 100m:0.####} %" : "")}" : null,
            d.ReasonCode is { } r ? $"causa {r}" : null,
            d.Branch is { } b ? $"sucursal {b.Code}" : null,
            d.CostCenter is { } c ? $"centro {c.Code}" : null,
        }.Where(x => x is not null).ToList();
        return partes.Count == 0 ? "Todas" : string.Join(" · ", partes);
    }

    private static DateOnly? LeerFecha(object? valor) =>
        DateOnly.TryParse(valor?.ToString(), System.Globalization.CultureInfo.InvariantCulture, out var f) ? f : null;
}
