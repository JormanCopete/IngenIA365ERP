@page "/contabilidad/apertura"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using IngenIA365ERP.Shared.Services.Contabilidad
@using IngenIA365ERP.Shared.Services.Nomina
@inject ContabilidadClient Contabilidad
@inject INotificationService Notification
@inject NavigationManager Navigation
@inject DescargaDeArchivos Descargas

<PageTitle>Saldos de apertura - IngenIA365ERP</PageTitle>

@* Feature 009 E2, US13 (FR-084..FR-087): la cooperativa que llega desde SOLIDO carga una sola vez
   los saldos con que arranca. Se descarga la plantilla, se llena, se importa: cada fila se valida con
   las reglas de cuenta y con un solo error no se guarda nada. Lo que queda es un borrador AP fechado
   la víspera del primer período, que se revisa y se contabiliza en Comprobantes como cualquier otro;
   a lo sumo una apertura contabilizada y no reversada por empresa. *@
<PermissionGate Required="Accounting.Opening.Manage" MostrarAviso="true">
<div class="page-header">
    <h3>Saldos de apertura</h3>
    <div class="toolbar">
        <SfButton CssClass="e-outline" IconCss="e-icons e-refresh" OnClick="@CargarAsync">Actualizar</SfButton>
        <SfButton CssClass="e-outline" IconCss="e-icons e-download" Disabled="@(_ocupado || _estado is null)" OnClick="@DescargarPlantillaAsync">Plantilla Excel</SfButton>
        <SfButton CssClass="e-primary" IconCss="e-icons e-upload-1" Disabled="@(_ocupado || _estado is null || _estado.Posted is not null)" OnClick="@(() => { _errores = []; _archivo = null; _importando = true; })"
                  title="@(_estado?.Posted is not null ? "Ya hay una apertura contabilizada: reverse la existente antes de cargar otra" : "")">Importar archivo</SfButton>
    </div>
</div>

<IndicadorDeCarga Cargando="@_carga.Activa">
    @if (_estado is null)
    {
        @if (_cargado)
        {
            <div class="info-card"><span class="label">Sin contabilidad</span><p>La contabilidad no está iniciada. Vaya a Contabilidad › Configuración inicial y luego abra el primer ejercicio.</p></div>
        }
    }
    else
    {
        <div class="info-card">
            <span class="label">Cómo funciona</span>
            <p>Se propone fecharlo el <strong>@_estado.ExpectedDate.ToString("yyyy-MM-dd")</strong> (la víspera del primer período del ejercicio @_estado.FirstFiscalYear), pero puede elegir el corte real de su contabilidad anterior hasta el <strong>@_estado.MaxDate.ToString("yyyy-MM-dd")</strong>.
               En consultas e informes la apertura es <em>saldo inicial</em>, no movimiento del mes, cualquiera sea su fecha.
               Descargue la plantilla, llénela con una fila por cuenta de movimiento (y por tercero y documento donde la cuenta lo exige) e impórtela: si una fila falla, se indica cuál y no se guarda nada. El archivo no tiene que cuadrar para importarse; cuadrar es requisito para contabilizar.
               Mientras el comprobante sea borrador todo se puede corregir —agregar, cambiar o quitar cuentas, y la fecha—; una vez contabilizado, sólo se reversa.</p>
        </div>

        @if (_estado.Posted is { } vigente)
        {
            <div class="info-card">
                <span class="label">Apertura vigente</span>
                <p>AP-@vigente.Number del @vigente.Date.ToString("yyyy-MM-dd"): @vigente.Lines líneas, débitos @vigente.TotalDebit.ToString("N2") y créditos @vigente.TotalCredit.ToString("N2"). Contabilizó @vigente.PostedBy el @(vigente.PostedAt?.ToLocalTime().ToString("yyyy-MM-dd") ?? "").
                   Para cargar otra, primero reverse ésta desde el comprobante; las dos quedan referenciadas y auditadas.</p>
                <div class="toolbar">
                    <SfButton CssClass="e-outline" OnClick="@(() => Navigation.NavigateTo($"/contabilidad/comprobantes/{vigente.PublicId}"))">Ver el comprobante</SfButton>
                    <SfButton CssClass="e-outline" OnClick="@(() => Navigation.NavigateTo($"/contabilidad/informes?vista=trial-balance&from={_estado.FirstFiscalYear}-01-01&to={_estado.FirstFiscalYear}-01-31"))">Balance de prueba del primer mes</SfButton>
                </div>
            </div>
        }
        else
        {
            <div class="info-card"><span class="label">Sin apertura contabilizada</span><p>Los informes arrancan en cero hasta que se contabilice un comprobante de apertura.</p></div>
        }

        @if (_estado.Drafts.Count > 0)
        {
            <h4>Borrador en preparación</h4>
            <p class="texto-apoyo">«Editar» abre el comprobante: ahí se agregan, cambian y quitan cuentas línea a línea, con las reglas de cada una, y se contabiliza cuando cuadre (permiso de contabilizar; cuatro ojos si la empresa lo exige). «Cambiar la fecha» la mueve sin tocar las líneas. Volver a importar reemplaza todas las líneas por las del archivo nuevo.</p>
            <table class="data-grid">
                <thead><tr><th>Fecha</th><th class="num">Líneas</th><th class="num">Débitos</th><th class="num">Créditos</th><th class="num">Diferencia</th><th>Registró</th><th>Acciones</th></tr></thead>
                <tbody>
                    @foreach (var d in _estado.Drafts)
                    {
                        <tr>
                            <td>@d.Date.ToString("yyyy-MM-dd")</td><td class="num">@d.Lines</td>
                            <td class="num">@d.TotalDebit.ToString("N2")</td><td class="num">@d.TotalCredit.ToString("N2")</td>
                            <td class="num">@((d.TotalDebit - d.TotalCredit) == 0 ? "cuadra" : (d.TotalDebit - d.TotalCredit).ToString("N2"))</td>
                            <td>@d.RegisteredBy</td>
                            <td class="acciones">
                                <button type="button" class="enlace" @onclick="@(() => Navigation.NavigateTo($"/contabilidad/comprobantes/{d.PublicId}"))">Editar</button>
                                <button type="button" class="enlace" @onclick="@(() => { _aFechar = d; _nuevaFecha = d.Date.ToDateTime(TimeOnly.MinValue); })">Cambiar la fecha</button>
                                <button type="button" class="enlace" @onclick="@(() => _aDescartar = d)">Descartar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (_estado.Reversed.Count > 0)
        {
            <h4>Aperturas reversadas</h4>
            <table class="data-grid filas-clicables">
                <thead><tr><th>Comprobante</th><th>Fecha</th><th class="num">Líneas</th><th class="num">Débitos</th><th>Contabilizó</th><th>Reversión</th></tr></thead>
                <tbody>
                    @foreach (var r in _estado.Reversed)
                    {
                        <tr class="clicable" tabindex="0" @onclick="@(() => Navigation.NavigateTo($"/contabilidad/comprobantes/{r.PublicId}"))">
                            <td>AP-@r.Number</td><td>@r.Date.ToString("yyyy-MM-dd")</td><td class="num">@r.Lines</td><td class="num">@r.TotalDebit.ToString("N2")</td><td>@r.PostedBy</td>
                            <td>@if (r.ReversedByPublicId is { } rev) { <a class="enlace" href="/contabilidad/comprobantes/@rev" @onclick:stopPropagation="true">ver reversión</a> }</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
</IndicadorDeCarga>

<SfDialog @bind-Visible="_importando" Header="Importar saldos de apertura" Width="640px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@_guardado.Activa" Texto="Validando el archivo…">
            <div class="pagina">
                <p class="texto-apoyo">Excel o CSV con las columnas de la plantilla: <code>cuenta</code>, <code>tercero</code>, <code>tipoDocumento</code>, <code>numeroDocumento</code>, <code>centroCosto</code>, <code>sucursal</code>, <code>debito</code>, <code>credito</code>, <code>detalle</code>.
                   Cada fila se valida con las reglas de su cuenta; con un solo error no se guarda nada.</p>
                <label class="campo">Fecha del comprobante
                    <SfDatePicker TValue="DateTime" @bind-Value="_fecha" Format="yyyy-MM-dd" Min="_minimo" Max="_maximo" />
                    <span class="hint">El corte de los saldos que trae el archivo. Se propone la víspera del primer período; el tope es el fin del primer ejercicio.</span>
                </label>
                @if (_estado?.Drafts.Count > 0)
                {
                    <p class="texto-alerta">Ya hay un borrador de apertura: al importar, sus @(_estado.Drafts[0].Lines) línea(s) se reemplazan por las del archivo.</p>
                }
                <InputFile OnChange="@ArchivoElegido" accept=".xlsx,.csv,.txt" />
                @if (_errores.Count > 0)
                {
                    <p class="texto-alerta">@_errores.Count error(es). Corrija el archivo y vuelva a importarlo.</p>
                    <div class="tabla-desplazable">
                        <table class="data-grid">
                            <thead><tr><th>Fila</th><th>Columna</th><th>Problema</th></tr></thead>
                            <tbody>
                                @foreach (var e in _errores) { <tr><td>@e.Row</td><td>@e.Column</td><td>@e.Message</td></tr> }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
            </IndicadorDeCarga>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _importando = false)" />
        <DialogButton Content="Importar" IsPrimary="true" OnClick="@ImportarAsync" Disabled="@(_guardado.Activa || _archivo is null)" />
    </DialogButtons>
</SfDialog>

<SfDialog Visible="@(_aFechar is not null)" Header="Cambiar la fecha de la apertura" Width="460px" IsModal="true" ShowCloseIcon="true" VisibleChanged="@(v => { if (!v) _aFechar = null; })">
    <DialogTemplates>
        <Content>
            <p>La fecha es el corte de los saldos. Las líneas no cambian; todas quedan con la fecha nueva.</p>
            <label class="campo">Fecha
                <SfDatePicker TValue="DateTime" @bind-Value="_nuevaFecha" Format="yyyy-MM-dd" Min="_minimo" Max="_maximo" />
            </label>
            <div class="toolbar">
                <SfButton CssClass="e-primary" Disabled="@_ocupado" OnClick="@CambiarFechaAsync">Guardar</SfButton>
                <SfButton CssClass="e-outline" OnClick="@(() => _aFechar = null)">Cancelar</SfButton>
            </div>
        </Content>
    </DialogTemplates>
</SfDialog>

<SfDialog Visible="@(_aDescartar is not null)" Header="Descartar el borrador de apertura" Width="460px" IsModal="true" ShowCloseIcon="true" VisibleChanged="@(v => { if (!v) CerrarDescarte(); })">
    <DialogTemplates>
        <Content>
            <p>Se descarta el borrador con sus @(_aDescartar?.Lines) línea(s). No afecta a ningún saldo: todavía no está contabilizado. Puede volver a importar el archivo cuando quiera.</p>
            @if (_confirmarDescarteConSoportes)
            {
                <p class="aviso aviso-alerta">Tiene @_soportesPorBorrar @(_soportesPorBorrar == 1 ? "soporte" : "soportes"); se borrarán y quedarán 90 días en la papelera.</p>
            }
            <div class="toolbar">
                @if (_confirmarDescarteConSoportes)
                {
                    <SfButton CssClass="e-danger" Disabled="@_ocupado" OnClick="@(() => DescartarAsync(borrarSoportes: true))">Descartar y borrar soportes</SfButton>
                }
                else
                {
                    <SfButton CssClass="e-danger" Disabled="@_ocupado" OnClick="@(() => DescartarAsync(borrarSoportes: false))">Descartar</SfButton>
                }
                <SfButton CssClass="e-outline" OnClick="@CerrarDescarte">Cancelar</SfButton>
            </div>
        </Content>
    </DialogTemplates>
</SfDialog>
</PermissionGate>

@code {
    private readonly EstadoDeCarga _carga = new();
    private readonly EstadoDeCarga _guardado = new();
    private EstadoDeAperturaDto? _estado;
    private bool _cargado, _ocupado, _importando;
    private IBrowserFile? _archivo;
    private List<ErrorDeFilaDto> _errores = [];
    private DateTime _fecha = DateTime.Today, _nuevaFecha = DateTime.Today;
    private DateTime _minimo = DateTime.Today, _maximo = DateTime.Today;
    private AperturaResumenDto? _aFechar, _aDescartar;
    private bool _confirmarDescarteConSoportes;
    private int _soportesPorBorrar;

    private void CerrarDescarte()
    {
        _aDescartar = null;
        _confirmarDescarteConSoportes = false;
    }

    protected override Task OnInitializedAsync() => CargarAsync();

    private async Task CargarAsync()
    {
        using var carga = _carga.Iniciar();
        var r = await Contabilidad.EstadoDeAperturaAsync();
        _cargado = true;
        if (!r.IsSuccess)
        {
            _estado = null;
            if (r.ErrorCode != "Accounting.NotInitialized" && r.ErrorCode != "Accounting.FiscalYear.NotFound")
                await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo consultar la apertura.");
            return;
        }
        _estado = r.Value;
        _fecha = (_estado.Drafts.FirstOrDefault()?.Date ?? _estado.ExpectedDate).ToDateTime(TimeOnly.MinValue);
        _minimo = _estado.ExpectedDate.ToDateTime(TimeOnly.MinValue);
        _maximo = _estado.MaxDate.ToDateTime(TimeOnly.MinValue);
    }

    /// <summary>Mueve la fecha del borrador sin tocar sus líneas: se reenvía tal cual con la fecha nueva.</summary>
    private async Task CambiarFechaAsync()
    {
        if (_aFechar is null) return;
        _ocupado = true;
        try
        {
            var comprobante = await Contabilidad.ObtenerComprobanteAsync(_aFechar.PublicId);
            if (!comprobante.IsSuccess) { await Notification.ErrorAsync(comprobante.ErrorMessage ?? "No se pudo leer el borrador."); return; }
            var lineas = comprobante.Value!.Lines
                .Select(l => new LineaDeBorradorRequest(l.AccountCode, l.BranchPublicId, l.CostCenterPublicId, l.PersonPublicId,
                    l.CrossDocumentType, l.CrossDocumentNumber, l.Debit, l.Credit, l.Detail, l.TaxBase))
                .ToList();
            var guardado = await Contabilidad.ActualizarBorradorAsync(_aFechar.PublicId, new BorradorRequest(comprobante.Value.VoucherTypeCode,
                DateOnly.FromDateTime(_nuevaFecha), comprobante.Value.Description, lineas));
            if (!guardado.IsSuccess) { await Notification.ErrorAsync(guardado.ErrorMessage ?? "No se pudo cambiar la fecha."); return; }
            _aFechar = null;
            await Notification.SuccessAsync($"La apertura quedó fechada el {_nuevaFecha:yyyy-MM-dd}.");
            await CargarAsync();
        }
        finally { _ocupado = false; }
    }

    private async Task DescartarAsync(bool borrarSoportes)
    {
        if (_aDescartar is null) return;
        _ocupado = true;
        try
        {
            var r = await Contabilidad.DescartarBorradorAsync(_aDescartar.PublicId, borrarSoportes);
            if (!r.IsSuccess && r.ErrorCode == ContabilidadClient.CodigoTieneSoportes)
            {
                // Feature 011 (FR-005): los soportes de la apertura tampoco se borran sin confirmarlo.
                _soportesPorBorrar = r.Entero("count") ?? 0;
                _confirmarDescarteConSoportes = true;
                return;
            }
            if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo descartar el borrador."); return; }
            CerrarDescarte();
            await Notification.SuccessAsync("Borrador descartado.");
            await CargarAsync();
        }
        finally { _ocupado = false; }
    }

    private async Task DescargarPlantillaAsync()
    {
        _ocupado = true;
        try
        {
            var r = await Contabilidad.PlantillaDeAperturaAsync();
            if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo descargar la plantilla."); return; }
            await Descargas.GuardarAsync(r.Value!.Nombre, r.Value.TipoContenido, r.Value.Contenido);
        }
        finally { _ocupado = false; }
    }

    private void ArchivoElegido(InputFileChangeEventArgs e)
    {
        _archivo = e.File;
        _errores = [];
    }

    private async Task ImportarAsync()
    {
        if (_archivo is null) return;
        using var guardado = _guardado.Iniciar();
        _errores = [];
        byte[] bytes;
        try
        {
            using var ms = new MemoryStream();
            await _archivo.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(ms);
            bytes = ms.ToArray();
        }
        catch (IOException ex)
        {
            await Notification.ErrorAsync($"No se pudo leer el archivo: {ex.Message}");
            return;
        }
        var r = await Contabilidad.ImportarAperturaAsync(_archivo.Name, bytes, DateOnly.FromDateTime(_fecha));
        if (!r.IsSuccess)
        {
            _errores = r.ErroresDeFila();
            await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo importar la apertura.");
            return;
        }
        var v = r.Value!;
        var diferencia = v.TotalDebit - v.TotalCredit;
        var que = v.Replaced ? "actualizado" : "creado";
        await Notification.SuccessAsync(diferencia == 0
            ? $"Borrador de apertura {que} con {v.Lines} líneas al {v.Date:yyyy-MM-dd}; cuadra. Revíselo y contabilícelo."
            : $"Borrador de apertura {que} con {v.Lines} líneas al {v.Date:yyyy-MM-dd}; no cuadra (diferencia {diferencia:N2}): corríjalo antes de contabilizar.");
        _importando = false;
        _archivo = null;
        Navigation.NavigateTo($"/contabilidad/comprobantes/{v.DraftPublicId}");
    }
}
