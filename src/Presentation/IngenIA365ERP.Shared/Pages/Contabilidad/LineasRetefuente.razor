@page "/contabilidad/impuestos/retefuente"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification

<PageTitle>Lineas de Retefuente - IngenIA365ERP</PageTitle>

<div class="page-header">
    <h3>Lineas de Retefuente</h3>
    <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@OpenCreate">Nuevo</SfButton>
</div>

<SfGrid @ref="_grid" TValue="TaxLineItem" DataSource="@_items"
    AllowPaging="true" AllowSorting="true" AllowFiltering="true">
    <GridColumns>
        <GridColumn Field="LineCode" HeaderText="Codigo Linea" Width="150" />
        <GridColumn Field="Description" HeaderText="Descripcion" Width="300" />
        <GridColumn Field="TaxRate" HeaderText="Tarifa (%)" Width="130" Format="N2" TextAlign="TextAlign.Right" />
        <GridColumn Field="AccountCode" HeaderText="Cuenta Contable" Width="180" />
        <GridColumn HeaderText="Acciones" Width="150" TextAlign="TextAlign.Center">
            <Template>
                @{
                    var item = context as TaxLineItem;
                    <SfButton CssClass="e-flat e-small" IconCss="e-icons e-edit" OnClick="@(() => OpenEdit(item!))" />
                    <SfButton CssClass="e-flat e-small e-danger" IconCss="e-icons e-trash" OnClick="@(() => OpenDelete(item!))" />
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

<SfDialog @bind-Visible="_showDialog" Header="@_dialogTitle" Width="500px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <div style="padding:10px;display:flex;flex-direction:column;gap:16px;">
                <div>
                    <label>Codigo Linea *</label>
                    <SfTextBox @bind-Value="_model.LineCode" Placeholder="Codigo de la linea" />
                </div>
                <div>
                    <label>Descripcion *</label>
                    <SfTextBox @bind-Value="_model.Description" Placeholder="Descripcion" />
                </div>
                <div>
                    <label>Tarifa (%)</label>
                    <SfNumericTextBox TValue="decimal?" @bind-Value="_model.TaxRate"
                        Placeholder="0.00" Decimals="2" Format="N2" Min="0" Max="100" Step="0.01m" />
                </div>
                <div>
                    <label>Cuenta Contable</label>
                    <SfTextBox @bind-Value="_model.AccountCode" Placeholder="Codigo cuenta contable" />
                </div>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _showDialog = false)" />
        <DialogButton Content="Guardar" IsPrimary="true" OnClick="@Save" />
    </DialogButtons>
</SfDialog>

<ConfirmDialog @bind-Visible="_showConfirm" OnConfirm="ConfirmDelete"
    Message="Esta seguro de eliminar este registro?" />

@code {
    private SfGrid<TaxLineItem>? _grid;
    private List<TaxLineItem> _items = [];
    private TaxLineModel _model = new();
    private Guid? _editId;
    private bool _showDialog, _showConfirm;
    private string _dialogTitle = "";
    private Guid _deleteId;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        try { _items = await Http.GetFromJsonAsync<List<TaxLineItem>>("/api/accounting/withholding-tax-lines?pageSize=500") ?? []; }
        catch { _items = []; }
    }

    private void OpenCreate() { _model = new(); _editId = null; _dialogTitle = "Nueva Linea de Retefuente"; _showDialog = true; }

    private void OpenEdit(TaxLineItem item)
    {
        _model = new()
        {
            LineCode = item.LineCode,
            Description = item.Description,
            TaxRate = item.TaxRate,
            AccountCode = item.AccountCode
        };
        _editId = item.PublicId;
        _dialogTitle = "Editar Linea de Retefuente";
        _showDialog = true;
    }

    private void OpenDelete(TaxLineItem item) { _deleteId = item.PublicId; _showConfirm = true; }

    private async Task Save()
    {
        HttpResponseMessage res;
        if (_editId.HasValue)
            res = await Http.PutAsJsonAsync($"/api/accounting/withholding-tax-lines/{_editId}", _model);
        else
            res = await Http.PostAsJsonAsync("/api/accounting/withholding-tax-lines", _model);

        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro guardado");
            _showDialog = false;
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al guardar");
    }

    private async Task ConfirmDelete()
    {
        var res = await Http.DeleteAsync($"/api/accounting/withholding-tax-lines/{_deleteId}");
        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro eliminado");
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al eliminar");
    }

    private class TaxLineItem
    {
        public Guid PublicId { get; set; }
        public string LineCode { get; set; } = "";
        public string Description { get; set; } = "";
        public decimal? TaxRate { get; set; }
        public string? AccountCode { get; set; }
    }

    private class TaxLineModel
    {
        public string LineCode { get; set; } = "";
        public string Description { get; set; } = "";
        public decimal? TaxRate { get; set; }
        public string? AccountCode { get; set; }
    }
}
