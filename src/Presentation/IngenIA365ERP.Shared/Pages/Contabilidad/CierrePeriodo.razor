@page "/contabilidad/cierre-periodo"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification

<PageTitle>Cierre de Periodo - IngenIA365ERP</PageTitle>

<div class="pagina">
    <div class="page-header">
        <h3>Cierre de Periodo Contable</h3>
    </div>

    <!-- Period Selector -->
    <div class="toolbar">
        <div>
            <label>Ano</label>
            <SfNumericTextBox TValue="int" @bind-Value="_year" Min="2000" Max="2099" Format="####" Width="120px" CssClass="e-small" />
        </div>
        <div>
            <label>Mes</label>
            <SfDropDownList TValue="int" TItem="MonthOption" @bind-Value="_month" DataSource="_months" CssClass="e-small" Width="160px">
                <DropDownListFieldSettings Text="Name" Value="Value" />
            </SfDropDownList>
        </div>
        <SfButton CssClass="e-info e-small" IconCss="e-icons e-search" OnClick="LoadPreview">Consultar</SfButton>
    </div>

    @if (_loading)
    {
        <SfProgressBar Type="ProgressType.Linear" IsIndeterminate="true" Height="4"
                       TrackColor="var(--borde)" ProgressColor="var(--acento)" />
    }

    @if (_preview is not null)
    {
        <!-- Status and Validations -->
        <div class="rejilla-tarjetas">
            <div class="info-card">
                <span class="label">Estado</span>
                @{
                    var badge = _preview.Status == "C" ? "e-badge e-badge-success" : "e-badge e-badge-warning";
                    var text = _preview.Status == "C" ? "Cerrado" : "Abierto";
                }
                <span class="@badge" style="font-size:var(--texto-md);">@text</span>
            </div>
            <div class="info-card">
                <span class="label">Comprobantes en Borrador</span>
                <span class="@(_preview.DraftDocumentCount > 0 ? "text-danger" : "text-success")">@_preview.DraftDocumentCount</span>
            </div>
            <div class="info-card">
                <span class="label">Total Debitos</span>
                <span>@_preview.TotalDebit.ToString("N2")</span>
            </div>
            <div class="info-card">
                <span class="label">Total Creditos</span>
                <span>@_preview.TotalCredit.ToString("N2")</span>
            </div>
            <div class="info-card">
                <span class="label">Diferencia</span>
                <span class="@(_preview.Difference != 0 ? "text-danger" : "text-success")">@_preview.Difference.ToString("N2")</span>
            </div>
        </div>

        <!-- Checklist -->
        <div class="info-card">
            <h5>Validaciones</h5>
            <ul style="list-style:none;padding:0;">
                <li>@CheckIcon(_preview.DraftDocumentCount == 0) Sin comprobantes en borrador</li>
                <li>@CheckIcon(_preview.Difference == 0) Cuadre global (Debitos = Creditos)</li>
                <li>@CheckIcon(_preview.Status != "C") Periodo no cerrado previamente</li>
            </ul>
        </div>

        <!-- Actions -->
        <div class="acciones">
            @if (_preview.CanClose)
            {
                <SfButton CssClass="e-primary" IconCss="e-icons e-lock" OnClick="@(() => _showCloseConfirm = true)">Cerrar Periodo</SfButton>
            }
            else if (_preview.Status != "C")
            {
                <SfButton CssClass="e-primary" Disabled="true">Cerrar Periodo (Validaciones pendientes)</SfButton>
            }
            @if (_preview.Status == "C")
            {
                <SfButton CssClass="e-warning" IconCss="e-icons e-unlock" OnClick="@(() => _showReopenConfirm = true)">Reabrir Periodo</SfButton>
            }
        </div>
    }

    <!-- Trial Balance -->
    @if (_trialBalance is not null && _trialBalance.Count > 0)
    {
        <h4>Balance de Prueba</h4>
        <SfGrid TValue="TrialBalanceLine" DataSource="_trialBalance" AllowPaging="true" AllowSorting="true" AllowExcelExport="true" @ref="_trialGrid">
            <GridPageSettings PageSize="50" />
            <GridColumns>
                <GridColumn Field="AccountCode" HeaderText="Cuenta" Width="140" />
                <GridColumn Field="AccountName" HeaderText="Nombre" Width="300" />
                <GridColumn Field="Level" HeaderText="Nivel" Width="80" TextAlign="TextAlign.Center" />
                <GridColumn Field="Nature" HeaderText="Nat." Width="60" TextAlign="TextAlign.Center" />
                <GridColumn Field="PreviousBalance" HeaderText="Saldo Anterior" Width="160" Format="N2" TextAlign="TextAlign.Right" />
                <GridColumn Field="Debit" HeaderText="Debitos" Width="160" Format="N2" TextAlign="TextAlign.Right" />
                <GridColumn Field="Credit" HeaderText="Creditos" Width="160" Format="N2" TextAlign="TextAlign.Right" />
                <GridColumn Field="FinalBalance" HeaderText="Saldo Final" Width="160" Format="N2" TextAlign="TextAlign.Right" />
            </GridColumns>
        </SfGrid>
    }

    <ConfirmDialog @bind-Visible="_showCloseConfirm"
                   Title="Cerrar Periodo"
                   Message="@($"Esta seguro de cerrar el periodo {_year}-{_month:D2}? Esta operacion contabilizara todos los movimientos.")"
                   ConfirmText="Cerrar"
                   OnConfirm="ClosePeriod" />

    <ConfirmDialog @bind-Visible="_showReopenConfirm"
                   Title="Reabrir Periodo"
                   Message="@($"Esta seguro de reabrir el periodo {_year}-{_month:D2}?")"
                   ConfirmText="Reabrir"
                   OnConfirm="ReopenPeriod" />
</div>

@code {
    private SfGrid<TrialBalanceLine>? _trialGrid;
    private int _year = DateTime.Today.Year;
    private int _month = DateTime.Today.Month;
    private bool _loading;
    private PeriodPreview? _preview;
    private List<TrialBalanceLine>? _trialBalance;
    private bool _showCloseConfirm;
    private bool _showReopenConfirm;

    private static readonly List<MonthOption> _months =
    [
        new(1, "01 - Enero"), new(2, "02 - Febrero"), new(3, "03 - Marzo"),
        new(4, "04 - Abril"), new(5, "05 - Mayo"), new(6, "06 - Junio"),
        new(7, "07 - Julio"), new(8, "08 - Agosto"), new(9, "09 - Septiembre"),
        new(10, "10 - Octubre"), new(11, "11 - Noviembre"), new(12, "12 - Diciembre")
    ];

    private static MarkupString CheckIcon(bool ok) =>
        new(ok ? "<span style='color:var(--exito-texto);margin-right:var(--gap-sm);'>&#10004;</span>"
               : "<span style='color:var(--peligro-texto);margin-right:var(--gap-sm);'>&#10008;</span>");

    private async Task LoadPreview()
    {
        _loading = true;
        try
        {
            _preview = await Http.GetFromJsonAsync<PeriodPreview>(
                $"/api/accounting/periods/{_year}/{_month}/close-preview");

            _trialBalance = await Http.GetListAsync<TrialBalanceLine>(
                $"/api/accounting/trial-balance/{_year}/{_month}");
        }
        catch
        {
            await Notification.ErrorAsync("Error al cargar la informacion del periodo.");
        }
        _loading = false;
    }

    private async Task ClosePeriod()
    {
        _loading = true;
        try
        {
            var response = await Http.PostAsync($"/api/accounting/periods/{_year}/{_month}/close", null);
            if (response.IsSuccessStatusCode)
            {
                await Notification.SuccessAsync("Periodo cerrado exitosamente.");
                await LoadPreview();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                await Notification.ErrorAsync($"Error al cerrar: {error}");
            }
        }
        catch
        {
            await Notification.ErrorAsync("Error de conexion al cerrar el periodo.");
        }
        _loading = false;
    }

    private async Task ReopenPeriod()
    {
        _loading = true;
        try
        {
            var body = new { Reason = "Reapertura solicitada por usuario" };
            var response = await Http.PostAsJsonAsync($"/api/accounting/periods/{_year}/{_month}/reopen", body);
            if (response.IsSuccessStatusCode)
            {
                await Notification.SuccessAsync("Periodo reabierto exitosamente.");
                await LoadPreview();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                await Notification.ErrorAsync($"Error al reabrir: {error}");
            }
        }
        catch
        {
            await Notification.ErrorAsync("Error de conexion al reabrir el periodo.");
        }
        _loading = false;
    }

    private class PeriodPreview
    {
        public int Year { get; set; }
        public int Month { get; set; }
        public string Status { get; set; } = "";
        public int DraftDocumentCount { get; set; }
        public decimal TotalDebit { get; set; }
        public decimal TotalCredit { get; set; }
        public decimal Difference { get; set; }
        public bool CanClose { get; set; }
    }

    private class TrialBalanceLine
    {
        public string AccountCode { get; set; } = "";
        public string AccountName { get; set; } = "";
        public byte Level { get; set; }
        public string Nature { get; set; } = "";
        public decimal PreviousBalance { get; set; }
        public decimal Debit { get; set; }
        public decimal Credit { get; set; }
        public decimal FinalBalance { get; set; }
    }

    private record MonthOption(int Value, string Name);
}
