@page "/contabilidad/plan-cuentas"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification

<PageTitle>Plan de Cuentas - IngenIA365ERP</PageTitle>

<div class="page-header">
    <h3>Plan de Cuentas</h3>
    <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@OpenCreate">Nuevo</SfButton>
</div>

<SfGrid @ref="_grid" TValue="ChartAccountItem" DataSource="@_items"
    AllowPaging="true" AllowSorting="true" AllowFiltering="true">
    <GridColumns>
        <GridColumn Field="AccountCode" HeaderText="Codigo Cuenta" Width="180" />
        <GridColumn Field="Name" HeaderText="Nombre" Width="300" />
        <GridColumn Field="Level" HeaderText="Nivel" Width="100" TextAlign="TextAlign.Right" />
        <GridColumn Field="Nature" HeaderText="Naturaleza" Width="120" />
        <GridColumn HeaderText="Acciones" Width="150" TextAlign="TextAlign.Center">
            <Template>
                @{
                    var item = context as ChartAccountItem;
                    <SfButton CssClass="e-flat e-small" IconCss="e-icons e-edit" OnClick="@(() => OpenEdit(item!))" />
                    <SfButton CssClass="e-flat e-small e-danger" IconCss="e-icons e-trash" OnClick="@(() => OpenDelete(item!))" />
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

<SfDialog @bind-Visible="_showDialog" Header="@_dialogTitle" Width="500px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <div style="padding:10px;display:flex;flex-direction:column;gap:16px;">
                <div>
                    <label>Codigo Cuenta *</label>
                    <SfTextBox @bind-Value="_model.AccountCode" Placeholder="Codigo de la cuenta" />
                </div>
                <div>
                    <label>Nombre *</label>
                    <SfTextBox @bind-Value="_model.Name" Placeholder="Nombre de la cuenta" />
                </div>
                <div>
                    <label>Nivel</label>
                    <SfNumericTextBox TValue="int?" @bind-Value="_model.Level"
                        Placeholder="1" Min="1" Max="10" Step="1" />
                </div>
                <div>
                    <label>Naturaleza</label>
                    <SfDropDownList TValue="string?" TItem="NatureOption" DataSource="@_natures"
                        @bind-Value="_model.Nature" Placeholder="Seleccione naturaleza">
                        <DropDownListFieldSettings Text="Name" Value="Code" />
                    </SfDropDownList>
                </div>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _showDialog = false)" />
        <DialogButton Content="Guardar" IsPrimary="true" OnClick="@Save" />
    </DialogButtons>
</SfDialog>

<ConfirmDialog @bind-Visible="_showConfirm" OnConfirm="ConfirmDelete"
    Message="Esta seguro de eliminar este registro?" />

@code {
    private SfGrid<ChartAccountItem>? _grid;
    private List<ChartAccountItem> _items = [];
    private List<NatureOption> _natures =
    [
        new() { Code = "D", Name = "Debito" },
        new() { Code = "C", Name = "Credito" }
    ];
    private ChartAccountModel _model = new();
    private Guid? _editId;
    private bool _showDialog, _showConfirm;
    private string _dialogTitle = "";
    private Guid _deleteId;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        try { _items = await Http.GetListAsync<ChartAccountItem>("/api/accounting/chart-of-accounts?pageSize=500") ?? []; }
        catch { _items = []; }
    }

    private void OpenCreate() { _model = new(); _editId = null; _dialogTitle = "Nueva Cuenta"; _showDialog = true; }

    private void OpenEdit(ChartAccountItem item)
    {
        _model = new()
        {
            AccountCode = item.AccountCode,
            Name = item.Name,
            Level = item.Level,
            Nature = item.Nature
        };
        _editId = item.PublicId;
        _dialogTitle = "Editar Cuenta";
        _showDialog = true;
    }

    private void OpenDelete(ChartAccountItem item) { _deleteId = item.PublicId; _showConfirm = true; }

    private async Task Save()
    {
        HttpResponseMessage res;
        if (_editId.HasValue)
            res = await Http.PutAsJsonAsync($"/api/accounting/chart-of-accounts/{_editId}", _model);
        else
            res = await Http.PostAsJsonAsync("/api/accounting/chart-of-accounts", _model);

        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro guardado");
            _showDialog = false;
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al guardar");
    }

    private async Task ConfirmDelete()
    {
        var res = await Http.DeleteAsync($"/api/accounting/chart-of-accounts/{_deleteId}");
        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro eliminado");
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al eliminar");
    }

    private class ChartAccountItem
    {
        public Guid PublicId { get; set; }
        public string AccountCode { get; set; } = "";
        public string Name { get; set; } = "";
        public int? Level { get; set; }
        public string? Nature { get; set; }
    }

    private class ChartAccountModel
    {
        public string AccountCode { get; set; } = "";
        public string Name { get; set; } = "";
        public int? Level { get; set; }
        public string? Nature { get; set; }
    }

    private class NatureOption
    {
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
    }
}
