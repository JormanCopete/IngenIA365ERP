@page "/contabilidad/comprobantes/nuevo"
@page "/contabilidad/comprobantes/{Id:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using IngenIA365ERP.Shared.Models.Contabilidad
@using IngenIA365ERP.Shared.Services.Contabilidad
@using IngenIA365ERP.Shared.Services.Nomina
@using IngenIA365ERP.Shared.Services.Pagos
@using IngenIA365ERP.Shared.Services.Security
@using IngenIA365ERP.Shared.Services.Teclado
@inject ContabilidadClient Contabilidad
@inject HttpClient Http
@inject INotificationService Notification
@inject NavigationManager Navigation
@inject DescargaDeArchivos Descargas
@inject PermisosDelUsuario Permisos
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>@_titulo - IngenIA365ERP</PageTitle>

@* Feature 009, US3 (FR-025..FR-031, FR-041, U3): la ventana de digitación. Se guarda como borrador
   con errores; al salir de cada campo se valida contra el servidor y cada infracción se pinta en
   su celda; «Contabilizar» y «Anular» son permisos aparte; un comprobante de módulo se consulta
   aquí de sólo lectura y se anula en su módulo («Ver en {módulo}»).
   2026-11-16 (pedido del dueño): ventana transaccional como las de Comercial y Recaudo.
   - Ocupa la pantalla: sólo las líneas se desplazan y el pie con totales, botones y atajos siempre se ve.
   - Teclas registradas en teclado.js y botones en la BarraDeAtajos: F1 ayuda, F2 buscar en el campo (Accounting.VoucherSearchMode),
     F3 línea nueva, F4 tercero de la línea, Ctrl+D duplicar (2026-11-23: F4 es «tercero» en todas las ventanas), F6 balancear, Ctrl+Supr quitar la selección, F9 guardar borrador, F10 contabilizar (guarda,
     contabiliza y deja listo uno nuevo con el mismo tipo y fecha), Ctrl+P imprimir (el abierto o el último contabilizado).
   - Desde el primer F9 cada cambio se guarda solo en el borrador.
   - Los pasos y la ayuda van ocultos y se muestran con el botón «Pasos y ayuda» (el equipo lo recuerda).
   - Los soportes, en una ventana. *@
<PermissionGate Required="Accounting.Vouchers.View" MostrarAviso="true">
<div class="ventana-transaccional ventana-comprobante" data-zona-teclado>
    <div class="page-header">
        <h3>@_titulo</h3>
        <div class="toolbar">
            <SfButton CssClass="e-outline" IconCss="e-icons e-arrow-left" OnClick="@(() => Navigation.NavigateTo(_documento?.Status == "Draft" || _documento is null ? "/contabilidad/borradores" : "/contabilidad/comprobantes"))">Volver</SfButton>
            @if (Id is not null || _ultimo is not null)
            {
                <SfButton CssClass="e-outline" IconCss="e-icons e-print" Disabled="@_saving" OnClick="@ImprimirAsync" title="@(Id is null ? $"Imprime el último contabilizado ({_ultimo?.Referencia})" : null)">Imprimir</SfButton>
                <SfButton CssClass="e-outline" IconCss="e-icons e-export-excel" Disabled="@_saving" OnClick="@ExportarAsync" title="@(Id is null ? $"Baja a Excel el último contabilizado ({_ultimo?.Referencia})" : "Todas las líneas, con filtro en los encabezados")">Excel</SfButton>
            }
            @if (_documento?.Origin is { } origen && origen.Module != "CNT" && (origen.Link ?? EnlacesDeOrigen.Ruta(origen.SourceType, origen.SourcePublicId)) is { } enlace)
            {
                <SfButton CssClass="e-outline" IconCss="e-icons e-open-link" OnClick="@(() => Navigation.NavigateTo(enlace))">Ver en @origen.ModuleName</SfButton>
            }
            @if (!_soloLectura)
            {
                <SfButton CssClass="@(_mostrarGuia ? "e-outline e-active" : "e-outline")" IconCss="e-icons e-help" OnClick="@AlternarGuiaAsync">Pasos y ayuda</SfButton>
            }
        </div>
    </div>

    @if (_documento is not null && !_esBorrador)
    {
        <div class="info-card ventana-aviso">
            <span class="label">
                <span class="marca-origen @(_documento.Origin.Module == "CNT" ? "marca-origen-manual" : "")">@_documento.Origin.ModuleName</span>
                @_documento.Referencia · @Estado(_documento.Status) · @_documento.Date.ToString("yyyy-MM-dd")
            </span>
            <p>
                Registró @_documento.RegisteredBy el @_documento.RegisteredAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                @if (_documento.PostedBy is not null) { <text>· contabilizó @_documento.PostedBy el @_documento.PostedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</text> }
            </p>
            @if (_documento.Reversal.ReversedByPublicId is { } rev)
            {
                <p class="aviso aviso-info">Reversado por <a href="/contabilidad/comprobantes/@rev">@_documento.Reversal.ReversedByNumber</a>. Motivo: @_documento.Reversal.Reason</p>
            }
            @if (_documento.Reversal.ReversesPublicId is { } orig)
            {
                <p class="aviso aviso-info">Reversa a <a href="/contabilidad/comprobantes/@orig">@_documento.Reversal.ReversesNumber</a>.</p>
            }
            @if (_documento.Origin.Module != "CNT")
            {
                <p class="texto-apoyo">Lo generó @_documento.Origin.ModuleName: se consulta aquí y sólo se anula desde ese módulo.</p>
            }
        </div>
    }

    <IndicadorDeCarga Cargando="@_carga.Activa">
    <div class="ventana-cuerpo @(_mostrarGuia && !_soloLectura ? "con-guia" : "")">
        <div class="ventana-principal">
            <div class="form-grid encabezado-comprobante">
                <label class="campo" data-ayuda="@AyudaDelComprobante.Texto("VoucherType")">Tipo de comprobante
                    @* Un borrador de apertura (AP) se edita aquí como cualquier otro, pero su tipo no se elige:
                       es un tipo reservado y cambiarlo convertiría la apertura en otra cosa (E2, 2026-09-22). *@
                    <select id="comprobante-tipo" class="e-input" value="@_m.TipoCode" disabled="@(_soloLectura || _esApertura)" @onchange="@(e => CambiarTipo(e.Value?.ToString()))" @onfocus="@(() => _campo = "VoucherType")">
                        @if (_soloLectura || _esApertura) { <option value="@_m.TipoCode">@_m.TipoCode · @_documento?.VoucherTypeName</option> }
                        else { @foreach (var t in _tipos) { <option value="@t.Code">@t.Code · @t.Name</option> } }
                    </select>
                </label>
                <label class="campo" data-ayuda="@AyudaDelComprobante.Texto("Date")">Fecha
                    @* La apertura puede quedar fechada en el futuro del reloj (el fin del primer ejercicio), así que su tope es otro. *@
                    <SfDatePicker TValue="DateTime" @bind-Value="_m.Fecha" Enabled="@(!_soloLectura)" Format="yyyy-MM-dd" Max="@(_esApertura ? _topeDeApertura : DateTime.Today)" ValueChange="@((Syncfusion.Blazor.Calendars.ChangedEventArgs<DateTime> _) => Cambio())" OnFocus="@(() => _campo = "Date")" />
                </label>
                <label class="campo campo-ancho" data-ayuda="@AyudaDelComprobante.Texto("Description")">Descripción
                    <input id="comprobante-descripcion" class="e-input" value="@_m.Descripcion" maxlength="200" disabled="@_soloLectura" placeholder="Qué registra este comprobante" @onchange="@(e => { _m.Descripcion = e.Value?.ToString() ?? ""; Cambio(); })" @onfocus="@(() => _campo = "Description")" />
                </label>
            </div>

            @foreach (var e in _errores.Where(x => x.LineNumber == 0))
            {
                <p class="aviso @(e.Bloquea ? "aviso-error" : "aviso-alerta")">@e.Message</p>
            }

            @* 2026-11-16: lo que ya no se digita se consulta con orden y filtro por columna (ConsultaDeLineas). *@
            @if (_soloLectura && _documento is not null)
            {
                <ConsultaDeLineas Lineas="@_documento.Lines" />
            }
            else
            {
            <LineasDeComprobante @ref="_lineas" Lineas="@_m.Lineas" Errores="@_errores" Sucursales="@_sucursales" Centros="@_centros" TiposDeCruce="@_tiposDeCruce"
                                 SoloLectura="@_soloLectura" BuscaEnVentana="@_ajustes.BuscaEnVentana" SucursalPropuesta="@_ajustes.ProposedBranchPublicId"
                                 OnCambio="@Cambio" OnCampo="@(c => _campo = c)" />
            }
        </div>

        @* 2026-11-10: los pasos y la ayuda sirven para digitar; en un comprobante contabilizado no hay nada que digitar. 2026-11-16: ocultos por
           defecto (pedido del dueño); el botón «Pasos y ayuda» los muestra y el equipo lo recuerda. *@
        @if (_mostrarGuia && !_soloLectura)
        {
            <aside class="guia-del-comprobante">
                <div class="info-card">
                    <span class="label">Pasos</span>
                    <div class="guia-de-pasos">
                        <div class="paso @(Paso == 1 ? "paso-activo" : Paso > 1 ? "paso-hecho" : "")"><span class="paso-numero">1</span><span>Tipo, fecha y descripción.</span></div>
                        <div class="paso @(Paso == 2 ? "paso-activo" : Paso > 2 ? "paso-hecho" : "")"><span class="paso-numero">2</span><span>Líneas: cuenta, lo que exige, débito o crédito.</span></div>
                        <div class="paso @(Paso == 3 ? "paso-activo" : Paso > 3 ? "paso-hecho" : "")"><span class="paso-numero">3</span><span>Cuadre y corrección de lo marcado. F9 guarda el borrador y desde ahí se guarda solo.</span></div>
                        <div class="paso @(Paso == 4 ? "paso-activo" : "")"><span class="paso-numero">4</span><span>F10 contabiliza: toma el número y pasa al libro. Después sólo se reversa.</span></div>
                    </div>
                </div>
                <div class="info-card">
                    <span class="label">Ayuda · @AyudaDelComprobante.Nombre(_campo)</span>
                    <p>@AyudaDelComprobante.Texto(_campo)</p>
                </div>
            </aside>
        }
    </div>
    </IndicadorDeCarga>

    <div class="ventana-pie">
        @if (_mostrarErrores && _errores.Count > 0)
        {
            <ul class="lista-de-errores ventana-pie-errores">
                @foreach (var e in _errores.OrderBy(x => x.LineNumber))
                {
                    <li class="@(e.Bloquea ? "" : "texto-tenue")">
                        @if (e.LineNumber > 0) { <button type="button" class="enlace" @onclick="() => _lineas!.IrALineaAsync(e.LineNumber)">Línea @e.LineNumber</button> <text>· </text> }
                        @e.Message
                    </li>
                }
            </ul>
        }
        <div class="ventana-pie-fila">
            <div class="pie-de-totales">
                <span>Débitos: @_m.TotalDebito.ToString("N2")</span>
                <span>Créditos: @_m.TotalCredito.ToString("N2")</span>
                <span class="@(_m.Diferencia == 0m ? "cuadrado" : "diferencia")">@(_m.Diferencia == 0m ? "Cuadrado" : $"Diferencia: {_m.Diferencia:N2}")</span>
                <span class="texto-tenue">@_m.Lineas.Count @(_m.Lineas.Count == 1 ? "línea" : "líneas")@(_lineas?.Seleccionadas > 1 ? $" · {_lineas.Seleccionadas} seleccionadas" : "")</span>
                @if (_errores.Count > 0)
                {
                    <button type="button" class="enlace @(_errores.Any(x => x.Bloquea) ? "texto-peligro" : "")" @onclick="@(() => _mostrarErrores = !_mostrarErrores)">
                        @(_errores.Count(x => x.Bloquea)) por corregir · @(_errores.Count(x => !x.Bloquea)) avisos @(_mostrarErrores ? "▾" : "▸")
                    </button>
                }
                @if (!_soloLectura)
                {
                    <span class="estado-guardado @ClaseDeGuardado">@TextoDeGuardado</span>
                }
            </div>
            <div class="toolbar">
                @if (Id is { })
                {
                    <SfButton CssClass="e-outline" IconCss="e-icons e-attachment" OnClick="@(() => _mostrarSoportes = true)">Soportes</SfButton>
                }
                @if (!_soloLectura)
                {
                    @if (Id is not null)
                    {
                        <PermissionGate Required="Accounting.Vouchers.Create">
                            <SfButton CssClass="e-outline e-danger" IconCss="e-icons e-trash" Disabled="@_saving" OnClick="@(() => _confirmarDescarte = true)">Descartar borrador</SfButton>
                        </PermissionGate>
                    }
                    <PermissionGate Required="Accounting.Vouchers.Create">
                        <SfButton CssClass="e-outline" IconCss="e-icons e-save" Disabled="@_saving" OnClick="@GuardarAsync">Guardar borrador (F9)</SfButton>
                    </PermissionGate>
                    <PermissionGate Required="Accounting.Vouchers.Post">
                        <SfButton CssClass="e-success" IconCss="e-icons e-check" Disabled="@_saving" OnClick="@ContabilizarAsync" title="Guarda, toma el consecutivo, pasa al libro y deja listo uno nuevo">Contabilizar (F10)</SfButton>
                    </PermissionGate>
                }
                else if (_documento is { Status: "Posted", Origin.Module: "CNT" })
                {
                    <PermissionGate Required="Accounting.Vouchers.Void">
                        <SfButton CssClass="e-outline e-danger" IconCss="e-icons e-undo" Disabled="@_saving" OnClick="@(() => { _motivo = ""; _mostrarReversion = true; })">Anular (reversar)</SfButton>
                    </PermissionGate>
                }
            </div>
        </div>
        <BarraDeAtajos Comandos="@Comandos" Ejecutar="@Tecla" />
    </div>
</div>

<ConfirmDialog @bind-Visible="_confirmarDescarte" Title="Descartar borrador" Message="El borrador se descarta y no aparece más en la lista. ¿Continuar?" ConfirmText="Descartar" OnConfirm="@(() => DescartarAsync(borrarSoportes: false))" />
<ConfirmDialog @bind-Visible="_confirmarDescarteConSoportes" Title="El borrador tiene soportes" ConfirmText="Descartar y borrar soportes" OnConfirm="@(() => DescartarAsync(borrarSoportes: true))"
               Message="@($"Tiene {_soportesPorBorrar} {(_soportesPorBorrar == 1 ? "soporte" : "soportes")}; se borrarán y quedarán 90 días en la papelera. ¿Continuar?")" />

<SfDialog @bind-Visible="_mostrarReversion" Header="Anular comprobante" Width="520px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <p>Se crea un comprobante de reversión con las líneas invertidas y el original queda «Reversado». Si el mes está cerrado, la reversión se fecha en el primer período abierto.</p>
            <label class="campo">Motivo
                <input class="e-input" @bind="_motivo" maxlength="200" placeholder="Por qué se anula" />
            </label>
            <div class="toolbar">
                <SfButton CssClass="e-primary" Disabled="@(_saving || string.IsNullOrWhiteSpace(_motivo))" OnClick="@ReversarAsync">Reversar</SfButton>
                <SfButton CssClass="e-outline" OnClick="@(() => _mostrarReversion = false)">Cancelar</SfButton>
            </div>
        </Content>
    </DialogTemplates>
</SfDialog>

@if (Id is { } idAdjuntos)
{
    <SfDialog @bind-Visible="_mostrarSoportes" Header="Soportes del comprobante" Width="720px" IsModal="true" ShowCloseIcon="true">
        <DialogTemplates>
            <Content>
                @* Feature 011 (FR-017): se agregan soportes al borrador y también al contabilizado —el soporte
                   suele llegar después—; borrarlos, sólo mientras sea borrador (lo decide el servidor). *@
                <PermissionGate Required="Attachments.Upload">
                    <PermissionGate Required="Accounting.Vouchers.Create">
                        <SubirSoporte OwnerEntityType="AccountingDocument" OwnerEntityPublicId="@idAdjuntos" OnSubido="@RefrescarSoportesAsync" />
                    </PermissionGate>
                </PermissionGate>
                <AttachmentList @ref="_soportes" OwnerEntityType="AccountingDocument" OwnerEntityPublicId="@idAdjuntos" />
            </Content>
        </DialogTemplates>
    </SfDialog>
}

<VentanaDeBusquedaContable @bind-Visible="_ventanaDeTipos" Tipo="VentanaDeBusquedaContable.TipoDeBusqueda.Catalogo" Titulo="Tipo de comprobante"
                           Opciones="@(_tipos.Select(t => new VentanaDeBusquedaContable.Opcion(t.Code, t.Code, t.Name)).ToList())" OnOpcion="@TipoDeVentanaAsync" />
</PermissionGate>

@code {
    [Parameter] public Guid? Id { get; set; }

    private static readonly string[] TeclasRegistradas =
        ["F2", "F3", "F4", "Ctrl+D", "F6", "F9", "F10", "Ctrl+Delete", "Ctrl+P", "Ctrl+Alt+N", "Ctrl+Alt+D", "Ctrl+Alt+B"];

    private const string ClaveGuia = "ingenia.comprobante.guia";
    private const string ClaveTipo = "ingenia.comprobante.tipo";

    private enum Guardado { Nada, Pendiente, Guardando, Guardado, Error }

    private readonly EstadoDeCarga _carga = new();
    private readonly SemaphoreSlim _cerrojo = new(1, 1);
    private ComprobanteModelo _m = new();
    private ComprobanteDto? _documento;
    private AjustesDeDigitacionDto _ajustes = AjustesDeDigitacionDto.PorDefecto;
    private List<ErrorDeLineaDto> _errores = [];
    private List<TipoComprobanteDto> _tipos = [];
    private List<LineasDeComprobante.ItemDeCatalogo> _sucursales = [], _centros = [];
    private List<TipoCruceDto> _tiposDeCruce = [];
    private LineasDeComprobante? _lineas;
    private bool _saving, _confirmarDescarte, _confirmarDescarteConSoportes, _mostrarReversion, _mostrarGuia, _mostrarErrores, _mostrarSoportes, _ventanaDeTipos;
    private bool _puedeCrear, _puedeContabilizar, _enfocarDescripcion, _tipoRecordado;
    private AttachmentList? _soportes;
    private int _soportesPorBorrar;
    private string _motivo = "", _campo = "VoucherType";
    private CancellationTokenSource? _debounce;
    private Guid? _cargado;
    private Guardado _guardado = Guardado.Nada;
    private DateTime _guardadoA;
    private string? _errorDeGuardado;
    private (Guid Id, string Referencia)? _ultimo;
    private (string Tipo, DateTime Fecha)? _siguiente;
    private TablaDeComandos? _comandosDeEdicion, _comandosDeLectura;
    private DotNetObjectReference<Comprobante>? _referencia;
    private int? _registroDeTeclas;

    private Task RefrescarSoportesAsync() => _soportes?.RefreshAsync() ?? Task.CompletedTask;

    private bool _esBorrador => _documento is null || _documento.Status == "Draft";
    private bool _esApertura => _documento?.Kind == "Opening";
    private DateTime _topeDeApertura = DateTime.Today.AddYears(1);
    private bool _soloLectura => !_esBorrador || (_documento is not null && _documento.Origin.Module != "CNT");
    private string _titulo => _documento is not null && !_esBorrador ? $"Comprobante {_documento.Referencia}" : Id is not null ? "Borrador de comprobante" : "Nuevo comprobante";
    private int Paso => string.IsNullOrEmpty(_m.TipoCode) || string.IsNullOrWhiteSpace(_m.Descripcion) ? 1 : _m.LineasAGuardar.Count < 2 ? 2 : _errores.Any(x => x.Bloquea) || Id is null ? 3 : 4;
    private TablaDeComandos? Comandos => _soloLectura ? _comandosDeLectura : _comandosDeEdicion;

    private string TextoDeGuardado => _guardado switch
    {
        Guardado.Guardando => "Guardando…",
        Guardado.Guardado => $"Borrador guardado {_guardadoA:HH:mm:ss}",
        Guardado.Error => $"No se guardó: {_errorDeGuardado}",
        Guardado.Pendiente when _m.LineaSinCuenta is { } n => $"Falta la cuenta de la línea {n}: se guarda al completarla",
        Guardado.Pendiente => "Cambios sin guardar…",
        _ => Id is null && _m.LineasAGuardar.Count > 0 ? "Sin guardar: F9 guarda el borrador" : "",
    };

    private string ClaseDeGuardado => _guardado switch { Guardado.Error => "texto-peligro", Guardado.Guardado => "texto-exito", _ => "texto-tenue" };

    protected override async Task OnInitializedAsync()
    {
        _comandosDeEdicion = new TablaDeComandos(
        [
            new("F2", "buscar", BuscarAsync),
            new("F3", "línea nueva", () => _lineas?.NuevaLineaAsync() ?? Task.CompletedTask),
            // 2026-11-23 (decisión del dueño): F4 es «tercero» en todas las ventanas transaccionales; duplicar pasa a Ctrl+D.
            new("F4", "tercero", () => _lineas?.BuscarTerceroAsync() ?? Task.CompletedTask, () => _lineas is not null),
            new("Ctrl+D", "duplicar", () => _lineas?.DuplicarAsync() ?? Task.CompletedTask, () => _lineas?.HayActiva == true, PorQueNo: () => "Elija primero una línea."),
            new("F6", "balancear", () => _lineas?.BalancearAsync() ?? Task.CompletedTask, () => _lineas?.HayActiva == true, PorQueNo: () => "Elija primero la línea que cuadra."),
            new("Ctrl+Delete", "quitar líneas", () => _lineas?.QuitarSeleccionAsync() ?? Task.CompletedTask, () => _lineas?.HayActiva == true || _lineas?.Seleccionadas > 0,
                TeclaVisible: "Ctrl+Supr", PorQueNo: () => "Elija primero las líneas: clic, Shift+clic o Ctrl+clic en el número."),
            new("F9", "guardar borrador", GuardarAsync, () => _puedeCrear && !_saving, PorQueNo: () => _puedeCrear ? null : "No tiene el permiso de digitar comprobantes."),
            new("F10", "contabilizar", ContabilizarAsync, () => _puedeContabilizar && !_saving, PorQueNo: () => _puedeContabilizar ? null : "No tiene el permiso de contabilizar: guarde el borrador (F9) y otra persona lo contabiliza."),
            new("Ctrl+P", "imprimir", ImprimirAsync, () => Id is not null || _ultimo is not null, PorQueNo: () => "Guarde primero el borrador (F9)."),
        ]);
        _comandosDeLectura = new TablaDeComandos([new("Ctrl+P", "imprimir", ImprimirAsync, () => Id is not null)]);

        using var carga = _carga.Iniciar();
        var tipos = Contabilidad.ListarTiposDeComprobanteAsync();
        var cruces = Contabilidad.ListarTiposDeCruceAsync();
        var sucursales = Http.TryGetListAsync<ItemCrudo>("/api/core/branches?PageNumber=1&PageSize=500&SortBy=name");
        var centros = Http.TryGetListAsync<ItemCrudo>("/api/core/cost-centers?PageNumber=1&PageSize=500");
        var crear = Permisos.TieneAsync("Accounting.Vouchers.Create");
        var contabilizar = Permisos.TieneAsync("Accounting.Vouchers.Post");
        await Task.WhenAll(tipos, cruces, sucursales, centros, crear, contabilizar);
        _puedeCrear = crear.Result;
        _puedeContabilizar = contabilizar.Result;
        if (_puedeCrear)
        {
            var ajustes = await Contabilidad.AjustesDeDigitacionAsync();
            if (ajustes.IsSuccess) _ajustes = ajustes.Value!;
        }
        _tipos = tipos.Result.IsSuccess ? tipos.Result.Value!.Where(t => t.Usage == "Manual").ToList() : [];
        _tiposDeCruce = cruces.Result.IsSuccess ? [.. cruces.Result.Value!] : [];
        // Quien tiene el alcance restringido sólo ve sus sucursales; con una sola, queda puesta (pedido del dueño del 2026-11-16).
        var todas = sucursales.Result.Select(x => new LineasDeComprobante.ItemDeCatalogo(x.PublicId, x.Name)).ToList();
        _sucursales = _ajustes.AllowedBranchPublicIds is { Count: > 0 } permitidas && todas.Any(s => permitidas.Contains(s.PublicId))
            ? todas.Where(s => permitidas.Contains(s.PublicId)).ToList()
            : todas;
        if (_ajustes.ProposedBranchPublicId is null && _sucursales.Count == 1) _ajustes = _ajustes with { ProposedBranchPublicId = _sucursales[0].PublicId };
        _centros = centros.Result.Select(x => new LineasDeComprobante.ItemDeCatalogo(x.PublicId, x.Name)).ToList();
        if (Id is null) { Nuevo(); _enfocarDescripcion = true; }
    }

    /// <summary>Un comprobante en blanco: el tipo y la fecha del anterior (o el primero y hoy) y una línea con la sucursal propuesta.</summary>
    private void Nuevo()
    {
        var tipo = _siguiente?.Tipo is { } t && _tipos.Any(x => x.Code == t) ? t : _tipos.FirstOrDefault()?.Code ?? "";
        _m = new ComprobanteModelo { TipoCode = tipo, Fecha = _siguiente?.Fecha ?? DateTime.Today };
        _m.Lineas.Add(new LineaDeComprobanteModelo { SucursalPublicId = _ajustes.ProposedBranchPublicId });
        _errores = [];
        _guardado = Guardado.Nada;
        _mostrarErrores = false;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Id is null)
        {
            if (_cargado is not null) { _cargado = null; _documento = null; Nuevo(); _enfocarDescripcion = true; }
            return;
        }
        if (_cargado == Id) return;
        _cargado = Id;
        using var carga = _carga.Iniciar();
        var r = await Contabilidad.ObtenerComprobanteAsync(Id.Value);
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se encontró el comprobante."); Navigation.NavigateTo("/contabilidad/comprobantes"); return; }
        _documento = r.Value!;
        // Las reglas de cada cuenta vienen del buscador: sin ellas la grilla no sabría qué exigir.
        var cuentas = new Dictionary<string, CuentaBuscadaDto>();
        foreach (var codigo in _documento.Lines.Select(l => l.AccountCode).Distinct())
        {
            var b = await Contabilidad.BuscarCuentasAsync(codigo, "CNT", onlyMovement: false);
            if (b.IsSuccess && b.Value!.FirstOrDefault(c => c.Code == codigo) is { } c) cuentas[codigo] = c;
        }
        _m = ComprobanteModelo.Desde(_documento, cuentas);
        _errores = [.. _documento.Errors];
        _guardado = Guardado.Nada;
        if (_esApertura)
        {
            var apertura = await Contabilidad.EstadoDeAperturaAsync();
            if (apertura.IsSuccess) _topeDeApertura = apertura.Value!.MaxDate.ToDateTime(TimeOnly.MinValue);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                _referencia = DotNetObjectReference.Create(this);
                _registroDeTeclas = await JS.InvokeAsync<int>("ingeniaTeclado.registrar", _referencia, TeclasRegistradas);
                _mostrarGuia = await JS.InvokeAsync<string?>("ingeniaTeclado.recordado", ClaveGuia) == "1";
                StateHasChanged();
            }
            // El último tipo digitado en este equipo, si sigue siendo manual: cuando ya llegaron los tipos y sólo en uno nuevo sin digitar.
            if (!_tipoRecordado && !_carga.Activa && _tipos.Count > 0)
            {
                _tipoRecordado = true;
                if (Id is null && _siguiente is null && _m.LineasAGuardar.Count == 0
                    && await JS.InvokeAsync<string?>("ingeniaTeclado.recordado", ClaveTipo) is { } tipo && _tipos.Any(t => t.Code == tipo) && tipo != _m.TipoCode)
                {
                    _m.TipoCode = tipo;
                    StateHasChanged();
                }
            }
            if (_enfocarDescripcion && !_carga.Activa)
            {
                _enfocarDescripcion = false;
                await JS.InvokeAsync<bool>("ingeniaTeclado.enfocar", "#comprobante-descripcion");
            }
        }
        catch (JSException ex) { InteropDeTeclado.Avisar(ex, "sin teclado.js el comprobante se maneja con los botones"); }
        catch (Exception ex) when (ex is JSDisconnectedException or InvalidOperationException or TaskCanceledException) { /* prerender o circuito cerrado */ }
    }

    [JSInvokable]
    public Task Tecla(string tecla) => InvokeAsync(async () =>
    {
        // Los atajos de antes siguen sirviendo (Ctrl+Alt+Supr nunca llegó al navegador: Windows lo toma).
        tecla = tecla switch { "Ctrl+Alt+N" => "F3", "Ctrl+Alt+D" => "Ctrl+D", "Ctrl+Alt+B" => "F6", _ => tecla };
        if (Comandos is null) return;
        var r = await Comandos.EjecutarAsync(tecla);
        if (r.Aviso is { } aviso) await Notification.WarningAsync(aviso);
        StateHasChanged();
    });

    // ---------------------------------------------------------------------------------- cambios y guardado --

    /// <summary>
    /// Algo cambió: espera 600 ms de silencio y, si el borrador ya existe y toda línea tiene cuenta, lo guarda (pedido del dueño del
    /// 2026-11-16: desde el primer F9 todo se guarda solo); si no, sólo valida (FR-041). No se espera aquí: la grilla sigue sin demora.
    /// </summary>
    private void Cambio()
    {
        if (_soloLectura) return;
        if (Id is not null) _guardado = Guardado.Pendiente;
        _ = SincronizarAsync();
    }

    private void CambiarTipo(string? tipo)
    {
        _m.TipoCode = tipo ?? "";
        _ = RecordarAsync(ClaveTipo, _m.TipoCode);
        Cambio();
    }

    private async Task SincronizarAsync()
    {
        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        var token = _debounce.Token;
        try
        {
            await Task.Delay(600, token);
            if (string.IsNullOrEmpty(_m.TipoCode) || _m.LineasAGuardar.Count == 0) { _errores = []; return; }
            if (Id is { } id && _puedeCrear && _m.LineaSinCuenta is null && !_saving)
            {
                await GuardarEnElServidorAsync(id, token);
                return;
            }
            var r = await Contabilidad.ValidarAsync(_m.ARequest(), token);
            if (token.IsCancellationRequested) return;
            if (r.IsSuccess) _errores = [.. r.Value!.Errors];
        }
        catch (TaskCanceledException) { /* llegó otro cambio: esa validación ya no sirve */ }
        finally { await InvokeAsync(StateHasChanged); }
    }

    /// <summary>Guarda el borrador existente; serializado para que dos guardados no se crucen. La petición no se cancela a mitad.</summary>
    private async Task<bool> GuardarEnElServidorAsync(Guid id, CancellationToken token)
    {
        await _cerrojo.WaitAsync(CancellationToken.None);
        try
        {
            if (token.IsCancellationRequested) return false;
            _guardado = Guardado.Guardando;
            await InvokeAsync(StateHasChanged);
            var r = await Contabilidad.ActualizarBorradorAsync(id, _m.ARequest());
            if (!r.IsSuccess)
            {
                _guardado = Guardado.Error;
                _errorDeGuardado = r.ErrorMessage ?? "el servidor no lo aceptó";
                return false;
            }
            _errores = [.. r.Value!.Errors];
            _guardado = Guardado.Guardado;
            _guardadoA = DateTime.Now;
            return true;
        }
        finally { _cerrojo.Release(); }
    }

    /// <summary>Guarda ya (crea el borrador la primera vez). Devuelve su identificador, o nulo si no se pudo.</summary>
    private async Task<Guid?> GuardarAhoraAsync()
    {
        _debounce?.Cancel();
        if (string.IsNullOrEmpty(_m.TipoCode)) { await Notification.WarningAsync("Elija el tipo de comprobante."); return null; }
        if (_m.LineasAGuardar.Count == 0) { await Notification.WarningAsync("Digite al menos una línea."); return null; }
        if (_m.LineaSinCuenta is { } n)
        {
            await Notification.WarningAsync($"La línea {n} no tiene cuenta: elíjala (F2) o quítela (Ctrl+Supr).");
            if (_lineas is not null) await _lineas.IrALineaAsync(n);
            return null;
        }
        if (Id is { } id) return await GuardarEnElServidorAsync(id, CancellationToken.None) ? id : null;

        await _cerrojo.WaitAsync();
        try
        {
            _guardado = Guardado.Guardando;
            var r = await Contabilidad.GuardarBorradorAsync(_m.ARequest());
            if (!r.IsSuccess)
            {
                _guardado = Guardado.Error;
                _errorDeGuardado = r.ErrorMessage ?? "el servidor no lo aceptó";
                await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo guardar el borrador.");
                return null;
            }
            _errores = [.. r.Value!.Errors];
            _guardado = Guardado.Guardado;
            _guardadoA = DateTime.Now;
            // Sin recargar: la grilla sigue como está y desde aquí cada cambio se guarda solo.
            _cargado = r.Value.PublicId;
            Navigation.NavigateTo($"/contabilidad/comprobantes/{r.Value.PublicId}", replace: true);
            return r.Value.PublicId;
        }
        finally { _cerrojo.Release(); }
    }

    /// <summary>F9.</summary>
    private async Task GuardarAsync()
    {
        if (_saving || _soloLectura) return;
        _saving = true;
        try
        {
            if (await GuardarAhoraAsync() is null) return;
            await Notification.SuccessAsync(_errores.Any(x => x.Bloquea)
                ? "Borrador guardado; quedan errores por corregir antes de contabilizar. Desde ahora cada cambio se guarda solo."
                : "Borrador guardado. Desde ahora cada cambio se guarda solo.");
        }
        finally { _saving = false; }
    }

    /// <summary>F10: guarda, contabiliza y deja listo un comprobante nuevo con el mismo tipo y fecha.</summary>
    private async Task ContabilizarAsync()
    {
        if (_saving || _soloLectura) return;
        _saving = true;
        try
        {
            if (await GuardarAhoraAsync() is not { } id) return;
            if (_errores.FirstOrDefault(x => x.Bloquea) is { } error)
            {
                _mostrarErrores = true;
                await Notification.WarningAsync($"No se contabilizó: {_errores.Count(x => x.Bloquea)} por corregir. El borrador quedó guardado.");
                if (error.LineNumber > 0 && _lineas is not null) await _lineas.IrALineaAsync(error.LineNumber);
                return;
            }
            var r = await Contabilidad.ContabilizarAsync(id);
            if (!r.IsSuccess)
            {
                var detalle = r.ErroresDeLinea();
                if (detalle.Count > 0) { _errores = detalle; _mostrarErrores = true; }
                await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo contabilizar.");
                return;
            }
            var referencia = $"{_m.TipoCode}-{r.Value!.Number}";
            _ultimo = (id, referencia);
            _siguiente = (_m.TipoCode, _m.Fecha);
            await RecordarAsync(ClaveTipo, _m.TipoCode);
            await Notification.SuccessAsync($"Contabilizado con el número {referencia}. Ctrl+P lo imprime.");
            _cargado = id; // para que la ruta «nuevo» limpie la ventana
            Navigation.NavigateTo("/contabilidad/comprobantes/nuevo");
        }
        finally { _saving = false; }
    }

    private async Task ReversarAsync()
    {
        if (_saving || Id is null) return;
        _saving = true;
        try
        {
            var r = await Contabilidad.ReversarAsync(Id.Value, new ReversionRequest(_motivo.Trim(), null));
            if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo reversar."); return; }
            _mostrarReversion = false;
            await Notification.SuccessAsync($"Reversado con el comprobante {_m.TipoCode}-{r.Value!.Number}.");
            Navigation.NavigateTo($"/contabilidad/comprobantes/{r.Value.ReversalPublicId}");
        }
        finally { _saving = false; }
    }

    private async Task DescartarAsync(bool borrarSoportes)
    {
        if (Id is null) return;
        _debounce?.Cancel();
        var r = await Contabilidad.DescartarBorradorAsync(Id.Value, borrarSoportes);
        if (!r.IsSuccess && r.ErrorCode == ContabilidadClient.CodigoTieneSoportes)
        {
            // Feature 011 (FR-005): los soportes no se borran sin que la persona lo confirme en el mismo acto.
            _soportesPorBorrar = r.Entero("count") ?? 0;
            _confirmarDescarteConSoportes = true;
            return;
        }
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo descartar."); return; }
        await Notification.SuccessAsync("Borrador descartado.");
        Navigation.NavigateTo("/contabilidad/borradores");
    }

    /// <summary>Ctrl+P: el comprobante abierto o, en uno nuevo, el último contabilizado desde esta ventana.</summary>
    private async Task ImprimirAsync()
    {
        if ((Id ?? _ultimo?.Id) is not { } id) return;
        var r = await Contabilidad.ImprimirComprobanteAsync(id);
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo imprimir."); return; }
        await Descargas.GuardarAsync(r.Value!.Nombre, r.Value.TipoContenido, r.Value.Contenido);
    }

    /// <summary>2026-11-16: el comprobante abierto (o el último contabilizado) en Excel, igual que imprimir.</summary>
    private async Task ExportarAsync()
    {
        if ((Id ?? _ultimo?.Id) is not { } id) return;
        var r = await Contabilidad.ExportarComprobanteAsync(id);
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo exportar."); return; }
        await Descargas.GuardarAsync(r.Value!.Nombre, r.Value.TipoContenido, r.Value.Contenido);
    }

    // ------------------------------------------------------------------------------------------ F2 --

    private async Task BuscarAsync()
    {
        if (_soloLectura) return;
        switch (_campo)
        {
            case "VoucherType" when !_esApertura:
                if (_ajustes.BuscaEnVentana) _ventanaDeTipos = true;
                else await LlamarAsync("ingeniaTeclado.desplegar", "#comprobante-tipo");
                break;
            case "VoucherType" or "Date" or "Description":
                if (_lineas is not null) await _lineas.EnfocarPrimeraAsync();
                break;
            default:
                if (_lineas is not null) await _lineas.BuscarAsync();
                break;
        }
    }

    private async Task TipoDeVentanaAsync(string codigo)
    {
        CambiarTipo(codigo);
        await LlamarAsync("ingeniaTeclado.enfocarDespuesDe", "#comprobante-tipo");
    }

    private async Task AlternarGuiaAsync()
    {
        _mostrarGuia = !_mostrarGuia;
        await RecordarAsync(ClaveGuia, _mostrarGuia ? "1" : null);
    }

    private async Task RecordarAsync(string clave, string? valor)
    {
        try { await JS.InvokeAsync<bool>("ingeniaTeclado.recordar", clave, valor); }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException) { /* comodidad del equipo, no un dato */ }
    }

    private async Task LlamarAsync(string funcion, string argumento)
    {
        try { await JS.InvokeAsync<bool>(funcion, argumento); }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException) { /* sin teclado.js se usa el mouse */ }
    }

    private static string Estado(string s) => s switch { "Draft" => "borrador", "Posted" => "contabilizado", "Reversed" => "reversado", _ => s };

    public void Dispose()
    {
        _debounce?.Cancel();
        if (_registroDeTeclas is { } id and > 0)
        {
            try { _ = JS.InvokeVoidAsync("ingeniaTeclado.soltar", id); }
            catch (Exception ex) when (ex is JSDisconnectedException or InvalidOperationException or ObjectDisposedException) { /* el circuito ya cerró */ }
        }
        _referencia?.Dispose();
    }

