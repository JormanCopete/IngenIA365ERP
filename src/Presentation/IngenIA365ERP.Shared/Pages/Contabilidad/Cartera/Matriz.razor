@page "/contabilidad/cartera/matriz"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using IngenIA365ERP.Shared.Services.Contabilidad
@using IngenIA365ERP.Shared.Services.Http
@using IngenIA365ERP.Shared.Services.Cartera
@inject IntegracionContableDeCarteraClient Integracion
@inject ContabilidadClient Contabilidad
@inject HttpClient Http
@inject INotificationService Notification

<PageTitle>Matriz contable de Cartera - IngenIA365ERP</PageTitle>

@* Feature 013, US7 (T0664; contracts/api.md §23.1, contracts/contabilidad.md §3.5–§3.7): la matriz con que Contabilidad traduce cada hecho de
   Cartera a cuentas —Cartera no conoce cuentas: manda la línea, la modalidad, la categoría, el concepto, la clase de recaudador… y la regla
   más específica vigente a la fecha contable del hecho dice la cuenta—. Pestañas por la familia de rol que trae el catálogo (Family);
   alta con las dimensiones que el rol exige (*) y admite —el hecho sólo en los roles de resultado—, la cuenta con BuscadorDeCuenta (sólo
   auxiliares habilitadas para Cartera) y, al elegirla, sus reglas (ReglasDeCuenta de sólo lectura, FR-016 de la 009); una versión nueva
   cierra la vigente la víspera; desactivar cierra la vigencia con motivo y nunca borra. «¿A qué cuenta va?» resuelve una combinación con
   la misma matriz del consumo y muestra las candidatas. La plantilla se descarga (vacía o con las reglas y las filas sugeridas «pendiente
   de validar») y se revisa y aplica todo o nada con el componente único ImportarPlantilla. Lo que el servidor rechaza se muestra tal
   como viene. *@
<PermissionGate Required="Accounting.LendingRules.View" MostrarAviso="true">
<div class="pagina">
    <div class="page-header">
        <h3>Matriz contable de Cartera</h3>
        <div class="toolbar">
            <a class="e-btn e-outline" href="/contabilidad/cartera/completitud">Completitud</a>
            <a class="e-btn e-outline" href="/contabilidad/cartera/tipos-de-comprobante">Tipos de comprobante</a>
            <SfButton CssClass="e-outline" IconCss="e-icons e-search" Disabled="@(_catalogo is null)" OnClick="@AbrirResolver">¿A qué cuenta va?</SfButton>
            <SfButton CssClass="e-outline" IconCss="e-icons e-upload" OnClick="@(() => _mostrarPlantilla = !_mostrarPlantilla)">Plantilla</SfButton>
            <PermissionGate Required="Accounting.LendingRules.Manage">
                <SfButton CssClass="e-primary" IconCss="e-icons e-plus" Disabled="@(_catalogo is null)" OnClick="@AbrirAlta">Nueva regla</SfButton>
            </PermissionGate>
        </div>
    </div>

    @if (_mostrarPlantilla)
    {
        <div class="info-card">
            <h4>Plantilla de la matriz contable de Cartera</h4>
            <p class="texto-tenue">Encabezados en la fila 1: operacion, rol, linea, modalidad, subsegmento, categoria, concepto, empleado, gracia, porCuentaDelAsociado, reestructurado, claseDeRecaudador, motivo, sucursal, centroDeCosto, cuenta, vigenteDesde, vigenteHasta y notas. La descarga con datos trae las reglas vigentes y futuras y las combinaciones sugeridas sin cuenta, marcadas «pendiente de validar»: las que vuelvan sin cuenta se ignoran. Una clave que ya existe con una fecha posterior es una versión nueva. Con un error no se guarda nada.</p>
            <ImportarPlantilla RutaBase="@IntegracionContableDeCarteraClient.RutaDeReglas" PermisoDeDescarga="Accounting.LendingRules.View"
                               PermisoDeDescargaConDatos="Accounting.LendingRules.View" PermisoDeImportacion="Accounting.LendingRules.Manage"
                               Aplicado="@(_ => CargarAsync())" />
        </div>
    }

    <div class="toolbar">
        @foreach (var f in FamiliasDelCatalogo)
        {
            var familia = f;
            <SfButton CssClass="@(_familia == familia ? "e-primary" : "e-outline")" OnClick="@(() => CambiarFamiliaAsync(familia))">@TextosDeContabilidadDeCartera.Familia(familia)</SfButton>
        }
    </div>
    <div class="toolbar">
        <label class="campo">Rol
            <select class="e-input" value="@(_filtroRol ?? "")" @onchange="@(e => _filtroRol = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString())">
                <option value="">Todos los de la familia</option>
                @foreach (var r in RolesDeLaFamilia) { <option value="@r.Code">@TextosDeContabilidadDeCartera.Rol(r.Code)</option> }
            </select>
        </label>
        <label class="campo">Cuenta <input class="e-input" @bind="_filtroCuenta" placeholder="Código que empieza por…" /></label>
        <label class="campo">A la fecha <input type="date" class="e-input" value="@(_filtroFecha?.ToString("yyyy-MM-dd"))" @onchange="@(e => _filtroFecha = LeerFecha(e.Value))" /></label>
        <SfCheckBox @bind-Checked="_soloVigentes" TChecked="bool" Label="Sólo vigentes" />
        <SfButton CssClass="e-primary" IconCss="e-icons e-search" Disabled="@_carga.Activa" OnClick="@CargarAsync">Buscar</SfButton>
    </div>

    <IndicadorDeCarga Cargando="@_carga.Activa">
        <div class="tabla-desplazable">
            <table class="data-grid">
                <thead><tr><th>Rol</th><th>Hecho</th><th>Dimensiones</th><th>Cuenta</th><th>Vigencia</th><th class="numero">Peso</th><th></th></tr></thead>
                <tbody>
                    @foreach (var r in _reglas)
                    {
                        var regla = r;
                        <tr class="@(regla.RulePublicId == _resaltada || !regla.Account.IsEligible ? "resaltada" : "")">
                            <td>@TextosDeContabilidadDeCartera.Rol(regla.Role)</td>
                            <td>@Hecho(regla.Operation)</td>
                            <td>@Dimensiones(regla.Dimensions)</td>
                            <td>
                                <a href="" @onclick="@(() => FiltrarPorCuentaAsync(regla.Account.Code))" @onclick:preventDefault="true" title="Ver las reglas de esta cuenta">@regla.Account.Code · @regla.Account.Name</a>
                                @if (!regla.Account.IsEligible) { <br /><span class="aviso aviso-alerta">ya no es elegible para Cartera</span> }
                            </td>
                            <td>@regla.ValidFrom.ToString("dd/MM/yyyy") – @(regla.ValidTo?.ToString("dd/MM/yyyy") ?? "vigente")@(regla.IsCurrent ? "" : " (no vigente hoy)")</td>
                            <td class="numero" title="@regla.DimensionKey">@regla.SpecificityWeight</td>
                            <td>
                                <SfButton CssClass="e-flat e-small" OnClick="@(() => VerVersionesAsync(regla))">Versiones</SfButton>
                                @if (regla.ValidTo is null)
                                {
                                    <PermissionGate Required="Accounting.LendingRules.Manage">
                                        <SfButton CssClass="e-flat e-small" OnClick="@(() => AbrirVersion(regla))">Nueva versión</SfButton>
                                        <SfButton CssClass="e-flat e-small" OnClick="@(() => AbrirDesactivar(regla))">Desactivar</SfButton>
                                    </PermissionGate>
                                }
                            </td>
                        </tr>
                    }
                    @if (_reglas.Count == 0 && !_carga.Activa)
                    {
                        <tr><td colspan="7" class="texto-tenue">@(_error ?? "Sin reglas en esta familia con estos filtros.")</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </IndicadorDeCarga>

    @if (_versionesDe is not null)
    {
        <div class="info-card">
            <h4>Versiones de @TextosDeContabilidadDeCartera.Rol(_versionesDe.Role) · @Hecho(_versionesDe.Operation) · @Dimensiones(_versionesDe.Dimensions)</h4>
            <IndicadorDeCarga Cargando="@_cargaVersiones.Activa">
                <ul>
                    @foreach (var v in _versiones)
                    {
                        <li>@v.ValidFrom.ToString("dd/MM/yyyy") – @(v.ValidTo?.ToString("dd/MM/yyyy") ?? "vigente") · @v.Account.Code @v.Account.Name@(string.IsNullOrWhiteSpace(v.Notes) ? "" : $" · {v.Notes}")@(v.CreatedByName is { } q ? $" · {q}" : "")</li>
                    }
                </ul>
                <SfButton CssClass="e-flat e-small" OnClick="@(() => _versionesDe = null)">Cerrar</SfButton>
            </IndicadorDeCarga>
        </div>
    }
</div>

<SfDialog @bind-Visible="_mostrarAlta" Header="Nueva regla" Width="760px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@_guardado.Activa" Texto="Guardando…">
                <div class="form-grid">
                    <label class="campo">Rol *
                        <select class="e-input" value="@(_f.Rol ?? "")" @onchange="@(e => ElegirRol(e.Value?.ToString()))">
                            <option value="">Elija…</option>
                            @foreach (var rol in RolesDeLaFamilia) { <option value="@rol.Code">@TextosDeContabilidadDeCartera.Rol(rol.Code)</option> }
                        </select>
                    </label>
                    @CamposDeDimension(RolElegido(_f.Rol), false)
                    <label class="campo">Centro de costo
                        <select class="e-input" value="@(_f.Centro?.ToString() ?? "")" @onchange="@(e => _f.Centro = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null)">
                            <option value="">Ninguno</option>
                            @foreach (var c in _centros) { <option value="@c.PublicId">@c.Name</option> }
                        </select>
                    </label>
                    <label class="campo campo-ancho">Cuenta *
                        <BuscadorDeCuenta Modulo="CAR" Cuenta="@_cuenta" CuentaChanged="@ElegirCuentaAsync" />
                    </label>
                    <label class="campo">Vigente desde * <input type="date" class="e-input" value="@(_f.Desde?.ToString("yyyy-MM-dd"))" @onchange="@(e => _f.Desde = LeerFecha(e.Value))" /></label>
                    <label class="campo">Vigente hasta <input type="date" class="e-input" value="@(_f.Hasta?.ToString("yyyy-MM-dd"))" @onchange="@(e => _f.Hasta = LeerFecha(e.Value))" /></label>
                    <label class="campo campo-ancho">Notas <input class="e-input" @bind="_f.Notas" maxlength="500" /></label>
                    <label class="campo campo-ancho">Motivo * <input class="e-input" @bind="_f.Motivo" @bind:event="oninput" maxlength="500" /></label>
                </div>
                <IndicadorDeCarga Cargando="@_cargaCuenta.Activa" Compacto="true" Texto="Leyendo la cuenta…">
                    @if (_reglasDeLaCuenta is { } reglas)
                    {
                        <div class="info-card">
                            <h4>Reglas de la cuenta @_cuenta?.Code</h4>
                            <p class="texto-tenue">Lo que la cuenta exige a cada línea: si Cartera no puede darlo, la evaluación del hecho lo dirá antes de emitirlo.</p>
                            <ReglasDeCuenta Modelo="@reglas" SoloLectura="true" />
                        </div>
                    }
                </IndicadorDeCarga>
                <div class="toolbar">
                    <SfButton CssClass="e-primary" Disabled="@(!PuedeCrear)" OnClick="@CrearAsync">Guardar</SfButton>
                    <SfButton CssClass="e-outline" OnClick="@(() => _mostrarAlta = false)">Cancelar</SfButton>
                </div>
            </IndicadorDeCarga>
        </Content>
    </DialogTemplates>
</SfDialog>

<SfDialog @bind-Visible="_mostrarVersion" Header="Nueva versión de la regla" Width="640px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@_guardado.Activa" Texto="Guardando…">
                @if (_editando is { } e)
                {
                    <p>@TextosDeContabilidadDeCartera.Rol(e.Role) · @Hecho(e.Operation) · @Dimensiones(e.Dimensions). Hoy: @e.Account.Code @e.Account.Name desde @e.ValidFrom.ToString("dd/MM/yyyy").</p>
                    <p class="texto-tenue">La versión vigente se cierra la víspera de la fecha nueva. No puede empezar en o antes de la fecha del último hecho ya contabilizado con esta clave: lo pasado se corrige con un comprobante manual.</p>
                }
                <div class="form-grid">
                    <label class="campo campo-ancho">Cuenta * <BuscadorDeCuenta Modulo="CAR" Cuenta="@_cuenta" CuentaChanged="@ElegirCuentaAsync" /></label>
                    <label class="campo">Vigente desde * <input type="date" class="e-input" value="@(_f.Desde?.ToString("yyyy-MM-dd"))" @onchange="@(ev => _f.Desde = LeerFecha(ev.Value))" /></label>
                    <label class="campo">Centro de costo
                        <select class="e-input" value="@(_f.Centro?.ToString() ?? "")" @onchange="@(ev => _f.Centro = Guid.TryParse(ev.Value?.ToString(), out var g) ? g : null)">
                            <option value="">Ninguno</option>
                            @foreach (var c in _centros) { <option value="@c.PublicId">@c.Name</option> }
                        </select>
                    </label>
                    <label class="campo campo-ancho">Notas <input class="e-input" @bind="_f.Notas" maxlength="500" /></label>
                    <label class="campo campo-ancho">Motivo * <input class="e-input" @bind="_f.Motivo" @bind:event="oninput" maxlength="500" /></label>
                </div>
                <IndicadorDeCarga Cargando="@_cargaCuenta.Activa" Compacto="true" Texto="Leyendo la cuenta…">
                    @if (_reglasDeLaCuenta is { } reglas) { <ReglasDeCuenta Modelo="@reglas" SoloLectura="true" /> }
                </IndicadorDeCarga>
                <div class="toolbar">
                    <SfButton CssClass="e-primary" Disabled="@(_guardado.Activa || _cuenta is null || _f.Desde is null || string.IsNullOrWhiteSpace(_f.Motivo))" OnClick="@GuardarVersionAsync">Guardar</SfButton>
                    <SfButton CssClass="e-outline" OnClick="@(() => _mostrarVersion = false)">Cancelar</SfButton>
                </div>
            </IndicadorDeCarga>
        </Content>
    </DialogTemplates>
</SfDialog>

<SfDialog @bind-Visible="_mostrarDesactivar" Header="Desactivar la regla" Width="520px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@_guardado.Activa" Texto="Guardando…">
                <p>La regla deja de valer desde el día siguiente a la fecha elegida; no se borra y queda en su historia. Lo que ya se contabilizó con ella no cambia.</p>
                <div class="form-grid">
                    <label class="campo">Vigente hasta * <input type="date" class="e-input" value="@(_f.Hasta?.ToString("yyyy-MM-dd"))" @onchange="@(ev => _f.Hasta = LeerFecha(ev.Value))" /></label>
                    <label class="campo campo-ancho">Motivo * <input class="e-input" @bind="_f.Motivo" @bind:event="oninput" maxlength="500" /></label>
                </div>
                <div class="toolbar">
                    <SfButton CssClass="e-primary" Disabled="@(_guardado.Activa || _f.Hasta is null || string.IsNullOrWhiteSpace(_f.Motivo))" OnClick="@DesactivarAsync">Desactivar</SfButton>
                    <SfButton CssClass="e-outline" OnClick="@(() => _mostrarDesactivar = false)">Cancelar</SfButton>
                </div>
            </IndicadorDeCarga>
        </Content>
    </DialogTemplates>
</SfDialog>

<SfDialog @bind-Visible="_mostrarResolver" Header="¿A qué cuenta va esta combinación?" Width="760px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@_resolviendo.Activa" Texto="Buscando la regla…">
                <p class="texto-tenue">Elija el hecho, el rol y las dimensiones de la combinación: se resuelve con la misma matriz con que se contabiliza, a la fecha indicada.</p>
                <div class="form-grid">
                    <label class="campo">Hecho *
                        <select class="e-input" value="@(_f.Operacion ?? "")" @onchange="@(e => { _f.Operacion = Vacio(e.Value?.ToString()); _f.Rol = null; _resolucion = null; })">
                            <option value="">Elija…</option>
                            @foreach (var o in (_catalogo?.Operations ?? []).Where(o => !o.IsInformational)) { <option value="@o.Code">@TextosDeContabilidadDeCartera.TipoDeHecho(o.Code)</option> }
                        </select>
                    </label>
                    <label class="campo">Rol *
                        <select class="e-input" value="@(_f.Rol ?? "")" @onchange="@(e => { ElegirRol(e.Value?.ToString()); _resolucion = null; })">
                            <option value="">Elija…</option>
                            @foreach (var rol in RolesDelHecho) { <option value="@rol">@TextosDeContabilidadDeCartera.Rol(rol)</option> }
                        </select>
                    </label>
                    @CamposDeDimension(RolElegido(_f.Rol), true)
                    <label class="campo">Fecha <input type="date" class="e-input" value="@(_f.Desde?.ToString("yyyy-MM-dd"))" @onchange="@(e => _f.Desde = LeerFecha(e.Value))" /></label>
                </div>
                <div class="toolbar">
                    <SfButton CssClass="e-primary" Disabled="@(_resolviendo.Activa || string.IsNullOrWhiteSpace(_f.Operacion) || string.IsNullOrWhiteSpace(_f.Rol))" OnClick="@ResolverAsync">Resolver</SfButton>
                    <SfButton CssClass="e-outline" OnClick="@(() => _mostrarResolver = false)">Cerrar</SfButton>
                </div>
                @if (_resolucion is { } res)
                {
                    @if (res.Rule is { } ganadora)
                    {
                        <div class="info-card">
                            <h4>Va a @(res.Account?.Code ?? ganadora.Account.Code) · @(res.Account?.Name ?? ganadora.Account.Name)</h4>
                            <p class="texto-tenue">Regla de peso @ganadora.SpecificityWeight (@Dimensiones(ganadora.Dimensions)), vigente desde @ganadora.ValidFrom.ToString("dd/MM/yyyy").</p>
                            @if (res.Account is { IsEligible: false }) { <p class="aviso aviso-alerta">La cuenta ya no es elegible para Cartera: el hecho se rechazaría.</p> }
                            <SfButton CssClass="e-flat e-small" OnClick="@(() => VerReglaAsync(ganadora.RulePublicId))">Ver la regla</SfButton>
                        </div>
                    }
                    else
                    {
                        <p class="aviso aviso-alerta">@(res.MissingMessage ?? "No hay una regla vigente para esa combinación.")</p>
                    }
                    @if (res.Candidates.Count > 0)
                    {
                        <h4>Candidatas del rol</h4>
                        <div class="tabla-desplazable">
                            <table class="data-grid">
                                <thead><tr><th>Clave</th><th class="numero">Peso</th><th>Casa</th></tr></thead>
                                <tbody>
                                    @foreach (var c in res.Candidates)
                                    {
                                        <tr class="@(c.RulePublicId == res.Rule?.RulePublicId ? "resaltada" : "")">
                                            <td><code>@c.DimensionKey</code></td>
                                            <td class="numero">@c.SpecificityWeight</td>
                                            <td>@(c.Matched ? "Sí" : "No")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </IndicadorDeCarga>
        </Content>
    </DialogTemplates>
</SfDialog>
</PermissionGate>

@code {
    private sealed class Formulario
    {
        public string? Operacion { get; set; }
        public string? Rol { get; set; }
        public string? Linea { get; set; }
        public string? Modalidad { get; set; }
        public string? Subsegmento { get; set; }
        public string? Categoria { get; set; }
        public string? Concepto { get; set; }
        public bool? Empleado { get; set; }
        public bool? Gracia { get; set; }
        public bool? PorCuentaDelAsociado { get; set; }
        public bool? Reestructurado { get; set; }
        public string? ClaseDeRecaudador { get; set; }
        public string? CodigoDeMotivo { get; set; }
        public Guid? Sucursal { get; set; }
        public Guid? Centro { get; set; }
        public DateOnly? Desde { get; set; }
        public DateOnly? Hasta { get; set; }
        public string? Notas { get; set; }

        /// <summary>El motivo del cambio (auditoría); <see cref="CodigoDeMotivo"/> es la dimensión <c>reasonCode</c>.</summary>
        public string? Motivo { get; set; }
    }

    private sealed class ItemCrudo { public Guid PublicId { get; set; } public string Name { get; set; } = ""; }

    [SupplyParameterFromQuery(Name = "operacion")] public string? OperacionInicial { get; set; }
    [SupplyParameterFromQuery(Name = "rol")] public string? RolInicial { get; set; }
    [SupplyParameterFromQuery(Name = "regla")] public Guid? ReglaInicial { get; set; }
    [SupplyParameterFromQuery(Name = "cuenta")] public string? CuentaInicial { get; set; }

    private readonly EstadoDeCarga _carga = new(), _guardado = new(), _cargaCuenta = new(), _cargaVersiones = new(), _resolviendo = new();
    private CatalogoDeReglasDeCarteraDto? _catalogo;
    private List<ReglaDeCarteraDto> _reglas = [], _versiones = [];
    private List<ItemCrudo> _sucursales = [], _centros = [];
    private string _familia = TextosDeContabilidadDeCartera.Familias[0].Clave;
    private string? _filtroRol, _filtroCuenta, _error;
    private DateOnly? _filtroFecha;
    private bool _soloVigentes = true, _mostrarPlantilla, _mostrarAlta, _mostrarVersion, _mostrarDesactivar, _mostrarResolver;
    private Formulario _f = new();
    private CuentaBuscadaDto? _cuenta;
    private ReglasDeCuentaModelo? _reglasDeLaCuenta;
    private ReglaDeCarteraDto? _editando, _versionesDe;
    private ResolucionDeReglaDeCarteraDto? _resolucion;
    private Guid? _resaltada;

    /// <summary>Las familias que trae el catálogo, en el orden de las pestañas (una familia desconocida va al final con su clave).</summary>
    private IEnumerable<string> FamiliasDelCatalogo
    {
        get
        {
            var presentes = (_catalogo?.Roles ?? []).Select(r => r.Family).Distinct().ToList();
            if (presentes.Count == 0) return TextosDeContabilidadDeCartera.Familias.Select(f => f.Clave);
            return TextosDeContabilidadDeCartera.Familias.Select(f => f.Clave).Where(presentes.Contains)
                .Concat(presentes.Where(p => TextosDeContabilidadDeCartera.Familias.All(f => f.Clave != p)));
        }
    }

    private IEnumerable<RolDelCatalogoDeCarteraDto> RolesDeLaFamilia => (_catalogo?.Roles ?? []).Where(r => r.Family == _familia);

    /// <summary>Los roles del hecho elegido en «¿a qué cuenta va?» (débito y crédito).</summary>
    private IEnumerable<string> RolesDelHecho => (_catalogo?.Operations ?? []).FirstOrDefault(o => o.Code == _f.Operacion) is { } op
        ? op.DebitRoles.Concat(op.CreditRoles).Distinct()
        : [];

    private RolDelCatalogoDeCarteraDto? RolElegido(string? rol) => _catalogo?.Roles.FirstOrDefault(r => r.Code == rol);

    private bool PuedeCrear => !_guardado.Activa && !string.IsNullOrWhiteSpace(_f.Rol) && _cuenta is not null && _f.Desde is not null
                               && !string.IsNullOrWhiteSpace(_f.Motivo);

    protected override async Task OnInitializedAsync()
    {
        using var carga = _carga.Iniciar();
        var catalogo = Integracion.CatalogoAsync();
        var sucursales = Http.TryGetListAsync<ItemCrudo>("/api/core/branches?PageNumber=1&PageSize=500&SortBy=name");
        var centros = Http.TryGetListAsync<ItemCrudo>("/api/core/cost-centers?PageNumber=1&PageSize=500");
        await Task.WhenAll(catalogo, sucursales, centros);
        _catalogo = catalogo.Result.IsSuccess ? catalogo.Result.Value : null;
        if (_catalogo is null) await Notification.ErrorAsync(catalogo.Result.ErrorMessage ?? "No se pudo leer el catálogo de la matriz.");
        _sucursales = sucursales.Result;
        _centros = centros.Result;
        _familia = FamiliasDelCatalogo.FirstOrDefault() ?? _familia;

        // Desde la completitud: «Crear la regla» trae hecho y rol; «Ver la regla», su id; «Plan de cuentas», la cuenta.
        if (ReglaInicial is { } id && (await Integracion.ReglaAsync(id)) is { IsSuccess: true, Value: { } regla })
        {
            _familia = RolElegido(regla.Role)?.Family ?? _familia;
            _filtroRol = regla.Role;
            _soloVigentes = false;
            _resaltada = regla.RulePublicId;
        }
        else if (RolElegido(RolInicial) is { } rol)
        {
            _familia = rol.Family;
            _filtroRol = rol.Code;
        }
        if (!string.IsNullOrWhiteSpace(CuentaInicial)) _filtroCuenta = CuentaInicial.Trim();
        await CargarAsync();
        if (RolInicial is not null && ReglaInicial is null && RolElegido(RolInicial) is not null)
        {
            AbrirAlta();
            ElegirRol(RolInicial);
            if (RolElegido(RolInicial)?.AllowsOperation == true && !string.IsNullOrWhiteSpace(OperacionInicial) && OperacionInicial != "*")
                _f.Operacion = OperacionInicial;
        }
    }

    private async Task CambiarFamiliaAsync(string familia)
    {
        _familia = familia;
        _filtroRol = null;
        await CargarAsync();
    }

    private async Task FiltrarPorCuentaAsync(string cuenta)
    {
        _filtroCuenta = cuenta;
        _filtroRol = null;
        await CargarAsync();
    }

    /// <summary>Las reglas de los roles de la familia (una consulta por rol: la lista filtra un rol a la vez).</summary>
    private async Task CargarAsync()
    {
        using var carga = _carga.Iniciar();
        var roles = _filtroRol is { } uno ? [uno] : RolesDeLaFamilia.Select(r => r.Code).ToList();
        var cuenta = string.IsNullOrWhiteSpace(_filtroCuenta) ? null : _filtroCuenta.Trim();
        var consultas = roles.Select(rol => Integracion.ReglasAsync(new FiltroDeReglasDeCartera(Rol: rol, ALaFecha: _filtroFecha, Cuenta: cuenta,
            SoloVigentes: _soloVigentes, TamanoDePagina: 200))).ToList();
        await Task.WhenAll(consultas);
        var fallida = consultas.Select(c => c.Result).FirstOrDefault(r => !r.IsSuccess);
        _error = fallida?.ErrorMessage;
        if (fallida is not null) await Notification.ErrorAsync(fallida.ErrorMessage ?? "No se pudieron consultar las reglas.");
        _reglas = [.. consultas.Where(c => c.Result.IsSuccess).SelectMany(c => c.Result.Value?.Items ?? [])
            .OrderBy(r => r.Role).ThenByDescending(r => r.SpecificityWeight).ThenBy(r => r.DimensionKey).ThenByDescending(r => r.ValidFrom)];
    }

    private async Task VerVersionesAsync(ReglaDeCarteraDto regla)
    {
        _versionesDe = regla;
        using var carga = _cargaVersiones.Iniciar();
        var r = await Integracion.VersionesDeReglaAsync(regla.RulePublicId);
        _versiones = r.IsSuccess ? [.. r.Value ?? []] : [];
        if (!r.IsSuccess) await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudieron leer las versiones.");
    }

    private async Task VerReglaAsync(Guid id)
    {
        _mostrarResolver = false;
        var r = await Integracion.ReglaAsync(id);
        if (!r.IsSuccess || r.Value is null) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo leer la regla."); return; }
        _familia = RolElegido(r.Value.Role)?.Family ?? _familia;
        _filtroRol = r.Value.Role;
        _soloVigentes = false;
        _resaltada = id;
        await CargarAsync();
    }

    private void AbrirAlta()
    {
        _f = new Formulario { Desde = DateOnly.FromDateTime(DateTime.Today) };
        _cuenta = null;
        _reglasDeLaCuenta = null;
        _mostrarAlta = true;
    }

    private void AbrirResolver()
    {
        _f = new Formulario { Desde = DateOnly.FromDateTime(DateTime.Today) };
        _resolucion = null;
        _mostrarResolver = true;
    }

    private void AbrirVersion(ReglaDeCarteraDto regla)
    {
        _editando = regla;
        _f = new Formulario { Desde = DateOnly.FromDateTime(DateTime.Today).AddDays(1), Centro = regla.Dimensions.CostCenter?.PublicId };
        _cuenta = null;
        _reglasDeLaCuenta = null;
        _mostrarVersion = true;
    }

    private void AbrirDesactivar(ReglaDeCarteraDto regla)
    {
        _editando = regla;
        _f = new Formulario { Hasta = DateOnly.FromDateTime(DateTime.Today) };
        _mostrarDesactivar = true;
    }

    /// <summary>Cambiar el rol limpia las dimensiones: cada rol admite las suyas.</summary>
    private void ElegirRol(string? rol)
    {
        var operacion = _f.Operacion;
        _f = new Formulario
        {
            Rol = Vacio(rol), Operacion = operacion, Desde = _f.Desde, Hasta = _f.Hasta, Notas = _f.Notas, Motivo = _f.Motivo,
            Centro = _f.Centro,
        };
    }

    /// <summary>Al elegir la cuenta se leen sus reglas y se muestran (FR-016 de la 009).</summary>
    private async Task ElegirCuentaAsync(CuentaBuscadaDto? cuenta)
    {
        _cuenta = cuenta;
        _reglasDeLaCuenta = null;
        if (cuenta is null) return;
        using var carga = _cargaCuenta.Iniciar();
        var r = await Contabilidad.ObtenerCuentaAsync(cuenta.PublicId);
        if (r.IsSuccess && r.Value is { } c) _reglasDeLaCuenta = ReglasDeCuentaModelo.Desde(c);
    }

    /// <summary>Sólo las dimensiones que el rol admite; las que no, no viajan.</summary>
    private DimensionesDeReglaDeCarteraRequest DimensionesDelFormulario()
    {
        var permitidas = (RolElegido(_f.Rol)?.AllowedDimensions ?? []).ToHashSet();
        string? Si(string dimension, string? valor) => permitidas.Contains(dimension) && !string.IsNullOrWhiteSpace(valor) ? valor : null;
        bool? SiB(string dimension, bool? valor) => permitidas.Contains(dimension) ? valor : null;
        return new DimensionesDeReglaDeCarteraRequest(
            Si("creditLineCode", _f.Linea), Si("modalityCode", _f.Modalidad), Si("subsegmentCode", _f.Subsegmento), Si("riskCategory", _f.Categoria),
            Si("conceptCode", _f.Concepto), SiB("isEmployee", _f.Empleado), SiB("inGracePeriod", _f.Gracia),
            SiB("onBehalfOfAssociate", _f.PorCuentaDelAsociado), SiB("restructured", _f.Reestructurado), Si("collectorClass", _f.ClaseDeRecaudador),
            Si("reasonCode", _f.CodigoDeMotivo), permitidas.Contains("branch") ? _f.Sucursal : null, _f.Centro);
    }

    private async Task CrearAsync()
    {
        if (!PuedeCrear) return;
        using var guardado = _guardado.Iniciar();
        var operacion = RolElegido(_f.Rol)?.AllowsOperation == true ? Vacio(_f.Operacion) : null;
        var r = await Integracion.CrearReglaAsync(new CrearReglaDeCarteraRequest(operacion, _f.Rol!, DimensionesDelFormulario(), _cuenta!.PublicId,
            _f.Desde!.Value, Vacio(_f.Notas), _f.Motivo!.Trim(), _f.Hasta));
        if (!r.IsSuccess || r.Value is null)
        {
            await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo guardar la regla.");
            return;
        }
        _mostrarAlta = false;
        await AvisarAsync(r.Value, "Regla guardada.");
        _resaltada = r.Value.RulePublicId;
        _familia = RolElegido(_f.Rol)?.Family ?? _familia;
        await CargarAsync();
    }

    private async Task GuardarVersionAsync()
    {
        if (_editando is null || _cuenta is null || _f.Desde is not { } desde || string.IsNullOrWhiteSpace(_f.Motivo)) return;
        using var guardado = _guardado.Iniciar();
        var r = await Integracion.NuevaVersionDeReglaAsync(_editando.RulePublicId, new VersionDeReglaDeCarteraRequest(_cuenta.PublicId, desde,
            Vacio(_f.Notas), _f.Motivo.Trim(), _f.Centro));
        if (!r.IsSuccess || r.Value is null)
        {
            await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo guardar la versión.");
            return;
        }
        _mostrarVersion = false;
        await AvisarAsync(r.Value, "Versión guardada: la anterior se cerró la víspera.");
        _resaltada = r.Value.RulePublicId;
        await CargarAsync();
    }

    private async Task DesactivarAsync()
    {
        if (_editando is null || _f.Hasta is not { } hasta || string.IsNullOrWhiteSpace(_f.Motivo)) return;
        using var guardado = _guardado.Iniciar();
        var r = await Integracion.DesactivarReglaAsync(_editando.RulePublicId, new DesactivarReglaDeCarteraRequest(hasta, _f.Motivo.Trim()));
        if (!r.IsSuccess)
        {
            await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo desactivar la regla.");
            return;
        }
        _mostrarDesactivar = false;
        await Notification.SuccessAsync("Regla desactivada.");
        await CargarAsync();
    }

    private async Task ResolverAsync()
    {
        if (string.IsNullOrWhiteSpace(_f.Operacion) || string.IsNullOrWhiteSpace(_f.Rol)) return;
        using var carga = _resolviendo.Iniciar();
        var r = await Integracion.ResolverAsync(new ResolverReglaDeCarteraRequest(_f.Operacion, _f.Rol, DimensionesDelFormulario(), _f.Desde));
        _resolucion = r.IsSuccess ? r.Value : null;
        if (!r.IsSuccess) await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo resolver la combinación.");
    }

    private async Task AvisarAsync(ReglaGuardadaDeCarteraDto guardada, string exito)
    {
        await Notification.SuccessAsync(exito);
        foreach (var aviso in guardada.Warnings) await Notification.WarningAsync(aviso.Message);
    }

    /// <summary>
    /// Los campos de las dimensiones que admite el rol (las exigidas con *): el hecho sólo en los roles de resultado y fuera de «¿a qué cuenta
    /// va?», que lo pide aparte.
    /// </summary>
    private RenderFragment CamposDeDimension(RolDelCatalogoDeCarteraDto? rol, bool sinHecho) => __builder =>
    {
        if (rol is null || _catalogo is null) return;
        foreach (var d in rol.AllowedDimensions)
        {
            var dimension = d;
            if (dimension == "operation" && sinHecho) continue;
            var exigida = rol.RequiredDimensions.Contains(dimension);
            var vacia = exigida ? "Elija…" : "Cualquiera";
            <label class="campo">@TextosDeContabilidadDeCartera.Dimension(dimension)@(exigida ? " *" : "")
                @switch (dimension)
                {
                    case "operation":
                        <select class="e-input" value="@(_f.Operacion ?? "")" @onchange="@(e => _f.Operacion = Vacio(e.Value?.ToString()))">
                            <option value="">Todos</option>
                            @foreach (var o in _catalogo.Operations.Where(o => o.DebitRoles.Contains(rol.Code) || o.CreditRoles.Contains(rol.Code)))
                            {
                                <option value="@o.Code">@TextosDeContabilidadDeCartera.TipoDeHecho(o.Code)</option>
                            }
                        </select>
                        break;
                    case "creditLineCode":
                        <select class="e-input" @bind="_f.Linea">
                            <option value="">@vacia</option>
                            @foreach (var l in _catalogo.Dimensions.CreditLines.OrderByDescending(l => l.Active).ThenBy(l => l.Code))
                            {
                                <option value="@l.Code">@l.Code · @l.Name@(l.Active ? "" : " (inactiva)")</option>
                            }
                        </select>
                        break;
                    case "modalityCode":
                        <select class="e-input" @bind="_f.Modalidad">
                            <option value="">@vacia</option>
                            @foreach (var m in _catalogo.Dimensions.Modalities) { <option value="@m.Code">@m.Code · @m.Name</option> }
                        </select>
                        break;
                    case "subsegmentCode":
                        <select class="e-input" @bind="_f.Subsegmento">
                            <option value="">@vacia</option>
                            @foreach (var s in Subsegmentos) { <option value="@s">@s</option> }
                        </select>
                        break;
                    case "riskCategory":
                        <select class="e-input" @bind="_f.Categoria">
                            <option value="">@vacia</option>
                            @foreach (var c in _catalogo.Dimensions.RiskCategories) { <option value="@c">@c</option> }
                        </select>
                        break;
                    case "conceptCode":
                        <select class="e-input" @bind="_f.Concepto">
                            <option value="">@vacia</option>
                            @foreach (var c in rol.Concepts ?? _catalogo.Dimensions.Concepts) { <option value="@c">@TextosDeCreditos.Concepto(c)</option> }
                        </select>
                        break;
                    case "isEmployee":
                        @CampoSiNo(_f.Empleado, v => _f.Empleado = v)
                        break;
                    case "inGracePeriod":
                        @CampoSiNo(_f.Gracia, v => _f.Gracia = v)
                        break;
                    case "onBehalfOfAssociate":
                        @CampoSiNo(_f.PorCuentaDelAsociado, v => _f.PorCuentaDelAsociado = v)
                        break;
                    case "restructured":
                        @CampoSiNo(_f.Reestructurado, v => _f.Reestructurado = v)
                        break;
                    case "collectorClass":
                        <select class="e-input" @bind="_f.ClaseDeRecaudador">
                            <option value="">@vacia</option>
                            @foreach (var c in _catalogo.Dimensions.CollectorClasses) { <option value="@c">@TextosDePagos.ClaseDeRecaudador(c)</option> }
                        </select>
                        break;
                    case "reasonCode":
                        <select class="e-input" @bind="_f.CodigoDeMotivo">
                            <option value="">@vacia</option>
                            @foreach (var m in rol.Reasons ?? _catalogo.Dimensions.Reasons) { <option value="@m">@TextosDeContabilidadDeCartera.Motivo(m)</option> }
                        </select>
                        break;
                    case "branch":
                        <select class="e-input" value="@(_f.Sucursal?.ToString() ?? "")" @onchange="@(e => _f.Sucursal = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null)">
                            <option value="">Cualquiera</option>
                            @foreach (var s in _sucursales) { <option value="@s.PublicId">@s.Name</option> }
                        </select>
                        break;
                }
            </label>
        }
    };

    /// <summary>Una dimensión sí/no: vacía es «cualquiera».</summary>
    private RenderFragment CampoSiNo(bool? valor, Action<bool?> cambiar) => __builder =>
    {
        <select class="e-input" value="@(valor switch { true => "true", false => "false", _ => "" })"
                @onchange="@(e => cambiar(bool.TryParse(e.Value?.ToString(), out var b) ? b : null))">
            <option value="">Cualquiera</option>
            <option value="true">Sí</option>
            <option value="false">No</option>
        </select>
    };

    /// <summary>Los subsegmentos de la modalidad elegida, o todos si no hay modalidad.</summary>
    private IEnumerable<string> Subsegmentos => (_catalogo?.Dimensions.Modalities ?? [])
        .Where(m => string.IsNullOrWhiteSpace(_f.Modalidad) || m.Code == _f.Modalidad)
        .SelectMany(m => m.SubsegmentCodes).Distinct().OrderBy(s => s);

    private static string Hecho(string? operacion) => string.IsNullOrWhiteSpace(operacion) || operacion == "*"
        ? "Todos"
        : TextosDeContabilidadDeCartera.TipoDeHecho(operacion);

    private static string Dimensiones(DimensionesDeReglaDeCarteraDto d)
    {
        static string SiNo(bool v) => v ? "sí" : "no";
        var partes = new[]
        {
            d.CreditLineCode is { } l ? $"línea {l}" : null,
            d.ModalityCode is { } m ? $"modalidad {m}" : null,
            d.SubsegmentCode is { } s ? $"subsegmento {s}" : null,
            d.RiskCategory is { } c ? $"categoría {c}" : null,
            d.ConceptCode is { } k ? IngenIA365ERP.Shared.Services.Cartera.TextosDeCreditos.Concepto(k).ToLowerInvariant() : null,
            d.IsEmployee is { } e ? $"empleado {SiNo(e)}" : null,
            d.InGracePeriod is { } g ? $"en gracia {SiNo(g)}" : null,
            d.OnBehalfOfAssociate is { } p ? $"por cuenta del asociado {SiNo(p)}" : null,
            d.Restructured is { } r ? $"reestructurado {SiNo(r)}" : null,
            d.CollectorClass is { } q ? $"recaudo {TextosDePagos.ClaseDeRecaudador(q).ToLowerInvariant()}" : null,
            d.ReasonCode is { } mo ? $"motivo {TextosDeContabilidadDeCartera.Motivo(mo).ToLowerInvariant()}" : null,
            d.Branch is { } b ? $"sucursal {b.Code}" : null,
            d.CostCenter is { } cc ? $"centro {cc.Code}" : null,
        }.Where(x => x is not null).ToList();
        return partes.Count == 0 ? "Todas" : string.Join(" · ", partes);
    }

    private static string? Vacio(string? valor) => string.IsNullOrWhiteSpace(valor) ? null : valor.Trim();

    private static DateOnly? LeerFecha(object? valor) =>
        DateOnly.TryParse(valor?.ToString(), System.Globalization.CultureInfo.InvariantCulture, out var f) ? f : null;
}
