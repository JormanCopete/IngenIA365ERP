@page "/contabilidad/codigos-impuestos"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification

<PageTitle>Codigos de Impuestos - IngenIA365ERP</PageTitle>

<div class="page-header">
    <h3>Codigos de Impuestos</h3>
    <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@OpenCreate">Nuevo</SfButton>
</div>

<SfGrid @ref="_grid" TValue="TaxFormCodeItem" DataSource="@_items"
    AllowPaging="true" AllowSorting="true" AllowFiltering="true">
    <GridColumns>
        <GridColumn Field="FormCode" HeaderText="Codigo Formulario" Width="180" />
        <GridColumn Field="Description" HeaderText="Descripcion" Width="280" />
        <GridColumn Field="AccountCode" HeaderText="Cuenta Contable" Width="180" />
        <GridColumn Field="TaxType" HeaderText="Tipo Impuesto" Width="150" />
        <GridColumn HeaderText="Acciones" Width="150" TextAlign="TextAlign.Center">
            <Template>
                @{
                    var item = context as TaxFormCodeItem;
                    <SfButton CssClass="e-flat e-small" IconCss="e-icons e-edit" OnClick="@(() => OpenEdit(item!))" />
                    <SfButton CssClass="e-flat e-small e-danger" IconCss="e-icons e-trash" OnClick="@(() => OpenDelete(item!))" />
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

<SfDialog @bind-Visible="_showDialog" Header="@_dialogTitle" Width="500px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <div style="padding:10px;display:flex;flex-direction:column;gap:16px;">
                <div>
                    <label>Codigo Formulario *</label>
                    <SfTextBox @bind-Value="_model.FormCode" Placeholder="Codigo del formulario" />
                </div>
                <div>
                    <label>Descripcion *</label>
                    <SfTextBox @bind-Value="_model.Description" Placeholder="Descripcion" />
                </div>
                <div>
                    <label>Cuenta Contable</label>
                    <SfTextBox @bind-Value="_model.AccountCode" Placeholder="Codigo cuenta contable" />
                </div>
                <div>
                    <label>Tipo Impuesto</label>
                    <SfTextBox @bind-Value="_model.TaxType" Placeholder="Tipo de impuesto" />
                </div>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _showDialog = false)" />
        <DialogButton Content="Guardar" IsPrimary="true" OnClick="@Save" />
    </DialogButtons>
</SfDialog>

<ConfirmDialog @bind-Visible="_showConfirm" OnConfirm="ConfirmDelete"
    Message="Esta seguro de eliminar este registro?" />

@code {
    private SfGrid<TaxFormCodeItem>? _grid;
    private List<TaxFormCodeItem> _items = [];
    private TaxFormCodeModel _model = new();
    private Guid? _editId;
    private bool _showDialog, _showConfirm;
    private string _dialogTitle = "";
    private Guid _deleteId;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        try { _items = await Http.GetFromJsonAsync<List<TaxFormCodeItem>>("/api/accounting/tax-form-codes?pageSize=500") ?? []; }
        catch { _items = []; }
    }

    private void OpenCreate() { _model = new(); _editId = null; _dialogTitle = "Nuevo Codigo de Impuesto"; _showDialog = true; }

    private void OpenEdit(TaxFormCodeItem item)
    {
        _model = new()
        {
            FormCode = item.FormCode,
            Description = item.Description,
            AccountCode = item.AccountCode,
            TaxType = item.TaxType
        };
        _editId = item.PublicId;
        _dialogTitle = "Editar Codigo de Impuesto";
        _showDialog = true;
    }

    private void OpenDelete(TaxFormCodeItem item) { _deleteId = item.PublicId; _showConfirm = true; }

    private async Task Save()
    {
        HttpResponseMessage res;
        if (_editId.HasValue)
            res = await Http.PutAsJsonAsync($"/api/accounting/tax-form-codes/{_editId}", _model);
        else
            res = await Http.PostAsJsonAsync("/api/accounting/tax-form-codes", _model);

        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro guardado");
            _showDialog = false;
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al guardar");
    }

    private async Task ConfirmDelete()
    {
        var res = await Http.DeleteAsync($"/api/accounting/tax-form-codes/{_deleteId}");
        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro eliminado");
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al eliminar");
    }

    private class TaxFormCodeItem
    {
        public Guid PublicId { get; set; }
        public string FormCode { get; set; } = "";
        public string Description { get; set; } = "";
        public string? AccountCode { get; set; }
        public string? TaxType { get; set; }
    }

    private class TaxFormCodeModel
    {
        public string FormCode { get; set; } = "";
        public string Description { get; set; } = "";
        public string? AccountCode { get; set; }
        public string? TaxType { get; set; }
    }
}
