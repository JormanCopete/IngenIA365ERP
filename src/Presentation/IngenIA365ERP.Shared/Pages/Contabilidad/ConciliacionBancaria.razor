@page "/contabilidad/conciliacion"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification

<PageTitle>Conciliacion Bancaria - IngenIA365ERP</PageTitle>

<div class="page-header">
    <h3>Conciliacion Bancaria</h3>
</div>

<!-- Header controls -->
<div style="display:flex;gap:12px;margin-bottom:16px;flex-wrap:wrap;align-items:end;">
    <div>
        <label>Cuenta Bancaria</label>
        <SfDropDownList TValue="string" TItem="BankAccountOption" @bind-Value="_selectedAccount"
                        DataSource="_bankAccounts" CssClass="e-small" Width="300px" Placeholder="Seleccione cuenta">
            <DropDownListFieldSettings Text="Display" Value="Code" />
        </SfDropDownList>
    </div>
    <div>
        <label>Anio</label>
        <SfNumericTextBox TValue="int" @bind-Value="_year" Format="####" Min="2000" Max="2099"
                          CssClass="e-small" Width="90px" />
    </div>
    <div>
        <label>Mes</label>
        <SfDropDownList TValue="int" TItem="MonthOption" @bind-Value="_month" DataSource="_months"
                        CssClass="e-small" Width="150px">
            <DropDownListFieldSettings Text="Name" Value="Value" />
        </SfDropDownList>
    </div>
    <SfButton CssClass="e-primary e-small" IconCss="e-icons e-reload" OnClick="LoadReconciliation">Cargar</SfButton>
    <SfButton CssClass="e-success e-small" IconCss="e-icons e-save" OnClick="SaveReconciliation"
              Disabled="@(!_hasData)">Guardar</SfButton>
</div>

@if (_hasData)
{
    <!-- Summary cards -->
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:16px;margin-bottom:20px;">
        <div style="padding:16px;border:1px solid #e0e0e0;border-radius:4px;background:#f9f9f9;">
            <span style="font-size:12px;color:#666;">Saldo Contable</span><br/>
            <strong style="font-size:18px;">@_summary.BookBalance.ToString("N2")</strong>
        </div>
        <div style="padding:16px;border:1px solid #e0e0e0;border-radius:4px;background:#f9f9f9;">
            <span style="font-size:12px;color:#666;">Saldo Banco</span><br/>
            <strong style="font-size:18px;">@_summary.BankBalance.ToString("N2")</strong>
        </div>
        <div style="padding:16px;border:1px solid #e0e0e0;border-radius:4px;background:#f9f9f9;">
            <span style="font-size:12px;color:#666;">Partidas Pendientes (DB)</span><br/>
            <strong style="font-size:18px;color:@(_summary.PendingDebits != 0 ? "orange" : "inherit");">@_summary.PendingDebits.ToString("N2")</strong>
        </div>
        <div style="padding:16px;border:1px solid #e0e0e0;border-radius:4px;background:#f9f9f9;">
            <span style="font-size:12px;color:#666;">Partidas Pendientes (CR)</span><br/>
            <strong style="font-size:18px;color:@(_summary.PendingCredits != 0 ? "orange" : "inherit");">@_summary.PendingCredits.ToString("N2")</strong>
        </div>
        <div style="padding:16px;border:1px solid #e0e0e0;border-radius:4px;background:@(_summary.Difference == 0 ? "#e8f5e9" : "#ffebee");">
            <span style="font-size:12px;color:#666;">Diferencia</span><br/>
            <strong style="font-size:18px;color:@(_summary.Difference == 0 ? "green" : "red");">@_summary.Difference.ToString("N2")</strong>
        </div>
    </div>

    <!-- Two-panel layout -->
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
        <!-- Left panel: Accounting entries -->
        <div>
            <h4 style="margin:0 0 8px 0;">Movimientos Contables</h4>
            <SfGrid @ref="_bookGrid" TValue="ReconciliationItem" DataSource="_bookItems"
                    AllowPaging="true" AllowSorting="true" Height="400">
                <GridPageSettings PageSize="20" />
                <GridColumns>
                    <GridColumn HeaderText="" Width="50" TextAlign="TextAlign.Center">
                        <Template>
                            @{
                                var item = context as ReconciliationItem;
                            }
                            <SfCheckBox TChecked="bool" @bind-Checked="item!.IsReconciled"
                                        ValueChange="@((Syncfusion.Blazor.Buttons.ChangeEventArgs<bool> e) => OnReconcileToggle(item, e.Checked))" />
                        </Template>
                    </GridColumn>
                    <GridColumn Field="TransactionDate" HeaderText="Fecha" Width="100" Format="d" Type="ColumnType.Date" />
                    <GridColumn Field="DocumentRef" HeaderText="Ref" Width="100" />
                    <GridColumn Field="Description" HeaderText="Descripcion" Width="200" />
                    <GridColumn Field="Debit" HeaderText="Debito" Width="120" Format="N2" TextAlign="TextAlign.Right" />
                    <GridColumn Field="Credit" HeaderText="Credito" Width="120" Format="N2" TextAlign="TextAlign.Right" />
                </GridColumns>
                <GridAggregates>
                    <GridAggregate>
                        <GridAggregateColumns>
                            <GridAggregateColumn Field="Debit" Type="AggregateType.Sum" Format="N2">
                                <FooterTemplate>
                                    @{ var sum = (context as AggregateTemplateContext); }
                                    <span><b>@sum?.Sum</b></span>
                                </FooterTemplate>
                            </GridAggregateColumn>
                            <GridAggregateColumn Field="Credit" Type="AggregateType.Sum" Format="N2">
                                <FooterTemplate>
                                    @{ var sum = (context as AggregateTemplateContext); }
                                    <span><b>@sum?.Sum</b></span>
                                </FooterTemplate>
                            </GridAggregateColumn>
                        </GridAggregateColumns>
                    </GridAggregate>
                </GridAggregates>
            </SfGrid>
        </div>

        <!-- Right panel: Bank statement -->
        <div>
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
                <h4 style="margin:0;">Extracto Bancario</h4>
                <SfButton CssClass="e-flat e-small" IconCss="e-icons e-upload" OnClick="@(() => _showImportDialog = true)">Importar</SfButton>
            </div>
            <SfGrid TValue="BankStatementItem" DataSource="_bankItems"
                    AllowPaging="true" AllowSorting="true" Height="400">
                <GridPageSettings PageSize="20" />
                <GridColumns>
                    <GridColumn Field="TransactionDate" HeaderText="Fecha" Width="100" Format="d" Type="ColumnType.Date" />
                    <GridColumn Field="Reference" HeaderText="Referencia" Width="120" />
                    <GridColumn Field="Description" HeaderText="Descripcion" Width="200" />
                    <GridColumn Field="Debit" HeaderText="Debito" Width="120" Format="N2" TextAlign="TextAlign.Right" />
                    <GridColumn Field="Credit" HeaderText="Credito" Width="120" Format="N2" TextAlign="TextAlign.Right" />
                    <GridColumn Field="StatusText" HeaderText="Estado" Width="100">
                        <Template>
                            @{
                                var item = context as BankStatementItem;
                                var badge = item?.IsMatched == true ? "e-badge e-badge-success" : "e-badge e-badge-warning";
                                var text = item?.IsMatched == true ? "Cruzado" : "Pendiente";
                            }
                            <span class="@badge">@text</span>
                        </Template>
                    </GridColumn>
                </GridColumns>
                <GridAggregates>
                    <GridAggregate>
                        <GridAggregateColumns>
                            <GridAggregateColumn Field="Debit" Type="AggregateType.Sum" Format="N2">
                                <FooterTemplate>
                                    @{ var sum = (context as AggregateTemplateContext); }
                                    <span><b>@sum?.Sum</b></span>
                                </FooterTemplate>
                            </GridAggregateColumn>
                            <GridAggregateColumn Field="Credit" Type="AggregateType.Sum" Format="N2">
                                <FooterTemplate>
                                    @{ var sum = (context as AggregateTemplateContext); }
                                    <span><b>@sum?.Sum</b></span>
                                </FooterTemplate>
                            </GridAggregateColumn>
                        </GridAggregateColumns>
                    </GridAggregate>
                </GridAggregates>
            </SfGrid>
        </div>
    </div>
}
else
{
    <div style="text-align:center;padding:60px;color:#888;">
        <span class="e-icons e-bank" style="font-size:48px;display:block;margin-bottom:16px;"></span>
        <p>Seleccione una cuenta bancaria, anio y mes, luego haga clic en "Cargar" para iniciar la conciliacion.</p>
    </div>
}

<!-- Import dialog (placeholder) -->
<SfDialog @bind-Visible="_showImportDialog" Header="Importar Extracto Bancario" Width="500px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <div style="padding:16px;text-align:center;color:#888;">
                <span class="e-icons e-upload" style="font-size:36px;display:block;margin-bottom:12px;"></span>
                <p>Funcionalidad de importacion de extracto bancario en desarrollo.</p>
                <p>Formatos soportados: CSV, OFX, MT940</p>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cerrar" CssClass="e-flat" OnClick="@(() => _showImportDialog = false)" />
    </DialogButtons>
</SfDialog>

@code {
    private SfGrid<ReconciliationItem>? _bookGrid;
    private bool _hasData;
    private bool _showImportDialog;

    // Filters
    private string _selectedAccount = "";
    private int _year = DateTime.Today.Year;
    private int _month = DateTime.Today.Month;

    // Data
    private List<BankAccountOption> _bankAccounts = [];
    private List<ReconciliationItem> _bookItems = [];
    private List<BankStatementItem> _bankItems = [];
    private ReconciliationSummary _summary = new();

    private List<MonthOption> _months =
    [
        new(1, "01 - Enero"), new(2, "02 - Febrero"), new(3, "03 - Marzo"),
        new(4, "04 - Abril"), new(5, "05 - Mayo"), new(6, "06 - Junio"),
        new(7, "07 - Julio"), new(8, "08 - Agosto"), new(9, "09 - Septiembre"),
        new(10, "10 - Octubre"), new(11, "11 - Noviembre"), new(12, "12 - Diciembre")
    ];

    protected override async Task OnInitializedAsync()
    {
        await LoadBankAccounts();
    }

    private async Task LoadBankAccounts()
    {
        try
        {
            var accounts = await Http.GetFromJsonAsync<List<BankAccountOption>>("/api/accounting/bank-accounts?pageSize=100");
            _bankAccounts = accounts ?? [];
            foreach (var a in _bankAccounts) a.Display = $"{a.Code} - {a.Name}";
        }
        catch { _bankAccounts = []; }
    }

    private async Task LoadReconciliation()
    {
        if (string.IsNullOrEmpty(_selectedAccount))
        {
            await Notification.ErrorAsync("Seleccione una cuenta bancaria");
            return;
        }

        try
        {
            var url = $"/api/accounting/bank-reconciliations?accountCode={_selectedAccount}&year={_year}&month={_month}";
            var data = await Http.GetFromJsonAsync<ReconciliationData>(url);

            if (data is not null)
            {
                _bookItems = data.BookEntries ?? [];
                _bankItems = data.BankStatements ?? [];
                _summary = data.Summary ?? new();
                _hasData = true;
            }
        }
        catch
        {
            _hasData = false;
            await Notification.ErrorAsync("Error al cargar conciliacion");
        }
    }

    private async Task OnReconcileToggle(ReconciliationItem item, bool isReconciled)
    {
        try
        {
            var res = await Http.PutAsJsonAsync(
                $"/api/accounting/bank-reconciliations/items/{item.PublicId}/reconcile",
                new { IsReconciled = isReconciled });

            if (res.IsSuccessStatusCode)
            {
                item.IsReconciled = isReconciled;
                RecalculateSummary();
            }
            else
            {
                item.IsReconciled = !isReconciled;
                await Notification.ErrorAsync("Error al actualizar estado");
            }
        }
        catch
        {
            item.IsReconciled = !isReconciled;
            await Notification.ErrorAsync("Error de conexion");
        }
    }

    private void RecalculateSummary()
    {
        var unreconciledDebits = _bookItems.Where(i => !i.IsReconciled).Sum(i => i.Debit);
        var unreconciledCredits = _bookItems.Where(i => !i.IsReconciled).Sum(i => i.Credit);
        _summary.PendingDebits = unreconciledDebits;
        _summary.PendingCredits = unreconciledCredits;
        _summary.Difference = _summary.BookBalance - _summary.BankBalance + unreconciledDebits - unreconciledCredits;
    }

    private async Task SaveReconciliation()
    {
        try
        {
            var payload = new
            {
                AccountCode = _selectedAccount,
                Year = _year,
                Month = _month,
                ReconciledItems = _bookItems.Where(i => i.IsReconciled).Select(i => i.PublicId).ToList()
            };
            var res = await Http.PostAsJsonAsync("/api/accounting/bank-reconciliations", payload);
            if (res.IsSuccessStatusCode)
                await Notification.SuccessAsync("Conciliacion guardada");
            else
                await Notification.ErrorAsync("Error al guardar conciliacion");
        }
        catch (Exception ex) { await Notification.ErrorAsync($"Error: {ex.Message}"); }
    }

    // Models
    private class BankAccountOption
    {
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
        public string Display { get; set; } = "";
    }

    private class ReconciliationData
    {
        public List<ReconciliationItem> BookEntries { get; set; } = [];
        public List<BankStatementItem> BankStatements { get; set; } = [];
        public ReconciliationSummary Summary { get; set; } = new();
    }

    private class ReconciliationItem
    {
        public Guid PublicId { get; set; }
        public DateTime TransactionDate { get; set; }
        public string DocumentRef { get; set; } = "";
        public string Description { get; set; } = "";
        public decimal Debit { get; set; }
        public decimal Credit { get; set; }
        public bool IsReconciled { get; set; }
    }

    private class BankStatementItem
    {
        public Guid PublicId { get; set; }
        public DateTime TransactionDate { get; set; }
        public string Reference { get; set; } = "";
        public string Description { get; set; } = "";
        public decimal Debit { get; set; }
        public decimal Credit { get; set; }
        public bool IsMatched { get; set; }
        public string StatusText => IsMatched ? "Cruzado" : "Pendiente";
    }

    private class ReconciliationSummary
    {
        public decimal BookBalance { get; set; }
        public decimal BankBalance { get; set; }
        public decimal PendingDebits { get; set; }
        public decimal PendingCredits { get; set; }
        public decimal Difference { get; set; }
    }

    private record MonthOption(int Value, string Name);
}
