@page "/contabilidad/categorias-riesgo"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification

<PageTitle>Categorias de Riesgo - IngenIA365ERP</PageTitle>

<div class="page-header">
    <h3>Categorias de Riesgo</h3>
    <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@OpenCreate">Nuevo</SfButton>
</div>

<SfGrid @ref="_grid" TValue="RiskCategoryItem" DataSource="@_items"
    AllowPaging="true" AllowSorting="true" AllowFiltering="true">
    <GridColumns>
        <GridColumn Field="AccountCode" HeaderText="Cuenta Contable" Width="180" />
        <GridColumn Field="PeriodCode" HeaderText="Codigo Periodo" Width="150" />
        <GridColumn Field="InitialBalance" HeaderText="Saldo Inicial" Width="160" Format="N2" TextAlign="TextAlign.Right" />
        <GridColumn Field="AverageBalance" HeaderText="Saldo Promedio" Width="160" Format="N2" TextAlign="TextAlign.Right" />
        <GridColumn HeaderText="Acciones" Width="150" TextAlign="TextAlign.Center">
            <Template>
                @{
                    var item = context as RiskCategoryItem;
                    <SfButton CssClass="e-flat e-small" IconCss="e-icons e-edit" OnClick="@(() => OpenEdit(item!))" />
                    <SfButton CssClass="e-flat e-small e-danger" IconCss="e-icons e-trash" OnClick="@(() => OpenDelete(item!))" />
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

<SfDialog @bind-Visible="_showDialog" Header="@_dialogTitle" Width="500px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <div style="padding:10px;display:flex;flex-direction:column;gap:16px;">
                <div>
                    <label>Cuenta Contable *</label>
                    <SfTextBox @bind-Value="_model.AccountCode" Placeholder="Codigo cuenta contable" />
                </div>
                <div>
                    <label>Codigo Periodo *</label>
                    <SfTextBox @bind-Value="_model.PeriodCode" Placeholder="Codigo del periodo" />
                </div>
                <div>
                    <label>Saldo Inicial</label>
                    <SfNumericTextBox TValue="decimal?" @bind-Value="_model.InitialBalance"
                        Placeholder="0.00" Decimals="2" Format="N2" />
                </div>
                <div>
                    <label>Saldo Promedio</label>
                    <SfNumericTextBox TValue="decimal?" @bind-Value="_model.AverageBalance"
                        Placeholder="0.00" Decimals="2" Format="N2" />
                </div>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _showDialog = false)" />
        <DialogButton Content="Guardar" IsPrimary="true" OnClick="@Save" />
    </DialogButtons>
</SfDialog>

<ConfirmDialog @bind-Visible="_showConfirm" OnConfirm="ConfirmDelete"
    Message="Esta seguro de eliminar este registro?" />

@code {
    private SfGrid<RiskCategoryItem>? _grid;
    private List<RiskCategoryItem> _items = [];
    private RiskCategoryModel _model = new();
    private Guid? _editId;
    private bool _showDialog, _showConfirm;
    private string _dialogTitle = "";
    private Guid _deleteId;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        try { _items = await Http.GetFromJsonAsync<List<RiskCategoryItem>>("/api/accounting/risk-categories?pageSize=500") ?? []; }
        catch { _items = []; }
    }

    private void OpenCreate() { _model = new(); _editId = null; _dialogTitle = "Nueva Categoria de Riesgo"; _showDialog = true; }

    private void OpenEdit(RiskCategoryItem item)
    {
        _model = new()
        {
            AccountCode = item.AccountCode,
            PeriodCode = item.PeriodCode,
            InitialBalance = item.InitialBalance,
            AverageBalance = item.AverageBalance
        };
        _editId = item.PublicId;
        _dialogTitle = "Editar Categoria de Riesgo";
        _showDialog = true;
    }

    private void OpenDelete(RiskCategoryItem item) { _deleteId = item.PublicId; _showConfirm = true; }

    private async Task Save()
    {
        HttpResponseMessage res;
        if (_editId.HasValue)
            res = await Http.PutAsJsonAsync($"/api/accounting/risk-categories/{_editId}", _model);
        else
            res = await Http.PostAsJsonAsync("/api/accounting/risk-categories", _model);

        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro guardado");
            _showDialog = false;
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al guardar");
    }

    private async Task ConfirmDelete()
    {
        var res = await Http.DeleteAsync($"/api/accounting/risk-categories/{_deleteId}");
        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro eliminado");
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al eliminar");
    }

    private class RiskCategoryItem
    {
        public Guid PublicId { get; set; }
        public string AccountCode { get; set; } = "";
        public string PeriodCode { get; set; } = "";
        public decimal? InitialBalance { get; set; }
        public decimal? AverageBalance { get; set; }
    }

    private class RiskCategoryModel
    {
        public string AccountCode { get; set; } = "";
        public string PeriodCode { get; set; } = "";
        public decimal? InitialBalance { get; set; }
        public decimal? AverageBalance { get; set; }
    }
}
