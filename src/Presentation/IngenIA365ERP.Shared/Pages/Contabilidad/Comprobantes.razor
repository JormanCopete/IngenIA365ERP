@page "/contabilidad/comprobantes"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using IngenIA365ERP.Shared.Services.Contabilidad
@using IngenIA365ERP.Shared.Services.Nomina
@inject ContabilidadClient Contabilidad
@inject INotificationService Notification
@inject NavigationManager Navigation

<PageTitle>Comprobantes - IngenIA365ERP</PageTitle>

@* Feature 009, US3 (FR-030, FR-035): todos los comprobantes —manuales y de módulo— con filtros de
   fecha, tipo, estado, origen y número; respeta el alcance de sucursal de quien consulta. *@
<PermissionGate Required="Accounting.Vouchers.View" MostrarAviso="true">
<div class="page-header">
    <h3>Comprobantes</h3>
    <div class="toolbar">
        <PermissionGate Required="Accounting.Vouchers.Create">
            <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@(() => Navigation.NavigateTo("/contabilidad/comprobantes/nuevo"))">Nuevo comprobante</SfButton>
        </PermissionGate>
    </div>
</div>

<div class="toolbar">
    <label class="campo">Desde <input class="e-input" type="date" value="@(_desde?.ToString("yyyy-MM-dd"))" @onchange="@(e => _desde = Fecha(e))" /></label>
    <label class="campo">Hasta <input class="e-input" type="date" value="@(_hasta?.ToString("yyyy-MM-dd"))" @onchange="@(e => _hasta = Fecha(e))" /></label>
    <label class="campo">Tipo
        <select class="e-input" @bind="_tipo">
            <option value="">Todos</option>
            @foreach (var t in _tipos) { <option value="@t.Code">@t.Code · @t.Name</option> }
        </select>
    </label>
    <label class="campo">Estado
        <select class="e-input" @bind="_estado">
            <option value="">Todos</option>
            <option value="Draft">Borrador</option>
            <option value="Posted">Contabilizado</option>
            <option value="Reversed">Reversado</option>
        </select>
    </label>
    <label class="campo">Origen
        <select class="e-input" @bind="_origen">
            <option value="">Todos</option>
            @foreach (var (codigo, nombre) in Modulos) { <option value="@codigo">@nombre</option> }
        </select>
    </label>
    <label class="campo">Número <input class="e-input" type="number" min="1" style="width:7rem" value="@_numero" @onchange="@(e => _numero = long.TryParse(e.Value?.ToString(), out var n) ? n : null)" /></label>
    <SfButton CssClass="e-outline" IconCss="e-icons e-search" OnClick="@(() => CargarAsync(1))">Buscar</SfButton>
</div>

<IndicadorDeCarga Cargando="@_carga.Activa">
    @if (_pagina is null)
    {
        <p class="texto-tenue">Elija los filtros y pulse «Buscar».</p>
    }
    else if (_pagina.Items.Count == 0)
    {
        <div class="info-card"><span class="label">Sin comprobantes</span><p>Ninguno coincide con los filtros (o ninguno tiene líneas en sus sucursales).</p></div>
    }
    else
    {
        <SfGrid TValue="ComprobanteResumenDto" DataSource="@_pagina.Items" AllowSorting="true" RowHeight="34">
            <GridEvents TValue="ComprobanteResumenDto" RowSelected="@(async (RowSelectEventArgs<ComprobanteResumenDto> e) => await Task.Run(() => Navigation.NavigateTo($"/contabilidad/comprobantes/{e.Data.PublicId}")))" />
            <GridColumns>
                <GridColumn HeaderText="Comprobante" Width="120">
                    <Template>@{ var d = (ComprobanteResumenDto)context; }<span>@d.VoucherTypeCode@(d.Number is { } n ? $"-{n}" : " (borrador)")</span></Template>
                </GridColumn>
                <GridColumn Field="Date" HeaderText="Fecha" Width="100" Format="yyyy-MM-dd" Type="ColumnType.Date" />
                <GridColumn Field="Description" HeaderText="Descripción" Width="300" />
                <GridColumn HeaderText="Origen" Width="110">
                    <Template>@{ var d = (ComprobanteResumenDto)context; }<span class="marca-origen @(d.OriginModule == "CNT" ? "marca-origen-manual" : "")">@Nombre(d.OriginModule)</span></Template>
                </GridColumn>
                <GridColumn HeaderText="Estado" Width="110">
                    <Template>@{ var d = (ComprobanteResumenDto)context; }<span>@Estado(d.Status)@(d.Kind == "Reversal" ? " · reversión" : "")</span></Template>
                </GridColumn>
                <GridColumn Field="TotalDebit" HeaderText="Débitos" Width="120" Format="N2" TextAlign="TextAlign.Right" />
                <GridColumn Field="TotalCredit" HeaderText="Créditos" Width="120" Format="N2" TextAlign="TextAlign.Right" />
                <GridColumn Field="RegisteredBy" HeaderText="Registró" Width="140" />
                <GridColumn Field="PostedBy" HeaderText="Contabilizó" Width="140" />
            </GridColumns>
        </SfGrid>
        <div class="toolbar">
            <span class="texto-tenue">@_pagina.TotalCount comprobantes · página @_pagina.PageNumber de @Math.Max(1, _pagina.TotalPages)</span>
            <SfButton CssClass="e-outline e-small" Disabled="@(_pagina.PageNumber <= 1)" OnClick="@(() => CargarAsync(_pagina.PageNumber - 1))">Anterior</SfButton>
            <SfButton CssClass="e-outline e-small" Disabled="@(_pagina.PageNumber >= _pagina.TotalPages)" OnClick="@(() => CargarAsync(_pagina.PageNumber + 1))">Siguiente</SfButton>
        </div>
    }
</IndicadorDeCarga>
</PermissionGate>

@code {
    private static readonly (string, string)[] Modulos = [("CNT", "Contabilidad"), ("NOM", "Nómina"), ("CAR", "Cartera"), ("INV", "Inventario"), ("TES", "Tesorería"), ("CDT", "CDT"), ("ACT", "Activos fijos")];

    private readonly EstadoDeCarga _carga = new();
    private List<TipoComprobanteDto> _tipos = [];
    private PaginaDto<ComprobanteResumenDto>? _pagina;
    private DateOnly? _desde = new(DateTime.Today.Year, DateTime.Today.Month, 1), _hasta = DateOnly.FromDateTime(DateTime.Today);
    private string _tipo = "", _estado = "", _origen = "";
    private long? _numero;

    protected override async Task OnInitializedAsync()
    {
        var t = await Contabilidad.ListarTiposDeComprobanteAsync(incluirInactivos: true);
        _tipos = t.IsSuccess ? [.. t.Value!] : [];
        await CargarAsync(1);
    }

    private async Task CargarAsync(int pagina)
    {
        using var carga = _carga.Iniciar();
        var r = await Contabilidad.ListarComprobantesAsync(new FiltroDeComprobantes(_desde, _hasta, Vacio(_tipo), Vacio(_estado), Vacio(_origen), _numero, pagina, 50));
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo consultar."); return; }
        _pagina = r.Value;
    }

    private static string? Vacio(string s) => string.IsNullOrWhiteSpace(s) ? null : s;
    private static DateOnly? Fecha(Microsoft.AspNetCore.Components.ChangeEventArgs e) => DateOnly.TryParse(e.Value?.ToString(), out var d) ? d : null;
    private static string Estado(string s) => s switch { "Draft" => "Borrador", "Posted" => "Contabilizado", "Reversed" => "Reversado", _ => s };
    private static string Nombre(string modulo) => Modulos.FirstOrDefault(m => m.Item1 == modulo).Item2 ?? modulo;
}
