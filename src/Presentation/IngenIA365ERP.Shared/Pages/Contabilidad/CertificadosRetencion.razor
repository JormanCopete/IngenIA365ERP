@page "/contabilidad/certificados-retencion"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification

<PageTitle>Certificados de Retencion - IngenIA365ERP</PageTitle>

<div class="pagina">
    <div class="page-header">
        <h3>Certificados de Retencion en la Fuente</h3>
    </div>

    <!-- Year Selector and Generate -->
    <div class="toolbar">
        <div>
            <label>Ano Gravable</label>
            <SfNumericTextBox TValue="int" @bind-Value="_year" Min="2000" Max="2099" Format="####" Width="120px" CssClass="e-small" />
        </div>
        <SfButton CssClass="e-primary" IconCss="e-icons e-play" OnClick="@(() => _showGenerateConfirm = true)">Generar Certificados</SfButton>
        <SfButton CssClass="e-info e-small" IconCss="e-icons e-reload" OnClick="LoadCertificates">Consultar</SfButton>
    </div>

    @if (_loading)
    {
        <SfProgressBar Type="ProgressType.Linear" IsIndeterminate="true" Height="4"
                       TrackColor="var(--borde)" ProgressColor="var(--acento)" />
    }

    @if (_genResult is not null)
    {
        <div class="aviso aviso-ok">
            <p>Se generaron <b>@_genResult.CertificatesGenerated</b> certificados para el ano @_genResult.Year.</p>
            <p>Total retencion: <b>@_genResult.TotalWithholding.ToString("N2")</b></p>
        </div>
    }

    <!-- Certificates Grid -->
    @if (_certificates is not null && _certificates.Count > 0)
    {
        <SfGrid TValue="TaxCertItem" DataSource="_certificates" AllowPaging="true" AllowSorting="true"
                AllowFiltering="true" AllowExcelExport="true" @ref="_grid">
            <GridPageSettings PageSize="20" />
            <GridColumns>
                <GridColumn Field="TaxId" HeaderText="Identificacion" Width="140" />
                <GridColumn Field="PersonName" HeaderText="Nombre" Width="300" />
                <GridColumn Field="TotalBase" HeaderText="Base Gravable" Width="160" Format="N2" TextAlign="TextAlign.Right" />
                <GridColumn Field="TotalWithholding" HeaderText="Retencion" Width="160" Format="N2" TextAlign="TextAlign.Right" />
                <GridColumn Field="Rate" HeaderText="Tarifa %" Width="100" Format="N2" TextAlign="TextAlign.Right" />
                <GridColumn Field="IssueDate" HeaderText="Fecha Expedicion" Width="140" Format="d" Type="ColumnType.Date" />
            </GridColumns>
            <GridAggregates>
                <GridAggregate>
                    <GridAggregateColumns>
                        <GridAggregateColumn Field="TotalBase" Type="AggregateType.Sum" Format="N2">
                            <FooterTemplate>@{ var s = context as AggregateTemplateContext; }<b>Total: @s?.Sum</b></FooterTemplate>
                        </GridAggregateColumn>
                        <GridAggregateColumn Field="TotalWithholding" Type="AggregateType.Sum" Format="N2">
                            <FooterTemplate>@{ var s = context as AggregateTemplateContext; }<b>Total: @s?.Sum</b></FooterTemplate>
                        </GridAggregateColumn>
                    </GridAggregateColumns>
                </GridAggregate>
            </GridAggregates>
        </SfGrid>
    }
    else if (!_loading && _certificates is not null)
    {
        <p class="texto-tenue">No se encontraron certificados para el ano @_year.</p>
    }

    <hr style="border-color:var(--borde);" />

    <!-- Individual Search -->
    <h4>Consulta Individual</h4>
    <div class="toolbar">
        <div style="flex:1;max-width:400px;">
            <label>Buscar Persona</label>
            <SfTextBox @bind-Value="_searchTerm" Placeholder="Nombre o identificacion..." CssClass="e-small" />
        </div>
        <SfButton CssClass="e-info e-small" IconCss="e-icons e-search" OnClick="SearchPerson">Buscar</SfButton>
    </div>

    @if (_searchResults is not null && _searchResults.Count > 0)
    {
        <SfGrid TValue="PersonItem" DataSource="_searchResults" AllowSelection="true">
            <GridSelectionSettings Type="Syncfusion.Blazor.Grids.SelectionType.Single" />
            <GridEvents RowSelected="OnPersonSelected" TValue="PersonItem" />
            <GridColumns>
                <GridColumn Field="TaxId" HeaderText="Identificacion" Width="140" />
                <GridColumn Field="FullName" HeaderText="Nombre" Width="300" />
            </GridColumns>
        </SfGrid>
    }

    @if (_individualCert is not null)
    {
        <div class="info-card">
            <h5>Certificado de @_individualCert.PersonName</h5>
            <div class="rejilla-tarjetas">
                <div class="info-card"><span class="label">NIT / CC</span><span>@_individualCert.TaxId</span></div>
                <div class="info-card"><span class="label">Ano</span><span>@_individualCert.Year</span></div>
                <div class="info-card"><span class="label">Base Gravable</span><span>@_individualCert.TotalBase.ToString("N2")</span></div>
                <div class="info-card"><span class="label">Retencion</span><span>@_individualCert.TotalWithholding.ToString("N2")</span></div>
                <div class="info-card"><span class="label">Tarifa</span><span>@_individualCert.Rate.ToString("N2")%</span></div>
                <div class="info-card"><span class="label">Expedido por</span><span>@_individualCert.PayerName</span></div>
            </div>
        </div>
    }

    <ConfirmDialog @bind-Visible="_showGenerateConfirm"
                   Title="Generar Certificados"
                   Message="@($"Esta seguro de generar los certificados de retencion para el ano {_year}? Se reemplazaran los existentes.")"
                   ConfirmText="Generar"
                   OnConfirm="GenerateCertificates" />
</div>

@code {
    private SfGrid<TaxCertItem>? _grid;
    private int _year = DateTime.Today.Year - 1;
    private bool _loading;
    private bool _showGenerateConfirm;
    private GenResult? _genResult;
    private List<TaxCertItem>? _certificates;
    private string _searchTerm = "";
    private List<PersonItem>? _searchResults;
    private TaxCertItem? _individualCert;

    private async Task LoadCertificates()
    {
        _loading = true;
        try
        {
            _certificates = await Http.GetListAsync<TaxCertItem>(
                $"/api/accounting/tax-certificates/{_year}");
        }
        catch
        {
            await Notification.ErrorAsync("Error al cargar certificados.");
        }
        _loading = false;
    }

    private async Task GenerateCertificates()
    {
        _loading = true;
        _genResult = null;
        try
        {
            var response = await Http.PostAsync($"/api/accounting/tax-certificates/generate/{_year}", null);
            if (response.IsSuccessStatusCode)
            {
                _genResult = await response.Content.ReadFromJsonAsync<GenResult>();
                await Notification.SuccessAsync("Certificados generados exitosamente.");
                await LoadCertificates();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                await Notification.ErrorAsync($"Error: {error}");
            }
        }
        catch
        {
            await Notification.ErrorAsync("Error de conexion.");
        }
        _loading = false;
    }

    private async Task SearchPerson()
    {
        if (string.IsNullOrWhiteSpace(_searchTerm)) return;
        try
        {
            _searchResults = await Http.GetListAsync<PersonItem>(
                $"/api/core/people?searchTerm={Uri.EscapeDataString(_searchTerm)}&pageSize=10");
        }
        catch
        {
            await Notification.ErrorAsync("Error al buscar persona.");
        }
    }

    private async Task OnPersonSelected(RowSelectEventArgs<PersonItem> args)
    {
        try
        {
            _individualCert = await Http.GetFromJsonAsync<TaxCertItem>(
                $"/api/accounting/tax-certificates/{args.Data.PublicId}/{_year}");
        }
        catch
        {
            await Notification.ErrorAsync("No se encontro certificado para esta persona.");
            _individualCert = null;
        }
    }

    private class TaxCertItem
    {
        public Guid PublicId { get; set; }
        public string PersonName { get; set; } = "";
        public string TaxId { get; set; } = "";
        public int Year { get; set; }
        public decimal TotalBase { get; set; }
        public decimal TotalWithholding { get; set; }
        public decimal Rate { get; set; }
        public DateTime IssueDate { get; set; }
        public string PayerName { get; set; } = "";
    }

    private class GenResult
    {
        public int CertificatesGenerated { get; set; }
        public int Year { get; set; }
        public decimal TotalWithholding { get; set; }
    }

    private class PersonItem
    {
        public Guid PublicId { get; set; }
        public string TaxId { get; set; } = "";
        public string FullName { get; set; } = "";
    }
}
