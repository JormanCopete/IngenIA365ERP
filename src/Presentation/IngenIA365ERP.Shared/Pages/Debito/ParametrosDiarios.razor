@page "/debito/parametros-diarios"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification

<PageTitle>Parametros Diarios - IngenIA365ERP</PageTitle>

<div class="page-header">
    <h3>Parametros Diarios</h3>
    <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@OpenCreate">Nuevo</SfButton>
</div>

<SfGrid @ref="_grid" TValue="DailyParameterItem" DataSource="@_items"
    AllowPaging="true" AllowSorting="true" AllowFiltering="true">
    <GridColumns>
        <GridColumn Field="ParameterCode" HeaderText="Codigo" Width="100" TextAlign="TextAlign.Right" />
        <GridColumn Field="BankId" HeaderText="Banco" Width="100" />
        <GridColumn Field="Description" HeaderText="Descripcion" Width="200" />
        <GridColumn Field="BatchVoucherCode" HeaderText="Cpte Batch" Width="110" />
        <GridColumn Field="OnlineVoucherCode" HeaderText="Cpte Linea" Width="110" />
        <GridColumn Field="NewCardsCount" HeaderText="Tarjetas Nuevas" Width="130" TextAlign="TextAlign.Right" />
        <GridColumn Field="NetworkCommission" HeaderText="Comision Red" Width="120" Format="N2" TextAlign="TextAlign.Right" />
        <GridColumn HeaderText="Acciones" Width="150" TextAlign="TextAlign.Center">
            <Template>
                @{
                    var item = context as DailyParameterItem;
                    <SfButton CssClass="e-flat e-small" IconCss="e-icons e-edit" OnClick="@(() => OpenEdit(item!))" />
                    <SfButton CssClass="e-flat e-small e-danger" IconCss="e-icons e-trash" OnClick="@(() => OpenDelete(item!))" />
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

<SfDialog @bind-Visible="_showDialog" Header="@_dialogTitle" Width="600px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <div style="padding:10px;display:flex;flex-direction:column;gap:16px;">
                <div>
                    <label>Codigo *</label>
                    <SfNumericTextBox TValue="int" @bind-Value="_model.ParameterCode" Placeholder="Codigo parametro" Min="0" />
                </div>
                <div>
                    <label>Banco *</label>
                    <SfTextBox @bind-Value="_model.BankId" Placeholder="Codigo banco" />
                </div>
                <div>
                    <label>Descripcion *</label>
                    <SfTextBox @bind-Value="_model.Description" Placeholder="Descripcion" />
                </div>
                <div>
                    <label>Comprobante Batch *</label>
                    <SfTextBox @bind-Value="_model.BatchVoucherCode" Placeholder="Codigo comprobante batch" />
                </div>
                <div>
                    <label>Comprobante Linea *</label>
                    <SfTextBox @bind-Value="_model.OnlineVoucherCode" Placeholder="Codigo comprobante en linea" />
                </div>
                <div>
                    <label>Comprobante Cierre</label>
                    <SfTextBox @bind-Value="_model.ClosingVoucherCode" Placeholder="Codigo comprobante cierre" />
                </div>
                <div>
                    <label>Comprobante Cierre Datafono</label>
                    <SfTextBox @bind-Value="_model.PosClosingVoucherCode" Placeholder="Codigo comprobante cierre datafono" />
                </div>
                <div>
                    <label>Comision de Red</label>
                    <SfNumericTextBox TValue="decimal" @bind-Value="_model.NetworkCommission" Placeholder="0.00" Decimals="2" Format="N2" Min="0" />
                </div>
                <div>
                    <label>Otra Comision de Red</label>
                    <SfNumericTextBox TValue="decimal" @bind-Value="_model.OtherNetworkCommission" Placeholder="0.00" Decimals="2" Format="N2" Min="0" />
                </div>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _showDialog = false)" />
        <DialogButton Content="Guardar" IsPrimary="true" OnClick="@Save" />
    </DialogButtons>
</SfDialog>

<ConfirmDialog @bind-Visible="_showConfirm" OnConfirm="ConfirmDelete"
    Message="Esta seguro de eliminar este registro?" />

@code {
    private SfGrid<DailyParameterItem>? _grid;
    private List<DailyParameterItem> _items = [];
    private DailyParameterModel _model = new();
    private Guid? _editId;
    private bool _showDialog, _showConfirm;
    private string _dialogTitle = "";
    private Guid _deleteId;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        try { _items = await Http.GetListAsync<DailyParameterItem>("/api/debit/daily-parameters?pageSize=500") ?? []; }
        catch { _items = []; }
    }

    private void OpenCreate() { _model = new(); _editId = null; _dialogTitle = "Nuevo Parametro Diario"; _showDialog = true; }

    private void OpenEdit(DailyParameterItem item)
    {
        _model = new()
        {
            ParameterCode = item.ParameterCode,
            BankId = item.BankId,
            Description = item.Description,
            BatchVoucherCode = item.BatchVoucherCode,
            OnlineVoucherCode = item.OnlineVoucherCode,
            ClosingVoucherCode = item.ClosingVoucherCode,
            PosClosingVoucherCode = item.PosClosingVoucherCode,
            NetworkCommission = item.NetworkCommission,
            OtherNetworkCommission = item.OtherNetworkCommission
        };
        _editId = item.PublicId;
        _dialogTitle = "Editar Parametro Diario";
        _showDialog = true;
    }

    private void OpenDelete(DailyParameterItem item) { _deleteId = item.PublicId; _showConfirm = true; }

    private async Task Save()
    {
        HttpResponseMessage res;
        if (_editId.HasValue)
            res = await Http.PutAsJsonAsync($"/api/debit/daily-parameters/{_editId}", _model);
        else
            res = await Http.PostAsJsonAsync("/api/debit/daily-parameters", _model);

        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro guardado");
            _showDialog = false;
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al guardar");
    }

    private async Task ConfirmDelete()
    {
        var res = await Http.DeleteAsync($"/api/debit/daily-parameters/{_deleteId}");
        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro eliminado");
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al eliminar");
    }

    private class DailyParameterItem
    {
        public Guid PublicId { get; set; }
        public int ParameterCode { get; set; }
        public string BankId { get; set; } = "";
        public string Description { get; set; } = "";
        public string BatchVoucherCode { get; set; } = "";
        public string OnlineVoucherCode { get; set; } = "";
        public string? ClosingVoucherCode { get; set; }
        public string? PosClosingVoucherCode { get; set; }
        public int NewCardsCount { get; set; }
        public decimal NetworkCommission { get; set; }
        public decimal OtherNetworkCommission { get; set; }
    }

    private class DailyParameterModel
    {
        public int ParameterCode { get; set; }
        public string BankId { get; set; } = "";
        public string Description { get; set; } = "";
        public string BatchVoucherCode { get; set; } = "";
        public string OnlineVoucherCode { get; set; } = "";
        public string? ClosingVoucherCode { get; set; }
        public string? PosClosingVoucherCode { get; set; }
        public decimal NetworkCommission { get; set; }
        public decimal OtherNetworkCommission { get; set; }
    }
}
