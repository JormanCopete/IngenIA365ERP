@page "/debito/parametros-convenio"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification

<PageTitle>Parametros de Convenio - IngenIA365ERP</PageTitle>

<div class="page-header">
    <h3>Parametros de Convenio</h3>
    <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@OpenCreate">Nuevo</SfButton>
</div>

<SfGrid @ref="_grid" TValue="AgreementParamItem" DataSource="@_items"
    AllowPaging="true" AllowSorting="true" AllowFiltering="true">
    <GridColumns>
        <GridColumn Field="AgreementCode" HeaderText="Codigo Convenio" Width="150" />
        <GridColumn Field="Name" HeaderText="Nombre" Width="300" />
        <GridColumn Field="TokenRS" HeaderText="Token RS" Width="120" TextAlign="TextAlign.Right" />
        <GridColumn HeaderText="Acciones" Width="150" TextAlign="TextAlign.Center">
            <Template>
                @{
                    var item = context as AgreementParamItem;
                    <SfButton CssClass="e-flat e-small" IconCss="e-icons e-edit" OnClick="@(() => OpenEdit(item!))" />
                    <SfButton CssClass="e-flat e-small e-danger" IconCss="e-icons e-trash" OnClick="@(() => OpenDelete(item!))" />
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

<SfDialog @bind-Visible="_showDialog" Header="@_dialogTitle" Width="450px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <div style="padding:10px;display:flex;flex-direction:column;gap:16px;">
                <div>
                    <label>Codigo Convenio *</label>
                    <SfTextBox @bind-Value="_model.AgreementCode" Placeholder="Codigo del convenio" />
                </div>
                <div>
                    <label>Nombre</label>
                    <SfTextBox @bind-Value="_model.Name" Placeholder="Nombre del convenio" />
                </div>
                <div>
                    <label>Token RS</label>
                    <SfNumericTextBox TValue="int" @bind-Value="_model.TokenRS" Placeholder="0" Min="0" />
                </div>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _showDialog = false)" />
        <DialogButton Content="Guardar" IsPrimary="true" OnClick="@Save" />
    </DialogButtons>
</SfDialog>

<ConfirmDialog @bind-Visible="_showConfirm" OnConfirm="ConfirmDelete"
    Message="Esta seguro de eliminar este registro?" />

@code {
    private SfGrid<AgreementParamItem>? _grid;
    private List<AgreementParamItem> _items = [];
    private AgreementParamModel _model = new();
    private Guid? _editId;
    private bool _showDialog, _showConfirm;
    private string _dialogTitle = "";
    private Guid _deleteId;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        try { _items = await Http.GetFromJsonAsync<List<AgreementParamItem>>("/api/debit/agreement-parameters?pageSize=500") ?? []; }
        catch { _items = []; }
    }

    private void OpenCreate() { _model = new(); _editId = null; _dialogTitle = "Nuevo Parametro de Convenio"; _showDialog = true; }

    private void OpenEdit(AgreementParamItem item)
    {
        _model = new() { AgreementCode = item.AgreementCode, Name = item.Name, TokenRS = item.TokenRS };
        _editId = item.PublicId;
        _dialogTitle = "Editar Parametro de Convenio";
        _showDialog = true;
    }

    private void OpenDelete(AgreementParamItem item) { _deleteId = item.PublicId; _showConfirm = true; }

    private async Task Save()
    {
        HttpResponseMessage res;
        if (_editId.HasValue)
            res = await Http.PutAsJsonAsync($"/api/debit/agreement-parameters/{_editId}", _model);
        else
            res = await Http.PostAsJsonAsync("/api/debit/agreement-parameters", _model);

        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro guardado");
            _showDialog = false;
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al guardar");
    }

    private async Task ConfirmDelete()
    {
        var res = await Http.DeleteAsync($"/api/debit/agreement-parameters/{_deleteId}");
        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro eliminado");
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al eliminar");
    }

    private class AgreementParamItem
    {
        public Guid PublicId { get; set; }
        public string AgreementCode { get; set; } = "";
        public string? Name { get; set; }
        public int TokenRS { get; set; }
    }

    private class AgreementParamModel
    {
        public string AgreementCode { get; set; } = "";
        public string? Name { get; set; }
        public int TokenRS { get; set; }
    }
}
