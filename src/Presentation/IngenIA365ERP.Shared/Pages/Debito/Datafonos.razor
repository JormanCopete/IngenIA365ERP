@page "/debito/datafonos"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject INotificationService Notification

<PageTitle>Datafonos - IngenIA365ERP</PageTitle>

<div class="page-header">
    <h3>Datafonos</h3>
    <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@OpenCreate">Nuevo</SfButton>
</div>

<SfGrid @ref="_grid" TValue="PosTerminalItem" DataSource="@_items"
    AllowPaging="true" AllowSorting="true" AllowFiltering="true">
    <GridColumns>
        <GridColumn Field="TerminalCode" HeaderText="Codigo Terminal" Width="150" />
        <GridColumn Field="InternalCode" HeaderText="Codigo Interno" Width="120" TextAlign="TextAlign.Right" />
        <GridColumn Field="VoucherCode" HeaderText="Comprobante" Width="120" />
        <GridColumn Field="MerchantName" HeaderText="Comercio" Width="200" />
        <GridColumn Field="Location" HeaderText="Ubicacion" Width="200" />
        <GridColumn Field="Status" HeaderText="Estado" Width="80" />
        <GridColumn HeaderText="Acciones" Width="150" TextAlign="TextAlign.Center">
            <Template>
                @{
                    var item = context as PosTerminalItem;
                    <SfButton CssClass="e-flat e-small" IconCss="e-icons e-edit" OnClick="@(() => OpenEdit(item!))" />
                    <SfButton CssClass="e-flat e-small e-danger" IconCss="e-icons e-trash" OnClick="@(() => OpenDelete(item!))" />
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

<SfDialog @bind-Visible="_showDialog" Header="@_dialogTitle" Width="500px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <div style="padding:10px;display:flex;flex-direction:column;gap:16px;">
                <div>
                    <label>Codigo Terminal *</label>
                    <SfTextBox @bind-Value="_model.TerminalCode" Placeholder="Codigo del terminal" />
                </div>
                <div>
                    <label>Codigo Interno *</label>
                    <SfNumericTextBox TValue="int" @bind-Value="_model.InternalCode" Placeholder="Codigo interno" Min="0" />
                </div>
                <div>
                    <label>Comprobante</label>
                    <SfTextBox @bind-Value="_model.VoucherCode" Placeholder="Codigo comprobante" />
                </div>
                <div>
                    <label>Nombre Comercio</label>
                    <SfTextBox @bind-Value="_model.MerchantName" Placeholder="Nombre del comercio" />
                </div>
                <div>
                    <label>Ubicacion</label>
                    <SfTextBox @bind-Value="_model.Location" Placeholder="Ubicacion del datafono" />
                </div>
                <div>
                    <label>Estado</label>
                    <SfTextBox @bind-Value="_model.Status" Placeholder="Estado" />
                </div>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _showDialog = false)" />
        <DialogButton Content="Guardar" IsPrimary="true" OnClick="@Save" />
    </DialogButtons>
</SfDialog>

<ConfirmDialog @bind-Visible="_showConfirm" OnConfirm="ConfirmDelete"
    Message="Esta seguro de eliminar este registro?" />

@code {
    private SfGrid<PosTerminalItem>? _grid;
    private List<PosTerminalItem> _items = [];
    private PosTerminalModel _model = new();
    private Guid? _editId;
    private bool _showDialog, _showConfirm;
    private string _dialogTitle = "";
    private Guid _deleteId;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        try { _items = await Http.GetFromJsonAsync<List<PosTerminalItem>>("/api/debit/pos-terminals?pageSize=500") ?? []; }
        catch { _items = []; }
    }

    private void OpenCreate() { _model = new(); _editId = null; _dialogTitle = "Nuevo Datafono"; _showDialog = true; }

    private void OpenEdit(PosTerminalItem item)
    {
        _model = new()
        {
            TerminalCode = item.TerminalCode,
            InternalCode = item.InternalCode,
            VoucherCode = item.VoucherCode,
            MerchantName = item.MerchantName,
            Location = item.Location,
            Status = item.Status
        };
        _editId = item.PublicId;
        _dialogTitle = "Editar Datafono";
        _showDialog = true;
    }

    private void OpenDelete(PosTerminalItem item) { _deleteId = item.PublicId; _showConfirm = true; }

    private async Task Save()
    {
        HttpResponseMessage res;
        if (_editId.HasValue)
            res = await Http.PutAsJsonAsync($"/api/debit/pos-terminals/{_editId}", _model);
        else
            res = await Http.PostAsJsonAsync("/api/debit/pos-terminals", _model);

        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro guardado");
            _showDialog = false;
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al guardar");
    }

    private async Task ConfirmDelete()
    {
        var res = await Http.DeleteAsync($"/api/debit/pos-terminals/{_deleteId}");
        if (res.IsSuccessStatusCode)
        {
            await Notification.SuccessAsync("Registro eliminado");
            await LoadData();
        }
        else
            await Notification.ShowErrorAsync(res, "Error al eliminar");
    }

    private class PosTerminalItem
    {
        public Guid PublicId { get; set; }
        public string TerminalCode { get; set; } = "";
        public int InternalCode { get; set; }
        public string? VoucherCode { get; set; }
        public string? MerchantName { get; set; }
        public string? Location { get; set; }
        public string? Status { get; set; }
    }

    private class PosTerminalModel
    {
        public string TerminalCode { get; set; } = "";
        public int InternalCode { get; set; }
        public string? VoucherCode { get; set; }
        public string? MerchantName { get; set; }
        public string? Location { get; set; }
        public string? Status { get; set; }
    }
}
