@page "/ventas/documentos-electronicos"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using IngenIA365ERP.Shared.Services.Adjuntos
@using IngenIA365ERP.Shared.Services.FacturacionElectronica
@using IngenIA365ERP.Shared.Services.Http
@using IngenIA365ERP.Shared.Services.Inventario
@using IngenIA365ERP.Shared.Services.Nomina
@using IngenIA365ERP.Shared.Services.Ventas
@using static IngenIA365ERP.Shared.Services.FacturacionElectronica.TextosDeFacturacionElectronica
@inject FacturacionElectronicaClient Facturacion
@inject AdjuntosClient Adjuntos
@inject VentasClient Ventas
@inject IImpresionDeDocumentos Impresion
@inject DescargaDeArchivos Descargas
@inject INotificationService Notification
@inject NavigationManager Nav

<PageTitle>Documentos electrónicos - IngenIA365ERP</PageTitle>

@* Feature 012, I4 (T755; FR-063, FR-066, FR-068; contracts/api.md §24.4, §24.5; contracts/dian.md §5, §6, §8): la bandeja de documentos
   electrónicos —facturas, notas, documentos equivalentes POS y documentos soporte— con filtros por estado, tipo, contingencia y los que
   llevan demasiado sin validar. El detalle muestra las versiones (con sus artefactos, que se bajan por un enlace firmado de 60 s), las
   transmisiones con los mensajes traducidos y las correcciones. Acciones según el estado: «Reintentar ahora», «Consultar a la DIAN», el
   caso a (corregir la copia fiscal sin cambio económico), el caso b («Preparar reemplazo» y reemplazar con el mismo número) y el caso c
   (anular sin reemplazo) —b y c sólo con el rechazo confirmado por una consulta— y «Transmitir por el canal vigente». Lo decide siempre
   el servidor; la pantalla sólo evita ofrecer lo que no procede (AccionesDelDocumentoElectronico).
   2026-11-24 (pedido del dueño): los filtros en un panel (PanelDeFiltros): a la vista número, cliente (identificación o nombre, tal como
   salió en el documento), fechas, estado y tipo; en «Más filtros» prefijo, valor desde y hasta, contingencia, demorados, en reintento y
   muertos.
   2026-11-25 (pedido del dueño): el número abre el detalle en una ventana —con la venta completa: líneas, impuestos, retenciones y pagos— en
   lugar de pintarlo al final de la página; desde la ventana se imprime una copia, se baja el PDF y se envía por correo al comprador o a otra
   dirección (POST …/send-email). *@
<PermissionGate Required="ElectronicInvoicing.Documents.View" MostrarAviso="true">
<div class="pagina">
    <div class="page-header">
        <h3>Documentos electrónicos</h3>
        <div class="toolbar">
            <SfButton CssClass="e-outline" IconCss="e-icons e-refresh" Disabled="@_carga.Activa" OnClick="@CargarAsync">Actualizar</SfButton>
            <a class="e-btn e-flat" href="/ventas/contingencias-dian">Contingencias</a>
            <a class="e-btn e-flat" href="/inventario/informes?vista=dian-documents">Informe</a>
            <a class="e-btn e-flat" href="/manual/facturacion-electronica">Ayuda</a>
        </div>
    </div>

    <PanelDeFiltros HayFiltros="@HayFiltros" ActivosOcultos="@ActivosOcultos" Limpiar="@LimpiarAsync">
        <Principales>
            <label class="campo">Número <input class="e-input" @bind="_numero" @bind:after="BuscarAsync" maxlength="20" data-ayuda="El número o una parte, con o sin el prefijo." /></label>
            <label class="campo">Cliente
                <input class="e-input" @bind="_cliente" @bind:after="BuscarAsync" maxlength="80" placeholder="Identificación o nombre" />
            </label>
            <label class="campo">Desde <input type="date" class="e-input" value="@(_desde?.ToString("yyyy-MM-dd"))" @onchange="@(e => { _desde = LeerFecha(e.Value); return BuscarAsync(); })" /></label>
            <label class="campo">Hasta <input type="date" class="e-input" value="@(_hasta?.ToString("yyyy-MM-dd"))" @onchange="@(e => { _hasta = LeerFecha(e.Value); return BuscarAsync(); })" /></label>
            <label class="campo">Estado
                <select class="e-input" value="@(_estado?.ToString() ?? "")" @onchange="@(e => { _estado = int.TryParse(e.Value?.ToString(), out var s) ? s : null; return BuscarAsync(); })">
                    <option value="">Todos</option>
                    @foreach (var (v, t) in Estados) { <option value="@v">@t</option> }
                </select>
            </label>
            <label class="campo">Tipo
                <select class="e-input" value="@(_tipo?.ToString() ?? "")" @onchange="@(e => { _tipo = int.TryParse(e.Value?.ToString(), out var k) ? k : null; return BuscarAsync(); })">
                    <option value="">Todos</option>
                    @foreach (var (v, t) in TiposDeDocumento.Where(p => p.Key <= 7)) { <option value="@v">@t</option> }
                </select>
            </label>
        </Principales>
        <MasFiltros>
            <label class="campo">Prefijo <input class="e-input" @bind="_prefijo" @bind:after="BuscarAsync" maxlength="10" placeholder="Todos" /></label>
            <label class="campo">Valor desde <input class="e-input" type="number" min="0" step="any" @bind="_valorDesde" @bind:after="BuscarAsync" /></label>
            <label class="campo">Valor hasta <input class="e-input" type="number" min="0" step="any" @bind="_valorHasta" @bind:after="BuscarAsync" /></label>
            <label class="campo-check"><input type="checkbox" @bind="_contingencia" @bind:after="BuscarAsync" /> En contingencia</label>
            <label class="campo-check" title="Pendientes o enviados que llevan más del tiempo de alerta sin validar."><input type="checkbox" @bind="_vencidos" @bind:after="BuscarAsync" /> Demorados sin validar</label>
            <label class="campo-check"><input type="checkbox" @bind="_reintentando" @bind:after="BuscarAsync" /> En reintento</label>
            <label class="campo-check"><input type="checkbox" @bind="_muertos" @bind:after="BuscarAsync" /> Muertos</label>
        </MasFiltros>
    </PanelDeFiltros>

    <IndicadorDeCarga Cargando="@_carga.Activa">
        @if (!_carga.Activa && _filas.Count == 0)
        {
            <p class="texto-tenue">No hay documentos electrónicos con estos filtros en su alcance.</p>
        }
        <div class="tabla-desplazable">
            <table class="data-grid">
                <thead>
                    <tr><th>Número</th><th>Tipo</th><th>Expedido</th><th>Contraparte</th><th class="numero">Total</th><th>Estado</th><th>Contingencia</th>
                        <th class="numero">Intentos</th><th>Próximo intento</th><th>Plazo</th><th>Canal</th><th>Último mensaje</th></tr>
                </thead>
                <tbody>
                    @foreach (var d in _filas)
                    {
                        <tr class="@(d.ElectronicDocumentPublicId == _detalle?.Document.ElectronicDocumentPublicId ? "fila-elegida" : "")">
                            <td><a href="@($"/ventas/documentos-electronicos?documento={d.ElectronicDocumentPublicId}")" @onclick="@(() => AbrirAsync(d.ElectronicDocumentPublicId))" @onclick:preventDefault>@d.Number</a></td>
                            <td>@TipoDeDocumento(d.Kind)</td>
                            <td>@d.IssuedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@d.CounterpartyName</td>
                            <td class="numero">@d.Total.ToString("N0")</td>
                            <td><span class="aviso @ClaseDeEstado(d.Status)">@Estado(d.Status)</span>@if (EstadoVisible(d) is { } visible) { <br /><small class="texto-tenue">@visible</small> }</td>
                            <td>@TipoDeContingencia(d.ContingencyType)</td>
                            <td class="numero">@d.AttemptCount@(d.DeadAttemptLimit is { } tope ? $" (tope {tope})" : d.TransientFailures > 0 ? $" ({d.TransientFailures} seguidos)" : "")</td>
                            <td>@d.NextAttemptAt?.ToLocalTime().ToString("dd/MM HH:mm")</td>
                            <td>@d.TransmissionDeadline?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@d.ChannelCode</td>
                            <td>@d.LastMessage</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="toolbar">
            <SfButton CssClass="e-flat" Disabled="@(_pagina <= 1 || _carga.Activa)" OnClick="@(() => PaginaAsync(-1))">Anterior</SfButton>
            <span class="texto-tenue">Página @_pagina · @_total documento(s)</span>
            <SfButton CssClass="e-flat" Disabled="@(_pagina * TamanoDePagina >= _total || _carga.Activa)" OnClick="@(() => PaginaAsync(1))">Siguiente</SfButton>
        </div>
    </IndicadorDeCarga>
</div>

@* 2026-11-25 (pedido del dueño): el detalle se abre en una ventana, no al final de la página: el resumen ante la DIAN, la venta completa (líneas,
   impuestos, retenciones y pagos), las versiones con sus archivos y las transmisiones; las acciones según el estado arriba, y en el pie
   «Imprimir» (tirilla o carta, como copia), el PDF de la representación y «Enviar por correo» al comprador o a otra dirección. *@
<SfDialog @bind-Visible="_verDetalle" Header="@TituloDelDetalle" Width="1100px" IsModal="true" ShowCloseIcon="true" CloseOnEscape="true"
          CssClass="dialogo-de-detalle" AllowDragging="true">
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@(_cargaDetalle.Activa || _accion.Activa)" Texto="@(_accion.Activa ? "Procesando…" : "Cargando el documento…")">
                @if (_detalle is { } det)
                {
                    var d = det.Document;
                    <div class="toolbar">
                        <span class="aviso @ClaseDeEstado(d.Status)">@Estado(d.Status)</span>
                        @if (EstadoVisible(d) is { } visible) { <span class="texto-tenue">@visible</span> }
                        <PermissionGate Required="ElectronicInvoicing.Documents.Transmit">
                            @if (AccionesDelDocumentoElectronico.PuedeReintentar(d.Status)) { <SfButton CssClass="e-primary" Disabled="@_accion.Activa" OnClick="@ReintentarAsync">Reintentar ahora</SfButton> }
                            @if (AccionesDelDocumentoElectronico.PuedeConsultar(d.Status)) { <SfButton CssClass="e-outline" Disabled="@_accion.Activa" OnClick="@ConsultarAsync">Consultar a la DIAN</SfButton> }
                        </PermissionGate>
                        <PermissionGate Required="ElectronicInvoicing.Documents.Correct">
                            @if (AccionesDelDocumentoElectronico.PuedeCorregirCasoA(d.Status)) { <SfButton CssClass="e-outline" Disabled="@_accion.Activa" OnClick="@AbrirCasoA">Corregir la copia fiscal (caso a)</SfButton> }
                            @if (AccionesDelDocumentoElectronico.PuedeReemplazarOCancelar(d.Status, det.RechazoConfirmado))
                            {
                                <SfButton CssClass="e-outline" Disabled="@_accion.Activa" OnClick="@PrepararReemplazoAsync">Preparar reemplazo</SfButton>
                                <SfButton CssClass="e-outline" Disabled="@_accion.Activa" OnClick="@AbrirCasoB">Reemplazar (caso b)</SfButton>
                                <SfButton CssClass="e-outline" Disabled="@_accion.Activa" OnClick="@(() => AbrirMotivo(Accion.CasoC))">Anular sin reemplazo (caso c)</SfButton>
                            }
                        </PermissionGate>
                        <PermissionGate Required="ElectronicInvoicing.Documents.TransmitByCurrentChannel">
                            @if (AccionesDelDocumentoElectronico.PuedeTransmitirPorElCanalVigente(d.Status)) { <SfButton CssClass="e-flat" Disabled="@_accion.Activa" OnClick="@(() => AbrirMotivo(Accion.CanalVigente))">Transmitir por el canal vigente</SfButton> }
                        </PermissionGate>
                    </div>
                    @if (d.Status == EstadoRechazado && !det.RechazoConfirmado)
                    {
                        <p class="aviso aviso-info">El rechazo todavía no está confirmado: «Consultar a la DIAN» lo confirma y habilita el reemplazo o la anulación (casos b y c).</p>
                    }
                    @if (det.Cancellation is { } anulacion)
                    {
                        <p class="aviso aviso-info">Anulado sin reemplazo@(anulacion.ByName is { } quien ? $" por {quien}" : "")@(anulacion.At is { } cuando ? $" el {cuando.ToLocalTime():dd/MM/yyyy HH:mm}" : ""): @anulacion.Reason</p>
                    }
                    @if (_camposEconomicos.Count > 0)
                    {
                        <div class="aviso aviso-alerta">La corrección cambia datos económicos (@string.Join(", ", _camposEconomicos)): no es un caso a. Corrija por el caso b («Preparar reemplazo»).</div>
                    }

                    <dl class="caja-resumen">
                        <div><dt>Cliente</dt><dd>@(_venta?.Counterparty is { } comprador ? $"{comprador.Name}{(comprador.IdNumber is { } nit ? $" · {comprador.IdType} {nit}" : "")}" : d.CounterpartyName ?? "—")</dd></div>
                        <div><dt>Expedido</dt><dd>@d.IssuedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd></div>
                        <div><dt>Total</dt><dd>@d.Total.ToString("N0")</dd></div>
                        <div><dt>Canal · ambiente</dt><dd>@d.ChannelCode · @Ambiente(d.Environment)</dd></div>
                        <div><dt>Resolución</dt><dd>@(det.Resolution is { } res ? $"{res.Number} ({res.Prefix})" : "—")</dd></div>
                        <div><dt>Validado</dt><dd>@(det.ValidatedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</dd></div>
                        <div><dt>Entregado</dt><dd>@(det.DeliveredAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</dd></div>
                        <div><dt>Correo</dt><dd>@(det.EmailSentAt is { } enviado ? $"enviado {enviado.ToLocalTime():dd/MM/yyyy HH:mm}" : "sin enviar")@(det.EmailDeliveryBy == CorreoPorElCanal ? " · lo entrega el canal" : "")</dd></div>
                        @if (_venta is { } v)
                        {
                            <div><dt>Sucursal / punto</dt><dd>@v.Branch.Name@(v.PointOfSale is { } punto ? $" · {punto.Name}" : "")@(v.CashRegister is { } caja ? $" · caja {caja.Code}" : "")</dd></div>
                            <div><dt>Vendedor</dt><dd>@(v.Salesperson?.Name ?? "—")</dd></div>
                            <div><dt>Registró</dt><dd>@v.CreatedBy.Name@(v.ConfirmedBy is { } cb && cb.Name != v.CreatedBy.Name ? $" · confirmó {cb.Name}" : "")</dd></div>
                        }
                        @if (d.RejectedBy is { } rechazo) { <div><dt>Rechazado por</dt><dd>@Rechazador(rechazo)</dd></div> }
                        @if (det.Contingency is { } cont)
                        {
                            <div><dt>Contingencia</dt><dd><a href="/ventas/contingencias-dian">@TipoDeContingencia(cont.Type)</a> desde @cont.StartedAt.ToLocalTime().ToString("dd/MM HH:mm")@(cont.DeadlineAt is { } pl ? $" · plazo {pl.ToLocalTime():dd/MM/yyyy HH:mm}" : "")</dd></div>
                        }
                        <div><dt>Documento del ERP</dt><dd>@if (AccionesDelDocumentoElectronico.PantallaDelOrigen(d.Source.Route) is { } origen) { <a href="@origen">Abrir</a> } else { <span>—</span> }</dd></div>
                    </dl>
                    <p class="texto-partido"><span class="texto-tenue">@CodigoUnico(d.UniqueCodeKind):</span> @(d.UniqueCode ?? "pendiente de validación de la DIAN")</p>
                    @if (det.CorrectsDocument is { } corrige)
                    {
                        <p>Corrige a <a href="@($"/ventas/documentos-electronicos?documento={corrige.ElectronicDocumentPublicId}")" @onclick="@(() => AbrirAsync(corrige.ElectronicDocumentPublicId))" @onclick:preventDefault>@corrige.Number</a></p>
                    }
                    @if (det.CorrectedBy.Count > 0)
                    {
                        <p>Corregido por:
                            @foreach (var cor in det.CorrectedBy)
                            {
                                <a href="@($"/ventas/documentos-electronicos?documento={cor.ElectronicDocumentPublicId}")" @onclick="@(() => AbrirAsync(cor.ElectronicDocumentPublicId))" @onclick:preventDefault>@TipoDeDocumento(cor.Kind) @cor.Number (@Estado(cor.Status))</a><span> </span>
                            }
                        </p>
                    }

                    @if (_venta is { } venta)
                    {
                        <div class="kpi-grid kpi-compacto">
                            <div class="kpi-card"><span class="kpi-value">@venta.Totals.Subtotal.ToString("N0")</span><span class="kpi-label">Subtotal</span></div>
                            <div class="kpi-card"><span class="kpi-value">@venta.Totals.DiscountTotal.ToString("N0")</span><span class="kpi-label">Descuentos</span></div>
                            <div class="kpi-card"><span class="kpi-value">@venta.Totals.TaxTotal.ToString("N0")</span><span class="kpi-label">Impuestos</span></div>
                            <div class="kpi-card"><span class="kpi-value">@venta.Totals.WithholdingTotal.ToString("N0")</span><span class="kpi-label">Retenciones</span></div>
                            <div class="kpi-card"><span class="kpi-value">@venta.Totals.Total.ToString("N0")</span><span class="kpi-label">Total</span></div>
                            <div class="kpi-card"><span class="kpi-value">@venta.Totals.AmountDue.ToString("N0")</span><span class="kpi-label">A pagar</span></div>
                        </div>

                        <h5>Productos y servicios</h5>
                        <div class="tabla-desplazable">
                            <table class="data-grid">
                                <thead><tr><th>#</th><th>Producto</th><th>Unidad</th><th class="numero">Cantidad</th><th class="numero">Precio</th><th>Descuentos</th><th>Impuestos</th><th class="numero">Total</th></tr></thead>
                                <tbody>
                                    @foreach (var l in venta.Lines.OrderBy(x => x.LineNumber))
                                    {
                                        <tr>
                                            <td>@l.LineNumber</td>
                                            <td>@l.Product.Code · @l.Product.Name@(l.ItemReference is { } referencia ? $" · {referencia}" : "")</td>
                                            <td>@l.Unit.Code</td>
                                            <td class="numero">@l.Quantity.ToString("0.####")</td>
                                            <td class="numero">@l.UnitPrice.ToString("N0")</td>
                                            <td>@string.Join("; ", l.Discounts.Select(x => $"{(x.Percent is { } pct ? $"{pct * 100m:0.##} % " : "")}{x.Amount:N0}"))</td>
                                            <td>@string.Join("; ", l.Taxes.Select(x => $"{x.TaxRateCode} {x.Amount:N0}"))</td>
                                            <td class="numero">@l.Total.ToString("N0")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr><td colspan="7">Total</td><td class="numero">@venta.Totals.Total.ToString("N0")</td></tr>
                                </tfoot>
                            </table>
                        </div>
                        @if (venta.Withholdings.Count > 0)
                        {
                            <p class="texto-tenue">Retenciones: @string.Join(" · ", venta.Withholdings.Select(r => $"{r.TaxRateCode} sobre {r.Base:N0} = {r.Amount:N0}"))</p>
                        }

                        <h5>Pagos</h5>
                        @if (venta.Payments.Count == 0)
                        {
                            <p class="texto-tenue">Sin pagos.</p>
                        }
                        else
                        {
                            <div class="tabla-desplazable">
                                <table class="data-grid">
                                    <thead><tr><th>Medio</th><th class="numero">Valor</th><th class="numero">Entregado / vueltas</th><th>Referencia</th><th>Tarjeta</th></tr></thead>
                                    <tbody>
                                        @foreach (var p in venta.Payments.OrderBy(x => x.LineNumber))
                                        {
                                            <tr>
                                                <td>@p.MeansCode · @TextosDeVentas.ClaseDeMedio(p.MeansClass)</td>
                                                <td class="numero">@p.Amount.ToString("N0")</td>
                                                <td class="numero">@p.Tendered?.ToString("N0")@(p.Change > 0m ? $" / {p.Change:N0}" : "")</td>
                                                <td>@p.Reference @p.AuthorizationCode</td>
                                                <td>@(p.Last4 is { } ultimos ? $"{p.NetworkCode} ****{ultimos}" : "")@(p.BatchNumber is { } lote ? $" lote {lote}" : "")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                    else if (_avisoDeVenta is { } aviso)
                    {
                        <p class="texto-tenue">@aviso</p>
                    }

                    <h5>Versiones y archivos</h5>
                    <div class="tabla-desplazable">
                        <table class="data-grid">
                            <thead><tr><th>#</th><th>Motivo</th><th>Creada</th><th>Huella</th><th>Archivos</th><th>Cambio de la copia fiscal</th></tr></thead>
                            <tbody>
                                @foreach (var ver in det.Versions.OrderBy(x => x.VersionNumber))
                                {
                                    <tr>
                                        <td>@ver.VersionNumber</td>
                                        <td>@MotivoDeVersion(ver.Reason)</td>
                                        <td>@ver.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="texto-tenue">@ver.CanonicalSha256[..Math.Min(12, ver.CanonicalSha256.Length)]…</td>
                                        <td>
                                            @foreach (var a in ver.Artifacts)
                                            {
                                                <SfButton CssClass="e-flat" IconCss="e-icons e-download" Disabled="@_accion.Activa" OnClick="@(() => DescargarAsync(ver.VersionNumber, a))">@Artefacto(a.Artifact)</SfButton>
                                            }
                                        </td>
                                        <td class="texto-tenue">@(ver.PartySnapshotChange?.ToString())</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <h5>Transmisiones</h5>
                    @if (det.Transmissions.Count == 0)
                    {
                        <p class="texto-tenue">Todavía no hay intentos ante el canal.</p>
                    }
                    else
                    {
                        <div class="tabla-desplazable">
                            <table class="data-grid">
                                <thead><tr><th>#</th><th>Operación</th><th>Cuándo</th><th>Quién</th><th class="numero">Duración (ms)</th><th>Resultado</th><th>Códigos</th><th>Mensajes</th></tr></thead>
                                <tbody>
                                    @foreach (var t in det.Transmissions.OrderBy(x => x.AttemptNumber))
                                    {
                                        <tr>
                                            <td>@t.AttemptNumber</td>
                                            <td>@Operacion(t.Operation) · @t.ChannelCode</td>
                                            <td>@t.RequestedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                                            <td>@Actor(t.RequestedBy.Kind): @t.RequestedBy.Name</td>
                                            <td class="numero">@t.DurationMs</td>
                                            <td>@Resultado(t.Outcome)</td>
                                            <td>@t.ProviderCode @t.DianStatusCode</td>
                                            <td>@if (t.Messages.Count > 0) { <ul>@foreach (var m in t.Messages) { <li>@m.Rule: @(m.Translation ?? m.Text)</li> }</ul> }</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </IndicadorDeCarga>
        </Content>
        <FooterTemplate>
            @if (_detalle is { } pie)
            {
                var documento = pie.Document;
                @if (_pie == Pie.Correo)
                {
                    <div class="toolbar dialogo-de-cobro-pie">
                        <label class="campo">Correo
                            <input class="e-input" type="email" @bind="_correo" maxlength="200" placeholder="Vacío: el de recepción del documento"
                                   data-ayuda="Se envía el PDF y el XML del documento en un ZIP. Vacío: al correo de recepción que quedó en la copia fiscal." />
                        </label>
                        <SfButton CssClass="e-primary" IconCss="e-icons e-send" Disabled="@_accion.Activa" OnClick="@EnviarPorCorreoAsync">Enviar</SfButton>
                        <SfButton CssClass="e-outline" Disabled="@_accion.Activa" OnClick="@(() => _pie = Pie.Botones)">Cancelar</SfButton>
                    </div>
                }
                else if (_pie == Pie.Imprimir)
                {
                    <div class="toolbar dialogo-de-cobro-pie">
                        <label class="campo">Formato
                            <select class="e-input" value="@_formato" @onchange="@(e => _formato = int.TryParse(e.Value?.ToString(), out var f) ? f : 80)">
                                @foreach (var (valor, texto) in TextosDeVentas.FormatosDeImpresion) { <option value="@valor">@texto</option> }
                            </select>
                        </label>
                        <label class="campo">Motivo de la copia <input class="e-input" @bind="_motivoDeCopia" maxlength="250" placeholder="Opcional" /></label>
                        <SfButton CssClass="e-primary" IconCss="e-icons e-print" Disabled="@_accion.Activa" OnClick="@ImprimirAsync">Imprimir</SfButton>
                        <SfButton CssClass="e-outline" Disabled="@_accion.Activa" OnClick="@(() => _pie = Pie.Botones)">Cancelar</SfButton>
                    </div>
                }
                else
                {
                    <div class="toolbar dialogo-de-cobro-pie">
                        @if (EsDelInventario(documento))
                        {
                            <PermissionGate Required="Inventory.Documents.Reprint">
                                <SfButton CssClass="e-outline" IconCss="e-icons e-print" Disabled="@_accion.Activa" OnClick="@AbrirImpresion">Imprimir</SfButton>
                            </PermissionGate>
                        }
                        @if (PdfVigente(pie) is { } pdf)
                        {
                            <SfButton CssClass="e-outline" IconCss="e-icons e-download" Disabled="@_accion.Activa" OnClick="@(() => DescargarAsync(pdf.Version, pdf.Artefacto))">PDF</SfButton>
                        }
                        @if (AccionesDelDocumentoElectronico.Entregable(documento.Status))
                        {
                            <SfButton CssClass="e-outline" IconCss="e-icons e-send" Disabled="@_accion.Activa" OnClick="@AbrirCorreo">Enviar por correo</SfButton>
                        }
                        <SfButton CssClass="e-primary" OnClick="@(() => _verDetalle = false)">Cerrar</SfButton>
                    </div>
                }
            }
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<SfDialog @bind-Visible="_mostrarCasoA" Header="Corregir la copia fiscal (caso a)" Width="640px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@_accion.Activa" Texto="Corrigiendo…">
                <p class="texto-apoyo">Se vuelve a armar el documento con los datos de la contraparte tal como están hoy en el maestro y lo que cambie aquí. Si
                    cambia algo económico (identificación, líneas, impuestos o totales) no es un caso a. Deje en blanco lo que no cambia.</p>
                <div class="form-grid">
                    <label class="campo campo-ancho">Nombre <input class="e-input" @bind="_casoA.Nombre" maxlength="200" /></label>
                    <label class="campo campo-ancho">Dirección <input class="e-input" @bind="_casoA.Direccion" maxlength="150" /></label>
                    <label class="campo">Ciudad (DIVIPOLA) <input class="e-input" @bind="_casoA.Ciudad" maxlength="5" /></label>
                    <label class="campo">Correo <input class="e-input" type="email" @bind="_casoA.Correo" maxlength="150" /></label>
                    <label class="campo">Teléfono <input class="e-input" @bind="_casoA.Telefono" maxlength="30" /></label>
                    <label class="campo campo-ancho">Responsabilidades (separadas por coma) <input class="e-input" @bind="_casoA.Responsabilidades" maxlength="200" /></label>
                    <label class="campo campo-ancho">Motivo * <input class="e-input" @bind="_casoA.Motivo" maxlength="500" /></label>
                </div>
                <div class="toolbar">
                    <SfButton CssClass="e-primary" Disabled="@(_accion.Activa || string.IsNullOrWhiteSpace(_casoA.Motivo))" OnClick="@CorregirCasoAAsync">Corregir y volver a transmitir</SfButton>
                    <SfButton CssClass="e-outline" OnClick="@(() => _mostrarCasoA = false)">Cancelar</SfButton>
                </div>
            </IndicadorDeCarga>
        </Content>
    </DialogTemplates>
</SfDialog>

<SfDialog @bind-Visible="_mostrarCasoB" Header="Reemplazar con el mismo número (caso b)" Width="560px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@_accion.Activa" Texto="Reemplazando…">
                @if (_borrador is { } b)
                {
                    <p class="texto-apoyo">Se anula el documento rechazado sin efecto fiscal y se confirma el borrador de reemplazo con el mismo número, en una sola operación.
                        @if (AccionesDelDocumentoElectronico.PantallaDelBorrador(b.EditRoute) is { } pantalla) { <a href="@pantalla">Revisar el borrador</a> }</p>
                    <label class="campo campo-ancho">Motivo * <input class="e-input" @bind="_motivo" maxlength="500" /></label>
                    <div class="toolbar">
                        <SfButton CssClass="e-primary" Disabled="@(_accion.Activa || string.IsNullOrWhiteSpace(_motivo))" OnClick="@ReemplazarAsync">Reemplazar</SfButton>
                        <SfButton CssClass="e-outline" OnClick="@(() => _mostrarCasoB = false)">Cancelar</SfButton>
                    </div>
