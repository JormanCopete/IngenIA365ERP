@page "/ventas/notas-credito/nueva"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using IngenIA365ERP.Shared.Services.Http
@using IngenIA365ERP.Shared.Services.Inventario
@using IngenIA365ERP.Shared.Services.Ventas
@inject VentasClient Ventas
@inject InventarioClient Inventario
@inject MediosDePagoClient Medios
@inject INotificationService Notification
@inject NavigationManager Nav

<PageTitle>Nota crédito de venta - IngenIA365ERP</PageTitle>

@* Feature 012, I3 (T642; FR-066, FR-097, US5-8; contracts/api.md §18.3, §22.4): la nota crédito sobre una venta confirmada, precargada con
   sus líneas: por cantidad (con devolución a una bodega, que vuelve al costo con que salió) o por valor, o la anulación total. Los
   reintegros van por medio de pago (un bono reintegrado vuelve a servir); el efectivo sale de la sesión de caja abierta. El servidor no deja
   pasar de lo que queda de la venta, y confirmar manda el total que la persona vio. *@
<PermissionGate Required="Inventory.Sales.Create" MostrarAviso="true">
<div class="pagina">
    <div class="page-header">
        <h3>@(_doc is null ? "Nueva nota crédito" : $"Nota {_doc.Numero} · {TextosDeInventario.Estado(_doc.Status)}")</h3>
        <div class="toolbar">
            @if (_origen is not null) { <a class="e-btn e-outline" href="@($"/ventas/documentos/{_origen.DocumentPublicId}")">Volver a la venta</a> }
            <SfButton CssClass="e-outline" IconCss="e-icons e-save" Disabled="@(_guardado.Activa || _origen is null)" OnClick="@(() => GuardarAsync(false))">Guardar</SfButton>
            @if (_doc is not null)
            {
                <PermissionGate Required="Inventory.Sales.Confirm">
                    <SfButton CssClass="e-primary" IconCss="e-icons e-check" Disabled="@_guardado.Activa" OnClick="@ConfirmarAsync">Confirmar</SfButton>
                </PermissionGate>
            }
        </div>
    </div>

    <IndicadorDeCarga Cargando="@(_carga.Activa || _guardado.Activa)" Texto="@(_guardado.Activa ? "Guardando…" : "Cargando…")">
        @if (_origen is { } o)
        {
            <p class="texto-apoyo">Sobre @TextosDeInventario.Clase(o.Class) @o.Numero del @o.OperationDate.ToString("dd/MM/yyyy") a @(o.Counterparty?.Name ?? "consumidor final") por @o.Totals.Total.ToString("N0").</p>
            @if (_doc?.Issues is { Count: > 0 } hallazgos)
            {
                <div class="aviso aviso-alerta"><ul>@foreach (var h in hallazgos) { <li>@(h.LineNumber is { } n ? $"Línea {n}: " : "")@h.Message</li> }</ul></div>
            }
            <div class="form-grid">
                <label class="campo">Tipo
                    <select class="e-input" disabled="@(_doc is not null)" value="@(_tipo?.ToString() ?? "")" @onchange="@(e => _tipo = Id(e.Value))">
                        <option value="">El que corresponde a la venta</option>
                        @foreach (var t in _tipos) { <option value="@t.PublicId">@t.Code · @t.Name</option> }
                    </select>
                </label>
                <label class="campo">Fecha <input type="date" class="e-input" value="@(_fecha?.ToString("yyyy-MM-dd"))" @onchange="@(e => _fecha = Fecha(e.Value))" /></label>
                <label class="campo-check"><input type="checkbox" @bind="_anulacionTotal" /> Anula toda la venta</label>
                <label class="campo-check"><input type="checkbox" @bind="_conDevolucion" /> Con devolución de mercancía</label>
                @if (_conDevolucion)
                {
                    <label class="campo">Bodega que recibe
                        <select class="e-input" value="@(_bodega?.ToString() ?? "")" @onchange="@(e => _bodega = Id(e.Value))">
                            <option value="">La de la venta</option>
                            @foreach (var b in _bodegas) { <option value="@b.PublicId">@b.Code · @b.Name</option> }
                        </select>
                    </label>
                }
                <label class="campo">Concepto de corrección <input class="e-input" @bind="_concepto" maxlength="4" placeholder="1, 2, 3…" /></label>
                <label class="campo campo-ancho">Motivo * <input class="e-input" @bind="_motivo" maxlength="500" /></label>
            </div>

            @if (!_anulacionTotal)
            {
                <div class="tabla-desplazable">
                    <table class="data-grid">
                        <thead><tr><th>#</th><th>Producto</th><th class="numero">Vendido</th><th class="numero">Precio</th><th class="numero">Cantidad de la nota</th><th class="numero">o valor</th></tr></thead>
                        <tbody>
                            @foreach (var l in _lineas)
                            {
                                var linea = l;
                                <tr>
                                    <td>@l.Origen.LineNumber</td><td>@l.Origen.Product.Code · @l.Origen.Product.Name</td>
                                    <td class="numero">@l.Origen.Quantity.ToString("0.####") @l.Origen.Unit.Code</td><td class="numero">@l.Origen.UnitPrice.ToString("N0")</td>
                                    <td class="numero"><input class="e-input numero" type="number" min="0" step="any" @bind="linea.Cantidad" /></td>
                                    <td class="numero"><input class="e-input numero" type="number" min="0" step="any" @bind="linea.Valor" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (_doc is { } d)
            {
                <div class="info-card">
                    <div class="pos-a-pagar">Total de la nota @d.Totals.Total.ToString("N0") · a reintegrar @d.Totals.AmountDue.ToString("N0")</div>
                </div>
                <h4>Reintegros</h4>
                <PanelDeCobro Cobro="@_reintegros" Medios="@_medios" Cambio="@StateHasChanged" />
                <p class="texto-tenue">Sin reintegros, la nota queda como saldo a favor del cliente.</p>
            }
        }
        else if (!_carga.Activa)
        {
            <p class="texto-tenue">Abra la nota desde la venta que corrige («Nota crédito» en el documento).</p>
        }
    </IndicadorDeCarga>
</div>
</PermissionGate>

@code {
    private sealed class LineaForm(LineaDeVentaDto origen)
    {
        public LineaDeVentaDto Origen { get; } = origen;
        public decimal? Cantidad { get; set; }
        public decimal? Valor { get; set; }
    }

    [SupplyParameterFromQuery(Name = "origen")] public Guid? OrigenId { get; set; }

    [SupplyParameterFromQuery(Name = "documento")] public Guid? Documento { get; set; }

    private readonly EstadoDeCarga _carga = new(), _guardado = new();
    private readonly ClaveDeOperacion _claveGuardar = new(), _claveConfirmar = new();
    private DocumentoDeVentaDto? _origen, _doc;
    private SesionDeCajaDto? _sesion;
    private List<TipoDeDocumentoDto> _tipos = [];
    private List<BodegaDto> _bodegas = [];
    private IReadOnlyList<MedioDelPosDto> _medios = [];
    private List<LineaForm> _lineas = [];
    private CobroDelPos _reintegros = new(0m);
    private Guid? _tipo, _bodega;
    private DateOnly? _fecha = DateOnly.FromDateTime(DateTime.Today);
    private bool _anulacionTotal, _conDevolucion = true;
    private string? _concepto, _motivo;

    protected override async Task OnInitializedAsync()
    {
        using var carga = _carga.Iniciar();
        var tipos = await Inventario.ListarTiposAsync(grupo: TextosDeVentas.GrupoDeVentas);
        _tipos = tipos.IsSuccess ? [.. (tipos.Value ?? []).Where(t => t.IsActive && TextosDeVentas.ClasesDeNota.Contains(t.Class))] : [];
        var bodegas = await Inventario.ListarBodegasAsync();
        _bodegas = bodegas.IsSuccess ? [.. (bodegas.Value ?? []).Where(b => !b.IsTransit && b.IsActive)] : [];
        var sesion = await Ventas.MiSesionAbiertaAsync();
        _sesion = sesion.IsSuccess ? sesion.Value : null;
        var medios = await Medios.ListarAsync(activos: true);
        var datafonos = await Medios.DatafonosAsync(activos: true);
        _medios = MediosDeOficina.Desde(medios.IsSuccess ? medios.Value ?? [] : [], datafonos.IsSuccess ? datafonos.Value ?? [] : [], DateOnly.FromDateTime(DateTime.Today))
            .Where(m => !TextosDeVentas.EsCredito(m.Class)).ToList();

        if (Documento is { } id) await CargarNotaAsync(id);
        else if (OrigenId is { } origen) await CargarOrigenAsync(origen);
    }

    private async Task CargarOrigenAsync(Guid origen)
    {
        var r = await Ventas.ObtenerDocumentoAsync(origen);
        if (!r.IsSuccess || r.Value is null) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo consultar la venta."); return; }
        _origen = r.Value;
        _lineas = r.Value.Lines.OrderBy(l => l.LineNumber).Select(l => new LineaForm(l)).ToList();
    }

    private async Task CargarNotaAsync(Guid id)
    {
        var r = await Ventas.ObtenerDocumentoAsync(id);
        if (!r.IsSuccess || r.Value is null) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo consultar la nota."); return; }
        if (r.Value.Status != 0) { Nav.NavigateTo($"/ventas/documentos/{id}"); return; }
        _doc = r.Value;
        _tipo = r.Value.DocumentType.PublicId;
        _fecha = r.Value.OperationDate;
        if (_origen is null && r.Value.Links.Origin is { } o) await CargarOrigenAsync(o.PublicId);
        _reintegros = new CobroDelPos(r.Value.Totals.AmountDue);
    }

    private BorradorDeNotaRequest Pedido() => new(
        _origen!.DocumentPublicId, _motivo!.Trim(), _anulacionTotal, _conDevolucion,
        _anulacionTotal ? [] : _lineas.Where(l => l.Cantidad is > 0 || l.Valor is > 0)
            .Select(l => new LineaDeNotaRequest(l.Origen.LinePublicId, l.Cantidad is > 0 ? l.Cantidad : null, l.Cantidad is > 0 ? null : l.Valor)).ToList(),
        _doc is null ? [] : _reintegros.Pedido(_sesion?.CashSessionPublicId),
        _tipo, _fecha, string.IsNullOrWhiteSpace(_concepto) ? null : _concepto.Trim(), _conDevolucion ? _bodega : null, _doc?.RowVersion);

    private async Task<bool> GuardarAsync(bool silencioso)
    {
        if (_origen is null) return false;
        if (string.IsNullOrWhiteSpace(_motivo)) { await Notification.WarningAsync("Escriba el motivo de la nota."); return false; }
        if (!_anulacionTotal && !_lineas.Any(l => l.Cantidad is > 0 || l.Valor is > 0)) { await Notification.WarningAsync("Diga qué se corrige: una cantidad o un valor por línea, o la anulación total."); return false; }
        using var guardado = _guardado.Iniciar();
        var r = await Ventas.GuardarNotaAsync(_doc?.DocumentPublicId, Pedido(), _claveGuardar);
        if (!r.IsSuccess || r.Value is null) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo guardar la nota."); return false; }
        var nueva = _doc is null;
        var reintegros = _reintegros;
        await CargarNotaAsync(r.Value.DocumentPublicId);
        if (!nueva && reintegros.APagar == _reintegros.APagar) _reintegros = reintegros;
        if (!silencioso) await Notification.SuccessAsync("Nota guardada.");
        if (nueva) Nav.NavigateTo($"/ventas/notas-credito/nueva?documento={r.Value.DocumentPublicId}", replace: true);
        return true;
    }

    private async Task ConfirmarAsync()
    {
        if (_doc is null) return;
        if (!await GuardarAsync(true)) return;
        using var guardado = _guardado.Iniciar();
        var r = await Ventas.ConfirmarAsync(VentasClient.Rutas.Notas, _doc.DocumentPublicId, _doc.Totals.AmountDue, _doc.RowVersion, _claveConfirmar);
        if (!r.IsSuccess || r.Value is null) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo confirmar la nota."); return; }
        if (r.Value.Status == 1) await Notification.InfoAsync("Quedó en aprobación: la confirma la última aprobación.");
        else await Notification.SuccessAsync($"Nota {r.Value.DisplayNumber} confirmada.");
        Nav.NavigateTo($"/ventas/documentos/{_doc.DocumentPublicId}");
    }

    private static Guid? Id(object? valor) => Guid.TryParse(valor?.ToString(), out var g) ? g : null;

    private static DateOnly? Fecha(object? valor) =>
        DateOnly.TryParse(valor?.ToString(), System.Globalization.CultureInfo.InvariantCulture, out var f) ? f : null;
}
