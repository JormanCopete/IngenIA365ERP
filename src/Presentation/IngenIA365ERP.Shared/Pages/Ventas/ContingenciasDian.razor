@page "/ventas/contingencias-dian"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using IngenIA365ERP.Shared.Services.FacturacionElectronica
@using IngenIA365ERP.Shared.Services.Http
@using IngenIA365ERP.Shared.Services.Inventario
@using IngenIA365ERP.Shared.Services.Nomina
@using static IngenIA365ERP.Shared.Services.FacturacionElectronica.TextosDeFacturacionElectronica
@inject FacturacionElectronicaClient Facturacion
@inject InventarioClient Inventario
@inject DescargaDeArchivos Descargas
@inject INotificationService Notification

<PageTitle>Contingencias DIAN - IngenIA365ERP</PageTitle>

@* Feature 012, I4 (T756; FR-067, SC-015; contracts/api.md §24.6; contracts/dian.md §7, §12): la bitácora de contingencias —la 03, por falla
   del facturador, que declara una persona o abre el circuito del canal; y la 04, por falla de la DIAN, que sólo declara el canal— con sus
   documentos pendientes, transmitidos y rechazados y el plazo de transmisión, que se fija al cerrar según el parámetro y la norma
   vigentes. En ninguna de las dos se detiene la venta. Las constancias y evidencias de la cooperativa se adjuntan al evento (dueño
   DianContingencyEvent); la evidencia automática es la bitácora, que se exporta con el informe de documentos electrónicos del periodo
   del evento. *@
<PermissionGate Required="ElectronicInvoicing.Contingencies.View" MostrarAviso="true">
<div class="pagina">
    <div class="page-header">
        <h3>Contingencias ante la DIAN</h3>
        <div class="toolbar">
            <SfButton CssClass="e-outline" IconCss="e-icons e-refresh" Disabled="@_carga.Activa" OnClick="@CargarAsync">Actualizar</SfButton>
            <PermissionGate Required="ElectronicInvoicing.Contingencies.Declare">
                <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@AbrirDeclaracion">Declarar contingencia 03</SfButton>
            </PermissionGate>
            <a class="e-btn e-flat" href="/ventas/documentos-electronicos?contingencia=true">Documentos electrónicos</a>
            <a class="e-btn e-flat" href="/manual/facturacion-electronica">Ayuda</a>
        </div>
    </div>

    <div class="toolbar">
        <label class="campo">Estado
            <select class="e-input" value="@(_abiertas?.ToString() ?? "")" @onchange="@(e => { _abiertas = bool.TryParse(e.Value?.ToString(), out var a) ? a : null; return CargarAsync(); })">
                <option value="">Todas</option>
                <option value="True">Abiertas</option>
                <option value="False">Cerradas</option>
            </select>
        </label>
        <label class="campo">Tipo
            <select class="e-input" value="@(_tipo?.ToString() ?? "")" @onchange="@(e => { _tipo = int.TryParse(e.Value?.ToString(), out var t) ? t : null; return CargarAsync(); })">
                <option value="">Todos</option>
                @foreach (var (v, t) in TiposDeContingencia) { <option value="@v">@t</option> }
            </select>
        </label>
        <label class="campo">Desde <input type="date" class="e-input" value="@(_desde?.ToString("yyyy-MM-dd"))" @onchange="@(e => { _desde = LeerFecha(e.Value); return CargarAsync(); })" /></label>
        <label class="campo">Hasta <input type="date" class="e-input" value="@(_hasta?.ToString("yyyy-MM-dd"))" @onchange="@(e => { _hasta = LeerFecha(e.Value); return CargarAsync(); })" /></label>
    </div>

    <IndicadorDeCarga Cargando="@_carga.Activa">
        @if (!_carga.Activa && _eventos.Count == 0)
        {
            <p class="texto-tenue">No hay contingencias con estos filtros.</p>
        }
        <div class="tabla-desplazable">
            <table class="data-grid">
                <thead>
                    <tr><th>Tipo</th><th>Canal</th><th>Inicio</th><th>Fin</th><th>Detectó</th><th>Motivo</th><th>Plazo</th>
                        <th class="numero">Documentos</th><th class="numero">Pendientes</th><th class="numero">Transmitidos</th><th class="numero">Rechazados</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var c in _eventos)
                    {
                        <tr>
                            <td><span class="aviso @(c.IsOpen ? "aviso-alerta" : "aviso-info")">@TipoDeContingencia(c.Type)@(c.IsOpen ? " · abierta" : "")</span></td>
                            <td>@c.ChannelCode</td>
                            <td>@c.StartedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@c.EndedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@Actor(c.DetectedBy.Kind): @c.DetectedBy.Name</td>
                            <td>@c.Reason</td>
                            <td>@c.DeadlineAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="numero">@c.Documents.Total</td>
                            <td class="numero">@c.Documents.Pending</td>
                            <td class="numero">@c.Documents.Transmitted</td>
                            <td class="numero">@c.Documents.Rejected</td>
                            <td><SfButton CssClass="e-flat" OnClick="@(() => AbrirAsync(c.ContingencyPublicId))">Ver</SfButton></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </IndicadorDeCarga>

    <IndicadorDeCarga Cargando="@(_cargaDetalle.Activa || _guardado.Activa)" Texto="@(_guardado.Activa ? "Guardando…" : "Cargando la contingencia…")">
        @if (_detalle is { } det)
        {
            var c = det.Contingency;
            <div class="page-header">
                <h4>Contingencia @TipoDeContingencia(c.Type) · @c.ChannelCode · @(c.IsOpen ? "abierta" : "cerrada")</h4>
                <div class="toolbar">
                    @if (c.IsOpen && c.Type == ContingenciaDelFacturador)
                    {
                        <PermissionGate Required="ElectronicInvoicing.Contingencies.Declare">
                            <SfButton CssClass="e-primary" Disabled="@_guardado.Activa" OnClick="@AbrirCierre">Cerrar la contingencia</SfButton>
                        </PermissionGate>
                    }
                    <PermissionGate Required="Inventory.Reports.Export">
                        <SfButton CssClass="e-outline" IconCss="e-icons e-download" Disabled="@_guardado.Activa" OnClick="@ExportarAsync">Exportar la bitácora</SfButton>
                    </PermissionGate>
                    <SfButton CssClass="e-flat" OnClick="@(() => _detalle = null)">Cerrar el detalle</SfButton>
                </div>
            </div>
            <div class="form-grid">
                <div class="kpi-card"><span class="label">Inicio</span><span>@c.StartedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span></div>
                <div class="kpi-card"><span class="label">Fin</span><span>@(c.EndedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</span></div>
                <div class="kpi-card"><span class="label">Plazo de transmisión</span><span>@(c.DeadlineAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "se fija al cerrar")@(det.DeadlineHoursApplied > 0 ? $" ({det.DeadlineHoursApplied} h)" : "")</span></div>
                <div class="kpi-card"><span class="label">Norma aplicada</span><span>@(string.IsNullOrWhiteSpace(det.LegalSource) ? "—" : det.LegalSource)</span></div>
                <div class="kpi-card"><span class="label">Detectó</span><span>@Actor(c.DetectedBy.Kind): @c.DetectedBy.Name</span></div>
                <div class="kpi-card"><span class="label">Cerró</span><span>@(det.ClosedByName ?? "—")@(det.CloseReason is { } motivo ? $": {motivo}" : "")</span></div>
            </div>
            <p>Motivo: @c.Reason</p>

            <h4>Documentos del evento</h4>
            @if (det.Documents.Count == 0)
            {
                <p class="texto-tenue">Ningún documento se emitió durante este evento.</p>
            }
            else
            {
                <div class="tabla-desplazable">
                    <table class="data-grid">
                        <thead><tr><th>Número</th><th>Tipo</th><th>Expedido</th><th>Contraparte</th><th class="numero">Total</th><th>Estado</th><th>Plazo</th><th>Último mensaje</th></tr></thead>
                        <tbody>
                            @foreach (var d in det.Documents)
                            {
                                <tr>
                                    <td><a href="@($"/ventas/documentos-electronicos?documento={d.ElectronicDocumentPublicId}")">@d.Number</a></td>
                                    <td>@TipoDeDocumento(d.Kind)</td>
                                    <td>@d.IssuedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@d.CounterpartyName</td>
                                    <td class="numero">@d.Total.ToString("N0")</td>
                                    <td><span class="aviso @ClaseDeEstado(d.Status)">@Estado(d.Status)</span></td>
                                    <td>@d.TransmissionDeadline?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@d.LastMessage</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <h4>Evidencia</h4>
            @if (det.Evidence.Count == 0)
            {
                <p class="texto-tenue">Sin notas de evidencia.</p>
            }
            else
            {
                <ul>@foreach (var e in det.Evidence.OrderBy(x => x.At)) { <li>@e.At.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @e.ByName: @e.Note</li> }</ul>
            }
            <h4>Constancias y soportes</h4>
            <AttachmentList OwnerEntityType="DianContingencyEvent" OwnerEntityPublicId="@c.ContingencyPublicId" />
        }
    </IndicadorDeCarga>
</div>

<SfDialog @bind-Visible="_mostrarDeclaracion" Header="Declarar contingencia 03 (falla del facturador)" Width="560px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@_guardado.Activa" Texto="Declarando…">
                <p class="texto-apoyo">Mientras esté abierta, las ventas fiscales nuevas salen con el consecutivo de contingencia de su caja y se transmiten al cerrarla. La 04 (falla de la DIAN) la declara sólo el canal.</p>
                <div class="form-grid">
                    <label class="campo campo-ancho">Motivo * <input class="e-input" @bind="_motivo" maxlength="500" /></label>
                    <label class="campo">Desde (vacío: ahora) <input type="datetime-local" class="e-input" @bind="_momento" /></label>
                    <label class="campo campo-ancho">Nota de evidencia <input class="e-input" @bind="_nota" maxlength="500" /></label>
                </div>
                <div class="toolbar">
                    <SfButton CssClass="e-primary" Disabled="@(_guardado.Activa || string.IsNullOrWhiteSpace(_motivo))" OnClick="@DeclararAsync">Declarar</SfButton>
                    <SfButton CssClass="e-outline" OnClick="@(() => _mostrarDeclaracion = false)">Cancelar</SfButton>
                </div>
            </IndicadorDeCarga>
        </Content>
    </DialogTemplates>
</SfDialog>

<SfDialog @bind-Visible="_mostrarCierre" Header="Cerrar la contingencia" Width="560px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@_guardado.Activa" Texto="Cerrando…">
                <p class="texto-apoyo">Al cerrar se fija el plazo de transmisión de cada documento según el parámetro vigente y el procesador los transmite en orden, referidos a su número de papel.</p>
                <div class="form-grid">
                    <label class="campo campo-ancho">Motivo * <input class="e-input" @bind="_motivo" maxlength="500" /></label>
                    <label class="campo">Hasta (vacío: ahora) <input type="datetime-local" class="e-input" @bind="_momento" /></label>
                    <label class="campo campo-ancho">Nota de evidencia <input class="e-input" @bind="_nota" maxlength="500" /></label>
                </div>
                <div class="toolbar">
                    <SfButton CssClass="e-primary" Disabled="@(_guardado.Activa || string.IsNullOrWhiteSpace(_motivo))" OnClick="@CerrarAsync">Cerrar</SfButton>
                    <SfButton CssClass="e-outline" OnClick="@(() => _mostrarCierre = false)">Cancelar</SfButton>
                </div>
            </IndicadorDeCarga>
        </Content>
    </DialogTemplates>
</SfDialog>
</PermissionGate>

@code {
    private readonly EstadoDeCarga _carga = new(), _cargaDetalle = new(), _guardado = new();
    private readonly ClaveDeOperacion _claveDeclarar = new(), _claveCerrar = new();
    private List<ContingenciaDianDto> _eventos = [];
    private DetalleDeContingenciaDto? _detalle;
    private bool? _abiertas;
    private int? _tipo;
    private DateOnly? _desde, _hasta;
    private string? _motivo, _nota;
    private DateTime? _momento;
    private bool _mostrarDeclaracion, _mostrarCierre;

    protected override Task OnInitializedAsync() => CargarAsync();

    private async Task CargarAsync()
    {
        using var carga = _carga.Iniciar();
        var r = await Facturacion.ContingenciasAsync(_abiertas, Nombre(NombresDeTipoDeContingencia, _tipo), _desde, _hasta);
        if (!r.IsSuccess || r.Value is null) { _eventos = []; await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudieron consultar las contingencias."); return; }
        _eventos = [.. r.Value];
    }

    private async Task AbrirAsync(Guid id)
    {
        using var carga = _cargaDetalle.Iniciar();
        var r = await Facturacion.ContingenciaAsync(id);
        if (!r.IsSuccess || r.Value is null) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo abrir la contingencia."); return; }
        _detalle = r.Value;
    }

    private void AbrirDeclaracion()
    {
        _motivo = _nota = null;
        _momento = null;
        _mostrarDeclaracion = true;
    }

    private void AbrirCierre()
    {
        _motivo = _nota = null;
        _momento = null;
        _mostrarCierre = true;
    }

    private async Task DeclararAsync()
    {
        if (string.IsNullOrWhiteSpace(_motivo)) return;
        using var guardado = _guardado.Iniciar();
        var r = await Facturacion.DeclararContingenciaAsync(new DeclaracionDeContingenciaRequest(NombresDeTipoDeContingencia[ContingenciaDelFacturador],
            _motivo.Trim(), EnUtc(_momento), Limpio(_nota)), _claveDeclarar);
        if (!r.IsSuccess || r.Value is null) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo declarar la contingencia."); return; }
        _mostrarDeclaracion = false;
        await Notification.WarningAsync("Contingencia 03 abierta: las ventas fiscales nuevas salen en contingencia.");
        await CargarAsync();
        await AbrirAsync(r.Value.ContingencyPublicId);
    }

    private async Task CerrarAsync()
    {
        if (_detalle is null || string.IsNullOrWhiteSpace(_motivo)) return;
        using var guardado = _guardado.Iniciar();
        var id = _detalle.Contingency.ContingencyPublicId;
        var r = await Facturacion.CerrarContingenciaAsync(id, new CierreDeContingenciaRequest(_motivo.Trim(), EnUtc(_momento), Limpio(_nota)), _claveCerrar);
        if (!r.IsSuccess || r.Value is null) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo cerrar la contingencia."); return; }
        _mostrarCierre = false;
        await Notification.SuccessAsync(r.Value.DeadlineAt is { } plazo
            ? $"Contingencia cerrada. Plazo de transmisión: {plazo.ToLocalTime():dd/MM/yyyy HH:mm}."
            : "Contingencia cerrada.");
        await CargarAsync();
        await AbrirAsync(id);
    }

    /// <summary>La bitácora del evento: el informe de documentos electrónicos en contingencia entre su inicio y su fin, en Excel.</summary>
    private async Task ExportarAsync()
    {
        if (_detalle is null) return;
        using var guardado = _guardado.Iniciar();
        var c = _detalle.Contingency;
        var desde = DateOnly.FromDateTime(c.StartedAt.ToLocalTime());
        var hasta = DateOnly.FromDateTime((c.EndedAt ?? DateTime.UtcNow).ToLocalTime());
        var query = $"from={desde:yyyy-MM-dd}&to={hasta:yyyy-MM-dd}&contingency=true";
        var r = await Inventario.DescargarInformeAsync("dian-documents", query, "xlsx");
        if (!r.IsSuccess || r.Value is null) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo exportar la bitácora."); return; }
        await Descargas.GuardarAsync(r.Value.Nombre, r.Value.TipoContenido, r.Value.Contenido);
    }

    private static DateTime? EnUtc(DateTime? local) => local is { } l ? DateTime.SpecifyKind(l, DateTimeKind.Local).ToUniversalTime() : null;

    private static string? Limpio(string? texto) => string.IsNullOrWhiteSpace(texto) ? null : texto.Trim();

    private static DateOnly? LeerFecha(object? valor) =>
        DateOnly.TryParse(valor?.ToString(), System.Globalization.CultureInfo.InvariantCulture, out var f) ? f : null;
}
