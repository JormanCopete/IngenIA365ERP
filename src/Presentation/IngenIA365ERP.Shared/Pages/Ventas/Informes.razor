@page "/ventas/informes"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using IngenIA365ERP.Shared.Services.Inventario
@using IngenIA365ERP.Shared.Services.Nomina
@using IngenIA365ERP.Shared.Services.Reportes
@using IngenIA365ERP.Shared.Services.Ventas
@using IngenIA365ERP.Shared.Components.Reportes
@inject InventarioClient Inventario
@inject VentasClient Ventas
@inject PermisosDelUsuario Permisos
@inject INotificationService Notification
@inject NavigationManager Navigation
@inject DescargaDeArchivos Descargas

<PageTitle>Informes de ventas - IngenIA365ERP</PageTitle>

@* Feature 012, I3 (T643; contracts/api.md §27, T625): el centro de informes de Ventas, en el molde de /inventario/informes y
   /contabilidad/informes. Del registro de vistas de la API se queda con las once de I3 (VistasDeVentas): ventas por sesión, por caja y
   por medio de pago, la sesión de caja, el cierre del día, los pagos con tarjeta, los movimientos de caja, las diferencias de arqueo, los
   bonos redimidos, las aprobaciones de descuento y los indicios de deterioro. Filtros comunes (rango o corte, punto) y los propios de cada
   vista (agrupamiento, clase de medio, clase de movimiento, tratamiento, estado del bono, fecha operativa); los demás llegan por el enlace.
   Las columnas ocultas (_…) no se pintan ni se exportan. Exportar exige Inventory.Reports.Export y, con datos de clientes, además
   Inventory.Reports.ExportPersonalData. *@
<PermissionGate Required="Inventory.Reports.View" MostrarAviso="true">
<div class="pagina">
    <div class="page-header">
        <h3>Informes de ventas</h3>
        <div class="toolbar">
            @if (_tabla is not null && _vista is not null && _puedeExportar)
            {
                <PermissionGate Required="Inventory.Reports.Export">
                    <SfButton CssClass="e-outline" IconCss="e-icons e-download" Disabled="@_carga.Activa" OnClick="@(() => DescargarAsync("xlsx"))">Excel</SfButton>
                    <SfButton CssClass="e-outline" IconCss="e-icons e-download" Disabled="@_carga.Activa" OnClick="@(() => DescargarAsync("pdf"))">PDF</SfButton>
                    <SfButton CssClass="e-outline" IconCss="e-icons e-download" Disabled="@_carga.Activa" OnClick="@(() => DescargarAsync("docx"))">Word</SfButton>
                </PermissionGate>
            }
        </div>
    </div>

    <IndicadorDeCarga Cargando="@_cargaVistas.Activa" Texto="Buscando los informes disponibles…">
        @if (!_cargaVistas.Activa && _vistas.Count == 0)
        {
            <p class="texto-tenue">Los informes de ventas todavía no están publicados en esta instalación.</p>
        }
        else if (_vistas.Count > 0)
        {
            <div class="toolbar">
                <label class="campo">Informe
                    <select class="e-input" value="@(_vista?.Key)" @onchange="@(e => CambiarVista(e.Value?.ToString()))">
                        @foreach (var v in _vistas) { <option value="@v.Key">@v.Name</option> }
                    </select>
                </label>
                @if (Usa("from"))
                {
                    <label class="campo">Desde <input type="date" class="e-input" value="@Fecha(_filtros.From)" @onchange="@(e => _filtros.From = LeerFecha(e.Value))" /></label>
                }
                @if (Usa("to"))
                {
                    <label class="campo">Hasta <input type="date" class="e-input" value="@Fecha(_filtros.To)" @onchange="@(e => _filtros.To = LeerFecha(e.Value))" /></label>
                }
                @if (Usa("asOf"))
                {
                    <label class="campo">Con corte al <input type="date" class="e-input" value="@Fecha(_filtros.AsOf)" @onchange="@(e => _filtros.AsOf = LeerFecha(e.Value))" /></label>
                }
                @if (Usa("pointOfSale") && _puntos.Count > 0)
                {
                    <label class="campo">Punto
                        <select class="e-input" value="@Otro("pointOfSale")" @onchange="@(e => PonerOtro("pointOfSale", e.Value?.ToString()))">
                            <option value="">Todos los del alcance</option>
                            @foreach (var p in _puntos) { <option value="@p.PointOfSalePublicId">@p.Code · @p.Name</option> }
                        </select>
                    </label>
                }
                @if (UsaPropio("groupBy"))
                {
                    <label class="campo">Agrupar
                        <select class="e-input" value="@Otro("groupBy")" @onchange="@(e => PonerOtro("groupBy", e.Value?.ToString()))">
                            <option value="">Por defecto</option>
                            @foreach (var (valor, texto) in VistasDeVentas.Agrupamientos) { <option value="@valor">@texto</option> }
                        </select>
                    </label>
                }
                @if (UsaPropio("class"))
                {
                    <label class="campo">Clase de medio
                        <select class="e-input" value="@Otro("class")" @onchange="@(e => PonerOtro("class", e.Value?.ToString()))">
                            <option value="">Todas</option>
                            @foreach (var (v, t) in TextosDeVentas.ClasesDeMedio) { <option value="@TextosDeVentas.NombreDeClaseDeMedio(v)">@t</option> }
                        </select>
                    </label>
                }
                @if (UsaPropio("kind"))
                {
                    <label class="campo">Movimiento
                        <select class="e-input" value="@Otro("kind")" @onchange="@(e => PonerOtro("kind", e.Value?.ToString()))">
                            <option value="">Todos</option>
                            @foreach (var (v, t) in TextosDeVentas.ClasesDeMovimiento) { <option value="@TextosDeVentas.NombreDeClaseDeMovimiento(v)">@t</option> }
                        </select>
                    </label>
                }
                @if (UsaPropio("treatment"))
                {
                    <label class="campo">Tratamiento
                        <select class="e-input" value="@Otro("treatment")" @onchange="@(e => PonerOtro("treatment", e.Value?.ToString()))">
                            <option value="">Todos</option>
                            @foreach (var (v, t) in TextosDeVentas.TratamientosDeDiferencia) { <option value="@TextosDeVentas.NombreDeTratamiento(v)">@t</option> }
                        </select>
                    </label>
                }
                @if (UsaPropio("status"))
                {
                    <label class="campo">Estado del bono
                        <select class="e-input" value="@Otro("status")" @onchange="@(e => PonerOtro("status", e.Value?.ToString()))">
                            <option value="">Todos</option>
                            @foreach (var (v, t) in TextosDeVentas.EstadosDeBono) { <option value="@TextosDeVentas.NombresDeEstadoDeBono[v]">@t</option> }
                        </select>
                    </label>
                }
                @if (UsaPropio("operatingDate"))
                {
                    <label class="campo">Fecha operativa <input type="date" class="e-input" value="@Otro("operatingDate")" @onchange="@(e => PonerOtro("operatingDate", e.Value?.ToString()))" /></label>
                }
                <SfButton CssClass="e-primary" IconCss="e-icons e-search" Disabled="@(_carga.Activa || _vista is null)" OnClick="@AplicarAsync">Consultar</SfButton>
            </div>
            @if (_filtros.Otros.Keys.Any(k => !Editables.Contains(k)))
            {
                <p class="texto-tenue">
                    Filtros del enlace: @string.Join(" · ", _filtros.Otros.Where(o => !Editables.Contains(o.Key)).Select(o => $"{o.Key} = {o.Value}"))
                    <button type="button" class="enlace" @onclick="@QuitarFiltrosDelEnlace">quitarlos</button>
                </p>
            }
            <p class="texto-tenue">@(_vista?.Description)</p>
        }
    </IndicadorDeCarga>

    <IndicadorDeCarga Cargando="@_carga.Activa">
        @if (_vistas.Count > 0)
        {
            <TablaDeReporte Tabla="@_tabla" TextoSinTabla="Elija el informe y los filtros y pulse «Consultar»."
                            FilasClicables="@Profundiza" EsClicable="@(f => Destino(f) is not null)" FilaElegida="@Profundizar" />
        }
    </IndicadorDeCarga>
</div>
</PermissionGate>

@code {
    /// <summary>Los filtros propios que la pantalla edita; los demás son «del enlace».</summary>
    private static readonly HashSet<string> Editables = new(StringComparer.Ordinal) { "pointOfSale", "groupBy", "class", "kind", "treatment", "status", "operatingDate" };

    private readonly EstadoDeCarga _cargaVistas = new(), _carga = new();
    private List<VistaDeInformeDto> _vistas = [];
    private List<PuntoDeVentaDto> _puntos = [];
    private VistaDeInformeDto? _vista;
    private FiltrosDeInformeDeInventarioModelo _filtros = new();
    private FiltrosDeInformeDeInventarioModelo _aplicados = new();
    private TablaReporteDto? _tabla;
    private bool _iniciado, _puedeExportar;

    [SupplyParameterFromQuery(Name = "vista")] public string? Vista { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (_iniciado) return;
        _iniciado = true;
        _filtros = FiltrosDeInformeDeInventarioModelo.DesdeQuery(new Uri(Navigation.Uri).Query);
        var hoy = DateOnly.FromDateTime(DateTime.Today);
        _filtros.To ??= hoy;
        _filtros.From ??= new DateOnly(hoy.Year, hoy.Month, 1);
        _filtros.AsOf ??= hoy;

        using (_cargaVistas.Iniciar())
        {
            var r = await Inventario.VistasDeInformeAsync();
            if (!r.IsSuccess)
            {
                await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudieron consultar los informes disponibles.");
                return;
            }
            _vistas = [.. (r.Value ?? []).Where(v => VistasDeVentas.EsDeVentas(v.Key)).OrderBy(v => VistasDeVentas.Claves.ToList().IndexOf(v.Key))];
            var puntos = await Ventas.ListarPuntosAsync();
            _puntos = puntos.IsSuccess ? [.. puntos.Value ?? []] : [];
        }

        _vista = _vistas.FirstOrDefault(v => v.Key == Vista) ?? _vistas.FirstOrDefault();
        await EvaluarExportacionAsync();
        if (_vista is not null && !string.IsNullOrWhiteSpace(Vista) && _vista.Key == Vista) await AplicarAsync();
    }

    private async Task CambiarVista(string? clave)
    {
        if (string.IsNullOrWhiteSpace(clave) || clave == _vista?.Key) return;
        _vista = _vistas.FirstOrDefault(v => v.Key == clave);
        _tabla = null;
        await EvaluarExportacionAsync();
    }

    private async Task EvaluarExportacionAsync()
    {
        _puedeExportar = _vista is not null
                         && (!_vista.PersonalData || await Permisos.TieneAsync("Inventory.Reports.ExportPersonalData"));
    }

    private bool Usa(string filtro) => _vista is not null && _vista.Filters.Contains(filtro, StringComparer.OrdinalIgnoreCase);

    private bool UsaPropio(string filtro) => _vista?.OwnFilters is { } propios && propios.Contains(filtro, StringComparer.OrdinalIgnoreCase);

    private string Otro(string nombre) => _filtros.Otros.TryGetValue(nombre, out var v) ? v : string.Empty;

    private void PonerOtro(string nombre, string? valor)
    {
        if (string.IsNullOrWhiteSpace(valor)) _filtros.Otros.Remove(nombre);
        else _filtros.Otros[nombre] = valor;
    }

    /// <summary>La tabla trae con qué profundizar: el documento de venta o la sesión.</summary>
    private bool Profundiza => _tabla is not null && _tabla.Columnas.Any(c => c.Clave is "_documento" or "_sesion");

    private string? Destino(FilaReporteDto fila)
    {
        if (_tabla is null) return null;
        if (TablaDeReporte.Oculto(_tabla, fila, "_documento") is { } documento && Guid.TryParse(documento, out var d)) return $"/ventas/documentos/{d}";
        if (TablaDeReporte.Oculto(_tabla, fila, "_sesion") is { } sesion && Guid.TryParse(sesion, out var s)) return $"/pos/sesiones/{s}";
        return null;
    }

    private void Profundizar(FilaReporteDto fila)
    {
        if (Destino(fila) is { } ruta) Navigation.NavigateTo(ruta);
    }

    private async Task AplicarAsync()
    {
        if (_vista is null) return;
        _aplicados = SoloLosDeLaVista(_filtros);
        using var carga = _carga.Iniciar();
        var r = await Inventario.InformeAsync(_vista.Key, _aplicados.ToQuery());
        if (!r.IsSuccess)
        {
            _tabla = null;
            await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo generar el informe.");
            return;
        }
        _tabla = r.Value;
    }

    private async Task DescargarAsync(string formato)
    {
        if (_vista is null) return;
        using var carga = _carga.Iniciar();
        var r = await Inventario.DescargarInformeAsync(_vista.Key, _aplicados.ToQuery(), formato);
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo exportar."); return; }
        await Descargas.GuardarAsync(r.Value!.Nombre, r.Value.TipoContenido, r.Value.Contenido);
    }

    private void QuitarFiltrosDelEnlace()
    {
        foreach (var clave in _filtros.Otros.Keys.Where(k => !Editables.Contains(k)).ToList()) _filtros.Otros.Remove(clave);
        _tabla = null;
    }

    /// <summary>Las fechas y los filtros propios que la vista no usa no viajan.</summary>
    private FiltrosDeInformeDeInventarioModelo SoloLosDeLaVista(FiltrosDeInformeDeInventarioModelo f)
    {
        var copia = f.Copia();
        if (!Usa("from")) copia.From = null;
        if (!Usa("to")) copia.To = null;
        if (!Usa("asOf")) copia.AsOf = null;
        foreach (var clave in Editables.Where(k => copia.Otros.ContainsKey(k) && !Usa(k) && !UsaPropio(k)).ToList()) copia.Otros.Remove(clave);
        return copia;
    }

    private static string Fecha(DateOnly? f) => f?.ToString("yyyy-MM-dd") ?? string.Empty;

    private static DateOnly? LeerFecha(object? valor) =>
        DateOnly.TryParse(valor?.ToString(), System.Globalization.CultureInfo.InvariantCulture, out var f) ? f : null;
}
