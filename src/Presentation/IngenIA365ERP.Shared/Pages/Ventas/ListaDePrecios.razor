@page "/ventas/listas-de-precios/{Id:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using IngenIA365ERP.Shared.Services.Http
@using IngenIA365ERP.Shared.Services.Inventario
@using IngenIA365ERP.Shared.Services.Ventas
@implements IDisposable
@inject VentasClient Ventas
@inject INotificationService Notification

<PageTitle>Lista de precios - IngenIA365ERP</PageTitle>

@* Feature 012, I3 (T638; FR-053; contracts/api.md §19.1–§19.2): una lista de precios. 2026-11-15 (pedido del dueño): un solo buscador
   flexible —código, nombre, referencia o código de barras, como en las ventas, desde tres caracteres—; sin texto muestra los productos de
   la lista. Al elegir un producto se abre su ventana: el precio actual en cada unidad en que se vende (la base y sus alternas de venta),
   el precio nuevo de cada una y la historia de sus precios en la lista. Los precios se cambian sólo ahí, con un motivo que queda en la
   historia. Abajo, la consulta del precio que gana para un producto, cliente y fecha. *@
<PermissionGate Required="Inventory.Prices.View" MostrarAviso="true">
<div class="pagina">
    <div class="page-header">
        <h3>@(_lista is null ? "Lista de precios" : $"{_lista.Code} · {_lista.Name}")</h3>
        <div class="toolbar">
            <a class="e-btn e-outline" href="/ventas/listas-de-precios">Volver a las listas</a>
            @if (_lista is not null)
            {
                <PermissionGate Required="Inventory.Prices.Manage">
                    <SfButton CssClass="e-outline" IconCss="e-icons e-edit" OnClick="@AbrirCabecera">Editar lista</SfButton>
                </PermissionGate>
            }
        </div>
    </div>

    @if (_lista is { } l)
    {
        <div class="info-card">
            <div>@(l.IncludesTaxes ? "El precio incluye impuestos." : "El precio es antes de impuestos.") Vigente desde @l.ValidFrom.ToString("dd/MM/yyyy")@(l.ValidTo is { } h ? $" hasta {h:dd/MM/yyyy}" : ""). @(l.IsActive ? "Activa." : "Inactiva.")</div>
            <div class="texto-tenue">Especificidad @l.Specificity · @l.ItemCount precio(s)</div>
        </div>
    }

    <div class="form-grid">
        <label class="campo campo-ancho">Buscar producto
            <input class="e-input" value="@_buscar" @oninput="EscribirAsync" autocomplete="off"
                   placeholder="Código, nombre, referencia o código de barras (desde @MinimoDeCaracteres caracteres)" />
        </label>
        @* 2026-11-15 (pedido del dueño): ver de un vistazo qué falta por cargar y qué productos tienen precios en otras unidades. *@
        <label class="campo">Mostrar
            <select class="e-input" value="@_filtro" @onchange="@(e => CambiarFiltroAsync(e.Value?.ToString()))">
                <option value="0">Todos</option>
                <option value="1">Con precio base</option>
                <option value="2">Sin precio base</option>
                <option value="3">Con precios en otras unidades</option>
            </select>
        </label>
    </div>
    <p class="texto-tenue">@TextoDelFiltro</p>

    <IndicadorDeCarga Cargando="@_carga.Activa">
        <div class="tabla-desplazable">
            <table class="data-grid">
                <thead><tr><th>Producto</th><th>Referencia</th><th>Unidad base</th><th class="numero">Precio base</th><th>Otras unidades</th><th></th></tr></thead>
                <tbody>
                    @foreach (var p in _productos)
                    {
                        var producto = p;
                        var otras = producto.Prices.Where(x => x.UnitCode != producto.BaseUnitCode).ToList();
                        <tr class="fila-clicable" @onclick="@(() => AbrirProductoAsync(producto.ProductPublicId))">
                            <td>
                                <TextoResaltado Texto="@producto.Code" Busqueda="@BusquedaActiva" /> · <TextoResaltado Texto="@producto.Name" Busqueda="@BusquedaActiva" />
                                @if (BusquedaActiva is { } buscado && !Resaltado.Coincide(producto.Code, buscado) && !Resaltado.Coincide(producto.Name, buscado) && !Resaltado.Coincide(producto.Reference, buscado))
                                {
                                    <span class="texto-tenue"> (coincide por el código de barras o la marca)</span>
                                }
                            </td>
                            <td><TextoResaltado Texto="@producto.Reference" Busqueda="@BusquedaActiva" /></td>
                            <td>@producto.BaseUnitCode</td>
                            <td class="numero">@(producto.BasePrice is { } b ? b.ToString("N2") : producto.PriceEnteredAtSale ? "se digita en la venta" : "sin precio")</td>
                            <td>@string.Join(", ", otras.Select(x => $"{x.UnitCode} {x.Price:N2}{(x.IsOrphan ? " (ya no es del producto)" : "")}"))</td>
                            <td><SfButton CssClass="e-flat e-small" IconCss="e-icons e-edit" title="Ver y cambiar el precio">Precio</SfButton></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (_productos.Count == 0 && !_carga.Activa)
        {
            <p class="texto-tenue">@(Buscando ? $"Ningún producto coincide con «{_buscar}»." : "La lista todavía no tiene precios.")</p>
        }
        <div class="toolbar">
            <SfButton CssClass="e-flat" Disabled="@(_pagina <= 1 || _carga.Activa)" OnClick="@(() => PaginaAsync(-1))">Anterior</SfButton>
            <span class="texto-tenue">Página @_pagina · @_total producto(s)</span>
            <SfButton CssClass="e-flat" Disabled="@(_pagina * TamanoDePagina >= _total || _carga.Activa)" OnClick="@(() => PaginaAsync(1))">Siguiente</SfButton>
        </div>
    </IndicadorDeCarga>

    @* 2026-11-15 (pedido del dueño): la consulta del precio que gana, más clara. Responde qué precio tomaría una venta de ese producto,
       para ese cliente y en esa fecha, entre todas las listas activas (no sólo ésta), y por qué. Con una sola lista, siempre es la suya. *@
    <div class="info-card">
        <h4>¿Qué precio tomaría una venta?</h4>
        <p class="texto-tenue">Elija el producto (y, si quiere, el cliente y la fecha) para ver qué precio cobraría el punto de venta o la factura y de qué
            lista sale. Sirve cuando hay varias listas (por cliente, canal, sucursal o clase de asociado): el sistema usa la más específica que tenga el producto.</p>
        <SelectorDeProducto Modo="ModoDeBusquedaDeProductos.EnElCampo" ConservarElegido="true" Etiqueta="Producto" Elegido="@ElegirParaConsultar" />
        <div class="form-grid">
            <label class="campo campo-ancho">Cliente (opcional) <PersonSearchPicker @bind-Selected="_clienteConsulta" ShowHelpText="false" Compacto="true" /></label>
            <label class="campo">Fecha <input type="date" class="e-input" value="@(_fechaConsulta?.ToString("yyyy-MM-dd"))" @onchange="@(e => _fechaConsulta = Fecha(e.Value))" /></label>
        </div>
        <div class="toolbar">
            <SfButton CssClass="e-primary" IconCss="e-icons e-search" Disabled="@(_productoConsulta is null || _cargaConsulta.Activa)" OnClick="@ConsultarAsync">Consultar</SfButton>
            <span class="texto-tenue">@(_nombreConsulta is { } n ? $"Producto: {n}" : "Elija el producto de la lista que aparece al escribir.")</span>
        </div>
        <IndicadorDeCarga Cargando="@_cargaConsulta.Activa" Compacto="true">
            @if (_errorConsulta is { } error)
            {
                <p class="aviso aviso-error">@error</p>
            }
            @if (_resuelto is { } r)
            {
                <div class="kpi-card">
                    <div class="texto-tenue">Precio que se cobraría (unidad base)</div>
                    <div><b>$ @r.Price.ToString("N2")</b> @(r.IncludesTaxes ? "· con impuestos incluidos" : "· antes de impuestos")</div>
                    <div>Sale de la lista <b>@r.PriceList.Code</b> (@r.PriceList.Name)@(r.PriceList.MatchedDimensions.Count > 0
                        ? $", que aplica por {string.Join(", ", r.PriceList.MatchedDimensions.Select(Dimension))}" : ", la lista general")</div>
                    @if (r.FallbackUsed)
                    {
                        <div class="aviso">Había una lista más específica, pero no tiene este producto: se usó la siguiente que sí lo tiene.</div>
                    }
                </div>
                @if (r.Candidates.Count > 1)
                {
                    <p class="texto-tenue">Listas que podían aplicar, de la más específica a la general:</p>
                    <table class="data-grid">
                        <thead><tr><th>Lista</th><th>Aplica por</th><th>¿Tiene el producto?</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var c in r.Candidates)
                            {
                                <tr>
                                    <td>@c.Code</td>
                                    <td>@(c.MatchedDimensions.Count == 0 ? "General (todos)" : string.Join(", ", c.MatchedDimensions.Select(Dimension)))</td>
                                    <td>@(c.HasProduct ? "Sí" : "No")</td>
                                    <td>@(c.PriceListPublicId == r.PriceList.PublicId ? "← ésta da el precio" : "")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="texto-tenue">Sólo una lista aplica a esta venta: el precio es el de esa lista.</p>
                }
            }
        </IndicadorDeCarga>
    </div>
</div>

@* La ventana del producto: su precio en cada unidad de venta, el precio nuevo y la historia en la lista. *@
<SfDialog @bind-Visible="_mostrarProducto" Header="@(_detalle is { } d ? $"Precio de {d.Code} · {d.Name}" : "Precio del producto")" Width="860px" IsModal="true"
          ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@(_cargaProducto.Activa || _guardado.Activa)" Texto="@(_guardado.Activa ? "Guardando…" : "Cargando…")">
                @if (_detalle is { } d)
                {
                    @if (!string.IsNullOrWhiteSpace(d.Reference)) { <p class="texto-tenue">Referencia @d.Reference</p> }
                    <div class="tabla-desplazable">
                        <table class="data-grid">
                            <thead><tr><th>Unidad</th><th class="numero">Factor</th><th class="numero">Precio actual</th><th class="numero">Precio nuevo</th></tr></thead>
                            <tbody>
                                @foreach (var u in d.Units)
                                {
                                    var unidad = u;
                                    <tr>
                                        <td>@unidad.UnitCode@(unidad.IsBase ? " (base)" : "")@(unidad.IsOrphan ? " · ya no es una unidad del producto: la venta no usa este precio" : "")</td>
                                        <td class="numero">@(unidad.IsOrphan ? "" : unidad.Factor.ToString("0.######"))</td>
                                        <td class="numero">@(unidad.Price is { } actual ? actual.ToString("N2") : "sin precio")</td>
                                        <td class="numero">
                                            @if (!unidad.IsOrphan)
                                            {
                                                <PermissionGate Required="Inventory.Prices.Manage">
                                                    <input class="e-input numero" type="number" min="0" step="any" value="@_nuevos.GetValueOrDefault(unidad.UnitPublicId)"
                                                           @onchange="@(e => _nuevos[unidad.UnitPublicId] = Numero(e.Value))" />
                                                </PermissionGate>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <PermissionGate Required="Inventory.Prices.Manage">
                        <div class="form-grid">
                            <label class="campo campo-ancho">Motivo * <input class="e-input" @bind="_motivo" maxlength="500" placeholder="Por qué cambia el precio (queda en la historia)" /></label>
                        </div>
                        <div class="toolbar">
                            <SfButton CssClass="e-primary" Disabled="@_guardado.Activa" OnClick="@GuardarPreciosAsync">Guardar precios</SfButton>
                            @if (d.Units.Any(u => u.Price is not null))
                            {
                                <SfButton CssClass="e-outline" IconCss="e-icons e-trash" Disabled="@_guardado.Activa" OnClick="@SacarDeLaListaAsync">Sacar de la lista</SfButton>
                            }
                            <SfButton CssClass="e-flat" OnClick="@(() => _mostrarProducto = false)">Cerrar</SfButton>
                        </div>
                    </PermissionGate>

                    <h4>Historia en la lista</h4>
                    @if (d.History.Count == 0)
                    {
                        <p class="texto-tenue">Sin cambios registrados (la historia empieza el 15/11/2026).</p>
                    }
                    else
                    {
                        <div class="tabla-desplazable">
                            <table class="data-grid">
                                <thead><tr><th>Fecha</th><th>Qué</th><th>Unidad</th><th class="numero">Antes</th><th class="numero">Después</th><th>Motivo</th><th>Quién</th></tr></thead>
                                <tbody>
                                    @foreach (var h in d.History)
                                    {
                                        <tr>
                                            <td>@h.At.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>@h.Que</td>
                                            <td>@(h.PreviousUnitCode is { } antes ? $"{antes} → {h.UnitCode}" : h.UnitCode)</td>
                                            <td class="numero">@h.PreviousPrice?.ToString("N2")</td>
                                            <td class="numero">@h.NewPrice?.ToString("N2")</td>
                                            <td>@h.Reason</td>
                                            <td>@h.By</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </IndicadorDeCarga>
        </Content>
    </DialogTemplates>
</SfDialog>

<SfDialog @bind-Visible="_mostrarCabecera" Header="Editar la lista" Width="560px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@_guardado.Activa" Texto="Guardando…">
                <div class="form-grid">
                    <label class="campo">Nombre * <input class="e-input" @bind="_nombre" maxlength="100" /></label>
                    <label class="campo">Vigente hasta <input type="date" class="e-input" value="@(_hasta?.ToString("yyyy-MM-dd"))" @onchange="@(e => _hasta = Fecha(e.Value))" /></label>
                    <label class="campo-check"><input type="checkbox" @bind="_activa" /> Activa</label>
                    <label class="campo campo-ancho">Notas <input class="e-input" @bind="_notas" maxlength="500" /></label>
                    <label class="campo campo-ancho">Motivo * <input class="e-input" @bind="_motivoCabecera" maxlength="500" /></label>
                </div>
                <div class="toolbar">
                    <SfButton CssClass="e-primary" Disabled="@_guardado.Activa" OnClick="@GuardarCabeceraAsync">Guardar</SfButton>
                    <SfButton CssClass="e-outline" OnClick="@(() => _mostrarCabecera = false)">Cancelar</SfButton>
                </div>
            </IndicadorDeCarga>
        </Content>
    </DialogTemplates>
</SfDialog>
</PermissionGate>

@code {
    private const int TamanoDePagina = 50;

    /// <summary>Desde cuántos caracteres filtra el buscador (como en las ventas).</summary>
    private const int MinimoDeCaracteres = 3;

    /// <summary>La espera desde la última tecla antes de buscar.</summary>
    private const int EsperaEnMilisegundos = 300;

    [Parameter] public Guid Id { get; set; }

    private readonly EstadoDeCarga _carga = new(), _guardado = new(), _cargaConsulta = new(), _cargaProducto = new();
    private ClaveDeOperacion _clavePrecios = new();
    private readonly ClaveDeOperacion _claveCabecera = new();
    private ListaDePreciosDto? _lista;
    private List<ProductoConPrecioDeListaDto> _productos = [];
    private string _buscar = string.Empty;
    private CancellationTokenSource? _espera;
    private int _pagina = 1;
    private long _total;

    private bool _mostrarProducto;
    private DetalleDePrecioDeProductoDto? _detalle;
    private readonly Dictionary<Guid, decimal?> _nuevos = [];
    private string? _motivo;

    private bool _mostrarCabecera, _activa;
    private string? _nombre, _notas, _motivoCabecera;
    private DateOnly? _hasta;

    private Guid? _productoConsulta;
    private PersonSearchPicker.PersonSearchItem? _clienteConsulta;
    private DateOnly? _fechaConsulta = DateOnly.FromDateTime(DateTime.Today);
    private PrecioResueltoDto? _resuelto;

    private bool Buscando => _buscar.Trim().Length >= MinimoDeCaracteres;

    /// <summary>Lo que se busca de verdad (desde tres caracteres): lo que se marca en la tabla.</summary>
    private string? BusquedaActiva => Buscando ? _buscar.Trim() : null;

    /// <summary>0 todos, 1 con precio base, 2 sin precio base, 3 con precios en otras unidades.</summary>
    private int _filtro;

    private string? _nombreConsulta, _errorConsulta;

    private string TextoDelFiltro => (_filtro, Buscando) switch
    {
        (2, false) => "Productos del catálogo que no tienen precio en su unidad base en esta lista: la venta no los encuentra.",
        (1, _) => "Productos con precio en su unidad base.",
        (3, _) => "Productos con precio en una unidad distinta de la base (otra unidad de venta, o una que el producto ya no tiene).",
        (_, true) => "Productos que coinciden, estén o no en la lista; lo que coincide va marcado. Elija uno para ver su precio y cambiarlo.",
        _ => "Los productos de la lista. Escriba para buscar cualquier producto, también los que todavía no tienen precio aquí.",
    };

    private Task CambiarFiltroAsync(string? valor)
    {
        _filtro = int.TryParse(valor, out var f) ? f : 0;
        _pagina = 1;
        return CargarAsync();
    }

    private static string Dimension(string d) => d switch
    {
        "Person" => "cliente", "Segment" => "clase de asociado", "Channel" => "canal de venta", "Branch" => "sucursal", _ => d,
    };

    protected override async Task OnParametersSetAsync()
    {
        await CargarListaAsync();
        await CargarAsync();
    }

    private async Task CargarListaAsync()
    {
        var r = await Ventas.ObtenerListaAsync(Id, null, 1, 1);
        if (!r.IsSuccess || r.Value is null) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo consultar la lista."); return; }
        _lista = r.Value.List;
    }

    /// <summary>Mientras se escribe: espera 300 ms desde la última tecla; con menos de tres caracteres vuelve a los productos de la lista.</summary>
    private async Task EscribirAsync(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        var anterior = Buscando;
        _buscar = e.Value?.ToString() ?? string.Empty;
        _espera?.Cancel();
        if (!Buscando && !anterior) return;
        var espera = _espera = new CancellationTokenSource();
        try { await Task.Delay(EsperaEnMilisegundos, espera.Token); }
        catch (TaskCanceledException) { return; }
        _pagina = 1;
        await CargarAsync();
    }

    private async Task PaginaAsync(int paso)
    {
        _pagina = Math.Max(1, _pagina + paso);
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        using var carga = _carga.Iniciar();
        var r = await Ventas.BuscarProductosDeListaAsync(Id, BusquedaActiva, _pagina, TamanoDePagina, filtro: _filtro);
        if (!r.IsSuccess || r.Value is null) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudieron buscar los productos."); return; }
        _productos = [.. r.Value.Items];
        _total = r.Value.TotalCount;
    }

    private async Task AbrirProductoAsync(Guid producto)
    {
        _detalle = null;
        _nuevos.Clear();
        _motivo = null;
        _clavePrecios = new ClaveDeOperacion();
        _mostrarProducto = true;
        await LeerProductoAsync(producto);
    }

    private async Task LeerProductoAsync(Guid producto)
    {
        using var carga = _cargaProducto.Iniciar();
        var r = await Ventas.PreciosDeProductoAsync(Id, producto);
        if (!r.IsSuccess || r.Value is null) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo leer el producto."); _mostrarProducto = false; return; }
        _detalle = r.Value;
    }

    private async Task GuardarPreciosAsync()
    {
        if (_detalle is not { } d) return;
        var cambios = d.Units
            .Where(u => !u.IsOrphan && _nuevos.TryGetValue(u.UnitPublicId, out var nuevo) && nuevo is { } valor && valor != u.Price)
            .Select(u => new PrecioDeListaRequest(d.ProductPublicId, u.UnitPublicId, _nuevos[u.UnitPublicId]!.Value))
            .ToList();
        if (cambios.Count == 0) { await Notification.WarningAsync("Escriba el precio nuevo de al menos una unidad."); return; }
        if (cambios.Any(c => c.Price < 0m)) { await Notification.WarningAsync("El precio no puede ser negativo."); return; }
        if (string.IsNullOrWhiteSpace(_motivo)) { await Notification.WarningAsync("Escriba el motivo del cambio de precio."); return; }

        using (_guardado.Iniciar())
        {
            var r = await Ventas.FijarPreciosAsync(Id, new PreciosDeListaRequest(cambios, null, _motivo.Trim()), _clavePrecios);
            if (!r.IsSuccess || r.Value is null) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudieron guardar los precios."); return; }
            await Notification.SuccessAsync($"{r.Value.Created} nuevo(s), {r.Value.Updated} cambiado(s).");
        }
        await DespuesDeGuardarAsync(d.ProductPublicId);
    }

    private async Task SacarDeLaListaAsync()
    {
        if (_detalle is not { } d) return;
        if (string.IsNullOrWhiteSpace(_motivo)) { await Notification.WarningAsync("Escriba el motivo para sacar el producto de la lista."); return; }
        using (_guardado.Iniciar())
        {
            var r = await Ventas.FijarPreciosAsync(Id, new PreciosDeListaRequest([], [d.ProductPublicId], _motivo.Trim()), _clavePrecios);
            if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo sacar el producto de la lista."); return; }
            await Notification.SuccessAsync($"{d.Code} salió de la lista.");
        }
        await DespuesDeGuardarAsync(d.ProductPublicId);
    }

    /// <summary>Tras guardar: la ventana muestra los precios nuevos y la historia, y la tabla y la cabecera se refrescan.</summary>
    private async Task DespuesDeGuardarAsync(Guid producto)
    {
        _nuevos.Clear();
        _motivo = null;
        _clavePrecios = new ClaveDeOperacion();
        await LeerProductoAsync(producto);
        await CargarListaAsync();
        await CargarAsync();
    }

    private void AbrirCabecera()
    {
        if (_lista is null) return;
        _nombre = _lista.Name; _hasta = _lista.ValidTo; _activa = _lista.IsActive; _notas = null; _motivoCabecera = null;
        _mostrarCabecera = true;
    }

    private async Task GuardarCabeceraAsync()
    {
        if (_lista is null || string.IsNullOrWhiteSpace(_nombre) || string.IsNullOrWhiteSpace(_motivoCabecera))
        {
            await Notification.WarningAsync("El nombre y el motivo son obligatorios.");
            return;
        }
        using var guardado = _guardado.Iniciar();
        var r = await Ventas.GuardarListaAsync(Id, new ListaDePreciosRequest(null, _nombre.Trim(), _lista.IncludesTaxes, null, null, _hasta, _activa, _motivoCabecera.Trim(),
            string.IsNullOrWhiteSpace(_notas) ? null : _notas.Trim()), _claveCabecera);
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo guardar la lista."); return; }
        _mostrarCabecera = false;
        await CargarListaAsync();
    }

    /// <summary>Elegido el producto, consulta de una vez (el cliente y la fecha se pueden cambiar y volver a consultar).</summary>
    private Task ElegirParaConsultar(ProductoElegido elegido)
    {
        _productoConsulta = elegido.Producto.PublicId;
        _nombreConsulta = $"{elegido.Producto.Code} · {elegido.Producto.Name} ({elegido.Producto.BaseUnitCode})";
        return ConsultarAsync();
    }

    private async Task ConsultarAsync()
    {
        if (_productoConsulta is not { } producto) return;
        using var carga = _cargaConsulta.Iniciar();
        _errorConsulta = null;
        var r = await Ventas.ResolverPrecioAsync(producto, persona: _clienteConsulta?.PublicId, fecha: _fechaConsulta);
        _resuelto = r.IsSuccess ? r.Value : null;
        // Sin precio no es una falla de la pantalla: es lo que la venta encontraría. Se dice en la tarjeta.
        if (!r.IsSuccess) _errorConsulta = r.ErrorMessage ?? "No se pudo consultar el precio.";
    }

    private static DateOnly? Fecha(object? valor) =>
        DateOnly.TryParse(valor?.ToString(), System.Globalization.CultureInfo.InvariantCulture, out var f) ? f : null;

    private static decimal? Numero(object? valor) =>
        decimal.TryParse(valor?.ToString(), System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var n) ? n : null;

    public void Dispose() => _espera?.Cancel();
}
