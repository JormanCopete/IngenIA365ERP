@* El alta se retiro: crear una fila SEC_Users sin identidad central produce
   alguien que existe en la pantalla y no puede entrar. Las personas entran por
   invitacion, que si crea las dos mitades. *@
@page "/security/users/{PublicId:guid}"
@using IngenIA365ERP.Shared.Configuration
@using System.Net.Http.Json
@using IngenIA365ERP.Shared.Services.Core
@using IngenIA365ERP.Shared.Services
@inject HttpClient Http
@inject NavigationManager Nav
@inject PersonasClient Personas

@*
    Feature 017: el correo y el documento son de la identidad central. El correo lo cambia la persona
    (Mi cuenta) o soporte; el documento lo corrige aquí el administrador si la persona sólo está en esta
    cooperativa, y si no, soporte de la plataforma. El campo libre «Cédula» se retiró: no lo leía nadie
    para entrar y contradecía al documento real.
*@

<PageTitle>Usuario — IngenIA365ERP</PageTitle>

<div class="admin-page">
    <div class="page-header">
        <h1>Usuario</h1>
    </div>

    @if (_mensaje is not null)
    {
        <div class="aviso @(_esError ? "aviso-error" : "aviso-ok")" role="status">@_mensaje</div>
    }

    <IndicadorDeCarga Cargando="@_carga.Activa">
        @if (_usuario is not null)
        {
            <section class="tarjeta">
                <div class="rejilla-campos">
                    <label>Correo <input value="@_usuario.Email" readonly /></label>
                    <label>Usuario de documento <input value="@(_usuario.DocumentUsername ?? "Sin registrar")" readonly /></label>
                </div>
                <p class="texto-apoyo">El correo lo cambia la propia persona desde «Mi cuenta».</p>
            </section>

            <section class="tarjeta">
                <h3>Persona</h3>
                <p class="texto-apoyo">
                    La persona del maestro que corresponde a este usuario. Cartera la exige para radicar, decidir, votar,
                    desembolsar o cargar la migración. Una persona es de un solo usuario.
                </p>
                <IndicadorDeCarga Cargando="@_cargaPersona.Activa">
                    @if (_usuario.PersonPublicId is not null)
                    {
                        <p><strong>@_usuario.PersonName</strong> · documento @_usuario.PersonDocument</p>
                    }
                    else if (_usuario.PersonId is not null)
                    {
                        <p class="celda-aviso">La persona vinculada fue eliminada. Restáurela en Maestros › Personas o vincule otra.</p>
                    }
                    else
                    {
                        <p class="celda-aviso">Sin persona vinculada: este usuario no puede intervenir en Cartera.</p>
                    }

                    <PermissionGate Required="Security.Users.Update">
                        @if (_usuario.PersonId is not null)
                        {
                            <div class="toolbar">
                                <button class="boton boton-secundario" type="button" disabled="@_cargaPersona.Activa"
                                        @onclick="() => VincularPersonaAsync(null, null)">Quitar el vínculo</button>
                            </div>
                        }
                        <div class="rejilla-campos">
                            <label>Buscar persona
                                <input @bind="_terminoPersona" @bind:event="oninput" @onkeydown="TeclaPersonaAsync"
                                       placeholder="Nombre o documento" autocomplete="off" />
                            </label>
                        </div>
                        <div class="toolbar">
                            <button class="boton-principal" type="button"
                                    disabled="@(_cargaPersona.Activa || string.IsNullOrWhiteSpace(_terminoPersona))"
                                    @onclick="BuscarPersonaAsync">Buscar</button>
                        </div>
                        @if (_personasEncontradas is { Count: 0 })
                        {
                            <p class="texto-apoyo">Ninguna persona coincide. Se registra en Maestros › Personas.</p>
                        }
                        else if (_personasEncontradas is not null)
                        {
                            <table class="table tabla data-grid">
                                <thead>
                                    <tr>
                                        <th>Documento</th>
                                        <th>Nombre</th>
                                        <th><span class="visualmente-oculto">Acciones</span></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in _personasEncontradas)
                                    {
                                        <tr>
                                            <td>@p.IdentificationNumber</td>
                                            <td>@p.FullName</td>
                                            <td>
                                                <button class="boton boton-secundario" type="button"
                                                        disabled="@(_cargaPersona.Activa || p.PublicId == _usuario.PersonPublicId)"
                                                        @onclick="() => VincularPersonaAsync(p.PublicId, p.FullName)">Vincular</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </PermissionGate>
                </IndicadorDeCarga>
            </section>

            <section class="tarjeta">
                <h3>Oficinas</h3>
                <p class="texto-apoyo">
                    Las oficinas asignadas dan el alcance de sucursal: en Contabilidad y en Cartera la persona ve y digita
                    sólo lo de las agencias vinculadas a sus oficinas. La de por defecto es la que se le propone.
                </p>
                <IndicadorDeCarga Cargando="@_cargaOficinas.Activa">
                    @if (_usuario.Branches.Count == 0)
                    {
                        <p class="texto-apoyo">
                            Sin oficinas asignadas: en Contabilidad ve todas las agencias y en Cartera no ve ninguna.
                        </p>
                    }
                    else
                    {
                        <table class="table tabla data-grid">
                            <thead>
                                <tr>
                                    <th>Oficina</th>
                                    <th>Agencia contable</th>
                                    <th>Por defecto</th>
                                    <th><span class="visualmente-oculto">Acciones</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var o in _usuario.Branches)
                                {
                                    <tr>
                                        <td>@o.Code · @o.Name</td>
                                        <td>
                                            @if (o.AgencyName is not null)
                                            {
                                                @o.AgencyName
                                            }
                                            else
                                            {
                                                <span class="celda-aviso">
                                                    Sin agencia contable: esta oficina no da alcance en Contabilidad.
                                                    Se vincula en Maestros › Agencias.
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            @if (o.IsDefault)
                                            {
                                                <span class="badge">Por defecto</span>
                                            }
                                            else
                                            {
                                                <PermissionGate Required="Security.Users.AssignBranch">
                                                    <button class="boton boton-secundario" type="button" disabled="@_cargaOficinas.Activa"
                                                            @onclick="() => MarcarPorDefectoAsync(o)">Marcar por defecto</button>
                                                </PermissionGate>
                                            }
                                        </td>
                                        <td>
                                            <PermissionGate Required="Security.Users.AssignBranch">
                                                <button class="boton boton-secundario" type="button" disabled="@_cargaOficinas.Activa"
                                                        @onclick="() => QuitarOficinaAsync(o)">Quitar</button>
                                            </PermissionGate>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }

                    <PermissionGate Required="Security.Users.AssignBranch">
                        @if (!_oficinasVisibles)
                        {
                            <p class="texto-apoyo">Para asignar oficinas hace falta ver las oficinas de la cooperativa (Sistema › Sucursales).</p>
                        }
                        else if (OficinasPorAsignar.Count == 0)
                        {
                            <p class="texto-apoyo">Ya tiene asignadas todas las oficinas activas de la cooperativa.</p>
                        }
                        else
                        {
                            <div class="rejilla-campos">
                                <label>Oficina
                                    <select @bind="_oficinaNueva">
                                        <option value="@Guid.Empty">Elegí una oficina…</option>
                                        @foreach (var o in OficinasPorAsignar)
                                        {
                                            <option value="@o.PublicId">@o.Code · @o.Name</option>
                                        }
                                    </select>
                                </label>
                                <label><input type="checkbox" @bind="_nuevaPorDefecto" /> Por defecto</label>
                            </div>
                            <div class="toolbar">
                                <button class="boton-principal" type="button"
                                        disabled="@(_cargaOficinas.Activa || _oficinaNueva == Guid.Empty)" @onclick="AsignarOficinaAsync">
                                    Asignar oficina
                                </button>
                            </div>
                        }
                    </PermissionGate>
                </IndicadorDeCarga>
            </section>

            <section class="tarjeta">
                <h3>Corregir documento</h3>
                @if (!_usuario.CanCorrectDocument)
                {
                    <p class="texto-apoyo">
                        Esta persona también está en otra cooperativa. Su documento sólo lo puede corregir soporte
                        de la plataforma.
                    </p>
                }
                else
                {
                    <p class="texto-apoyo">
                        «Corrección» si se digitó mal; «Actualización» si el documento cambió (por ejemplo, de tarjeta de
                        identidad a cédula). La persona recibe un correo con su usuario nuevo.
                    </p>
                    <div class="rejilla-campos">
                        <label>Tipo
                            <select @bind="_c.Tipo">
                                @foreach (var t in TiposDeAcceso.Todos)
                                {
                                    <option value="@t.Codigo">@t.Nombre</option>
                                }
                            </select>
                        </label>
                        <label>Número <input @bind="_c.Numero" autocomplete="off" /></label>
                        <label>Confirme el número <input @bind="_c.Confirmacion" autocomplete="off" @onpaste:preventDefault="true" /></label>
                        <label>Motivo
                            <select @bind="_c.Motivo">
                                <option value="Correction">Corrección (se digitó mal)</option>
                                <option value="Update">Actualización (el documento cambió)</option>
                            </select>
                        </label>
                        <label>Notas <input @bind="_c.Notas" maxlength="500" /></label>
                    </div>
                    <div class="toolbar">
                        <button class="boton-principal" type="button" disabled="@_carga.Activa" @onclick="CorregirAsync">
                            Corregir documento
                        </button>
                    </div>
                }
            </section>

            <section class="tarjeta">
                <h3>Recuperar la contraseña</h3>
                <p class="texto-apoyo">
                    La persona recibe en su correo un enlace para fijar una contraseña nueva. Nadie más la conoce:
                    el administrador ya no la fija.
                </p>
                <button class="boton-principal" type="button" disabled="@_carga.Activa" @onclick="EnviarEnlaceAsync">
                    Enviar enlace de recuperación
                </button>
            </section>
        }
    </IndicadorDeCarga>

    <div class="actions">
        <button type="button" @onclick="Volver">Volver</button>
    </div>
</div>

@code {
    [Parameter] public Guid PublicId { get; set; }

    private readonly EstadoDeCarga _carga = new();
    private readonly EstadoDeCarga _cargaOficinas = new();
    private readonly EstadoDeCarga _cargaPersona = new();
    private string? _terminoPersona;
    private IReadOnlyList<PersonaBusquedaDto>? _personasEncontradas;
    private Detalle? _usuario;
    private Correccion _c = new();
    private string? _mensaje;
    private bool _esError;

    // Las oficinas de la cooperativa (Admin.Branches.View); sin ese permiso no hay selector para asignar.
    private List<OficinaDeLaCooperativa> _oficinas = new();
    private bool _oficinasVisibles;
    private Guid _oficinaNueva;
    private bool _nuevaPorDefecto;

    private List<OficinaDeLaCooperativa> OficinasPorAsignar =>
        _oficinas
            .Where(o => o.IsActive && _usuario?.Branches.Any(b => b.PublicId == o.PublicId) != true)
            .OrderBy(o => o.Code, StringComparer.Ordinal)
            .ToList();

    protected override async Task OnParametersSetAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        using var carga = _carga.Iniciar();
        try
        {
            _usuario = await Http.GetFromJsonAsync<Detalle>($"{AppSettings.GetApiBaseUrl()}/api/admin/users/{PublicId}");
        }
        catch (HttpRequestException ex)
        {
            Avisar(ex.Message, error: true);
        }
        try
        {
            _oficinas = await Http.GetListAsync<OficinaDeLaCooperativa>(
                $"{AppSettings.GetApiBaseUrl()}/api/admin/branches?page=1&pageSize=500");
            _oficinasVisibles = true;
        }
        catch (HttpRequestException)
        {
            _oficinas = new();
            _oficinasVisibles = false;
        }
    }

    private async Task RecargarUsuarioAsync() =>
        _usuario = await Http.GetFromJsonAsync<Detalle>($"{AppSettings.GetApiBaseUrl()}/api/admin/users/{PublicId}");

    private async Task TeclaPersonaAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await BuscarPersonaAsync();
    }

    private async Task BuscarPersonaAsync()
    {
        if (string.IsNullOrWhiteSpace(_terminoPersona)) return;
        using var carga = _cargaPersona.Iniciar();
        var r = await Personas.BuscarAsync(_terminoPersona.Trim());
        _personasEncontradas = r.IsSuccess ? r.Value : null;
        if (!r.IsSuccess)
            Avisar(r.StatusCode == 404 ? "Para buscar personas hace falta el permiso de ver Personas." : r.ErrorMessage ?? "No se pudo buscar.", error: true);
    }

    private async Task VincularPersonaAsync(Guid? persona, string? nombre)
    {
        using var carga = _cargaPersona.Iniciar();
        var resp = await Http.PutAsJsonAsync($"{AppSettings.GetApiBaseUrl()}/api/admin/users/{PublicId}/person", new { personPublicId = persona });
        if (resp.IsSuccessStatusCode)
        {
            Avisar(persona is null ? "Vínculo con la persona quitado." : $"Usuario vinculado a {nombre}.", error: false);
            _personasEncontradas = null;
            _terminoPersona = null;
            await RecargarUsuarioAsync();
        }
        else
        {
            Avisar(await ErrorAsync(resp), error: true);
        }
    }

    private async Task AsignarOficinaAsync()
    {
        if (_oficinaNueva == Guid.Empty) return;
        using var carga = _cargaOficinas.Iniciar();
        var oficina = _oficinas.FirstOrDefault(o => o.PublicId == _oficinaNueva);
        var resp = await Http.PostAsJsonAsync($"{AppSettings.GetApiBaseUrl()}/api/admin/users/{PublicId}/branches",
            new { branchPublicId = _oficinaNueva, isDefault = _nuevaPorDefecto });
        if (resp.IsSuccessStatusCode)
        {
            Avisar($"Oficina {oficina?.Name} asignada.", error: false);
            _oficinaNueva = Guid.Empty;
            _nuevaPorDefecto = false;
            await RecargarUsuarioAsync();
        }
        else
        {
            Avisar(await ErrorAsync(resp), error: true);
        }
    }

    private async Task MarcarPorDefectoAsync(Oficina o)
    {
        using var carga = _cargaOficinas.Iniciar();
        var resp = await Http.PutAsync($"{AppSettings.GetApiBaseUrl()}/api/admin/users/{PublicId}/branches/{o.PublicId}/default", null);
        if (resp.IsSuccessStatusCode)
        {
            Avisar($"{o.Name} es ahora la oficina por defecto.", error: false);
            await RecargarUsuarioAsync();
        }
        else
        {
            Avisar(await ErrorAsync(resp), error: true);
        }
    }

    private async Task QuitarOficinaAsync(Oficina o)
    {
        using var carga = _cargaOficinas.Iniciar();
        var resp = await Http.DeleteAsync($"{AppSettings.GetApiBaseUrl()}/api/admin/users/{PublicId}/branches/{o.PublicId}");
        if (resp.IsSuccessStatusCode)
        {
            Avisar(o.IsDefault
                ? $"Oficina {o.Name} quitada. Era la de por defecto: marcá otra."
                : $"Oficina {o.Name} quitada.", error: false);
            await RecargarUsuarioAsync();
        }
        else
        {
            Avisar(await ErrorAsync(resp), error: true);
        }
    }

    private async Task CorregirAsync()
    {
        using var carga = _carga.Iniciar();
        var resp = await Http.PostAsJsonAsync($"{AppSettings.GetApiBaseUrl()}/api/admin/users/{PublicId}/correct-document", new
        {
            documentType = _c.Tipo,
            documentNumber = _c.Numero,
            documentNumberConfirmation = _c.Confirmacion,
            reason = _c.Motivo,
            notes = _c.Notas,
        });
        if (resp.IsSuccessStatusCode)
        {
            var r = await resp.Content.ReadFromJsonAsync<Corregido>();
            Avisar($"Documento corregido. El usuario ahora es {r?.DocumentUsername}.", error: false);
            _c = new();
            _usuario = await Http.GetFromJsonAsync<Detalle>($"{AppSettings.GetApiBaseUrl()}/api/admin/users/{PublicId}");
        }
        else
        {
            Avisar(await ErrorAsync(resp), error: true);
        }
    }

    private async Task EnviarEnlaceAsync()
    {
        using var carga = _carga.Iniciar();
        var resp = await Http.PostAsync($"{AppSettings.GetApiBaseUrl()}/api/admin/users/{PublicId}/send-recovery-link", null);
        if (resp.IsSuccessStatusCode) Avisar($"Se envió el enlace de recuperación a {_usuario?.Email}.", error: false);
        else Avisar(await ErrorAsync(resp), error: true);
    }

    private static async Task<string> ErrorAsync(HttpResponseMessage resp)
    {
        try
        {
            var sobre = await resp.Content.ReadFromJsonAsync<Sobre>();
            if (!string.IsNullOrWhiteSpace(sobre?.Message)) return sobre.Message;
        }
        catch (System.Text.Json.JsonException)
        {
            // El cuerpo no era el sobre de error: se informa el estado HTTP.
            return $"No se pudo completar ({(int)resp.StatusCode}).";
        }
        return $"No se pudo completar ({(int)resp.StatusCode}).";
    }

    private void Avisar(string texto, bool error) { _mensaje = texto; _esError = error; }

    private void Volver() => Nav.NavigateTo("/security/users");

    private sealed record Detalle(Guid PublicId, string Username, string? Email, string? DocumentUsername, bool CanCorrectDocument,
        IReadOnlyList<Oficina> Branches, int? PersonId = null, Guid? PersonPublicId = null, string? PersonName = null, string? PersonDocument = null);
    private sealed record Oficina(Guid PublicId, string Code, string Name, bool IsDefault, string? AgencyName);
    private sealed record Corregido(string DocumentUsername);
    private sealed record Sobre(string? Code, string? Message);

    private sealed class Correccion
    {
        public string Tipo { get; set; } = "CC";
        public string? Numero { get; set; }
        public string? Confirmacion { get; set; }
        public string Motivo { get; set; } = "Correction";
        public string? Notas { get; set; }
    }
}
