@page "/security/users"
@using IngenIA365ERP.Shared.Configuration
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Nav
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Usuarios — IngenIA365ERP</PageTitle>

<div class="admin-page">
    <div class="page-header">
        <h1>Usuarios</h1>
    </div>

    <div class="toolbar">
        <input type="search" placeholder="Buscar usuario o correo…" @bind="_search" @bind:event="oninput" />
        <label><input type="checkbox" @bind="_includeDisabled" /> incluir deshabilitados</label>
        <button class="primary" @onclick="InvitarAsync">Invitar persona</button>
        <button @onclick="LoadAsync">Refrescar</button>
    </div>

    <IndicadorDeCarga Cargando="@_loading">
    @if (_loading) { <p>Cargando…</p> }
    else if (_error is not null) { <p class="error aviso aviso-error" role="alert">@_error</p> }
    else if (_items.Count == 0) { <p>Sin resultados.</p> }
    else
    {
        <table class="data-grid">
            <thead>
                <tr>
                    <th>Usuario</th><th>Email</th><th>Estado</th><th>MFA</th>
                    <th>Bloqueado</th><th>Roles</th><th>Último login</th><th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in _items)
                {
                    <tr>
                        <td>@u.Username</td>
                        <td>@u.Email</td>
                        <td>@(u.IsActive ? "Activo" : "Inactivo")</td>
                        @* «—» cuando no se sabe, y NO «No»: estas columnas se leian
                           de SEC_Users, donde ya no las escribe nadie, y afirmaban
                           que nadie tenia segundo factor ni estaba bloqueado. *@
                        <td>@(u.IsMfaEnabled is null ? "—" : u.IsMfaEnabled.Value ? "Sí" : "No")</td>
                        <td>@(u.IsLocked is null ? "—" : u.IsLocked.Value ? "Sí" : "")</td>
                        <td>@string.Join(", ", u.RoleCodes)</td>
                        <td>@u.LastLoginAt?.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <div class="acciones">
                                <button @onclick="() => Edit(u.PublicId)">Editar</button>
                                <button @onclick="() => Roles(u.PublicId)">Roles</button>
                                @* Feature 012, T433: la pestaña «Alcance comercial» (bodegas que ve y opera) vive en /inventario/alcances. *@
                                <PermissionGate Required="Inventory.Scopes.Manage">
                                    <button @onclick="() => Alcance(u.PublicId)">Alcance comercial</button>
                                </PermissionGate>
                                @if (u.IsLocked == true)
                                {
                                    <button @onclick="() => UnlockAsync(u.PublicId)">Desbloquear</button>
                                }
                                @if (u.IsActive)
                                {
                                    <button @onclick="() => DisableAsync(u.PublicId)">Deshabilitar</button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    </IndicadorDeCarga>
</div>

@code {
    private List<UserItem> _items = new();
    private string _search = string.Empty;
    private bool _includeDisabled;
    private bool _loading;
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthState { get; set; }

    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true; _error = null;
        try
        {
            var url = $"{AppSettings.GetApiBaseUrl()}/api/admin/users?search={Uri.EscapeDataString(_search)}&includeDisabled={_includeDisabled}";
            var resp = await Http.GetAsync(url);
            if (!resp.IsSuccessStatusCode)
            {
                _error = $"Error {(int)resp.StatusCode}";
                return;
            }
            var page = await resp.Content.ReadFromJsonAsync<PagedResult<UserItem>>();
            _items = page?.Items?.ToList() ?? new();
        }
        finally { _loading = false; }
    }

    /// <summary>
    /// Se invita, no se crea.
    ///
    /// <para>
    /// El botón anterior daba de alta una fila en SEC_Users y nada más. Pero el
    /// acceso valida contra la identidad central, que ese camino no tocaba: la
    /// persona aparecía en la pantalla, se le podían asignar roles, y no podía
    /// entrar. La invitación sí crea las dos mitades.
    /// </para>
    /// </summary>
    private async Task InvitarAsync()
    {
        var estado = await AuthState!;
        var cooperativa = estado.User.FindFirst("active_tenant_id")?.Value;

        if (string.IsNullOrWhiteSpace(cooperativa))
        {
            _error = "Elegí una cooperativa antes de invitar a alguien.";
            return;
        }

        Nav.NavigateTo($"/admin/tenants/{cooperativa}/invitaciones");
    }
    private void Edit(Guid id) => Nav.NavigateTo($"/security/users/{id}");
    private void Roles(Guid id) => Nav.NavigateTo($"/security/users/{id}/roles");
    private void Alcance(Guid id) => Nav.NavigateTo($"/inventario/alcances?usuario={id}");

    private async Task UnlockAsync(Guid id) => await PostAsync($"/api/admin/users/{id}/unlock");
    private async Task DisableAsync(Guid id) => await PostAsync($"/api/admin/users/{id}/disable");

    private async Task PostAsync(string path)
    {
        var resp = await Http.PostAsync($"{AppSettings.GetApiBaseUrl()}{path}", null);
        if (resp.IsSuccessStatusCode) await LoadAsync();
        else _error = await resp.Content.ReadAsStringAsync();
    }

    public sealed record UserItem(
        Guid PublicId, string Username, string? Email,
        bool IsActive, bool? IsMfaEnabled, bool? IsLocked,
        DateTime? LastLoginAt, IReadOnlyList<string> RoleCodes);

    public sealed record PagedResult<T>(IReadOnlyList<T> Items, int Page, int PageSize, long TotalCount);
}
