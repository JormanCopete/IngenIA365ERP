@page "/security/users"
@using IngenIA365ERP.Shared.Configuration
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Nav
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Usuarios — IngenIA365ERP</PageTitle>

<div class="admin-page">
    <div class="page-header">
        <h1>Usuarios</h1>
    </div>

    @* 2026-11-19 (pedido del dueño): buscar y «Incluir deshabilitados» consultan de verdad (antes cambiaban el campo y no
       volvían a pedir la lista); deshabilitar pide confirmación; cada botón sale según el permiso de quien entra. *@
    <p class="texto-apoyo">
        Cada persona entra con su usuario y su segundo factor, y puede hacer lo que permitan sus roles. Las personas nuevas se
        invitan; los permisos se reparten en <a href="/security/roles">Roles y permisos</a>.
    </p>
    <div class="toolbar">
        <input type="search" class="e-input" placeholder="Buscar usuario o correo y Enter…" aria-label="Buscar usuario" @bind="_search" @bind:after="LoadAsync" />
        <label class="campo-check"><input type="checkbox" @bind="_includeDisabled" @bind:after="LoadAsync" /> Incluir deshabilitados</label>
        <button class="boton-principal" @onclick="InvitarAsync">Invitar persona</button>
        <button class="boton boton-secundario" @onclick="LoadAsync">Refrescar</button>
    </div>

    @* 2026-11-15: cómo sale el usuario en los documentos impresos (parámetro de la cooperativa). *@
    <IngenIA365ERP.Shared.Components.Identidad.UsuarioEnImpresosAjuste />

    <IndicadorDeCarga Cargando="@_loading">
    @if (_loading) { }
    else if (_error is not null) { <p class="error aviso aviso-error" role="alert">@_error</p> }
    else if (_items.Count == 0) { <p>Sin resultados.</p> }
    else
    {
        <table class="data-grid">
            <thead>
                <tr>
                    <th>Usuario</th><th>Email</th><th>Usuario de documento</th><th>Cargo</th><th>Estado</th><th>MFA</th>
                    <th>Bloqueado</th><th>Roles</th><th>Último login</th><th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in _items)
                {
                    <tr>
                        <td>@u.Username</td>
                        <td>@u.Email</td>
                        @* Feature 017 (D-08): si la copia de esta cooperativa no coincide con la identidad central,
                           se marca; se pone al día sola en el siguiente ingreso o corrección. *@
                        <td>
                            @(u.DocumentUsername ?? "—")
                            @if (u.DocumentMismatch)
                            {
                                <span class="aviso-alerta" title="La copia de esta cooperativa no coincide con la identidad central"> ⚠ diferencia</span>
                            }
                        </td>
                        <td>@(u.Position ?? "—")</td>
                        <td>@(u.IsActive ? "Activo" : "Inactivo")</td>
                        @* «—» cuando no se sabe, y NO «No»: estas columnas se leian
                           de SEC_Users, donde ya no las escribe nadie, y afirmaban
                           que nadie tenia segundo factor ni estaba bloqueado. *@
                        <td>@(u.IsMfaEnabled is null ? "—" : u.IsMfaEnabled.Value ? "Sí" : "No")</td>
                        <td>@(u.IsLocked is null ? "—" : u.IsLocked.Value ? "Sí" : "")</td>
                        <td>@string.Join(", ", u.RoleCodes)</td>
                        <td>@u.LastLoginAt?.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <div class="acciones">
                                <button class="boton boton-secundario" @onclick="() => Edit(u.PublicId)">Editar</button>
                                <button class="boton boton-secundario" @onclick="() => Roles(u.PublicId)">Roles</button>
                                @* Feature 012, T433: la pestaña «Alcance comercial» (bodegas que ve y opera) vive en /inventario/alcances. *@
                                <PermissionGate Required="Inventory.Scopes.Manage">
                                    <button class="boton boton-secundario" @onclick="() => Alcance(u.PublicId)">Alcance comercial</button>
                                </PermissionGate>
                                @* Feature 013, T0322: la pestaña «Alcance de Cartera» (oficinas y líneas de crédito) vive en /cartera/alcances. *@
                                <PermissionGate Required="Lending.Scopes.Manage">
                                    <button class="boton boton-secundario" @onclick="() => AlcanceDeCartera(u.PublicId)">Alcance de Cartera</button>
                                </PermissionGate>
                                @if (u.IsLocked == true)
                                {
                                    <PermissionGate Required="Security.Users.Unlock">
                                        <button class="boton boton-secundario" @onclick="() => UnlockAsync(u.PublicId)">Desbloquear</button>
                                    </PermissionGate>
                                }
                                @if (u.IsActive)
                                {
                                    var usuario = u;
                                    <PermissionGate Required="Security.Users.Disable">
                                        <button class="boton boton-secundario" @onclick="() => PedirDeshabilitar(usuario)">Deshabilitar</button>
                                    </PermissionGate>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    </IndicadorDeCarga>
</div>

<ConfirmDialog @bind-Visible="_confirmarDeshabilitar" Title="Deshabilitar usuario" ConfirmText="Deshabilitar" OnConfirm="DisableAsync"
               Message="@($"¿Deshabilitar a {_aDeshabilitar?.Username}? No podrá entrar a esta cooperativa hasta que se restaure. Sus registros y su historia se conservan.")" />

@code {
    private List<UserItem> _items = new();
    private string _search = string.Empty;
    private bool _includeDisabled;
    private bool _loading;
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthState { get; set; }

    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true; _error = null;
        try
        {
            var url = $"{AppSettings.GetApiBaseUrl()}/api/admin/users?search={Uri.EscapeDataString(_search)}&includeDisabled={_includeDisabled}";
            var resp = await Http.GetAsync(url);
            if (!resp.IsSuccessStatusCode)
            {
                _error = await NotificationServiceExtensions.MensajeDeErrorAsync(resp, "No se pudieron leer los usuarios.");
                return;
            }
            var page = await resp.Content.ReadFromJsonAsync<PagedResult<UserItem>>();
            _items = page?.Items?.ToList() ?? new();
        }
        finally { _loading = false; }
    }

    /// <summary>
    /// Se invita, no se crea.
    ///
    /// <para>
    /// El botón anterior daba de alta una fila en SEC_Users y nada más. Pero el
    /// acceso valida contra la identidad central, que ese camino no tocaba: la
    /// persona aparecía en la pantalla, se le podían asignar roles, y no podía
    /// entrar. La invitación sí crea las dos mitades.
    /// </para>
    /// </summary>
    private async Task InvitarAsync()
    {
        var estado = await AuthState!;
        var cooperativa = estado.User.FindFirst("active_tenant_id")?.Value;

        if (string.IsNullOrWhiteSpace(cooperativa))
        {
            _error = "Elegí una cooperativa antes de invitar a alguien.";
            return;
        }

        Nav.NavigateTo($"/admin/tenants/{cooperativa}/invitaciones");
    }
    private void Edit(Guid id) => Nav.NavigateTo($"/security/users/{id}");
    private void Roles(Guid id) => Nav.NavigateTo($"/security/users/{id}/roles");
    private void Alcance(Guid id) => Nav.NavigateTo($"/inventario/alcances?usuario={id}");
    private void AlcanceDeCartera(Guid id) => Nav.NavigateTo($"/cartera/alcances?usuario={id}");

    private async Task UnlockAsync(Guid id) => await PostAsync($"/api/admin/users/{id}/unlock");
    private bool _confirmarDeshabilitar;
    private UserItem? _aDeshabilitar;

    private void PedirDeshabilitar(UserItem u)
    {
        _aDeshabilitar = u;
        _confirmarDeshabilitar = true;
    }

    private async Task DisableAsync()
    {
        if (_aDeshabilitar is null) return;
        var id = _aDeshabilitar.PublicId;
        _aDeshabilitar = null;
        await PostAsync($"/api/admin/users/{id}/disable");
    }

    private async Task PostAsync(string path)
    {
        var resp = await Http.PostAsync($"{AppSettings.GetApiBaseUrl()}{path}", null);
        if (resp.IsSuccessStatusCode) await LoadAsync();
        else _error = await NotificationServiceExtensions.MensajeDeErrorAsync(resp, "No se pudo completar la acción.");
    }

    public sealed record UserItem(
        Guid PublicId, string Username, string? Email,
        bool IsActive, bool? IsMfaEnabled, bool? IsLocked,
        DateTime? LastLoginAt, IReadOnlyList<string> RoleCodes,
        string? DocumentUsername = null, bool DocumentMismatch = false, bool CanCorrectDocument = false,
        string? Position = null);

    public sealed record PagedResult<T>(IReadOnlyList<T> Items, int Page, int PageSize, long TotalCount);
}
