@page "/auth/reset-password"
@layout MinimalLayout
@using System.ComponentModel.DataAnnotations
@using IngenIA365ERP.Shared.Services.Security
@inject ProfileClient ProfileClient
@inject NavigationManager Nav

@*
    T079l — Consume el token del correo y establece la nueva contraseña.
    Al éxito redirige a /security/login?reset=1 con banner informativo.
*@

<PageTitle>Restablecer contraseña — IngenIA365ERP</PageTitle>

<div class="auth-card" style="max-width: 480px; margin: calc(var(--gap-xl) * 1.5) auto;">
    @if (string.IsNullOrWhiteSpace(Token))
    {
        <h1>Enlace inválido</h1>
        <p>El enlace no incluye un token. Solicita un nuevo correo.</p>
        <p><NavLink href="/auth/forgot-password">Solicitar de nuevo</NavLink></p>
    }
    else
    {
        <h1>Crea tu nueva contraseña</h1>
        <p>Elige una contraseña fuerte. Mínimo 12 caracteres.</p>

        <EditForm Model="@_model" OnValidSubmit="@SubmitAsync" FormName="resetPassword">
            <DataAnnotationsValidator />

            <label>Nueva contraseña</label>
            <InputText
                @bind-Value="_model.NewPassword"
                type="password"
                autocomplete="new-password"
                @oninput="OnPasswordInput" />
            <ValidationMessage For="@(() => _model.NewPassword)" />
            <small style="color: @PasswordMeterColor">@PasswordMeterLabel</small>

            <label>Repite la nueva contraseña</label>
            <InputText
                @bind-Value="_model.NewPasswordRepeat"
                type="password"
                autocomplete="new-password" />
            <ValidationMessage For="@(() => _model.NewPasswordRepeat)" />

            <button type="submit" disabled="@_busy">
                @(_busy ? "Aplicando..." : "Restablecer contraseña")
            </button>
        </EditForm>

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="error" role="alert" style="margin-top: var(--gap-md);">@_error</p>
        }
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private readonly ResetInput _model = new();
    private bool _busy;
    private string? _error;

    private string PasswordMeterLabel { get; set; } = "Mínimo 12 caracteres.";
    private string PasswordMeterColor { get; set; } = "var(--texto-tenue)";

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(Token)) return;
        _busy = true;
        _error = null;
        try
        {
            var result = await ProfileClient.ResetPasswordAsync(Token, _model.NewPassword!);
            if (result.IsSuccess)
            {
                Nav.NavigateTo("/security/login?reset=1", forceLoad: true);
                return;
            }
            _error = MapError(result.ErrorCode, result.ErrorMessage);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private static string MapError(string? code, string? message) => code switch
    {
        "Profile.PasswordReset.Invalid" =>
            "El enlace no es válido. Solicita uno nuevo.",
        "Profile.PasswordReset.Expired" =>
            "El enlace expiró. Solicita uno nuevo.",
        "Profile.PasswordReset.AlreadyConsumed" =>
            "Este enlace ya fue usado. Solicita uno nuevo si lo necesitas.",
        "Identity.Password.Pwned" =>
            "La contraseña aparece en filtraciones públicas; elige otra.",
        _ => message ?? "No se pudo restablecer la contraseña.",
    };

    private void OnPasswordInput(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        var pwd = e.Value as string ?? string.Empty;
        (PasswordMeterLabel, PasswordMeterColor) = pwd.Length switch
        {
            < 12 => ("Demasiado corta — mínimo 12 caracteres.", "var(--peligro-texto)"),
            < 16 => ("Aceptable — considera 16+ caracteres.", "var(--alerta-texto)"),
            _ => ("Buena longitud.", "var(--exito-texto)"),
        };
    }

    public sealed class ResetInput
    {
        [Required(ErrorMessage = "La contraseña es obligatoria.")]
        [MinLength(12, ErrorMessage = "Mínimo 12 caracteres.")]
        public string? NewPassword { get; set; }

        [Required(ErrorMessage = "Repite la contraseña.")]
        [Compare(nameof(NewPassword), ErrorMessage = "Las contraseñas no coinciden.")]
        public string? NewPasswordRepeat { get; set; }
    }
}
