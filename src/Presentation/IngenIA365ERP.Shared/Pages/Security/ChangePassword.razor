@page "/profile/password"
@layout MinimalLayout
@using System.ComponentModel.DataAnnotations
@using IngenIA365ERP.Shared.Services.Security
@inject ProfileClient ProfileClient
@inject NavigationManager Nav

@*
    T079l — Cambio voluntario de contraseña. Tras éxito muestra confirmación
    + advertencia de que se invalidaron las sesiones (security stamp regenerado).
*@

<PageTitle>Cambiar contraseña — IngenIA365ERP</PageTitle>

<div class="auth-card" style="max-width: 480px; margin: calc(var(--gap-xl) * 1.5) auto;">
    @if (_done)
    {
        <h1>Contraseña actualizada</h1>
        <p style="margin-top: var(--pad-lg);">
            Tu contraseña se cambió correctamente. Por seguridad, se cerraron
            tus sesiones en otros dispositivos — vuelve a iniciar sesión allí
            cuando lo necesites.
        </p>
        <NavLink href="/" class="btn">Volver al inicio</NavLink>
    }
    else
    {
        <h1>Cambiar contraseña</h1>

        <div class="aviso aviso-alerta" style="margin: var(--pad-lg) 0;">
            <strong>Importante:</strong> esto cerrará tus sesiones activas en
            otros dispositivos y afectará el acceso a todas tus empresas.
        </div>

        <DirtyTrackingEditForm Model="@_model" OnValidSubmit="@SubmitAsync" FormName="changePassword">
            <DataAnnotationsValidator />

            <label>Contraseña actual</label>
            <InputText
                @bind-Value="_model.CurrentPassword"
                type="password"
                autocomplete="current-password" />
            <ValidationMessage For="@(() => _model.CurrentPassword)" />

            <label>Nueva contraseña</label>
            <InputText
                @bind-Value="_model.NewPassword"
                type="password"
                autocomplete="new-password"
                @oninput="OnPasswordInput" />
            <ValidationMessage For="@(() => _model.NewPassword)" />
            <small style="color: @PasswordMeterColor">@PasswordMeterLabel</small>

            <label>Repite la nueva</label>
            <InputText
                @bind-Value="_model.NewPasswordRepeat"
                type="password"
                autocomplete="new-password" />
            <ValidationMessage For="@(() => _model.NewPasswordRepeat)" />

            <button type="submit" disabled="@_busy">
                @(_busy ? "Aplicando..." : "Cambiar contraseña")
            </button>
        </DirtyTrackingEditForm>

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="error" role="alert" style="margin-top: var(--gap-md);">@_error</p>
        }
    }
</div>

@code {
    private readonly ChangeInput _model = new();
    private bool _busy;
    private bool _done;
    private string? _error;

    private string PasswordMeterLabel { get; set; } = "Mínimo 12 caracteres.";
    private string PasswordMeterColor { get; set; } = "var(--texto-tenue)";

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await ProfileClient.ChangePasswordAsync(
                _model.CurrentPassword!, _model.NewPassword!);
            if (result.IsSuccess)
            {
                _done = true;
                return;
            }
            _error = MapError(result.ErrorCode, result.ErrorMessage);
        }
        finally
        {
            _busy = false;
        }
    }

    private static string MapError(string? code, string? message) => code switch
    {
        "Identity.PasswordMismatch" or "Identity.InvalidCredentials" =>
            "La contraseña actual no es correcta.",
        "Identity.Password.Pwned" =>
            "La nueva contraseña aparece en filtraciones públicas; elige otra.",
        "Profile.Password.SameAsCurrent" =>
            "La nueva contraseña debe ser distinta de la actual.",
        _ => message ?? "No se pudo cambiar la contraseña.",
    };

    private void OnPasswordInput(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        var pwd = e.Value as string ?? string.Empty;
        (PasswordMeterLabel, PasswordMeterColor) = pwd.Length switch
        {
            < 12 => ("Demasiado corta — mínimo 12 caracteres.", "var(--peligro-texto)"),
            < 16 => ("Aceptable — considera 16+ caracteres.", "var(--alerta-texto)"),
            _ => ("Buena longitud.", "var(--exito-texto)"),
        };
    }

    public sealed class ChangeInput
    {
        [Required(ErrorMessage = "La contraseña actual es obligatoria.")]
        public string? CurrentPassword { get; set; }

        [Required(ErrorMessage = "La nueva contraseña es obligatoria.")]
        [MinLength(12, ErrorMessage = "Mínimo 12 caracteres.")]
        public string? NewPassword { get; set; }

        [Required(ErrorMessage = "Repite la nueva contraseña.")]
        [Compare(nameof(NewPassword), ErrorMessage = "Las contraseñas no coinciden.")]
        public string? NewPasswordRepeat { get; set; }
    }
}
