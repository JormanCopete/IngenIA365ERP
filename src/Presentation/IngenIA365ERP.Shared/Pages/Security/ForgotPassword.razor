@page "/auth/forgot-password"
@layout MinimalLayout
@using System.ComponentModel.DataAnnotations
@using IngenIA365ERP.Shared.Services.Security
@inject ProfileClient ProfileClient
@inject NavigationManager Nav

@*
    T079l — Olvidé mi contraseña (público). Tras submit muestra SIEMPRE
    el mismo mensaje genérico para no revelar si el email existe (FR-041).
*@

<PageTitle>Recuperar contraseña — IngenIA365ERP</PageTitle>

<div class="auth-card" style="max-width: 420px; margin: calc(var(--gap-xl) * 1.5) auto;">
    @if (_sent)
    {
        <h1>Revisa tu correo</h1>
        <p style="margin-top: var(--pad-lg);">
            Si <strong>@_model.Email</strong> corresponde a una cuenta, te enviaremos a su correo un
            enlace para restablecer tu contraseña. Revisa también la carpeta
            de spam.
        </p>
        <p style="margin-top: var(--pad-xl); font-size: var(--texto-sm);">
            <NavLink href="/security/login">Volver al inicio de sesión</NavLink>
        </p>
    }
    else
    {
        <h1>Recuperar contraseña</h1>
        <p>Ingresa tu correo o tu usuario y te enviaremos las instrucciones a tu correo.</p>

        <EditForm Model="@_model" OnValidSubmit="@SubmitAsync" FormName="forgotPassword">
            <DataAnnotationsValidator />

            <label>Correo o usuario</label>
            <InputText
                @bind-Value="_model.Email"
                autocomplete="username" />
            <ValidationMessage For="@(() => _model.Email)" />

            <button type="submit" disabled="@_busy">
                @(_busy ? "Enviando..." : "Enviar enlace")
            </button>
        </EditForm>

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="error" role="alert" style="margin-top: var(--gap-md);">@_error</p>
        }

        <p style="margin-top: var(--pad-xl); font-size: var(--texto-sm);">
            <NavLink href="/security/login">Volver al inicio</NavLink>
        </p>
    }
</div>

@code {
    private readonly ForgotInput _model = new();
    private bool _busy;
    private bool _sent;
    private string? _error;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            // El backend SIEMPRE responde éxito; mostramos el banner sin
            // distinguir si la cuenta existe o no.
            await ProfileClient.ForgotPasswordAsync(_model.Email!);
            _sent = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    public sealed class ForgotInput
    {
        // Feature 017 (T081): «Correo o usuario». La validación de formato la hace el servidor (sólo si lleva @).
        [Required(ErrorMessage = "Digita tu correo o tu usuario.")]
        public string? Email { get; set; }
    }
}
