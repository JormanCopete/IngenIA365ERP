@page "/auth/forgot-password"
@layout MinimalLayout
@using System.ComponentModel.DataAnnotations
@using IngenIA365ERP.Shared.Services.Security
@inject ProfileClient ProfileClient
@inject NavigationManager Nav

@*
    T079l — Olvidé mi contraseña (público). Tras submit muestra SIEMPRE
    el mismo mensaje genérico para no revelar si el email existe (FR-041).
*@

<PageTitle>Recuperar contraseña — IngenIA365ERP</PageTitle>

<div class="auth-card" style="max-width: 420px; margin: 48px auto;">
    @if (_sent)
    {
        <h1>Revisa tu correo</h1>
        <p style="margin-top: 16px;">
            Si <strong>@_model.Email</strong> tiene una cuenta, te enviaremos un
            enlace para restablecer tu contraseña. Revisa también la carpeta
            de spam.
        </p>
        <p style="margin-top: 24px; font-size: 13px;">
            <NavLink href="/security/login">Volver al inicio de sesión</NavLink>
        </p>
    }
    else
    {
        <h1>Recuperar contraseña</h1>
        <p>Ingresa tu correo y te enviaremos las instrucciones.</p>

        <EditForm Model="@_model" OnValidSubmit="@SubmitAsync" FormName="forgotPassword">
            <DataAnnotationsValidator />

            <label>Correo</label>
            <InputText
                @bind-Value="_model.Email"
                type="email"
                autocomplete="username" />
            <ValidationMessage For="@(() => _model.Email)" />

            <button type="submit" disabled="@_busy" style="margin-top: 16px;">
                @(_busy ? "Enviando..." : "Enviar enlace")
            </button>
        </EditForm>

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="error" role="alert" style="margin-top: 12px;">@_error</p>
        }

        <p style="margin-top: 24px; font-size: 13px;">
            <NavLink href="/security/login">Volver al inicio</NavLink>
        </p>
    }
</div>

@code {
    private readonly ForgotInput _model = new();
    private bool _busy;
    private bool _sent;
    private string? _error;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            // El backend SIEMPRE responde éxito; mostramos el banner sin
            // distinguir si la cuenta existe o no.
            await ProfileClient.ForgotPasswordAsync(_model.Email!);
            _sent = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    public sealed class ForgotInput
    {
        [Required(ErrorMessage = "El correo es obligatorio.")]
        [EmailAddress(ErrorMessage = "Correo no válido.")]
        public string? Email { get; set; }
    }
}
