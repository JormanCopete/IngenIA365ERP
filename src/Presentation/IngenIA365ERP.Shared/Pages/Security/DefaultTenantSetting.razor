@page "/profile/default-tenant"
@layout MinimalLayout
@using IngenIA365ERP.Shared.Services.Security
@inject TenantSessionClient SessionClient
@inject NavigationManager Nav

@*
    T090 (US3) — Configurar empresa por defecto. La preferencia se aplica
    en el próximo login: si está válida, el usuario entra directo a esa
    empresa sin pasar por TenantSelection.
*@

<PageTitle>Empresa por defecto — IngenIA365ERP</PageTitle>

<div class="auth-card" style="max-width: 520px; margin: calc(var(--gap-xl) * 1.5) auto;">
    <h1>Empresa por defecto</h1>
    <p>
        Elige a qué empresa entrarás automáticamente al iniciar sesión.
        Puedes cambiarla o quitarla cuando quieras.
    </p>

    @if (_loading)
    {
        <p>Cargando...</p>
    }
    else if (_tenants is null || _tenants.Count == 0)
    {
        <p class="muted">No tienes membresías activas todavía.</p>
    }
    else
    {
        <div class="lista-empresas">
            @foreach (var t in _tenants)
            {
                <div class="empresa-fila">
                    <div class="empresa-nombre">
                        <strong>@t.TenantName</strong>
                        @if (t.IsDefault)
                        {
                            <span class="pastilla pastilla-exito">Default</span>
                        }
                    </div>
                    @if (t.IsDefault)
                    {
                        <button @onclick="ClearDefaultAsync" disabled="@_busy">Quitar default</button>
                    }
                    else
                    {
                        <button @onclick="() => SetDefaultAsync(t.TenantPublicId)" disabled="@_busy">
                            Establecer
                        </button>
                    }
                </div>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(_message))
    {
        <p class="aviso aviso-ok" role="status" style="margin-top: var(--pad-lg);">@_message</p>
    }
    @if (!string.IsNullOrEmpty(_error))
    {
        <p class="error" role="alert" style="margin-top: var(--gap-md);">@_error</p>
    }
</div>

@code {
    private IReadOnlyList<ActiveTenantInfo>? _tenants;
    private bool _loading = true;
    private bool _busy;
    private string? _message;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var result = await SessionClient.GetActiveTenantsAsync();
            if (result.IsSuccess) _tenants = result.Value;
            else _error = result.ErrorMessage ?? "No se pudo cargar.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SetDefaultAsync(Guid tenantPublicId)
    {
        _busy = true; _message = null; _error = null;
        try
        {
            var result = await SessionClient.SetDefaultAsync(tenantPublicId);
            if (result.IsSuccess) _message = "Default actualizado.";
            else _error = result.ErrorMessage ?? "No se pudo guardar.";
            await LoadAsync();
        }
        finally { _busy = false; }
    }

    private async Task ClearDefaultAsync()
    {
        _busy = true; _message = null; _error = null;
        try
        {
            var result = await SessionClient.SetDefaultAsync(null);
            if (result.IsSuccess) _message = "Default eliminado.";
            else _error = result.ErrorMessage ?? "No se pudo guardar.";
            await LoadAsync();
        }
        finally { _busy = false; }
    }
}
