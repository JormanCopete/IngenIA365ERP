@page "/security/roles/new"
@page "/security/roles/{PublicId:guid}"
@using IngenIA365ERP.Shared.Configuration
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>@(_isNew ? "Nuevo rol" : "Editar rol") — IngenIA365ERP</PageTitle>

<div class="admin-page">
    <div class="page-header">
        <h1>@(_isNew ? "Crear rol" : "Editar rol")</h1>
    </div>

    <EditForm Model="_model" OnValidSubmit="SaveAsync" FormName="role-edit">
        <DataAnnotationsValidator />

        <div class="row toolbar">
            @if (_isNew)
            {
                <label>Código<InputText @bind-Value="_model.Code" /></label>
            }
            else
            {
                <label>Código <code>@_model.Code</code></label>
            }
            <label>Nombre<InputText @bind-Value="_model.Name" /></label>
        </div>
        <div class="row toolbar">
            <label>Descripción<InputText @bind-Value="_model.Description" /></label>
            @if (!_isNew)
            {
                <label class="campo-check"><InputCheckbox @bind-Value="_model.IsAssignable" disabled="@_isBuiltIn" /> Asignable</label>
            }
        </div>

        <h2>Permisos</h2>
        <PermissionMatrix
            SelectedPermissionPublicIds="@_model.PermissionPublicIds"
            SelectedPermissionPublicIdsChanged="OnPermissionsChanged" />

        <ValidationSummary />
        @if (_error is not null) { <p class="error aviso aviso-error" role="alert">@_error</p> }

        <div class="actions">
            <button type="submit" class="primary" disabled="@_saving">Guardar</button>
            <button type="button" @onclick="Cancel">Cancelar</button>
        </div>
    </EditForm>
</div>

@code {
    [Parameter] public Guid? PublicId { get; set; }
    private bool _isNew => PublicId is null;
    private bool _isBuiltIn;
    private readonly Model _model = new();
    private bool _saving;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        if (_isNew) return;
        var resp = await Http.GetAsync($"{AppSettings.GetApiBaseUrl()}/api/admin/roles/{PublicId}");
        if (!resp.IsSuccessStatusCode)
        {
            _error = $"Error {(int)resp.StatusCode}";
            return;
        }
        var dto = await resp.Content.ReadFromJsonAsync<RoleDto>();
        if (dto is null) return;
        _model.Code = dto.Code;
        _model.Name = dto.Name;
        _model.Description = dto.Description;
        _model.IsAssignable = dto.IsAssignable;
        _model.PermissionPublicIds = dto.Permissions.Select(p => p.PublicId).ToList();
        _isBuiltIn = dto.IsBuiltIn;
    }

    private void OnPermissionsChanged(List<Guid> next) => _model.PermissionPublicIds = next;

    private async Task SaveAsync()
    {
        _saving = true; _error = null;
        try
        {
            var url = $"{AppSettings.GetApiBaseUrl()}/api/admin/roles";
            HttpResponseMessage resp = _isNew
                ? await Http.PostAsJsonAsync(url, new
                {
                    code = _model.Code,
                    name = _model.Name,
                    description = _model.Description,
                    permissionPublicIds = _model.PermissionPublicIds
                })
                : await Http.PutAsJsonAsync($"{url}/{PublicId}", new
                {
                    name = _model.Name,
                    description = _model.Description,
                    isAssignable = _model.IsAssignable,
                    permissionPublicIds = _model.PermissionPublicIds
                });

            if (resp.IsSuccessStatusCode) Nav.NavigateTo("/security/roles");
            else _error = await resp.Content.ReadAsStringAsync();
        }
        finally { _saving = false; }
    }

    private void Cancel() => Nav.NavigateTo("/security/roles");

    public sealed class Model
    {
        [Required, MaxLength(40)] public string Code { get; set; } = string.Empty;
        [Required, MaxLength(100)] public string Name { get; set; } = string.Empty;
        [MaxLength(500)] public string? Description { get; set; }
        public bool IsAssignable { get; set; } = true;
        public List<Guid> PermissionPublicIds { get; set; } = new();
    }

    public sealed record RoleDto(
        Guid PublicId, string Code, string Name, string? Description,
        bool IsBuiltIn, bool IsAssignable, bool IsActive,
        IReadOnlyList<RolePermissionDto> Permissions);

    public sealed record RolePermissionDto(Guid PublicId, string Code);
}
