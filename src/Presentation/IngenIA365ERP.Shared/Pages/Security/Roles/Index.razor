@page "/security/roles"
@using IngenIA365ERP.Shared.Configuration
@using System.Net.Http.Json
@using IngenIA365ERP.Shared.Services.Http
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>Roles — IngenIA365ERP</PageTitle>

<div class="admin-page">
    <div class="page-header">
        <h1>Roles</h1>
    </div>

    <div class="toolbar">
        <input type="search" placeholder="Buscar rol…" @bind="_search" @bind:event="oninput" />
        <label><input type="checkbox" @bind="_includeBuiltIn" /> incluir built-in</label>
        <button class="primary" @onclick="OpenCreate">+ Nuevo rol</button>
        @* Feature 012 (T129, FR-093): único botón de perfiles sugeridos; US12 no lo repite. *@
        <PermissionGate Required="Security.Roles.Create">
            <button @onclick="AbrirPlantillasAsync">Crear desde perfil sugerido</button>
        </PermissionGate>
        <button @onclick="LoadAsync">Refrescar</button>
    </div>

    @if (_loading) { <p>Cargando…</p> }
    else if (_error is not null) { <p class="error aviso aviso-error" role="alert">@_error</p> }
    else if (_items.Count == 0) { <p>Sin resultados.</p> }
    else
    {
        <table class="data-grid">
            <thead>
                <tr>
                    <th>Código</th><th>Nombre</th><th>Tipo</th><th>Permisos</th><th>Usuarios</th><th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _items)
                {
                    <tr>
                        <td>@r.Code</td>
                        <td>@r.Name</td>
                        <td>@(r.IsBuiltIn ? "Built-in" : "Custom")</td>
                        <td>@r.PermissionCount</td>
                        <td>@r.UserCount</td>
                        <td>
                            <div class="acciones">
                                <button @onclick="() => Edit(r.PublicId)">Editar</button>
                                @if (!r.IsBuiltIn)
                                {
                                    <button @onclick="() => DeleteAsync(r.PublicId)">Eliminar</button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<SfDialog @bind-Visible="_plantillasAbierto" Header="Crear desde perfil sugerido" Width="720px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@_cargaPlantillas.Activa">
            <div class="pagina">
                @if (_creado is not null)
                {
                    <p>Rol <strong>@_creado.Code</strong> creado con @_creado.PermissionCodes.Count permiso(s). Es un rol normal: podés editarlo.</p>
                    @if (_creado.Omitted.Count > 0)
                    {
                        <p class="texto-alerta">Estos códigos del perfil no existen en el catálogo de la cooperativa y no se asignaron:</p>
                        <ul>@foreach (var c in _creado.Omitted) { <li><code>@c</code></li> }</ul>
                    }
                }
                else
                {
                    <p class="texto-apoyo">Un perfil sugerido es una propuesta: el rol que se crea es de la cooperativa y se edita como cualquier otro. El alcance (bodegas y puntos de venta) y los montos máximos se asignan aparte.</p>
                    <label class="campo">Perfil
                        <select @bind="_plantillaElegida">
                            <option value="">Elegí un perfil…</option>
                            @foreach (var t in _plantillas)
                            {
                                <option value="@t.Key">@t.Actor (@t.Key)</option>
                            }
                        </select>
                    </label>
                    @if (Elegida is { } elegida)
                    {
                        <p>@elegida.Description</p>
                        <p class="texto-apoyo">@elegida.Notes</p>
                        <details>
                            <summary>@elegida.PermissionCodes.Count permiso(s)</summary>
                            <ul>@foreach (var c in elegida.PermissionCodes) { <li><code>@c</code></li> }</ul>
                        </details>
                    }
                    <label class="campo">Código del rol
                        <input @bind="_codigo" maxlength="40" placeholder="BodegaCentral" />
                    </label>
                    <label class="campo">Nombre del rol
                        <input @bind="_nombre" maxlength="100" />
                    </label>
                    <label class="campo">Descripción
                        <input @bind="_descripcion" maxlength="500" />
                    </label>
                }
                @if (_errorPlantilla is not null)
                {
                    <p class="error aviso aviso-error" role="alert">@_errorPlantilla</p>
                }
            </div>
            </IndicadorDeCarga>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cerrar" CssClass="e-flat" OnClick="@(() => _plantillasAbierto = false)" />
        @if (_creado is null)
        {
            <DialogButton Content="Crear rol" IsPrimary="true" Disabled="@(_cargaPlantillas.Activa || string.IsNullOrWhiteSpace(_plantillaElegida))" OnClick="@CrearDesdePlantillaAsync" />
        }
    </DialogButtons>
</SfDialog>

@code {
    private List<RoleItem> _items = new();
    private string _search = string.Empty;
    private bool _includeBuiltIn = true;
    private bool _loading;
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true; _error = null;
        try
        {
            var url = $"{AppSettings.GetApiBaseUrl()}/api/admin/roles?search={Uri.EscapeDataString(_search)}&includeBuiltIn={_includeBuiltIn}";
            var resp = await Http.GetAsync(url);
            if (!resp.IsSuccessStatusCode) { _error = $"Error {(int)resp.StatusCode}"; return; }
            var page = await resp.Content.ReadFromJsonAsync<PagedResult<RoleItem>>();
            _items = page?.Items?.ToList() ?? new();
        }
        finally { _loading = false; }
    }

    private void OpenCreate() => Nav.NavigateTo("/security/roles/new");
    private void Edit(Guid id) => Nav.NavigateTo($"/security/roles/{id}");

    private async Task DeleteAsync(Guid id)
    {
        var resp = await Http.DeleteAsync($"{AppSettings.GetApiBaseUrl()}/api/admin/roles/{id}");
        if (resp.IsSuccessStatusCode) await LoadAsync();
        else _error = await resp.Content.ReadAsStringAsync();
    }

    // ------------------------------------------------------ perfiles sugeridos (feature 012, T129) --

    private readonly EstadoDeCarga _cargaPlantillas = new();
    private List<RoleTemplateItem> _plantillas = new();
    private bool _plantillasAbierto;
    private string _plantillaElegida = string.Empty;
    private string _codigo = string.Empty, _nombre = string.Empty, _descripcion = string.Empty;
    private string? _errorPlantilla;
    private RoleFromTemplateResult? _creado;
    private ClaveDeOperacion _clave = new();

    private RoleTemplateItem? Elegida => _plantillas.FirstOrDefault(t => t.Key == _plantillaElegida);

    private async Task AbrirPlantillasAsync()
    {
        _plantillaElegida = _codigo = _nombre = _descripcion = string.Empty;
        _errorPlantilla = null;
        _creado = null;
        _clave = new ClaveDeOperacion();
        _plantillasAbierto = true;

        using var carga = _cargaPlantillas.Iniciar();
        var resp = await Http.GetAsync($"{AppSettings.GetApiBaseUrl()}/api/admin/roles/templates?module=Inventory");
        if (!resp.IsSuccessStatusCode) { _errorPlantilla = await MensajeDeErrorAsync(resp); return; }
        _plantillas = await resp.Content.ReadFromJsonAsync<List<RoleTemplateItem>>() ?? new();
    }

    private async Task CrearDesdePlantillaAsync()
    {
        _errorPlantilla = null;
        using var carga = _cargaPlantillas.Iniciar();
        var cuerpo = new
        {
            templateKey = _plantillaElegida,
            code = _codigo.Trim(),
            name = _nombre.Trim(),
            description = string.IsNullOrWhiteSpace(_descripcion) ? null : _descripcion.Trim(),
        };
        using var peticion = new HttpRequestMessage(HttpMethod.Post, $"{AppSettings.GetApiBaseUrl()}/api/admin/roles/from-template")
        {
            Content = JsonContent.Create(cuerpo),
        };
        _clave.Aplicar(peticion, cuerpo);
        var resp = await Http.SendAsync(peticion);
        if (!resp.IsSuccessStatusCode) { _errorPlantilla = await MensajeDeErrorAsync(resp); return; }

        _clave.Exito();
        _creado = await resp.Content.ReadFromJsonAsync<RoleFromTemplateResult>();
        await LoadAsync();
    }

    private static async Task<string> MensajeDeErrorAsync(HttpResponseMessage resp)
    {
        try
        {
            var sobre = await resp.Content.ReadFromJsonAsync<SobreDeError>();
            if (!string.IsNullOrWhiteSpace(sobre?.Message)) return sobre.Message!;
        }
        catch { /* cuerpo sin sobre */ }
        return $"Error {(int)resp.StatusCode}";
    }

    public sealed record RoleTemplateItem(
        string Key, string Actor, string Description, IReadOnlyList<string> PermissionCodes, string Notes);

    public sealed record RoleFromTemplateResult(
        Guid RolePublicId, string Code, string Name, IReadOnlyList<string> PermissionCodes, IReadOnlyList<string> Omitted);

    private sealed record SobreDeError(string? Code, string? Message);

    public sealed record RoleItem(
        Guid PublicId, string Code, string Name, string? Description,
        bool IsBuiltIn, bool IsAssignable, bool IsActive,
        int PermissionCount, int UserCount);

    public sealed record PagedResult<T>(IReadOnlyList<T> Items, int Page, int PageSize, long TotalCount);
}
