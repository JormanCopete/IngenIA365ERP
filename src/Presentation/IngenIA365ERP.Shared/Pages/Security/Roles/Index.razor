@page "/security/roles"
@using IngenIA365ERP.Shared.Configuration
@using System.Net.Http.Json
@using IngenIA365ERP.Shared.Services.Http
@using IngenIA365ERP.Shared.Services.Security
@inject HttpClient Http
@inject NavigationManager Nav
@inject PermisosDelUsuario Permisos

<PageTitle>Roles y permisos — IngenIA365ERP</PageTitle>

@* 2026-11-19 (pedido del dueño): la lista de roles dice para qué sirve cada uno, de qué tipo es y a cuántos usuarios llega; se
   copia un rol para armar otro parecido, y eliminar pide confirmación y se apaga mientras el rol tenga usuarios (la API también
   lo rechaza). Los botones se muestran según los permisos de quien entra. *@
<PermissionGate Required="Security.Roles.View" MostrarAviso="true">
<div class="admin-page pagina">
    <div class="page-header">
        <h1>Roles y permisos</h1>
        <div class="toolbar">
            <PermissionGate Required="Security.Roles.Create">
                <button class="boton-principal" @onclick="OpenCreate">Nuevo rol</button>
                @* Feature 012 (T129, FR-093): único botón de perfiles sugeridos; US12 no lo repite. *@
                <button class="boton boton-secundario" @onclick="AbrirPlantillasAsync">Crear desde perfil sugerido</button>
            </PermissionGate>
        </div>
    </div>
    <p class="texto-apoyo">
        Un rol es un conjunto de permisos. A cada usuario se le asignan roles (en <a href="/security/users">Usuarios</a>) y puede hacer
        lo que permita cualquiera de ellos. Al abrir un rol se ve, de cada permiso, qué permite, de qué módulo es y en qué opción del
        menú se usa.
    </p>

    <div class="toolbar">
        <input type="search" class="e-input" placeholder="Buscar por código, nombre o para qué sirve…" aria-label="Buscar rol"
               @bind="_search" @bind:event="oninput" />
        <label class="campo-check"><input type="checkbox" @bind="_includeBuiltIn" @bind:after="LoadAsync" /> Incluir los integrados</label>
    </div>

    <IndicadorDeCarga Cargando="@_carga.Activa">
    @if (_error is not null) { <p class="aviso aviso-error" role="alert">@_error</p> }
    @if (Filtrados.Count == 0)
    {
        <p class="texto-tenue">@(_carga.Activa ? "" : _items.Count == 0 ? "No hay roles." : "Ningún rol coincide con la búsqueda.")</p>
    }
    else
    {
        <div class="tabla-desplazable">
        <table class="data-grid">
            <thead>
                <tr>
                    <th>Rol</th><th>Para qué sirve</th><th>Tipo</th><th class="numero">Permisos</th><th class="numero">Usuarios</th><th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Filtrados)
                {
                    var rol = r;
                    <tr>
                        <td><strong>@r.Name</strong><div class="texto-tenue"><code>@r.Code</code></div></td>
                        <td>@(string.IsNullOrWhiteSpace(r.Description) ? "—" : r.Description)</td>
                        <td>
                            <span class="badge">@(r.IsBuiltIn ? "Integrado" : "Propio")</span>
                            @if (!r.IsAssignable) { <span class="badge" title="No se puede asignar a usuarios">No asignable</span> }
                            @if (!r.IsActive) { <span class="badge">Inactivo</span> }
                        </td>
                        <td class="numero">@r.PermissionCount</td>
                        <td class="numero">@r.UserCount</td>
                        <td>
                            <div class="acciones">
                                <button class="boton boton-secundario" @onclick="() => Edit(rol.PublicId)">@(_puedeEditar ? "Ver y editar" : "Ver")</button>
                                <PermissionGate Required="Security.Roles.Create">
                                    <button class="boton boton-secundario" title="Crear un rol nuevo con los mismos permisos" @onclick="() => Copiar(rol.PublicId)">Copiar</button>
                                </PermissionGate>
                                @if (!r.IsBuiltIn)
                                {
                                    <PermissionGate Required="Security.Roles.Delete">
                                        <button class="boton boton-secundario" disabled="@(rol.UserCount > 0)"
                                                title="@(rol.UserCount > 0 ? "Quitale el rol a sus usuarios antes de eliminarlo" : "Eliminar el rol")"
                                                @onclick="() => PedirEliminar(rol)">Eliminar</button>
                                    </PermissionGate>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
    </IndicadorDeCarga>
</div>
</PermissionGate>

<ConfirmDialog @bind-Visible="_confirmarEliminar" Title="Eliminar rol" ConfirmText="Eliminar" OnConfirm="DeleteAsync"
               Message="@($"¿Eliminar el rol {_aEliminar?.Code} — {_aEliminar?.Name}? Ningún usuario lo tiene; el rol deja de existir y ya no se puede asignar.")" />

<SfDialog @bind-Visible="_plantillasAbierto" Header="Crear desde perfil sugerido" Width="720px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@_cargaPlantillas.Activa">
            <div class="pagina">
                @if (_creado is not null)
                {
                    <p>Rol <strong>@_creado.Code</strong> creado con @_creado.PermissionCodes.Count permiso(s). Es un rol normal: podés editarlo.</p>
                    @if (_creado.Omitted.Count > 0)
                    {
                        <p class="texto-alerta">Estos códigos del perfil no existen en el catálogo de la cooperativa y no se asignaron:</p>
                        <ul>@foreach (var c in _creado.Omitted) { <li><code>@c</code></li> }</ul>
                    }
                }
                else
                {
                    <p class="texto-apoyo">Un perfil sugerido es una propuesta: el rol que se crea es de la cooperativa y se edita como cualquier otro. El alcance (bodegas y puntos de venta) y los montos máximos se asignan aparte.</p>
                    <label class="campo">Perfil
                        <select class="e-input" @bind="_plantillaElegida">
                            <option value="">Elegí un perfil…</option>
                            @foreach (var t in _plantillas)
                            {
                                <option value="@t.Key">@t.Actor (@t.Key)</option>
                            }
                        </select>
                    </label>
                    @if (Elegida is { } elegida)
                    {
                        <p>@elegida.Description</p>
                        <p class="texto-apoyo">@elegida.Notes</p>
                        <details>
                            <summary>@elegida.PermissionCodes.Count permiso(s)</summary>
                            <ul>@foreach (var c in elegida.PermissionCodes) { <li><code>@c</code></li> }</ul>
                        </details>
                    }
                    <label class="campo">Código del rol
                        <input class="e-input" @bind="_codigo" maxlength="40" placeholder="BodegaCentral" />
                    </label>
                    <label class="campo">Nombre del rol
                        <input class="e-input" @bind="_nombre" maxlength="100" />
                    </label>
                    <label class="campo">Para qué sirve
                        <input class="e-input" @bind="_descripcion" maxlength="500" />
                    </label>
                }
                @if (_errorPlantilla is not null)
                {
                    <p class="aviso aviso-error" role="alert">@_errorPlantilla</p>
                }
            </div>
            </IndicadorDeCarga>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cerrar" CssClass="e-flat" OnClick="@(() => _plantillasAbierto = false)" />
        @if (_creado is null)
        {
            <DialogButton Content="Crear rol" IsPrimary="true" Disabled="@(_cargaPlantillas.Activa || string.IsNullOrWhiteSpace(_plantillaElegida))" OnClick="@CrearDesdePlantillaAsync" />
        }
    </DialogButtons>
</SfDialog>

@code {
    private readonly EstadoDeCarga _carga = new();
    private List<RoleItem> _items = new();
    private string _search = string.Empty;
    private bool _includeBuiltIn = true;
    private bool _puedeEditar;
    private string? _error;
    private bool _confirmarEliminar;
    private RoleItem? _aEliminar;

    private List<RoleItem> Filtrados => _search.Trim() is { Length: > 0 } t
        ? _items.Where(r => Contiene(r.Code, t) || Contiene(r.Name, t) || Contiene(r.Description, t)).ToList()
        : _items;

    private static bool Contiene(string? s, string t) =>
        s is not null && System.Globalization.CultureInfo.InvariantCulture.CompareInfo.IndexOf(
            s, t, System.Globalization.CompareOptions.IgnoreCase | System.Globalization.CompareOptions.IgnoreNonSpace) >= 0;

    protected override async Task OnInitializedAsync()
    {
        _puedeEditar = await Permisos.TieneAsync("Security.Roles.Update");
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        using var carga = _carga.Iniciar();
        _error = null;
        var resp = await Http.GetAsync($"{AppSettings.GetApiBaseUrl()}/api/admin/roles?includeBuiltIn={_includeBuiltIn}&pageSize=200");
        if (!resp.IsSuccessStatusCode)
        {
            _error = await NotificationServiceExtensions.MensajeDeErrorAsync(resp, "No se pudieron leer los roles.");
            return;
        }
        var page = await resp.Content.ReadFromJsonAsync<PagedResult<RoleItem>>();
        _items = page?.Items?.OrderBy(r => r.IsBuiltIn ? 0 : 1).ThenBy(r => r.Name).ToList() ?? new();
    }

    private void OpenCreate() => Nav.NavigateTo("/security/roles/new");
    private void Copiar(Guid id) => Nav.NavigateTo($"/security/roles/new?copiar={id}");
    private void Edit(Guid id) => Nav.NavigateTo($"/security/roles/{id}");

    private void PedirEliminar(RoleItem rol)
    {
        _aEliminar = rol;
        _confirmarEliminar = true;
    }

    private async Task DeleteAsync()
    {
        if (_aEliminar is null) return;
        using var carga = _carga.Iniciar();
        var resp = await Http.DeleteAsync($"{AppSettings.GetApiBaseUrl()}/api/admin/roles/{_aEliminar.PublicId}");
        _aEliminar = null;
        if (resp.IsSuccessStatusCode) await LoadAsync();
        else _error = await NotificationServiceExtensions.MensajeDeErrorAsync(resp, "No se pudo eliminar el rol.");
    }

    // ------------------------------------------------------ perfiles sugeridos (feature 012, T129) --

    private readonly EstadoDeCarga _cargaPlantillas = new();
    private List<RoleTemplateItem> _plantillas = new();
    private bool _plantillasAbierto;
    private string _plantillaElegida = string.Empty;
    private string _codigo = string.Empty, _nombre = string.Empty, _descripcion = string.Empty;
    private string? _errorPlantilla;
    private RoleFromTemplateResult? _creado;
    private ClaveDeOperacion _clave = new();

    private RoleTemplateItem? Elegida => _plantillas.FirstOrDefault(t => t.Key == _plantillaElegida);

    private async Task AbrirPlantillasAsync()
    {
        _plantillaElegida = _codigo = _nombre = _descripcion = string.Empty;
        _errorPlantilla = null;
        _creado = null;
        _clave = new ClaveDeOperacion();
        _plantillasAbierto = true;

        using var carga = _cargaPlantillas.Iniciar();
        var resp = await Http.GetAsync($"{AppSettings.GetApiBaseUrl()}/api/admin/roles/templates?module=Inventory");
        if (!resp.IsSuccessStatusCode) { _errorPlantilla = await NotificationServiceExtensions.MensajeDeErrorAsync(resp, "No se pudieron leer los perfiles."); return; }
        _plantillas = await resp.Content.ReadFromJsonAsync<List<RoleTemplateItem>>() ?? new();
    }

    private async Task CrearDesdePlantillaAsync()
    {
        _errorPlantilla = null;
        using var carga = _cargaPlantillas.Iniciar();
        var cuerpo = new
        {
            templateKey = _plantillaElegida,
            code = _codigo.Trim(),
            name = _nombre.Trim(),
            description = string.IsNullOrWhiteSpace(_descripcion) ? null : _descripcion.Trim(),
        };
        using var peticion = new HttpRequestMessage(HttpMethod.Post, $"{AppSettings.GetApiBaseUrl()}/api/admin/roles/from-template")
        {
            Content = JsonContent.Create(cuerpo),
        };
        _clave.Aplicar(peticion, cuerpo);
        var resp = await Http.SendAsync(peticion);
        if (!resp.IsSuccessStatusCode) { _errorPlantilla = await NotificationServiceExtensions.MensajeDeErrorAsync(resp, "No se pudo crear el rol."); return; }

        _clave.Exito();
        _creado = await resp.Content.ReadFromJsonAsync<RoleFromTemplateResult>();
        await LoadAsync();
    }

    public sealed record RoleTemplateItem(
        string Key, string Actor, string Description, IReadOnlyList<string> PermissionCodes, string Notes);

    public sealed record RoleFromTemplateResult(
        Guid RolePublicId, string Code, string Name, IReadOnlyList<string> PermissionCodes, IReadOnlyList<string> Omitted);

    public sealed record RoleItem(
        Guid PublicId, string Code, string Name, string? Description,
        bool IsBuiltIn, bool IsAssignable, bool IsActive,
        int PermissionCount, int UserCount);

    public sealed record PagedResult<T>(IReadOnlyList<T> Items, int Page, int PageSize, long TotalCount);
}
