@page "/admin/tenant/{TenantPublicId:guid}/members"
@using IngenIA365ERP.Shared.Services.Security
@inject MembershipsClient Client

@*
    T111 (US4) — Gestión de miembros de la empresa: tabla con acciones
    suspender/activar/revocar/promover/degradar + banner cuando queda 1 admin.
*@

<PageTitle>Miembros — IngenIA365ERP</PageTitle>

<div class="pagina">
    <div class="page-header">
        <h1>Miembros de la empresa</h1>
    </div>

    @if (_loading)
    {
        <p>Cargando...</p>
    }
    else if (_members is null || _members.Items.Count == 0)
    {
        <p>No hay miembros para mostrar.</p>
    }
    else
    {
        @if (_activeAdminsCount == 1)
        {
            <div class="aviso aviso-alerta">
                <strong>Queda 1 administrador activo</strong> en la empresa. No podrás
                revocarlo ni degradarlo hasta que otro miembro sea promovido a admin.
            </div>
        }

        <table class="tabla">
            <thead>
                <tr>
                    <th>CentralUser</th>
                    <th>Estado</th>
                    <th>Rol</th>
                    <th>Invitado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in _members.Items)
                {
                    <tr>
                        <td style="font-family: var(--fuente-mono); font-size: var(--texto-sm);">
                            @m.CentralUserId.ToString("N")[..8]
                        </td>
                        <td>@StatusLabel(m.Status)</td>
                        <td>
                            @if (m.IsTenantAdmin)
                            {
                                <span class="pastilla pastilla-info">Admin</span>
                            }
                        </td>
                        <td>@m.InvitedAt.ToString("dd/MM/yyyy")</td>
                        <td>
                            <div class="acciones">
                                @if (m.Status == 1)
                                {
                                    <button @onclick="() => SuspendAsync(m.MembershipPublicId)" disabled="@_busy">Suspender</button>
                                }
                                @if (m.Status == 2)
                                {
                                    <button @onclick="() => ActivateAsync(m.MembershipPublicId)" disabled="@_busy">Reactivar</button>
                                }
                                @if (m.Status != 3)
                                {
                                    <button @onclick="() => RevokeAsync(m.MembershipPublicId)" disabled="@_busy">Revocar</button>
                                }
                                @if (m.IsTenantAdmin && m.Status == 1)
                                {
                                    <button @onclick="() => DemoteAsync(m.MembershipPublicId)" disabled="@_busy">Degradar</button>
                                }
                                else if (!m.IsTenantAdmin && m.Status == 1)
                                {
                                    <button @onclick="() => PromoteAsync(m.MembershipPublicId)" disabled="@_busy">Promover</button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (!string.IsNullOrEmpty(_error))
    {
        <p class="error aviso aviso-error" role="alert">@_error</p>
    }
</div>

@code {
    [Parameter] public Guid TenantPublicId { get; set; }

    private MembersListResponse? _members;
    private int _activeAdminsCount;
    private bool _loading = true;
    private bool _busy;
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true; _error = null;
        try
        {
            var r = await Client.ListAsync(TenantPublicId);
            if (r.IsSuccess && r.Value is not null)
            {
                _members = r.Value;
                _activeAdminsCount = _members.Items.Count(m => m.IsTenantAdmin && m.Status == 1);
            }
            else _error = r.ErrorMessage ?? "No se pudo cargar.";
        }
        finally { _loading = false; }
    }

    private async Task Act(Func<Task<InvitationApiResult<EmptyResponse>>> action)
    {
        _busy = true; _error = null;
        try
        {
            var r = await action();
            if (!r.IsSuccess) _error = MapError(r.ErrorCode, r.ErrorMessage);
            await LoadAsync();
        }
        finally { _busy = false; }
    }

    private Task SuspendAsync(Guid id) => Act(() => Client.SuspendAsync(TenantPublicId, id));
    private Task ActivateAsync(Guid id) => Act(() => Client.ActivateAsync(TenantPublicId, id));
    private Task RevokeAsync(Guid id) => Act(() => Client.RevokeAsync(TenantPublicId, id));
    private Task PromoteAsync(Guid id) => Act(() => Client.PromoteAsync(TenantPublicId, id));
    private Task DemoteAsync(Guid id) => Act(() => Client.DemoteAsync(TenantPublicId, id));

    private static string StatusLabel(int s) => s switch
    {
        0 => "Invitado",
        1 => "Activo",
        2 => "Suspendido",
        3 => "Revocado",
        _ => "?",
    };

    private static string MapError(string? code, string? message) => code switch
    {
        "Membership.LastAdminProtected" =>
            "No puedes ejecutar esta acción: dejarías la empresa sin administrador.",
        "Membership.SelfDemoteBlocked.LastAdmin" =>
            "No puedes degradarte: eres el único administrador activo.",
        _ => message ?? "Acción rechazada.",
    };
}
