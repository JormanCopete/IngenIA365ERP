@page "/security/mfa-reset-approvals"
@using System.ComponentModel.DataAnnotations
@using IngenIA365ERP.Shared.Services.Security
@inject AuthClient AuthClient

@*
    Feature 003 (US6, FR-119) — Consola única de reset administrativo de MFA:
    tabla de solicitudes pendientes (solicitante, afectado, motivo, fechas)
    con aprobación en línea, más el formulario de alta (absorbe la antigua
    MfaResetRequests.razor). Doble aprobación: el solicitante no puede
    aprobarse a sí mismo (validado en backend).
*@

<PageTitle>Reset de MFA — IngenIA365ERP</PageTitle>

<h1>Reset administrativo del MFA</h1>
<p>Cada solicitud necesita dos aprobaciones de administradores distintos del solicitante y expira en 24 horas.</p>

<h2 style="margin-top: 24px;">Solicitudes pendientes</h2>

@if (_loading)
{
    <p>Cargando solicitudes...</p>
}
else if (_items.Count == 0)
{
    <p>No hay solicitudes pendientes.</p>
}
else
{
    <div style="overflow-x: auto;">
        <table class="table">
            <thead>
                <tr>
                    <th>Afectado</th>
                    <th>Solicitante</th>
                    <th>Motivo</th>
                    <th>Solicitada</th>
                    <th>Expira</th>
                    <th>Aprobaciones</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _items)
                {
                    <tr>
                        <td>@r.TargetUserName <small>(@r.TargetEmail)</small></td>
                        <td>@r.RequestedByUserName</td>
                        <td>@r.Reason</td>
                        <td>@r.RequestedAt.ToLocalTime().ToString("g")</td>
                        <td>@r.ExpiresAt.ToLocalTime().ToString("g")</td>
                        <td>@((r.HasFirstApproval ? 1 : 0) + (r.HasSecondApproval ? 1 : 0)) / 2</td>
                        <td>
                            <button disabled="@_busy" @onclick="() => ApproveAsync(r.PublicId)">Aprobar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (!string.IsNullOrEmpty(_status))
{
    <p role="status">Resultado: <strong>@_status</strong></p>
}

<h2 style="margin-top: 32px;">Nueva solicitud</h2>

<EditForm Model="@_model" OnValidSubmit="@SubmitRequestAsync" FormName="mfa-reset-request">
    <DataAnnotationsValidator />

    <label>PublicId del usuario afectado</label>
    <InputText @bind-Value="_model.TargetUserPublicId" />
    <ValidationMessage For="@(() => _model.TargetUserPublicId)" />

    <label>Justificación</label>
    <InputTextArea @bind-Value="_model.Reason" rows="3" />
    <ValidationMessage For="@(() => _model.Reason)" />

    <label>PublicId del adjunto de evidencia (opcional)</label>
    <InputText @bind-Value="_model.EvidenceAttachmentPublicId" />

    <button type="submit" disabled="@_busy">Crear solicitud</button>
</EditForm>

@if (_lastRequestId is not null)
{
    <p>Solicitud creada: <code>@_lastRequestId</code> (expira el @_lastExpiresAt:O)</p>
}

@if (!string.IsNullOrEmpty(_error))
{
    <p class="error" role="alert">@_error</p>
}

@code {
    private readonly Input _model = new();
    private IReadOnlyList<MfaResetRequestSummaryDto> _items = [];
    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private string? _status;
    private Guid? _lastRequestId;
    private DateTime? _lastExpiresAt;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var resp = await AuthClient.ListMfaResetRequestsAsync(status: "Pending");
            _items = resp?.Items ?? [];
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ApproveAsync(Guid requestPublicId)
    {
        _busy = true; _error = null; _status = null;
        try
        {
            var status = await AuthClient.ApproveMfaResetAsync(requestPublicId);
            if (status is null) { _error = "No fue posible registrar la aprobación."; return; }
            _status = status;
            await LoadAsync(); // Los resueltos desaparecen del filtro Pending.
        }
        finally { _busy = false; }
    }

    private async Task SubmitRequestAsync()
    {
        _busy = true; _error = null;
        try
        {
            if (!Guid.TryParse(_model.TargetUserPublicId, out var target)) { _error = "PublicId inválido."; return; }
            Guid? evidence = Guid.TryParse(_model.EvidenceAttachmentPublicId, out var e) ? e : null;
            var resp = await AuthClient.RequestMfaResetAsync(target, _model.Reason!, evidence);
            if (resp is null) { _error = "No fue posible crear la solicitud."; return; }
            _lastRequestId = resp.RequestPublicId;
            _lastExpiresAt = resp.ExpiresAt;
            await LoadAsync();
        }
        finally { _busy = false; }
    }

    public sealed class Input
    {
        [Required] public string? TargetUserPublicId { get; set; }
        [Required, MaxLength(500)] public string? Reason { get; set; }
        public string? EvidenceAttachmentPublicId { get; set; }
    }
}
