@page "/security/no-membership"
@layout MinimalLayout
@using IngenIA365ERP.Shared.Services.Security
@inject CentralAuthClient AuthClient
@inject NavigationManager Nav

@*
    T078 — Pantalla que se muestra cuando el login fue exitoso pero el usuario
    no tiene NINGUNA membresía activa con tenants. No emite JWT — el flujo
    queda en este "limbo" hasta que el usuario reciba una invitación.
*@

<PageTitle>Sin acceso — IngenIA365ERP</PageTitle>

<div class="auth-card" style="max-width: 520px; margin: calc(var(--gap-xl) * 1.5) auto; text-align: center;">
    <h1>No tienes acceso a ninguna empresa</h1>
    <p style="margin-top: var(--pad-lg);">
        Tu cuenta existe pero todavía no estás vinculado a ninguna cooperativa.
        Solicita una invitación al administrador de la empresa con la que
        vas a trabajar — recibirás un correo con el enlace para unirte.
    </p>

    <p class="muted" style="margin-top: var(--pad-xl);">
        Si crees que esto es un error, contacta al soporte indicando tu correo.
    </p>

    <button @onclick="LogoutAsync" disabled="@_busy" style="margin-top: var(--pad-xl);">
        @(_busy ? "Cerrando..." : "Cerrar sesión")
    </button>
</div>

@code {
    private bool _busy;

    private async Task LogoutAsync()
    {
        _busy = true;
        try
        {
            await AuthClient.LogoutAsync();
            Nav.NavigateTo("/security/login", forceLoad: true);
        }
        finally
        {
            _busy = false;
        }
    }
}
