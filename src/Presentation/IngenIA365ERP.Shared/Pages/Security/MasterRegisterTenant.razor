@page "/saas/register-tenant"
@layout MinimalLayout
@using System.ComponentModel.DataAnnotations
@using IngenIA365ERP.Shared.Services.Security
@inject SaasAdminClient Client
@inject NavigationManager Nav

@*
    T120 (US5) — Master admin registra nueva empresa + envía invitación admin
    en una sola operación. Tras éxito muestra confirmación con detalles.
*@

<PageTitle>Nueva empresa — IngenIA365ERP</PageTitle>

<div class="auth-card" style="max-width: 640px;">
    @if (_done && _result is not null)
    {
        @if (_result.CorreoEnviado)
        {
            <h1>Empresa registrada ✓</h1>
            <div class="aviso aviso-ok" role="status">
                <strong>@_model.Name</strong> fue creada y se envió la invitación
                de administrador a <strong>@_model.FirstAdminEmail</strong>.
            </div>
            <p>
                La invitación expira el
                <strong>@_result.InvitationExpiresAt.ToString("dd/MM/yyyy HH:mm 'UTC'")</strong>.
            </p>
        }
        else
        {
            <h1>Empresa registrada, correo NO enviado</h1>
            <div class="aviso aviso-alerta" role="alert">
                <strong>@_model.Name</strong> fue creada y la invitación de
                administrador quedó registrada, pero <strong>el correo a
                @_model.FirstAdminEmail no salió</strong>. Nadie la recibió:
                hay que reenviarla.
            </div>
            @if (!string.IsNullOrWhiteSpace(_result.MotivoCorreoNoEnviado))
            {
                <p>Motivo informado por el servidor de correo:
                   <em>@_result.MotivoCorreoNoEnviado</em></p>
            }
            <p>
                La invitación expira el
                <strong>@_result.InvitationExpiresAt.ToString("dd/MM/yyyy HH:mm 'UTC'")</strong>,
                se haya entregado el correo o no.
            </p>
            <p>
                <a href="@InvitacionesUrl">Ir a las invitaciones de esta empresa
                   para reenviarla</a>
            </p>
        }
        <button @onclick="Restart">Crear otra</button>
    }
    else
    {
        <h1>Registrar nueva empresa</h1>
        <p>Crea el tenant y envía la invitación de admin en un solo paso.</p>

        <EditForm Model="@_model" OnValidSubmit="@SubmitAsync" FormName="masterRegister">
            <DataAnnotationsValidator />

            <label>Razón social</label>
            <InputText @bind-Value="_model.LegalName" />
            <ValidationMessage For="@(() => _model.LegalName)" />

            <label>Nombre comercial</label>
            <InputText @bind-Value="_model.Name" />
            <ValidationMessage For="@(() => _model.Name)" />

            <label>NIT</label>
            <InputText @bind-Value="_model.Nit" />
            <ValidationMessage For="@(() => _model.Nit)" />

            <label>Schema (slug interno)</label>
            <InputText @bind-Value="_model.SchemaName" placeholder="tenant_coop_xyz" />
            <ValidationMessage For="@(() => _model.SchemaName)" />

            <label>Correo de contacto</label>
            <InputText @bind-Value="_model.ContactEmail" type="email" />
            <ValidationMessage For="@(() => _model.ContactEmail)" />

            <label>Correo del primer administrador</label>
            <InputText @bind-Value="_model.FirstAdminEmail" type="email" />
            <ValidationMessage For="@(() => _model.FirstAdminEmail)" />

            @* Feature 017: el primer administrador entra anclado a su documento, como cualquier invitado. *@
            <label>Tipo de documento del administrador</label>
            <InputSelect @bind-Value="_model.FirstAdminDocumentType">
                <option value="CC">CC — Cédula de ciudadanía</option>
                <option value="CE">CE — Cédula de extranjería</option>
                <option value="PPT">PPT — Permiso por protección temporal</option>
                <option value="PEP">PEP — Permiso especial de permanencia</option>
                <option value="TI">TI — Tarjeta de identidad</option>
                <option value="PA">PA — Pasaporte</option>
            </InputSelect>

            <label>Número de documento</label>
            <InputText @bind-Value="_model.FirstAdminDocumentNumber" autocomplete="off" />
            <ValidationMessage For="@(() => _model.FirstAdminDocumentNumber)" />

            <label>Repita el número de documento</label>
            <InputText @bind-Value="_model.FirstAdminDocumentNumberConfirmation" autocomplete="off" />
            <ValidationMessage For="@(() => _model.FirstAdminDocumentNumberConfirmation)" />

            <label>Nombre del administrador</label>
            <InputText @bind-Value="_model.FirstAdminFirstName" />
            <ValidationMessage For="@(() => _model.FirstAdminFirstName)" />

            <label>Apellido del administrador</label>
            <InputText @bind-Value="_model.FirstAdminLastName" />
            <ValidationMessage For="@(() => _model.FirstAdminLastName)" />

            <label>Celular del administrador</label>
            <InputText @bind-Value="_model.FirstAdminMobilePhone" />

            <button type="submit" disabled="@_busy">
                @(_busy ? "Creando..." : "Crear empresa y enviar invitación")
            </button>
        </EditForm>

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="error" role="alert" style="margin-top: var(--gap-md);">@_error</p>
        }
    }
</div>

@code {
    private readonly Input _model = new();
    private bool _busy;
    private bool _done;
    private string? _error;
    private RegisterTenantWithAdminResponse? _result;

    // Pantalla donde se lista y se reenvía la invitación cuando el correo falló.
    private string InvitacionesUrl =>
        $"/admin/tenants/{_result!.TenantPublicId}/invitaciones";

    private async Task SubmitAsync()
    {
        _busy = true; _error = null;
        try
        {
            var body = new RegisterTenantWithAdminBody(
                Name: _model.Name!,
                SchemaName: _model.SchemaName!,
                Subdomain: null,
                Nit: _model.Nit!,
                LegalName: _model.LegalName!,
                LegalAddress: null,
                TaxRegime: null,
                ContactEmail: _model.ContactEmail!,
                ContactPhone: null,
                PlanType: "Basic",
                MaxUsers: 50,
                StorageLimitMb: 5000,
                FirstAdminEmail: _model.FirstAdminEmail!,
                FirstAdminDocumentType: _model.FirstAdminDocumentType,
                FirstAdminDocumentNumber: _model.FirstAdminDocumentNumber,
                FirstAdminDocumentNumberConfirmation: _model.FirstAdminDocumentNumberConfirmation,
                FirstAdminFirstName: _model.FirstAdminFirstName,
                FirstAdminLastName: _model.FirstAdminLastName,
                FirstAdminMobilePhone: _model.FirstAdminMobilePhone);

            var r = await Client.RegisterTenantWithAdminAsync(body);
            if (r.IsSuccess && r.Value is not null)
            {
                _result = r.Value;
                _done = true;
                return;
            }
            _error = MapError(r.ErrorCode, r.ErrorMessage);
        }
        finally { _busy = false; }
    }

    private void Restart()
    {
        Nav.NavigateTo("/saas/register-tenant", forceLoad: true);
    }

    private static string MapError(string? code, string? message) => code switch
    {
        "Tenant.NitConflict" => "Ya existe una empresa con ese NIT.",
        "Saas.MasterOnly" => "Solo el master admin puede ejecutar esta acción.",
        _ => message ?? "No se pudo registrar la empresa.",
    };

    public sealed class Input
    {
        [Required(ErrorMessage = "Obligatorio.")] [MaxLength(200)]
        public string? Name { get; set; }

        [Required(ErrorMessage = "Obligatorio.")] [MaxLength(50)]
        [RegularExpression("^[a-z][a-z0-9_]*$", ErrorMessage = "En minúsculas, sólo letras, dígitos y guion bajo, empezando por una letra.")]
        public string? SchemaName { get; set; }

        [Required(ErrorMessage = "Obligatorio.")] [MaxLength(20)]
        public string? Nit { get; set; }

        [Required(ErrorMessage = "Obligatorio.")] [MaxLength(200)]
        public string? LegalName { get; set; }

        [Required(ErrorMessage = "Obligatorio.")]
        [EmailAddress(ErrorMessage = "Correo no válido.")]
        public string? ContactEmail { get; set; }

        [Required(ErrorMessage = "Obligatorio.")]
        [EmailAddress(ErrorMessage = "Correo no válido.")]
        public string? FirstAdminEmail { get; set; }

        // Feature 017: documento y nombre del primer administrador. El número se digita dos veces.
        public string FirstAdminDocumentType { get; set; } = "CC";

        [Required(ErrorMessage = "Obligatorio.")] [MaxLength(30)]
        public string? FirstAdminDocumentNumber { get; set; }

        [Required(ErrorMessage = "Obligatorio.")]
        [Compare(nameof(FirstAdminDocumentNumber), ErrorMessage = "Los dos números no coinciden.")]
        public string? FirstAdminDocumentNumberConfirmation { get; set; }

        [Required(ErrorMessage = "Obligatorio.")] [MaxLength(60)]
        public string? FirstAdminFirstName { get; set; }

        [Required(ErrorMessage = "Obligatorio.")] [MaxLength(60)]
        public string? FirstAdminLastName { get; set; }

        [MaxLength(30)]
        public string? FirstAdminMobilePhone { get; set; }
    }
}
