@page "/profile/mfa"
@layout MinimalLayout
@using System.ComponentModel.DataAnnotations
@using IngenIA365ERP.Shared.Services.Security
@inject ProfileClient ProfileClient
@inject CentralAuthClient AuthClient
@inject NavigationManager Nav

@*
    T079l — Enrollment voluntario de MFA desde el perfil.
    Estados: NotStarted → Pending (secret + input) → Enrolled.

    No se pinta código QR: no hay ninguna capa que lo genere. Existía un
    TotpService con QRCoder que esta pantalla nunca llamó, y se retiró. Hasta
    que el rediseño de MFA lo resuelva, la persona teclea el secret a mano —
    el texto de abajo lo dice en vez de prometer un QR que no aparece.
    Feature 003 (T019): si MFA ya está activo (detectado vía GetMeAsync),
    muestra el estado Active con el contador de recovery codes restantes
    (FR-110) y la regeneración con confirmación de identidad (FR-111/FR-112).
*@

<PageTitle>Activar MFA — IngenIA365ERP</PageTitle>

<div class="auth-card" style="max-width: 520px; margin: calc(var(--gap-xl) * 1.5) auto;">
    @if (_state == State.NotStarted)
    {
        <h1>Activar verificación en dos pasos</h1>
        <p>
            Protege tu cuenta con un código de 6 dígitos generado por tu app
            de autenticación (Google Authenticator, Authy, Microsoft Authenticator).
        </p>
        <button @onclick="BeginAsync" disabled="@_busy" style="margin-top: var(--pad-lg);">
            @(_busy ? "Generando..." : "Comenzar")
        </button>
    }
    else if (_state == State.Pending && _begin is not null)
    {
        <h1>Configura tu app</h1>
        <ol>
            <li>Abre tu app de autenticación y agrega una nueva cuenta.</li>
            <li>
                Elige «ingresar clave manualmente» y escribe este secret
                (todavía no mostramos el código QR):
                <code style="display: block; padding: var(--pad-sm); background: var(--superficie-0);
                              margin: var(--gap-sm) 0; word-break: break-all;">@_begin.SecretBase32</code>
                <small>otpauth URI: <code style="word-break: break-all;">@_begin.OtpAuthUri</code></small>
            </li>
            <li>Ingresa el código que muestra la app para confirmar.</li>
        </ol>

        <DirtyTrackingEditForm Model="@_confirm" OnValidSubmit="@ConfirmAsync" FormName="mfaConfirm">
            <DataAnnotationsValidator />

            <label>Código de la app</label>
            <InputText
                @bind-Value="_confirm.Code"
                inputmode="numeric"
                maxlength="8"
                style="font-size: var(--texto-xl); letter-spacing: 4px; text-align: center;" />
            <ValidationMessage For="@(() => _confirm.Code)" />

            <button type="submit" disabled="@_busy">
                @(_busy ? "Verificando..." : "Activar")
            </button>
        </DirtyTrackingEditForm>
    }
    else if (_state == State.Enrolled && _enrolledCodes is not null)
    {
        <h1>MFA activado ✓</h1>
        <p>
            La próxima vez que inicies sesión te pedirán el código de tu app.
        </p>

        <div class="aviso aviso-alerta" style="margin: var(--pad-lg) 0;">
            <strong>Guarda estos códigos de respaldo</strong> en un lugar seguro.
            Los podrás usar para entrar si pierdes acceso a tu app. Se muestran
            una sola vez:
            <ul style="font-family: var(--fuente-mono); margin-top: var(--gap-sm);">
                @foreach (var c in _enrolledCodes)
                {
                    <li>@c</li>
                }
            </ul>
        </div>

        <NavLink href="/" class="btn">Volver al inicio</NavLink>
    }

    else if (_state == State.Active)
    {
        <h1>Verificación en dos pasos</h1>
        <p>MFA está <strong>activo</strong> en tu cuenta.</p>

        @if (_recoveryRemaining is int remaining)
        {
            <p role="status">
                Códigos de recuperación disponibles: <strong>@remaining</strong>.
                @if (remaining <= 3)
                {
                    <span> Te quedan pocos — regenera un juego nuevo.</span>
                }
            </p>
        }

        @if (_regenerated is not null)
        {
            <div class="aviso aviso-alerta" style="margin: var(--pad-lg) 0;">
                <strong>Nuevos códigos de recuperación.</strong> Los anteriores
                quedaron invalidados. Guárdalos ahora — se muestran una sola vez:
                <ul style="font-family: var(--fuente-mono); margin-top: var(--gap-sm);">
                    @foreach (var c in _regenerated)
                    {
                        <li>@c</li>
                    }
                </ul>
            </div>
        }
        else if (!_showRegenerate)
        {
            <button @onclick="() => _showRegenerate = true" style="margin-top: var(--pad-lg);">
                Regenerar códigos de recuperación
            </button>
        }
        else
        {
            <div style="margin-top: var(--pad-lg);">
                <p>
                    Para confirmar tu identidad, ingresa tu contraseña actual
                    <em>o</em> un código de tu app de autenticación (solo uno).
                </p>
                <DirtyTrackingEditForm Model="@_regen" OnValidSubmit="@RegenerateAsync" FormName="regenCodes">
                    <label>Contraseña actual</label>
                    <InputText type="password" @bind-Value="_regen.CurrentPassword"
                               autocomplete="current-password" />

                    <label style="margin-top: var(--gap-sm);">o código TOTP</label>
                    <InputText @bind-Value="_regen.TotpCode" inputmode="numeric" maxlength="8" />

                    <button type="submit" disabled="@_busy">
                        @(_busy ? "Regenerando..." : "Regenerar códigos")
                    </button>
                </DirtyTrackingEditForm>
            </div>
        }

        <p style="margin-top: var(--pad-xl);">
            <NavLink href="/">Volver al inicio</NavLink>
        </p>
    }

    @if (!string.IsNullOrEmpty(_error))
    {
        <p class="error" role="alert" style="margin-top: var(--gap-md);">@_error</p>
    }
</div>

@code {
    private enum State { NotStarted, Pending, Enrolled, Active }

    private State _state = State.NotStarted;
    private BeginMfaEnrollResponse? _begin;
    private IReadOnlyList<string>? _enrolledCodes;
    private readonly ConfirmInput _confirm = new();
    private readonly RegenInput _regen = new();
    private IReadOnlyList<string>? _regenerated;
    private int? _recoveryRemaining;
    private bool _showRegenerate;
    private bool _busy;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        // Detección "MFA ya activo" (solo en el flujo voluntario con sesión full).
        if (UseChallengeToken) return;

        var me = await AuthClient.GetMeAsync();
        if (me?.MfaEnabled == true)
        {
            _state = State.Active;
            _recoveryRemaining = me.RecoveryCodesRemaining;
        }
    }

    private async Task RegenerateAsync()
    {
        var hasPassword = !string.IsNullOrWhiteSpace(_regen.CurrentPassword);
        var hasTotp = !string.IsNullOrWhiteSpace(_regen.TotpCode);
        if (hasPassword == hasTotp)
        {
            _error = "Ingresa tu contraseña actual o un código TOTP (exactamente uno).";
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var result = await ProfileClient.RegenerateRecoveryCodesAsync(
                hasPassword ? _regen.CurrentPassword : null,
                hasTotp ? _regen.TotpCode : null);
            if (result.IsSuccess && result.Value is not null)
            {
                _regenerated = result.Value.RecoveryCodes;
                _recoveryRemaining = _regenerated.Count;
                _showRegenerate = false;
                _regen.CurrentPassword = null;
                _regen.TotpCode = null;
                await AuthClient.GetMeAsync(forceRefresh: true);
                return;
            }
            _error = result.ErrorCode switch
            {
                "Identity.InvalidCredentials" => "La confirmación de identidad no es válida.",
                "Profile.Mfa.NotEnabled" => "MFA no está activo en tu cuenta.",
                _ => result.ErrorMessage ?? "No se pudieron regenerar los códigos.",
            };
        }
        finally
        {
            _busy = false;
        }
    }

    public sealed class RegenInput
    {
        public string? CurrentPassword { get; set; }
        public string? TotpCode { get; set; }
    }

    /// <summary>true cuando esta página atiende el enrollment FORZADO post-login
    /// (purpose=mfa-enroll). Las subclases la override.</summary>
    protected virtual bool UseChallengeToken => false;

    /// <summary>URL al éxito. Override en la versión forzada para forzar reload.</summary>
    protected virtual string SuccessUrl => "/";

    private async Task BeginAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await ProfileClient.BeginMfaEnrollAsync(useChallengeToken: UseChallengeToken);
            if (result.IsSuccess && result.Value is not null)
            {
                _begin = result.Value;
                _state = State.Pending;
                return;
            }
            _error = result.ErrorMessage ?? "No se pudo iniciar el enrollment.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ConfirmAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await ProfileClient.ConfirmMfaEnrollAsync(
                _confirm.Code!, useChallengeToken: UseChallengeToken);
            if (result.IsSuccess && result.Value is not null)
            {
                _enrolledCodes = result.Value.RecoveryCodes;
                _state = State.Enrolled;
                return;
            }
            _error = result.ErrorCode switch
            {
                "Profile.Mfa.NoPendingEnrollment" => "El tiempo expiró. Reinicia el enrollment.",
                "Profile.Mfa.InvalidCode" => "Código incorrecto. Verifica los dígitos.",
                _ => result.ErrorMessage ?? "No se pudo confirmar.",
            };
        }
        finally
        {
            _busy = false;
        }
    }

    public sealed class ConfirmInput
    {
        [Required(ErrorMessage = "Ingresa el código.")]
        [StringLength(8, MinimumLength = 6)]
        public string? Code { get; set; }
    }
}
