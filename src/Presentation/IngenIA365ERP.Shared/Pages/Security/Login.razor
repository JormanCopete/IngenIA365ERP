@page "/login"
@page "/security/login"
@layout MinimalLayout
@using System.ComponentModel.DataAnnotations
@using IngenIA365ERP.Shared.Services.Security
@inject CentralAuthClient AuthClient
@inject NavigationManager Nav

@*
    T077 — Login centralizado (Feature 002). Sin combo box de cooperativa:
    el usuario solo entra email + password; el backend decide a dónde ir
    (single tenant directo, MFA verify, MFA enrollment forzado, selección
    de tenant, o aviso "sin membresía").
*@

<PageTitle>Iniciar sesión — IngenIA365ERP</PageTitle>

<div class="auth-card" style="max-width: 420px; margin: 32px auto;">
    <h1>Iniciar sesión</h1>
    <EditForm Model="@_model" OnValidSubmit="@SubmitAsync" FormName="login">
        <DataAnnotationsValidator />

        <label>Correo</label>
        <InputText
            @bind-Value="_model.Email"
            type="email"
            autocomplete="username"
            placeholder="tu.correo@cooperativa.co" />
        <ValidationMessage For="@(() => _model.Email)" />

        <label>Contraseña</label>
        <InputText
            @bind-Value="_model.Password"
            type="password"
            autocomplete="current-password" />
        <ValidationMessage For="@(() => _model.Password)" />

        <button type="submit" disabled="@_busy" style="margin-top: 16px;">
            @(_busy ? "Validando..." : "Continuar")
        </button>
    </EditForm>

    @if (!string.IsNullOrEmpty(_error))
    {
        <p class="error" role="alert" style="margin-top: 12px;">@_error</p>
    }

    <p style="margin-top: 16px; font-size: 13px;">
        <NavLink href="/auth/forgot-password">¿Olvidaste tu contraseña?</NavLink>
    </p>
</div>

@code {
    private readonly LoginInput _model = new();
    private bool _busy;
    private string? _error;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await AuthClient.LoginAsync(_model.Email!, _model.Password!);
            if (!result.IsSuccess || result.Value is null)
            {
                _error = MapError(result.ErrorCode, result.ErrorMessage);
                return;
            }

            var body = result.Value;
            switch (body.Challenge)
            {
                case "None":
                    // autoSelected — el AuthClient ya almacenó access+refresh.
                    Nav.NavigateTo("/");
                    break;
                case "MfaRequired":
                    Nav.NavigateTo("/security/mfa-challenge");
                    break;
                case "MfaEnrollmentRequired":
                    Nav.NavigateTo("/auth/enroll-mfa-forced");
                    break;
                case "TenantSelection":
                    Nav.NavigateTo("/security/select-tenant");
                    break;
                case "NoActiveMembership":
                    Nav.NavigateTo("/security/no-membership");
                    break;
                default:
                    _error = $"Respuesta inesperada del servidor: {body.Challenge}";
                    break;
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private static string MapError(string? code, string? message) => code switch
    {
        "Identity.InvalidCredentials" => "Correo o contraseña incorrectos.",
        "Identity.Locked.Soft" => message ?? "Cuenta bloqueada temporalmente. Reintenta en unos minutos.",
        "Network.Error" => message ?? "No se pudo contactar al servidor.",
        _ => message ?? "No fue posible iniciar sesión.",
    };

    public sealed class LoginInput
    {
        [Required(ErrorMessage = "El correo es obligatorio.")]
        [EmailAddress(ErrorMessage = "Correo no válido.")]
        public string? Email { get; set; }

        [Required(ErrorMessage = "La contraseña es obligatoria.")]
        public string? Password { get; set; }
    }
}
