@page "/auth/enroll-mfa-forced"
@layout MinimalLayout
@using System.ComponentModel.DataAnnotations
@using IngenIA365ERP.Shared.Services.Security
@inject ProfileClient ProfileClient
@inject CentralAuthClient AuthClient
@inject WebAuthnInterop Passkeys
@inject NavigationManager Nav

@*
    T079l — Enrollment FORZADO de MFA. Se llega aquí tras un login con
    challenge=MfaEnrollmentRequired. El CentralAuthClient retiene el
    challengeToken (purpose=mfa-enroll) y este flujo lo usa.

    Page guard: no se navega a ninguna otra ruta hasta completar el setup
    (excepto cerrar sesión).
*@

<PageTitle>Configura MFA — IngenIA365ERP</PageTitle>

<div class="auth-card" style="max-width: 520px; margin: calc(var(--gap-xl) * 1.5) auto;">
    <div class="aviso aviso-info" style="margin-bottom: var(--pad-lg);">
        <strong>Tu empresa requiere verificación en dos pasos.</strong>
        Configura tu app de autenticación para continuar.
    </div>

    @if (_state == State.NotStarted)
    {
        <h1>Activa la verificación en dos pasos</h1>
        <p>Elegí cómo querés confirmar que sos vos al entrar.</p>

        <button @onclick="BeginAsync" disabled="@_busy" style="margin-top: var(--pad-lg);">
            @(_busy ? "Generando..." : "Usar una app de códigos")
        </button>

        @* La alternativa importa: quien no puede manejar una app de
           autenticación —y es una de las razones por las que existen las
           passkeys— quedaría obligado a usarla igual para poder entrar, que es
           justo lo contrario de lo que se buscaba. *@
        @if (_passkeysDisponibles)
        {
            <button class="boton boton-secundario" @onclick="InscribirPasskeyAsync"
                    disabled="@_busy" style="margin-top: var(--gap-sm);">
                @(_esperandoLlave ? "Esperando la llave…" : "Usar una llave o passkey")
            </button>
        }
    }
    else if (_state == State.Pending && _begin is not null)
    {
        <h1>Configura tu app</h1>
        <ol>
            <li>Abre tu app de autenticación.</li>
            <li>
                Agrega el siguiente código secreto:
                <code style="display: block; padding: var(--pad-sm); background: var(--superficie-0);
                              margin: var(--gap-sm) 0; word-break: break-all;">@_begin.SecretBase32</code>
            </li>
            <li>Ingresa el código que muestra la app.</li>
        </ol>

        <EditForm Model="@_confirm" OnValidSubmit="@ConfirmAsync" FormName="forcedMfa">
            <DataAnnotationsValidator />

            <label>Código</label>
            <InputText
                @bind-Value="_confirm.Code"
                inputmode="numeric"
                maxlength="8"
                style="font-size: var(--texto-xl); letter-spacing: 4px; text-align: center;" />
            <ValidationMessage For="@(() => _confirm.Code)" />

            <button type="submit" disabled="@_busy">
                @(_busy ? "Verificando..." : "Activar y continuar")
            </button>
        </EditForm>
    }
    else if (_state == State.Enrolled && _enrolledCodes is not null)
    {
        <h1>Listo ✓</h1>

        <div class="aviso aviso-alerta" style="margin: var(--pad-lg) 0;">
            <strong>Guarda estos códigos de respaldo</strong> en un lugar seguro:
            <ul style="font-family: var(--fuente-mono); margin-top: var(--gap-sm);">
                @foreach (var c in _enrolledCodes)
                {
                    <li>@c</li>
                }
            </ul>
            Solo se muestran una vez.
        </div>

        <button @onclick="ContinueAsync" style="margin-top: var(--pad-lg);">
            Continuar al dashboard
        </button>
    }

    @if (!string.IsNullOrEmpty(_error))
    {
        <p class="error" role="alert" style="margin-top: var(--gap-md);">@_error</p>
    }

    <p style="margin-top: var(--pad-xl); font-size: var(--texto-sm);">
        <NavLink href="/security/login">Salir y cerrar sesión</NavLink>
    </p>
</div>

@code {
    private enum State { NotStarted, Pending, Enrolled }

    private State _state = State.NotStarted;
    private BeginMfaEnrollResponse? _begin;
    private IReadOnlyList<string>? _enrolledCodes;
    private readonly ConfirmInput _confirm = new();
    private bool _busy;
    private string? _error;

    private bool _passkeysDisponibles;
    private bool _esperandoLlave;

    protected override async Task OnAfterRenderAsync(bool primeraVez)
    {
        if (!primeraVez) return;

        _passkeysDisponibles = await Passkeys.EstaDisponibleAsync();
        StateHasChanged();
    }

    /// <summary>
    /// Inscribir una passkey cumple la exigencia igual que un código, y el
    /// servidor eleva la sesión igual. El único cuidado es el mismo de siempre:
    /// cancelar el diálogo no es un fallo.
    /// </summary>
    private async Task InscribirPasskeyAsync()
    {
        if (_busy) return;
        _busy = true;
        _error = null;

        try
        {
            var inicio = await ProfileClient.IniciarAltaPasskeyAsync(useChallengeToken: true);
            if (!inicio.IsSuccess || inicio.Value is null)
            {
                _error = inicio.ErrorMessage ?? "No se pudo iniciar el registro de la llave.";
                return;
            }

            _esperandoLlave = true;
            StateHasChanged();

            var firmada = await Passkeys.InscribirAsync(inicio.Value.OpcionesJson);
            _esperandoLlave = false;

            if (!firmada.Ok)
            {
                if (firmada.Motivo != MotivosWebAuthn.Cancelado)
                {
                    _error = firmada.Mensaje ?? "No se pudo registrar la llave.";
                }
                return;
            }

            var confirmacion = await ProfileClient.ConfirmarAltaPasskeyAsync(
                inicio.Value.RetoId, firmada.RespuestaJson!, useChallengeToken: true);

            if (!confirmacion.IsSuccess || confirmacion.Value is null)
            {
                _error = confirmacion.ErrorMessage ?? "El servidor no pudo verificar la llave.";
                return;
            }

            _enrolledCodes = confirmacion.Value.CodigosDeRecuperacion;
            _state = State.Enrolled;
        }
        finally
        {
            _esperandoLlave = false;
            _busy = false;
        }
    }

    private async Task BeginAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await ProfileClient.BeginMfaEnrollAsync(useChallengeToken: true);
            if (result.IsSuccess && result.Value is not null)
            {
                _begin = result.Value;
                _state = State.Pending;
                return;
            }
            _error = result.ErrorMessage ?? "No se pudo iniciar el enrollment.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ConfirmAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await ProfileClient.ConfirmMfaEnrollAsync(
                _confirm.Code!, useChallengeToken: true);
            if (result.IsSuccess && result.Value is not null)
            {
                _enrolledCodes = result.Value.RecoveryCodes;
                _state = State.Enrolled;
                return;
            }
            _error = result.ErrorCode switch
            {
                "Profile.Mfa.NoPendingEnrollment" => "El tiempo expiró. Vuelve a iniciar el flow.",
                "Profile.Mfa.InvalidCode" => "Código incorrecto. Verifica los dígitos.",
                _ => result.ErrorMessage ?? "No se pudo confirmar.",
            };
        }
        finally
        {
            _busy = false;
        }
    }

    private void ContinueAsync()
    {
        // Tras la inscripción forzada el servidor eleva la sesión y ProfileClient
        // la adopta. Pero no siempre puede elevarla —con más de una cooperativa
        // hace falta elegir, y eso pide otra pantalla—, así que se comprueba en
        // vez de darlo por hecho: navegar al panel sin sesión rebota al login sin
        // explicar nada, justo después de decirle a la persona «listo ✓».
        if (AuthClient.IsAuthenticated)
        {
            Nav.NavigateTo("/");
            return;
        }

        Nav.NavigateTo("/security/login");
    }

    public sealed class ConfirmInput
    {
        [Required(ErrorMessage = "Ingresa el código.")]
        [StringLength(8, MinimumLength = 6)]
        public string? Code { get; set; }
    }
}
