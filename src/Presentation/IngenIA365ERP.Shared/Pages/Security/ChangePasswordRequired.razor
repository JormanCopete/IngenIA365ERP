@page "/security/change-password-required"
@layout MinimalLayout
@using System.ComponentModel.DataAnnotations
@using IngenIA365ERP.Shared.Services.Security
@inject AuthClient AuthClient
@inject NavigationManager Nav

<PageTitle>Cambio de contraseña obligatorio — IngenIA365ERP</PageTitle>

<div class="auth-card">
    <h1>Debes actualizar tu contraseña</h1>
    <p>Por seguridad, antes de continuar establece una nueva contraseña que cumpla la política.</p>

    <EditForm Model="@_model" OnValidSubmit="@SubmitAsync" FormName="change-password-required">
        <DataAnnotationsValidator />

        <label>Contraseña actual</label>
        <InputText @bind-Value="_model.CurrentPassword" type="password" />
        <ValidationMessage For="@(() => _model.CurrentPassword)" />

        <label>Nueva contraseña</label>
        <InputText @bind-Value="_model.NewPassword" type="password" />
        <ValidationMessage For="@(() => _model.NewPassword)" />

        <label>Confirmar nueva contraseña</label>
        <InputText @bind-Value="_model.Confirm" type="password" />
        <ValidationMessage For="@(() => _model.Confirm)" />

        <button type="submit" disabled="@_busy">Cambiar contraseña</button>
    </EditForm>

    @if (!string.IsNullOrEmpty(_error))
    {
        <p class="error" role="alert">@_error</p>
    }
</div>

@code {
    private readonly Input _model = new();
    private bool _busy;
    private string? _error;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var ok = await AuthClient.ChangePasswordAsync(_model.CurrentPassword!, _model.NewPassword!);
            if (!ok) { _error = "No fue posible cambiar la contraseña. Revisa los requisitos."; return; }
            Nav.NavigateTo("/security/login", forceLoad: true);
        }
        finally { _busy = false; }
    }

    public sealed class Input : IValidatableObject
    {
        [Required] public string? CurrentPassword { get; set; }
        [Required, MinLength(8)] public string? NewPassword { get; set; }
        [Required] public string? Confirm { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext _)
        {
            if (NewPassword != Confirm)
                yield return new ValidationResult("La confirmación no coincide con la nueva contraseña.", [nameof(Confirm)]);
        }
    }
}
