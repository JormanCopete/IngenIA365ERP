@page "/security/mfa-challenge"
@layout MinimalLayout
@using System.ComponentModel.DataAnnotations
@using IngenIA365ERP.Shared.Services.Security
@inject CentralAuthClient AuthClient
@inject NavigationManager Nav

@*
    T079 — Segundo factor del login. El usuario llega aquí tras un login con
    challenge=MfaRequired; el CentralAuthClient ya tiene el challengeToken
    purpose=mfa-verify en memoria. POST a /api/auth/mfa/verify con el código TOTP
    o, en modo alterno (feature 003, FR-108/FR-109), un recovery code one-shot.
*@

<PageTitle>Verifica tu código — IngenIA365ERP</PageTitle>

<div class="auth-card" style="max-width: 420px; margin: calc(var(--gap-xl) * 1.5) auto;">
    <h1>Verificación en dos pasos</h1>
    <p>
        @(_useRecovery
            ? "Ingresa uno de tus códigos de recuperación. Cada código sirve una sola vez."
            : "Ingresa el código de 6 dígitos de tu app de autenticación.")
    </p>

    <EditForm Model="@_model" OnValidSubmit="@SubmitAsync" FormName="mfaVerify">
        <DataAnnotationsValidator />

        <label>@(_useRecovery ? "Código de recuperación" : "Código")</label>
        <InputText
            @bind-Value="_model.Code"
            autocomplete="one-time-code"
            inputmode="@(_useRecovery ? "text" : "numeric")"
            maxlength="20"
            style="font-size: var(--texto-xl); letter-spacing: 4px; text-align: center;" />
        <ValidationMessage For="@(() => _model.Code)" />

        <button type="submit" disabled="@_busy">
            @(_busy ? "Verificando..." : "Verificar")
        </button>
    </EditForm>

    @if (!string.IsNullOrEmpty(_error))
    {
        <p class="error" role="alert" style="margin-top: var(--gap-md);">@_error</p>
    }

    @if (_recoveryRemaining is int remaining)
    {
        <p role="status" style="margin-top: var(--gap-md); font-size: var(--texto-sm);">
            Te quedan <strong>@remaining</strong> códigos de recuperación.
            @if (remaining <= 3)
            {
                <span> Considera regenerarlos desde tu perfil (Autenticación MFA).</span>
            }
        </p>
    }

    <p style="margin-top: var(--pad-xl); font-size: var(--texto-sm);">
        <a href="" @onclick="ToggleMode" @onclick:preventDefault>
            @(_useRecovery ? "Usar el código de mi app de autenticación" : "¿No tienes tu app? Usa un código de recuperación")
        </a>
    </p>

    <p style="margin-top: var(--gap-sm); font-size: var(--texto-sm);">
        <NavLink href="/security/login">Volver al inicio de sesión</NavLink>
    </p>
</div>

@code {
    private readonly MfaInput _model = new();
    private bool _busy;
    private bool _useRecovery;
    private int? _recoveryRemaining;
    private string? _error;

    private void ToggleMode()
    {
        _useRecovery = !_useRecovery;
        _model.Code = null;
        _error = null;
    }

    private async Task SubmitAsync()
    {
        // Validación por modo (el DataAnnotations base solo exige no-vacío).
        var code = _model.Code?.Trim() ?? string.Empty;
        if (!_useRecovery && (code.Length < 6 || code.Length > 8))
        {
            _error = "El código tiene entre 6 y 8 dígitos.";
            return;
        }
        if (_useRecovery && (code.Length < 5 || code.Length > 20))
        {
            _error = "El código de recuperación tiene entre 5 y 20 caracteres.";
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var result = await AuthClient.MfaVerifyAsync(code, useRecoveryCode: _useRecovery);
            if (!result.IsSuccess || result.Value is null)
            {
                _error = MapError(result.ErrorCode, result.ErrorMessage);
                return;
            }

            _recoveryRemaining = result.Value.RecoveryCodesRemaining;

            switch (result.Value.Challenge)
            {
                case "None":
                    // Sin forceLoad: el storage es in-memory y un full reload
                    // reinicia el runtime WASM descartando la sesión adoptada.
                    Nav.NavigateTo("/");
                    break;
                case "TenantSelection":
                    Nav.NavigateTo("/security/select-tenant");
                    break;
                case "NoActiveMembership":
                    Nav.NavigateTo("/security/no-membership");
                    break;
                default:
                    _error = $"Respuesta inesperada: {result.Value.Challenge}";
                    break;
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private string MapError(string? code, string? message) => code switch
    {
        "Identity.MfaInvalid" => _useRecovery
            ? "Código de recuperación incorrecto o ya usado."
            : "Código incorrecto. Verifica los dígitos en tu app.",
        "Identity.ChallengeExpired" => "El tiempo expiró. Vuelve a iniciar sesión.",
        "Identity.NoChallengeToken" => "Falta el token de challenge. Reinicia el login.",
        "Identity.WrongTokenPurpose" => "El token no es válido para este paso.",
        _ => message ?? "No se pudo verificar el código.",
    };

    public sealed class MfaInput
    {
        [Required(ErrorMessage = "Ingresa el código.")]
        [StringLength(20, MinimumLength = 5, ErrorMessage = "El código tiene entre 5 y 20 caracteres.")]
        public string? Code { get; set; }
    }
}
