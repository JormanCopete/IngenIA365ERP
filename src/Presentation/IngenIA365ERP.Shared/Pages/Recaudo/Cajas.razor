@page "/recaudo/cajas"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using IngenIA365ERP.Shared.Components.Recaudo
@using IngenIA365ERP.Shared.Services.Http
@using IngenIA365ERP.Shared.Services.Nomina
@using IngenIA365ERP.Shared.Services.Recaudo
@inject SesionesClient Cliente
@inject INotificationService Notification
@inject DescargaDeArchivos Descargas

<PageTitle>Cajas del día - IngenIA365ERP</PageTitle>

@* 2026-11-24 (pedido del dueño): la consulta de las cajas de Recaudo, aparte de abrir la propia («Mi caja») e igual a la del punto de venta: las del día
   elegido y las pendientes de otros días (olvidadas y con diferencia por aprobar), con lo que hace un supervisor: cerrar la olvidada de otro, el arqueo
   sorpresivo (los dos en /recaudo/sesiones/{id}/cierre), aprobar diferencias, el ajuste de una cerrada y el informe. Antes estaba debajo de la apertura
   en Sesiones de caja (desde el 2026-11-14 con las pendientes de días anteriores). *@
<PermissionGate Required="Receipts.Session.View" MostrarAviso="true">
<div class="pagina">
    <div class="page-header">
        <h3>Cajas del día</h3>
        <div class="toolbar">
            <SfButton CssClass="e-outline" IconCss="e-icons e-refresh" Disabled="@_carga.Activa" OnClick="@CargarAsync">Actualizar</SfButton>
            <a class="e-btn e-flat" href="/recaudo/sesiones">Mi caja</a>
            <a class="e-btn e-flat" href="/recaudo/cierre-del-dia">Cierre del día</a>
        </div>
    </div>

    <TablaDeCajas Filas="@_filas" Cargando="@_carga.Activa" Dia="@_dia" DiaChanged="@CambiarDiaAsync" EtiquetaDelPunto="Punto de recaudo">
        <Acciones Context="f">
            @{ var s = _sesiones.First(x => x.PublicId == f.Id); }
            @if (s.Status == SesionesClient.EstadoOlvidada)
            {
                <PermissionGate Required="Receipts.Session.CloseForgotten">
                    <a class="e-btn e-flat" href="@($"/recaudo/sesiones/{s.PublicId}/cierre?modo=olvidada")">Cerrar</a>
                </PermissionGate>
            }
            @if (s.Status == SesionesClient.EstadoConDiferenciaPorAprobar)
            {
                <PermissionGate Required="Receipts.Count.ApproveDifference">
                    <SfButton CssClass="e-flat" OnClick="@(() => VerDiferenciasAsync(s))">Diferencias</SfButton>
                </PermissionGate>
            }
            @if (s.Status is 1 or 5)
            {
                <PermissionGate Required="Receipts.Session.SurpriseCount">
                    <a class="e-btn e-flat" href="@($"/recaudo/sesiones/{s.PublicId}/cierre?modo=sorpresivo")">Arqueo sorpresivo</a>
                </PermissionGate>
            }
            @if (s.Status == 4)
            {
                <PermissionGate Required="Receipts.Session.Adjust">
                    <SfButton CssClass="e-flat" OnClick="@(() => AbrirAjuste(s))">Ajuste</SfButton>
                </PermissionGate>
            }
            @if (s.Status is 3 or 4)
            {
                <SfButton CssClass="e-flat" OnClick="@(() => DescargarCierreAsync(s))">Informe</SfButton>
            }
        </Acciones>
    </TablaDeCajas>

    @if (_aprobacion is not null)
    {
        <AprobacionPresenteDeRecaudo Solicitud="_aprobacion.Value" Huella="@_huella" Motivo="@_motivoDeAprobacion" Aprobada="@RepetirConAprobacionAsync"
                                     Cancelada="@(() => _aprobacion = null)" />
    }
</div>

<SfDialog @bind-Visible="_diferenciasVisible" Header="Diferencias por aprobar" Width="620px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@_guardado.Activa" Texto="Cargando…">
                @foreach (var l in _pendientes)
                {
                    <div class="info-card">
                        <p><strong>@l.MeansCode</strong>: esperado @l.Expected.ToString("N0"), contado @l.Counted.ToString("N0"), diferencia @l.Difference.ToString("N0")
                            (tolerancia @l.Tolerance.ToString("N0")). @l.Reason</p>
                        <div class="form-grid">
                            @if (l.Difference < 0)
                            {
                                <label class="campo">El faltante va
                                    <select class="e-input" @bind="_tratamiento"><option value="2">Al gasto</option><option value="1">A cargo del cajero</option></select>
                                </label>
                            }
                            <label class="campo campo-ancho">Motivo de la aprobación * <input class="e-input" @bind="_motivo" maxlength="500" /></label>
                            <SfButton CssClass="e-primary" OnClick="@(() => AprobarAsync(l))">Aprobar</SfButton>
                        </div>
                    </div>
                }
            </IndicadorDeCarga>
        </Content>
    </DialogTemplates>
</SfDialog>

<SfDialog @bind-Visible="_ajusteVisible" Header="Ajuste de una caja cerrada" Width="520px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@_guardado.Activa" Texto="Guardando…">
                <div class="form-grid">
                    <label class="campo">Qué se corrige
                        <select class="e-input" @bind="_claseDeAjuste"><option value="1">Lo contado</option><option value="2">El medio</option></select>
                    </label>
                    <label class="campo">Medio
                        <select class="e-input" @bind="_medioDeAjuste">@foreach (var m in _sesionElegida?.Means ?? []) { <option value="@m.PaymentMeansPublicId">@m.Name</option> }</select>
                    </label>
                    <label class="campo">Valor (con signo) * <input class="e-input" type="number" @bind="_valor" /></label>
                    <label class="campo campo-ancho">Motivo * <input class="e-input" @bind="_motivo" maxlength="500" /></label>
                </div>
                @if (_sesionElegida is { } elegida)
                {
                    <SubirSoporte OwnerEntityType="@AdjuntosDeRecaudo.SoporteDeCaja" OwnerEntityPublicId="@elegida.PublicId"
                                  Rotulo="@(_politica.Estricto ? "Subir el soporte *" : "Subir el soporte (opcional)")" OnDisponible="@(id => _soporte = id)" />
                }
            </IndicadorDeCarga>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _ajusteVisible = false)" />
        <DialogButton Content="Registrar el ajuste" IsPrimary="true" OnClick="@(() => AjustarAsync(null))" Disabled="@_guardado.Activa" />
    </DialogButtons>
</SfDialog>
</PermissionGate>

@code {
    private readonly EstadoDeCarga _carga = new(), _guardado = new();
    private ClaveDeOperacion _clave = new();
    private PoliticaDeCaja _politica = PoliticaDeCaja.PorDefecto;
    private DateOnly _dia = DiaDeCaja.Hoy();
    private IReadOnlyList<SesionDeCajaDto> _sesiones = [];
    private IReadOnlyList<FilaDeCaja> _filas = [];
    private IReadOnlyList<LineaDeArqueoDto> _pendientes = [];
    private SesionDeCajaDto? _sesionElegida;
    private string _medioDeAjuste = "";
    private string? _motivo, _huella, _motivoDeAprobacion;
    private Guid? _soporte, _aprobacion;
    private int _tratamiento = 2, _claseDeAjuste = 1;
    private decimal _valor;
    private bool _diferenciasVisible, _ajusteVisible;
    private Func<Guid, Task>? _repetir;

    protected override async Task OnInitializedAsync()
    {
        _politica = await Cliente.PoliticaAsync();
        await CargarAsync();
    }

    private Task CambiarDiaAsync(DateOnly dia)
    {
        _dia = dia;
        return CargarAsync();
    }

    /// <summary>Las del día elegido más las pendientes de cualquier día: abiertas, olvidadas y con diferencia por aprobar.</summary>
    private async Task CargarAsync()
    {
        using var carga = _carga.Iniciar();
        var delDia = await Cliente.SesionesAsync(dia: _dia);
        var abiertas = await Cliente.SesionesAsync(estado: 1);
        var olvidadas = await Cliente.SesionesAsync(estado: SesionesClient.EstadoOlvidada);
        var porAprobar = await Cliente.SesionesAsync(estado: SesionesClient.EstadoConDiferenciaPorAprobar);
        if (!delDia.IsSuccess) await Notification.ErrorAsync(delDia.ErrorMessage ?? "No se pudieron consultar las cajas.");
        _sesiones = SesionesClient.DelDiaYPendientes([.. delDia.Value ?? [], .. abiertas.Value ?? [], .. olvidadas.Value ?? [], .. porAprobar.Value ?? []]);
        var hoy = DiaDeCaja.Hoy();
        _filas = _sesiones.Select(s => new FilaDeCaja(s.PublicId, s.BusinessDate, s.CollectionPointCode, s.CashBoxCode, s.CashierName, SesionesClient.Estado(s.Status),
            s.Status is 1 or 5, s.OpenedAt, s.ClosedAt, s.OpeningBase,
            Pendiente: s.Status is 3 or 5 || (s.Status == 1 && s.BusinessDate < hoy))).ToList();
    }

    private async Task VerDiferenciasAsync(SesionDeCajaDto sesion)
    {
        _sesionElegida = sesion;
        _motivo = null;
        _clave = new ClaveDeOperacion();
        _diferenciasVisible = true;
        using var g = _guardado.Iniciar();
        var r = await Cliente.ArqueosAsync(sesion.PublicId);
        _pendientes = r.IsSuccess && r.Value is not null ? r.Value.SelectMany(a => a.Lines).Where(l => l.PendingApproval).ToList() : [];
    }

    private async Task AprobarAsync(LineaDeArqueoDto linea)
    {
        if (_sesionElegida is null) return;
        if (string.IsNullOrWhiteSpace(_motivo)) { await Notification.WarningAsync("Escriba el motivo de la aprobación."); return; }
        using var g = _guardado.Iniciar();
        var r = await Cliente.AprobarDiferenciaAsync(_sesionElegida.PublicId, linea.PublicId,
            new AprobarDiferenciaRequest(_motivo.Trim(), linea.Difference < 0 ? _tratamiento : null), _clave);
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo aprobar la diferencia."); return; }
        _clave = new ClaveDeOperacion();
        _diferenciasVisible = false;
        await Notification.SuccessAsync("Diferencia aprobada.");
        await CargarAsync();
    }

    private void AbrirAjuste(SesionDeCajaDto sesion)
    {
        _sesionElegida = sesion;
        _medioDeAjuste = sesion.Means.FirstOrDefault()?.PaymentMeansPublicId.ToString() ?? "";
        _valor = 0;
        _soporte = null;
        _motivo = null;
        _clave = new ClaveDeOperacion();
        _ajusteVisible = true;
    }

    private async Task AjustarAsync(Guid? aprobacion)
    {
        if (_sesionElegida is null || !Guid.TryParse(_medioDeAjuste, out var medio)) return;
        if (string.IsNullOrWhiteSpace(_motivo)) { await Notification.WarningAsync("Escriba el motivo."); return; }
        if (_politica.Estricto && _soporte is null) { await Notification.WarningAsync("Suba el soporte del ajuste."); return; }
        using var g = _guardado.Iniciar();
        var r = await Cliente.AjustarAsync(_sesionElegida.PublicId, new AjusteRequest(_claseDeAjuste, medio, _valor, _motivo.Trim(), _soporte), _clave, aprobacion);
        if (PideAprobacion(r, $"Ajuste de {_valor:N0}", AjustarAsync)) return;
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo registrar el ajuste."); return; }
        _clave = new ClaveDeOperacion();
        _ajusteVisible = false;
        _aprobacion = null;
        await Notification.SuccessAsync($"Ajuste {r.Value!.Number} registrado.");
        await CargarAsync();
    }

    private bool PideAprobacion<T>(Services.Inventario.ResultadoDeInventario<T> r, string motivo, Func<Guid?, Task> repetir)
    {
        if (r.ErrorCode != "Approvals.PresenceRequired") return false;
        _aprobacion = r.Dato<Guid?>("approvalRequestPublicId");
        _huella = r.Dato<string>("contentSha256");
        _motivoDeAprobacion = motivo;
        _repetir = id => repetir(id);
        return true;
    }

    private async Task RepetirConAprobacionAsync(Guid solicitud)
    {
        if (_repetir is not null) await _repetir(solicitud);
    }

    private async Task DescargarCierreAsync(SesionDeCajaDto sesion)
    {
        var r = await Cliente.InformeDeCierreAsync(sesion.PublicId);
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo descargar el informe."); return; }
        await Descargas.GuardarAsync(r.Value!.Nombre, r.Value.TipoContenido, r.Value.Contenido);
    }
}
