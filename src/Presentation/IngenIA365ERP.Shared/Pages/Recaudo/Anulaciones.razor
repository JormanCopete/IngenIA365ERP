@page "/recaudo/anulaciones"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using IngenIA365ERP.Shared.Services.Http
@using IngenIA365ERP.Shared.Services.Nomina
@using IngenIA365ERP.Shared.Services.Recaudo
@inject AnulacionesClient AnulacionesApi
@inject CajaClient Caja
@inject IngenIA365ERP.Shared.Services.Security.PermisosDelUsuario Permisos
@inject INotificationService Notification
@inject DescargaDeArchivos Descargas

<PageTitle>Anulaciones de recibos - IngenIA365ERP</PageTitle>

@* Feature 015, US5 (T0181; FR-057, FR-058, FR-064, FR-194): pedir la anulación del recibo entero con motivo y que otra persona la apruebe —presente en la sesión
   abierta y el mismo día, o con el permiso después—. Al aprobarla se reversa cada aplicación vigente por su contrato; las que el módulo ya reversó se omiten, y si
   la sesión cerró el dinero queda como saldo a favor del pagador. *@
@* 2026-11-18 (pedido del dueño): el recibo se pide por su número (antes pedía el identificador interno) y llega lleno desde Recibos y desde la caja
   (?numero=); la pantalla la ve también quien sólo aprueba. *@
<PermissionGate Required="Receipts.Voiding.Request" AnyOf="@(new[] { "Receipts.Voiding.Approve", "Receipts.Voiding.Direct" })" MostrarAviso="true">
<div class="pagina">
    <div class="page-header">
        <h3>Anulaciones de recibos</h3>
        <div class="toolbar">
            <select class="e-input" @bind="_estado" @bind:after="CargarAsync">
                <option value="0">Todas</option>
                <option value="1">Pendientes de aprobar</option>
                <option value="2">Aplicadas</option>
                <option value="3">Rechazadas</option>
            </select>
            <SfButton CssClass="e-outline" IconCss="e-icons e-refresh" Disabled="@_carga.Activa" OnClick="@CargarAsync">Actualizar</SfButton>
        </div>
    </div>

    <PermissionGate Required="Receipts.Voiding.Request">
    <section class="info-card">
        <h4>Pedir una anulación</h4>
        <p class="texto-tenue">La aprueba otra persona con el permiso de aprobar anulaciones, distinta de quien la pide y del cajero que hizo el recibo. Al aprobarla, lo
            pagado vuelve a quedar por pagar en cada crédito o cuenta; el dinero sale de la caja si su sesión sigue abierta, o queda como saldo a favor del pagador.
            @if (_sinSegunda) { <b>Usted tiene el permiso de anular sin una segunda persona: el recibo se anula al pulsar el botón.</b> }</p>
        <IndicadorDeCarga Cargando="@_pedido.Activa" Texto="Pidiendo la anulación…">
            <div class="form-grid">
                <label class="campo">Número del recibo *
                    <input class="e-input" value="@_numero" @onchange="@(e => CambiarNumeroAsync(e.Value?.ToString()))" placeholder="Ej.: 000005" />
                </label>
                <label class="campo">Motivo * <input class="e-input" @bind="_motivo" maxlength="500" /></label>
            </div>
            @if (_elegido is { } recibo)
            {
                <p class="@(recibo.Status == 1 ? "aviso aviso-ok" : "aviso aviso-error")">
                    Recibo @recibo.Number del @recibo.ValueDate.ToString("dd/MM/yyyy") · @recibo.PayerName · @recibo.TotalApplied.ToString("N0")
                    @(recibo.Status == 1 ? "" : recibo.Status == 2 ? " · ya tiene una anulación por aprobar" : " · ya está anulado")
                </p>
                @foreach (var x in recibo.Applications)
                {
                    <p class="texto-tenue">@x.Ordinal. @CajaClient.Destino(x.Target) @x.ProductNumber · @CajaClient.Modalidad(x.LoanModality) · @x.Amount.ToString("N0")</p>
                }
            }
            else if (_noEncontrado)
            {
                <p class="aviso aviso-error">No hay un recibo con ese número a su alcance.</p>
            }
            <div class="toolbar"><SfButton CssClass="e-primary" Disabled="@(_pedido.Activa || _elegido is not { Status: 1 })" OnClick="@PedirAsync">@(_sinSegunda ? "Anular el recibo" : "Pedir la anulación")</SfButton></div>
        </IndicadorDeCarga>
    </section>
    </PermissionGate>
    <IndicadorDeCarga Cargando="@_carga.Activa" Texto="Cargando anulaciones…">
        <table class="data-grid">
            <thead><tr><th>Número</th><th>Recibo</th><th>Valor</th><th>Motivo</th><th>Pidió</th><th>Estado</th><th>Aprobó</th><th>Omitidas</th><th></th></tr></thead>
            <tbody>
                @foreach (var a in _anulaciones)
                {
                    <tr>
                        <td>@(a.Number ?? "—")</td><td>@a.ReceiptNumber</td><td>@a.Amount.ToString("N2")</td><td>@a.Reason</td><td>@a.RequestedByName</td>
                        <td>@Estado(a.Status)@(a.InSameSession ? " · en la sesión" : "")</td><td>@a.ApprovedByName</td>
                        <td>@string.Join(", ", a.OmittedApplications)</td>
                        <td>
                            @if (a.Status == 1)
                            {
                                <PermissionGate Required="Receipts.Voiding.Approve" AnyOf="@(new[] { "Receipts.Voiding.Direct" })">
                                    <SfButton CssClass="e-flat" OnClick="@(() => AprobarAsync(a))">Aprobar</SfButton>
                                    <SfButton CssClass="e-flat" OnClick="@(() => RechazarAsync(a))">Rechazar</SfButton>
                                </PermissionGate>
                            }
                            else if (a.Status == 2)
                            {
                                <SfButton CssClass="e-flat" OnClick="@(() => DocumentoAsync(a))">Documento</SfButton>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (_anulaciones.Count > 0)
        {
            <label class="campo">Motivo de la decisión (para rechazar es obligatorio) <input class="e-input" @bind="_decision" maxlength="500" /></label>
        }
    </IndicadorDeCarga>
</div>
</PermissionGate>

@code {
    private readonly EstadoDeCarga _carga = new(), _pedido = new();
    private IReadOnlyList<AnulacionDto> _anulaciones = [];
    private string? _numero;
    private string _motivo = "";
    private ReciboDto? _elegido;
    private bool _noEncontrado;

    /// <summary>El número del recibo cuando se llega desde Recibos o desde la caja.</summary>
    [SupplyParameterFromQuery(Name = "numero")] public string? NumeroInicial { get; set; }
    private string? _decision;
    private int _estado;
    private ClaveDeOperacion _clave = new();
    private bool _sinSegunda;
    // El permiso de anular sin segunda persona (2026-11-18).
    private const string PermisoSinSegunda="Receipts.Voiding.Direct";

    [SupplyParameterFromQuery(Name = "estado")] public int? EstadoInicial { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (EstadoInicial is { } e) _estado = e;
        _sinSegunda = await Permisos.TieneAsync(PermisoSinSegunda);
        if (!string.IsNullOrWhiteSpace(NumeroInicial)) await CambiarNumeroAsync(NumeroInicial);
        await CargarAsync();
    }

    private async Task CambiarNumeroAsync(string? numero)
    {
        _numero = numero?.Trim();
        _elegido = null;
        _noEncontrado = false;
        if (string.IsNullOrEmpty(_numero)) return;
        using var g = _pedido.Iniciar();
        var r = await Caja.ReciboPorNumeroAsync(_numero);
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo consultar el recibo."); return; }
        _elegido = r.Value;
        _noEncontrado = r.Value is null;
        if (_elegido is not null) _numero = _elegido.Number;
    }

    private async Task CargarAsync()
    {
        using var carga = _carga.Iniciar();
        var r = await AnulacionesApi.AnulacionesAsync(_estado == 0 ? null : _estado);
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudieron consultar las anulaciones."); return; }
        _anulaciones = r.Value ?? [];
    }

    private static string Estado(int e) => e switch { 1 => "Pendiente de aprobar", 2 => "Aplicada", 3 => "Rechazada", _ => "—" };

    private async Task PedirAsync()
    {
        if (_elegido is not { Status: 1 } recibo || string.IsNullOrWhiteSpace(_motivo))
        {
            await Notification.WarningAsync("Indique un recibo vigente y el motivo.");
            return;
        }
        using var g = _pedido.Iniciar();
        var r = await AnulacionesApi.PedirAsync(recibo.PublicId, _motivo.Trim(), _clave);
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo pedir la anulación."); return; }
        _clave = new();
        _numero = null;
        _motivo = "";
        _elegido = null;
        if (_sinSegunda)
        {
            // Con «Anular recibos sin una segunda persona» la anulación se aplica en el mismo clic; si esta segunda llamada falla, queda pendiente en la lista.
            var aplicada = await AnulacionesApi.AprobarAsync(r.Value!.PublicId, null, new ClaveDeOperacion());
            if (!aplicada.IsSuccess) await Notification.ErrorAsync(aplicada.ErrorMessage ?? "La anulación quedó pendiente: apruébela en la lista.");
            else await Notification.SuccessAsync($"Recibo {recibo.Number} anulado con el documento {aplicada.Value!.Number}.");
        }
        else
        {
            await Notification.SuccessAsync($"Anulación del recibo {recibo.Number} pedida: la aprueba otra persona.");
        }
        await CargarAsync();
    }

    private async Task AprobarAsync(AnulacionDto a)
    {
        using var g = _carga.Iniciar();
        var r = await AnulacionesApi.AprobarAsync(a.PublicId, _decision, new ClaveDeOperacion());
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo aprobar la anulación."); return; }
        await Notification.SuccessAsync(r.Value!.Status == 2 ? $"Recibo {a.ReceiptNumber} anulado con el documento {r.Value.Number}." : "Aprobación registrada.");
        await CargarAsync();
    }

    private async Task RechazarAsync(AnulacionDto a)
    {
        if (string.IsNullOrWhiteSpace(_decision)) { await Notification.WarningAsync("Escriba el motivo del rechazo."); return; }
        using var g = _carga.Iniciar();
        var r = await AnulacionesApi.RechazarAsync(a.PublicId, _decision.Trim(), new ClaveDeOperacion());
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo rechazar la anulación."); return; }
        await Notification.SuccessAsync("Anulación rechazada: el recibo sigue vigente.");
        await CargarAsync();
    }

    private async Task DocumentoAsync(AnulacionDto a)
    {
        var r = await AnulacionesApi.DocumentoAsync(a.PublicId);
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo generar el documento."); return; }
        await Descargas.GuardarAsync(r.Value!.Nombre, r.Value.TipoContenido, r.Value.Contenido);
    }
}
