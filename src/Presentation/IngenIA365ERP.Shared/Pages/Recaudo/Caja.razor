@page "/recaudo/caja"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using IngenIA365ERP.Shared.Components.Personas
@using IngenIA365ERP.Shared.Components.Recaudo
@using IngenIA365ERP.Shared.Services.Http
@using IngenIA365ERP.Shared.Services.Nomina
@using IngenIA365ERP.Shared.Services.Recaudo
@inject CajaClient Cliente
@inject SesionesClient Sesiones
@inject INotificationService Notification
@inject DescargaDeArchivos Descargas
@inject HttpClient Http
@inject CumplimientoClient CumplimientoApi
@inject MediosDePagoClient CatalogoDeMedios

<PageTitle>Caja - IngenIA365ERP</PageTitle>

@* Feature 015, US3 (T0120; R-35; FR-018, FR-037 a FR-045, FR-188 a FR-191; SC-003): la caja en tres pasos —la persona (el buscador común, que acepta el lector
   y el documento), qué paga (cada ítem simulado con su módulo, con su aviso y las dos alternativas del abono extraordinario) y los medios con su imputación—
   y la confirmación todo o nada. Atajos: F2 buscar, F4 todo lo exigible (R1), F8 medios, F9 confirmar, Esc cancelar. Los rechazos se leen por su código, nunca por el texto. La misma
   clave de operación se repite al reconfirmar tras «la distribución cambió» o tras la aprobación presente. *@
<PermissionGate Required="Receipts.Receipt.Register" MostrarAviso="true">
<div class="pagina" tabindex="0" @onkeydown="@AtajoAsync">
    <div class="page-header">
        <h3>Caja</h3>
        <div class="toolbar">
            <SfButton CssClass="e-outline" OnClick="@CancelarAsync">Cancelar (Esc)</SfButton>
        </div>
    </div>

    <IndicadorDeCarga Cargando="@_carga.Activa" Texto="Cargando…">
        @if (_sesion is null)
        {
            <p class="texto-alerta">No tiene una sesión de caja abierta: ábrala en <a href="/recaudo/sesiones">Sesiones de caja</a>.</p>
        }
        else
        {
            <p class="texto-tenue">Caja @_sesion.CollectionPointCode · @_sesion.CashBoxCode · @SesionesClient.Estado(_sesion.Status)</p>
        }
    </IndicadorDeCarga>

    @if (_sesion is not null)
    {
        <div class="info-card">
            <h4>1. Persona (F2)</h4>
            <PersonSearchPicker @ref="_buscador" Selected="_persona" SelectedChanged="@PersonaElegidaAsync" PermitirCrear="true" OnCrearPersona="@CrearPersona" Compacto="true" />
            @* Decisión del dueño del 2026-10-24 (T0113): también por el número del crédito o de la cuenta, que Cartera y Captaciones resuelven por su puerto. *@
            <div class="toolbar">
                <input class="e-input" placeholder="Número del crédito o de la cuenta" @bind="_numeroDeObligacion" @onkeydown="@NumeroTecladoAsync" maxlength="40" />
                <SfButton CssClass="e-outline" Disabled="@(_cargaDePagables.Activa || string.IsNullOrWhiteSpace(_numeroDeObligacion))" OnClick="@BuscarPorNumeroAsync">Buscar por número</SfButton>
                @* Feature 015, R1 (T0365; FR-037): las obligaciones donde la persona es codeudora, a pedido. *@
                <label class="campo"><input type="checkbox" checked="@_comoCodeudor" @onchange="@(e => CambiarCodeudorAsync(e.Value is true))" /> También como codeudor</label>
            </div>
            <IndicadorDeCarga Cargando="@_cargaDePagables.Activa" Texto="Consultando lo que puede pagar…">
                @if (_pagables is not null)
                {
                    <p><strong>@_pagables.PersonName</strong> @(_pagables.IsAssociate ? "· asociado" : "· no asociado")</p>
                    @foreach (var n in _pagables.Notices) { <p class="texto-alerta">@n</p> }
                    <table class="data-grid">
                        <thead><tr><th>Producto</th><th>Exigible hoy</th><th>Cuota</th><th>Vencido</th><th>Para cancelar</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var o in _pagables.Obligations?.Obligations ?? [])
                            {
                                <tr>
                                    <td>@o.Number · @o.CreditLineName @(o.DaysPastDue > 0 ? $"· {o.DaysPastDue} días de mora" : "")</td>
                                    <td>@o.DueToday.ToString("N0")</td><td>@o.CycleInstallment.ToString("N0")</td><td>@o.PastDue.ToString("N0")</td><td>@o.PayoffAmount.ToString("N0")</td>
                                    <td><SfButton CssClass="e-flat" Disabled="@(o.BlockReasons.Count > 0)" OnClick="@(() => AgregarCredito(o))">Pagar</SfButton>
                                        @string.Join(", ", o.BlockReasons)</td>
                                </tr>
                            }
                            @foreach (var c in _pagables.Accounts?.Accounts ?? [])
                            {
                                <tr>
                                    <td>@c.Number · @c.LineName</td><td colspan="4">@string.Join(" · ", (_pagables.DueInstallments?.Installments ?? []).Where(x => x.AccountPublicId == c.AccountPublicId).Select(x => $"{x.Period}: {x.Pending:N0}"))</td>
                                    <td><SfButton CssClass="e-flat" Disabled="@(!c.AcceptsDeposits)" OnClick="@(() => AgregarCuenta(c))">Consignar</SfButton></td>
                                </tr>
                            }
                            @if (PuedeDejarPendiente(1))
                            {
                                @* Feature 015, R1 (T0365; FR-046): Cartera no está activada y la persona está en su carga aplicada: el valor queda pendiente de aplicar. *@
                                <tr><td>Crédito de la carga (Cartera sin activar)</td><td colspan="4">Queda como recaudo pendiente de aplicar el día de la activación.</td>
                                    <td><SfButton CssClass="e-flat" OnClick="@(() => AgregarPendiente(1))">Dejar pendiente</SfButton></td></tr>
                            }
                            @if (PuedeDejarPendiente(2))
                            {
                                <tr><td>Cuenta de la carga (Captaciones sin activar)</td><td colspan="4">Queda como recaudo pendiente de aplicar el día de la activación.</td>
                                    <td><SfButton CssClass="e-flat" OnClick="@(() => AgregarPendiente(2))">Dejar pendiente</SfButton></td></tr>
                            }
                            @* R1 (T0398; FR-049): las facturas comerciales con saldo, con tercero y factura de cruce; nunca como concepto vario. *@
                            @foreach (var f in _cuentasPorCobrar)
                            {
                                <tr><td>Factura @f.InvoiceNumber · @f.Date.ToString("dd/MM/yyyy")</td><td colspan="3">Saldo @f.Pending.ToString("N0")</td><td></td>
                                    <td><SfButton CssClass="e-flat" OnClick="@(() => AgregarCuentaPorCobrar(f))">Cobrar</SfButton></td></tr>
                            }
                            @foreach (var k in _pagables.MiscConcepts)
                            {
                                <tr><td>Concepto @k.Code · @k.Name</td><td colspan="4"></td><td><SfButton CssClass="e-flat" OnClick="@(() => AgregarConcepto(k))">Cobrar</SfButton></td></tr>
                            }
                        </tbody>
                    </table>
                }
            </IndicadorDeCarga>
        </div>

        <div class="info-card">
            <h4>2. Qué paga</h4>
            <IndicadorDeCarga Cargando="@_cargaDeItems.Activa" Texto="Simulando con cada módulo…">
                <table class="data-grid">
                    <thead><tr><th>Producto</th><th>Modalidad</th><th>Valor</th><th>Elección / aviso</th><th>Simulación</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var i in _items)
                        {
                            var simulado = _operacion?.Items.FirstOrDefault(x => x.ItemId == i.ItemId);
                            <tr class="@(_rechazados.ContainsKey(i.ItemId!.Value) ? "fila-error" : "")">
                                <td>@_rotulos.GetValueOrDefault(i.ItemId!.Value)</td>
                                <td>
                                    @if (i.Target == 1)
                                    {
                                        <select class="e-input" value="@i.LoanModality" @onchange="@(e => CambiarModalidad(i, e.Value?.ToString()))">
                                            @foreach (var m in new[] { 3, 2, 1, 5, 4, 7 }) { <option value="@m">@CajaClient.Modalidad(m)</option> }
                                        </select>
                                    }
                                    else { @CajaClient.Destino(i.Target) }
                                </td>
                                <td><input class="e-input" type="number" min="0" value="@i.Amount" @onchange="@(e => CambiarValor(i, e.Value?.ToString()))" /></td>
                                <td>
                                    @if (i.LoanModality == 5)
                                    {
                                        <select class="e-input" value="@(i.Choice?.ToString() ?? "")" @onchange="@(e => CambiarEleccion(i, e.Value?.ToString()))">
                                            <option value="">Elección del deudor…</option><option value="1">Reducir el plazo</option><option value="2">Reducir la cuota</option>
                                        </select>
                                        @foreach (var a in simulado?.Alternatives ?? []) { <div class="texto-tenue">@(a.Choice == 1 ? "Plazo" : "Cuota"): aplica @a.AppliedAmount.ToString("N0")</div> }
                                    }
                                    @if (simulado?.AdvanceWithoutPrincipal == true)
                                    {
                                        <label><input type="checkbox" checked="@i.AdvanceNoticeAccepted" @onchange="@(e => AceptarAviso(i, e.Value is true))" /> El deudor acepta que el anticipo no abona a capital</label>
                                    }
                                </td>
                                <td>@(simulado is null ? "" : $"aplica {simulado.SimulatedApplied:N0}") @string.Join(" · ", simulado?.Notices ?? [])
                                    @if (_rechazados.TryGetValue(i.ItemId!.Value, out var motivo)) { <div class="texto-alerta">@motivo</div> }</td>
                                <td><SfButton CssClass="e-flat" OnClick="@(() => Quitar(i))">Quitar</SfButton></td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="toolbar">
                    <SfButton CssClass="e-outline" Disabled="@(_pagables is null || _cargaDeItems.Activa)" OnClick="@PreseleccionarAsync">Todo lo exigible (F4)</SfButton>
                    <SfButton CssClass="e-outline" Disabled="@(_items.Count == 0)" OnClick="@SimularAsync">Simular</SfButton>
                    <span>Total: <strong>@_items.Sum(i => i.Amount).ToString("N0")</strong></span>
                </div>
            </IndicadorDeCarga>
        </div>

        <div class="info-card">
            <h4>3. Medios (F8) y confirmación (F9)</h4>
            <IndicadorDeCarga Cargando="@_cargaDeMedios.Activa" Texto="Imputando…">
                @foreach (var m in _medios)
                {
                    <div class="form-grid">
                        <label class="campo">Medio
                            <select class="e-input" value="@m.PaymentMeansPublicId" @onchange="@(e => CambiarMedio(m, e.Value?.ToString()))">
                                @foreach (var x in _sesion.Means) { <option value="@x.PaymentMeansPublicId">@x.Code · @x.Name</option> }
                            </select>
                        </label>
                        <label class="campo">Valor <input class="e-input" type="number" min="0" value="@m.Amount" @onchange="@(e => CambiarValorDelMedio(m, e.Value?.ToString()))" /></label>
                        <label class="campo">Referencia <input class="e-input" value="@m.Reference" @onchange="@(e => CambiarReferencia(m, e.Value?.ToString()))" /></label>
                        @* Segunda ronda del 2026-10-27 (D-f; FR-231): la cuenta propia a la que entró la transferencia o la consignación, entre las habilitadas en esta caja. *@
                        @if (EntraAUnaCuenta(m))
                        {
                            var opciones = _cuentasDeTransferencia.Where(o => o.PaymentMeansPublicId == m.PaymentMeansPublicId).ToList();
                            <label class="campo">Cuenta propia *
                                <select class="e-input" value="@(m.OwnBankAccountPublicId ?? (opciones.Count == 1 ? opciones[0].OwnBankAccountPublicId : null))"
                                        @onchange="@(e => _medios[_medios.IndexOf(m)] = m with { OwnBankAccountPublicId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null })">
                                    @if (opciones.Count != 1) { <option value="">Elija la cuenta</option> }
                                    @foreach (var o in opciones) { <option value="@o.OwnBankAccountPublicId">@o.AccountLabel</option> }
                                </select>
                            </label>
                            @if (opciones.Count == 0) { <span class="aviso aviso-error">Este medio no tiene cuenta habilitada en la caja.</span> }
                        }
                    </div>
                    @if (EsTarjeta(m))
                    {
                        @* Feature 015, R1 (T0358; FR-024, FR-031): la tarjeta lleva el datáfono, el lote y la aprobación; el número de la tarjeta nunca se registra. *@
                        <div class="form-grid">
                            <label class="campo">Datáfono *
                                <select class="e-input" value="@m.CardTerminalPublicId" @onchange="@(e => _medios[_medios.IndexOf(m)] = m with { CardTerminalPublicId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null })">
                                    <option value="">— Elija —</option>
                                    @foreach (var d in _datafonos) { <option value="@d.CardTerminalPublicId">@d.Code · @d.CardAcquirerCode</option> }
                                </select>
                            </label>
                            <label class="campo">Lote * <input class="e-input" maxlength="20" value="@m.TerminalBatch" @onchange="@(e => _medios[_medios.IndexOf(m)] = m with { TerminalBatch = e.Value?.ToString() })" /></label>
                            <label class="campo">Aprobación * <input class="e-input" maxlength="20" value="@m.ApprovalCode" @onchange="@(e => _medios[_medios.IndexOf(m)] = m with { ApprovalCode = e.Value?.ToString() })" /></label>
                        </div>
                        <p class="texto-apoyo">No escriba el número de la tarjeta: sólo el lote y la aprobación del comprobante.</p>
                    }
                    @if (EsBono(m))
                    {
                        <label class="campo">Número del bono * <input class="e-input" maxlength="40" value="@m.VoucherNumber" @onchange="@(e => _medios[_medios.IndexOf(m)] = m with { VoucherNumber = e.Value?.ToString() })" /></label>
                    }
                    @if (EsCheque(m))
                    {
                        @* US15 (T0219): un cheque trae banco librado, número, cuenta, fecha, plaza y girador si no es el pagador. *@
                        <div class="form-grid">
                            <label class="campo">Banco librado
                                <select class="e-input" value="@m.Check?.DraweeBankPublicId" @onchange="@(e => CambiarCheque(m, c => c with { DraweeBankPublicId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : Guid.Empty }))">
                                    <option value="">— Elija —</option>
                                    @foreach (var b in _bancos) { <option value="@b.PublicId">@b.Name</option> }
                                </select>
                            </label>
                            <label class="campo">Número <input class="e-input" maxlength="20" value="@m.Check?.CheckNumber" @onchange="@(e => CambiarCheque(m, c => c with { CheckNumber = e.Value?.ToString() ?? "" }))" /></label>
                            <label class="campo">Cuenta <input class="e-input" maxlength="30" value="@m.Check?.AccountNumber" @onchange="@(e => CambiarCheque(m, c => c with { AccountNumber = e.Value?.ToString() ?? "" }))" /></label>
                            <label class="campo">Fecha <input class="e-input" type="date" value="@m.Check?.IssueDate.ToString("yyyy-MM-dd")" @onchange="@(e => CambiarCheque(m, c => c with { IssueDate = DateOnly.TryParse(e.Value?.ToString(), out var f) ? f : c.IssueDate }))" /></label>
                            <label class="campo"><input type="checkbox" checked="@(m.Check?.SamePlace ?? true)" @onchange="@(e => CambiarCheque(m, c => c with { SamePlace = e.Value is true }))" /> Misma plaza</label>
                            <label class="campo">Girador (si no es el pagador) <input class="e-input" maxlength="200" value="@m.Check?.DrawerName" @onchange="@(e => CambiarCheque(m, c => c with { DrawerName = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value?.ToString() }))" /></label>
                        </div>
                    }
                }
                <div class="toolbar">
                    <SfButton CssClass="e-outline" OnClick="@AgregarMedio">Agregar medio</SfButton>
                    <SfButton CssClass="e-outline" Disabled="@(_operacion is null || _medios.Count == 0)" OnClick="@ImputarAsync">Imputar</SfButton>
                    <SfButton CssClass="e-primary" Disabled="@(_operacion is null || _operacion.Imputation.Count == 0 || _confirmando.Activa)" OnClick="@(() => ConfirmarAsync(null))">Confirmar (F9)</SfButton>
                </div>
                @if (_operacion is not null && _operacion.Imputation.Count > 0)
                {
                    <p>Medios @_operacion.TotalMeans.ToString("N0") · aplicado @_operacion.TotalItems.ToString("N0") · vueltas <strong>@_operacion.Change.ToString("N0")</strong></p>
                }
                @if (_pideDeclaracion)
                {
                    <div class="form-grid">
                        <label class="campo campo-ancho">Origen de los fondos * <input class="e-input" @bind="_origen" maxlength="500" /></label>
                        <label class="campo">Soporte (adjunto) * <input class="e-input" @bind="_soporteDeDeclaracion" /></label>
                        <SfButton CssClass="e-primary" OnClick="@DeclararAsync">Registrar la declaración</SfButton>
                    </div>
                }
                @if (_pideQuienEfectua)
                {
                    @* Decisión del dueño del 2026-10-24 (T0115): obligatorio con el efectivo en el umbral de la transacción individual o si el pagador no es el titular. *@
                    <p class="texto-alerta">@_motivoQuienEfectua</p>
                    <label class="campo campo-ancho">Quién efectúa el pago *</label>
                    <PersonSearchPicker Selected="_quienEfectua" SelectedChanged="@(p => _quienEfectua = p)" Compacto="true" />
                    <SfButton CssClass="e-primary" Disabled="@(_quienEfectua is null)" OnClick="@RegistrarQuienEfectuaAsync">Registrar y confirmar</SfButton>
                }
            </IndicadorDeCarga>
        </div>

        @if (_aprobacion is not null)
        {
            <AprobacionPresenteDeRecaudo Solicitud="_aprobacion.Value" Huella="@_huella" Motivo="Recibo con fecha valor anterior" Aprobada="@(id => ConfirmarAsync(id))"
                                         Cancelada="@(() => _aprobacion = null)" />
        }

        @if (_recibo is not null)
        {
            <div class="info-card">
                <h4>Recibo @_recibo.Number</h4>
                @foreach (var a in _recibo.Applications) { <p>@a.Ordinal. @CajaClient.Destino(a.Target) @a.ProductNumber · @a.Amount.ToString("N0") · comprobante @a.ModuleVoucherNumber</p> }
                <div class="toolbar">
                    <SfButton CssClass="e-outline" OnClick="@(() => ImprimirAsync(false))">Imprimir tirilla</SfButton>
                    <SfButton CssClass="e-outline" OnClick="@(() => ImprimirAsync(true))">Imprimir carta</SfButton>
                    @* Feature 015, R1 (T0365; FR-020, FR-045): por correo, sólo con la autorización del canal; el servidor dice si salió. *@
                    <input class="e-input" placeholder="Correo (opcional)" @bind="_correoDelAviso" maxlength="200" />
                    <SfButton CssClass="e-outline" Disabled="@_enviandoAviso.Activa" OnClick="@AvisarAsync">Enviar por correo</SfButton>
                    <SfButton CssClass="e-primary" OnClick="@NuevaAsync">Nueva operación</SfButton>
                </div>
            </div>
        }
    }
</div>

<PersonaDialog @bind-Visible="_crearPersona" DocumentoInicial="@_documentoNuevo" CapturarAutorizacion="true" Compacto="true" OnGuardado="@PersonaCreadaAsync" />
</PermissionGate>

@code {
    private readonly EstadoDeCarga _carga = new(), _cargaDePagables = new(), _cargaDeItems = new(), _cargaDeMedios = new(), _confirmando = new();
    private ClaveDeOperacion _claveDeCreacion = new(), _claveDeItems = new(), _claveDeMedios = new(), _claveDeConfirmacion = new(), _claveDeDeclaracion = new();
    private PersonSearchPicker? _buscador;
    private PersonSearchPicker.PersonSearchItem? _persona;
    private SesionDeCajaDto? _sesion;
    private LoQuePuedePagarDto? _pagables;
    private OperacionDeCajaDto? _operacion;
    private ReciboDto? _recibo;
    private readonly List<ItemPedidoRequest> _items = [];
    private IReadOnlyList<CuentaPorCobrarComercialDto> _cuentasPorCobrar = [];
    private readonly Dictionary<Guid, string> _rotulos = [];
    private readonly Dictionary<Guid, string> _rechazados = [];
    private readonly List<MedioDeCajaRequest> _medios = [];
    private Guid? _aprobacion;
    private string? _huella, _origen, _soporteDeDeclaracion, _documentoNuevo, _numeroDeObligacion;
    private bool _pideDeclaracion, _crearPersona, _pideQuienEfectua;
    private PersonSearchPicker.PersonSearchItem? _quienEfectua;
    private string? _motivoQuienEfectua;
    private ClaveDeOperacion _claveDeQuienEfectua = new();

    protected override async Task OnInitializedAsync()
    {
        using var carga = _carga.Iniciar();
        var r = await Sesiones.ActualAsync();
        _sesion = r.IsSuccess ? r.Value : null;
        if (_sesion is { } s && s.Means.Any(x => x.Class is ClaseConsignacion or ClaseTransferencia))
        {
            var c = await Cliente.CuentasDeTransferenciaAsync(s.PublicId);
            if (c.IsSuccess && c.Value is not null) _cuentasDeTransferencia = c.Value;
        }
        if (_sesion?.Means.Any(x => x.Class == ClaseCheque) == true)
            _bancos = await Http.TryGetListAsync<BancoDeCheque>("/api/core/banks?PageNumber=1&PageSize=500&SortBy=name");
        if (_sesion?.Means.Any(x => x.Class is ClaseTarjetaDeCredito or ClaseTarjetaDebito) == true)
        {
            var d = await CatalogoDeMedios.DatafonosAsync(activos: true);
            if (d.IsSuccess && d.Value is not null) _datafonos = d.Value;
        }
    }

    // Feature 015, R1 (T0358): tarjetas (con su datáfono, lote y aprobación) y bonos.
    private const int ClaseTarjetaDeCredito = 2, ClaseTarjetaDebito = 3, ClaseBono = 8;
    private IReadOnlyList<DatafonoDto> _datafonos = [];

    private bool EsTarjeta(MedioDeCajaRequest m) =>
        _sesion?.Means.FirstOrDefault(x => x.PaymentMeansPublicId == m.PaymentMeansPublicId)?.Class is ClaseTarjetaDeCredito or ClaseTarjetaDebito;

    private bool EsBono(MedioDeCajaRequest m) => _sesion?.Means.FirstOrDefault(x => x.PaymentMeansPublicId == m.PaymentMeansPublicId)?.Class == ClaseBono;

    // Feature 015, US15 (T0219): los datos del cheque recibido como medio.
    private const int ClaseCheque = 9;

    // Segunda ronda del 2026-10-27 (D-f): la consignación y la transferencia entran a una cuenta propia habilitada en la caja.
    private const int ClaseConsignacion = 6, ClaseTransferencia = 7;
    private IReadOnlyList<OpcionDeCuentaDto> _cuentasDeTransferencia = [];

    private bool EntraAUnaCuenta(MedioDeCajaRequest m) =>
        _sesion?.Means.FirstOrDefault(x => x.PaymentMeansPublicId == m.PaymentMeansPublicId)?.Class is ClaseConsignacion or ClaseTransferencia;
    private sealed record BancoDeCheque(Guid PublicId, string Name);
    private List<BancoDeCheque> _bancos = [];

    private bool EsCheque(MedioDeCajaRequest m) => _sesion?.Means.FirstOrDefault(x => x.PaymentMeansPublicId == m.PaymentMeansPublicId)?.Class == ClaseCheque;

    private void CambiarCheque(MedioDeCajaRequest m, Func<ChequeDeCajaRequest, ChequeDeCajaRequest> cambio)
    {
        var actual = m.Check ?? new ChequeDeCajaRequest(Guid.Empty, "", "", DateOnly.FromDateTime(DateTime.Today));
        _medios[_medios.IndexOf(m)] = m with { Check = cambio(actual) };
    }

    private async Task AtajoAsync(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "F2": _persona = null; StateHasChanged(); break;
            case "F4" when _pagables is not null: await PreseleccionarAsync(); break;
            case "F8": AgregarMedio(); break;
            case "F9" when _operacion is not null && _operacion.Imputation.Count > 0: await ConfirmarAsync(null); break;
            case "Escape": await CancelarAsync(); break;
        }
    }

    private void CrearPersona(string documento)
    {
        _documentoNuevo = documento;
        _crearPersona = true;
    }

    private async Task PersonaCreadaAsync(Guid persona)
    {
        _crearPersona = false;
        await CargarPagablesAsync(persona);
    }

    private async Task PersonaElegidaAsync(PersonSearchPicker.PersonSearchItem? persona)
    {
        _persona = persona;
        if (persona is null) { _pagables = null; return; }
        await CargarPagablesAsync(persona.PublicId);
    }

    private async Task NumeroTecladoAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await BuscarPorNumeroAsync();
    }

    private async Task BuscarPorNumeroAsync()
    {
        if (string.IsNullOrWhiteSpace(_numeroDeObligacion)) return;
        _persona = null;
        await CargarPagablesAsync(null, _numeroDeObligacion.Trim());
    }

    // Feature 015, R1 (T0365): codeudor, F4, recaudo pendiente de aplicar y aviso por correo.
    private bool _comoCodeudor;
    private string? _correoDelAviso;
    private readonly EstadoDeCarga _enviandoAviso = new();
    private ClaveDeOperacion _claveDePreseleccion = new(), _claveDeAviso = new();

    private async Task CambiarCodeudorAsync(bool incluir)
    {
        _comoCodeudor = incluir;
        if (_pagables is not null) await CargarPagablesAsync(_pagables.PersonPublicId);
    }

    /// <summary>1 = Cartera, 2 = Captaciones: el módulo no está activado (estado 1) y, en cuentas, la persona está en la carga.</summary>
    private bool PuedeDejarPendiente(int modulo) => _pagables is not null && modulo switch
    {
        1 => _pagables.Obligations?.LendingStatus == 1,
        _ => (_pagables.DueInstallments?.DepositsStatus == 1 || _pagables.DueInstallments?.ContributionsStatus == 1)
             && (_pagables.DueInstallments?.MigratedNotActivated ?? []).Contains(_pagables.PersonPublicId),
    };

    private void AgregarPendiente(int modulo) =>
        Agregar(new ItemPedidoRequest(5, 0, PendingTarget: modulo), modulo == 1 ? "Pendiente de aplicar · crédito" : "Pendiente de aplicar · cuenta");

    private async Task PreseleccionarAsync()
    {
        using var carga = _cargaDeItems.Iniciar();
        if (!await AsegurarOperacionAsync()) return;
        _rechazados.Clear();
        var r = await Cliente.PreseleccionarAsync(_operacion!.PublicId, _comoCodeudor, _claveDePreseleccion);
        _claveDePreseleccion = new ClaveDeOperacion();
        if (!r.IsSuccess)
        {
            if (r.ErrorCode == "Receipts.Receipt.ItemRejected")
                foreach (var x in r.Dato<List<RechazoDeItem>>("items") ?? []) _rechazados[x.ItemId] = x.Message;
            await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo preseleccionar lo exigible.");
            return;
        }
        _operacion = r.Value;
        // Los ítems de la pantalla pasan a ser los de la operación, que el cajero puede quitar.
        _items.Clear();
        foreach (var i in _operacion!.Items)
        {
            _items.Add(new ItemPedidoRequest(i.Target, i.Amount, i.ProductPublicId, i.BeneficiaryPersonPublicId, i.LoanModality, i.AccountModality, i.Choice,
                i.InstallmentNumber, i.InstallmentPublicIds, i.AdvanceNoticeAccepted, i.MiscConceptPublicId, i.CrossDocument, i.InvoicePublicId, i.ItemId,
                i.PendingTarget, i.LoadObligationPublicId, i.ProductReference));
            if (!_rotulos.ContainsKey(i.ItemId)) _rotulos[i.ItemId] = $"{CajaClient.Destino(i.Target)} {i.ProductNumber}";
        }
        _pideDeclaracion = _operacion.Items.Any(x => x.RequiresSourceOfFunds) && !_operacion.SourceOfFundsDeclared;
    }

    private async Task AvisarAsync()
    {
        if (_recibo is null) return;
        using var envio = _enviandoAviso.Iniciar();
        var r = await Cliente.AvisarAsync(_recibo.PublicId, string.IsNullOrWhiteSpace(_correoDelAviso) ? null : _correoDelAviso.Trim(), _claveDeAviso);
        _claveDeAviso = new ClaveDeOperacion();
        if (!r.IsSuccess || r.Value is null) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo enviar el aviso."); return; }
        if (r.Value.Outcome == "Sent") await Notification.SuccessAsync(r.Value.Message);
        else await Notification.WarningAsync(r.Value.Message);
    }

    private async Task CargarPagablesAsync(Guid? persona, string? numero = null)
    {
        using var carga = _cargaDePagables.Iniciar();
        var r = await Cliente.LoQuePuedePagarAsync(persona, null, _comoCodeudor, numero: numero);
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo consultar lo que puede pagar."); return; }
        _pagables = r.Value;
        _cuentasPorCobrar = [];
        if (r.Value?.PersonPublicId is { } quien)
        {
            var cxc = await Cliente.CuentasPorCobrarAsync(quien);
            if (cxc.IsSuccess) _cuentasPorCobrar = cxc.Value ?? [];
        }
        _items.Clear();
        _rotulos.Clear();
        _medios.Clear();
        _operacion = null;
        _recibo = null;
        _claveDeCreacion = new ClaveDeOperacion();
        _claveDeConfirmacion = new ClaveDeOperacion();
    }

    private void Agregar(ItemPedidoRequest item, string rotulo)
    {
        var conId = item with { ItemId = Guid.NewGuid() };
        _items.Add(conId);
        _rotulos[conId.ItemId!.Value] = rotulo;
    }

    private void AgregarCredito(ObligacionPagableDto o) =>
        Agregar(new ItemPedidoRequest(1, o.CycleInstallment > 0 ? o.CycleInstallment : o.DueToday, o.ObligationPublicId, LoanModality: 3), $"Crédito {o.Number}");

    private void AgregarCuenta(CuentaPagableDto c)
    {
        var exigibles = (_pagables?.DueInstallments?.Installments ?? []).Where(x => x.AccountPublicId == c.AccountPublicId).ToList();
        Agregar(new ItemPedidoRequest(2, exigibles.Sum(x => x.Pending), c.AccountPublicId, AccountModality: exigibles.Count > 0 ? 2 : 1,
            InstallmentPublicIds: exigibles.Select(x => x.InstallmentPublicId).ToList()), $"Cuenta {c.Number}");
    }

    private void AgregarCuentaPorCobrar(CuentaPorCobrarComercialDto f) =>
        Agregar(new ItemPedidoRequest(4, f.Pending, CrossDocument: f.InvoiceNumber, InvoicePublicId: f.AccountingDocumentPublicId), $"Factura {f.InvoiceNumber}");

    private void AgregarConcepto(ConceptoVarioPagableDto k) => Agregar(new ItemPedidoRequest(3, 0, MiscConceptPublicId: k.MiscConceptPublicId), $"Concepto {k.Code}");

    private void Reemplazar(ItemPedidoRequest viejo, ItemPedidoRequest nuevo) => _items[_items.IndexOf(viejo)] = nuevo;

    private void CambiarModalidad(ItemPedidoRequest i, string? valor) => Reemplazar(i, i with { LoanModality = int.TryParse(valor, out var m) ? m : 3, Choice = null });

    private void CambiarValor(ItemPedidoRequest i, string? valor) => Reemplazar(i, i with { Amount = decimal.TryParse(valor, out var v) ? v : 0m });

    private void CambiarEleccion(ItemPedidoRequest i, string? valor) => Reemplazar(i, i with { Choice = int.TryParse(valor, out var c) ? c : null });

    private void AceptarAviso(ItemPedidoRequest i, bool acepta) => Reemplazar(i, i with { AdvanceNoticeAccepted = acepta });

    private void Quitar(ItemPedidoRequest i) => _items.Remove(i);

    private async Task<bool> AsegurarOperacionAsync()
    {
        if (_operacion is not null) return true;
        if (_sesion is null || _pagables is null) return false;
        var r = await Cliente.CrearAsync(new CrearOperacionRequest(_sesion.PublicId, _pagables.PersonPublicId, null, null, null, null, null), _claveDeCreacion);
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo empezar la operación."); return false; }
        _operacion = r.Value;
        return true;
    }

    private async Task SimularAsync()
    {
        using var carga = _cargaDeItems.Iniciar();
        if (!await AsegurarOperacionAsync()) return;
        _rechazados.Clear();
        var r = await Cliente.ItemsAsync(_operacion!.PublicId, _items, _claveDeItems);
        _claveDeItems = new ClaveDeOperacion();
        if (!r.IsSuccess)
        {
            if (r.ErrorCode == "Receipts.Receipt.ItemRejected")
                foreach (var x in r.Dato<List<RechazoDeItem>>("items") ?? []) _rechazados[x.ItemId] = x.Message;
            await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo simular.");
            return;
        }
        _operacion = r.Value;
        _pideDeclaracion = _operacion!.Items.Any(x => x.RequiresSourceOfFunds) && !_operacion.SourceOfFundsDeclared;
    }

    private void AgregarMedio()
    {
        if (_sesion is null || _sesion.Means.Count == 0) return;
        var pendiente = _items.Sum(i => i.Amount) - _medios.Sum(m => m.Amount);
        _medios.Add(new MedioDeCajaRequest(_sesion.Means[0].PaymentMeansPublicId, Math.Max(0m, pendiente), MeansId: Guid.NewGuid()));
    }

    private void CambiarMedio(MedioDeCajaRequest m, string? valor) =>
        _medios[_medios.IndexOf(m)] = m with { PaymentMeansPublicId = Guid.TryParse(valor, out var g) ? g : m.PaymentMeansPublicId };

    private void CambiarValorDelMedio(MedioDeCajaRequest m, string? valor) => _medios[_medios.IndexOf(m)] = m with { Amount = decimal.TryParse(valor, out var v) ? v : 0m };

    private void CambiarReferencia(MedioDeCajaRequest m, string? valor) => _medios[_medios.IndexOf(m)] = m with { Reference = valor };

    private async Task ImputarAsync()
    {
        if (_operacion is null) return;
        using var carga = _cargaDeMedios.Iniciar();
        var r = await Cliente.MediosAsync(_operacion.PublicId, _medios, null, _claveDeMedios);
        _claveDeMedios = new ClaveDeOperacion();
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo imputar."); return; }
        _operacion = r.Value;
    }

    private async Task DeclararAsync()
    {
        if (_operacion is null || string.IsNullOrWhiteSpace(_origen) || !Guid.TryParse(_soporteDeDeclaracion, out var soporte))
        {
            await Notification.WarningAsync("Escriba el origen y adjunte el soporte.");
            return;
        }
        using var carga = _cargaDeMedios.Iniciar();
        var efectivo = _operacion.Means.Where(m => _sesion!.Means.FirstOrDefault(x => x.PaymentMeansPublicId == m.PaymentMeansPublicId)?.Class == 1).Sum(m => m.Amount);
        var r = await Cliente.DeclararAsync(_operacion.PublicId, _origen.Trim(), efectivo, soporte, _claveDeDeclaracion);
        _claveDeDeclaracion = new ClaveDeOperacion();
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo registrar la declaración."); return; }
        _operacion = r.Value;
        _pideDeclaracion = false;
    }

    private async Task RegistrarQuienEfectuaAsync()
    {
        if (_operacion is null || _quienEfectua is null) return;
        IngenIA365ERP.Shared.Services.Inventario.ResultadoDeInventario<OperacionDeCajaDto> r;
        using (_confirmando.Iniciar()) r = await Cliente.QuienEfectuaAsync(_operacion.PublicId, _quienEfectua.PublicId, _claveDeQuienEfectua);
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo registrar quién efectúa el pago."); return; }
        _claveDeQuienEfectua = new ClaveDeOperacion();
        _operacion = r.Value;
        _pideQuienEfectua = false;
        await ConfirmarAsync(null);
    }

    private async Task ConfirmarAsync(Guid? aprobacion)
    {
        if (_operacion is null) return;
        using var carga = _confirmando.Iniciar();
        var r = await Cliente.ConfirmarAsync(_operacion.PublicId, _claveDeConfirmacion, aprobacion);
        switch (r.ErrorCode)
        {
            case null when r.IsSuccess:
                _recibo = r.Value;
                _aprobacion = null;
                await Notification.SuccessAsync($"Recibo {_recibo!.Number} confirmado.");
                return;
            case "Approvals.PresenceRequired":
                _aprobacion = r.Dato<Guid?>("approvalRequestPublicId");
                _huella = r.Dato<string>("contentSha256");
                return;
            case "Receipts.Compliance.DeclarationRequired":
                _pideDeclaracion = true;
                break;
            case "Receipts.Compliance.WithholdRequired":
                // US14 (T0245): coincidencia no vinculante con «retiene»: el efectivo queda en custodia hasta que el oficial lo libere o lo devuelva.
                var retenida = await CumplimientoApi.RetenerAsync(_operacion.PublicId, new ClaveDeOperacion());
                if (retenida.IsSuccess)
                {
                    await Notification.WarningAsync("La operación quedó retenida por cumplimiento: el efectivo está en custodia hasta que el oficial decida.");
                    return;
                }
                break;
            case "Receipts.Compliance.DeliveredByRequired":
                _pideQuienEfectua = true;
                _motivoQuienEfectua = r.ErrorMessage;
                return;
            case "Receipts.Receipt.DistributionChanged":
                await SimularAsync();
                break;
            case "Receipts.Receipt.ItemRejected":
                foreach (var x in r.Dato<List<RechazoDeItem>>("items") ?? []) _rechazados[x.ItemId] = x.Message;
                break;
        }
        await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo confirmar el recibo.");
    }

    private async Task ImprimirAsync(bool carta)
    {
        if (_recibo is null) return;
        var r = await Cliente.DocumentoAsync(_recibo.PublicId, carta, copia: false);
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo generar el recibo."); return; }
        await Descargas.GuardarAsync(r.Value!.Nombre, r.Value.TipoContenido, r.Value.Contenido);
    }

    private async Task CancelarAsync()
    {
        if (_operacion is not null && _recibo is null) await Cliente.AbandonarAsync(_operacion.PublicId, new ClaveDeOperacion());
        await NuevaAsync();
    }

    private Task NuevaAsync()
    {
        _persona = null;
        _pagables = null;
        _operacion = null;
        _recibo = null;
        _items.Clear();
        _medios.Clear();
        _rechazados.Clear();
        _aprobacion = null;
        _claveDeCreacion = new ClaveDeOperacion();
        _claveDeConfirmacion = new ClaveDeOperacion();
        return Task.CompletedTask;
    }

    private sealed record RechazoDeItem(Guid ItemId, string Code, string Message);
}
