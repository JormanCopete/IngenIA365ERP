    /// <summary>
    /// Cambia un ítem por su versión nueva, buscándolo por su identificador. 2026-11-17: antes se buscaba el registro mismo (IndexOf); si entre el
    /// render y el cambio otro paso lo había reemplazado (Repartir, F4, la simulación), no aparecía, el índice era -1 y la pantalla caía con «Ha
    /// ocurrido un error inesperado».
    /// </summary>
    private void Reemplazar(ItemPedidoRequest viejo, ItemPedidoRequest nuevo)
    {
        var indice = _items.FindIndex(x => x.ItemId == viejo.ItemId);
        if (indice < 0) return;
