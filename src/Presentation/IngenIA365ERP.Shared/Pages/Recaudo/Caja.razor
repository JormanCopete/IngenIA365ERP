    private async Task<bool> SimularAsync()
    {
        using var carga = _cargaDeItems.Iniciar();
        await _cerrojoDeSimulacion.WaitAsync();
        try { return await SimularSinCerrojoAsync(); }
        finally { _cerrojoDeSimulacion.Release(); }
    }

    private async Task<bool> SimularSinCerrojoAsync()
    {
        if (!await AsegurarOperacionAsync()) return false;
        _rechazados.Clear();
        // 2026-11-16: un concepto recién agregado sin valor todavía no se manda (el servidor rechaza un ítem en cero y con él toda la lista).
        var r = await Cliente.ItemsAsync(_operacion!.PublicId, _items.Where(i => i.Amount > 0m).ToList(), _claveDeItems);
        _claveDeItems = new ClaveDeOperacion();
        if (!r.IsSuccess)
        {
            if (r.ErrorCode == "Receipts.Receipt.ItemRejected")
                foreach (var x in r.Dato<List<RechazoDeItem>>("items") ?? []) _rechazados[x.ItemId] = x.Message;
            await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo simular.");
            return false;
        }
        _operacion = r.Value;
        _pideDeclaracion = _operacion!.Items.Any(x => x.RequiresSourceOfFunds) && !_operacion.SourceOfFundsDeclared;
        return true;
    }

