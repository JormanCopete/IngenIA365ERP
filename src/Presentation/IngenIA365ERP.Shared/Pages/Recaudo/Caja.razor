    {
        var i = _items.FirstOrDefault(x => x.ItemId == viejo.ItemId) ?? viejo;
        var modalidad = int.TryParse(valor, out var m) ? m : 3;
        var o = ObligacionDe(i);
        var propuesto = (modalidad, o) switch
        {
            (1, { } ob) => ob.PayoffAmount,
            (2, { } ob) => ob.DueToday,
            (3, { } ob) => ob.CycleInstallment,
            _ => i.Amount,
        };
        Reemplazar(i, i with { LoanModality = modalidad, Choice = null, Amount = propuesto, InstallmentNumber = modalidad == 6 ? i.InstallmentNumber : null });
    }

