    /// <summary>Q12: la simulación se actualiza sola, 400 ms después del último cambio; un cambio nuevo cancela la anterior.</summary>
    private void ProgramarSimulacion()
    {
        _cobro.CambiarAPagar(TotalItems);
        _simulacion?.Cancel();
        _simulacion = new CancellationTokenSource();
        var token = _simulacion.Token;
        _ = InvokeAsync(async () =>
        {
            try
            {
                await Task.Delay(400, token);
                if (_items.Count == 0) { StateHasChanged(); return; }
                await SimularAsync();
            }
            catch (OperationCanceledException) { return; }
            catch (Exception ex)
            {
                // 2026-11-17: un fallo de la simulación en segundo plano se avisa; antes quedaba suelto.
                await Notification.ErrorAsync($"No se pudo simular ({ex.Message}).");
            }
            StateHasChanged();
        });
    }

