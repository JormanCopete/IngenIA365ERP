    private IEnumerable<ObligacionPagableDto> CreditosParaCancelar =>
        (_pagables?.Obligations?.Obligations ?? []).Where(o => o.BlockReasons.Count == 0 && o.PayoffAmount > 0m
            && (o.AdmittedModalities is not { Count: > 0 } m || m.Contains(1)));

    private bool TieneParaCancelar => _pagables is { } p
        && (CreditosParaCancelar.Any() || (p.DueInstallments?.Installments ?? []).Any(x => x.Pending > 0m) || _cuentasPorCobrar.Any(f => f.Pending > 0m));

    /// <summary>
    /// F7, 2026-11-18 (pedido del dueño): todo lo que la persona debe, sin elegirlo uno a uno. Cada crédito por su valor de cancelación (modalidad
    /// «cancelación»), las cuotas pendientes de sus cuentas y el saldo de sus facturas. Los conceptos varios y las consignaciones libres no entran: no
    /// son una deuda. Reemplaza lo que hubiera en «Qué paga».
    /// </summary>
    private void TodoParaCancelar()
    {
        if (_pagables is null || _recibo is not null) return;
        _items.Clear();
        _rotulos.Clear();
        _rechazados.Clear();
        foreach (var o in CreditosParaCancelar)
            Agregar(new ItemPedidoRequest(1, o.PayoffAmount, o.ObligationPublicId, LoanModality: 1), $"Crédito {o.Number}");
        foreach (var c in _pagables.Accounts?.Accounts ?? [])
            if (c.AcceptsDeposits && (_pagables.DueInstallments?.Installments ?? []).Any(x => x.AccountPublicId == c.AccountPublicId && x.Pending > 0m))
                AgregarCuenta(c);
        foreach (var f in _cuentasPorCobrar.Where(f => f.Pending > 0m)) AgregarCuentaPorCobrar(f);
        ProgramarSimulacion();
    }

    private async Task<bool> AsegurarOperacionAsync()
    {
        if (_operacion is not null) return true;
        if (_sesion is null || _pagables is null) return false;
