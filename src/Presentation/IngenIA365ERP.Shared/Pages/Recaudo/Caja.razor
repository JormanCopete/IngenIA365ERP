    /// <summary>
    /// Las modalidades que se ofrecen: las que admite la obligación y, si tiene algo exigible y la cooperativa así lo dice
    /// (<c>Caja.ConMoraSoloExigible</c>), sólo lo exigible, la cancelación y una cuota específica (para pagar una vencida).
    /// </summary>
    private IReadOnlyList<int> ModalidadesPermitidas(ObligacionPagableDto? o)
    {
        int[] orden = [2, 3, 1, 5, 6, 4, 7];
        var admitidas = o?.AdmittedModalities is { Count: > 0 } a ? a : orden;
        var lista = orden.Where(admitidas.Contains);
        if (o is { ConExigible: true } && (_pagables?.OverdueOnlyDue ?? true)) lista = lista.Where(m => m is 1 or 2 or 6);
        return lista.ToList();
    }

    /// <summary>
    /// Sin nada exigible y con la regla de la cooperativa, la cuota del ciclo se paga completa: el mínimo es su valor menos lo que ya tenga
    /// anticipado (lo mismo que exige el servidor).
    /// </summary>
    private decimal? MinimoDe(ItemPedidoRequest i, ObligacionPagableDto o) =>
        !o.ConExigible && (_pagables?.MinimumOneInstallment ?? true) && i.LoanModality == 3 && o.CycleInstallment - o.Advance > 0m
            ? o.CycleInstallment - o.Advance : null;

    private static readonly string[] ClasesPorDefecto = ["Aportes", "Creditos", "Ahorros", "Facturas", "Conceptos"];

    /// <summary>La prelación por clase que configuró la cooperativa (vacía = libre).</summary>
    private IReadOnlyList<string> Prelacion => _pagables?.PriorityClasses ?? [];

    private static string NombreDeClase(string clase) => clase switch
    {
        "Aportes" => "aportes", "Creditos" => "créditos", "Ahorros" => "ahorros", "Facturas" => "facturas", "Conceptos" => "conceptos", _ => clase,
    };

    private string ClaseDe(ItemPedidoRequest i) => i.Target switch
    {
        1 => "Creditos",
        2 => _pagables?.Accounts?.Accounts.FirstOrDefault(c => c.AccountPublicId == i.ProductPublicId)?.Nature == 3 ? "Aportes" : "Ahorros",
        4 => "Facturas",
        5 => i.PendingTarget == 2 ? "Ahorros" : "Creditos",
        _ => "Conceptos",
    };

    /// <summary>Lo exigible de un ítem: lo causado y vencido de un crédito, las cuotas pendientes de una cuenta, el saldo de una factura.</summary>
    private decimal ExigibleDe(ItemPedidoRequest i) => i.Target switch
    {
        1 => ObligacionDe(i)?.DueToday ?? 0m,
        2 => (_pagables?.DueInstallments?.Installments ?? []).Where(x => x.AccountPublicId == i.ProductPublicId).Sum(x => x.Pending),
        4 => _cuentasPorCobrar.FirstOrDefault(f => f.InvoiceNumber == i.CrossDocument)?.Pending ?? i.Amount,
        _ => 0m,
    };

    /// <summary>Lo que se propone para un ítem cuando sobra después de lo exigible: la cuota del ciclo, lo de cancelar la cuenta o el valor escrito.</summary>
    private decimal PropuestoDe(ItemPedidoRequest i) => i.Target switch
    {
        1 when ObligacionDe(i) is { } o => i.LoanModality switch { 1 => o.PayoffAmount, 2 => o.DueToday, _ => Math.Max(o.CycleInstallment, o.DueToday) },
        _ => Math.Max(i.Amount, ExigibleDe(i)),
    };

    /// <summary>
    /// F6: reparte lo que entrega la persona entre lo que va a pagar. Primero lo exigible de cada ítem, en el orden de la prelación de la cooperativa
    /// (o el de la lista si no hay); después, si sobra, hasta lo propuesto de cada uno en el mismo orden. Lo que todavía sobre queda «por repartir»:
    /// el cajero lo escribe en el producto que la persona quiera abonar.
    /// </summary>
    private void Repartir()
    {
        if (_valorRecibido is not > 0m || _items.Count == 0) return;
        var orden = Prelacion.Count > 0 ? Prelacion : ClasesPorDefecto;
        var items = _items.Select((x, i) => (Item: x, Indice: i))
            .OrderBy(t => Array.IndexOf([.. orden], ClaseDe(t.Item)) is var k && k < 0 ? int.MaxValue : k).ThenBy(t => t.Indice).ToList();
        var resto = _valorRecibido.Value;
        var asignado = items.ToDictionary(t => t.Indice, _ => 0m);
        foreach (var pasada in new Func<ItemPedidoRequest, decimal>[] { ExigibleDe, PropuestoDe })
            foreach (var (item, indice) in items)
            {
                if (resto <= 0m) break;
                var tope = Math.Max(0m, pasada(item) - asignado[indice]);
                var parte = Math.Min(resto, tope);
                asignado[indice] += parte;
                resto -= parte;
            }
        for (var i = 0; i < _items.Count; i++) _items[i] = _items[i] with { Amount = asignado[i] };
        _items.RemoveAll(x => x.Amount <= 0m && x.Target != 3);
        ProgramarSimulacion();
    }

