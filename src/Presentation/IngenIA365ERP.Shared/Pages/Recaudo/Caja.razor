    // Feature 015, R1 (T0365): codeudor, F4, recaudo pendiente de aplicar y aviso por correo.
    private bool _comoCodeudor;
    private string? _correoDelAviso;
    private readonly EstadoDeCarga _enviandoAviso = new();
    private ClaveDeOperacion _claveDePreseleccion = new(), _claveDeAviso = new();

    private async Task CambiarCodeudorAsync(bool incluir)
    {
        _comoCodeudor = incluir;
        if (_pagables is not null) await CargarPagablesAsync(_pagables.PersonPublicId);
    }

    /// <summary>1 = Cartera, 2 = Captaciones: el módulo no está activado (estado 1) y, en cuentas, la persona está en la carga.</summary>
    private bool PuedeDejarPendiente(int modulo) => _pagables is not null && modulo switch
    {
        1 => _pagables.Obligations?.LendingStatus == 1,
        _ => (_pagables.DueInstallments?.DepositsStatus == 1 || _pagables.DueInstallments?.ContributionsStatus == 1)
             && (_pagables.DueInstallments?.MigratedNotActivated ?? []).Contains(_pagables.PersonPublicId),
    };

    private async Task CargarPagablesAsync(Guid? persona, string? numero = null)
    {
        // 2026-11-16: la operación sin confirmar de la persona anterior se abandona (antes quedaba abierta al cambiar de persona).
        if (_operacion is not null && _recibo is null) _ = Cliente.AbandonarAsync(_operacion.PublicId, new ClaveDeOperacion());
        _valorRecibido = null;
        using var carga = _cargaDePagables.Iniciar();
        var r = await Cliente.LoQuePuedePagarAsync(persona, null, _comoCodeudor, numero: numero);
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo consultar lo que puede pagar."); return; }
        _pagables = r.Value;
        _cuentasPorCobrar = [];
        if (r.Value?.PersonPublicId is { } quien)
        {
            var cxc = await Cliente.CuentasPorCobrarAsync(quien);
            if (cxc.IsSuccess) _cuentasPorCobrar = cxc.Value ?? [];
        }
        _items.Clear();
        _rotulos.Clear();
        _cobro = new CobroMultiple(0m);
        _operacion = null;
        _recibo = null;
        _claveDeCreacion = new ClaveDeOperacion();
        _claveDeConfirmacion = new ClaveDeOperacion();
        ArmarPagable();
        StateHasChanged();
        if (_pagable.Count > 0) await Enfocar("#lista-pagable");
        // 2026-11-16 (pedido del dueño): al entrar, lo exigible (lo causado y vencido) queda ya en «Qué paga».
        if (TieneExigible) await PreseleccionarAsync();
    }

    /// <summary>La persona tiene algo exigible: cuotas causadas o vencidas de créditos o cuotas pendientes de sus cuentas.</summary>
    private bool TieneExigible => _pagables is { } p
        && ((p.Obligations?.Obligations ?? []).Any(o => o.DueToday > 0m && o.BlockReasons.Count == 0)
            || (p.DueInstallments?.Installments ?? []).Any(x => x.Pending > 0m));

    private void ArmarPagable()
    {
        var lista = new List<Pagable>();
        if (_pagables is { } p)
        {
            foreach (var o in p.Obligations?.Obligations ?? [])
            {
                var obligacion = o;
                lista.Add(new Pagable(GrupoCartera, $"{o.Number} · {o.CreditLineName}{(o.Role == 2 ? " (codeudor)" : "")}",
                    $"exigible {V(o.DueToday)} · cuota {V(o.CycleInstallment)} · vencido {V(o.PastDue)} · para cancelar {V(o.PayoffAmount)}{(o.DaysPastDue > 0 ? $" · {o.DaysPastDue} días de mora" : "")}",
                    o.DueToday > 0 ? o.DueToday : o.CycleInstallment, o.BlockReasons.Count > 0 ? string.Join(", ", o.BlockReasons.Select(Bloqueo)) : null,
                    () => AgregarCredito(obligacion), o.ObligationPublicId, o.Number));
            }
            foreach (var c in p.Accounts?.Accounts ?? [])
            {
                var cuenta = c;
                var cuotas = (p.DueInstallments?.Installments ?? []).Where(x => x.AccountPublicId == c.AccountPublicId).ToList();
                lista.Add(new Pagable(GrupoCuentas, $"{c.Number} · {c.LineName}", string.Join(" · ", cuotas.Select(x => $"{x.Period}: {V(x.Pending)}")),
                    cuotas.Sum(x => x.Pending), c.AcceptsDeposits ? null : "no recibe consignaciones", () => AgregarCuenta(cuenta)));
            }
            if (PuedeDejarPendiente(1)) lista.Add(new Pagable(GrupoCartera, "Crédito de la carga (Cartera sin activar)", "Queda pendiente de aplicar el día de la activación.", null, null, () => AgregarPendiente(1)));
            if (PuedeDejarPendiente(2)) lista.Add(new Pagable(GrupoCuentas, "Cuenta de la carga (Captaciones sin activar)", "Queda pendiente de aplicar el día de la activación.", null, null, () => AgregarPendiente(2)));
            // R1 (T0398; FR-049): las facturas comerciales con saldo, con tercero y factura de cruce; nunca como concepto vario.
            foreach (var f in _cuentasPorCobrar)
            {
                var factura = f;
                lista.Add(new Pagable(GrupoContabilidad, $"Factura {f.InvoiceNumber}", f.Date.ToString("dd/MM/yyyy"), f.Pending, null, () => AgregarCuentaPorCobrar(factura)));
            }
            foreach (var k in p.MiscConcepts)
            {
                var concepto = k;
                lista.Add(new Pagable(GrupoConceptos, $"Concepto {k.Code} · {k.Name}",
                    k.ThirdPartyMode == 2 && k.DefaultThirdPartyName is { } tercero ? $"a nombre de {tercero}" : null, k.SuggestedAmount, null, () => AgregarConcepto(concepto)));
            }
        }
        // Ordenados por grupo, para que cada grupo salga junto bajo su título; dentro del grupo, como vinieron.
        _pagable = lista.Select((x, i) => (x, i)).OrderBy(t => Array.IndexOf(OrdenDeGrupos, t.x.Grupo)).ThenBy(t => t.i).Select(t => t.x).ToList();
        _marcado = 0;
    }

    private const string GrupoCartera = "Cartera · créditos", GrupoCuentas = "Aportes y ahorros", GrupoContabilidad = "Contabilidad y Comercial · facturas",
        GrupoConceptos = "Conceptos varios";

    private static readonly string[] OrdenDeGrupos = [GrupoCartera, GrupoCuentas, GrupoContabilidad, GrupoConceptos];

    private static string Bloqueo(string codigo) => codigo switch
    {
        "WrittenOff" => "castigado",
        "Insolvency" => "en proceso de insolvencia",
        _ => codigo,
    };

    private async Task TeclaEnPagableAsync(KeyboardEventArgs e)
    {
        if (_pagable.Count == 0) return;
        switch (e.Key)
        {
            case "ArrowDown": _marcado = Math.Min(_marcado + 1, _pagable.Count - 1); await MostrarMarcado(); break;
            case "ArrowUp": _marcado = Math.Max(_marcado - 1, 0); await MostrarMarcado(); break;
            case " " or "Enter": AgregarPagable(_marcado); break;
        }
    }

    private void AgregarPagable(int indice)
    {
        if (indice < 0 || indice >= _pagable.Count) return;
        _marcado = indice;
        var x = _pagable[indice];
        if (x.Bloqueo is not null) { _ = Notification.WarningAsync($"No se puede pagar: {x.Bloqueo}."); return; }
        x.Agregar();
        ProgramarSimulacion();
    }

    // ------------------------------------------------------------------------------------- qué paga --

    private void Agregar(ItemPedidoRequest item, string rotulo)
    {
        var conId = item with { ItemId = Guid.NewGuid() };
        _items.Add(conId);
        _rotulos[conId.ItemId!.Value] = rotulo;
    }

    private void AgregarPendiente(int modulo) =>
        Agregar(new ItemPedidoRequest(5, 0, PendingTarget: modulo), modulo == 1 ? "Pendiente de aplicar · crédito" : "Pendiente de aplicar · cuenta");

    /// <summary>
    /// 2026-11-16: con algo exigible y la regla de la cooperativa, entra lo exigible (modalidad «lo vencido»); sin nada exigible, la cuota del ciclo
    /// por su valor completo.
    /// </summary>
    private void AgregarCredito(ObligacionPagableDto o)
    {
        if (o.ConExigible && (_pagables?.OverdueOnlyDue ?? true))
            Agregar(new ItemPedidoRequest(1, o.DueToday, o.ObligationPublicId, LoanModality: 2), $"Crédito {o.Number}");
        else
            Agregar(new ItemPedidoRequest(1, o.CycleInstallment > 0 ? o.CycleInstallment : o.DueToday, o.ObligationPublicId, LoanModality: 3), $"Crédito {o.Number}");
    }

    private void AgregarCuenta(CuentaPagableDto c)
    {
        var exigibles = (_pagables?.DueInstallments?.Installments ?? []).Where(x => x.AccountPublicId == c.AccountPublicId).ToList();
        Agregar(new ItemPedidoRequest(2, exigibles.Sum(x => x.Pending), c.AccountPublicId, AccountModality: exigibles.Count > 0 ? 2 : 1,
            InstallmentPublicIds: exigibles.Select(x => x.InstallmentPublicId).ToList()), $"Cuenta {c.Number}");
    }

    private void AgregarCuentaPorCobrar(CuentaPorCobrarComercialDto f) =>
        Agregar(new ItemPedidoRequest(4, f.Pending, CrossDocument: f.InvoiceNumber, InvoicePublicId: f.AccountingDocumentPublicId), $"Factura {f.InvoiceNumber}");

    /// <summary>2026-11-16: con su valor sugerido y, si el concepto tiene tercero fijo, a nombre de ese tercero.</summary>
    private void AgregarConcepto(ConceptoVarioPagableDto k) =>
        Agregar(new ItemPedidoRequest(3, k.SuggestedAmount ?? 0m, MiscConceptPublicId: k.MiscConceptPublicId,
            BeneficiaryPersonPublicId: k.ThirdPartyMode == 2 ? k.DefaultThirdPartyPublicId : null), $"Concepto {k.Code}");

    private void Reemplazar(ItemPedidoRequest viejo, ItemPedidoRequest nuevo)
    {
        _items[_items.IndexOf(viejo)] = nuevo;
        ProgramarSimulacion();
    }

    /// <summary>2026-11-16: al cambiar la modalidad se propone su valor (lo exigible, la cuota del ciclo, lo de cancelar).</summary>
    private void CambiarModalidad(ItemPedidoRequest i, string? valor)
    {
        var modalidad = int.TryParse(valor, out var m) ? m : 3;
        var o = ObligacionDe(i);
        var propuesto = (modalidad, o) switch
        {
            (1, { } ob) => ob.PayoffAmount,
            (2, { } ob) => ob.DueToday,
            (3, { } ob) => ob.CycleInstallment,
            _ => i.Amount,
        };
        Reemplazar(i, i with { LoanModality = modalidad, Choice = null, Amount = propuesto, InstallmentNumber = modalidad == 6 ? i.InstallmentNumber : null });
    }

    private void CambiarCuota(ItemPedidoRequest i, string? valor) => Reemplazar(i, i with { InstallmentNumber = int.TryParse(valor, out var n) && n > 0 ? n : null });

    private void CambiarCruce(ItemPedidoRequest i, string? valor) => Reemplazar(i, i with { CrossDocument = string.IsNullOrWhiteSpace(valor) ? null : valor.Trim() });

    private readonly Dictionary<Guid, PersonSearchPicker.PersonSearchItem> _terceros = [];

    private PersonSearchPicker.PersonSearchItem? TerceroDe(ItemPedidoRequest i) => i.ItemId is { } id ? _terceros.GetValueOrDefault(id) : null;

    private void CambiarTercero(ItemPedidoRequest i, PersonSearchPicker.PersonSearchItem? tercero)
    {
        if (i.ItemId is { } id) { if (tercero is null) _terceros.Remove(id); else _terceros[id] = tercero; }
        Reemplazar(i, i with { BeneficiaryPersonPublicId = tercero?.PublicId });
    }

    // ------------------------------------------------------------------------- 2026-11-16: reglas de la caja --

    private string _tamano = "normal";
    private bool _decimales;
    private decimal? _valorRecibido;
    private Guid? _detalleDe;
    private string? _numeroDelDetalle;

    private string V(decimal valor) => IngenIA365ERP.Shared.Services.Cartera.FormatoDelEstadoDeCuenta.Valor(valor, _decimales);

    private ObligacionPagableDto? ObligacionDe(ItemPedidoRequest i) =>
        i.Target == 1 ? _pagables?.Obligations?.Obligations.FirstOrDefault(o => o.ObligationPublicId == i.ProductPublicId) : null;

    private ConceptoVarioPagableDto? ConceptoDe(ItemPedidoRequest i) => _pagables?.MiscConcepts.FirstOrDefault(k => k.MiscConceptPublicId == i.MiscConceptPublicId);

    /// <summary>
    /// Las modalidades que se ofrecen: las que admite la obligación y, si tiene algo exigible y la cooperativa así lo dice
    /// (<c>Caja.ConMoraSoloExigible</c>), sólo lo exigible, la cancelación y una cuota específica (para pagar una vencida).
    /// </summary>
    private IReadOnlyList<int> ModalidadesPermitidas(ObligacionPagableDto? o)
    {
        int[] orden = [2, 3, 1, 5, 6, 4, 7];
        var admitidas = o?.AdmittedModalities is { Count: > 0 } a ? a : orden;
        var lista = orden.Where(admitidas.Contains);
        if (o is { ConExigible: true } && (_pagables?.OverdueOnlyDue ?? true)) lista = lista.Where(m => m is 1 or 2 or 6);
        return lista.ToList();
    }

    /// <summary>
    /// Sin nada exigible y con la regla de la cooperativa, la cuota del ciclo se paga completa: el mínimo es su valor menos lo que ya tenga
    /// anticipado (lo mismo que exige el servidor).
    /// </summary>
    private decimal? MinimoDe(ItemPedidoRequest i, ObligacionPagableDto o) =>
        !o.ConExigible && (_pagables?.MinimumOneInstallment ?? true) && i.LoanModality == 3 && o.CycleInstallment - o.Advance > 0m
            ? o.CycleInstallment - o.Advance : null;

    private static readonly string[] ClasesPorDefecto = ["Aportes", "Creditos", "Ahorros", "Facturas", "Conceptos"];

    /// <summary>La prelación por clase que configuró la cooperativa (vacía = libre).</summary>
    private IReadOnlyList<string> Prelacion => _pagables?.PriorityClasses ?? [];

    private static string NombreDeClase(string clase) => clase switch
    {
        "Aportes" => "aportes", "Creditos" => "créditos", "Ahorros" => "ahorros", "Facturas" => "facturas", "Conceptos" => "conceptos", _ => clase,
    };

    private string ClaseDe(ItemPedidoRequest i) => i.Target switch
    {
        1 => "Creditos",
        2 => _pagables?.Accounts?.Accounts.FirstOrDefault(c => c.AccountPublicId == i.ProductPublicId)?.Nature == 3 ? "Aportes" : "Ahorros",
        4 => "Facturas",
        5 => i.PendingTarget == 2 ? "Ahorros" : "Creditos",
        _ => "Conceptos",
    };

    /// <summary>Lo exigible de un ítem: lo causado y vencido de un crédito, las cuotas pendientes de una cuenta, el saldo de una factura.</summary>
    private decimal ExigibleDe(ItemPedidoRequest i) => i.Target switch
    {
        1 => ObligacionDe(i)?.DueToday ?? 0m,
        2 => (_pagables?.DueInstallments?.Installments ?? []).Where(x => x.AccountPublicId == i.ProductPublicId).Sum(x => x.Pending),
        4 => _cuentasPorCobrar.FirstOrDefault(f => f.InvoiceNumber == i.CrossDocument)?.Pending ?? i.Amount,
        _ => 0m,
    };

    /// <summary>Lo que se propone para un ítem cuando sobra después de lo exigible: la cuota del ciclo, lo de cancelar la cuenta o el valor escrito.</summary>
    private decimal PropuestoDe(ItemPedidoRequest i) => i.Target switch
    {
        1 when ObligacionDe(i) is { } o => i.LoanModality switch { 1 => o.PayoffAmount, 2 => o.DueToday, _ => Math.Max(o.CycleInstallment, o.DueToday) },
        _ => Math.Max(i.Amount, ExigibleDe(i)),
    };

    /// <summary>
    /// F6: reparte lo que entrega la persona entre lo que va a pagar. Primero lo exigible de cada ítem, en el orden de la prelación de la cooperativa
    /// (o el de la lista si no hay); después, si sobra, hasta lo propuesto de cada uno en el mismo orden. Lo que todavía sobre queda «por repartir»:
    /// el cajero lo escribe en el producto que la persona quiera abonar.
    /// </summary>
    private void Repartir()
    {
        if (_valorRecibido is not > 0m || _items.Count == 0) return;
        var orden = Prelacion.Count > 0 ? Prelacion : ClasesPorDefecto;
        var items = _items.Select((x, i) => (Item: x, Indice: i))
            .OrderBy(t => Array.IndexOf([.. orden], ClaseDe(t.Item)) is var k && k < 0 ? int.MaxValue : k).ThenBy(t => t.Indice).ToList();
        var resto = _valorRecibido.Value;
        var asignado = items.ToDictionary(t => t.Indice, _ => 0m);
        foreach (var pasada in new Func<ItemPedidoRequest, decimal>[] { ExigibleDe, PropuestoDe })
            foreach (var (item, indice) in items)
            {
                if (resto <= 0m) break;
                var tope = Math.Max(0m, pasada(item) - asignado[indice]);
                var parte = Math.Min(resto, tope);
                asignado[indice] += parte;
                resto -= parte;
            }
        for (var i = 0; i < _items.Count; i++) _items[i] = _items[i] with { Amount = asignado[i] };
        _items.RemoveAll(x => x.Amount <= 0m && x.Target != 3);
        ProgramarSimulacion();
    }

    private void VerDetalle(Guid obligacion, string? numero)
    {
        _detalleDe = obligacion;
        _numeroDelDetalle = numero;
    }

    private void VerDetalleDelMarcado()
    {
        if (_marcado >= 0 && _marcado < _pagable.Count && _pagable[_marcado].Obligacion is { } ob) { VerDetalle(ob, _pagable[_marcado].Numero); return; }
        if (_items.Select(ObligacionDe).FirstOrDefault(o => o is not null) is { } enQuePaga) VerDetalle(enQuePaga.ObligationPublicId, enQuePaga.Number);
    }

    /// <summary>Las cuotas que el asociado quiere anticipar: un ítem «cuota específica» por cada una, con su valor completo.</summary>
    private void AnticiparCuotas(IReadOnlyList<CuotaDeObligacionDto> cuotas)
    {
        if (_detalleDe is not { } obligacion) return;
        var numero = _numeroDelDetalle ?? "";
        foreach (var q in cuotas)
        {
            _items.RemoveAll(x => x.Target == 1 && x.ProductPublicId == obligacion && x.LoanModality == 6 && x.InstallmentNumber == q.Number);
            Agregar(new ItemPedidoRequest(1, q.ValueToAnticipate, obligacion, LoanModality: 6, InstallmentNumber: q.Number), $"Crédito {numero} · cuota {q.Number}");
        }
        _detalleDe = null;
        ProgramarSimulacion();
    }

    private void CambiarValor(ItemPedidoRequest i, decimal? valor) => Reemplazar(i, i with { Amount = valor ?? 0m });

    private void CambiarEleccion(ItemPedidoRequest i, string? valor) => Reemplazar(i, i with { Choice = int.TryParse(valor, out var c) ? c : null });

    private void AceptarAviso(ItemPedidoRequest i, bool acepta) => Reemplazar(i, i with { AdvanceNoticeAccepted = acepta });

    private void QuitarItem(ItemPedidoRequest i)
    {
        _items.Remove(i);
        ProgramarSimulacion();
    }

    /// <summary>Q12: la simulación se actualiza sola, 400 ms después del último cambio; un cambio nuevo cancela la anterior.</summary>
    private void ProgramarSimulacion()
    {
        _cobro.CambiarAPagar(TotalItems);
        _simulacion?.Cancel();
        _simulacion = new CancellationTokenSource();
        var token = _simulacion.Token;
        _ = InvokeAsync(async () =>
        {
            try { await Task.Delay(400, token); }
            catch (OperationCanceledException) { return; }
            if (_items.Count == 0) { StateHasChanged(); return; }
            await SimularAsync();
            StateHasChanged();
        });
    }

    private async Task PreseleccionarAsync()
    {
        using var carga = _cargaDeItems.Iniciar();
        if (!await AsegurarOperacionAsync()) return;
        _rechazados.Clear();
        var r = await Cliente.PreseleccionarAsync(_operacion!.PublicId, _comoCodeudor, _claveDePreseleccion);
        _claveDePreseleccion = new ClaveDeOperacion();
        if (!r.IsSuccess)
        {
            if (r.ErrorCode == "Receipts.Receipt.ItemRejected")
                foreach (var x in r.Dato<List<RechazoDeItem>>("items") ?? []) _rechazados[x.ItemId] = x.Message;
            await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo preseleccionar lo exigible.");
            return;
        }
        _operacion = r.Value;
        _items.Clear();
        foreach (var i in _operacion!.Items)
        {
            _items.Add(new ItemPedidoRequest(i.Target, i.Amount, i.ProductPublicId, i.BeneficiaryPersonPublicId, i.LoanModality, i.AccountModality, i.Choice,
                i.InstallmentNumber, i.InstallmentPublicIds, i.AdvanceNoticeAccepted, i.MiscConceptPublicId, i.CrossDocument, i.InvoicePublicId, i.ItemId,
                i.PendingTarget, i.LoadObligationPublicId, i.ProductReference));
            if (!_rotulos.ContainsKey(i.ItemId)) _rotulos[i.ItemId] = $"{CajaClient.Destino(i.Target)} {i.ProductNumber}";
        }
        _cobro.CambiarAPagar(TotalItems);
        _pideDeclaracion = _operacion.Items.Any(x => x.RequiresSourceOfFunds) && !_operacion.SourceOfFundsDeclared;
    }

    private async Task<bool> AsegurarOperacionAsync()
    {
        if (_operacion is not null) return true;
        if (_sesion is null || _pagables is null) return false;
        var r = await Cliente.CrearAsync(new CrearOperacionRequest(_sesion.PublicId, _pagables.PersonPublicId, null, null, null, null, null), _claveDeCreacion);
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo empezar la operación."); return false; }
        _operacion = r.Value;
        return true;
    }

    private async Task<bool> SimularAsync()
    {
        using var carga = _cargaDeItems.Iniciar();
        if (!await AsegurarOperacionAsync()) return false;
        _rechazados.Clear();
        // 2026-11-16: un concepto recién agregado sin valor todavía no se manda (el servidor rechaza un ítem en cero y con él toda la lista).
        var r = await Cliente.ItemsAsync(_operacion!.PublicId, _items.Where(i => i.Amount > 0m).ToList(), _claveDeItems);
        _claveDeItems = new ClaveDeOperacion();
        if (!r.IsSuccess)
        {
            if (r.ErrorCode == "Receipts.Receipt.ItemRejected")
                foreach (var x in r.Dato<List<RechazoDeItem>>("items") ?? []) _rechazados[x.ItemId] = x.Message;
            await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo simular.");
            return false;
        }
        _operacion = r.Value;
        _pideDeclaracion = _operacion!.Items.Any(x => x.RequiresSourceOfFunds) && !_operacion.SourceOfFundsDeclared;
        return true;
    }

    // ----------------------------------------------------------------------------------- confirmación --

    /// <summary>Q12: imputa (los medios del panel) y confirma en un paso. La simulación pendiente se hace antes.</summary>
    private async Task ImputarYConfirmarAsync(Guid? aprobacion)
    {
        if (_cobro.Problema() is { } problema) { await Notification.WarningAsync(problema); return; }
        _simulacion?.Cancel();
        if (!await SimularAsync()) return;
        using (_cargaDeMedios.Iniciar())
        {
            var r = await Cliente.MediosAsync(_operacion!.PublicId, AdaptadoresDeCobro.ParaRecaudo(_cobro), null, _claveDeMedios);
            _claveDeMedios = new ClaveDeOperacion();
            if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo imputar."); return; }
            _operacion = r.Value;
        }
        await ConfirmarAsync(aprobacion);
    }

    private async Task DeclararAsync()
    {
        if (_operacion is null || string.IsNullOrWhiteSpace(_origen) || !Guid.TryParse(_soporteDeDeclaracion, out var soporte))
        {
            await Notification.WarningAsync("Escriba el origen y adjunte el soporte.");
            return;
        }
        using var carga = _cargaDeMedios.Iniciar();
        var efectivo = _operacion.Means.Where(m => _sesion!.Means.FirstOrDefault(x => x.PaymentMeansPublicId == m.PaymentMeansPublicId)?.Class == 1).Sum(m => m.Amount);
        var r = await Cliente.DeclararAsync(_operacion.PublicId, _origen.Trim(), efectivo, soporte, _claveDeDeclaracion);
        _claveDeDeclaracion = new ClaveDeOperacion();
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo registrar la declaración."); return; }
        _operacion = r.Value;
        _pideDeclaracion = false;
    }

    private async Task RegistrarQuienEfectuaAsync()
    {
        if (_operacion is null || _quienEfectua is null) return;
        IngenIA365ERP.Shared.Services.Inventario.ResultadoDeInventario<OperacionDeCajaDto> r;
        using (_confirmando.Iniciar()) r = await Cliente.QuienEfectuaAsync(_operacion.PublicId, _quienEfectua.PublicId, _claveDeQuienEfectua);
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo registrar quién efectúa el pago."); return; }
        _claveDeQuienEfectua = new ClaveDeOperacion();
        _operacion = r.Value;
        _pideQuienEfectua = false;
        await ConfirmarAsync(null);
    }

    private async Task ConfirmarAsync(Guid? aprobacion)
    {
        if (_operacion is null) return;
        using var carga = _confirmando.Iniciar();
        var r = await Cliente.ConfirmarAsync(_operacion.PublicId, _claveDeConfirmacion, aprobacion);
        switch (r.ErrorCode)
        {
            case null when r.IsSuccess:
                _recibo = r.Value;
                _mostrarMedios = false;
                _aprobacion = null;
                await Notification.SuccessAsync($"Recibo {_recibo!.Number} confirmado.");
                StateHasChanged();
                await Enfocar("#caja-nueva");
                return;
            case "Approvals.PresenceRequired":
                _aprobacion = r.Dato<Guid?>("approvalRequestPublicId");
                _huella = r.Dato<string>("contentSha256");
                return;
            case "Receipts.Compliance.DeclarationRequired":
                _pideDeclaracion = true;
                break;
            case "Receipts.Compliance.WithholdRequired":
                // US14 (T0245): coincidencia no vinculante con «retiene»: el efectivo queda en custodia hasta que el oficial lo libere o lo devuelva.
                var retenida = await CumplimientoApi.RetenerAsync(_operacion.PublicId, new ClaveDeOperacion());
                if (retenida.IsSuccess)
                {
                    await Notification.WarningAsync("La operación quedó retenida por cumplimiento: el efectivo está en custodia hasta que el oficial decida.");
                    return;
                }
                break;
            case "Receipts.Compliance.DeliveredByRequired":
                _pideQuienEfectua = true;
                _motivoQuienEfectua = r.ErrorMessage;
                return;
            case "Receipts.Receipt.DistributionChanged":
                await SimularAsync();
                break;
            case "Receipts.Receipt.ItemRejected":
                foreach (var x in r.Dato<List<RechazoDeItem>>("items") ?? []) _rechazados[x.ItemId] = x.Message;
                break;
        }
        await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo confirmar el recibo.");
    }

    private async Task AvisarAsync()
    {
        if (_recibo is null) return;
        using var envio = _enviandoAviso.Iniciar();
        var r = await Cliente.AvisarAsync(_recibo.PublicId, string.IsNullOrWhiteSpace(_correoDelAviso) ? null : _correoDelAviso.Trim(), _claveDeAviso);
        _claveDeAviso = new ClaveDeOperacion();
        if (!r.IsSuccess || r.Value is null) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo enviar el aviso."); return; }
        if (r.Value.Outcome == "Sent") await Notification.SuccessAsync(r.Value.Message);
        else await Notification.WarningAsync(r.Value.Message);
    }

    private async Task ImprimirAsync(bool carta)
    {
        if (_recibo is null) return;
        var r = await Cliente.DocumentoAsync(_recibo.PublicId, carta, copia: false);
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo generar el recibo."); return; }
        await Descargas.GuardarAsync(r.Value!.Nombre, r.Value.TipoContenido, r.Value.Contenido);
    }

    private void PedirCancelar() => _confirmarCancelar = true;

    /// <summary>FR-054: cancelar es un acto propio y confirmado; Esc nunca lo hace.</summary>
    private async Task CancelarAsync()
    {
        _mostrarMedios = false;
        _confirmarCancelar = false;
        if (_operacion is not null && _recibo is null) await Cliente.AbandonarAsync(_operacion.PublicId, new ClaveDeOperacion());
        await NuevaAsync();
    }

    private async Task NuevaAsync()
    {
        _mostrarMedios = false;
        _valorRecibido = null;
        _detalleDe = null;
        _terceros.Clear();
        _simulacion?.Cancel();
        _persona = null;
        _pagables = null;
        _pagable = [];
        _operacion = null;
        _recibo = null;
        _items.Clear();
        _cobro = new CobroMultiple(0m);
        _rechazados.Clear();
        _aprobacion = null;
        _pideDeclaracion = false;
        _pideQuienEfectua = false;
        _claveDeCreacion = new ClaveDeOperacion();
        _claveDeConfirmacion = new ClaveDeOperacion();
        StateHasChanged();
        if (_buscador is not null) await _buscador.EnfocarAsync();
    }

    private async Task MostrarMarcado()
    {
        try { await JS.InvokeVoidAsync("ingeniaTeclado.mostrarMarcado", "#lista-pagable"); }
        catch (JSException ex) { InteropDeTeclado.Avisar(ex, "sin teclado.js la lista se recorre igual"); }
    }

    private async Task Enfocar(string selector)
    {
        try { await JS.InvokeVoidAsync("ingeniaTeclado.enfocar", selector); }
        catch (JSException ex) { InteropDeTeclado.Avisar(ex, "sin teclado.js el foco se pone a mano"); }
    }

    public async ValueTask DisposeAsync()
    {
        _simulacion?.Cancel();
        if (_registroDeTeclas is > 0)
        {
            try { await JS.InvokeVoidAsync("ingeniaTeclado.soltar", _registroDeTeclas); }
            catch (JSDisconnectedException ex) { InteropDeTeclado.Avisar(ex, "el circuito ya se cerró"); }
            catch (JSException ex) { InteropDeTeclado.Avisar(ex, "sin teclado.js no hay nada que soltar"); }
        }
        _referencia?.Dispose();
    }

