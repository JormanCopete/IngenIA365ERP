                        <div class="caja-desplazable">
                            <div class="aviso aviso-ok">Recibo <b>@_recibo.Number</b> confirmado.</div>
                            <div class="pos-total">
                                <div class="pos-renglon"><span>Total pagado</span><span class="pos-a-pagar">@V(_recibo.TotalApplied)</span></div>
                                <div class="pos-renglon"><span>Recibido</span><span>@V(_recibo.TotalMeans)</span></div>
                                @if (_recibo.ChangeGiven > 0m) { <div class="pos-renglon pos-vueltas"><span>Vueltas</span><span>@V(_recibo.ChangeGiven)</span></div> }
                            </div>
                            <ul class="caja-aplicaciones">
                                @foreach (var a in _recibo.Applications) { <li>@a.Ordinal. @CajaClient.Destino(a.Target) @a.ProductNumber · @V(a.Amount)@(a.ModuleVoucherNumber is { } c ? $" · comprobante {c}" : "")</li> }
                            </ul>
                            <ul class="caja-aplicaciones">
                                @foreach (var m in _recibo.Means) { <li>@m.MeansCode · @V(m.Amount)@(m.Reference is { Length: > 0 } r ? $" · ref. {r}" : "")</li> }
                            </ul>
                            @* Feature 015, R1 (T0365; FR-020, FR-045): por correo, sólo con la autorización del canal; el servidor dice si salió. *@
                            <label class="campo">Correo (opcional)
                                <input class="e-input" placeholder="El registrado de la persona" @bind="_correoDelAviso" maxlength="200" data-ayuda="El correo al que se envía el recibo; vacío, el registrado de la persona." />
                            </label>
                        </div>
                        <div class="caja-comandos" data-zona-teclado>
                            <SfButton id="caja-nueva" CssClass="e-primary" data-principal OnClick="@NuevaAsync">Nueva operación (Enter)</SfButton>
                            <SfButton CssClass="e-outline" IconCss="e-icons e-print" OnClick="@(() => ImprimirAsync(false))">Tirilla (Ctrl+P)</SfButton>
                            <SfButton CssClass="e-outline" IconCss="e-icons e-print" OnClick="@(() => ImprimirAsync(true))">Carta (Ctrl+Shift+P)</SfButton>
                            <SfButton CssClass="e-outline" Disabled="@_enviandoAviso.Activa" OnClick="@AvisarAsync">Enviar por correo</SfButton>
                            <PermissionGate Required="Receipts.Voiding.Request">
                                <SfButton CssClass="e-flat" OnClick="@(() => Navegacion.NavigateTo($"recaudo/anulaciones?numero={Uri.EscapeDataString(_recibo.Number)}"))">Pedir su anulación</SfButton>
                            </PermissionGate>
                        </div>
                    }
                </section>
            </div>
        }
    </IndicadorDeCarga>
</div>

