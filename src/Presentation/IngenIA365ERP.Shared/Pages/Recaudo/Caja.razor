    {
        try { await JS.InvokeVoidAsync("ingeniaTeclado.mostrarMarcado", "#lista-pagable"); }
        catch (JSException ex) { InteropDeTeclado.Avisar(ex, "sin teclado.js la lista se recorre igual"); }
    }

    private async Task Enfocar(string selector)
    {
        try { await JS.InvokeVoidAsync("ingeniaTeclado.enfocar", selector); }
        catch (JSException ex) { InteropDeTeclado.Avisar(ex, "sin teclado.js el foco se pone a mano"); }
    }

    public async ValueTask DisposeAsync()
    {
        _simulacion?.Cancel();
        if (_registroDeTeclas is > 0)
        {
            try { await JS.InvokeVoidAsync("ingeniaTeclado.soltar", _registroDeTeclas); }
            catch (JSDisconnectedException ex) { InteropDeTeclado.Avisar(ex, "el circuito ya se cerró"); }
            catch (JSException ex) { InteropDeTeclado.Avisar(ex, "sin teclado.js no hay nada que soltar"); }
        }
        _referencia?.Dispose();
        _cerrojoDeSimulacion.Dispose();
    }

    // ------------------------------------------------------------------- 2026-11-17: disposición, comandos y validaciones --

    private const string Apilada = "apilada", Columnas = "columnas", ClaveDeDisposicion = "ingenia.caja.disposicion";

    /// <summary>Cómo se reparte la pantalla: «apilada» (por defecto) o «columnas». Se recuerda en este navegador.</summary>
    private string _disposicion = Apilada;

    [CascadingParameter] public MenuLateralDelPos? Menu { get; set; }

    private bool MenuAbierto => Menu?.Abierto == true;

    private string? _errorDeSesion;
    private TablaDeComandos? _comandos;
    private static DateOnly Hoy => DateOnly.FromDateTime(DateTime.Today);

    /// <summary>Una sola simulación a la vez: dos PUT de la misma operación chocaban por concurrencia (500 en producción el 2026-11-17).</summary>
    private readonly SemaphoreSlim _cerrojoDeSimulacion = new(1, 1);

    private TablaDeComandos ArmarComandos() => new(
    [
        new("F2", "buscar persona", EnfocarBuscadorAsync),
        new("F3", "ver por dentro", () => { VerDetalleDelMarcado(); return Task.CompletedTask; }, () => _pagables is not null,
            PorQueNo: () => "Busque primero a la persona."),
        new("F4", "todo lo exigible", PreseleccionarAsync, () => _pagables is not null && _recibo is null && TieneExigible,
            PorQueNo: () => _pagables is null ? "Busque primero a la persona." : "La persona no tiene nada exigible."),
        new("F7", "todo para cancelar", () => { TodoParaCancelar(); return Task.CompletedTask; }, () => _pagables is not null && _recibo is null && TieneParaCancelar,
            PorQueNo: () => _pagables is null ? "Busque primero a la persona." : "La persona no tiene nada que cancelar."),
        new("F6", "repartir", () => { Repartir(); return Task.CompletedTask; }, () => _items.Count > 0 && _recibo is null && _valorRecibido is > 0m,
            PorQueNo: () => _items.Count == 0 ? "Elija primero lo que se va a pagar." : "Escriba el valor que entrega la persona."),
        new("F10", "cobrar", F10Async, () => _recibo is null && _items.Count > 0, PorQueNo: () => _recibo is not null ? null : "Elija primero lo que se va a pagar."),
        new("Ctrl+Alt+X", "cancelar", () => { PedirCancelar(); return Task.CompletedTask; }, () => _recibo is null && (_items.Count > 0 || _operacion is not null)),
        new("Ctrl+P", "tirilla", () => ImprimirAsync(false), () => _recibo is not null, PorQueNo: () => "Primero confirme el recibo."),
        new("Ctrl+Shift+P", "carta", () => ImprimirAsync(true), () => _recibo is not null, PorQueNo: () => "Primero confirme el recibo."),
        new("Enter", "nueva (tras el recibo)", NuevaAsync, () => _recibo is not null),
    ]);

    private async Task EnfocarBuscadorAsync()
    {
        if (_recibo is not null) await NuevaAsync();
        if (_buscador is not null) await _buscador.EnfocarAsync(limpiar: true);
    }

    private async Task F10Async()
    {
        if (!_mostrarMedios)
        {
            if (HayBloqueantes) { await Notification.WarningAsync("Antes de cobrar: " + string.Join(" ", Problemas(soloBloqueantes: true))); return; }
            await AbrirMediosAsync();
            return;
        }
        if (_cobro.Pagos.Count == 0 || _cobro.Problema() is not null) { if (_panel is not null) await _panel.EnfocarAsync(); return; }
        await ImputarYConfirmarAsync(null);
    }

    private async Task CambiarDisposicionAsync(string disposicion)
    {
        _disposicion = disposicion == Columnas ? Columnas : Apilada;
        try { await JS.InvokeVoidAsync("localStorage.setItem", ClaveDeDisposicion, _disposicion); }
        catch (JSException ex) { InteropDeTeclado.Avisar(ex, "sin almacenamiento local la disposición dura lo que dure la pantalla"); }
    }

    private async Task LeerDisposicionAsync()
    {
        try
        {
            var guardada = await JS.InvokeAsync<string?>("localStorage.getItem", ClaveDeDisposicion);
            if (guardada is Columnas or Apilada && guardada != _disposicion) { _disposicion = guardada; StateHasChanged(); }
        }
        catch (JSException ex) { InteropDeTeclado.Avisar(ex, "sin almacenamiento local queda la disposición de defecto"); }
    }

    /// <summary>La fila de «lo que puede pagar» ya está en «Qué paga».</summary>
    private bool EstaEnQuePaga(Pagable x) =>
        (x.Obligacion is { } o && _items.Any(i => i.Target == 1 && i.ProductPublicId == o))
        || (x.Cuenta is { } c && _items.Any(i => i.Target == 2 && i.ProductPublicId == c.AccountPublicId));

    /// <summary>
    /// Lo que se ve antes de cobrar: lo que el servidor va a rechazar (bloqueante) y lo que conviene revisar. Las mismas reglas que valida el servidor
    /// (<c>ReglasDeLaCaja</c>); el servidor sigue siendo quien decide.
    /// </summary>
    private List<string> Problemas(bool soloBloqueantes = false)
    {
        var lista = new List<string>();
        foreach (var i in _items)
        {
            var rotulo = _rotulos.GetValueOrDefault(i.ItemId!.Value) ?? "Un ítem";
            foreach (var p in ProblemasDelItem(i, ObligacionDe(i)).Where(p => !soloBloqueantes || p.Bloquea)) lista.Add($"{rotulo}: {p.Texto}");
        }
        if (!soloBloqueantes && _valorRecibido is { } recibido && recibido > 0m && recibido < TotalItems)
            lista.Add($"Lo que entrega ({V(recibido)}) no alcanza para lo que va a pagar ({V(TotalItems)}): ajuste los valores o use «Repartir» (F6).");
        return lista;
    }

    private bool HayBloqueantes => _items.Any(i => ProblemasDelItem(i, ObligacionDe(i)).Any(p => p.Bloquea));

    private readonly record struct Problema(string Texto, bool Bloquea);

    private IEnumerable<Problema> ProblemasDelItem(ItemPedidoRequest i, ObligacionPagableDto? o)
    {
        if (_rechazados.TryGetValue(i.ItemId!.Value, out var rechazo)) yield return new(rechazo, true);
        if (i.Amount <= 0m) { yield return new("escriba el valor que paga.", true); yield break; }
        if (i.Target == 1 && o is not null)
        {
            if (!ModalidadesPermitidas(o).Contains(i.LoanModality ?? 0))
                yield return new($"con {V(o.DueToday)} exigible sólo se paga lo exigible, una cuota vencida o la cancelación.", true);
            if (MinimoDe(i, o) is { } minimo && i.Amount < minimo) yield return new($"sin nada exigible se paga al menos una cuota completa: {V(minimo)}.", true);
            if (i.LoanModality == 5 && i.Choice is null) yield return new("el deudor tiene que elegir si el abono reduce el plazo o la cuota.", true);
            if (i.LoanModality == 6 && i.InstallmentNumber is null) yield return new("diga el número de la cuota.", true);
            if (i.LoanModality != 1 && o.PayoffAmount > 0m && i.Amount > o.PayoffAmount)
                yield return new($"paga más de lo que vale cancelar el crédito ({V(o.PayoffAmount)}); lo que sobre queda a favor del deudor.", false);
            else if (i.LoanModality == 2 && o.DueToday > 0m && i.Amount < o.DueToday)
                yield return new($"paga menos de lo exigible ({V(o.DueToday)}): el crédito sigue en mora por {V(o.DueToday - i.Amount)}.", false);
        }
        if (_operacion?.Items.FirstOrDefault(x => x.ItemId == i.ItemId) is { AdvanceWithoutPrincipal: true } && !i.AdvanceNoticeAccepted)
            yield return new("el anticipo no abona a capital: el deudor tiene que aceptarlo (marque la casilla).", true);
        if (i.Target == 3 && ConceptoDe(i) is { } k)
        {
            if (k.ThirdPartyMode == 3 && i.BeneficiaryPersonPublicId is null) yield return new("elija el tercero del concepto.", true);
            if ((k.RequiresCrossDocument || k.RequiresInvoice) && string.IsNullOrWhiteSpace(i.CrossDocument)) yield return new("escriba el documento cruce.", true);
            if (k.MaxAmount is { } tope && i.Amount > tope) yield return new($"el concepto admite hasta {V(tope)}.", true);
        }
        if (i.Target == 2 && i.InstallmentPublicIds is { Count: > 0 } marcadas)
        {
            var debe = (_pagables?.DueInstallments?.Installments ?? []).Where(x => marcadas.Contains(x.InstallmentPublicId)).Sum(x => x.Pending);
            if (i.Amount < debe) yield return new($"las cuotas elegidas suman {V(debe)}: paga menos que eso.", false);
        }
    }

    /// <summary>Los avisos de un ítem que se ven en su tarjeta (los mismos de «Antes de cobrar», sin el rótulo).</summary>
    private IEnumerable<string> AvisosDelItem(ItemPedidoRequest i, ObligacionPagableDto? o) =>
        ProblemasDelItem(i, o).Where(p => !_rechazados.ContainsKey(i.ItemId!.Value) || p.Texto != _rechazados[i.ItemId!.Value]).Select(p => p.Texto);

    /// <summary>Cómo queda el producto después de este pago, en una frase.</summary>
    private string? QuedaDespues(DesgloseDelPagoDto d)
    {
        if (d.AccountBalanceAfter is { } saldo) return $"Saldo de la cuenta después: {V(saldo)}";
        if (d.PaidOff) return "Con este pago el crédito queda cancelado.";
        if (d.PayoffAfter is not { } cancelar) return null;
        var texto = $"Queda: para cancelar {V(cancelar)}";
        texto += d.PastDueAfter is > 0m ? $" · vencido {V(d.PastDueAfter.Value)}{(d.DaysPastDueAfter is > 0 ? $" ({d.DaysPastDueAfter} días de mora)" : "")}" : " · al día";
        if (d.NextDueDate is { } proxima) texto += $" · próxima cuota {(d.NextInstallment is { } v ? V(v) + " " : "")}el {proxima:dd/MM/yyyy}";
        return texto;
    }

    // ---------------------------------------------------------------- 2026-11-17: las cuotas pendientes de una cuenta --

    private CuentaPagableDto? _cuotasDe;
    private readonly HashSet<Guid> _cuotasMarcadas = [];

    private List<ExigiblePagableDto> CuotasDeLaCuenta(CuentaPagableDto c) =>
        [.. (_pagables?.DueInstallments?.Installments ?? []).Where(x => x.AccountPublicId == c.AccountPublicId && x.Pending > 0m).OrderBy(x => x.DueDate)];

    private void VerCuotasDeCuenta(CuentaPagableDto c)
    {
        _cuotasDe = c;
        _cuotasMarcadas.Clear();
        // Lo que ya está en «Qué paga» de esa cuenta sale marcado; si no hay nada, todas.
        var enQuePaga = _items.FirstOrDefault(i => i.Target == 2 && i.ProductPublicId == c.AccountPublicId);
        foreach (var q in CuotasDeLaCuenta(c).Where(q => enQuePaga?.InstallmentPublicIds is not { Count: > 0 } ids || ids.Contains(q.InstallmentPublicId)))
            _cuotasMarcadas.Add(q.InstallmentPublicId);
    }

    /// <summary>Las cuotas se pagan en orden: marcar una marca las anteriores; desmarcarla desmarca las posteriores.</summary>
    private void MarcarCuotaDeCuenta(Guid cuota, bool marcar)
    {
        if (_cuotasDe is not { } c) return;
        var cuotas = CuotasDeLaCuenta(c);
        var indice = cuotas.FindIndex(q => q.InstallmentPublicId == cuota);
        if (indice < 0) return;
        for (var k = 0; k < cuotas.Count; k++)
        {
            if (marcar && k <= indice) _cuotasMarcadas.Add(cuotas[k].InstallmentPublicId);
            if (!marcar && k >= indice) _cuotasMarcadas.Remove(cuotas[k].InstallmentPublicId);
        }
    }

    private void AgregarCuotasDeCuenta()
    {
        if (_cuotasDe is not { } c) return;
        var marcadas = CuotasDeLaCuenta(c).Where(q => _cuotasMarcadas.Contains(q.InstallmentPublicId)).ToList();
        if (marcadas.Count == 0) return;
        _items.RemoveAll(i => i.Target == 2 && i.ProductPublicId == c.AccountPublicId);
        // Por cuotas (modalidad 2): la cuenta las recibe de la más antigua a la más nueva, y como se marcan en ese orden, el valor de las marcadas cubre
        // exactamente esas.
        Agregar(new ItemPedidoRequest(2, marcadas.Sum(q => q.Pending), c.AccountPublicId, AccountModality: 2,
            InstallmentPublicIds: marcadas.Select(q => q.InstallmentPublicId).ToList()), $"Cuenta {c.Number} · {string.Join(", ", marcadas.Select(q => q.Period))}");
        _cuotasDe = null;
        ProgramarSimulacion();
    }

    private sealed record RechazoDeItem(Guid ItemId, string Code, string Message);
