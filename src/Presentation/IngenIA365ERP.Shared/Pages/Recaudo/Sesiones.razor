@page "/recaudo/sesiones"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using IngenIA365ERP.Shared.Components.Recaudo
@using IngenIA365ERP.Shared.Services.Http
@using IngenIA365ERP.Shared.Services.Recaudo
@inject SesionesClient Cliente
@inject ConfiguracionDeRecaudoClient Configuracion
@inject INotificationService Notification

<PageTitle>Mi caja - IngenIA365ERP</PageTitle>

@* 2026-11-24 (pedido del dueño): «Mi caja» de Recaudo, igual a la del punto de venta. Sólo lo del cajero: abrir su caja con la base, y con la caja
   abierta ir a cobrar, mover efectivo y arquear y cerrar (en /recaudo/sesiones/{id}/cierre, el arqueo en dos pasos). Las cajas de todos, las diferencias
   por aprobar, el arqueo sorpresivo y el ajuste están aparte, en «Cajas del día» (/recaudo/cajas). Con el arqueo sencillo (Caja.ArqueoEstricto apagado)
   el movimiento con la bóveda no pide segundo custodio ni sello y la reclasificación no pide soporte. Antes (feature 015, US2, T0098) todo esto estaba
   en una sola pantalla con la lista del supervisor debajo. *@
<PermissionGate Required="Receipts.Session.Open" MostrarAviso="true">
<div class="pagina">
    <div class="page-header">
        <h3>Mi caja</h3>
        <div class="toolbar">
            <SfButton CssClass="e-outline" IconCss="e-icons e-refresh" Disabled="@_carga.Activa" OnClick="@CargarAsync">Actualizar</SfButton>
            <PermissionGate Required="Receipts.Session.View">
                <a class="e-btn e-flat" href="/recaudo/cajas">Cajas del día</a>
                <a class="e-btn e-flat" href="/recaudo/cierre-del-dia">Cierre del día</a>
            </PermissionGate>
        </div>
    </div>

    <IndicadorDeCarga Cargando="@_carga.Activa" Texto="Buscando su caja…">
        @if (_actual is not { } s)
        {
            @if (!_carga.Activa)
            {
                <AperturaDeCaja Cajas="@_opcionesDeCaja" Denominaciones="@_denominaciones" Forma="@_politica.FormaDelEfectivo" Ocupado="@_guardado.Activa"
                                AyudaDeLaCaja="La caja donde va a recibir el dinero hoy."
                                AyudaDeLaBase="El efectivo que recibe para dar vueltas; no es recaudo. Si la caja trabaja con fondo fijo, tiene que ser igual al fondo. Sin efectivo, deje 0."
                                Abrir="@AbrirAsync" />
            }
        }
        else
        {
            <MiCajaAbierta Caja="@($"{s.CollectionPointCode} · caja {s.CashBoxCode}")" Dia="@s.BusinessDate" AbiertaEl="@s.OpenedAt" Base="@s.OpeningBase"
                           Esperados="@_esperados" Ciego="@(_esperado?.Hidden == true)" UrlParaCerrar="@UrlDelCierre(s)">
                <Avisos>
                    @if (s.Status == SesionesClient.EstadoOlvidada)
                    {
                        <p class="aviso aviso-alerta">Esta caja quedó abierta después de la hora de corte y ya no recibe pagos. Ciérrela con «Arquear y cerrar».</p>
                    }
                    @* 2026-11-23, caja única: la caja del punto de venta abre y cierra con esta sesión. *@
                    @if (_cajaUnica is { Enabled: true, PosCashRegisterPublicId: not null } cu)
                    {
                        @if (cu.PosSessionOpen)
                        {
                            <p class="aviso aviso-info">Caja única: la caja @cu.CashRegisterCode de @cu.PointOfSaleName está abierta con esta sesión. Venda allí sin abrir
                                otra caja; al «Arquear y cerrar» aquí se cierra sola y se cuenta todo junto.</p>
                        }
                        else if (cu.PosSessionPublicId is not null)
                        {
                            @* 2026-11-25: cerrada con el arqueo, no se abre otra en la misma sesión (lo de una segunda caja no entraba a Recaudo). *@
                            <p class="aviso aviso-info">Caja única: la caja @cu.CashRegisterCode del punto de venta ya se cerró con el arqueo de esta sesión.
                                Termine el arqueo con «Arquear y cerrar».</p>
                        }
                        else if (s.Status == 1)
                        {
                            <p class="aviso aviso-alerta">Caja única: la caja del punto de venta de esta caja no está abierta.
                                <SfButton CssClass="e-flat" Disabled="@_guardado.Activa" OnClick="@AbrirCajaDelPuntoDeVentaAsync">Abrir la caja del punto de venta</SfButton></p>
                        }
                    }
                </Avisos>
                <Acciones>
                    @if (s.Status == 1)
                    {
                        <PermissionGate Required="Receipts.Receipt.Register">
                            <a class="e-btn e-primary" href="/recaudo/caja">Ir a la caja</a>
                        </PermissionGate>
                    }
                    @if (s.Status is 1 or 5)
                    {
                        <PermissionGate Required="Receipts.Session.Close">
                            <a class="e-btn @(s.Status == 5 ? "e-primary" : "e-outline")" href="@UrlDelCierre(s)">Arquear y cerrar</a>
                        </PermissionGate>
                    }
                    @if (s.Status == 1)
                    {
                        <PermissionGate Required="Receipts.Session.Move">
                            <SfButton CssClass="e-outline" OnClick="@AbrirMovimientoAsync">Movimiento de efectivo</SfButton>
                        </PermissionGate>
                        <PermissionGate Required="Receipts.Session.Reclassify">
                            <SfButton CssClass="e-flat" OnClick="@(() => _reclasificacionVisible = true)">Reclasificar un medio</SfButton>
                        </PermissionGate>
                    }
                </Acciones>
            </MiCajaAbierta>
        }
    </IndicadorDeCarga>

    @if (_aprobacion is not null)
    {
        <AprobacionPresenteDeRecaudo Solicitud="_aprobacion.Value" Huella="@_huella" Motivo="@_motivoDeAprobacion" Aprobada="@RepetirConAprobacionAsync"
                                     Cancelada="@(() => _aprobacion = null)" />
    }
</div>

<SfDialog @bind-Visible="_movimientoVisible" Header="Movimiento de efectivo" Width="560px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@_guardado.Activa" Texto="Guardando…">
                <div class="form-grid">
                    <label class="campo">Movimiento
                        <select class="e-input" @bind="_claseDeMovimiento">
                            <option value="2">Recibir de la bóveda</option>
                            <option value="3">Llevar a la bóveda</option>
                            <option value="4">Pasar a otra caja</option>
                        </select>
                    </label>
                    @if (_claseDeMovimiento == 4)
                    {
                        <label class="campo">Caja que recibe
                            <select class="e-input" @bind="_contraparte">
                                <option value="">Elija la caja…</option>
                                @foreach (var o in _otrasAbiertas) { <option value="@o.PublicId">@o.CashBoxCode · @o.CashierName</option> }
                            </select>
                        </label>
                    }
                    else if (_politica.Estricto)
                    {
                        <label class="campo">Segundo custodio
                            <select class="e-input" @bind="_segundoCustodio">
                                <option value="">Elija el custodio…</option>
                                @foreach (var u in _usuarios) { <option value="@u.PublicId">@u.Username</option> }
                            </select>
                        </label>
                        <label class="campo">Sello de la bolsa <input class="e-input" @bind="_sello" maxlength="40" /></label>
                    }
                    <label class="campo campo-ancho">Motivo * <input class="e-input" @bind="_motivo" maxlength="500" /></label>
                </div>
                <p class="hint">Cuente los billetes y monedas que se mueven.</p>
                <BilletesYMonedas Denominaciones="@_denominaciones" Cantidades="@_movimiento" />
            </IndicadorDeCarga>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _movimientoVisible = false)" />
        <DialogButton Content="Registrar" IsPrimary="true" OnClick="@MoverAsync" Disabled="@_guardado.Activa" />
    </DialogButtons>
</SfDialog>

<SfDialog @bind-Visible="_reclasificacionVisible" Header="Reclasificar un medio" Width="520px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@_guardado.Activa" Texto="Guardando…">
                <p class="hint">El recibo no cambia: lo esperado pasa de un medio a otro. Desde efectivo hace falta otra persona que apruebe.</p>
                <div class="form-grid">
                    <label class="campo">Desde
                        <select class="e-input" @bind="_desde">@foreach (var m in _actual?.Means ?? []) { <option value="@m.PaymentMeansPublicId">@m.Name</option> }</select>
                    </label>
                    <label class="campo">Hacia
                        <select class="e-input" @bind="_hacia">@foreach (var m in _actual?.Means ?? []) { <option value="@m.PaymentMeansPublicId">@m.Name</option> }</select>
                    </label>
                    <label class="campo">Valor * <CampoDeValor Valor="@_valor" ValorChanged="@(v => _valor = v ?? 0m)" /></label>
                    <label class="campo campo-ancho">Motivo * <input class="e-input" @bind="_motivo" maxlength="500" /></label>
                </div>
                @if (_actual is { } sesion)
                {
                    <SubirSoporte OwnerEntityType="@AdjuntosDeRecaudo.SoporteDeCaja" OwnerEntityPublicId="@sesion.PublicId"
                                  Rotulo="@(_politica.Estricto ? "Subir el soporte *" : "Subir el soporte (opcional)")" OnDisponible="@(id => _soporte = id)" />
                }
            </IndicadorDeCarga>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _reclasificacionVisible = false)" />
        <DialogButton Content="Reclasificar" IsPrimary="true" OnClick="@(() => ReclasificarAsync(null))" Disabled="@_guardado.Activa" />
    </DialogButtons>
</SfDialog>
</PermissionGate>

@code {
    private readonly EstadoDeCarga _carga = new(), _guardado = new();
    private ClaveDeOperacion _clave = new();
    private SesionDeCajaDto? _actual;
    private EsperadoDeSesionDto? _esperado;
    private IReadOnlyList<(string Medio, decimal Esperado)>? _esperados;
    private CajaUnicaDto? _cajaUnica;
    private PoliticaDeCaja _politica = PoliticaDeCaja.PorDefecto;
    private IReadOnlyList<OpcionDeCaja> _opcionesDeCaja = [];
    private IReadOnlyList<DenominacionDeConteo> _denominaciones = [];
    private IReadOnlyList<Services.Inventario.PersonaDeLaCooperativaDto> _usuarios = [];
    private IReadOnlyList<SesionDeCajaDto> _otrasAbiertas = [];
    private readonly Dictionary<Guid, int> _movimiento = [];
    private string _contraparte = "", _segundoCustodio = "", _desde = "", _hacia = "";
    private string? _sello, _motivo, _huella, _motivoDeAprobacion;
    private Guid? _soporte, _aprobacion;
    private int _claseDeMovimiento = 3;
    private decimal _valor;
    private bool _movimientoVisible, _reclasificacionVisible;
    private Func<Guid, Task>? _repetir;

    private static string UrlDelCierre(SesionDeCajaDto s) => $"/recaudo/sesiones/{s.PublicId}/cierre";

    protected override async Task OnInitializedAsync()
    {
        using (_carga.Iniciar())
        {
            _politica = await Cliente.PoliticaAsync();
            var d = await Cliente.DenominacionesAsync();
            _denominaciones = d.IsSuccess && d.Value is not null
                ? d.Value.Where(x => x.IsActive).Select(x => new DenominacionDeConteo(x.CashDenominationPublicId, x.Value, x.Kind != 1)).ToList()
                : [];
        }
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        using var carga = _carga.Iniciar();
        var r = await Cliente.ActualAsync();
        _actual = r.IsSuccess ? r.Value : null;
        _esperado = null;
        _esperados = null;
        _cajaUnica = null;
        if (_actual is { } s)
        {
            var cu = await Cliente.CajaUnicaAsync(s.PublicId);
            _cajaUnica = cu.IsSuccess ? cu.Value : null;
            // Lo esperado se ve con Receipts.Session.ViewExpected; sin el permiso, la consulta falla y no se muestra.
            var e = await Cliente.EsperadoAsync(s.PublicId);
            _esperado = e.IsSuccess ? e.Value : null;
            if (_esperado is { Hidden: false } esp)
                _esperados = esp.Means.Select(m => (s.Means.FirstOrDefault(x => x.PaymentMeansPublicId == m.PaymentMeansPublicId)?.Name ?? m.Code, m.Expected)).ToList();
            _desde = s.Means.FirstOrDefault()?.PaymentMeansPublicId.ToString() ?? "";
            _hacia = s.Means.Skip(1).FirstOrDefault()?.PaymentMeansPublicId.ToString() ?? "";
        }
        else
        {
            var c = await Configuracion.CajasAsync();
            // 2026-11-25: las cajas de otros cajeros (Caja.SoloCajerosAsignados) se ven pero no se eligen, y las de quien abre van primero.
            _opcionesDeCaja = c.IsSuccess && c.Value is not null
                ? c.Value.OrderByDescending(x => x.OpenableByMe == true && x.CashierNames is { Count: > 0 })
                    .Select(x => new OpcionDeCaja(x.PublicId, $"{x.CollectionPointCode} · {x.Code} · {x.Name}", null,
                        OpcionDeCaja.Para(x.OpenableByMe, x.CashierNames))).ToList()
                : [];
        }
    }

    private async Task AbrirAsync(BaseDeApertura pedido)
    {
        using var g = _guardado.Iniciar();
        var r = pedido.Billetes is { } billetes
            ? await Cliente.AbrirAsync(new AbrirSesionRequest(pedido.Caja, Billetes(billetes)), _clave)
            : await Cliente.AbrirAsync(new AbrirSesionRequest(pedido.Caja, [], pedido.Valor ?? 0m), _clave);
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo abrir la caja."); return; }
        _clave = new ClaveDeOperacion();
        await Notification.SuccessAsync("Caja abierta.");
        await CargarAsync();
    }

    private static IReadOnlyList<DenominacionContadaRequest> Billetes(IReadOnlyDictionary<Guid, int> cantidades) =>
        cantidades.Where(c => c.Value > 0).Select(c => new DenominacionContadaRequest(c.Key, c.Value)).ToList();

    private async Task AbrirMovimientoAsync()
    {
        _movimiento.Clear();
        _motivo = null;
        _contraparte = "";
        _segundoCustodio = "";
        _sello = null;
        _movimientoVisible = true;
        // Las otras cajas abiertas hoy (para pasar efectivo) y, con el arqueo estricto, quién puede ser segundo custodio.
        var abiertas = await Cliente.SesionesAsync(estado: 1);
        _otrasAbiertas = abiertas.IsSuccess && abiertas.Value is not null ? abiertas.Value.Where(x => x.PublicId != _actual?.PublicId).ToList() : [];
        if (_politica.Estricto && _usuarios.Count == 0)
        {
            var u = await Configuracion.UsuariosAsync();
            if (u.IsSuccess && u.Value is not null) _usuarios = u.Value.Items.Where(x => x.IsActive).ToList();
        }
    }

    private async Task MoverAsync()
    {
        if (_actual is null) return;
        if (string.IsNullOrWhiteSpace(_motivo)) { await Notification.WarningAsync("Escriba el motivo."); return; }
        using var g = _guardado.Iniciar();
        var r = await Cliente.MoverAsync(_actual.PublicId, new MovimientoRequest(_claseDeMovimiento, Billetes(_movimiento), _motivo.Trim(),
            Guid.TryParse(_contraparte, out var c) ? c : null, Guid.TryParse(_segundoCustodio, out var s) ? s : null, _sello), _clave);
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo registrar el movimiento."); return; }
        _clave = new ClaveDeOperacion();
        _movimientoVisible = false;
        await Notification.SuccessAsync($"Movimiento {r.Value!.Number} registrado.");
        await CargarAsync();
    }

    private async Task ReclasificarAsync(Guid? aprobacion)
    {
        if (_actual is null || !Guid.TryParse(_desde, out var desde) || !Guid.TryParse(_hacia, out var hacia)) return;
        if (string.IsNullOrWhiteSpace(_motivo)) { await Notification.WarningAsync("Escriba el motivo."); return; }
        using var g = _guardado.Iniciar();
        var r = await Cliente.ReclasificarAsync(_actual.PublicId, new ReclasificacionRequest(desde, hacia, _valor, _motivo.Trim(), _soporte), _clave, aprobacion);
        if (PideAprobacion(r, $"Reclasificar {_valor:N0}", ReclasificarAsync)) return;
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo reclasificar."); return; }
        _clave = new ClaveDeOperacion();
        _reclasificacionVisible = false;
        _aprobacion = null;
        _soporte = null;
        await Notification.SuccessAsync("Medio reclasificado.");
        await CargarAsync();
    }

    /// <summary>Un 428: muestra la aprobación presente y deja lista la repetición con la misma clave.</summary>
    private bool PideAprobacion<T>(Services.Inventario.ResultadoDeInventario<T> r, string motivo, Func<Guid?, Task> repetir)
    {
        if (r.ErrorCode != "Approvals.PresenceRequired") return false;
        _aprobacion = r.Dato<Guid?>("approvalRequestPublicId");
        _huella = r.Dato<string>("contentSha256");
        _motivoDeAprobacion = motivo;
        _repetir = id => repetir(id);
        return true;
    }

    private async Task RepetirConAprobacionAsync(Guid solicitud)
    {
        if (_repetir is not null) await _repetir(solicitud);
    }

    private async Task AbrirCajaDelPuntoDeVentaAsync()
    {
        if (_actual is null) return;
        using var g = _guardado.Iniciar();
        var r = await Cliente.AbrirCajaDelPuntoDeVentaAsync(_actual.PublicId, new ClaveDeOperacion());
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo abrir la caja del punto de venta."); return; }
        await Notification.SuccessAsync("Caja del punto de venta abierta.");
        await CargarAsync();
    }
}
