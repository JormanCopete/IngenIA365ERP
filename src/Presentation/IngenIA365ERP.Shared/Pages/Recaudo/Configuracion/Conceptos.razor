@page "/recaudo/configuracion/conceptos"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using IngenIA365ERP.Shared.Services.Http
@using IngenIA365ERP.Shared.Services.Recaudo
@inject ConfiguracionDeRecaudoClient Configuracion
@inject IngenIA365ERP.Shared.Services.Core.MediosDePagoClient MediosDePago
@inject INotificationService Notification

<PageTitle>Conceptos varios - IngenIA365ERP</PageTitle>

@* Feature 015, US1 (T0077; FR-027, FR-179): los conceptos de ingreso y egreso no ligados a un producto. Uno gravado «exige factura»: no se cobra sin la
   factura de Comercial como documento cruce. Los del sistema no se inactivan.
   2026-11-16 (pedido del dueño, conceptos como el SOAT): cada concepto dice cómo funciona su tercero —quien paga, un tercero fijo (p. ej. la
   aseguradora, a cuyo nombre queda el registro contable para girarle después) o el que elija el cajero— y puede traer un valor sugerido. La cuenta
   contable sale de la matriz de Recaudo (Contabilidad › Recaudo › Matriz, rol «Concepto vario» con el código del concepto): aquí se muestra cuál es y
   se avisa si falta, porque sin ella el recibo no se contabiliza. *@
<PermissionGate Required="Receipts.Setup.View" MostrarAviso="true">
<div class="pagina">
    <div class="page-header">
        <h3>Conceptos varios</h3>
        <div class="toolbar">
            <SfButton CssClass="e-outline" IconCss="e-icons e-refresh" Disabled="@_carga.Activa" OnClick="@CargarAsync">Actualizar</SfButton>
            <PermissionGate Required="Receipts.Setup.Manage">
                <SfButton CssClass="e-primary" IconCss="e-icons e-plus" OnClick="@(() => Abrir(null))">Nuevo concepto</SfButton>
            </PermissionGate>
        </div>
    </div>

    <IndicadorDeCarga Cargando="@(_carga.Activa || _guardado.Activa)" Texto="@(_guardado.Activa ? "Guardando…" : "Cargando…")">
        @if (_conceptos.Count == 0)
        {
            <p class="texto-tenue">No hay conceptos varios.</p>
        }
        else
        {
            <div class="tabla-desplazable">
                <table class="data-grid">
                    <thead><tr><th>Código</th><th>Nombre</th><th>Sentido</th><th>Tercero contable</th><th>Uso</th><th>Cuenta</th><th>Valor sugerido</th><th>Documento cruce</th><th>Factura</th><th>Aprobación</th><th>Máximo</th><th>Del sistema</th><th>Estado</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var c in _conceptos)
                        {
                            <tr>
                                <td>@c.Code</td><td>@c.Name</td><td>@(c.Direction == 2 ? "Egreso" : "Ingreso")</td><td>@ModoDeTercero(c)</td>
                                <td>@(c.CollectedForThirdParty ? "Recaudo para terceros" : c.IsAdvance ? $"Anticipo · se cruza con {c.AdvanceMeansCode}{(c.AdvanceCreditLineCode is { } l ? $" · solo en la línea {l}" : "")}" : "")</td>
                                <td class="@(c.AccountCode is null ? "texto-alerta" : null)">@(c.AccountCode is { } cuenta ? $"{cuenta} · {c.AccountName}" : "Sin cuenta en la matriz")</td>
                                <td class="numero">@c.SuggestedAmount?.ToString("N0")</td>
                                <td>@SiNo(c.RequiresCrossDocument)</td><td>@SiNo(c.RequiresInvoice)</td><td>@SiNo(c.RequiresApproval)</td>
                                <td>@c.MaxAmount?.ToString("N0")</td><td>@SiNo(c.IsSystem)</td><td>@ConfiguracionDeRecaudoClient.Estado(c.Status)</td>
                                <td>
                                    <PermissionGate Required="Receipts.Setup.Manage">
                                        <SfButton CssClass="e-flat" OnClick="@(() => Abrir(c))">Editar</SfButton>
                                        @if (c.Status == 1 && !c.IsSystem)
                                        {
                                            <SfButton CssClass="e-flat" Disabled="@_guardado.Activa" OnClick="@(() => InactivarAsync(c))">Inactivar</SfButton>
                                        }
                                    </PermissionGate>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </IndicadorDeCarga>
</div>

<SfDialog @bind-Visible="_visible" Header="@(_editando is null ? "Nuevo concepto vario" : "Editar concepto vario")" Width="640px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@_guardado.Activa" Texto="Guardando…">
                <div class="rejilla-campos">
                    @if (_editando is null)
                    {
                        <CampoCodigo Catalogo="conceptos-varios" @bind-Value="_codigo" Obligatorio="true" DuplicadoChanged="@(d => _duplicado = d)" />
                        <div>
                            <label>Sentido</label>
                            <select class="form-control" @bind="_sentido"><option value="1">Ingreso</option><option value="2">Egreso</option></select>
                        </div>
                    }
                    else
                    {
                        <div><label>Código</label><input class="form-control" value="@_editando.Code" readonly /></div>
                    }
                    <div><label>Nombre</label><input class="form-control" @bind="_nombre" maxlength="150" /></div>
                    <div>
                        <label>Tercero contable</label>
                        <select class="form-control" @bind="_modoDeTercero">
                            <option value="1">Quien paga</option>
                            <option value="2">Un tercero fijo (p. ej. la aseguradora)</option>
                            <option value="3">El que elija el cajero</option>
                        </select>
                    </div>
                    @if (_modoDeTercero == 2)
                    {
                        <div class="campo-ancho">
                            <label>Tercero fijo</label>
                            <PersonSearchPicker Selected="@_terceroFijo" SelectedChanged="@(p => _terceroFijo = p)" Compacto="true" ShowHelpText="false" />
                        </div>
                    }
                    <div><label>Valor sugerido (opcional)</label><SfNumericTextBox TValue="decimal?" @bind-Value="_sugerido" Format="N0" Min="0" /></div>
                    <div><label><input type="checkbox" @bind="_tercero" /> Exige tercero</label></div>
                    <div><label><input type="checkbox" @bind="_cruce" /> Exige documento cruce</label></div>
                    <div><label><input type="checkbox" @bind="_factura" /> Exige factura (concepto gravado)</label></div>
                    <div><label><input type="checkbox" @bind="_aprobacion" /> Exige aprobación</label></div>
                    <div><label>Valor máximo (opcional)</label><SfNumericTextBox TValue="decimal?" @bind-Value="_maximo" Format="N0" Min="0" /></div>
                    @* 2026-11-23 (pedido del dueño): recaudo para terceros (el «solidario») y anticipo de concepto (la administración pagada antes de causarse). *@
                    <div class="campo-ancho"><label><input type="checkbox" checked="@_paraTerceros" @onchange="@(e => { _paraTerceros = e.Value is true; if (_paraTerceros) { _anticipo = false; _modoDeTercero = 2; _cruce = true; } })" />
                        Recaudo para terceros: lo recibido es del tercero fijo y se le paga después</label></div>
                    <div class="campo-ancho"><label><input type="checkbox" checked="@_anticipo" @onchange="@(e => { _anticipo = e.Value is true; if (_anticipo) { _paraTerceros = false; _modoDeTercero = 1; _factura = false; } })" />
                        Anticipo: queda como saldo a favor del asociado en este concepto y se cruza después en la caja</label></div>
                    @if (_anticipo)
                    {
                        <div class="campo-ancho">
                            <label>Medio de pago con que la caja cruza el anticipo (clase «otro»)</label>
                            <select class="form-control" value="@(_medioDelAnticipo?.ToString() ?? "")" @onchange="@(e => _medioDelAnticipo = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null)">
                                <option value="">Elija…</option>
                                @foreach (var m in _mediosOtro) { <option value="@m.PaymentMeansPublicId">@m.Code · @m.Name</option> }
                            </select>
                        </div>
                        @* 2026-11-23 (cruce automático): con la línea, el anticipo se cruza solo cuando nace una obligación de esa línea. *@
                        <div>
                            <label>Línea de Cartera que cubre (opcional)</label>
                            <input class="form-control" maxlength="20" placeholder="Código de la línea" value="@_lineaQueCubre"
                                   @onchange="@(e => _lineaQueCubre = e.Value?.ToString()?.Trim().ToUpperInvariant())" />
                        </div>
                    }
                </div>
                @if (_paraTerceros)
                {
                    <p class="hint">Recaudo para terceros: la caja propone el documento cruce del período ({código}-{aaaamm}). En la matriz de Recaudo el rol «Concepto vario»
                        con este código va a la cuenta por pagar al tercero (p. ej. 24109505), exigiendo tercero y documento cruce. Se liquida en Recaudo → Recaudo para
                        terceros, que crea la orden de pago en Tesorería.</p>
                }
                @if (_anticipo)
                {
                    <p class="hint">Anticipo: en la matriz de Recaudo el rol «Concepto vario» con este código y el rol «Medio por cobrar» con el medio elegido van a la cuenta
                        del anticipo (p. ej. 272095001). El medio tiene que estar habilitado en los puntos de recaudo. Los saldos del sistema anterior se cargan con la
                        plantilla «Anticipos de concepto al corte».</p>
                    <p class="hint">Con la línea de Cartera, cuando se factura un cargo a crédito de esa línea (por ejemplo, la administración del vehículo), el anticipo se
                        cruza solo contra la cuota, hasta lo disponible, con un recibo «Cruce de anticipo» (cree en Tipos de documento uno de esa clase). Si no se puede,
                        llega la alerta «Anticipo por cruzar en la caja». Sin línea, el anticipo se cruza a mano en la caja.</p>
                }
                <p class="hint">Un concepto que exige factura exige también el tercero y el documento cruce. La cuenta contable se configura en la matriz de
                    Recaudo de Contabilidad con el rol «Concepto vario» y este código.</p>
                @if (_editando is { AccountCode: null })
                {
                    <p class="aviso aviso-alerta">Este concepto todavía no tiene cuenta en la matriz de Recaudo: sin ella el recibo no se contabiliza.</p>
                }
            </IndicadorDeCarga>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@(() => _visible = false)" />
        <DialogButton Content="Guardar" IsPrimary="true" OnClick="@GuardarAsync" Disabled="@(_guardado.Activa || _duplicado)" />
    </DialogButtons>
</SfDialog>
</PermissionGate>

@code {
    private readonly EstadoDeCarga _carga = new(), _guardado = new();
    private ClaveDeOperacion _clave = new();
    private IReadOnlyList<ConceptoVarioDto> _conceptos = [];
    private ConceptoVarioDto? _editando;
    private string? _codigo;
    private string _nombre = "";
    private int _sentido = 1;
    private decimal? _maximo, _sugerido;
    private int _modoDeTercero = 1;
    private PersonSearchPicker.PersonSearchItem? _terceroFijo;

    private static string ModoDeTercero(ConceptoVarioDto c) => c.ThirdPartyMode switch
    {
        2 => c.DefaultThirdPartyName is { } nombre ? $"Fijo: {nombre}" : "Fijo",
        3 => "Lo elige el cajero",
        _ => c.RequiresThirdParty ? "Quien paga (exigido)" : "Quien paga",
    };
    private bool _tercero, _cruce, _factura, _aprobacion, _visible, _duplicado;

    // 2026-11-23: recaudo para terceros y anticipo con su medio (los medios de la clase «otro», 99).
    private bool _paraTerceros, _anticipo;
    private Guid? _medioDelAnticipo;
    private string? _lineaQueCubre;
    private IReadOnlyList<IngenIA365ERP.Shared.Services.Core.MedioDePagoDto> _mediosOtro = [];

    private static string SiNo(bool v) => v ? "Sí" : "No";

    protected override Task OnInitializedAsync() => CargarAsync();

    private async Task CargarAsync()
    {
        using var carga = _carga.Iniciar();
        if (_mediosOtro.Count == 0)
        {
            var medios = await MediosDePago.ListarAsync(clase: 99, activos: true);
            if (medios.IsSuccess && medios.Value is not null) _mediosOtro = medios.Value;
        }
        var r = await Configuracion.ConceptosAsync();
        if (!r.IsSuccess || r.Value is null) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudieron consultar los conceptos."); return; }
        _conceptos = r.Value;
    }

    private void Abrir(ConceptoVarioDto? c)
    {
        _editando = c;
        _codigo = null;
        _nombre = c?.Name ?? "";
        _sentido = c?.Direction ?? 1;
        _tercero = c?.RequiresThirdParty ?? false;
        _cruce = c?.RequiresCrossDocument ?? false;
        _factura = c?.RequiresInvoice ?? false;
        _aprobacion = c?.RequiresApproval ?? false;
        _maximo = c?.MaxAmount;
        _sugerido = c?.SuggestedAmount;
        _paraTerceros = c?.CollectedForThirdParty ?? false;
        _anticipo = c?.IsAdvance ?? false;
        _medioDelAnticipo = c?.AdvanceMeansPublicId;
        _lineaQueCubre = c?.AdvanceCreditLineCode;
        _modoDeTercero = c?.ThirdPartyMode ?? 1;
        _terceroFijo = c?.DefaultThirdPartyPublicId is { } fijo
            ? new PersonSearchPicker.PersonSearchItem { PublicId = fijo, FullName = c.DefaultThirdPartyName ?? "Tercero", IdentificationNumber = string.Empty }
            : null;
        _duplicado = false;
        _clave = new ClaveDeOperacion();
        _visible = true;
    }

    private async Task GuardarAsync()
    {
        if (string.IsNullOrWhiteSpace(_nombre)) { await Notification.WarningAsync("Escriba el nombre."); return; }
        if (_modoDeTercero == 2 && _terceroFijo is null) { await Notification.WarningAsync("Elija el tercero fijo del concepto."); return; }
        var fijo = _modoDeTercero == 2 ? _terceroFijo?.PublicId : null;
        using var guardado = _guardado.Iniciar();
        Services.Inventario.ResultadoDeInventario<ConceptoVarioDto> r;
        if (_editando is null)
        {
            if (string.IsNullOrWhiteSpace(_codigo)) { await Notification.WarningAsync("Escriba el código."); return; }
            r = await Configuracion.CrearConceptoAsync(new CrearConceptoRequest(_codigo, _nombre.Trim(), _sentido, _tercero, _cruce, _factura, _aprobacion, _maximo,
                _modoDeTercero, fijo, _sugerido, _paraTerceros, _anticipo, _anticipo ? _medioDelAnticipo : null, _anticipo ? _lineaQueCubre : null), _clave);
        }
        else
        {
            r = await Configuracion.EditarConceptoAsync(_editando.PublicId, new EditarConceptoRequest(_nombre.Trim(), _tercero, _cruce, _factura, _aprobacion, _maximo,
                _modoDeTercero, fijo, _sugerido, _paraTerceros, _anticipo, _anticipo ? _medioDelAnticipo : null, _anticipo ? _lineaQueCubre : null), _clave);
        }
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo guardar el concepto."); return; }
        _visible = false;
        await Notification.SuccessAsync("Concepto guardado.");
        await CargarAsync();
    }

    private async Task InactivarAsync(ConceptoVarioDto c)
    {
        using var guardado = _guardado.Iniciar();
        var r = await Configuracion.InactivarConceptoAsync(c.PublicId, new ClaveDeOperacion());
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo inactivar el concepto."); return; }
        await Notification.SuccessAsync("Concepto inactivado.");
        await CargarAsync();
    }
}
