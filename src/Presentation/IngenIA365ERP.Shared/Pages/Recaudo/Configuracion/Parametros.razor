@page "/recaudo/configuracion/parametros"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using IngenIA365ERP.Shared.Services.Http
@using IngenIA365ERP.Shared.Services.Inventario
@using IngenIA365ERP.Shared.Services.Recaudo
@inject ConfiguracionDeRecaudoClient Configuracion
@inject INotificationService Notification

<PageTitle>Parámetros de Recaudo - IngenIA365ERP</PageTitle>

@* 2026-11-25 (pedido del dueño): los parámetros de Recaudo (RCD) —la caja, el arqueo, la caja única, los recibos— con su valor vigente, agrupados por
   tema y con la caja primero. Hasta ese día no había pantalla: regían siempre con su defecto. Nada se edita en su sitio: «Cambiar» registra una vigencia
   nueva desde una fecha y con motivo, y la anterior queda en el historial. Las reglas del módulo las aplica el servidor (por ejemplo, la caja única no se
   enciende sin sus requisitos) y su mensaje se muestra tal cual. *@
<PermissionGate Required="Receipts.Setup.View" MostrarAviso="true">
<div class="pagina">
    <div class="page-header">
        <h3>Parámetros de Recaudo</h3>
        <div class="toolbar">
            <input type="search" class="e-input" placeholder="Buscar parámetro…" @bind="_buscar" @bind:event="oninput" />
            <SfButton CssClass="e-outline" IconCss="e-icons e-refresh" Disabled="@_carga.Activa" OnClick="@CargarAsync">Actualizar</SfButton>
        </div>
    </div>
    <p class="texto-apoyo">Un cambio rige desde la fecha que indique y queda en el historial con su motivo. La caja los lee al momento de cada operación.</p>

    <IndicadorDeCarga Cargando="@_carga.Activa">
        @foreach (var grupo in Grupos())
        {
            <section class="info-card">
                <h4>@grupo.Key</h4>
                <div class="tabla-desplazable">
                    <table class="data-grid">
                        <thead><tr><th>Parámetro</th><th>Valor vigente</th><th>Desde</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var p in grupo)
                            {
                                var parametro = p;
                                <tr class="@(_elegido?.Key == parametro.Key ? "resaltada" : "")">
                                    <td><strong>@parametro.Key</strong><br /><span class="texto-tenue">@parametro.Description</span></td>
                                    <td>@Mostrar(parametro, parametro.Current.Value)
                                        @foreach (var s in parametro.Scheduled)
                                        {
                                            <div class="texto-tenue">Desde el @s.ValidFrom.ToString("dd/MM/yyyy"): @Mostrar(parametro, s.Value)</div>
                                        }
                                    </td>
                                    <td>@(parametro.Current.Source == "Version" ? parametro.Current.ValidFrom?.ToString("dd/MM/yyyy") : "De fábrica")</td>
                                    <td class="acciones-fila">
                                        <PermissionGate Required="Receipts.Setup.Manage">
                                            <SfButton CssClass="e-flat e-small" OnClick="@(() => AbrirCambio(parametro))">Cambiar</SfButton>
                                        </PermissionGate>
                                        <SfButton CssClass="e-flat e-small" OnClick="@(() => VerHistorialAsync(parametro))">Historial</SfButton>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
        @if (!_carga.Activa && _parametros.Count == 0)
        {
            <p class="texto-tenue">No hay parámetros para mostrar.</p>
        }
    </IndicadorDeCarga>

    @if (_elegido is { } elegido)
    {
        <section class="info-card">
            <h4>Historial de @elegido.Key</h4>
            <IndicadorDeCarga Cargando="@_historial.Activa">
                @if (_vigencias.Count == 0)
                {
                    <p class="texto-tenue">Sin cambios registrados: rige el valor de fábrica (@Mostrar(elegido, elegido.DefaultValue)).</p>
                }
                else
                {
                    <div class="tabla-desplazable">
                        <table class="data-grid">
                            <thead><tr><th>Valor</th><th>Desde</th><th>Hasta</th><th>Motivo</th><th>Registró</th><th>El</th></tr></thead>
                            <tbody>
                                @foreach (var v in _vigencias)
                                {
                                    <tr>
                                        <td>@Mostrar(elegido, v.Value)</td>
                                        <td>@v.ValidFrom.ToString("dd/MM/yyyy")</td>
                                        <td>@(v.ValidTo?.ToString("dd/MM/yyyy") ?? "—")</td>
                                        <td>@v.Reason</td>
                                        <td>@v.CreatedBy</td>
                                        <td>@v.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </IndicadorDeCarga>
        </section>
    }
</div>

<SfDialog @bind-Visible="_mostrarCambio" Header="Cambiar el parámetro" Width="600px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@_guardado.Activa" Texto="Registrando…">
                @if (_editado is { } p)
                {
                    <p><strong>@p.Key</strong></p>
                    <p class="texto-apoyo">@p.Description</p>
                    <p class="texto-tenue">Hoy: @Mostrar(p, p.Current.Value).</p>
                    <div class="form-grid">
                        <label class="campo">Nuevo valor *
                            @if (p.Type == "Bool")
                            {
                                <select class="e-input" @bind="_valor"><option value="true">Sí</option><option value="false">No</option></select>
                            }
                            else if (p.AllowedValues is { Count: > 0 } valores)
                            {
                                <select class="e-input" @bind="_valor">
                                    <option value="">Elija…</option>
                                    @foreach (var v in valores) { <option value="@v">@v</option> }
                                </select>
                            }
                            else if (p.Type == "Time")
                            {
                                <input type="time" class="e-input" @bind="_valor" />
                            }
                            else
                            {
                                <input class="e-input" @bind="_valor" inputmode="@(p.Type is "Int" or "Decimal" ? "decimal" : "text")" />
                            }
                        </label>
                        <label class="campo">Rige desde *
                            <input type="date" class="e-input" value="@_desde.ToString("yyyy-MM-dd")" @onchange="@(e => _desde = DateOnly.TryParse(e.Value?.ToString(), out var d) ? d : _desde)" />
                        </label>
                    </div>
                    <label class="campo campo-ancho">Motivo * <input class="e-input" @bind="_motivo" @bind:event="oninput" maxlength="500" placeholder="Por qué se cambia" /></label>
                    @if (_error is not null)
                    {
                        <p class="aviso aviso-error" role="alert">@_error</p>
                    }
                    <div class="toolbar">
                        <SfButton CssClass="e-primary" Disabled="@(_guardado.Activa || string.IsNullOrWhiteSpace(_motivo) || string.IsNullOrWhiteSpace(_valor))"
                                  OnClick="@GuardarAsync">Registrar el cambio</SfButton>
                        <SfButton CssClass="e-outline" OnClick="@(() => _mostrarCambio = false)">Cancelar</SfButton>
                    </div>
                }
            </IndicadorDeCarga>
        </Content>
    </DialogTemplates>
</SfDialog>
</PermissionGate>

@code {
    private readonly EstadoDeCarga _carga = new(), _historial = new(), _guardado = new();
    private ClaveDeOperacion _clave = new();
    private List<ParametroDto> _parametros = [];
    private List<VigenciaDeParametroDto> _vigencias = [];
    private ParametroDto? _elegido, _editado;
    private bool _mostrarCambio;
    private string _buscar = "", _valor = "", _motivo = "";
    private string? _error;
    private DateOnly _desde = DiaDeCaja.Hoy();

    protected override Task OnInitializedAsync() => CargarAsync();

    private async Task CargarAsync()
    {
        using var carga = _carga.Iniciar();
        var r = await Configuracion.ParametrosAsync();
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudieron consultar los parámetros."); return; }
        _parametros = (r.Value ?? []).ToList();
    }

    /// <summary>Por tema (lo que va antes del primer punto de la clave), con la caja primero.</summary>
    private IEnumerable<IGrouping<string, ParametroDto>> Grupos() =>
        _parametros
            .Where(p => string.IsNullOrWhiteSpace(_buscar)
                || p.Key.Contains(_buscar, StringComparison.OrdinalIgnoreCase)
                || p.Description.Contains(_buscar, StringComparison.OrdinalIgnoreCase))
            .OrderBy(p => p.Key, StringComparer.OrdinalIgnoreCase)
            .GroupBy(p => Tema(p.Key))
            .OrderBy(g => g.Key == "Caja" ? 0 : 1).ThenBy(g => g.Key, StringComparer.OrdinalIgnoreCase);

    private static string Tema(string clave) => clave.IndexOf('.') is > 0 and var i ? clave[..i] : clave;

    private static string Mostrar(ParametroDto p, string? valor) => p.Type == "Bool"
        ? (string.Equals(valor, "true", StringComparison.OrdinalIgnoreCase) ? "Sí" : "No")
        : string.IsNullOrWhiteSpace(valor) ? "Sin valor" : valor;

    private async Task VerHistorialAsync(ParametroDto p)
    {
        _elegido = p;
        _vigencias = [];
        using var carga = _historial.Iniciar();
        var r = await Configuracion.HistorialDeParametroAsync(p.Key);
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo consultar el historial."); return; }
        _vigencias = (r.Value ?? []).ToList();
    }

    private void AbrirCambio(ParametroDto p)
    {
        _editado = p;
        _valor = p.Type == "Bool" ? (string.Equals(p.Current.Value, "true", StringComparison.OrdinalIgnoreCase) ? "false" : "true") : p.Current.Value ?? "";
        _desde = DiaDeCaja.Hoy();
        _motivo = "";
        _error = null;
        _clave = new ClaveDeOperacion();
        _mostrarCambio = true;
    }

    private async Task GuardarAsync()
    {
        if (_editado is not { } p) return;
        _error = null;
        using var guardado = _guardado.Iniciar();
        var r = await Configuracion.NuevaVigenciaAsync(p.Key, new NuevaVigenciaDeRecaudoRequest(_valor.Trim(), _desde, _motivo.Trim()), _clave);
        if (!r.IsSuccess)
        {
            _error = r.ErrorMessage ?? "No se pudo registrar el cambio.";
            return;
        }
        _mostrarCambio = false;
        await Notification.SuccessAsync($"{p.Key}: {Mostrar(p, _valor)} desde el {_desde:dd/MM/yyyy}.");
        await CargarAsync();
        if (_elegido?.Key == p.Key) await VerHistorialAsync(_parametros.FirstOrDefault(x => x.Key == p.Key) ?? p);
    }
}
