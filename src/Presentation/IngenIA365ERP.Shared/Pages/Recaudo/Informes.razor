@page "/recaudo/informes"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using IngenIA365ERP.Shared.Services.Recaudo
@using IngenIA365ERP.Shared.Services.Nomina
@using IngenIA365ERP.Shared.Services.Reportes
@using IngenIA365ERP.Shared.Components.Reportes
@inject InformesDeRecaudoYTesoreriaClient InformesApi
@inject ConfiguracionDeRecaudoClient Configuracion
@inject INotificationService Notification
@inject DescargaDeArchivos Descargas

<PageTitle>Informes de Recaudo - IngenIA365ERP</PageTitle>

@* Feature 015, US21 (T0316; FR-152 parte R0, FR-154; api.md §17): el centro de informes de Recaudo. El selector sale del registro de vistas
   (GET /api/reports/receipts); filtros de rango, corte, punto, caja y la agrupación del recaudo del día. Exportar exige Receipts.Reports.Export y queda en
   la auditoría. Las columnas ocultas (_sesion, _recibo, _partida…) no se pintan ni se exportan. *@
<PermissionGate Required="Receipts.Reports.View" MostrarAviso="true">
<div class="pagina">
    <div class="page-header">
        <h3>Informes de Recaudo</h3>
        <div class="toolbar">
            @if (_tabla is not null && _vista is not null)
            {
                <PermissionGate Required="Receipts.Reports.Export">
                    <SfButton CssClass="e-outline" IconCss="e-icons e-download" Disabled="@_carga.Activa" OnClick="@(() => DescargarAsync("xlsx"))">Excel</SfButton>
                    <SfButton CssClass="e-outline" IconCss="e-icons e-download" Disabled="@_carga.Activa" OnClick="@(() => DescargarAsync("pdf"))">PDF</SfButton>
                </PermissionGate>
            }
        </div>
    </div>

    <IndicadorDeCarga Cargando="@_cargaVistas.Activa" Texto="Buscando los informes disponibles…">
        @if (_vistas.Count > 0)
        {
            <div class="toolbar">
                <label class="campo">Informe
                    <select class="e-input" value="@(_vista?.Key)" @onchange="@(e => CambiarVista(e.Value?.ToString()))">
                        @foreach (var v in _vistas) { <option value="@v.Key">@v.Name</option> }
                    </select>
                </label>
                @if (Usa("from"))
                {
                    <label class="campo">Desde <input type="date" class="e-input" value="@Fecha(_desde)" @onchange="@(e => _desde = LeerFecha(e.Value))" /></label>
                }
                @if (Usa("to"))
                {
                    <label class="campo">Hasta <input type="date" class="e-input" value="@Fecha(_hasta)" @onchange="@(e => _hasta = LeerFecha(e.Value))" /></label>
                }
                @if (Usa("asOf"))
                {
                    <label class="campo">Con corte al <input type="date" class="e-input" value="@Fecha(_corte)" @onchange="@(e => _corte = LeerFecha(e.Value))" /></label>
                }
                @if (Usa("point") && _puntos.Count > 0)
                {
                    <label class="campo">Punto
                        <select class="e-input" value="@(_punto?.ToString() ?? "")" @onchange="@(e => _punto = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null)">
                            <option value="">Todos los del alcance</option>
                            @foreach (var p in _puntos) { <option value="@p.PublicId">@p.Code · @p.Name</option> }
                        </select>
                    </label>
                }
                @if (Usa("cashBox") && _cajas.Count > 0)
                {
                    <label class="campo">Caja
                        <select class="e-input" value="@(_caja?.ToString() ?? "")" @onchange="@(e => _caja = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null)">
                            <option value="">Todas</option>
                            @foreach (var c in _cajas.Where(c => _punto is null || c.CollectionPointPublicId == _punto)) { <option value="@c.PublicId">@c.CollectionPointCode · @c.Code</option> }
                        </select>
                    </label>
                }
                @if (_vista?.OwnFilters?.Contains("groupBy") == true)
                {
                    <label class="campo">Agrupar por
                        <select class="e-input" @bind="_agrupar">
                            @foreach (var (valor, texto) in Agrupaciones) { <option value="@valor">@texto</option> }
                        </select>
                    </label>
                }
                <SfButton CssClass="e-primary" IconCss="e-icons e-search" Disabled="@(_carga.Activa || _vista is null)" OnClick="@AplicarAsync">Consultar</SfButton>
            </div>
            <p class="texto-tenue">@(_vista?.Description)</p>
        }
        else if (!_cargaVistas.Activa)
        {
            <p class="texto-tenue">No hay informes de Recaudo disponibles para su usuario.</p>
        }
    </IndicadorDeCarga>

    <IndicadorDeCarga Cargando="@_carga.Activa">
        @if (_vistas.Count > 0)
        {
            <TablaDeReporte Tabla="@_tabla" TextoSinTabla="Elija el informe y los filtros y pulse «Consultar»." />
        }
    </IndicadorDeCarga>
</div>
</PermissionGate>

@code {
    private readonly EstadoDeCarga _cargaVistas = new(), _carga = new();
    private List<VistaDeInformeDeModuloDto> _vistas = [];
    private List<PuntoDeRecaudoDto> _puntos = [];
    private List<CajaDeRecaudoDto> _cajas = [];
    private VistaDeInformeDeModuloDto? _vista;
    private DateOnly? _desde, _hasta, _corte;
    private Guid? _punto, _caja;
    private string _agrupar = "means";
    private string _aplicado = string.Empty;
    private TablaReporteDto? _tabla;
    private bool _iniciado;

    private static readonly (string Valor, string Texto)[] Agrupaciones =
    [
        ("means", "Medio"), ("point", "Punto"), ("cashBox", "Caja"), ("cashier", "Cajero"), ("channel", "Canal"), ("module", "Módulo"), ("product", "Producto o línea"),
    ];

    [SupplyParameterFromQuery(Name = "vista")] public string? Vista { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (_iniciado) return;
        _iniciado = true;
        var hoy = DateOnly.FromDateTime(DateTime.Today);
        (_desde, _hasta, _corte) = (new DateOnly(hoy.Year, hoy.Month, 1), hoy, hoy);
        using (_cargaVistas.Iniciar())
        {
            var r = await InformesApi.VistasAsync(InformesDeRecaudoYTesoreriaClient.Recaudo);
            if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudieron consultar los informes disponibles."); return; }
            _vistas = [.. r.Value ?? []];
            var puntos = await Configuracion.PuntosAsync();
            _puntos = puntos.IsSuccess ? [.. puntos.Value ?? []] : [];
            var cajas = await Configuracion.CajasAsync();
            _cajas = cajas.IsSuccess ? [.. cajas.Value ?? []] : [];
        }
        _vista = _vistas.FirstOrDefault(v => v.Key == Vista) ?? _vistas.FirstOrDefault();
        if (_vista is not null && !string.IsNullOrWhiteSpace(Vista) && _vista.Key == Vista) await AplicarAsync();
    }

    private void CambiarVista(string? clave)
    {
        if (string.IsNullOrWhiteSpace(clave) || clave == _vista?.Key) return;
        _vista = _vistas.FirstOrDefault(v => v.Key == clave);
        _tabla = null;
    }

    private bool Usa(string filtro) => _vista is not null && _vista.Filters.Contains(filtro, StringComparer.OrdinalIgnoreCase);

    /// <summary>Sólo viajan los filtros que la vista usa.</summary>
    private string Query()
    {
        var partes = new List<string>();
        void Poner(string clave, string? valor) { if (!string.IsNullOrWhiteSpace(valor)) partes.Add($"{clave}={Uri.EscapeDataString(valor)}"); }
        if (Usa("from")) Poner("from", Fecha(_desde));
        if (Usa("to")) Poner("to", Fecha(_hasta));
        if (Usa("asOf")) Poner("asOf", Fecha(_corte));
        if (Usa("point")) Poner("point", _punto?.ToString());
        if (Usa("cashBox")) Poner("cashBox", _caja?.ToString());
        if (_vista?.OwnFilters?.Contains("groupBy") == true) Poner("groupBy", _agrupar);
        return string.Join('&', partes);
    }

    private async Task AplicarAsync()
    {
        if (_vista is null) return;
        _aplicado = Query();
        using var carga = _carga.Iniciar();
        var r = await InformesApi.InformeAsync(InformesDeRecaudoYTesoreriaClient.Recaudo, _vista.Key, _aplicado);
        if (!r.IsSuccess) { _tabla = null; await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo generar el informe."); return; }
        _tabla = r.Value;
    }

    private async Task DescargarAsync(string formato)
    {
        if (_vista is null) return;
        using var carga = _carga.Iniciar();
        var r = await InformesApi.DescargarAsync(InformesDeRecaudoYTesoreriaClient.Recaudo, _vista.Key, _aplicado, formato);
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo exportar."); return; }
        await Descargas.GuardarAsync(r.Value!.Nombre, r.Value.TipoContenido, r.Value.Contenido);
    }

    private static string Fecha(DateOnly? f) => f?.ToString("yyyy-MM-dd") ?? string.Empty;

    private static DateOnly? LeerFecha(object? valor) =>
        DateOnly.TryParse(valor?.ToString(), System.Globalization.CultureInfo.InvariantCulture, out var f) ? f : null;
}
