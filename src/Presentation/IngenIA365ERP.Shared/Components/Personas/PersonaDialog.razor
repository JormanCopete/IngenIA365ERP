@using IngenIA365ERP.Shared.Models.Personas
@inject PersonasClient Personas
@inject INotificationService Notification

@*
    El diálogo de persona: crear una o editar una existente (feature 008, FR-006). Es el ÚNICO
    sitio que escribe la persona desde la interfaz: Personas lo abre desde «Nueva» y «Editar»;
    Empleados y Asociados lo abren desde «Editar datos de la persona» (FR-005).
    Con documento duplicado ofrece abrir esa persona; con documento de una eliminada ofrece
    restaurarla a quien tenga el permiso de eliminar (FR-007, FR-016).
    Feature 012 (T175): con CapturarAutorizacion, al crear muestra la política de tratamiento de datos
    vigente y registra la decisión del titular junto con la persona (o el aviso «sin política vigente»).
*@

<SfDialog @bind-Visible="Visible" Header="@Titulo" Width="@(Compacto ? "640px" : "900px")" IsModal="true" ShowCloseIcon="true">
    <DialogEvents Opened="@OnAbiertoAsync" Closed="@OnCerrado" />
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@(_carga.Activa || _guardado.Activa)" Texto="@(_guardado.Activa ? "Guardando…" : "Cargando…")">
                <EditForm Model="_modelo" OnValidSubmit="GuardarAsync">
                    <DataAnnotationsValidator />
                    @* «Registrar como…» sólo tiene sentido con una persona ya guardada. *@
                    <PersonaFormulario Modelo="@_modelo" Ciudades="@_ciudades" Compacto="@Compacto"
                                       RolesRegistrables="@(_modelo.PublicId is null ? [] : RolesRegistrables)"
                                       OnRegistrarRol="@RegistrarRolAsync" />
                    <button type="submit" class="oculto"></button>
                </EditForm>

                @if (MostrarAutorizacion)
                {
                    <div class="panel-pestana">
                        <h4>Autorización de tratamiento de datos</h4>
                        @if (_politica is { } politica)
                        {
                            <p class="hint">Léale o muéstrele al titular el aviso de privacidad vigente (versión @politica.Version) y registre su decisión.</p>
                            <div class="texto-politica">@politica.Text</div>
                            @* 2026-11-24 (pedido del dueño): la autorización general registra también las demás finalidades que no exigen soporte. *@
                            <div class="rejilla-campos">
                                <div>
                                    <SfRadioButton TChecked="string" Label="El titular autoriza todas las finalidades (autorización general)" Name="autorizacion-datos" Value="@AceptaTodas" @bind-Checked="_decision" />
                                </div>
                                <div>
                                    <SfRadioButton TChecked="string" Label="El titular autoriza sólo el tratamiento de datos" Name="autorizacion-datos" Value="Accepted" @bind-Checked="_decision" />
                                </div>
                                <div>
                                    <SfRadioButton TChecked="string" Label="El titular no autoriza" Name="autorizacion-datos" Value="Declined" @bind-Checked="_decision" />
                                </div>
                            </div>
                            @if (_decision == AceptaTodas)
                            {
                                <p class="hint">Con la autorización general quedan registrados el tratamiento de datos y el trámite de crédito (salvo que la cooperativa
                                    exija el soporte firmado). La consulta y el reporte a centrales y los canales de contacto exigen el soporte: regístrelos después en
                                    Cartera › Autorizaciones del titular.</p>
                            }
                        }
                        else if (_politicaFallo)
                        {
                            @* 2026-11-16: si la política no se pudo leer (error, no «sin política»), no se guarda: la persona quedaría sin
                               autorización ni constancia. *@
                            <div class="aviso aviso-error">
                                <span>No se pudo leer la política de tratamiento de datos. Reintente antes de guardar.</span>
                                <SfButton CssClass="e-small" OnClick="@CargarPoliticaAsync" Disabled="@_carga.Activa">Reintentar</SfButton>
                            </div>
                        }
                        else if (_politicaCargada)
                        {
                            <div class="aviso aviso-alerta">
                                La cooperativa no tiene publicada una política de tratamiento de datos: la persona se crea
                                sin autorización y queda la constancia «sin política vigente».
                            </div>
                        }
                    </div>
                }

                @* Feature 015 (T0032; FR-210): las cuentas bancarias para giros se registran y aprueban aparte, con doble control; este diálogo no las escribe. *@
                @if (_modelo.PublicId is { } existente)
                {
                    <PermissionGate Required="Core.PersonBankAccounts.View">
                        <p class="hint"><a href="@($"/maestros/personas/{existente}/cuentas-bancarias")">Cuentas bancarias para giros</a>: se piden y se aprueban aparte, con su certificación.</p>
                    </PermissionGate>
                }

                @if (_colision is not null)
                {
                    <div class="aviso aviso-error aviso-documento">
                        <span>@_colision.Mensaje</span>
                        @if (_colision.Eliminada)
                        {
                            <PermissionGate Required="Core.People.Delete">
                                <SfButton CssClass="e-small" OnClick="@RestaurarAsync" Disabled="@_saving">Restaurar persona</SfButton>
                            </PermissionGate>
                            <PermissionGate Required="Core.People.Delete" Fallback="@FallbackRestaurar" />
                        }
                        else
                        {
                            @if (PuedeUsarExistente)
                            {
                                @* 2026-11-16: desde otro módulo (POS, Compras, Caja…) se puede seguir con la persona existente sin editarla:
                                   quien no tiene permiso de editar personas no queda atascado. *@
                                <SfButton CssClass="e-small" IsPrimary="true" OnClick="@UsarExistenteAsync" Disabled="@_saving">Usar esa persona</SfButton>
                            }
                            <SfButton CssClass="e-small" OnClick="@AbrirExistenteAsync" Disabled="@_saving">Abrir esa persona</SfButton>
                        }
                    </div>
                }
            </IndicadorDeCarga>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@CancelarAsync" />
        <DialogButton Content="Guardar" IsPrimary="true" OnClick="@GuardarAsync" Disabled="@(_saving || _carga.Activa || _guardado.Activa || (MostrarAutorizacion && _politicaFallo))" />
    </DialogButtons>
</SfDialog>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    /// <summary>Persona a editar; nulo = crear una nueva.</summary>
    [Parameter] public Guid? PersonaPublicId { get; set; }

    /// <summary>Al crear: documento ya escrito (lo que se buscó y no existía).</summary>
    [Parameter] public string? DocumentoInicial { get; set; }

    /// <summary>
    /// Fase 2: rol simple que viene premarcado al crear desde otro módulo
    /// (<c>customer</c>, <c>supplier</c>, <c>advisor</c>, <c>thirdparty</c>, <c>invoice</c>).
    /// </summary>
    [Parameter] public string? RolSimpleInicial { get; set; }

    /// <summary>Roles derivados que Personas puede ofrecer registrar según los permisos del usuario.</summary>
    [Parameter] public IReadOnlyCollection<string> RolesRegistrables { get; set; } = [];

    /// <summary>
    /// Feature 012 (T175): al crear, muestra el aviso de privacidad vigente y registra la decisión del titular
    /// (POS, Compras). Al editar no aplica: la autorización de una persona existente se registra en Habeas Data.
    /// </summary>
    [Parameter] public bool CapturarAutorizacion { get; set; }

    /// <summary>Canal que queda en el consentimiento (<c>Pos</c>, <c>Compras</c>…); sin él, «InPerson».</summary>
    [Parameter] public string? CanalDeAutorizacion { get; set; }

    /// <summary>
    /// Feature 012 (T616): el modo compacto para el alta de cliente desde el POS (<c>ClienteDelPos</c>): sin pestañas, sólo
    /// identificación, contacto y datos tributarios, y con la autorización de datos si <see cref="CapturarAutorizacion"/>.
    /// </summary>
    [Parameter] public bool Compacto { get; set; }

    /// <summary>Se guardó (creación o edición); el argumento es el PublicId de la persona.</summary>
    [Parameter] public EventCallback<Guid> OnGuardado { get; set; }

    /// <summary>
    /// Se pulsó «Registrar como…» en Roles; el argumento lleva el rol y la persona <b>cargada en el diálogo</b> (2026-11-16: antes quien
    /// lo contenía navegaba con la persona que había pedido abrir, y tras «Abrir esa persona» no hacía nada o usaba otra). Quien contiene
    /// el diálogo navega.
    /// </summary>
    [Parameter] public EventCallback<RolARegistrar> OnRegistrarRol { get; set; }

    private readonly EstadoDeCarga _carga = new(), _guardado = new();
    private PersonaFormularioModelo _modelo = PersonaFormularioModelo.Nuevo();
    private IReadOnlyList<OpcionDeCiudad> _ciudades = [];
    private bool _saving, _ciudadesCargadas;
    private Colision? _colision;
    private PoliticaDeDatosVigenteDto? _politica;
    private bool _politicaCargada, _politicaFallo;
    private string? _decision;

    /// <summary>2026-11-24: la opción de la autorización general (viaja como <c>Accepted</c> con <c>allPurposes</c>).</summary>
    private const string AceptaTodas = "AcceptedAll";

    private bool MostrarAutorizacion => CapturarAutorizacion && _modelo.PublicId is null;

    /// <summary>
    /// «Usar esa persona»: el alta se abrió desde otro módulo (rol simple premarcado o captura de la autorización) y alguien espera la
    /// persona por <see cref="OnGuardado"/>.
    /// </summary>
    private bool PuedeUsarExistente => _modelo.PublicId is null && OnGuardado.HasDelegate
                                       && (!string.IsNullOrEmpty(RolSimpleInicial) || CapturarAutorizacion);

    private string Titulo => _modelo.PublicId is null
        ? "Nueva persona"
        : $"Editar persona: {_modelo.NombreVisible}";

    private RenderFragment FallbackRestaurar => @<span class="hint">Pedile la restauración a quien administra Maestros › Personas.</span>;

    private async Task OnAbiertoAsync(Syncfusion.Blazor.Popups.OpenEventArgs _)
    {
        _colision = null;
        _politicaFallo = false;
        await CargarCiudadesAsync();
        if (PersonaPublicId is { } id) await CargarPersonaAsync(id);
        else
        {
            _modelo = PersonaFormularioModelo.Nuevo(DocumentoInicial);
            AplicarRolSimpleInicial();
            if (CapturarAutorizacion) await CargarPoliticaAsync();
        }
        StateHasChanged();
    }

    private void OnCerrado(Syncfusion.Blazor.Popups.CloseEventArgs _) => _colision = null;

    private void AplicarRolSimpleInicial()
    {
        switch (RolSimpleInicial)
        {
            case "customer": _modelo.IsCustomer = true; break;
            case "supplier": _modelo.IsSupplier = true; break;
            case "advisor": _modelo.IsAdvisor = true; break;
            case "thirdparty": _modelo.IsThirdParty = true; break;
            case "invoice": _modelo.ReceivesInvoice = true; break;
        }
    }

    private async Task CargarCiudadesAsync()
    {
        if (_ciudadesCargadas) return;
        using var carga = _carga.Iniciar();
        try
        {
            _ciudades = await Personas.ListarCiudadesAsync();
            _ciudadesCargadas = true;
        }
        catch (Exception ex)
        {
            await Notification.ErrorAsync($"No se pudieron cargar las ciudades: {ex.Message}");
        }
    }

    private async Task CargarPoliticaAsync()
    {
        using var carga = _carga.Iniciar();
        _politica = null;
        _politicaCargada = false;
        _politicaFallo = false;
        _decision = null;
        var r = await Personas.PoliticaDeDatosVigenteAsync();
        if (!r.IsSuccess)
        {
            _politicaFallo = true;
            await Notification.ErrorAsync($"No se pudo leer la política de tratamiento de datos: {r.ErrorMessage}");
            return;
        }
        _politica = r.Value;
        _politicaCargada = true;
    }

    /// <summary>Lo que viaja como <c>authorization</c> en el alta; nulo si no se captura.</summary>
    private AutorizacionAlCrearDto? Autorizacion() => !MostrarAutorizacion || !_politicaCargada
        ? null
        : _politica is { } p
            ? new AutorizacionAlCrearDto(_decision == AceptaTodas ? "Accepted" : _decision!, p.PolicyVersionPublicId, CanalDeAutorizacion, _decision == AceptaTodas)
            : new AutorizacionAlCrearDto("Accepted", null, CanalDeAutorizacion);

    private async Task CargarPersonaAsync(Guid id)
    {
        using var carga = _carga.Iniciar();
        var r = await Personas.ObtenerAsync(id);
        if (!r.IsSuccess || r.Value is null)
        {
            await Notification.ErrorAsync($"No se pudieron cargar los datos de la persona: {r.ErrorMessage}");
            await CerrarAsync();
            return;
        }
        _modelo = PersonaFormularioModelo.DesdeDto(r.Value);
    }

    private async Task GuardarAsync()
    {
        if (_saving) return;
        var avisos = _modelo.Validar();
        if (avisos.Count > 0)
        {
            await Notification.WarningAsync(avisos[0]);
            return;
        }
        if (MostrarAutorizacion && _politicaFallo)
        {
            await Notification.WarningAsync("No se pudo leer la política de tratamiento de datos. Pulse «Reintentar» antes de guardar.");
            return;
        }
        if (MostrarAutorizacion && _politica is not null && _decision is null)
        {
            await Notification.WarningAsync("Registre si el titular autoriza o no el tratamiento de sus datos.");
            return;
        }

        _saving = true;
        _colision = null;
        using var guardado = _guardado.Iniciar();
        try
        {
            var entrada = _modelo.AInput();
            Guid publicId;
            if (_modelo.PublicId is { } existente)
            {
                var r = await Personas.ActualizarAsync(existente, entrada);
                if (!r.IsSuccess) { await FalloAsync(r.ErrorCode, r.ErrorMessage); return; }
                publicId = existente;
                await Notification.SuccessAsync("Persona actualizada correctamente.");
            }
            else
            {
                var r = await Personas.CrearAsync(entrada with { Authorization = Autorizacion() });
                if (!r.IsSuccess) { await FalloAsync(r.ErrorCode, r.ErrorMessage); return; }
                publicId = r.Value;
                await Notification.SuccessAsync("Persona creada correctamente.");
            }

            await CerrarAsync();
            await OnGuardado.InvokeAsync(publicId);
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>Un duplicado o una eliminada se muestran junto al formulario con su acción; lo demás, como aviso.</summary>
    private async Task FalloAsync(string? codigo, string? mensaje)
    {
        switch (codigo)
        {
            case ErroresDePersona.DocumentoDuplicado:
                _colision = new Colision(mensaje ?? "Ya existe una persona con ese documento.", Eliminada: false);
                break;
            case ErroresDePersona.DocumentoEliminado:
                _colision = new Colision(mensaje ?? "Ese documento pertenece a una persona eliminada.", Eliminada: true);
                break;
            default:
                await Notification.ErrorAsync(codigo == "Generic.NotFound"
                    ? $"Error al guardar persona: {NotificationServiceExtensions.SinPermiso}"
                    : $"Error al guardar persona: {mensaje}");
                break;
        }
    }

    /// <summary>«Abrir esa persona»: el documento ya es de alguien; se pasa a editarla.</summary>
    private async Task AbrirExistenteAsync()
    {
        var r = await Personas.PorDocumentoAsync(_modelo.TaxId.Trim(), _modelo.IdType);
        if (!r.IsSuccess || r.Value is null)
        {
            await Notification.ErrorAsync($"No se pudo abrir la persona existente: {r.ErrorMessage}");
            return;
        }
        _colision = null;
        await CargarPersonaAsync(r.Value.PublicId);
    }

    /// <summary>«Usar esa persona»: devuelve la existente por <see cref="OnGuardado"/> sin escribir nada (no hace PUT).</summary>
    private async Task UsarExistenteAsync()
    {
        if (_saving) return;
        _saving = true;
        using var guardado = _guardado.Iniciar();
        try
        {
            var r = await Personas.PorDocumentoAsync(_modelo.TaxId.Trim(), _modelo.IdType);
            if (!r.IsSuccess || r.Value is null || r.Value.IsDeleted)
            {
                await Notification.ErrorAsync($"No se pudo usar la persona existente: {r.ErrorMessage}");
                return;
            }
            await CerrarAsync();
            await OnGuardado.InvokeAsync(r.Value.PublicId);
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>«Restaurar persona»: misma fila, y se sigue editándola.</summary>
    private async Task RestaurarAsync()
    {
        if (_saving) return;
        _saving = true;
        using var guardado = _guardado.Iniciar();
        try
        {
            var quien = await Personas.PorDocumentoAsync(_modelo.TaxId.Trim(), _modelo.IdType);
            if (!quien.IsSuccess || quien.Value is null)
            {
                await Notification.ErrorAsync($"No se encontró la persona eliminada: {quien.ErrorMessage}");
                return;
            }
            var r = await Personas.RestaurarAsync(quien.Value.PublicId);
            if (!r.IsSuccess)
            {
                await Notification.ErrorAsync(r.ErrorCode == "Generic.NotFound"
                    ? NotificationServiceExtensions.SinPermiso
                    : $"No se pudo restaurar: {r.ErrorMessage}");
                return;
            }
            await Notification.SuccessAsync($"Persona restaurada: {quien.Value.FullName}.");
            _colision = null;
            await CargarPersonaAsync(quien.Value.PublicId);
            await OnGuardado.InvokeAsync(quien.Value.PublicId);
        }
        finally
        {
            _saving = false;
        }
    }

    private Task RegistrarRolAsync(string rol) =>
        _modelo.PublicId is { } persona ? OnRegistrarRol.InvokeAsync(new RolARegistrar(rol, persona)) : Task.CompletedTask;

    private Task CancelarAsync() => CerrarAsync();

    private async Task CerrarAsync()
    {
        Visible = false;
        _colision = null;
        await VisibleChanged.InvokeAsync(false);
    }

    private sealed record Colision(string Mensaje, bool Eliminada);
}
