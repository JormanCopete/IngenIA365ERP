@* Feature 013, K4 (T0958): los botones «Anterior» y «Siguiente» de una lista paginada del servidor; no se muestra si todo cabe en una página. *@
@if (Total > Tamano)
{
    <div class="toolbar">
        <SfButton CssClass="e-flat e-small" Disabled="@(Pagina <= 1)" OnClick="@(() => Cambia.InvokeAsync(Pagina - 1))">Anterior</SfButton>
        <span>Página @Pagina de @((Total + Tamano - 1) / Tamano)</span>
        <SfButton CssClass="e-flat e-small" Disabled="@(Pagina * Tamano >= Total)" OnClick="@(() => Cambia.InvokeAsync(Pagina + 1))">Siguiente</SfButton>
    </div>
}

@code {
    [Parameter] public int Pagina { get; set; } = 1;
    [Parameter] public long Total { get; set; }
    [Parameter] public int Tamano { get; set; } = 20;
    [Parameter] public EventCallback<int> Cambia { get; set; }
}
