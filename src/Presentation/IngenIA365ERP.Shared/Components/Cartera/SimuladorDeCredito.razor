@using System.Globalization
@using IngenIA365ERP.Shared.Services.Cartera
@using IngenIA365ERP.Shared.Services.Http
@using Microsoft.JSInterop
@inject OriginacionClient Originacion
@inject LineasDeCreditoClient Lineas
@inject INotificationService Notification
@inject IJSRuntime JS

@* Feature 013, US2 (T0410; FR-034, FR-013; contracts/api.md §4.1): el simulador de crédito. Muestra el plan cuota a cuota, la tasa efectiva y
   la nominal, el costo total y la validación de usura —una simulación sobre la usura no es error: se muestra el aviso—, sin registrar nada.
   Imprimir baja el PDF (sin número ni código, con la leyenda de que no es una aprobación); enviar lo manda por correo a la persona simulada si
   ella autorizó el tratamiento de sus datos. Lo usan /cartera/simulador y la solicitud nueva (FR-013: visible en toda pantalla de
   originación); con SimulacionHecha la solicitud toma lo simulado.
   2026-11-17 (pedido del dueño): al elegir la línea se leen sus condiciones vigentes y sólo se ofrecen sus periodicidades y sistemas (con los
   de defecto elegidos), se muestran sus rangos de monto y plazo, el desembolso arranca en hoy y, si la línea lo pide, la fecha del primer pago
   (las demás cuotas salen de ella con la periodicidad). Cambiar un dato deja la simulación anterior como vieja: hay que volver a simular. *@
<div class="info-card simulador-credito">
    <h4>Simulador</h4>
    <div class="form-grid">
        <div class="campo campo-ancho">
            <span class="etiqueta-campo">Línea de crédito *</span>
            <SelectorDeLineaDeCredito Value="@_linea" ValueChanged="@ElegirLineaAsync" Deshabilitado="@LineaFija" />
            @if (_condiciones is { } c)
            {
                <span class="texto-tenue">
                    Monto de @TextosDeOriginacion.Pesos(c.MinAmount) a @TextosDeOriginacion.Pesos(c.MaxAmount) · plazo de @c.MinTermMonths a @c.MaxTermMonths meses@(c.MaxInstallments is { } mc ? $" (hasta {mc} cuotas)" : "")@(c.PaymentDay is { } dp ? $" · día de pago {dp}" : "")
                </span>
            }
        </div>
        @if (Opciones.Count > 0)
        {
            @* 2026-11-23 (descuento condicionado, el caso del SOAT): el monto es el valor del bien menos lo que paga el fondo según la opción. *@
            <label class="campo">Valor del bien *
                <input class="e-input" type="number" min="0" step="1000" value="@_valorDelBien" @onchange="@(e => { _valorDelBien = LeerDecimal(e.Value); Recalcular(); })" />
            </label>
            <label class="campo">Opción de descuento *
                <select class="e-input" value="@_opcion" @onchange="@(e => { _opcion = e.Value?.ToString(); Recalcular(); })">
                    <option value="">Elija…</option>
                    @foreach (var o in Opciones) { <option value="@o.Code">@o.Name (@((o.Fraction * 100m).ToString("0.##", Colombia)) %)</option> }
                </select>
            </label>
        }
        <label class="campo">@(Opciones.Count > 0 ? "Monto del crédito" : "Monto *")
            <input class="e-input" type="number" min="0" step="1000" value="@_monto" disabled="@(Opciones.Count > 0)"
                   @onchange="@(e => { _monto = LeerDecimal(e.Value) ?? 0m; Cambio(); })" />
            @if (Opciones.Count > 0 && Subsidio is { } fondo)
            {
                <span class="texto-tenue">El fondo pone @TextosDeOriginacion.Pesos(fondo); al proveedor se giran @TextosDeOriginacion.Pesos(_valorDelBien ?? 0m).</span>
            }
        </label>
        <label class="campo">@(EsPagoUnico ? "Cuotas (pago único: 1)" : "Cuotas *")
            <input class="e-input" type="number" min="1" max="600" value="@_cuotas" disabled="@EsPagoUnico" @onchange="@(e => { _cuotas = LeerEntero(e.Value) ?? 0; Cambio(); })" />
        </label>
        <label class="campo">Periodicidad
            <select class="e-input" value="@_periodicidad" @onchange="@(e => { _periodicidad = LeerEntero(e.Value) ?? 0; Cambio(); })">
                @if (_condiciones is null) { <option value="@DeLaLinea">La de la línea</option> }
                @foreach (var p in PeriodicidadesOfrecidas) { <option value="@p.Valor">@p.Texto</option> }
            </select>
        </label>
        <label class="campo">Sistema
            <select class="e-input" value="@_sistema" disabled="@EsPagoUnico" @onchange="@(e => { _sistema = LeerEntero(e.Value) ?? 0; Cambio(); })">
                @if (_condiciones is null) { <option value="@DeLaLinea">El de la línea</option> }
                @foreach (var s in SistemasOfrecidos) { <option value="@s.Valor">@s.Texto</option> }
            </select>
        </label>
        <label class="campo">Fecha de desembolso
            <input type="date" class="e-input" value="@_desembolso.ToString("yyyy-MM-dd")" @onchange="@(e => { _desembolso = LeerFecha(e.Value) ?? Hoy; Cambio(); })" />
        </label>
        @if (PideFechaDePrimerPago)
        {
            <label class="campo">@(EsPagoUnico ? "Fecha de vencimiento *" : "Fecha del primer pago *")
                <input type="date" class="e-input" value="@(_primerPago?.ToString("yyyy-MM-dd"))" min="@_desembolso.AddDays(1).ToString("yyyy-MM-dd")"
                       @onchange="@(e => { _primerPago = LeerFecha(e.Value); Cambio(); })" />
                @if (!EsPagoUnico) { <span class="texto-tenue">Las demás cuotas se calculan desde esta fecha, @TextosDeOriginacion.Periodicidad(PeriodicidadElegida).ToLowerInvariant().</span> }
            </label>
        }
        <div class="campo campo-ancho">
            <span class="etiqueta-campo">Persona (opcional: aplica su banda de tasa y permite enviarle la simulación)</span>
            <PersonSearchPicker Selected="@_persona" SelectedChanged="@(p => { _persona = p; Cambio(); })" ShowHelpText="false" Compacto="true" />
        </div>
    </div>
    @if (_avisoDeDatos is { } aviso) { <p class="aviso aviso-info">@aviso</p> }
    <div class="toolbar">
        <SfButton CssClass="e-primary" IconCss="e-icons e-play" Disabled="@(_carga.Activa || !PuedeSimular)" OnClick="@SimularAsync">Simular</SfButton>
        <SfButton CssClass="e-outline" IconCss="e-icons e-print" Disabled="@(_simulacion is null || _vieja || _carga.Activa)" OnClick="@ImprimirAsync">Imprimir</SfButton>
        <SfButton CssClass="e-outline" IconCss="e-icons e-send" Disabled="@(_simulacion is null || _vieja || _persona is null || _carga.Activa)" OnClick="@EnviarAsync">Enviar por correo</SfButton>
        @if (SimulacionHecha.HasDelegate && _simulacion is not null && !_vieja)
        {
            <SfButton CssClass="e-success" IconCss="e-icons e-check" OnClick="@UsarAsync">Usar en la solicitud</SfButton>
        }
    </div>

    <IndicadorDeCarga Cargando="@_carga.Activa" Texto="Simulando…">
        @if (_error is not null) { <p class="aviso aviso-error" role="alert">@_error</p> }
        @if (_simulacion is { } s)
        {
            @if (_vieja) { <p class="aviso aviso-alerta">Este plan es de los datos anteriores: vuelva a simular.</p> }
            @if (!s.Usury.Passes)
            {
                <p class="aviso aviso-alerta" role="alert">
                    La tasa efectiva con cargos (@TextosDeOriginacion.Porcentaje(s.EffectiveRateWithCharges) EA) supera la usura
                    @(s.Usury.Rate is { } u ? $"de {TextosDeOriginacion.Porcentaje(u)} EA" : "") vigente el @s.Usury.Date.ToString("dd/MM/yyyy").
                    Con estas condiciones la solicitud no se puede radicar.
                </p>
            }
            <div class="kpi-grid">
                <div class="kpi-card"><span class="kpi-label">Tasa efectiva anual</span><span class="kpi-value">@TextosDeOriginacion.Porcentaje(s.EffectiveAnnualRate)</span></div>
                @if (s.MonthlyRate is { } mv)
                {
                    @* 2026-11-24 (feature 025, HU2; FR-012): la pactada en MV al lado de su E.A. *@
                    <div class="kpi-card"><span class="kpi-label">Tasa pactada</span><span class="kpi-value">@TasaMensualVencida.Texto(s.EffectiveAnnualRate, mv)</span></div>
                }
                <div class="kpi-card"><span class="kpi-label">Tasa nominal del período</span><span class="kpi-value">@TextosDeOriginacion.Porcentaje(s.NominalPeriodRate)</span></div>
                <div class="kpi-card"><span class="kpi-label">Efectiva con cargos</span><span class="kpi-value">@TextosDeOriginacion.Porcentaje(s.EffectiveRateWithCharges)</span></div>
                <div class="kpi-card"><span class="kpi-label">Costo total</span><span class="kpi-value">@TextosDeOriginacion.Pesos(s.Totals.ToPay)</span></div>
                <div class="kpi-card"><span class="kpi-label">Usura</span><span class="kpi-value">@(s.Usury.Rate is { } r ? TextosDeOriginacion.Porcentaje(r) : "—")</span></div>
            </div>
            <p class="texto-apoyo">
                @s.CreditLineCode · @s.CreditLineName — @TextosDeOriginacion.Pesos(s.Amount) en @s.InstallmentCount cuotas
                (@TextosDeOriginacion.Periodicidad(s.Periodicity)), intereses @TextosDeOriginacion.Pesos(s.Totals.Interest), seguros
                @TextosDeOriginacion.Pesos(s.Totals.Insurance).
            </p>
            @foreach (var a in s.Warnings) { <p class="aviso aviso-info">@a.Message</p> }
            <div class="tabla-desplazable">
                <table class="data-grid">
                    <thead><tr><th class="numero">Cuota</th><th>Vence</th><th class="numero">Capital</th><th class="numero">Interés</th><th class="numero">Seguros</th><th class="numero">Otros</th><th class="numero">Total</th><th class="numero">Saldo</th></tr></thead>
                    <tbody>
                        @foreach (var c in s.Installments)
                        {
                            <tr>
                                <td class="numero">@c.Number</td>
                                <td>@c.DueDate.ToString("dd/MM/yyyy")</td>
                                <td class="numero">@c.Principal.ToString("N2", Colombia)</td>
                                <td class="numero">@c.Interest.ToString("N2", Colombia)</td>
                                <td class="numero">@c.Insurance.ToString("N2", Colombia)</td>
                                <td class="numero">@c.Other.ToString("N2", Colombia)</td>
                                <td class="numero">@c.Total.ToString("N2", Colombia)</td>
                                <td class="numero">@c.BalanceAfter.ToString("N2", Colombia)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (s.Uvr is { } uvr)
            {
                @* K6b (T1060; FR-024): en una línea en UVR la cuota se pacta en UVR. Las cuotas en pesos de arriba son su equivalencia a la UVR
                   publicada del desembolso; la de cada pago será la UVR de ese día. *@
                <div class="info-card">
                    <h4>Plan en UVR</h4>
                    <p class="aviso aviso-info">@uvr.Legend</p>
                    <div class="kpi-grid">
                        <div class="kpi-card"><span class="kpi-label">UVR del @uvr.UvrDate.ToString("dd/MM/yyyy")</span><span class="kpi-value">@TextosDeCreditos.ValorDeUvr(uvr.UvrValue)</span></div>
                        <div class="kpi-card"><span class="kpi-label">Monto en UVR</span><span class="kpi-value">@TextosDeCreditos.Uvr(uvr.AmountUvr)</span></div>
                        <div class="kpi-card"><span class="kpi-label">Total a pagar en UVR</span><span class="kpi-value">@TextosDeCreditos.Uvr(uvr.ToPayUvr)</span></div>
                    </div>
                    <div class="tabla-desplazable">
                        <table class="data-grid">
                            <thead><tr><th class="numero">Cuota</th><th>Vence</th><th class="numero">Capital (UVR)</th><th class="numero">Interés (UVR)</th><th class="numero">Seguros (UVR)</th><th class="numero">Cuota (UVR)</th><th class="numero">Equivalencia en pesos</th><th class="numero">Saldo (UVR)</th></tr></thead>
                            <tbody>
                                @foreach (var c in uvr.Installments)
                                {
                                    <tr>
                                        <td class="numero">@c.Number</td>
                                        <td>@c.DueDate.ToString("dd/MM/yyyy")</td>
                                        <td class="numero">@c.Principal.ToString("N4", Colombia)</td>
                                        <td class="numero">@c.Interest.ToString("N4", Colombia)</td>
                                        <td class="numero">@c.Insurance.ToString("N4", Colombia)</td>
                                        <td class="numero">@c.Total.ToString("N4", Colombia)</td>
                                        <td class="numero">@((c.Total * uvr.UvrValue).ToString("N2", Colombia))</td>
                                        <td class="numero">@c.BalanceAfter.ToString("N4", Colombia)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <p class="texto-tenue">La equivalencia en pesos usa la UVR del @uvr.UvrDate.ToString("dd/MM/yyyy") para todas las cuotas: es una proyección, no el valor a pagar de cada fecha.</p>
                </div>
            }
            @if (s.ExplanationLines.Count > 0)
            {
                <details>
                    <summary>Cómo se calculó</summary>
                    <ul>@foreach (var l in s.ExplanationLines) { <li>@l</li> }</ul>
                </details>
            }
        }
    </IndicadorDeCarga>
</div>

@code {
    private static readonly CultureInfo Colombia = CultureInfo.GetCultureInfo("es-CO");
    private const int DeLaLinea = -1;

    /// <summary>Lo que la solicitud nueva toma del simulador: la entrada, el resultado y la persona simulada (si se eligió).</summary>
    [Parameter] public EventCallback<(SimulacionRequest Entrada, SimulacionDto Resultado)> SimulacionHecha { get; set; }

    /// <summary>La persona elegida en el simulador, para que la solicitud la proponga como solicitante.</summary>
    [Parameter] public EventCallback<PersonSearchPicker.PersonSearchItem?> PersonaElegida { get; set; }

    /// <summary>La línea con que abre (desde la solicitud).</summary>
    [Parameter] public Guid? LineaInicial { get; set; }

    /// <summary>2026-11-23: los datos con que abre al corregir una solicitud devuelta (monto, cuotas, fechas…).</summary>
    [Parameter] public SimulacionRequest? Inicial { get; set; }

    /// <summary>2026-11-23: la línea no se puede cambiar (corrección de una solicitud devuelta con la línea fija).</summary>
    [Parameter] public bool LineaFija { get; set; }

    /// <summary>2026-11-23 (descuento condicionado): el valor del bien y la opción con que abre (al corregir).</summary>
    [Parameter] public (decimal Valor, string Opcion)? CompraInicial { get; set; }

    /// <summary>2026-11-23: lo que la solicitud toma de una línea con descuento condicionado: el valor del bien y la opción; nulo sin descuento.</summary>
    [Parameter] public EventCallback<(decimal Valor, string Opcion)?> CompraElegida { get; set; }

    private decimal? _valorDelBien;
    private string? _opcion;

    private IReadOnlyList<OpcionDeDescuentoDto> Opciones => _condiciones?.DiscountOptions ?? [];

    /// <summary>Lo que paga el fondo con el valor y la opción elegidos (al peso, como el servidor).</summary>
    private decimal? Subsidio => _valorDelBien is { } v && Opciones.FirstOrDefault(o => o.Code == _opcion) is { } o
        ? Math.Round(v * o.Fraction, 0, MidpointRounding.AwayFromZero)
        : null;

    private void Recalcular()
    {
        if (_valorDelBien is { } v && Subsidio is { } fondo) _monto = v - fondo;
        Cambio();
    }

    private readonly EstadoDeCarga _carga = new();
    private Guid? _linea;
    private VersionDeLineaDto? _condiciones;
    private decimal _monto = 1_000_000m;
    private int _cuotas = 12, _periodicidad = DeLaLinea, _sistema = DeLaLinea;
    private DateOnly _desembolso = Hoy;
    private DateOnly? _primerPago;
    private PersonSearchPicker.PersonSearchItem? _persona;
    private SimulacionDto? _simulacion;
    private SimulacionRequest? _entrada;
    private bool _vieja;
    private string? _error, _avisoDeDatos;
    private ClaveDeOperacion _claveDeEnvio = new();

    private static DateOnly Hoy => DateOnly.FromDateTime(DateTime.Now);

    private int PeriodicidadElegida => _periodicidad != DeLaLinea ? _periodicidad : _condiciones?.DefaultPeriodicity ?? 30;
    private bool EsPagoUnico => PeriodicidadElegida == 0;
    private bool PideFechaDePrimerPago => (_condiciones?.AsksFirstDueDate ?? false) || EsPagoUnico;

    private IEnumerable<(int Valor, string Texto)> PeriodicidadesOfrecidas => _condiciones is { } c
        ? TextosDeOriginacion.Periodicidades.Where(p => c.Periodicities.Contains(p.Valor))
        : TextosDeOriginacion.Periodicidades;

    private IEnumerable<(int Valor, string Texto)> SistemasOfrecidos => _condiciones is { } c
        ? TextosDeOriginacion.SistemasDeAmortizacion.Where(s => c.AmortizationSystems.Contains(s.Valor))
        : TextosDeOriginacion.SistemasDeAmortizacion;

    private bool PuedeSimular => _linea is not null && _monto > 0 && (EsPagoUnico || _cuotas > 0) && (Opciones.Count == 0 || Subsidio is not null)
        && (!PideFechaDePrimerPago || _primerPago is { } p && p > _desembolso);

    protected override async Task OnInitializedAsync()
    {
        if (Inicial is { } i)
        {
            _desembolso = i.DisbursementDate ?? Hoy;
            await ElegirLineaAsync(i.CreditLinePublicId);
            _monto = i.Amount;
            _cuotas = i.Installments;
            if (i.Periodicity is { } p) _periodicidad = p;
            if (i.AmortizationSystem is { } sis) _sistema = sis;
            if (i.FirstDueDate is { } f) _primerPago = f;
            if (CompraInicial is { } c) { _valorDelBien = c.Valor; _opcion = c.Opcion; }
            Cambio();
        }
        else if (LineaInicial is { } l) await ElegirLineaAsync(l);
    }

    /// <summary>Elegir la línea lee sus condiciones vigentes a la fecha de desembolso y propone sus valores por defecto.</summary>
    private async Task ElegirLineaAsync(Guid? linea)
    {
        _linea = linea;
        _condiciones = null;
        _valorDelBien = null;
        _opcion = null;
        _periodicidad = _sistema = DeLaLinea;
        Cambio();
        if (linea is not { } id) return;
        using var carga = _carga.Iniciar();
        var r = await Lineas.LineaAsync(id, _desembolso);
        if (!r.IsSuccess || r.Value?.CurrentVersion is not { } v) return;    // sin las condiciones, el servidor sigue aplicando las de la línea
        _condiciones = v;
        _periodicidad = v.DefaultPeriodicity;
        _sistema = v.DefaultAmortizationSystem;
        _monto = Math.Clamp(_monto, v.MinAmount, v.MaxAmount);
        _primerPago = v.AsksFirstDueDate || EsPagoUnico ? Propuesta() : null;
    }

    /// <summary>La fecha del primer pago que se propone: un período después del desembolso (en pago único, un mes), o el día de pago de la línea.</summary>
    private DateOnly Propuesta()
    {
        var p = PeriodicidadElegida;
        var fecha = p switch
        {
            0 => _desembolso.AddMonths(1),
            _ when p % 30 == 0 => _desembolso.AddMonths(p / 30),
            _ => _desembolso.AddDays(p),
        };
        if (_condiciones?.PaymentDay is { } dia && p >= 30)
            fecha = new DateOnly(fecha.Year, fecha.Month, Math.Min(dia, DateTime.DaysInMonth(fecha.Year, fecha.Month)));
        return fecha > _desembolso ? fecha : _desembolso.AddDays(1);
    }

    /// <summary>Un dato cambió: la simulación que se ve ya no corresponde, y la fecha del primer pago se ajusta si quedó antes del desembolso.</summary>
    private void Cambio()
    {
        if (_simulacion is not null) _vieja = true;
        _error = null;
        if (PideFechaDePrimerPago && (_primerPago is null || _primerPago <= _desembolso)) _primerPago = Propuesta();
        _avisoDeDatos = _vieja ? "Cambió un dato: vuelva a simular para ver el plan con lo nuevo." : null;
    }

    private SimulacionRequest Entrada() => new(_linea!.Value, _monto, EsPagoUnico ? 1 : _cuotas,
        _periodicidad == DeLaLinea ? null : _periodicidad, _desembolso, PideFechaDePrimerPago ? _primerPago : null,
        AmortizationSystem: _sistema == DeLaLinea || EsPagoUnico ? null : _sistema, PersonPublicId: _persona?.PublicId);

    private async Task SimularAsync()
    {
        if (_linea is null) return;
        using var carga = _carga.Iniciar();
        _error = null;
        _avisoDeDatos = null;
        _entrada = Entrada();
        var r = await Originacion.SimularAsync(_entrada);
        if (!r.IsSuccess) { _simulacion = null; _error = string.Join(" ", LineasDeCreditoClient.Explicar(r)); return; }
        _simulacion = r.Value;
        _vieja = false;
        _claveDeEnvio = new ClaveDeOperacion();
    }

    private async Task ImprimirAsync()
    {
        if (_entrada is null) return;
        using var carga = _carga.Iniciar();
        var r = await Originacion.SimulacionEnPdfAsync(_entrada);
        if (!r.IsSuccess || r.Value is null) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo generar el PDF."); return; }
        using var flujo = new DotNetStreamReference(new MemoryStream(r.Value.Contenido));
        await JS.InvokeVoidAsync("descargas.downloadFromStream", r.Value.Nombre, r.Value.TipoContenido, flujo);
    }

    private async Task EnviarAsync()
    {
        if (_entrada is null || _persona is null) return;
        using var carga = _carga.Iniciar();
        var r = await Originacion.EnviarSimulacionAsync(new EnviarSimulacionRequest(_entrada, _persona.PublicId), _claveDeEnvio);
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo enviar la simulación."); return; }
        await Notification.SuccessAsync("La simulación quedó en la cola de mensajes al deudor.");
    }

    private async Task UsarAsync()
    {
        if (_entrada is not { } e || _simulacion is not { } s) return;
        await SimulacionHecha.InvokeAsync((e, s));
        await CompraElegida.InvokeAsync(Opciones.Count > 0 && _valorDelBien is { } v && _opcion is { } o ? (v, o) : null);
        if (_persona is not null) await PersonaElegida.InvokeAsync(_persona);
    }

    private static DateOnly? LeerFecha(object? valor) =>
        DateOnly.TryParse(valor?.ToString(), CultureInfo.InvariantCulture, out var f) ? f : null;

    private static decimal? LeerDecimal(object? valor) =>
        decimal.TryParse(valor?.ToString(), NumberStyles.Number, CultureInfo.InvariantCulture, out var d) ? d : null;

    private static int? LeerEntero(object? valor) =>
        int.TryParse(valor?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var i) ? i : null;
}
