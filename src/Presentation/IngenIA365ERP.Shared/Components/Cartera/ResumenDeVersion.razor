@using System.Globalization
@using IngenIA365ERP.Shared.Services.Cartera

@* Feature 013, US1 (T0361): una versión de la línea, de sólo lectura, por las mismas secciones del editor. *@
<div class="info-card">
    <h4>Versión @V.VersionNumber · desde @V.ValidFrom.ToString("dd/MM/yyyy") @(V.ValidTo is { } h ? $"hasta {h:dd/MM/yyyy}" : "")</h4>
    <p class="texto-tenue">@V.Reason · registrada @V.RegisteredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")@(V.RegisteredBy is null ? "" : $" por {V.RegisteredBy}")</p>
    <div class="form-grid">
        <div class="campo"><b>Modalidad</b> @V.ModalityCode@(V.SubsegmentCode is null ? "" : $" / {V.SubsegmentCode}")</div>
        <div class="campo"><b>Tasa</b> @Tasa</div>
        <div class="campo"><b>Mora</b> @(V.DefaultRateKind == 1 ? $"{Pct(V.DefaultRate)} EA" : $"{V.DefaultRateFactor?.ToString("0.######", Es)} veces la corriente")</div>
        <div class="campo"><b>Días</b> @TextosDeCartera.Convencion(V.DayCount)</div>
        <div class="campo"><b>Montos</b> @V.MinAmount.ToString("N0", Es) a @V.MaxAmount.ToString("N0", Es)</div>
        <div class="campo"><b>Plazos</b> @V.MinTermMonths a @V.MaxTermMonths meses@(V.MaxInstallments is { } c ? $" · hasta {c} cuotas" : "")</div>
        <div class="campo"><b>Periodicidades</b> @TextosDeCartera.Lista(TextosDeCartera.Periodicidades, V.Periodicities)</div>
        <div class="campo"><b>Sistemas</b> @TextosDeCartera.Lista(TextosDeCartera.Sistemas, V.AmortizationSystems)</div>
        <div class="campo"><b>Gracia</b> @TextosDeCartera.ClaseDeGracia(V.AllowedGraceKind)@(V.MaxGraceInstallments is { } maxGracia ? $" hasta {maxGracia} cuotas" : "")</div>
        <div class="campo"><b>Formas de pago</b> @TextosDeCartera.Lista(TextosDeCartera.FormasDePago, V.PaymentForms)</div>
        <div class="campo"><b>Clientes</b> @(V.AllowsNonAssociates ? "Asociados y no asociados" : "Sólo asociados")@(V.ForEmployees ? " · para empleados" : "")</div>
        <div class="campo"><b>Comercio</b> @(V.AllowsCommercialOrigin ? "Admite ventas a crédito" : "No")</div>
        <div class="campo"><b>Concepto tributario</b> @(V.InterestTaxTreatment switch { 1 => "No gravado", 2 => "Gravado", _ => "Sin concepto" })@(V.InterestTaxSupportAttachmentPublicId is null ? "" : " · con soporte")</div>
        <div class="campo"><b>Puntaje</b> @(V.HasScoring ? $"Sí, mínimo {V.MinimumScore?.ToString("N2", Es) ?? "—"}" : "No")</div>
    </div>

    @if (V.RateBands.Count > 0)
    {
        <h5>Bandas</h5>
        <div class="tabla-desplazable">
            <table class="data-grid">
                <thead><tr><th>Monto</th><th>Plazo (meses)</th><th>Deudor</th><th>Empleados</th><th class="numero">@(V.RateKind == 1 ? "Tasa" : "Margen")</th></tr></thead>
                <tbody>
                    @foreach (var b in V.RateBands.OrderBy(b => b.Order))
                    {
                        <tr>
                            <td>@Rango(b.AmountFrom, b.AmountTo)</td>
                            <td>@($"{b.TermFrom?.ToString() ?? "…"} – {b.TermTo?.ToString() ?? "…"}")</td>
                            <td>@TextosDeCartera.TipoDeDeudor(b.DebtorKind)</td>
                            <td>@(b.ForEmployees switch { true => "Sí", false => "No", _ => "Indiferente" })</td>
                            <td class="numero">@(V.RateKind == 1 ? $"{Pct(b.EffectiveAnnual)} EA" : $"{Pct(b.Margin)}")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    @if (V.Insurances.Count > 0)
    {
        <h5>Seguros</h5>
        <ul>
            @foreach (var s in V.Insurances)
            {
                <li>@s.Code · @s.Name (@s.InsurerName): @Pct(s.Rate) sobre @TextosDeCartera.BaseDeSeguro(s.Base).ToLowerInvariant(), @TextosDeCartera.Periodicidad(s.Periodicity).ToLowerInvariant()@(s.ComputesForUsury ? " · computa para usura" : "")</li>
            }
        </ul>
    }
    @if (V.CollateralRules.Count > 0)
    {
        <h5>Garantías</h5>
        <ul>
            @foreach (var g in V.CollateralRules.OrderBy(g => g.Order))
            {
                <li>@Rango(g.AmountFrom, g.AmountTo): @TextosDeCartera.Lista(TextosDeCartera.Garantias, g.AdmittedKinds)@(g.CoDebtors > 0 ? $" · {g.CoDebtors} codeudor(es)" : "")</li>
            }
        </ul>
    }
    @if (V.Documents.Count > 0)
    {
        <h5>Documentos</h5>
        <ul>@foreach (var d in V.Documents.OrderBy(d => d.Order)) { <li>@d.Code · @d.Name@(d.Mandatory ? "" : " (opcional)")</li> }</ul>
    }
    <p class="texto-tenue">Huella: @V.ContentSha256</p>
</div>

@code {
    [Parameter, EditorRequired] public VersionDeLineaDto V { get; set; } = default!;

    private static readonly CultureInfo Es = CultureInfo.GetCultureInfo("es-CO");

    private string Tasa => V.RateKind == 1
        ? $"Fija {Pct(V.EffectiveAnnual)} EA"
        : $"{V.IndexCode} {V.IndexKey} + {Pct(V.Margin)}{(V.RateFloor is { } p ? $", piso {Pct(p)}" : "")}{(V.RateCeiling is { } t ? $", techo {Pct(t)}" : "")}";

    private static string Pct(decimal? f) => f is { } x ? LineasDeCreditoClient.Porcentaje(x) : "—";

    private static string Rango(decimal? desde, decimal? hasta) => $"{desde?.ToString("N0", Es) ?? "…"} – {hasta?.ToString("N0", Es) ?? "…"}";
}
