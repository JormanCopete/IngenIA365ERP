@using IngenIA365ERP.Shared.Services.Cartera
@using IngenIA365ERP.Shared.Services.Http
@inject GarantiasClient ClienteDeGarantias
@inject INotificationService Notification

@* Feature 013, US3 (T0460; FR-043, FR-044, T71–T73; contracts/api.md §6): la zona «Garantías y pagaré» del expediente de una solicitud.
   Garantías reales o de fondo: registrarlas mientras la solicitud no esté decidida, pasarlas de estado (constituida → perfeccionada →
   extinguida o ejecutada) y adjuntar sus documentos (avalúo, póliza, registro) directo al almacén. El pagaré: físico (con su custodia y el
   documento firmado) o desmaterializado por el depósito de valores vigente, con «Actualizar estado» para traer la firma. Un pagaré del
   depósito simulado se marca: en producción no tiene efecto legal. *@
<div class="info-card">
    <h4>Garantías y pagaré</h4>
    <IndicadorDeCarga Cargando="@_carga.Activa">
        @if (_garantias.Count > 0)
        {
            <table class="data-grid">
                <thead><tr><th>Clase</th><th>Descripción</th><th class="numero">Valor</th><th class="numero">Admisible</th><th>Estado</th><th></th></tr></thead>
                <tbody>
                    @foreach (var g in _garantias)
                    {
                        var garantia = g;
                        <tr>
                            <td>@TextosDeDesembolso.ClaseDeGarantia(garantia.Kind)</td>
                            <td>@garantia.Description@(garantia.MortgageRank is { } grado ? $" · hipoteca de grado {grado}" : "")@(garantia.ValidUntil is { } v ? $" · vigente hasta {v:dd/MM/yyyy}" : "")</td>
                            <td class="numero">@TextosDeOriginacion.Pesos(garantia.Value)</td>
                            <td class="numero">@TextosDeOriginacion.Pesos(garantia.AdmissibleValue)</td>
                            <td>@TextosDeDesembolso.EstadoDeGarantia(garantia.Status) · @garantia.Documents.Count documento(s)</td>
                            <td>
                                <PermissionGate Required="Lending.Guarantees.Manage">
                                    @foreach (var siguiente in TextosDeDesembolso.SiguientesEstados(garantia.Status))
                                    {
                                        var estado = siguiente;
                                        <SfButton CssClass="e-flat e-small" Disabled="@_accion.Activa" OnClick="@(() => AbrirEstado(garantia, estado))">@TextosDeDesembolso.EstadoDeGarantia(estado)…</SfButton>
                                    }
                                    @if (garantia.Status is "Constituted" or "Valid")
                                    {
                                        <SfButton CssClass="e-flat e-small" OnClick="@(() => _adjuntarA = _adjuntarA == garantia.PublicId ? null : garantia.PublicId)">Adjuntar</SfButton>
                                    }
                                </PermissionGate>
                            </td>
                        </tr>
                        @if (_adjuntarA == garantia.PublicId)
                        {
                            <tr><td colspan="6"><SubirSoporte OwnerEntityType="@GarantiasClient.DuenoDeDocumentos" OwnerEntityPublicId="@garantia.PublicId" OnSubido="@CargarAsync" /></td></tr>
                        }
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="texto-tenue">La solicitud no tiene garantías reales registradas.</p>
        }

        @if (Solicitud.Status is 1 or 2 or 3 or 4)
        {
            <PermissionGate Required="Lending.Guarantees.Manage">
                <div class="toolbar">
                    <label class="campo">Clase
                        <select class="e-input" @bind="_nueva.Clase">
                            @foreach (var c in TextosDeDesembolso.ClasesDeGarantia) { <option value="@c.Valor">@c.Texto</option> }
                        </select>
                    </label>
                    <label class="campo campo-ancho">Descripción <input class="e-input" @bind="_nueva.Descripcion" maxlength="300" /></label>
                    <label class="campo">Valor <input class="e-input" type="number" min="0" step="1" @bind="_nueva.Valor" /></label>
                    <label class="campo">Vigente hasta <input class="e-input" type="date" @bind="_nueva.VigenteHasta" /></label>
                    @if (_nueva.Clase == "Mortgage")
                    {
                        @* K6b (T1060): la hipoteca lleva su matrícula y su grado; vivienda exige primer grado para desembolsar (Ley 546). *@
                        <label class="campo">Matrícula <input class="e-input" @bind="_nueva.Matricula" maxlength="60" /></label>
                        <label class="campo">Grado <input class="e-input" type="number" min="1" max="9" @bind="_nueva.Grado" /></label>
                    }
                    <SfButton CssClass="e-outline" Disabled="@(_accion.Activa || string.IsNullOrWhiteSpace(_nueva.Descripcion) || _nueva.Valor is not > 0)" OnClick="@RegistrarAsync">Registrar garantía</SfButton>
                </div>
            </PermissionGate>
        }

        <h4>Pagaré</h4>
        @if (_pagare is { } p)
        {
            <p>
                @TextosDeDesembolso.FormaDePagare(p.Form) · @TextosDeDesembolso.EstadoDePagare(p.Status)@(p.Number is { } n ? $" · {n}" : "")
                @if (p.Perfected) { <span class="e-badge e-badge-success">Perfeccionado</span> }
                @if (p.Simulated) { <span class="e-badge e-badge-warning">Depósito simulado: sin efecto legal en producción</span> }
                @if (p.SignatureRejected) { <span class="e-badge e-badge-danger">El firmante rechazó la firma</span> }
            </p>
            <PermissionGate Required="Lending.PromissoryNotes.Manage">
                <div class="toolbar">
                    @if (p.Form == "Dematerialized" && p.Status is "Created" or "PendingSignature" or "Signed")
                    {
                        <SfButton CssClass="e-outline" Disabled="@_accion.Activa" OnClick="@ActualizarAsync">Actualizar estado</SfButton>
                    }
                    @if (p.Form == "Physical" && p.Status is "Created" or "Signed")
                    {
                        <SubirSoporte OwnerEntityType="@GarantiasClient.DuenoDeDocumentos" OwnerEntityPublicId="@p.PublicId" OnSubido="@CargarAsync" />
                        <label class="campo">Custodia <input class="e-input" @bind="_custodia" maxlength="120" /></label>
                        <SfButton CssClass="e-outline" Disabled="@(_accion.Activa || p.Documents.Count == 0 || string.IsNullOrWhiteSpace(_custodia))" OnClick="@CustodiaAsync">Registrar custodia</SfButton>
                    }
                </div>
            </PermissionGate>
        }
        else if (Solicitud.Status is not (6 or 7 or 8 or 9))
        {
            <PermissionGate Required="Lending.PromissoryNotes.Manage">
                <div class="toolbar">
                    <label class="campo">Forma
                        <select class="e-input" @bind="_formaDelPagare">
                            <option value="Dematerialized">Desmaterializado (depósito de valores)</option>
                            <option value="Physical">Físico</option>
                        </select>
                    </label>
                    @if (_formaDelPagare == "Physical")
                    {
                        <label class="campo">Número <input class="e-input" @bind="_numeroFisico" maxlength="40" /></label>
                    }
                    <SfButton CssClass="e-outline" Disabled="@_accion.Activa" OnClick="@CrearPagareAsync">Crear pagaré</SfButton>
                </div>
            </PermissionGate>
        }
        else
        {
            <p class="texto-tenue">Sin pagaré.</p>
        }
    </IndicadorDeCarga>
</div>

<SfDialog @bind-Visible="_mostrarEstado" Header="@($"Pasar a «{TextosDeDesembolso.EstadoDeGarantia(_estado)}»")" Width="520px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Content>
            <IndicadorDeCarga Cargando="@_accion.Activa" Texto="Registrando…">
                <label class="campo campo-ancho">Motivo * <input class="e-input" @bind="_motivo" maxlength="500" /></label>
                <div class="toolbar">
                    <SfButton CssClass="e-primary" Disabled="@(_accion.Activa || string.IsNullOrWhiteSpace(_motivo))" OnClick="@CambiarEstadoAsync">Registrar</SfButton>
                    <SfButton CssClass="e-outline" OnClick="@(() => _mostrarEstado = false)">Volver</SfButton>
                </div>
            </IndicadorDeCarga>
        </Content>
    </DialogTemplates>
</SfDialog>

@code {
    [Parameter, EditorRequired] public SolicitudDto Solicitud { get; set; } = default!;

    private sealed class NuevaGarantia
    {
        public string Clase { get; set; } = "Pledge";
        public string? Descripcion { get; set; }
        public decimal? Valor { get; set; }
        public DateOnly? VigenteHasta { get; set; }
        public string? Matricula { get; set; }
        public byte? Grado { get; set; } = 1;
    }

    private readonly EstadoDeCarga _carga = new(), _accion = new();
    private List<GarantiaDto> _garantias = [];
    private PagareDto? _pagare;
    private NuevaGarantia _nueva = new();
    private Guid? _adjuntarA;
    private GarantiaDto? _garantia;
    private string _estado = "Valid", _formaDelPagare = "Dematerialized";
    private string? _motivo, _numeroFisico, _custodia;
    private bool _mostrarEstado;
    private ClaveDeOperacion _clave = new();

    protected override async Task OnParametersSetAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        using var carga = _carga.Iniciar();
        _garantias = [.. (await ClienteDeGarantias.GarantiasAsync(Solicitud.PublicId)).Value?.Items ?? []];
        _pagare = (await ClienteDeGarantias.PagaresAsync(Solicitud.PublicId)).Value?.Items.FirstOrDefault(p => p.Status != "Voided");
    }

    private async Task RegistrarAsync()
    {
        using var carga = _accion.Iniciar();
        var r = await ClienteDeGarantias.RegistrarGarantiaAsync(new GarantiaRequest
        {
            OwnerPublicId = Solicitud.PublicId,
            Kind = _nueva.Clase,
            Description = _nueva.Descripcion!.Trim(),
            Value = _nueva.Valor ?? 0m,
            ValidUntil = _nueva.VigenteHasta,
            RegistrationReference = _nueva.Clase == "Mortgage" && !string.IsNullOrWhiteSpace(_nueva.Matricula) ? _nueva.Matricula.Trim() : null,
            MortgageRank = _nueva.Clase == "Mortgage" ? _nueva.Grado : null,
        }, _clave);
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo registrar la garantía."); return; }
        _nueva = new NuevaGarantia();
        _clave = new ClaveDeOperacion();
        await CargarAsync();
    }

    private void AbrirEstado(GarantiaDto garantia, string estado)
    {
        _garantia = garantia;
        _estado = estado;
        _motivo = null;
        _clave = new ClaveDeOperacion();
        _mostrarEstado = true;
    }

    private async Task CambiarEstadoAsync()
    {
        if (_garantia is null || string.IsNullOrWhiteSpace(_motivo)) return;
        using var carga = _accion.Iniciar();
        var r = await ClienteDeGarantias.CambiarEstadoAsync(_garantia.PublicId, new EstadoDeGarantiaRequest(_estado, _motivo.Trim()), _clave);
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo cambiar el estado."); return; }
        _mostrarEstado = false;
        await CargarAsync();
    }

    private async Task CrearPagareAsync()
    {
        using var carga = _accion.Iniciar();
        var r = await ClienteDeGarantias.CrearPagareAsync(new PagareRequest("Application", Solicitud.PublicId, _formaDelPagare,
            string.IsNullOrWhiteSpace(_numeroFisico) ? null : _numeroFisico.Trim()), new ClaveDeOperacion());
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo crear el pagaré."); return; }
        await CargarAsync();
    }

    private async Task ActualizarAsync()
    {
        if (_pagare is null) return;
        using var carga = _accion.Iniciar();
        var r = await ClienteDeGarantias.ActualizarPagareAsync(_pagare.PublicId);
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "El depósito de valores no respondió."); return; }
        _pagare = r.Value;
    }

    private async Task CustodiaAsync()
    {
        if (_pagare is not { Documents.Count: > 0 } p || string.IsNullOrWhiteSpace(_custodia)) return;
        using var carga = _accion.Iniciar();
        var r = await ClienteDeGarantias.CustodiaAsync(p.PublicId, new CustodiaDePagareRequest(DateTime.UtcNow, _custodia.Trim(), p.Documents[^1]),
            new ClaveDeOperacion());
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo registrar la custodia."); return; }
        await CargarAsync();
    }
}
