@using System.Globalization
@using IngenIA365ERP.Shared.Services.Cartera

@* Feature 013, US5 (T0562): una distribución de pago por cuota y concepto (antes y después de un reverso). Sólo muestra: no carga nada. *@
<table class="data-grid">
    <thead><tr><th class="numero">Cuota</th><th>Concepto</th><th class="numero">Valor</th></tr></thead>
    <tbody>
        @foreach (var d in Lineas)
        {
            <tr><td class="numero">@(d.Installment?.ToString(CultureInfo.InvariantCulture) ?? "—")</td><td>@TextosDeCreditos.Concepto(d.Concept)</td><td class="numero">@TextosDeCreditos.Pesos(d.Amount)</td></tr>
        }
    </tbody>
</table>
@if (Lineas.Count == 0) { <p class="texto-tenue">No cubre nada.</p> }

@code {
    [Parameter] public IReadOnlyList<LineaDeDistribucionDePagoDto> Lineas { get; set; } = [];
}
