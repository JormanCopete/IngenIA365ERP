@using IngenIA365ERP.Shared.Services.Cartera

@* Feature 013, US5 (T0563): el resultado de un ítem del contrato de obligaciones (aplicado, ya aplicado con la misma clave, rechazado o
   atendida) con el mensaje en español que trae; el código no se muestra (FR-013). Sólo muestra: no carga nada. *@
<p class="aviso @(TextosDePagos.EsRechazo(Resultado) ? "aviso-error" : Resultado == 2 ? "aviso-info" : "aviso-ok")" role="status">
    <strong>@TextosDePagos.Resultado(Resultado).</strong> @Mensaje
</p>

@code {
    [Parameter] public int Resultado { get; set; }
    [Parameter] public string? Mensaje { get; set; }
}
