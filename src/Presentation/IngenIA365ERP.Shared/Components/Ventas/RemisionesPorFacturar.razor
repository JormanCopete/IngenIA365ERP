@using IngenIA365ERP.Shared.Services.Inventario
@using IngenIA365ERP.Shared.Services.Ventas
@inject VentasClient Ventas
@inject INotificationService Notification

@* 2026-11-23 (pedido del dueño): las remisiones que faltan por facturar, para traerlas a la factura desde «Traer documento» (F8). Con cliente,
   sólo las suyas; sin él, todas, con su cliente. Se eligen una o varias del mismo cliente (Espacio o clic) y «Traer las elegidas» (Enter) las
   entrega a la pantalla, que abre la factura desde remisiones. Se facturan completas o en parte: en la factura se baja la cantidad. *@
<div data-zona-teclado>
    <IndicadorDeCarga Cargando="@_carga.Activa" Texto="Buscando las remisiones por facturar…">
        @if (_remisiones.Count == 0 && !_carga.Activa)
        {
            <p class="texto-tenue">@(Cliente is null ? "No hay remisiones por facturar." : "Este cliente no tiene remisiones por facturar.")</p>
        }
        else
        {
            <div class="tabla-desplazable tabla-de-dialogo">
                <table class="data-grid">
                    <thead><tr><th></th><th>Número</th><th>Fecha</th><th class="numero">Días</th><th>Cliente</th><th>Facturación</th><th class="numero">Total</th></tr></thead>
                    <tbody>
                        @foreach (var r in _remisiones)
                        {
                            var remision = r;
                            <tr class="@(_elegidas.Contains(r.DocumentPublicId) ? "fila-elegida" : null)" @onclick="@(() => Alternar(remision))">
                                <td><input type="checkbox" checked="@_elegidas.Contains(r.DocumentPublicId)" aria-label="@($"Elegir la remisión {r.Numero}")"
                                           data-ayuda="Marque las remisiones que va a facturar; deben ser del mismo cliente."
                                           @onclick:stopPropagation="true" @onchange="@(e => Elegir(remision, e.Value is true))" /></td>
                                <td>@r.Numero</td><td>@r.OperationDate.ToString("dd/MM/yyyy")</td>
                                <td class="numero">@FormularioDelCiclo.DiasDesde(r.OperationDate, DateOnly.FromDateTime(DateTime.Today))</td>
                                <td>@r.CounterpartyName</td><td>@TextosDeVentas.EstadoDeFacturacion(r.InvoicingState)</td>
                                <td class="numero">@r.Total.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </IndicadorDeCarga>
    @if (Motivo is { } motivo && _elegidas.Count > 0)
    {
        <p class="texto-alerta">@motivo</p>
    }
    <div class="toolbar">
        <SfButton CssClass="e-primary" data-principal Disabled="@(Motivo is not null || Ocupado)" OnClick="@TraerAsync">Traer las elegidas (@_elegidas.Count)</SfButton>
    </div>
    <p class="texto-apoyo">La factura trae lo pendiente de cada línea; para facturar en parte, baje la cantidad en la factura (al precio de la remisión).</p>
</div>

@code {
    /// <summary>El cliente de la factura: con él, sólo sus remisiones.</summary>
    [Parameter] public Guid? Cliente { get; set; }

    /// <summary>La pantalla está ocupada (guardando): no se trae mientras tanto.</summary>
    [Parameter] public bool Ocupado { get; set; }

    /// <summary>Las remisiones elegidas, todas confirmadas y del mismo cliente.</summary>
    [Parameter] public EventCallback<IReadOnlyList<ResumenDeVentaDto>> Traer { get; set; }

    private readonly EstadoDeCarga _carga = new();
    private List<ResumenDeVentaDto> _remisiones = [];
    private readonly HashSet<Guid> _elegidas = [];

    private IReadOnlyCollection<ResumenDeVentaDto> Elegidas => _remisiones.Where(r => _elegidas.Contains(r.DocumentPublicId)).ToList();

    private string? Motivo => FormularioDelCiclo.NoSePuedenFacturarJuntas(Elegidas);

    protected override async Task OnInitializedAsync()
    {
        using var carga = _carga.Iniciar();
        var r = await Ventas.ListarDocumentosAsync(new FiltroDeVentas
        {
            Class = TextosDeVentas.ClaseRemision, Invoicing = TextosDeVentas.FacturacionPorFacturar, Person = Cliente, PageSize = 100,
        });
        if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudieron consultar las remisiones."); return; }
        _remisiones = [.. r.Value!.Items.Where(x => x.Status == TextosDeVentas.EstadoConfirmado && x.InvoicingState != "Invoiced")];
        if (_remisiones.Count == 1) _elegidas.Add(_remisiones[0].DocumentPublicId);
    }

    private void Alternar(ResumenDeVentaDto remision) => Elegir(remision, !_elegidas.Contains(remision.DocumentPublicId));

    private void Elegir(ResumenDeVentaDto remision, bool elegida)
    {
        if (elegida) _elegidas.Add(remision.DocumentPublicId);
        else _elegidas.Remove(remision.DocumentPublicId);
    }

    private async Task TraerAsync()
    {
        if (Motivo is not null) return;
        await Traer.InvokeAsync([.. Elegidas]);
    }
}
