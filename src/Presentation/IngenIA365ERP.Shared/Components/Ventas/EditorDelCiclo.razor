@using IngenIA365ERP.Shared.Services.Http
@using IngenIA365ERP.Shared.Services.Inventario
@using IngenIA365ERP.Shared.Services.Ventas
@inject VentasClient Ventas
@inject InventarioClient Inventario
@inject MediosDePagoClient Medios
@inject INotificationService Notification

@* Feature 012, I6 (T894–T898; FR-052, FR-055, FR-060; contracts/api.md §18.4): el borrador de un documento del ciclo comercial
   —cotización, pedido, remisión o nota débito— sobre la ruta de su clase. El servidor precifica, aplica las promociones (se ven en la
   línea, no se digitan) y calcula los totales en cada guardado; con orígenes y sin líneas propone lo pendiente de cada línea origen.
   Confirmar, anular (con motivo: el documento contrario, o la liberación de la reserva de un pedido) y descartar van detrás de su permiso.
   La nota débito cobra: sus pagos van por el panel de cobro y, con un medio de crédito, quedan esperando la aprobación del crédito
   provisional. (nuevo) *@
<IndicadorDeCarga Cargando="@(_carga.Activa || _guardado.Activa)" Texto="@(_guardado.Activa ? "Guardando…" : "Cargando…")">
    <div class="info-card">
        <div class="page-header">
            <h4>@(_doc is null ? $"{(Masculino ? "Nuevo" : "Nueva")} {Nombre}" : $"{Titulo(_doc)} {_doc.Numero} · {TextosDeInventario.Estado(_doc.Status)}")</h4>
            <div class="toolbar">
                @if (Borrador)
                {
                    <PermissionGate Required="Inventory.Sales.Create">
                        <SfButton CssClass="e-outline" IconCss="e-icons e-save" Disabled="@_guardado.Activa" OnClick="@(() => GuardarAsync(false))">Guardar</SfButton>
                    </PermissionGate>
                }
                @if (_doc is { Status: 0 })
                {
                    <PermissionGate Required="Inventory.Sales.Confirm">
                        <SfButton CssClass="e-primary" IconCss="e-icons e-check" Disabled="@(_guardado.Activa || (ConPagos && _cobro.Problema() is not null))" OnClick="@ConfirmarAsync">Confirmar</SfButton>
                    </PermissionGate>
                    <PermissionGate Required="Inventory.Sales.Create">
                        <SfButton CssClass="e-flat" Disabled="@_guardado.Activa" OnClick="@(() => PedirMotivo(Accion.Descartar))">Descartar</SfButton>
                    </PermissionGate>
                }
                @if (_doc is { Status: 2 })
                {
                    @if (Acciones is not null) { @Acciones(_doc) }
                    <PermissionGate Required="Inventory.Sales.Void">
                        <SfButton CssClass="e-outline" Disabled="@_guardado.Activa" OnClick="@(() => PedirMotivo(Accion.Anular))">Anular</SfButton>
                    </PermissionGate>
                }
            </div>
        </div>

        @if (_accion is { } accion)
        {
            <div class="aviso aviso-alerta">
                <p>@(accion == Accion.Anular ? AvisoDeAnulacion : "El borrador queda descartado con su motivo; no consume número.")</p>
                <label class="campo campo-ancho">Motivo * <input class="e-input" @bind="_motivo" maxlength="500" /></label>
                <div class="toolbar">
                    <SfButton CssClass="e-primary" Disabled="@(_guardado.Activa || string.IsNullOrWhiteSpace(_motivo))" OnClick="@AplicarMotivoAsync">Aceptar</SfButton>
                    <SfButton CssClass="e-flat" OnClick="@(() => _accion = null)">Cancelar</SfButton>
                </div>
            </div>
        }

        @if (_doc?.Issues is { Count: > 0 } hallazgos)
        {
            <div class="aviso aviso-alerta"><b>Lo que hoy impediría confirmarlo:</b><ul>@foreach (var h in hallazgos) { <li>@(h.LineNumber is { } n ? $"Línea {n}: " : "")@h.Message</li> }</ul></div>
        }
        @if (_origenes.Count > 0)
        {
            <p class="texto-apoyo">Nace de @string.Join(", ", _origenes.Select(o => o.DisplayNumber ?? "(sin número)")). @(Borrador && _lineas.Count == 0 ? "Al guardar se proponen las líneas pendientes." : "")</p>
        }

        <div class="form-grid">
            <label class="campo">Tipo *
                <select class="e-input" disabled="@(_doc is not null)" value="@(_tipo?.ToString() ?? "")" @onchange="@(e => _tipo = Id(e.Value))">
                    <option value="">Elija…</option>
                    @foreach (var t in _tipos) { <option value="@t.PublicId">@t.Code · @t.Name</option> }
                </select>
            </label>
            <label class="campo">Bodega
                <select class="e-input" disabled="@(!Borrador)" value="@(_bodega?.ToString() ?? "")" @onchange="@(e => _bodega = Id(e.Value))">
                    <option value="">@(_origenes.Count > 0 ? "La del origen" : "Elija…")</option>
                    @foreach (var b in _bodegas) { <option value="@b.PublicId">@b.Code · @b.Name</option> }
                </select>
            </label>
            <label class="campo">Fecha <input type="date" class="e-input" disabled="@(!Borrador)" value="@(_fecha?.ToString("yyyy-MM-dd"))" @onchange="@(e => _fecha = Fecha(e.Value))" /></label>
            @if (ConVigencia)
            {
                <label class="campo">Vigente hasta * <input type="date" class="e-input" disabled="@(!Borrador)" value="@(_vigencia?.ToString("yyyy-MM-dd"))" @onchange="@(e => _vigencia = Fecha(e.Value))" /></label>
            }
            else if (_doc?.ValidUntil is { } vence)
            {
                <div class="kpi-card"><span class="label">La reserva vence</span><span>@vence.ToString("dd/MM/yyyy")</span></div>
            }
            @if (ConConcepto)
            {
                <label class="campo">Concepto de corrección * <input class="e-input" disabled="@(!Borrador)" @bind="_concepto" maxlength="4" placeholder="1, 2, 3…" /></label>
            }
            <label class="campo campo-ancho">Cliente <ClienteDelPos @bind-Seleccionado="_cliente" /></label>
            <label class="campo">Vendedor
                <select class="e-input" disabled="@(!Borrador)" value="@(_vendedor?.ToString() ?? "")" @onchange="@(e => _vendedor = Id(e.Value))">
                    <option value="">Sin vendedor</option>
                    @foreach (var v in _vendedores) { <option value="@v.SalespersonPublicId">@v.Person.Name</option> }
                </select>
            </label>
            <label class="campo campo-ancho">Notas <input class="e-input" disabled="@(!Borrador)" @bind="_notas" maxlength="1000" /></label>
        </div>

        @if (Borrador && !SoloLineasDelOrigen)
        {
            <SelectorDeProducto Etiqueta="Agregar producto (lector o código + Enter)" Bodega="@_bodega" Elegido="@AgregarLineaAsync" />
        }
        <div class="tabla-desplazable">
            <table class="data-grid">
                <thead>
                    <tr>
                        <th>#</th><th>Producto</th><th>Unidad</th><th class="numero">Cantidad</th><th class="numero">Precio (vacío: el de la lista)</th>
                        <th class="numero">Descuento %</th><th>Promoción</th>
                        @if (ConExistencias) { <th class="numero">Físico</th><th class="numero">Reservado</th><th class="numero">Disponible</th> }
                        @if (_doc is { Status: 2 } && _doc.Lines.Any(l => l.Pending is not null)) { <th class="numero">@EtiquetaPendiente</th> }
                        <th class="numero">Total</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < _lineas.Count; i++)
                    {
                        var indice = i;
                        var l = _lineas[i];
                        var guardada = _doc?.Lines.FirstOrDefault(x => x.LinePublicId == l.LinePublicId);
                        var existencia = _existencias.GetValueOrDefault(l.ProductPublicId);
                        <tr>
                            <td>@(indice + 1)</td><td>@l.Producto</td><td>@l.Unidad</td>
                            <td class="numero"><input class="e-input numero" type="number" min="0" step="any" disabled="@(!Borrador)" @bind="l.Cantidad" /></td>
                            <td class="numero"><input class="e-input numero" type="number" min="0" step="any" disabled="@(!Borrador || SoloLineasDelOrigen)" @bind="l.Precio" placeholder="@guardada?.ListPrice.ToString("N0")" /></td>
                            <td class="numero"><input class="e-input numero" type="number" min="0" max="100" step="any" disabled="@(!Borrador || l.ConPromocion)" @bind="l.Descuento" title="@(l.ConPromocion ? "La línea tiene una promoción: no admite descuento manual." : "")" /></td>
                            <td>@FormularioDelCiclo.Promociones(guardada)</td>
                            @if (ConExistencias)
                            {
                                <td class="numero">@existencia?.Physical.ToString("0.####")</td><td class="numero">@existencia?.Reserved.ToString("0.####")</td><td class="numero">@existencia?.Available.ToString("0.####")</td>
                            }
                            @if (_doc is { Status: 2 } && _doc.Lines.Any(x => x.Pending is not null)) { <td class="numero">@guardada?.Pending?.ToString("0.####")</td> }
                            <td class="numero">@guardada?.Total.ToString("N0")</td>
                            <td>@if (Borrador && !SoloLineasDelOrigen) { <SfButton CssClass="e-flat" IconCss="e-icons e-delete" title="Quitar la línea" OnClick="@(() => _lineas.RemoveAt(indice))" /> }</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (_doc is { } d)
        {
            <div class="pos-renglon">Subtotal @d.Totals.Subtotal.ToString("N0") · descuentos @d.Totals.DiscountTotal.ToString("N0") · impuestos @d.Totals.TaxTotal.ToString("N0") · total @d.Totals.Total.ToString("N0")</div>
            @if (ConPagos && d.Status == 0)
            {
                <h4>Pagos</h4>
                @if (_sesion is null) { <p class="aviso aviso-info">No tiene una sesión de caja abierta: los pagos que se arquean (efectivo, tarjetas) no se pueden registrar hasta abrirla.</p> }
                @if (_cobro.Pagos.Any(p => TextosDeVentas.EsCredito(p.Medio.Class)))
                {
                    <p class="aviso aviso-info">El pago a crédito es provisional mientras Cartera no responda en línea: la nota queda esperando la aprobación del crédito y se confirma con la última aprobación.</p>
                }
                <PanelDeCobro Cobro="@_cobro" Medios="@_medios" Cambio="@StateHasChanged" Cliente="@_cliente?.PublicId" TipoDeDocumento="@_tipo" Fecha="@_fecha" />
            }
        }
    </div>
</IndicadorDeCarga>

@code {
    private enum Accion { Anular, Descartar }

    /// <summary>La ruta de la clase (<see cref="VentasClient.Rutas"/>).</summary>
    [Parameter, EditorRequired] public string Ruta { get; set; } = "";

    /// <summary>Las clases de los tipos que se ofrecen (<see cref="TextosDeVentas"/>).</summary>
    [Parameter, EditorRequired] public IReadOnlyList<int> Clases { get; set; } = [];

    /// <summary>«cotización», «remisión»…, para el título.</summary>
    [Parameter] public string Nombre { get; set; } = "documento";

    [Parameter] public Guid? Documento { get; set; }

    /// <summary>Los documentos de los que nace uno nuevo (el pedido de la remisión, la factura de la nota débito).</summary>
    [Parameter] public IReadOnlyList<Guid>? Origenes { get; set; }

    /// <summary>El nombre es masculino («pedido»): «Nuevo pedido», «guardado».</summary>
    [Parameter] public bool Masculino { get; set; }

    [Parameter] public bool ConVigencia { get; set; }
    [Parameter] public bool ConConcepto { get; set; }
    [Parameter] public bool ConPagos { get; set; }
    [Parameter] public bool ConExistencias { get; set; }

    /// <summary>La línea viene toda del origen: no se agregan productos ni se cambia el precio.</summary>
    [Parameter] public bool SoloLineasDelOrigen { get; set; }

    [Parameter] public string EtiquetaPendiente { get; set; } = "Pendiente";
    [Parameter] public string AvisoDeAnulacion { get; set; } = "Se crea el documento contrario con su propia fecha.";

    /// <summary>Acciones propias de un documento confirmado (convertir, remisionar, facturar).</summary>
    [Parameter] public RenderFragment<DocumentoDeVentaDto>? Acciones { get; set; }

    /// <summary>Después de guardar, confirmar, anular o descartar, con el documento como quedó (nulo si se descartó).</summary>
    [Parameter] public EventCallback<DocumentoDeVentaDto?> Cambio { get; set; }

    private readonly EstadoDeCarga _carga = new(), _guardado = new();
    private readonly ClaveDeOperacion _claveGuardar = new(), _claveConfirmar = new(), _claveMotivo = new();
    private DocumentoDeVentaDto? _doc;
    private SesionDeCajaDto? _sesion;
    private List<TipoDeDocumentoDto> _tipos = [];
    private List<BodegaDto> _bodegas = [];
    private List<VendedorDto> _vendedores = [];
    private IReadOnlyList<MedioDelPosDto> _medios = [];
    private List<LineaDelCiclo> _lineas = [];
    private List<DocumentoReferidoDeInventarioDto> _origenes = [];
    private readonly Dictionary<Guid, ExistenciaPorBodegaDto?> _existencias = [];
    private CobroDelPos _cobro = new(0m);
    private Guid? _tipo, _bodega, _vendedor, _cargado;
    private DateOnly? _fecha = DateOnly.FromDateTime(DateTime.Today), _vigencia;
    private PersonSearchPicker.PersonSearchItem? _cliente;
    private string? _notas, _concepto, _motivo;
    private Accion? _accion;
    private bool _iniciado;

    private bool Borrador => _doc is null || _doc.Status == 0;

    protected override async Task OnParametersSetAsync()
    {
        if (!_iniciado)
        {
            _iniciado = true;
            using var carga = _carga.Iniciar();
            var tipos = await Inventario.ListarTiposAsync(grupo: TextosDeVentas.GrupoDeVentas);
            _tipos = tipos.IsSuccess ? [.. (tipos.Value ?? []).Where(t => t.IsActive && Clases.Contains(t.Class))] : [];
            var bodegas = await Inventario.ListarBodegasAsync();
            _bodegas = bodegas.IsSuccess ? [.. (bodegas.Value ?? []).Where(b => !b.IsTransit && b.IsActive)] : [];
            var vendedores = await Inventario.VendedoresAsync(null, conRetirados: false, 1, 200);
            _vendedores = vendedores.IsSuccess ? [.. vendedores.Value!.Items.Where(v => v.IsActive)] : [];
            if (ConPagos)
            {
                var sesion = await Ventas.MiSesionAbiertaAsync();
                _sesion = sesion.IsSuccess ? sesion.Value : null;
                var medios = await Medios.ListarAsync(activos: true);
                var datafonos = await Medios.DatafonosAsync(activos: true);
                _medios = MediosDeOficina.Desde(medios.IsSuccess ? medios.Value ?? [] : [], datafonos.IsSuccess ? datafonos.Value ?? [] : [], DateOnly.FromDateTime(DateTime.Today));
            }
            _tipo = _tipos.FirstOrDefault()?.PublicId;
            if (Origenes is not { Count: > 0 }) _bodega = _bodegas.FirstOrDefault(b => b.IsDefault)?.PublicId ?? _bodegas.FirstOrDefault()?.PublicId;
        }
        if (Documento is { } id && id != _cargado) await CargarAsync(id);
        else if (Documento is null && Origenes is { Count: > 0 } origenes && _doc is null)
            _origenes = origenes.Select(o => new DocumentoReferidoDeInventarioDto(o, null)).ToList();
    }

    private async Task CargarAsync(Guid id)
    {
        using var carga = _carga.Iniciar();
        var r = await Ventas.ObtenerDocumentoAsync(id);
        if (!r.IsSuccess || r.Value is null) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo consultar el documento."); return; }
        var d = r.Value;
        _doc = d;
        _cargado = id;
        _tipo = d.DocumentType.PublicId;
        _bodega = d.Warehouse?.PublicId;
        _fecha = d.OperationDate;
        _vigencia = d.ValidUntil;
        _concepto = d.CorrectionConceptCode;
        _vendedor = d.Salesperson?.PublicId;
        _origenes = [.. d.Origins ?? []];
        _cliente = d.Counterparty is { IsFinalConsumer: false } c
            ? new PersonSearchPicker.PersonSearchItem { PublicId = c.PersonPublicId, FullName = c.Name, IdentificationNumber = c.IdNumber ?? "" }
            : null;
        _lineas = FormularioDelCiclo.Lineas(d);
        if (ConPagos)
        {
            var cobro = new CobroDelPos(d.Totals.AmountDue);
            foreach (var p in d.Payments.Where(x => x.Direction == 1))
            {
                var medio = _medios.FirstOrDefault(m => m.Code == p.MeansCode);
                if (medio is null) continue;
                var pago = cobro.AgregarPorLoQueFalta(medio);
                if (pago is null) break;
                pago.Monto = p.Amount;
                pago.Entregado = p.Tendered;
                pago.Referencia = p.Reference;
                pago.Autorizacion = p.AuthorizationCode;
                pago.Lote = p.BatchNumber;
                pago.Last4 = p.Last4;
            }
            _cobro = cobro;
        }
        if (ConExistencias) await ExistenciasAsync();
    }

    /// <summary>Físico, reservado y disponible de cada producto en la bodega del documento (§5).</summary>
    private async Task ExistenciasAsync()
    {
        foreach (var producto in _lineas.Select(l => l.ProductPublicId).Distinct())
        {
            var r = await Inventario.ExistenciaDelProductoAsync(producto);
            _existencias[producto] = r.IsSuccess ? r.Value?.ByWarehouse.FirstOrDefault(b => b.Warehouse.PublicId == (_doc?.Warehouse?.PublicId ?? _bodega)) : null;
        }
    }

    private async Task AgregarLineaAsync(ProductoElegido elegido)
    {
        var producto = await Inventario.ObtenerProductoAsync(elegido.Producto.PublicId);
        if (!producto.IsSuccess || producto.Value is null) { await Notification.ErrorAsync(producto.ErrorMessage ?? "No se pudo leer el producto."); return; }
        var p = producto.Value;
        var empaque = elegido.Empaque is { } e ? p.Units.FirstOrDefault(u => u.ProductUnitPublicId == e.ProductUnitPublicId) : null;
        _lineas.Add(new LineaDelCiclo
        {
            ProductPublicId = p.PublicId, Producto = $"{p.Code} · {p.Name}", UnitPublicId = empaque?.Unit.PublicId ?? p.BaseUnit.PublicId, Unidad = empaque?.Unit.Code ?? p.BaseUnit.Code,
        });
        if (ConExistencias) await ExistenciasAsync();
    }

    private BorradorDeVentaRequest Pedido() => new(
        _tipo!.Value, _bodega ?? Guid.Empty, FormularioDelCiclo.Pedido(_lineas),
        ConPagos && _doc is not null ? _cobro.Pedido(_sesion?.CashSessionPublicId) : [],
        _fecha, _cliente?.PublicId, _vendedor, Notes: string.IsNullOrWhiteSpace(_notas) ? null : _notas.Trim(),
        OriginPublicIds: _origenes.Count > 0 ? _origenes.Select(o => o.PublicId).ToList() : null, RowVersion: _doc?.RowVersion,
        ValidUntil: ConVigencia ? _vigencia : null, CorrectionConceptCode: ConConcepto && !string.IsNullOrWhiteSpace(_concepto) ? _concepto.Trim() : null);

    private async Task<bool> GuardarAsync(bool silencioso)
    {
        if (_tipo is null) { await Notification.WarningAsync("Elija el tipo."); return false; }
        if (_bodega is null && _origenes.Count == 0) { await Notification.WarningAsync("Elija la bodega."); return false; }
        if (_lineas.Count == 0 && (_origenes.Count == 0 || ConConcepto)) { await Notification.WarningAsync("Agregue al menos un producto."); return false; }
        using var guardado = _guardado.Iniciar();
        var r = await Ventas.GuardarBorradorAsync(Ruta, _doc?.DocumentPublicId, Pedido(), _claveGuardar);
        if (!r.IsSuccess || r.Value is null) { await Notification.ErrorAsync(r.ErrorMessage ?? $"No se pudo guardar {El} {Nombre}."); return false; }
        await CargarAsync(r.Value.DocumentPublicId);
        if (!silencioso) await Notification.SuccessAsync($"{Mayuscula(Nombre)} {Hecho("guardad")}.");
        await Cambio.InvokeAsync(_doc);
        return true;
    }

    private async Task ConfirmarAsync()
    {
        if (_doc is null) return;
        if (!await GuardarAsync(true)) return;
        if (ConPagos && _cobro.Problema() is { } problema) { await Notification.WarningAsync(problema); return; }
        using var guardado = _guardado.Iniciar();
        var r = await Ventas.ConfirmarAsync(Ruta, _doc.DocumentPublicId, _doc.Totals.AmountDue, _doc.RowVersion, _claveConfirmar);
        if (!r.IsSuccess || r.Value is null) { await Notification.ErrorAsync(r.ErrorMessage ?? $"No se pudo confirmar {El} {Nombre}."); return; }
        if (r.Value.Status == 1) await Notification.InfoAsync("Quedó en aprobación: se confirma con la última aprobación.");
        else await Notification.SuccessAsync($"{Mayuscula(Nombre)} {r.Value.DisplayNumber} {Hecho("confirmad")}.");
        await CargarAsync(_doc.DocumentPublicId);
        await Cambio.InvokeAsync(_doc);
    }

    private void PedirMotivo(Accion accion)
    {
        _accion = accion;
        _motivo = null;
    }

    private async Task AplicarMotivoAsync()
    {
        if (_doc is null || _accion is null || string.IsNullOrWhiteSpace(_motivo)) return;
        using var guardado = _guardado.Iniciar();
        if (_accion == Accion.Anular)
        {
            var r = await Ventas.AnularAsync(Ruta, _doc.DocumentPublicId, _motivo.Trim(), _claveMotivo);
            if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? $"No se pudo anular {El} {Nombre}."); return; }
            await Notification.SuccessAsync($"{Mayuscula(Nombre)} {Hecho("anulad")}.");
            _accion = null;
            await CargarAsync(_doc.DocumentPublicId);
            await Cambio.InvokeAsync(_doc);
        }
        else
        {
            var r = await Ventas.DescartarAsync(Ruta, _doc.DocumentPublicId, _motivo.Trim(), _claveMotivo);
            if (!r.IsSuccess) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo descartar el borrador."); return; }
            await Notification.SuccessAsync("Borrador descartado.");
            _accion = null;
            await Cambio.InvokeAsync(null);
        }
    }

    private static string Titulo(DocumentoDeVentaDto d) => TextosDeInventario.Clase(d.Class);

    private string El => Masculino ? "el" : "la";

    private string Hecho(string raiz) => raiz + (Masculino ? "o" : "a");

    private static string Mayuscula(string s) => s.Length == 0 ? s : char.ToUpperInvariant(s[0]) + s[1..];

    private static Guid? Id(object? valor) => Guid.TryParse(valor?.ToString(), out var g) ? g : null;

    private static DateOnly? Fecha(object? valor) =>
        DateOnly.TryParse(valor?.ToString(), System.Globalization.CultureInfo.InvariantCulture, out var f) ? f : null;
}
