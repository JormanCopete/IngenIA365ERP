@using IngenIA365ERP.Shared.Services.Ventas
@inject VentasClient Ventas
@inject INotificationService Notification

@* 2026-11-12 (decisión del dueño, la cotización es una base de venta): la búsqueda de «Cargar cotización», una sola para la factura de oficina
   (F8 en NuevaFactura) y el punto de venta (Ctrl+Alt+O en PuntoDeVenta). Cada una dice si está vigente a la fecha de la venta o vencida (se
   carga con los precios de hoy). Cargar la decide la pantalla (Cargar): ésta sólo busca. Se pinta dentro del diálogo de cada pantalla con un
   @key nuevo en cada apertura.
   2026-11-18 (pedido del dueño): ya no hace falta saber el número. Al abrir lista las confirmadas más recientes —si la venta tiene cliente,
   sólo las suyas, con una casilla para ver todas— y se filtran por número, cliente, usuario que la hizo, fechas y vigencia
   (FiltrosDeCotizaciones, los mismos de la pantalla de Cotizaciones). Clic en una fila la marca; doble clic, Enter sobre la fila o
   «Cargar» la cargan. *@
<div data-zona-teclado class="buscador-de-cotizaciones">
    <p class="texto-apoyo">@Explicacion</p>
    <FiltrosDeCotizaciones Filtro="@_filtro" Estados="@EstadosDelBuscador" IdDelNumero="@IdDelNumero" SoloElCliente="@SoloElClienteActivo" Cambio="@BuscarDesdeElInicioAsync" />
    @if (Cliente is not null)
    {
        <label class="campo-check">
            <input type="checkbox" @bind="_soloElCliente" @bind:after="BuscarDesdeElInicioAsync" />
            Sólo las del cliente de la venta
        </label>
    }
    <IndicadorDeCarga Cargando="@(_carga.Activa || Ocupado)">
        @if (_halladas.Count == 0)
        {
            <p class="texto-tenue">@(_carga.Activa ? "" : "No hay cotizaciones con estos filtros.")</p>
        }
        else
        {
            <div class="tabla-desplazable buscador-de-cotizaciones-lista">
                <table class="data-grid">
                    <thead><tr><th>Número</th><th>Fecha</th><th>Cliente</th><th>Hecha por</th><th>Vendedor</th><th>Vigencia</th><th class="numero">Total</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var c in _halladas)
                        {
                            var cotizacion = c;
                            var vencida = c.ValidUntil is { } v && v < (Fecha ?? DateOnly.FromDateTime(DateTime.Today));
                            <tr class="@(_marcada == c.DocumentPublicId ? "fila-seleccionada" : "")" tabindex="0" data-enter="propio"
                                @onclick="@(() => _marcada = cotizacion.DocumentPublicId)"
                                @ondblclick="@(() => CargarAsync(cotizacion))"
                                @onkeydown="@(e => e.Key == "Enter" ? CargarAsync(cotizacion) : Task.CompletedTask)">
                                <td>@c.Numero</td>
                                <td>@c.OperationDate.ToString("dd/MM/yyyy")</td>
                                <td>@c.CounterpartyName</td>
                                <td>@(c.CreatedByName ?? "—")</td>
                                <td>@(c.SalespersonName ?? "—")</td>
                                <td class="@(vencida ? "texto-alerta" : "")">@(c.Status != TextosDeVentas.EstadoConfirmado ? TextosDeVentas.EstadoDeCotizacion(c.Status, c.ValidUntil, Fecha ?? DateOnly.FromDateTime(DateTime.Today)) : c.ValidUntil is { } hasta ? (vencida ? $"Vencida el {hasta:dd/MM/yyyy} (precios de hoy)" : $"Vigente hasta {hasta:dd/MM/yyyy}") : "—")</td>
                                <td class="numero">@c.Total.ToString("N0")</td>
                                <td><SfButton CssClass="e-primary e-small" Disabled="@(Ocupado || c.Status != TextosDeVentas.EstadoConfirmado)" OnClick="@(() => CargarAsync(cotizacion))">Cargar</SfButton></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <Paginador Pagina="@_pagina" Total="@_total" Tamano="@TamanoDePagina" Cambia="@IrAPaginaAsync" />
        }
    </IndicadorDeCarga>
</div>

@code {
    /// <summary>El <c>id</c> del campo del número: la pantalla lo enfoca al abrir.</summary>
    [Parameter, EditorRequired] public string IdDelNumero { get; set; } = "";

    /// <summary>Lo que se le explica a la persona arriba (qué pasa al cargar en esta pantalla).</summary>
    [Parameter, EditorRequired] public string Explicacion { get; set; } = "";

    /// <summary>El cliente de la venta (su persona): de entrada se listan sólo sus cotizaciones.</summary>
    [Parameter] public Guid? Cliente { get; set; }

    /// <summary>La fecha de la venta, para decir si cada cotización sigue vigente; sin ella, hoy.</summary>
    [Parameter] public DateOnly? Fecha { get; set; }

    /// <summary>La pantalla está cargando una: la zona se vela y «Cargar» se apaga.</summary>
    [Parameter] public bool Ocupado { get; set; }

    /// <summary>La cotización elegida: la carga la pantalla.</summary>
    [Parameter] public EventCallback<ResumenDeVentaDto> Cargar { get; set; }

    private const int TamanoDePagina = 10;

    /// <summary>Sólo se cargan las confirmadas: el buscador no ofrece borradores ni anuladas.</summary>
    private static readonly IReadOnlyList<(string, string)> EstadosDelBuscador =
    [
        (FiltroDeCotizaciones.Confirmada, "Vigentes y vencidas"),
        (FiltroDeCotizaciones.Vigente, "Sólo vigentes"),
        (FiltroDeCotizaciones.Vencida, "Sólo vencidas"),
    ];

    private readonly EstadoDeCarga _carga = new();
    private readonly FiltroDeCotizaciones _filtro = new(FiltroDeCotizaciones.Confirmada);
    private List<ResumenDeVentaDto> _halladas = [];
    private bool _soloElCliente = true;
    private int _pagina = 1;
    private long _total;
    private Guid? _marcada;

    private bool SoloElClienteActivo => Cliente is not null && _soloElCliente;

    protected override Task OnInitializedAsync() => BuscarAsync();

    private Task BuscarDesdeElInicioAsync()
    {
        _pagina = 1;
        return BuscarAsync();
    }

    private Task IrAPaginaAsync(int pagina)
    {
        _pagina = Math.Max(1, pagina);
        return BuscarAsync();
    }

    private async Task BuscarAsync()
    {
        using var carga = _carga.Iniciar();
        // Con número se busca en todas las del cliente o no: el número manda.
        var persona = SoloElClienteActivo && _filtro.Numero is null ? Cliente : null;
        var r = await Ventas.ListarDocumentosAsync(_filtro.ParaLaApi(_pagina, TamanoDePagina, persona));
        _halladas = r.IsSuccess ? [.. r.Value!.Items] : [];
        _total = r.IsSuccess ? r.Value!.TotalCount : 0;
        _marcada = _halladas.Count == 1 ? _halladas[0].DocumentPublicId : _marcada;
        if (!r.IsSuccess) await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudieron consultar las cotizaciones.");
        StateHasChanged();
    }

    private async Task CargarAsync(ResumenDeVentaDto cotizacion)
    {
        if (Ocupado || cotizacion.Status != TextosDeVentas.EstadoConfirmado) return;
        _marcada = cotizacion.DocumentPublicId;
        await Cargar.InvokeAsync(cotizacion);
    }
}
