@* Dialogo de busqueda de cuentas contables *@

<SfDialog Width="600px" IsModal="true" @bind-Visible="Visible" ShowCloseIcon="true"
          Header="Buscar Cuenta Contable" CssClass="search-dialog">
    <DialogTemplates>
        <Content>
            <div class="toolbar" style="margin-bottom: var(--gap-md);">
                <SfTextBox @bind-Value="_search" Placeholder="Buscar por codigo o nombre..."
                           CssClass="e-small" Input="@OnSearchInput" />
            </div>
            <SfGrid DataSource="@_filtered" AllowPaging="true" Height="300">
                <GridPageSettings PageSize="10" />
                <GridEvents RowSelected="@OnRowSelected" TValue="AccountSearchResult" />
                <GridColumns>
                    <GridColumn Field="@nameof(AccountSearchResult.Code)" HeaderText="Codigo" Width="120" />
                    <GridColumn Field="@nameof(AccountSearchResult.Name)" HeaderText="Nombre" Width="300" />
                    <GridColumn Field="@nameof(AccountSearchResult.Nature)" HeaderText="Naturaleza" Width="100" />
                </GridColumns>
            </SfGrid>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancelar" CssClass="e-flat" OnClick="@Close" />
        <DialogButton Content="Seleccionar" IsPrimary="true" CssClass="e-primary"
                      Disabled="@(_selected is null)" OnClick="@Select" />
    </DialogButtons>
</SfDialog>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public EventCallback<AccountSearchResult> OnAccountSelected { get; set; }

    private string? _search;
    private AccountSearchResult? _selected;

    // TODO: Replace with API call
    private List<AccountSearchResult> _accounts =
    [
        new("1105", "Caja General", "Debito"),
        new("1110", "Bancos", "Debito"),
        new("1305", "Cuentas por Cobrar", "Debito"),
        new("2105", "Obligaciones Financieras", "Credito"),
        new("2205", "Proveedores", "Credito"),
        new("3105", "Capital Social", "Credito"),
        new("4105", "Ingresos Operacionales", "Credito"),
        new("5105", "Gastos de Personal", "Debito"),
    ];

    private List<AccountSearchResult> _filtered = [];

    protected override void OnInitialized() => _filtered = _accounts;

    private void OnSearchInput(InputEventArgs args)
    {
        var term = args.Value ?? "";
        _filtered = _accounts.Where(a =>
            a.Code.Contains(term) ||
            a.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
        ).ToList();
    }

    private void OnRowSelected(RowSelectEventArgs<AccountSearchResult> args) => _selected = args.Data;

    private async Task Select()
    {
        if (_selected is not null)
        {
            await OnAccountSelected.InvokeAsync(_selected);
            await Close();
        }
    }

    private async Task Close()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
    }

    public record AccountSearchResult(string Code, string Name, string Nature);
}
