@using IngenIA365ERP.Shared.Services.Http
@using IngenIA365ERP.Shared.Services.Recaudo
@using IngenIA365ERP.Shared.Services.Ventas
@inject SesionesClient Sesiones
@inject WebAuthnInterop Passkeys
@inject INotificationService Notification

@* Feature 015, US2 (T0098; FR-013, FR-030; contracts/api.md §1.4): el aprobador presente decide en el equipo del cajero con SU identidad —su correo, luego
   su llave (webauthn.js) o un código de su autenticador—. Nunca se pide una contraseña. Aprobada, la pantalla repite la operación con la misma clave y
   la solicitud (X-Approval-Request). Molde: AprobacionEnCaja de la 012. (nuevo) *@
<div class="info-card" aria-live="polite">
    <h4>Aprobación de otra persona</h4>
    <p>@Motivo</p>
    <IndicadorDeCarga Cargando="@_decidiendo.Activa" Texto="Verificando…" Compacto="true">
        <div class="form-grid">
            <label class="campo">Correo del aprobador * <input class="e-input" type="email" autocomplete="off" @bind="_correo" /></label>
            @if (_desafio is null)
            {
                <SfButton CssClass="e-primary" Disabled="@string.IsNullOrWhiteSpace(_correo)" OnClick="@PedirDesafioAsync">Continuar</SfButton>
            }
            else
            {
                @if (_desafio.Methods.Contains("Totp"))
                {
                    <label class="campo">Código de su autenticador <input class="e-input" inputmode="numeric" autocomplete="one-time-code" maxlength="8" @bind="_totp" /></label>
                }
                <label class="campo campo-ancho">Motivo (obligatorio para rechazar) <input class="e-input" @bind="_motivo" maxlength="500" /></label>
                <div class="toolbar">
                    @if (_desafio.Methods.Contains("Passkey") && _desafio.PublicKeyOptions is not null)
                    {
                        <SfButton CssClass="e-primary" OnClick="@(() => DecidirAsync("Approve", conPasskey: true))">Aprobar con su llave</SfButton>
                    }
                    @if (_desafio.Methods.Contains("Totp"))
                    {
                        <SfButton CssClass="e-primary" Disabled="@string.IsNullOrWhiteSpace(_totp)" OnClick="@(() => DecidirAsync("Approve", conPasskey: false))">Aprobar con el código</SfButton>
                    }
                    <SfButton CssClass="e-outline" Disabled="@string.IsNullOrWhiteSpace(_motivo)" OnClick="@(() => DecidirAsync("Reject", conPasskey: _desafio.PublicKeyOptions is not null && string.IsNullOrWhiteSpace(_totp)))">Rechazar</SfButton>
                </div>
            }
            <SfButton CssClass="e-flat" OnClick="@(() => Cancelada.InvokeAsync())">Cancelar</SfButton>
        </div>
    </IndicadorDeCarga>
</div>

@code {
    /// <summary>La solicitud que devolvió el 428.</summary>
    [Parameter, EditorRequired] public Guid Solicitud { get; set; }

    /// <summary>La huella de lo que se aprueba (<c>data.contentSha256</c> del 428).</summary>
    [Parameter] public string? Huella { get; set; }

    /// <summary>Lo que se aprueba, en palabras.</summary>
    [Parameter] public string Motivo { get; set; } = string.Empty;

    /// <summary>Aprobada: la pantalla repite la operación con <see cref="Solicitud"/>.</summary>
    [Parameter] public EventCallback<Guid> Aprobada { get; set; }

    [Parameter] public EventCallback Cancelada { get; set; }

    private readonly EstadoDeCarga _decidiendo = new();
    private readonly ClaveDeOperacion _claveDesafio = new(), _claveDecision = new();
    private string? _correo, _totp, _motivo;
    private DesafioDePresenciaDto? _desafio;

    private async Task PedirDesafioAsync()
    {
        if (string.IsNullOrWhiteSpace(_correo)) return;
        using var d = _decidiendo.Iniciar();
        var r = await Sesiones.DesafioDePresenciaAsync(Solicitud, _correo.Trim(), _claveDesafio);
        if (!r.IsSuccess || r.Value is null) { await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo preparar la aprobación en persona."); return; }
        _desafio = r.Value;
    }

    private async Task DecidirAsync(string decision, bool conPasskey)
    {
        if (_desafio is null) return;
        using var d = _decidiendo.Iniciar();
        string? asercion = null;
        if (conPasskey)
        {
            var firma = await Passkeys.FirmarAsync(_desafio.PublicKeyOptions!);
            if (!firma.Ok)
            {
                if (firma.Motivo != MotivosWebAuthn.Cancelado) await Notification.ErrorAsync(firma.Mensaje ?? "No se pudo usar la llave del aprobador.");
                return;
            }
            asercion = firma.RespuestaJson;
        }
        var r = await Sesiones.DecidirEnPersonaAsync(Solicitud, new DecisionEnPersonaRequest(decision, string.IsNullOrWhiteSpace(_motivo) ? null : _motivo.Trim(),
            conPasskey ? "InPersonPasskey" : "InPersonTotp", new PresenciaRequest(_desafio.ChallengePublicId, asercion, conPasskey ? null : _totp?.Trim()), Huella),
            _claveDecision);
        if (!r.IsSuccess)
        {
            await Notification.ErrorAsync(r.ErrorMessage ?? "No se pudo registrar la decisión.");
            if (r.ErrorCode is "Approvals.Presence.Expired" or "Approvals.Presence.TotpReused") _desafio = null;
            return;
        }
        if (decision == "Approve") await Aprobada.InvokeAsync(Solicitud);
        else await Cancelada.InvokeAsync();
    }
}
