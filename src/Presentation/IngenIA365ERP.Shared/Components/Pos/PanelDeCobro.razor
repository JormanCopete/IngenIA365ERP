@using IngenIA365ERP.Shared.Services.Ventas

@* Feature 012, I3 (T639; FR-056, FR-096, FR-097, FR-019; contracts/api.md §22.4): el panel de cobro, usado por el POS y por la factura
   de oficina. La tecla rápida de un medio (o su botón) agrega un pago por lo que falta; se ve lo que falta, lo que sobra y las vueltas.
   Por medio: referencia (el número del bono va aquí), autorización, datáfono (el de la caja, propuesto), lote y los últimos cuatro
   dígitos —nunca el número de la tarjeta—; el crédito pide cuotas, plazo, periodicidad y primer vencimiento (provisional mientras
   Cartera no responda en línea). Las reglas definitivas (bono ya usado, disponibilidad, crédito) las decide el servidor. (nuevo) *@
<div class="pos-cobro">
    <div class="pos-total">
        <div class="pos-renglon"><span>A pagar</span><span class="pos-a-pagar">@Cobro.APagar.ToString("N0")</span></div>
        <div class="pos-renglon"><span>Pagado</span><span>@Cobro.Pagado.ToString("N0")</span></div>
        @if (Cobro.Falta > 0m) { <div class="pos-renglon pos-falta"><span>Falta</span><span>@Cobro.Falta.ToString("N0")</span></div> }
        @if (Cobro.Sobra > 0m) { <div class="pos-renglon pos-falta"><span>Sobra</span><span>@Cobro.Sobra.ToString("N0")</span></div> }
        @if (Cobro.Vueltas > 0m) { <div class="pos-renglon pos-vueltas"><span>Vueltas</span><span>@Cobro.Vueltas.ToString("N0")</span></div> }
    </div>

    <div class="pos-medios" aria-label="Medios de pago">
        @foreach (var m in Medios)
        {
            var medio = m;
            <SfButton CssClass="e-outline" Disabled="@(Cobro.Falta <= 0m)" OnClick="@(() => AgregarAsync(medio))">@(string.IsNullOrWhiteSpace(m.QuickKey) ? "" : $"{m.QuickKey} · ")@m.Name</SfButton>
        }
        @if (Medios.Count == 0)
        {
            <p class="texto-tenue">No hay medios de pago disponibles para este punto, canal, tipo y cliente.</p>
        }
    </div>

    @foreach (var p in Cobro.Pagos)
    {
        var pago = p;
        <div class="pos-pago">
            <div class="fila-campos">
                <b>@p.Medio.Name</b>
                <label class="campo">Valor <input class="e-input numero" type="number" min="0" step="any" value="@Num(p.Monto)" @onchange="@(e => Fijar(() => pago.Monto = Dec(e.Value) ?? 0m))" /></label>
                @if (p.Medio.AllowsChange)
                {
                    <label class="campo">Entregado <input class="e-input numero" type="number" min="0" step="any" value="@Num(p.Entregado)" @onchange="@(e => Fijar(() => pago.Entregado = Dec(e.Value)))" /></label>
                }
                @if (p.Medio.RequiresReference)
                {
                    <label class="campo">@TextosDeVentas.TipoDeReferencia(p.Medio.ReferenceKind) * <input class="e-input" value="@p.Referencia" maxlength="40" @onchange="@(e => Fijar(() => pago.Referencia = e.Value?.ToString()))" /></label>
                }
                @if (TextosDeVentas.EsTarjeta(p.Medio.Class))
                {
                    <label class="campo">Datáfono
                        <select class="e-input" value="@(p.Datafono?.ToString() ?? "")" @onchange="@(e => Fijar(() => pago.Datafono = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null))">
                            <option value="">—</option>
                            @foreach (var d in p.Medio.CardTerminals) { <option value="@d.PublicId">@d.Code</option> }
                        </select>
                    </label>
                    <label class="campo">Autorización <input class="e-input" value="@p.Autorizacion" maxlength="20" @onchange="@(e => Fijar(() => pago.Autorizacion = e.Value?.ToString()))" /></label>
                    <label class="campo">Lote <input class="e-input" value="@p.Lote" maxlength="20" @onchange="@(e => Fijar(() => pago.Lote = e.Value?.ToString()))" /></label>
                    <label class="campo">Últimos 4 <input class="e-input" inputmode="numeric" autocomplete="off" maxlength="4" pattern="[0-9]{4}" value="@p.Last4" @onchange="@(e => Fijar(() => pago.Last4 = e.Value?.ToString()))" /></label>
                }
                @if (TextosDeVentas.EsCredito(p.Medio.Class))
                {
                    <label class="campo">Cuotas <input class="e-input numero" type="number" min="1" value="@p.Cuotas" @onchange="@(e => Fijar(() => pago.Cuotas = Corto(e.Value)))" /></label>
                    <label class="campo">Plazo (días) <input class="e-input numero" type="number" min="1" value="@p.PlazoDias" @onchange="@(e => Fijar(() => pago.PlazoDias = Corto(e.Value)))" /></label>
                    <label class="campo">Periodicidad (días) <input class="e-input numero" type="number" min="1" value="@p.PeriodicidadDias" @onchange="@(e => Fijar(() => pago.PeriodicidadDias = Corto(e.Value)))" /></label>
                    <label class="campo">Primer vencimiento <input type="date" class="e-input" value="@(p.PrimerVencimiento?.ToString("yyyy-MM-dd"))" @onchange="@(e => Fijar(() => pago.PrimerVencimiento = DateOnly.TryParse(e.Value?.ToString(), System.Globalization.CultureInfo.InvariantCulture, out var f) ? f : null))" /></label>
                }
                <SfButton CssClass="e-flat" IconCss="e-icons e-delete" title="Quitar el pago" OnClick="@(() => QuitarAsync(pago))" />
            </div>
        </div>
    }

    @if (Cobro.Pagos.Count > 0 && Cobro.Problema() is { } problema)
    {
        <p class="aviso aviso-alerta">@problema</p>
    }
</div>

@code {
    [Parameter, EditorRequired] public CobroDelPos Cobro { get; set; } = new(0m);

    [Parameter, EditorRequired] public IReadOnlyList<MedioDelPosDto> Medios { get; set; } = [];

    /// <summary>Avisa a la pantalla que cambió algo del cobro (para repintar su total y su botón).</summary>
    [Parameter] public EventCallback Cambio { get; set; }

    /// <summary>La tecla rápida de un medio: agrega un pago por lo que falta. Devuelve si la tecla era de un medio.</summary>
    public async Task<bool> TeclaRapidaAsync(string tecla)
    {
        var medio = Medios.FirstOrDefault(m => string.Equals(m.QuickKey, tecla, StringComparison.OrdinalIgnoreCase));
        if (medio is null) return false;
        await AgregarAsync(medio);
        return true;
    }

    private async Task AgregarAsync(MedioDelPosDto medio)
    {
        Cobro.AgregarPorLoQueFalta(medio);
        await Cambio.InvokeAsync();
    }

    private async Task QuitarAsync(PagoEnCobro pago)
    {
        Cobro.Quitar(pago);
        await Cambio.InvokeAsync();
    }

    private Task Fijar(System.Action accion)
    {
        accion();
        return Cambio.InvokeAsync();
    }

    private static string Num(decimal? v) => v?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "";

    private static decimal? Dec(object? v) =>
        decimal.TryParse(v?.ToString(), System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var d) ? d : null;

    private static short? Corto(object? v) => short.TryParse(v?.ToString(), out var s) ? s : null;
}
