<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.8" />
    <!-- Solo Core (AddSyncfusionBlazor y la licencia): los componentes llegan por IngenIA365ERP.Shared. -->
    <PackageReference Include="Syncfusion.Blazor.Core" Version="33.2.8" />
    <PackageReference Include="Syncfusion.Blazor.Themes" Version="33.2.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IngenIA365ERP.Shared\IngenIA365ERP.Shared.csproj" />
  </ItemGroup>

</Project>
