@using IngenIA365ERP.Shared.Configuration
@using Microsoft.JSInterop
@inject HttpClient Http
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="attachment-list">
    @if (_loading)
    {
        <p>Cargando adjuntos…</p>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <p class="error">@_error</p>
    }
    else if (_items.Count == 0)
    {
        <p class="muted">Sin adjuntos.</p>
    }
    else
    {
        <table class="data-grid">
            <thead>
                <tr><th>Archivo</th><th>Tipo</th><th>Tamaño</th><th>Subido</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var a in _items)
                {
                    <tr>
                        <td>@a.FileName</td>
                        <td>@a.ContentType</td>
                        <td>@FormatBytes(a.SizeBytes)</td>
                        <td>@a.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <button @onclick="() => DownloadAsync(a)">Descargar</button>
                            <button @onclick="() => DeleteAsync(a)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    [Parameter, EditorRequired] public string OwnerEntityType { get; set; } = string.Empty;
    [Parameter, EditorRequired] public Guid OwnerEntityPublicId { get; set; }

    private bool _loading;
    private string _error = string.Empty;
    private List<AttachmentDto> _items = new();
    private IJSObjectReference? _downloadModule;

    protected override Task OnInitializedAsync() => RefreshAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Reusa el helper de descarga creado en T092 (consola de audit).
            _downloadModule = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./audit-console.js");
        }
    }

    /// <summary>Recarga la lista — llamable desde el padre tras un upload.</summary>
    public async Task RefreshAsync()
    {
        _loading = true; _error = string.Empty;
        try
        {
            var url = $"{AppSettings.GetApiBaseUrl()}/api/attachments/by-owner" +
                      $"?ownerEntityType={Uri.EscapeDataString(OwnerEntityType)}" +
                      $"&ownerEntityPublicId={OwnerEntityPublicId}";
            var resp = await Http.GetAsync(url);
            if (!resp.IsSuccessStatusCode)
            {
                _error = $"Error {(int)resp.StatusCode}";
                return;
            }
            _items = await resp.Content.ReadFromJsonAsync<List<AttachmentDto>>() ?? new();
        }
        catch (Exception ex)
        {
            _error = $"Error de red: {ex.Message}";
        }
        finally { _loading = false; }
    }

    private async Task DownloadAsync(AttachmentDto a)
    {
        if (_downloadModule is null) return;
        try
        {
            var url = $"{AppSettings.GetApiBaseUrl()}/api/attachments/{a.PublicId}";
            using var resp = await Http.GetAsync(url, HttpCompletionOption.ResponseHeadersRead);
            if (!resp.IsSuccessStatusCode)
            {
                _error = $"Error descargando: {(int)resp.StatusCode}";
                return;
            }
            using var stream = await resp.Content.ReadAsStreamAsync();
            using var streamRef = new DotNetStreamReference(stream, leaveOpen: false);
            await _downloadModule.InvokeVoidAsync(
                "downloadFromStream", a.FileName, a.ContentType, streamRef);
        }
        catch (Exception ex)
        {
            _error = $"Error: {ex.Message}";
        }
    }

    private async Task DeleteAsync(AttachmentDto a)
    {
        var url = $"{AppSettings.GetApiBaseUrl()}/api/attachments/{a.PublicId}";
        var resp = await Http.DeleteAsync(url);
        if (!resp.IsSuccessStatusCode)
        {
            _error = $"Error eliminando: {(int)resp.StatusCode}";
            return;
        }
        await RefreshAsync();
    }

    private static string FormatBytes(long bytes)
    {
        string[] suffixes = ["B", "KB", "MB", "GB"];
        double value = bytes;
        var i = 0;
        while (value >= 1024 && i < suffixes.Length - 1) { value /= 1024; i++; }
        return $"{value:N1} {suffixes[i]}";
    }

    public async ValueTask DisposeAsync()
    {
        if (_downloadModule is not null)
        {
            try { await _downloadModule.DisposeAsync(); }
            catch (JSDisconnectedException) { /* navigation away */ }
        }
    }

    public sealed record AttachmentDto(
        Guid PublicId, string OwnerEntityType, Guid OwnerEntityPublicId,
        string FileName, string ContentType, long SizeBytes, string Sha256Hex,
        DateTime CreatedAt, string? CreatedBy);
}
