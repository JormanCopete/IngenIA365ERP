@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthState

@if (_allowed)
{
    @ChildContent
}
else if (Fallback is not null)
{
    @Fallback
}

@code {
    /// <summary>
    /// Permiso requerido en formato <c>Resource.Action</c> (ej. <c>Security.Users.Create</c>).
    /// Si el JWT del usuario actual contiene un claim <c>perm</c> con ese valor,
    /// se renderiza <see cref="ChildContent"/>. En caso contrario se oculta o se
    /// muestra <see cref="Fallback"/> si fue provisto. (FR-018)
    /// </summary>
    [Parameter, EditorRequired] public string Required { get; set; } = string.Empty;

    /// <summary>Lista alternativa: el usuario necesita AL MENOS UNO de estos.</summary>
    [Parameter] public IEnumerable<string>? AnyOf { get; set; }

    /// <summary>Contenido a renderizar cuando el usuario tiene el permiso.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Contenido a renderizar cuando NO tiene el permiso (opcional).</summary>
    [Parameter] public RenderFragment? Fallback { get; set; }

    private bool _allowed;

    protected override async Task OnParametersSetAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var user = state.User;

        if (!user.Identity?.IsAuthenticated ?? true)
        {
            _allowed = false;
            return;
        }

        if (!string.IsNullOrWhiteSpace(Required))
        {
            _allowed = HasPerm(user, Required);
            if (_allowed) return;
        }

        if (AnyOf is not null)
        {
            _allowed = AnyOf.Any(p => HasPerm(user, p));
            return;
        }

        _allowed = string.IsNullOrWhiteSpace(Required);
    }

    private static bool HasPerm(System.Security.Claims.ClaimsPrincipal user, string code) =>
        user.HasClaim(c => c.Type == "perm" && string.Equals(c.Value, code, StringComparison.Ordinal));
}
