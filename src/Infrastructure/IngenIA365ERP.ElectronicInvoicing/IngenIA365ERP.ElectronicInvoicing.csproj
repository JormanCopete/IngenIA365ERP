<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Feature 012, entrega I4 (T688; plan.md, decisiones-transversales §1.1): los adaptadores del puerto
    ICanalDeEmisionElectronica (CanalSimulado, el del proveedor tecnológico y CanalServicioCentral), las
    credenciales en archivo, el procesador de fondo y el circuito por canal. Referencia sólo Application:
    Domain y Application no lo conocen (ElProveedorTecnologicoSoloLoConoceSuAdaptador) y la API lo toca sólo
    desde Program.cs con AddElectronicInvoicing.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>IngenIA365ERP.ElectronicInvoicing</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.*" />
    <!-- Consulta y descarga contra el canal (reintentos y tiempos del transporte, no de la emisión). -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Core\IngenIA365ERP.Application\IngenIA365ERP.Application.csproj" />
  </ItemGroup>
</Project>
