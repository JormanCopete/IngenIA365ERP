<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>IngenIA365ERP.Identity</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Microsoft.AspNetCore.Identity (abstracciones) viene transitivamente con
         Microsoft.AspNetCore.Identity.EntityFrameworkCore. En .NET 10 no existe un
         paquete standalone "Microsoft.AspNetCore.Identity" 10.x; sus tipos
         pertenecen a Microsoft.Extensions.Identity.Core / .Stores cargados como
         dependencias transitivas. -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.*" />
    <!-- Feature 004: Identity ya no conoce el proveedor de BD — el paquete
         Microsoft.EntityFrameworkCore.SqlServer se retiro; el motor lo decide
         Persistence/Providers/IDbProviderConfigurator. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.*" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.*" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.*" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.*" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="10.0.*" />
    <PackageReference Include="Otp.NET" Version="1.4.*" />
    <PackageReference Include="QRCoder" Version="1.6.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Core\IngenIA365ERP.Application\IngenIA365ERP.Application.csproj" />
    <ProjectReference Include="..\IngenIA365ERP.Storage\IngenIA365ERP.Storage.csproj" />
    <!-- Feature 002 (Chunk C.3) — Identity necesita CentralUserIdentity (bridge
         IdentityUser<Guid>) que vive en Persistence (donde AdminDbContext lo persiste).
         No crea ciclo: Persistence no referencia Identity. -->
    <ProjectReference Include="..\IngenIA365ERP.Persistence\IngenIA365ERP.Persistence.csproj" />
  </ItemGroup>
</Project>
