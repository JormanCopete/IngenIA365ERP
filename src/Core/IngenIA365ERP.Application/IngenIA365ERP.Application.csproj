<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>IngenIA365ERP.Application</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MediatR" Version="14.1.0" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageReference Include="Mapster" Version="10.*" />
    <PackageReference Include="Mapster.DependencyInjection" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\IngenIA365ERP.Domain\IngenIA365ERP.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="IngenIA365ERP.Application.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Feature 010 (US5): el layout de la PILA es dato versionado embebido, como la semilla del PUC. -->
    <EmbeddedResource Include="Payroll\Pila\Layouts\*.json" />
    <!-- Feature 012 (T180): los catálogos DIAN son datos versionados por vigencia, no tablas (CatalogoDian). -->
    <EmbeddedResource Include="ElectronicInvoicing\Catalogs\Data\*.json" />
    <!-- Feature 013, K5 (T0998): los layouts del SICSES y de las centrales de riesgo son dato versionado embebido (CatalogoDeLayoutsDeCartera). -->
    <EmbeddedResource Include="Lending\Regulatory\Layouts\*.json" />
    <!-- Feature 014, US8 (T144): las cuentas CUIF que la plantilla de la matriz sugiere para captaciones y aportes son dato embebido, no código. -->
    <EmbeddedResource Include="Accounting\Lending\Plantilla\*.json" />
  </ItemGroup>

</Project>
