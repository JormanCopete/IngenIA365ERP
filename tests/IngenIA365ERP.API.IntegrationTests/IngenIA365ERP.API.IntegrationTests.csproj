<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.*" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.*" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.*" />
    <PackageReference Include="Testcontainers.MongoDb" Version="4.*" />
    <PackageReference Include="Testcontainers.Redis" Version="4.*" />
    <!-- Feature 011: almacén compatible con S3 para probar POST y GET prefirmados de verdad. -->
    <PackageReference Include="Testcontainers.Minio" Version="4.*" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.*" />
    <!-- 2026-09-22: el almacén S3 de adjuntos se prueba con un IAmazonS3 falso; el CI no tiene credenciales ni las necesita. -->
    <PackageReference Include="NSubstitute" Version="5.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Presentation\IngenIA365ERP.API\IngenIA365ERP.API.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Limita cuantas clases de prueba corren a la vez. NO es una preferencia de
      estilo: cada clase con fixture levanta TRES contenedores (base de datos,
      Mongo y Redis), y hay 25 clases asi. Sin tope, la maquina intenta arrancar
      hasta 75 contenedores en paralelo y los hosts empiezan a caerse durante el
      arranque.

      Lo peor es el sintoma: el fallo llega como ObjectDisposedException sobre
      IServiceProvider en WebApplicationFactory.StartServer, que no dice ni una
      palabra de contenedores. Se vieron 44 pruebas rojas de golpe que pasaban
      todas en aislamiento; diagnosticar eso desde el mensaje cuesta horas.
    -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
