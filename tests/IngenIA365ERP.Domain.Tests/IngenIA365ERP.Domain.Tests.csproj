<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
    <PackageReference Include="NSubstitute" Version="5.*" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Payroll\Calculation\Casos\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Feature 010: casos dorados de las liquidaciones especiales y sus parametros 2026 (datos, no programa). -->
    <None Include="Payroll\Settlements\Casos\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Payroll\Settlements\Parametros\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Payroll\Pila\Casos\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Payroll\Pila\Casos\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Payroll\Withholding\Casos\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Feature 012 (T010): casos dorados del motor de aprobaciones. -->
    <None Include="Approvals\Casos\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Feature 012 (T097): casos dorados del motor tributario, calculados a mano. -->
    <None Include="Taxes\Casos\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Feature 012 (T268-T271): casos dorados del motor de costeo, calculados a mano (SC-007). -->
    <None Include="Inventory\Costing\Casos\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Feature 012 (T382): casos de la comparación de un conteo físico, calculados a mano. -->
    <None Include="Inventory\Counts\Casos\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Feature 012 (T942): casos de la reposición (posición, reorden, sugerido y quiebre), calculados a mano. -->
    <None Include="Inventory\Replenishment\Casos\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Feature 012, I3 (T546, T547): casos dorados de precios y de caja, calculados a mano. -->
    <None Include="Sales\Pricing\Casos\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Sales\Cash\Casos\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Feature 012, I5 (T766, T767): casos del cruce a tres vías y del reparto de costos adicionales, calculados a mano. -->
    <None Include="Inventory\Purchasing\Casos\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Inventory\Costing\Prorrateo\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\IngenIA365ERP.Domain\IngenIA365ERP.Domain.csproj" />
    <!-- Feature 005: los casos dorados del motor usan el MISMO catalogo de conceptos y
         parametros que siembra la cooperativa (PayrollConceptDefinitionsSeeder,
         PayrollLegalParametersSeeder). Solo se toman los catalogos estaticos; ningun
         test toca EF ni una base. -->
    <ProjectReference Include="..\..\src\Infrastructure\IngenIA365ERP.Persistence\IngenIA365ERP.Persistence.csproj" />
  </ItemGroup>
</Project>
