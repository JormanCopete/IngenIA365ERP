<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
    <PackageReference Include="NSubstitute" Version="5.*" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Payroll\Calculation\Casos\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Feature 010: casos dorados de las liquidaciones especiales y sus parametros 2026 (datos, no programa). -->
    <None Include="Payroll\Settlements\Casos\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Payroll\Settlements\Parametros\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Payroll\Pila\Casos\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Payroll\Pila\Casos\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Payroll\Withholding\Casos\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Feature 012 (T010): casos dorados del motor de aprobaciones. -->
    <None Include="Approvals\Casos\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Feature 012 (T097): casos dorados del motor tributario, calculados a mano. -->
    <None Include="Taxes\Casos\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Feature 012 (T268-T271): casos dorados del motor de costeo, calculados a mano (SC-007). -->
    <None Include="Inventory\Costing\Casos\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Feature 012 (T382): casos de la comparación de un conteo físico, calculados a mano. -->
    <None Include="Inventory\Counts\Casos\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Feature 012 (T942): casos de la reposición (posición, reorden, sugerido y quiebre), calculados a mano. -->
    <None Include="Inventory\Replenishment\Casos\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Feature 012, I3 (T546, T547): casos dorados de precios y de caja, calculados a mano. -->
    <None Include="Sales\Pricing\Casos\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Sales\Cash\Casos\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Feature 012, I6 (T862): casos dorados de promociones, calculados a mano. -->
    <None Include="Sales\Promotions\Casos\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Feature 012, I5 (T766, T767): casos del cruce a tres vías y del reparto de costos adicionales, calculados a mano. -->
    <None Include="Inventory\Purchasing\Casos\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Inventory\Costing\Prorrateo\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Feature 012, I6 (T943): casos dorados de la rotación y los días de inventario, calculados a mano. -->
    <None Include="Inventory\Analytics\Casos\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Feature 013 (T0021): documentos normativos de prueba para los lectores tipados de valores nacionales. -->
    <None Include="Common\NationalValues\Documentos\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Feature 013, K5 (T0987): casos del motor generico de layouts (ancho fijo, delimitado, bloqueantes), derivados a mano. -->
    <None Include="Common\Layouts\Casos\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Feature 013, US17 (T0240, T0241, T0269): casos dorados de la votacion, las atribuciones y la ventana legal de contacto,
         calculados a mano. -->
    <None Include="Lending\Sessions\Casos\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Lending\Attributions\Casos\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Lending\Collections\Casos\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Feature 013, US1 (T0330, T0331): casos dorados del motor financiero (plan, tasas y usura), calculados con la hoja
         Lending\Casos\calcular.py (decimal de 40 digitos), que se versiona junto a ellos. -->
    <None Include="Lending\Casos\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Feature 013, US2 (T0364): casos dorados del puntaje, calculados a mano con la hoja Lending\Scoring\Casos\puntaje.py. -->
    <None Include="Lending\Scoring\Casos\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Feature 013, US9 (T0672): casos dorados de riesgo, calculados a mano y repasados con la hoja Lending\Risk\Casos\riesgo.py
         (decimal de 40 digitos), sobre las normas de prueba de Lending\Risk\Normas. -->
    <None Include="Lending\Risk\Casos\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Lending\Risk\Normas\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Feature 013, K2 (T0803): casos dorados de las novedades de libranza, calculados con la hoja Lending\Payroll\Casos\novedades.py. -->
    <None Include="Lending\Payroll\Casos\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\IngenIA365ERP.Domain\IngenIA365ERP.Domain.csproj" />
    <!-- Feature 005: los casos dorados del motor usan el MISMO catalogo de conceptos y
         parametros que siembra la cooperativa (PayrollConceptDefinitionsSeeder,
         PayrollLegalParametersSeeder). Solo se toman los catalogos estaticos; ningun
         test toca EF ni una base. -->
    <ProjectReference Include="..\..\src\Infrastructure\IngenIA365ERP.Persistence\IngenIA365ERP.Persistence.csproj" />
  </ItemGroup>
</Project>
