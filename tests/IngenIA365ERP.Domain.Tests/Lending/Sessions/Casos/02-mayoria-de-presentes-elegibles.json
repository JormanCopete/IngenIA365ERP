// Mayoría ordinaria de la semilla F7: más de la mitad de los presentes elegibles. La abstención no suma a favor:
// con 4 presentes hacen falta 4 / 2 + 1 = 3 votos a favor, y dos a favor con dos abstenciones no alcanzan.
{
  "nombre": "02-mayoria-de-presentes-elegibles",
  "descripcion": "Mayoría MoreThan 1/2 de los presentes elegibles; la abstención no cuenta a favor.",
  "regla": {
    "quorum": { "numerador": 1, "denominador": 2, "comparacion": "MoreThan" },
    "mayoria": { "numerador": 1, "denominador": 2, "comparacion": "MoreThan", "base": "PresentEligible" },
    "vinculados": { "numerador": 4, "denominador": 5 }
  },
  "miembros": [
    { "persona": 101 }, { "persona": 102 }, { "persona": 103 }, { "persona": 104 }, { "persona": 105 }
  ],
  "escenarios": [
    {
      "nombre": "dos a favor y dos abstenciones",
      "presentes": [101, 102, 103, 104],
      "punto": {
        "votos": [
          { "voto": 1, "persona": 101, "valor": "For" },
          { "voto": 2, "persona": 102, "valor": "For" },
          { "voto": 3, "persona": 103, "valor": "Abstain" },
          { "voto": 4, "persona": 104, "valor": "Abstain" }
        ]
      },
      // 2 × 2 = 4 ≤ 1 × 4 = 4 → no aprobado.
      "esperado": {
        "quorum": { "cumple": true, "composicion": 5, "requerido": 3, "presentesElegibles": 4 },
        "elegibles": 4, "base": 4, "requeridos": 3,
        "aFavor": 2, "enContra": 0, "abstenciones": 2,
        "resultado": "NoAprobado",
        "explicacionContiene": ["2 × 2 = 4 ≤ 1 × 4 = 4"]
      }
    },
    {
      "nombre": "tres a favor y una abstención",
      "presentes": [101, 102, 103, 104],
      "punto": {
        "votos": [
          { "voto": 1, "persona": 101, "valor": "For" },
          { "voto": 2, "persona": 102, "valor": "For" },
          { "voto": 3, "persona": 103, "valor": "For" },
          { "voto": 4, "persona": 104, "valor": "Abstain" }
        ]
      },
      // 3 × 2 = 6 > 1 × 4 = 4 → aprobado.
      "esperado": {
        "quorum": { "cumple": true, "composicion": 5, "requerido": 3, "presentesElegibles": 4 },
        "elegibles": 4, "base": 4, "requeridos": 3,
        "aFavor": 3, "enContra": 0, "abstenciones": 1,
        "resultado": "Aprobado"
      }
    }
  ]
}
