// F7: el principal 101 vino, y también su suplente 201. Sólo vota el principal: el voto del suplente se rechaza y el
// suplente no cuenta para el quórum ni para la base. Sentados: 101, 102, 103 = 3; 3 × 2 = 6 > 5 → quórum.
// Mayoría: 3 / 2 + 1 = 2; a favor sólo 102 → no aprobado (con el voto del suplente habrían sido 2).
{
  "nombre": "06-suplente-con-principal-presente",
  "descripcion": "Con el principal presente, el suplente no vota.",
  "regla": {
    "quorum": { "numerador": 1, "denominador": 2, "comparacion": "MoreThan" },
    "mayoria": { "numerador": 1, "denominador": 2, "comparacion": "MoreThan", "base": "PresentEligible" },
    "vinculados": { "numerador": 4, "denominador": 5 }
  },
  "miembros": [
    { "persona": 101 }, { "persona": 102 }, { "persona": 103 }, { "persona": 104 }, { "persona": 105 },
    { "persona": 201, "principal": false, "suplenteDe": 101 }
  ],
  "escenarios": [
    {
      "nombre": "principal y suplente presentes",
      "presentes": [101, 102, 103, 201],
      "punto": {
        "votos": [
          { "voto": 1, "persona": 101, "valor": "Against" },
          { "voto": 2, "persona": 201, "valor": "For" },
          { "voto": 3, "persona": 102, "valor": "For" },
          { "voto": 4, "persona": 103, "valor": "Against" }
        ]
      },
      // 1 × 2 = 2 ≤ 1 × 3 = 3 → no aprobado.
      "esperado": {
        "quorum": { "cumple": true, "composicion": 5, "requerido": 3, "presentesElegibles": 3 },
        "elegibles": 3, "base": 3, "requeridos": 2,
        "aFavor": 1, "enContra": 2, "abstenciones": 0,
        "resultado": "NoAprobado",
        "rechazados": [ { "persona": 201, "motivo": "SuplenteConPrincipalPresente" } ]
      }
    }
  ]
}
