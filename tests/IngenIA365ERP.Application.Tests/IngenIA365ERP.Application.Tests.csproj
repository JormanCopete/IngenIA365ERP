<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
    <PackageReference Include="NSubstitute" Version="5.*" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.*" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.*" />
  </ItemGroup>
  <ItemGroup>
    <!-- Feature 010: calendarios de festivos esperados (Ley 51 de 1983) que lee FestivosLey51Tests. -->
    <None Include="Infrastructure\Festivos\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Feature 010 (US8): el formato ficticio de ancho fijo de contracts/archivos.md §2.2 que FlatFileWriterTests compara byte a byte. -->
    <None Include="Payroll\Dispersion\Formatos\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Feature 012 (T011): casos dorados del sello de integridad de la auditoria, calculados fuera de .NET. -->
    <None Include="Infrastructure\Audit\Casos\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Feature 012 (T014): los cuatro ejemplos de contracts/mensajes.md §14 en su forma compacta, comparados byte a byte. -->
    <None Include="Common\Integration\Casos\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Feature 012, T332: facturas del proveedor de muestra (UBL 2.1, AttachedDocument, nota crédito) para LectorDeFacturaUblTests. -->
    <None Include="Inventory\Purchasing\Muestras\*.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\IngenIA365ERP.Application\IngenIA365ERP.Application.csproj" />
    <ProjectReference Include="..\..\src\Core\IngenIA365ERP.Domain\IngenIA365ERP.Domain.csproj" />
    <!-- Feature 004: tests unitarios de piezas de infraestructura pura
         (DatabaseOptions, masker, orquestador de seeds). Solo en tests —
         Application (src) sigue sin referenciar Persistence. -->
    <ProjectReference Include="..\..\src\Infrastructure\IngenIA365ERP.Persistence\IngenIA365ERP.Persistence.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure\IngenIA365ERP.Storage\IngenIA365ERP.Storage.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure\IngenIA365ERP.Identity\IngenIA365ERP.Identity.csproj" />
    <!-- Para probar la forma del documento de auditoria (AuditDocumentSchema) sin
         levantar MongoDB: es una funcion pura BsonDocument <-> AuditLogEntry. -->
    <ProjectReference Include="..\..\src\Infrastructure\IngenIA365ERP.Audit\IngenIA365ERP.Audit.csproj" />
  </ItemGroup>
</Project>
