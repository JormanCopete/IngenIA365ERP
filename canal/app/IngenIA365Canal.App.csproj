<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Feature 021, US11 (T135; research R14): la app de tiendas del canal del asociado. Una sola app para Android e iOS que trae el
    build de React (canal/web, modo «app») en Resources/Raw/wwwroot y lo muestra en un HybridWebView; el puente C# da biometría,
    almacenamiento seguro, la pasarela en el navegador del sistema, push y guardar documentos. Es otra app que la de funcionarios
    (src/Presentation/IngenIA365ERP.App): otro ApplicationId y otra firma.

    Propiedades por ambiente (nunca secretos en el repositorio):
      CanalHost          el host público del canal (App Links / Universal Links y la API); por defecto el de producción.
      CanalConFirebase   true para compilar con FCM (Plugin.Firebase); exige google-services.json y GoogleService-Info.plist en
                         Platforms/, que git ignora. Sin él, la app no registra push y los avisos llegan por correo.
    La firma de Android e iOS se hace fuera del CI público: docs/operaciones/canal-digital-app-tiendas.md.
  -->

  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>IngenIA365Canal.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <ApplicationTitle>Canal del asociado</ApplicationTitle>
    <ApplicationId>com.ingenia365.canal</ApplicationId>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>

    <CanalHost Condition="'$(CanalHost)' == ''">asociados.ingenia365.com</CanalHost>
    <CanalConFirebase Condition="'$(CanalConFirebase)' == ''">false</CanalConFirebase>
    <DefineConstants Condition="'$(CanalConFirebase)' == 'true'">$(DefineConstants);CANAL_FIREBASE</DefineConstants>

  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#1F4E79" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1F4E79" BaseSize="128,128" />
    <!-- El build de React (canal/scripts/empaquetar-app.sh lo copia aquí; git ignora el contenido). -->
    <MauiAsset Include="Resources\Raw\wwwroot\**" LogicalName="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.70" />
  </ItemGroup>

  <ItemGroup Condition="'$(CanalConFirebase)' == 'true'">
    <PackageReference Include="Plugin.Firebase.CloudMessaging" Version="3.1.4" />
    <GoogleServicesJson Include="Platforms\Android\google-services.json" Condition="$(TargetFramework.Contains('-android'))" />
    <BundleResource Include="Platforms\iOS\GoogleService-Info.plist" Link="GoogleService-Info.plist" Condition="$(TargetFramework.Contains('-ios'))" />
  </ItemGroup>

  <!-- El host del canal como constante: los atributos de App Links lo necesitan en tiempo de compilación. -->
  <Target Name="GenerarConfiguracionDelCanal" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <ArchivoDeConfiguracion>$(IntermediateOutputPath)ConfiguracionDelCanal.g.cs</ArchivoDeConfiguracion>
    </PropertyGroup>
    <WriteLinesToFile File="$(ArchivoDeConfiguracion)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="namespace IngenIA365Canal.App%3B;/// &lt;summary&gt;Generado desde la propiedad CanalHost del proyecto.&lt;/summary&gt;;public static partial class ConfiguracionDelCanal { public const string Host = &quot;$(CanalHost)&quot;%3B }" />
    <ItemGroup>
      <Compile Include="$(ArchivoDeConfiguracion)" />
      <FileWrites Include="$(ArchivoDeConfiguracion)" />
    </ItemGroup>
  </Target>

</Project>
