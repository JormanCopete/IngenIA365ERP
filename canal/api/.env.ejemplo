# Configuración del canal digital para desarrollo local. Copiar a canal/api/.env (que git ignora) y ajustar.
# Ningún valor real va en este archivo: las llaves las genera canal/scripts/llaves-dev.sh fuera del repositorio.

CANAL_DIRECCION=:8080
# PostgreSQL de canal/docker-compose.yml (puerto 5434).
CANAL_BASE_URL=postgres://canal:canal-solo-desarrollo@localhost:5434/ingenia365_canal?sslmode=disable
# Sólo el host (sin esquema): con localhost el retorno de la pasarela simulada va por http.
CANAL_HOST_PUBLICO=localhost:8080
# API del ERP en local (la que expone /api/canal/v1).
CANAL_ERP_URL=http://localhost:5000

# Tokens de servicio (research R2). Rutas a los PEM que deja llaves-dev.sh en $HOME/.ingenia365/canal-dev/.
CANAL_LLAVE_PRIVADA_FILE=/ruta/a/canal-privada.pem
CANAL_LLAVE_KID=dev1
CANAL_ERP_LLAVE_PUBLICA_FILE=/ruta/a/erp-publica.pem

# Llave de cifrado de llaves (KEK) para los secretos de pasarela, por versión (R10).
CANAL_KEK_V1_FILE=/ruta/a/kek-v1.b64
CANAL_KEK_ACTIVA=1

# Pasarela: simulada en desarrollo. Las credenciales de una pasarela real se cargan por la pantalla del ERP.
CANAL_PASARELA=simulada
CANAL_NIVEL_LOG=info

# Correo (opcional hasta C1).
# CANAL_SMTP_HOST=
# CANAL_SMTP_PUERTO=587
# CANAL_SMTP_USUARIO=
# CANAL_SMTP_CLAVE=
# CANAL_SMTP_REMITENTE=

# Frecuencias y límites (valores por defecto).
# CANAL_FRECUENCIA_COOPERATIVAS=5m
# CANAL_FRECUENCIA_HABILITACIONES=60s
# CANAL_FRECUENCIA_PENDIENTES=15m
# CANAL_FRECUENCIA_PURGA_TOKENS=10m
# CANAL_LIMITE_IP_POR_MINUTO=300
# CANAL_LIMITE_IP_RAFAGA=60

# Avisos por notificación (US10). Sin estas variables los avisos salen sólo por correo (en desarrollo, a la consola).
# Web Push para la PWA instalada: el escalar de P-256 en base64url (32 bytes) y el contacto de quien opera el canal.
# CANAL_VAPID_PRIVADA=
# CANAL_VAPID_SUJETO=mailto:soporte@ejemplo.test
# FCM para la app de tiendas: ruta al JSON de la cuenta de servicio de Firebase (fuera del repositorio).
# CANAL_FCM_CUENTA_DE_SERVICIO=

# App de tiendas (US11): la identidad firmada de la app, para /.well-known/assetlinks.json y apple-app-site-association.
# Sin estas variables esos archivos responden 404 y los enlaces abren el navegador.
# CANAL_ANDROID_PAQUETE=com.ingenia365.canal
# CANAL_ANDROID_HUELLAS=AA:BB:...  (SHA-256 del certificado con que Google Play firma; varias separadas por coma)
# CANAL_IOS_APP_ID=TEAMID.com.ingenia365.canal
