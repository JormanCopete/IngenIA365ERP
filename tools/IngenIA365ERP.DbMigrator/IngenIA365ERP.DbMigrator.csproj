<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <!-- Publicacion para el contenedor (ci.yml pasa -p:ContainerPublish=true): ReadyToRun
       precompila el IL a codigo nativo de linux-x64, asi el arranque del pod y la primera
       peticion de cada endpoint tras un despliegue no pagan el JIT completo (en produccion
       el Job PreSync de migraciones tambien paga ese arranque). Condicionado para que dotnet run
       y dotnet test en la maquina de desarrollo no cambien. Framework-dependent: la imagen
       base aspnet:10.0 trae el runtime.
       2026-11-09: ReadyToRun APAGADO por ahora en el migrador. Con la 022 el publish del CI agotaba
       la memoria del runner de GitHub (MSB4166 a la hora, o 3 h 20 min sobre swap); el migrador corre
       una vez por despliegue y no necesita arranque rapido. Pendiente de una solucion de fondo. -->
  <PropertyGroup Condition="'$(ContainerPublish)' == 'true'">
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.*" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Infrastructure\IngenIA365ERP.Persistence\IngenIA365ERP.Persistence.csproj" />
    <!-- Feature 004: la CLI aplica migraciones y genera scripts — necesita
         ambos arboles de proveedor en runtime. -->
    <ProjectReference Include="..\..\src\Infrastructure\IngenIA365ERP.Persistence.Migrations.SqlServer\IngenIA365ERP.Persistence.Migrations.SqlServer.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure\IngenIA365ERP.Persistence.Migrations.PostgreSql\IngenIA365ERP.Persistence.Migrations.PostgreSql.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure\IngenIA365ERP.Audit\IngenIA365ERP.Audit.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.*" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="9.*" />
  </ItemGroup>
</Project>
