{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Objetos",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::ingenia365-erp-attachments/*"
    },
    {
      "Sid": "NiListarNiVersionesNiConfiguracion",
      "Effect": "Deny",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketVersions",
        "s3:ListBucketMultipartUploads",
        "s3:DeleteObjectVersion",
        "s3:PutBucketVersioning",
        "s3:PutLifecycleConfiguration",
        "s3:PutBucketPolicy",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutEncryptionConfiguration",
        "s3:DeleteBucket",
        "s3:GetObjectVersion",
        "s3:DeleteBucketPolicy",
        "s3:PutBucketCORS"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NoTocarElBucketDeRespaldos",
      "Effect": "Deny",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::ingenia365-erp-backups",
        "arn:aws:s3:::ingenia365-erp-backups/*"
      ]
    }
  ]
}
